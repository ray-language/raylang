{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(cargo *)",
      "Bash(source \"$HOME/.cargo/env\" && cargo *)",
      "Bash(source \"$HOME/.cargo/env\" && ./target/*)",
      "Bash(./target/*)",
      "Bash(mdbook *)",
      "Bash(git commit *)",
      "Bash(git commit:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(git clean:*)"
    ],
    "deny": []
  }
}
