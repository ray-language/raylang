// Asignación en heap + GC: construir y recorrer arreglos repetidamente.
fn main() -> int {
    var total: int = 0;
    var r: int = 0;
    while (r < 2000) {
        var a: [int] = [];
        var i: int = 0;
        while (i < 500) {
            push(a, i);
            i = i + 1;
        }
        var j: int = 0;
        while (j < len(a)) {
            total = total + a[j];
            j = j + 1;
        }
        r = r + 1;
    }
    total % 1000
}
