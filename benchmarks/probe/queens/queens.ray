import std/time;

fn solve(row: int, n: int, cols: [bool], d1: [bool], d2: [bool]) -> int {
    if (row == n) {
        return 1;
    }
    var count = 0;
    for c in 0..n {
        let a = row + c;
        let b = row - c + n - 1;
        if (!cols[c] && !d1[a] && !d2[b]) {
            cols[c] = true;
            d1[a] = true;
            d2[b] = true;
            count = count + solve(row + 1, n, cols, d1, d2);
            cols[c] = false;
            d1[a] = false;
            d2[b] = false;
        }
    }
    count
}

fn main() {
    let t0 = time.monotonic_nanos();
    let n = 11;
    var cols: [bool] = [];
    var d1: [bool] = [];
    var d2: [bool] = [];
    for i in 0..n {
        cols.push(false);
    }
    for i in 0..(2 * n) {
        d1.push(false);
        d2.push(false);
    }
    print(solve(0, n, cols, d1, d2));
    eprint("bench_ns=${time.monotonic_nanos() - t0}");
}
