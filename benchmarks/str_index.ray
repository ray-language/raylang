// Indexación secuencial `s[i]` sobre una cadena ASCII larga (288 000 caracteres): el caso 12 de
// ray-sublime. Antes de M213 cada `s[i]` copiaba la cadena y la recorría entera para saber si era
// ASCII → cuadrático (4 s); con la caché por cadena es lineal (~0.09 s). Vigila que siga así.
fn main() -> int {
    var s = "";
    var k = 0;
    while (k < 8000) {
        s = s + "abcdefghijklmnopqrstuvwxyz0123456789";
        k = k + 1;
    }
    let n = s.len();
    var i = 0;
    var vowels = 0;
    while (i < n) {
        let c = s[i];
        if (c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u') {
            vowels = vowels + 1;
        }
        i = i + 1;
    }
    print(vowels);
    0
}
