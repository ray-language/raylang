// Carga `plaintext` — raylang sobre `net/webserver` PELADO (sin `web/framework`).
//
// Responde `Hello, World!` con `Content-Type: text/plain` a cualquier ruta: es la primera
// categoría de TechEmpower, el mínimo común denominador que todas las implementaciones del
// banco sirven byte a byte igual (lo verifica `webbench.py` antes de medir).
//
// El host y el puerto llegan por argumento porque el arnés asigna un puerto distinto a cada
// implementación (las levanta en paralelo sin colisiones ni esperas de TIME_WAIT) y, cuando el
// generador de carga vive en otra máquina, necesita bindear a una IP alcanzable desde ella.
import net/webserver;

fn handle(req: webserver.Request) -> webserver.Response {
    var r: webserver.Response = webserver.text(200, "Hello, World!");
    r.headers.insert("Content-Type", "text/plain");
    r
}

fn main() -> int {
    let argv: [string] = args();
    if (argv.len() < 2) {
        eprint("uso: plaintext-ray <host> <puerto>");
        return 2;
    }
    let host: string = argv[0];
    let port: int = match (argv[1].parse_int()) {
        Option.Some(p) => p,
        Option.None => {
            eprint("puerto inválido: " + argv[1]);
            return 2;
        },
    };
    match (webserver.serve(host, port, handle)) {
        Result.Ok(_) => 0,
        Result.Err(e) => {
            eprint("serve: " + e);
            1
        },
    }
}
