<?xml version="1.0" encoding="UTF-8"?>
<!-- Hace que "Toggle Comment" (Ctrl/Cmd+/) inserte // en raylang. Sublime activa el comentado
     de línea cuando el scope define TM_COMMENT_START. raylang solo tiene comentarios de línea. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>name</key>
	<string>Comentarios de raylang</string>
	<key>scope</key>
	<string>source.raylang</string>
	<key>settings</key>
	<dict>
		<key>shellVariables</key>
		<array>
			<dict>
				<key>name</key>
				<string>TM_COMMENT_START</string>
				<key>value</key>
				<string>// </string>
			</dict>
		</array>
	</dict>
</dict>
</plist>
