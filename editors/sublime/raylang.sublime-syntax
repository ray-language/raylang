%YAML 1.2
---
# Sintaxis de raylang para Sublime Text 4 (.sublime-syntax).
#
# Es un *port* de la gramática TextMate de la extensión de VSCode
# (editors/vscode/syntaxes/raylang.tmLanguage.json): mismas reglas, **mismos scopes**, para que
# cualquier tema de color las pinte igual en ambos editores. Es coloreado **estático** (no
# entiende el programa); la validación real (errores subrayados) la da el Language Server
# `raylang --lsp` vía el paquete LSP. Ver README.md.
#
# El orden de las reglas importa: en cada posición gana la primera que casa. Se replica el orden
# de la gramática de VSCode (definiciones y palabras clave antes que los identificadores
# genéricos; `self`/`Self` y builtins antes que la regla de tipos/llamadas).
name: raylang
file_extensions:
  - ray
scope: source.raylang

variables:
  ident: '[A-Za-z_][A-Za-z0-9_]*'
  # Escapes de string/char (M118): \n \t \r \0 \\ \" \' \$ \xNN \u{H…H}.
  escape: '\\(u\{[0-9A-Fa-f]+\}|x[0-9A-Fa-f]{2}|.)'
  int_suffix: '(?:u8|u32|u64)?'
  user_type: '[A-Z][A-Za-z0-9_]*'
  # M244: los builtins LIBRES de llms.txt (§ "Free global builtins" + concurrencia) y los builtins
  # de RECEPTOR (s.len(), xs.map(f), m.insert(k, v)). Una sola lista, la misma que la gramática de
  # VSCode (builtins y pipeline-target); la guarda tests/sublime_syntax_test.rs la contrasta con
  # llms.txt.
  builtins: 'print|eprint|to_string|panic|assert|assert_eq|args|env|platform|input|parse_int|parse_float|from_utf8|bytes_of|sort|sort_by|sort_by_key|get|char_code|char_from_code|try_call|exit|spawn|send|recv|try_recv|try_send|join|try_join|scope|select|select_timeout|close|signals|add_to|len|trim|split|chars|contains|replace|starts_with|ends_with|to_upper|to_lower|substring|repeat|index_of|to_bytes|push|pop|reverse|position|map|filter|fold|iter|insert|contains_key|keys|values|sub_bytes|remove'

contexts:
  main:
    - include: comments
    - include: byte_strings
    - include: strings
    - include: characters
    - include: annotations
    - include: definitions
    - include: keywords
    - include: types
    - include: literals
    - include: calls
    - include: operators

  comments:
    # `///` es documentación (visible en LSP/raydoc): scope propio, además del de comentario.
    - match: '///.*$'
      scope: comment.line.documentation.raylang
    - match: '//.*$'
      scope: comment.line.double-slash.raylang

  strings:
    # Backticks (M95): string donde la comilla doble es literal, multilínea, misma interpolación.
    - match: '`'
      scope: punctuation.definition.string.begin.raylang
      push:
        - meta_scope: string.quoted.other.template.raylang
        - match: '{{escape}}'
          scope: constant.character.escape.raylang
        - match: '\$\{'
          scope: punctuation.section.interpolation.begin.raylang support.function.builtin.raylang
          push:
            - clear_scopes: 1
            - meta_scope: meta.interpolation.raylang
            - match: '\}'
              scope: punctuation.section.interpolation.end.raylang support.function.builtin.raylang
              pop: true
            - match: '\{'
              push:
                - match: '\}'
                  pop: true
                - include: main
            - include: main
        - match: '`'
          scope: punctuation.definition.string.end.raylang
          pop: true
    # Una cadena con escapes e interpolación `${expr}` (M27.3); contexto propio hasta la comilla.
    - match: '"'
      scope: punctuation.definition.string.begin.raylang
      push:
        - meta_scope: string.quoted.double.raylang
        # Escapes: \n \t \r \\ \" y \$ (un '$' literal, para un '${' sin interpolar). Va primero:
        # así '\${' se toma como '$' escapado + '{' literal, sin abrir interpolación.
        - match: '{{escape}}'
          scope: constant.character.escape.raylang
        # Interpolación: el '$' solo es especial seguido de '{'. El interior se resalta como código.
        - match: '\$\{'
          scope: punctuation.section.interpolation.begin.raylang support.function.builtin.raylang
          push:
            # `clear_scopes: 1` suelta el scope `string.quoted.double` heredado, para que el
            # interior se pinte como CÓDIGO (identificadores/literales/operadores), no como cadena.
            - clear_scopes: 1
            - meta_scope: meta.interpolation.raylang
            - match: '\}'
              scope: punctuation.section.interpolation.end.raylang support.function.builtin.raylang
              pop: true
            # Llaves anidadas en la expresión (p. ej. `${f({a: 1})}`) para no cerrar de más.
            - match: '\{'
              push:
                - match: '\}'
                  pop: true
                - include: main
            - include: main
        - match: '"'
          scope: punctuation.definition.string.end.raylang
          pop: true

  byte_strings:
    # Literal de bytes `b"..."` (M16.1): escapes de string más `\xNN`. No interpola.
    - match: 'b"'
      scope: punctuation.definition.string.begin.raylang storage.type.string.byte.raylang
      push:
        - meta_scope: string.quoted.double.byte.raylang
        - match: '{{escape}}'
          scope: constant.character.escape.raylang
        - match: '"'
          scope: punctuation.definition.string.end.raylang
          pop: true

  characters:
    # Literal de carácter `'a'` (M11.4c): un code point, con escapes `\n \t \r \\ \'`.
    - match: "'({{escape}}|[^'\\\\])'"
      scope: constant.character.raylang

  annotations:
    # @nombre (M10.1): @test, @derive, ... El argumento (@derive(Eq)) cae luego en 'types'.
    - match: '@{{ident}}'
      scope: storage.modifier.annotation.raylang

  definitions:
    # `struct Punto` / `enum Figura` / `trait Mostrable`: la palabra clave + el nombre de tipo.
    - match: '\b(struct|enum|trait)\s+({{user_type}})'
      captures:
        1: storage.type.raylang
        2: entity.name.type.raylang
    # `impl Mostrable for Punto`: 'for' es contextual (no es palabra clave global), solo aquí.
    - match: '\b(impl)\s+({{user_type}})\s+(for)\s+({{user_type}})'
      captures:
        1: storage.type.raylang
        2: entity.name.type.raylang
        3: keyword.control.raylang
        4: entity.name.type.raylang
    # `extern "lib" [blocking] { … }` (M41): bloque FFI; 'blocking' es contextual.
    - match: '\b(extern)\b'
      scope: storage.modifier.raylang
    - match: '\b(blocking)\b(?=\s*\{)'
      scope: storage.modifier.raylang
    # `fn fib`: definición de función.
    - match: '\b(fn)\s+({{ident}})'
      captures:
        1: storage.type.function.raylang
        2: entity.name.function.raylang

  keywords:
    - match: '\b(if|else|while|for|in|return|break|continue|match|import|from|as)\b'
      scope: keyword.control.raylang
    # El receptor 'self' y el tipo 'Self' (M9). Antes de 'types' porque Self es mayúscula.
    - match: '\b(self|Self)\b'
      scope: variable.language.self.raylang
    - match: '\b(let|var|const|fn|struct|enum|trait|impl|dyn|pub)\b'
      scope: storage.type.raylang
    # Builtins/stdlib seguidos de '(' : antes de la regla de llamadas para conservar su color.
    - match: '\b({{builtins}})\b(?=\s*\()'
      scope: support.function.builtin.raylang

  types:
    - match: '\b(int|float|bool|string|char|bytes|unit|ptr|u8|u32|u64)\b'
      scope: support.type.primitive.raylang
    # Constante en SCREAMING_SNAKE (2+ chars, todo mayúsculas): PI, MAX_INTENTOS. Antes del tipo de
    # usuario para ganar; una sola letra (T/E/K) queda como type param.
    - match: '\b[A-Z][A-Z0-9_]*[A-Z0-9]\b'
      scope: constant.other.raylang
    # Nombre de tipo de usuario por convención (empieza en mayúscula): struct/enum/variante/etc.
    - match: '\b{{user_type}}\b'
      scope: entity.name.type.raylang

  literals:
    - match: '\b(true|false)\b'
      scope: constant.language.boolean.raylang
    # Con prefijo de base (M118): 0xFF, 0o17, 0b1010; sufijo u8/u32/u64 opcional (M192).
    - match: '\b0[xX][0-9A-Fa-f]+{{int_suffix}}\b'
      scope: constant.numeric.integer.raylang
    - match: '\b0[oO][0-7]+{{int_suffix}}\b'
      scope: constant.numeric.integer.raylang
    - match: '\b0[bB][01]+{{int_suffix}}\b'
      scope: constant.numeric.integer.raylang
    # Flotante: con punto y/o exponente (`1.5`, `1e3`, `1.5e-3`, `2E+10`).
    - match: '\b[0-9]+(\.[0-9]+)?[eE][+-]?[0-9]+\b'
      scope: constant.numeric.float.raylang
    - match: '\b[0-9]+\.[0-9]+\b'
      scope: constant.numeric.float.raylang
    - match: '\b[0-9]+{{int_suffix}}\b'
      scope: constant.numeric.integer.raylang

  calls:
    # Llamada ordinaria: identificador seguido de '('.
    - match: '\b({{ident}})(?=\s*\()'
      captures:
        1: entity.name.function.raylang
    # Objetivo de un pipeline desnudo (`x |> doble`): función aunque no lleve '('. Se excluyen
    # los builtins, que en `|> map(...)` ya colorea el paréntesis.
    - match: '(\|>)\s*(?!(?:{{builtins}})\b)({{ident}})'
      captures:
        1: keyword.operator.raylang
        2: entity.name.function.raylang

  operators:
    # Incluye el rango `..` (bucles for, M27.2) y los bit a bit `& | ^ ~ << >>` (M19.3a).
    - match: '=>|->|\|>|\.\.|<<|>>|==|!=|<=|>=|&&|\|\||[-+*/%<>!=:?&|^~]'
      scope: keyword.operator.raylang
