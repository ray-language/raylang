{
  "name": "raylang",
  "displayName": "raylang",
  "description": "Resaltado de sintaxis para el lenguaje raylang (.ray)",
  "version": "0.9.0",
  "publisher": "rayala",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "raylang",
        "aliases": [
          "raylang",
          "Raylang"
        ],
        "extensions": [
          ".ray"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "raylang",
        "scopeName": "source.raylang",
        "path": "./syntaxes/raylang.tmLanguage.json"
      }
    ]
  }
}
