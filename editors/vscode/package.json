{
  "name": "raylang",
  "displayName": "raylang",
  "description": "Soporte para el lenguaje raylang (.ray) y sus templates compilados (.ray.html): resaltado de sintaxis + cliente del Language Server (diagnósticos en vivo).",
  "version": "0.17.0",
  "publisher": "ray-language",
  "license": "MIT OR Apache-2.0",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ray-language/raylang",
    "directory": "editors/vscode"
  },
  "bugs": {
    "url": "https://github.com/ray-language/raylang/issues"
  },
  "homepage": "https://github.com/ray-language/raylang/tree/main/editors/vscode",
  "keywords": [
    "raylang",
    "ray",
    "language-server",
    "lsp",
    "syntax-highlighting"
  ],
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:raylang",
    "onLanguage:html"
  ],
  "contributes": {
    "languages": [
      {
        "id": "raylang",
        "aliases": [
          "raylang",
          "Raylang"
        ],
        "extensions": [
          ".ray"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "html",
        "extensions": [
          ".ray.html"
        ]
      }
    ],
    "grammars": [
      {
        "language": "raylang",
        "scopeName": "source.raylang",
        "path": "./syntaxes/raylang.tmLanguage.json"
      },
      {
        "scopeName": "text.html.raylang",
        "path": "./syntaxes/raylang-template.tmLanguage.json",
        "embeddedLanguages": {
          "source.raylang": "raylang"
        },
        "injectTo": [
          "text.html.basic",
          "text.html.derivative"
        ]
      }
    ],
    "configuration": {
      "title": "raylang",
      "properties": {
        "raylang.serverPath": {
          "type": "string",
          "default": "ray",
          "description": "Ruta al binario de raylang que provee el Language Server. Por defecto 'ray' (se busca en el PATH). El cliente lo lanza con el subcomando 'lsp'. Si VSCode no encuentra 'ray' (p. ej. lanzado desde el Dock en macOS, sin ~/.local/bin en el PATH), pon aquí la ruta absoluta."
        },
        "raylang.enableLsp": {
          "type": "boolean",
          "default": true,
          "description": "Activa el cliente del Language Server (diagnósticos en vivo). Si se desactiva, la extensión solo colorea."
        }
      }
    },
    "configurationDefaults": {
      "[raylang]": {
        "editor.quickSuggestions": {
          "other": true,
          "comments": false,
          "strings": true
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.4.0"
  }
}
