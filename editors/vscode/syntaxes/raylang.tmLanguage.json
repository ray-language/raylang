{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "raylang",
  "scopeName": "source.raylang",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#annotation" },
    { "include": "#struct-definition" },
    { "include": "#enum-definition" },
    { "include": "#trait-definition" },
    { "include": "#impl-definition" },
    { "include": "#function-definition" },
    { "include": "#keywords-control" },
    { "include": "#self" },
    { "include": "#storage" },
    { "include": "#builtins" },
    { "include": "#types" },
    { "include": "#user-types" },
    { "include": "#booleans" },
    { "include": "#numbers" },
    { "include": "#function-call" },
    { "include": "#pipeline-target" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.double-slash.raylang",
      "match": "//.*$"
    },
    "strings": {
      "name": "string.quoted.double.raylang",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.raylang",
          "match": "\\\\."
        }
      ]
    },
    "annotation": {
      "comment": "Anotación @nombre (M10.1): @test, @derive, ... Los argumentos (p. ej. @derive(Eq)) caen en sus propias reglas (tipos de usuario).",
      "match": "@[A-Za-z_][A-Za-z0-9_]*",
      "name": "storage.modifier.annotation.raylang"
    },
    "struct-definition": {
      "match": "\\b(struct)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "storage.type.struct.raylang" },
        "2": { "name": "entity.name.type.raylang" }
      }
    },
    "enum-definition": {
      "match": "\\b(enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "storage.type.enum.raylang" },
        "2": { "name": "entity.name.type.raylang" }
      }
    },
    "trait-definition": {
      "match": "\\b(trait)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "storage.type.trait.raylang" },
        "2": { "name": "entity.name.type.raylang" }
      }
    },
    "impl-definition": {
      "comment": "`impl Trait for Tipo`: 'for' es contextual (no es palabra clave global), solo se colorea aquí.",
      "match": "\\b(impl)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s+(for)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "storage.type.impl.raylang" },
        "2": { "name": "entity.name.type.raylang" },
        "3": { "name": "keyword.control.raylang" },
        "4": { "name": "entity.name.type.raylang" }
      }
    },
    "function-definition": {
      "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "storage.type.function.raylang" },
        "2": { "name": "entity.name.function.raylang" }
      }
    },
    "keywords-control": {
      "name": "keyword.control.raylang",
      "match": "\\b(if|else|while|return|match)\\b"
    },
    "self": {
      "comment": "El receptor 'self' y el tipo 'Self' dentro de un trait/impl (M9).",
      "name": "variable.language.self.raylang",
      "match": "\\b(self|Self)\\b"
    },
    "storage": {
      "name": "storage.type.raylang",
      "match": "\\b(let|var|fn|struct|enum|trait|impl|dyn)\\b"
    },
    "builtins": {
      "name": "support.function.builtin.raylang",
      "match": "\\b(print|len|push|map|filter|fold)\\b(?=\\s*\\()"
    },
    "types": {
      "name": "support.type.primitive.raylang",
      "match": "\\b(int|float|bool|string)\\b"
    },
    "user-types": {
      "name": "entity.name.type.raylang",
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
    },
    "booleans": {
      "name": "constant.language.boolean.raylang",
      "match": "\\b(true|false)\\b"
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.raylang",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.raylang",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "function-call": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
      "captures": {
        "1": { "name": "entity.name.function.raylang" }
      }
    },
    "pipeline-target": {
      "comment": "El objetivo de un pipeline desnudo (`x |> doble`) es una función aunque no lleve '('. Se excluyen los builtins: en `|> map(...)` el paréntesis ya los colorea como tales.",
      "match": "(\\|>)\\s*(?!(?:print|len|push|map|filter|fold)\\b)([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.operator.raylang" },
        "2": { "name": "entity.name.function.raylang" }
      }
    },
    "operators": {
      "name": "keyword.operator.raylang",
      "match": "=>|->|\\|>|==|!=|<=|>=|&&|\\|\\||[-+*/%<>!=:?]"
    }
  }
}
