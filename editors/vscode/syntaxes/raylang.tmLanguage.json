{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "raylang",
  "scopeName": "source.raylang",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#struct-definition" },
    { "include": "#function-definition" },
    { "include": "#keywords-control" },
    { "include": "#storage" },
    { "include": "#builtins" },
    { "include": "#types" },
    { "include": "#user-types" },
    { "include": "#booleans" },
    { "include": "#numbers" },
    { "include": "#function-call" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.double-slash.raylang",
      "match": "//.*$"
    },
    "strings": {
      "name": "string.quoted.double.raylang",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.raylang",
          "match": "\\\\."
        }
      ]
    },
    "struct-definition": {
      "match": "\\b(struct)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "storage.type.struct.raylang" },
        "2": { "name": "entity.name.type.raylang" }
      }
    },
    "function-definition": {
      "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "storage.type.function.raylang" },
        "2": { "name": "entity.name.function.raylang" }
      }
    },
    "keywords-control": {
      "name": "keyword.control.raylang",
      "match": "\\b(if|else|while|return)\\b"
    },
    "storage": {
      "name": "storage.type.raylang",
      "match": "\\b(let|var|fn|struct)\\b"
    },
    "builtins": {
      "name": "support.function.builtin.raylang",
      "match": "\\b(print)\\b(?=\\s*\\()"
    },
    "types": {
      "name": "support.type.primitive.raylang",
      "match": "\\b(int|float|bool|string)\\b"
    },
    "user-types": {
      "name": "entity.name.type.raylang",
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
    },
    "booleans": {
      "name": "constant.language.boolean.raylang",
      "match": "\\b(true|false)\\b"
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.raylang",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.raylang",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "function-call": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
      "captures": {
        "1": { "name": "entity.name.function.raylang" }
      }
    },
    "operators": {
      "name": "keyword.operator.raylang",
      "match": "->|==|!=|<=|>=|&&|\\|\\||[-+*/%<>!=:]"
    }
  }
}
