// A minimal client for the Claude Messages API (`POST /v1/messages`) over plain HTTP: there is no
// official SDK for raylang, and the API is just JSON. Messages travel as raw JSON text, so an
// assistant turn goes back to the API exactly as it arrived (thinking blocks included, which must
// be returned unchanged).
import std/json;
import net/http;
from std/json import Json;

/// What the agent needs to call the API.
pub struct Config {
    api_key: string,
    model: string,
    base_url: string,
}

/// One tool call the model asked for.
pub struct ToolCall {
    id: string,
    name: string,
    input: string,
}

/// The parts of a response the agent loop uses.
pub struct Reply {
    stop_reason: string,
    content: string,
    text: string,
    calls: [ToolCall],
}

/// The request body. `tools` and `messages` are JSON arrays already rendered as text.
pub fn request_body(model: string, system: string, tools: string, messages: [string]) -> string {
    "{\"model\":"
        + json.stringify(Json.JStr(model))
        + ",\"max_tokens\":16000"
        + ",\"output_config\":{\"effort\":\"medium\"}"
        + ",\"fallbacks\":\"default\""
        + ",\"system\":"
        + json.stringify(Json.JStr(system))
        + ",\"tools\":"
        + tools
        + ",\"messages\":["
        + messages.join(",")
        + "]}"
}

/// A user turn with plain text.
pub fn user_text(text: string) -> string {
    "{\"role\":\"user\",\"content\":" + json.stringify(Json.JStr(text)) + "}"
}

/// The assistant turn to send back: its content, unchanged.
pub fn assistant_turn(r: Reply) -> string {
    "{\"role\":\"assistant\",\"content\":" + r.content + "}"
}

/// One `tool_result` block. Every result of a turn goes back in ONE user message.
pub fn tool_result(id: string, output: string, is_error: bool) -> string {
    json.render(json.obj()
        .field("type", "tool_result")
        .field("tool_use_id", id)
        .field("content", output)
        .field("is_error", is_error))
}

/// The user message that carries the results of a turn's tool calls.
pub fn results_turn(results: [string]) -> string {
    "{\"role\":\"user\",\"content\":[" + results.join(",") + "]}"
}

/// Reads a response body.
pub fn parse_reply(body: string) -> Result<Reply, string> {
    let j = json.parse(body)?;
    match (json.get_object(j, "error")) {
        Option.Some(_) => {
            let e = json.member(j, "error").unwrap_or(Json.JNull);
            return Result.Err("API error: " + json.get_string(e, "message").unwrap_or(body));
        },
        Option.None => { },
    }
    let content = json.member(j, "content").unwrap_or(Json.JArray([]));
    var text = "";
    var calls: [ToolCall] = [];
    for block in json.as_array(content)
        .unwrap_or([]) {
        let kind = json.get_string(block, "type").unwrap_or("");
        if (kind == "text") {
            text = text + json.get_string(block, "text").unwrap_or("");
        }
        if (kind == "tool_use") {
            calls.push(
                ToolCall {
                    id: json.get_string(block, "id").unwrap_or(""),
                    name: json.get_string(block, "name").unwrap_or(""),
                    input: json.stringify(json.member(block, "input").unwrap_or(Json.JObject(Map.new())))
                }
            );
        }
    }
    Result.Ok(
        Reply {
            stop_reason: json.get_string(j, "stop_reason").unwrap_or(""),
            content: json.stringify(content),
            text: text,
            calls: calls
        }
    )
}

/// Sends one request. A long answer can take minutes, hence the 10-minute timeout.
pub fn send(c: Config, body: string) -> Result<string, string> {
    var headers: Map<string, string> = Map.new();
    headers.insert("content-type", "application/json");
    headers.insert("x-api-key", c.api_key);
    headers.insert("anthropic-version", "2023-06-01");
    // `fallbacks: "default"`: if a safety classifier declines, the API retries on a fallback model.
    headers.insert("anthropic-beta", "server-side-fallback-2026-07-01");
    let r = http.request_bytes(
        "POST",
        c.base_url + "/v1/messages",
        body.to_bytes(),
        headers,
        600000
    )?;
    let text = http.body_text(r)?;
    if (r.status >= 400) {
        return Result.Err("HTTP " + to_string(r.status) + ": " + text);
    }
    Result.Ok(text)
}
