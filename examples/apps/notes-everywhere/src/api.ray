// The protocol between the page and the program. The page calls
// `window.ray.request({op: "...", ...})`; each request arrives here as JSON text and the answer
// goes back with `ui.reply_json`, so the page's Promise resolves with an object. Every operation
// answers with the list for the current search: the UI repaints from a single source of truth.
// Nothing here touches a window, so `ray test` covers it like any other function.
import std/json;
import notes;
from db/sqlite import Conn;
from notes import Note;

/// The answer with the notes that match `query`.
pub fn ok(conn: Conn, query: string) -> string {
    match (notes.search(conn, query)) {
        Result.Ok(list) => `{"ok": true, "notes": ${json.render_arr(json.list(list))}}`,
        Result.Err(e) => fail(e),
    }
}

/// An error answer; the page shows `error`.
pub fn fail(message: string) -> string {
    json.render(json.obj().field("ok", false).field("error", message))
}

/// Answers one request from the page. `now_ms` comes from the caller so tests are deterministic.
pub fn handle(conn: Conn, body: string, now_ms: int) -> string {
    let req = match (json.parse(body)) {
        Result.Ok(j) => j,
        Result.Err(e) => return fail("bad request: " + e),
    };
    let op = json.get_string(req, "op").unwrap_or("");
    let query = json.get_string(req, "query").unwrap_or("");
    if (op == "list") {
        return ok(conn, query);
    }
    if (op == "save") {
        let id = json.get_string(req, "id").unwrap_or("");
        let title = json.get_string(req, "title").unwrap_or("");
        let text = json.get_string(req, "body").unwrap_or("");
        return match (notes.save(conn, id, title, text, now_ms)) {
            Result.Ok(_) => ok(conn, query),
            Result.Err(e) => fail(e),
        };
    }
    if (op == "delete") {
        let id = json.get_string(req, "id").unwrap_or("");
        return match (notes.remove(conn, id)) {
            Result.Ok(_) => ok(conn, query),
            Result.Err(e) => fail(e),
        };
    }
    fail("unknown op '" + op + "'")
}
