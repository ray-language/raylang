// Where each platform wants an app's data. A desktop app does not write into the user's
// Documents: macOS has Application Support, Linux the XDG data folder, Windows %APPDATA%. On the
// phone HOME is inside the app's sandbox. `fs.data_dir` knows the folder of each one.
import std/fs;

/// The folder for the app's data on this platform, created if missing. `NOTES_DIR` overrides
/// it (tests, CI).
pub fn data_dir(app: string) -> Result<string, string> {
    match (env("NOTES_DIR")) {
        Option.Some(d) => {
            fs.mkdir(d)?;
            Result.Ok(d)
        },
        Option.None => fs.data_dir(app),
    }
}

/// True on macOS, Linux and Windows: windows, menus and file dialogs exist there.
pub fn is_desktop() -> bool {
    let os = platform();
    os == "macos" || os == "linux" || os == "windows"
}
