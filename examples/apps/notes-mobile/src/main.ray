// Notes: una app de notas para iOS y Android (y, sin cambiar una línea, para escritorio).
//
// La interfaz es React + TypeScript (frontend/), construida con Vite. Bajo `ray dev` la ventana
// carga el dev server de Vite (recarga en caliente); en un build nativo o en el bundle del
// teléfono carga el `frontend/dist` embebido, servido por `ray://app/` sin ningún puerto. La
// página habla con este programa por el puente `window.ray.request`, y las notas viven en un
// archivo de `std/kv` dentro de la carpeta de datos de la app.
import std/ui;
import std/kv;
import std/fs;
import std/time;
import api;

// La carpeta de datos: `$HOME/Documents/Notes`. En iOS `$HOME` es el contenedor de la app (su
// raíz no se puede escribir, `Documents/` sí); en Android el shell pone `HOME` en la carpeta
// privada de la app; en escritorio es la carpeta del usuario. `NOTES_DIR` la cambia (tests, CI).
fn data_dir() -> string {
    match (env("NOTES_DIR")) {
        Option.Some(d) => d,
        Option.None => match (env("HOME")) {
            Option.Some(home) => home + "/Documents/Notes",
            Option.None => "notes-data",
        },
    }
}

fn main() -> int {
    let dir = data_dir();
    let _ = fs.mkdir(home_documents(dir));
    let _ = fs.mkdir(dir);
    let store = match (kv.open(dir + "/notes.kv")) {
        Result.Ok(s) => s,
        Result.Err(e) => {
            eprint("notes: could not open the store: " + e);
            return 1;
        },
    };
    // Bajo `ray dev` el build puede no existir todavía (lo sirve Vite): solo se avisa.
    match (ui.mount_embed_at("", "frontend/dist")) {
        Result.Err(e) => eprint("frontend build not mounted (fine under `ray dev`): " + e),
        Result.Ok(_) => { },
    }
    let window = match (ui.open("Notes", "app://index.html", 420, 760)) {
        Result.Err(e) => {
            eprint("ui: " + e);
            return 1;
        },
        Result.Ok(w) => w,
    };
    while (true) {
        let e = match (ui.next_event()) {
            Result.Err(err) => {
                eprint("ui: " + err);
                return 1;
            },
            Result.Ok(e) => e,
        };
        // En escritorio, cerrar la ventana termina la app. En el teléfono no llega nunca: el
        // sistema suspende o mata el proceso, y por eso cada cambio ya está guardado.
        if (e.kind == "closed" && e.window == window) {
            return 0;
        }
        if (e.kind == "lifecycle") {
            print("notes: app moved to the " + e.tag);
        }
        if (e.kind == "message") {
            match (ui.as_request(e)) {
                Option.Some(request) => {
                    let (id, body) = request;
                    let answer = api.handle(store, body, time.now());
                    let _ = ui.reply_json(e.window, id, answer);
                },
                Option.None => { },
            }
        }
    }
    0
}

// El padre de la carpeta de datos (`…/Documents`), que en un escritorio nuevo puede no existir.
fn home_documents(dir: string) -> string {
    match (dir.last_index_of("/")) {
        Option.Some(i) => dir.substring(0, i),
        Option.None => ".",
    }
}
