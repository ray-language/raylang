// Notes as a website with a React frontend. One binary serves both: the JSON API under /api and
// the built frontend (frontend/dist), embedded in the binary. The notes live in Redis.
//
// Development: `ray dev` starts Vite (http://localhost:5173, hot reload) next to this program,
// and Vite forwards /api to it. Production: `ray build --native --release` builds the frontend,
// embeds it, and the binary is the whole site.
import std/json;
import std/time;
import std/embed;
import net/redis;
import store;
from net/redis import Pool;
from web/framework import
    new_app,
    GET,
    POST,
    PUT,
    DELETE,
    static_embedded,
    gzip,
    log_requests,
    not_found,
    listen_graceful,
    json,
    html,
    status,
    text,
    param,
    query,
    json_body,
    App,
    Ctx,
    Res;

fn fail(r: Res, code: int, message: string) {
    r.status(code).json(json.render(json.obj().field("error", message)));
}

fn note_input(c: Ctx) -> Result<(string, string), string> {
    let body = c.json_body()?;
    let title = json.get_string(body, "title").unwrap_or("");
    if (title.trim() == "") {
        return Result.Err("title is required");
    }
    Result.Ok((title, json.get_string(body, "body").unwrap_or("")))
}

// The single-page app: every GET that is not /api or a file gets index.html, so the browser's
// router (client-side URLs such as /notes/123) works on reload too.
fn spa(c: Ctx, r: Res) {
    if (c.req.method != "GET" || c.req.path.starts_with("/api/")) {
        fail(r, 404, "no such route");
        return;
    }
    match (embed.read("frontend/dist/index.html")) {
        Result.Ok(page) => r.status(200).html(from_utf8(page).unwrap_or("")),
        Result.Err(_) => r.text("frontend not built: run `npm --prefix frontend run build`"),
    }
}

fn routes(db: Pool) -> App {
    var app = new_app();
    app.log_requests();
    app.gzip();
    // The built frontend: read from disk under `ray run`, baked into the native binary. Only
    // /assets/ is mounted: a mount answers every GET under its prefix before the routes run, so
    // mounting "/" would swallow /api too. The page itself comes from `spa`.
    app.static_embedded("/assets/", "frontend/dist/assets");
    app.GET("/", spa);
    app.GET("/favicon.svg", fn(c: Ctx, r: Res) {
        match (embed.read("frontend/dist/favicon.svg")) {
            Result.Ok(svg) => {
                let _ = r.header("Content-Type", "image/svg+xml");
                r.text(from_utf8(svg).unwrap_or(""));
            },
            Result.Err(_) => fail(r, 404, "no favicon"),
        }
    });

    app.GET("/api/notes", fn(c: Ctx, r: Res) {
        let limit = c.query("limit").parse_int().unwrap_or(100);
        match (store.list(db, c.query("q"), limit)) {
            Result.Ok(list) => r.json(store.list_json(list)),
            Result.Err(e) => fail(r, 503, e),
        }
    });
    app.POST("/api/notes", fn(c: Ctx, r: Res) {
        match (note_input(c)) {
            Result.Err(e) => fail(r, 422, e),
            Result.Ok(input) => {
                let (title, body) = input;
                match (store.save(db, "", title, body, time.now())) {
                    Result.Ok(Option.Some(n)) => r.status(201).json(n.to_json()),
                    Result.Ok(Option.None) => fail(r, 500, "not saved"),
                    Result.Err(e) => fail(r, 503, e),
                }
            },
        }
    });
    app.PUT("/api/notes/:id", fn(c: Ctx, r: Res) {
        match (note_input(c)) {
            Result.Err(e) => fail(r, 422, e),
            Result.Ok(input) => {
                let (title, body) = input;
                match (store.save(db, c.param("id"), title, body, time.now())) {
                    Result.Ok(Option.Some(n)) => r.json(n.to_json()),
                    Result.Ok(Option.None) => fail(r, 404, "no such note"),
                    Result.Err(e) => fail(r, 503, e),
                }
            },
        }
    });
    app.DELETE("/api/notes/:id", fn(c: Ctx, r: Res) {
        match (store.remove(db, c.param("id"))) {
            Result.Ok(true) => r.status(204).text(""),
            Result.Ok(false) => fail(r, 404, "no such note"),
            Result.Err(e) => fail(r, 503, e),
        }
    });
    app.not_found(spa);
    app
}

fn main() -> int {
    let db = store.pool_from_env(10);
    match (redis.pool_command(db, ["PING"])) {
        Result.Ok(_) => { },
        Result.Err(e) => {
            eprint("redis: " + e);
            return 1;
        },
    }
    let host = env("HOST").unwrap_or("127.0.0.1");
    let port = env("PORT").unwrap_or("8080").parse_int().unwrap_or(8080);
    print("notes-web: http://" + host + ":" + to_string(port));
    let served = listen_graceful(fn() -> App { routes(db) }, host, port, 5000);
    redis.pool_close(db);
    match (served) {
        Result.Ok(_) => 0,
        Result.Err(e) => {
            eprint(e);
            1
        },
    }
}
