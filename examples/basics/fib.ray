// Programa-objetivo de M1 (ver DESIGN.md §9).
// Calcula los primeros 10 números de Fibonacci.
//
// Por ahora solo lo usamos para alimentar al lexer:
//   cargo run -- examples/basics/fib.ray
fn fib(n: int) -> int {
    if (n < 2) {
        n
    } else {
        fib(n - 1) + fib(n - 2)
    }
}

fn main() -> int {
    let a = args();
    let ds = 10;
    let steps = if (a.len() > 0) {
        match (parse_int(a[0])) {
            Option.Some(x) => x,
            Option.None => ds,
        }
    } else {
        ds
    };

    var i: int = 0;
    while (i < steps) {
        print(fib(i));
        i = i + 1;
    }
    0
}
