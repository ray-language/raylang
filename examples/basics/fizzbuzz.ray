// FizzBuzz del 1 al 20.
fn main() -> int {
    var i: int = 1;
    while (i <= 20) {
        if (i % 15 == 0) {
            print("FizzBuzz");
        } else if (i % 3 == 0) {
            print("Fizz");
        } else if (i % 5 == 0) {
            print("Buzz");
        } else {
            print(i);
        }
        i = i + 1;
    }
    0
}
