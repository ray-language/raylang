// Interpolación de strings (M27.3): cualquier cadena puede incrustar el valor de una expresión con
// `${expr}`, convertida con `to_string`. Sustituye las largas cadenas de `+ to_string(...)`. No hace
// falta prefijo: el `$` solo es especial seguido de `{`, así que `"$5"` o `"{n}"` son literales (el
// `{` ya no necesita escape). Para un `${` literal se escribe `\${`.
fn area(base: int, altura: int) -> int { base * altura / 2 }

fn main() {
  let nombre = "Ada";
  let anio = 1815;

  // Variables y texto.
  print(to_string(nombre) + " nació en " + to_string(anio) + ".");  // Ada nació en 1815.

  // Expresiones arbitrarias dentro de `${}`.
  print("Un triángulo 6x4 tiene área " + to_string(area(6, 4)) + ".");  // ... área 12.

  let x = 7;
  print(to_string(x) + " al cuadrado es " + to_string(x * x) + ", y su mitad " + to_string(x / 2) + ".");  // 7 ... 49 ... 3.

  // Cualquier tipo imprimible: int, float, bool, char, string.
  print("bool=" + to_string(true) + ", float=" + to_string(2.5) + ", char=" + to_string('!'));  // bool=true, float=2.5, char=!

  // Las llaves son literales (sin doblar); solo `${` interpola.
  print("un objeto JSON: { \"clave\": " + to_string(x) + " }");  // un objeto JSON: { "clave": 7 }

  // Se combina con `for` (M27.2) y tuplas (M27.1).
  for i in 1..4 {
    let par = (i, i * i);
    print("  " + to_string(par.0) + "² = " + to_string(par.1));  // 1²=1, 2²=4, 3²=9
  }
}
