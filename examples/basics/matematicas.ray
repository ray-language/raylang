// M15.1a / M49.1a — la stdlib de matemáticas.
//
// Las funciones float (sqrt, trig, log…) y pow viven en el módulo `std/math` (M49): se importan y se
// usan calificadas (`math.sqrt(2.0)`). Las polimórficas `abs`/`min`/`max` y las constantes `pi()`/`e()`
// siguen globales por ahora (se mueven a `std/math` en M49.1b).
import std/math;

fn main() {
    // Raíz, potencia y redondeo.
    print(math.sqrt(16.0));  // 4
    print(math.pow(2.0, 10.0));  // 1024
    print(math.floor(3.7));  // 3
    print(math.ceil(3.2));  // 4
    print(math.round(2.5));  // 3

    // Trigonometría y logaritmos.
    print(math.sin(0.0));  // 0
    print(math.cos(0.0));  // 1
    print(math.ln(e()));  // 1
    print(math.log10(1000.0));  // 3

    // Polimórficas (aún globales; → std/math en M49.1b): conservan el tipo numérico.
    print(abs(-7));  // 7  (int)
    print(abs(-2.5));  // 2.5 (float)
    print(min(3, 8));  // 3  (int)
    print(max(1.5, 9.0));  // 9  (float)

    let area: float = pi() * math.pow(2.0, 2.0);  // π·r² con r=2
    print(area);  // 12.566370614359172
}
