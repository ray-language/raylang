// M15.1a / M49 — la stdlib de matemáticas.
//
// Todo vive en el módulo `std/math` (M49): se importa y se usa calificado (`math.sqrt(2.0)`). Las
// funciones float envuelven primitivos internos; `abs`/`min`/`max` son genéricas (traits `Signed`/`Ord`)
// y `pi`/`e` son funciones nularias.
import std/math;

fn main() {
    // Raíz, potencia y redondeo.
    print(math.sqrt(16.0));  // 4
    print(math.pow(2.0, 10.0));  // 1024
    print(math.floor(3.7));  // 3
    print(math.ceil(3.2));  // 4
    print(math.round(2.5));  // 3

    // Trigonometría y logaritmos.
    print(math.sin(0.0));  // 0
    print(math.cos(0.0));  // 1
    print(math.ln(math.e()));  // 1
    print(math.log10(1000.0));  // 3

    // Polimórficas (genéricas sobre Signed/Ord): conservan el tipo numérico.
    print(math.abs(-7));  // 7  (int)
    print(math.abs(-2.5));  // 2.5 (float)
    print(math.min(3, 8));  // 3  (int)
    print(math.max(1.5, 9.0));  // 9  (float)

    let area: float = math.pi() * math.pow(2.0, 2.0);  // π·r² con r=2
    print(area);  // 12.566370614359172
}
