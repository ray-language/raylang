// Tuplas (M27.1): tipos heterogéneos de aridad fija, para retorno múltiple y agrupar valores.
// En runtime se borran a un arreglo (erasure), así que no cuestan un tipo de valor nuevo.
// Retorno múltiple: división y resto a la vez.
fn divmod(a: int, b: int) -> (int, int) {
    (a / b, a % b)
}

// Una tupla heterogénea como "registro anónimo".
fn stats(xs: [int]) -> (int, int, int) {
    var suma = 0;
    var maxi = xs[0];
    var i = 0;
    while (i < len(xs)) {
        suma = suma + xs[i];
        if (xs[i] > maxi) {
            maxi = xs[i];
        }
        i = i + 1;
    }
    // `return` explícito: un `(…)` de tupla justo tras un `while {}` se parsearía como una llamada.
    return (suma, maxi, len(xs));
}

fn main() {
    // Acceso por índice `.0`/`.1`.
    let d = divmod(17, 5);
    print("17 / 5 = " + to_string(d.0) + " resto " + to_string(d.1));  // 3 resto 2

    // Desestructuración: liga varios nombres a la vez (`_` descarta).
    let (q, r) = divmod(23, 4);
    print("q=" + to_string(q) + " r=" + to_string(r));  // q=5 r=3

    let (suma, maxi, n) = stats([3, 9, 4, 9, 1]);
    print("suma=" + to_string(suma) + " max=" + to_string(maxi) + " n=" + to_string(n));  // 26, 9, 5

    // Tupla heterogénea.
    let persona = ("Ada", 36, true);
    print(persona.0 + " tiene " + to_string(persona.1) + " años");  // Ada tiene 36 años

    // Intercambio sin variable temporal: la tupla del lado derecho se evalúa antes de ligar.
    let x = 10;
    let y = 20;
    let (x2, y2) = (y, x);
    print("swap: " + to_string(x2) + ", " + to_string(y2));  // swap: 20, 10
}
