// `select` (M12.4): multiplexar varios canales — esperar al PRIMERO que esté listo para recibir.
// `select(chs) -> int` bloquea hasta que algún canal de la lista tiene un valor (o está cerrado, o
// tiene un emisor esperando) y devuelve el ÍNDICE del primero listo; luego `recv(chs[i])` toma el
// valor. Como toda la concurrencia, vive SOLO en la VM:
//
//     cargo run -- --vm examples/concurrency/select.ray
//
// (Con el intérprete da un error claro pidiendo la VM.)
//
// OJO: un canal CERRADO queda "listo" para siempre (un recv da `None` sin bloquear). Si haces select
// sobre una lista fija que incluye canales cerrados, `select` los elegiría una y otra vez (el idiom de
// Go es "poner ese caso a nil"; aquí: quitar el canal cerrado de la lista). Para no liar el ejemplo,
// estas fuentes NO cierran: el consumidor lee un número conocido de valores.
fn fuente(ch: Channel<int>, base: int, cuantos: int) {
  var i = 0;
  while (i < cuantos) {
    send(ch, base + i);
    i = i + 1;
  }
}

fn main() -> int {
  let a: Channel<int> = channel();
  let b: Channel<int> = channel();
  spawn(fn() {
  fuente(a, 100, 2);  // 100, 101
});
  spawn(fn() {
  fuente(b, 200, 2);  // 200, 201
});

  let chs: [Channel<int>] = [a, b];
  var total = 0;
  var n = 0;
  // Un solo bucle atiende AMBAS fuentes: select elige el canal que esté listo (menor índice primero).
  while (n < 4) {
    let i = select(chs);
    match (recv(chs[i])) {
      Option.Some(v) => {
        print(v);
        total = total + v;
      },
      Option.None => { },
    }
    n = n + 1;
  }
  print(total);  // 100+101+200+201 = 602
  total
}
