// Demostración de arreglos (M3.1).
fn suma(a: [int]) -> int {
    var s: int = 0;
    var i: int = 0;
    while (i < len(a)) {
        s = s + a[i];
        i = i + 1;
    }
    s
}

fn main() -> int {
    let nums: [int] = [3, 1, 4, 1, 5, 9, 2, 6];
    print(nums);  // imprime el arreglo
    print(len(nums));  // 8
    print(suma(nums));  // 31

    // Construir un arreglo dinámicamente con push.
    var cuadrados: [int] = [];
    var i: int = 0;
    while (i < 5) {
        push(cuadrados, i * i);
        i = i + 1;
    }
    print(cuadrados);  // [0, 1, 4, 9, 16]
    0
}
