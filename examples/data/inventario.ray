// Arreglo de structs: un pequeño modelo de dominio.
// Cada producto es un struct; el inventario es un [Producto].
struct Producto {
    nombre: string,
    precio: int,
    cantidad: int,
}

// Valor total del inventario: suma de precio * cantidad.
fn valor_total(inv: [Producto]) -> int {
    var total: int = 0;
    var i: int = 0;
    while (i < len(inv)) {
        let p: Producto = inv[i];
        total = total + p.precio * p.cantidad;
        i = i + 1;
    }
    total
}

// Cuántos productos tienen stock por debajo del umbral.
fn bajo_stock(inv: [Producto], umbral: int) -> int {
    var n: int = 0;
    var i: int = 0;
    while (i < len(inv)) {
        if (inv[i].cantidad < umbral) {
            n = n + 1;
        }
        i = i + 1;
    }
    n
}

fn main() -> int {
    var inv: [Producto] = [Producto { nombre: "teclado", precio: 25, cantidad: 8 }, Producto { nombre: "mouse", precio: 15, cantidad: 3 }, Producto { nombre: "monitor", precio: 180, cantidad: 2 }];

    print(valor_total(inv));  // 25*8 + 15*3 + 180*2 = 605
    print(bajo_stock(inv, 5));  // 2 (mouse y monitor)

    // Reponer stock del mouse: muta el struct dentro del arreglo.
    inv[1].cantidad = 20;
    print(bajo_stock(inv, 5));  // 1 (solo monitor)
    print(valor_total(inv));  // 25*8 + 15*20 + 180*2 = 860
    0
}
