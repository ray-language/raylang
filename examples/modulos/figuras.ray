// Un módulo (M11.3): el nombre del módulo es el nombre del archivo, "figuras".
// `pub` exporta; sin `pub`, el ítem es privado al módulo.

pub fn area_rect(ancho: int, alto: int) -> int { ancho * alto }

pub fn area_cuadrado(lado: int) -> int {
  // Reusa una función privada del propio módulo.
  area_rect(lado, lado)
}

pub fn perimetro_rect(ancho: int, alto: int) -> int { doble(ancho) + doble(alto) }

// Privada: no se puede llamar desde fuera con `figuras.doble(...)`.
fn doble(n: int) -> int { n + n }
