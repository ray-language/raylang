// M15.2 — cliente TCP: una petición HTTP/1.1 "a mano".
//
// Conecta a un servidor, escribe una petición y acumula la respuesta leyendo por trozos
// (socket_read hace UNA lectura; "" = el otro extremo cerró → fin). En M15.4 esto se envolverá
// en una librería HTTP de raylang; aquí se ve el transporte crudo.
//
// Necesita red al ejecutarlo (no es determinista → no entra al oráculo ni a los tests).
// Lee del socket hasta que el servidor cierra (acumulando los trozos).
import std/net;

fn leer_todo(h: int) -> string {
    var acc: string = "";
    var seguir: bool = true;
    while (seguir) {
        match (net.socket_read(h)) {
            Result.Ok(trozo) => {
                if (trozo.len() == 0) {
                    seguir = false;  // EOF: el servidor cerró
                } else {
                    acc = acc + trozo;
                }
            },
            Result.Err(e) => {
                eprint("error de lectura: " + e);
                seguir = false;
            },
        }
    }
    acc
}

fn main() -> int {
    match (net.tcp_connect("example.com", 80)) {
        Result.Ok(h) => {
            // Petición HTTP/1.1 mínima (Connection: close → el servidor cierra al terminar).
            let req: string = "GET / HTTP/1.1\r\nHost: example.com\r\nConnection: close\r\n\r\n";
            match (net.socket_write(h, req)) {
                Result.Ok(_) => {
                    let resp: string = leer_todo(h);
                    // Imprime solo la primera línea (la línea de estado), p. ej. "HTTP/1.1 200 OK".
                    let lineas: [string] = resp.split("\r\n");
                    print(lineas[0]);
                },
                Result.Err(e) => eprint("error de escritura: " + e),
            }
            close(h);
            0
        },
        Result.Err(e) => {
            eprint("could not connect: " + e);
            1
        },
    }
}
