// Ordenamiento de burbuja: muta el arreglo in situ.
// Muestra la semántica de referencia — 'ordenar' modifica el mismo arreglo
// que ve 'main', sin devolverlo.
fn ordenar(a: [int]) {
    var n: int = len(a);
    var i: int = 0;
    while (i < n) {
        var j: int = 0;
        while (j < n - i - 1) {
            if (a[j] > a[j + 1]) {
                // intercambio
                let tmp: int = a[j];
                a[j] = a[j + 1];
                a[j + 1] = tmp;
            }
            j = j + 1;
        }
        i = i + 1;
    }
}

fn main() -> int {
    var nums: [int] = [5, 2, 9, 1, 5, 6, 3];
    print(nums);        // [5, 2, 9, 1, 5, 6, 3]
    ordenar(nums);      // muta el arreglo compartido
    print(nums);        // [1, 2, 3, 5, 5, 6, 9]
    0
}
