// StringBuilder y Deque (M40.3c/d), dos colecciones lineales; M50.2 las mueve a `std/collections/`.
// `stringbuilder` se importa `as sb` (leaf corto) y `deque` con su leaf. Uso calificado: `sb.push(b, s)`,
// `deque.push_back(d, x)`, etc.
import std/collections/stringbuilder as sb;
import std/collections/deque;

fn dv(o: Option<int>) -> int {
    match (o) {
        Option.Some(v) => v,
        Option.None => 0 - 1,
    }
}

fn main() -> int {
    // StringBuilder: acumula trozos y los une UNA vez (evita el O(n²) de `+` en un bucle).
    let b = sb.new();
    var i = 1;
    while (i <= 5) {
        sb.push(b, "fila");
        sb.push(b, to_string(i));
        sb.push(b, "\n");
        i = i + 1;
    }
    print(sb.build(b));  // fila1\nfila2\n…\nfila5\n
    print(sb.count(b));  // 15 (3 trozos × 5)

    // Deque: cola doble. Como COLA (FIFO): push_back + pop_front.
    let cola: deque.Deque<int> = deque.new();
    deque.push_back(cola, 10);
    deque.push_back(cola, 20);
    deque.push_back(cola, 30);
    print(dv(deque.pop_front(cola)));  // 10
    print(dv(deque.pop_front(cola)));  // 20

    // Como PILA (LIFO): push_back + pop_back.
    let pila: deque.Deque<string> = deque.new();
    deque.push_back(pila, "a");
    deque.push_back(pila, "b");
    match (deque.pop_back(pila)) {
        Option.Some(s) => print(s),  // "b"
        Option.None => print("vacía"),
    }

    // Doble extremo: insertar por delante.
    let d: deque.Deque<int> = deque.new();
    deque.push_back(d, 2);
    deque.push_front(d, 1);
    deque.push_front(d, 0);
    print(deque.len(d));  // 3
    print(dv(deque.peek_front(d)));  // 0

    0
}
