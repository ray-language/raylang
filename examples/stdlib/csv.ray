// CSV (RFC 4180) escrito EN raylang. Parser y writer de valores separados por comas, con soporte de
// campos entrecomillados (comas, comillas y saltos de línea dentro del campo). Puro cómputo, cero
// runtime. Importable: `from csv import parse_csv, write_csv;`.
//
// El parseo devuelve `[[string]]` (filas de campos como strings): raylang es estáticamente tipado y las
// columnas son heterogéneas, así que dejar todo como string (y que el usuario convierta) es lo idiomático.
// M59.5: el writer acumula en StringBuilder (O(n)); en el parser los campos siguen con `+` por
// carácter — el coste es cuadrático solo en el LARGO DEL CAMPO (cortos en la práctica), y la
// alternativa (substring por rachas) es peor: substring indexa por carácter y escanea desde 0.
import std/collections/stringbuilder as sb;

// Parsea un documento CSV a filas de campos. Los campos entrecomillados (`"..."`) admiten comas, saltos
// de línea y comillas escapadas como `""`. Acepta finales de línea LF o CRLF.
/// Parses a CSV document (RFC 4180) into rows of string fields. Quoted fields (`"..."`) may
/// contain commas, newlines, and quotes escaped as `""`; accepts LF or CRLF line endings.
/// Returns `Err` on an unterminated quoted field.
pub fn parse_csv(src: string) -> Result<[[string]], string> {
    let cs = src.chars();
    let n = cs.len();
    var rows: [[string]] = [];
    var row: [string] = [];
    var field = "";
    var vivo = false;  // ¿hay una fila/campo en curso? (para flushear el final sin `\n`)
    var i = 0;
    while (i < n) {
        let c = cs[i];
        if (c == '"') {
            vivo = true;
            i = i + 1;
            var cerrado = false;
            while (!cerrado && i < n) {
                let d = cs[i];
                if (d == '"') {
                    if (i + 1 < n && cs[i + 1] == '"') {
                        field = field + "\"";  // comilla escapada
                        i = i + 2;
                    } else {
                        cerrado = true;
                        i = i + 1;
                    }
                } else {
                    field = field + to_string(d);
                    i = i + 1;
                }
            }
            if (!cerrado) {
                return Result.Err("comilla sin cerrar en el CSV");
            }
        } else if (c == ',') {
            row.push(field);
            field = "";
            vivo = true;
            i = i + 1;
        } else if (c == '\n') {
            row.push(field);
            rows.push(row);
            row = [];
            field = "";
            vivo = false;
            i = i + 1;
        } else if (c == '\r') {
            i = i + 1;  // se ignora (parte de CRLF)
        } else {
            field = field + to_string(c);
            vivo = true;
            i = i + 1;
        }
    }
    // Flushea la última fila si el documento no terminó en salto de línea.
    if (vivo || field.len() > 0 || row.len() > 0) {
        row.push(field);
        rows.push(row);
    }
    Result.Ok(rows)
}

// ¿Necesita `s` entrecomillado al escribir? (contiene coma, comilla, CR o LF).
fn necesita_comillas(s: string) -> bool {
    var q = false;
    var i = 0;
    while (i < s.len()) {
        let c = s[i];
        if (c == ',' || c == '"' || c == '\n' || c == '\r') {
            q = true;
        }
        i = i + 1;
    }
    q
}

// Escribe un campo, entrecomillándolo y escapando las comillas si hace falta.
// M59.5: la comilla interior se escapa duplicando por rachas (replace nativo, O(n)).
fn write_field(s: string) -> string {
    if (!necesita_comillas(s)) {
        return s;
    }
    "\"" + s.replace("\"", "\"\"") + "\""
}

// Serializa filas de campos a un documento CSV (líneas separadas por `\n`).
/// Serializes rows of fields to a CSV document (`\n` line endings). Fields containing a
/// comma, quote, CR, or LF are quoted, with inner quotes escaped as `""` (RFC 4180).
pub fn write_csv(rows: [[string]]) -> string {
    let b = sb.new();
    var r = 0;
    while (r < rows.len()) {
        let fila = rows[r];
        var c = 0;
        while (c < fila.len()) {
            if (c > 0) {
                sb.push(b, ",");
            }
            sb.push(b, write_field(fila[c]));
            c = c + 1;
        }
        sb.push(b, "\n");
        r = r + 1;
    }
    sb.build(b)
}
