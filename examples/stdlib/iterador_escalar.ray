// Iteradores de usuario (M40.2) + adaptadores escalares del prelude, en la porción que transpila a
// nativo (P2.b/B2): `impl Iterator<T>` propio, `.iter()`, `range`, `.map()`, `.filter()`. Los adaptadores
// que entregan TUPLAS (`enumerate`/`zip`) quedan diferidos en el transpilador (ver `iterador.ray`).
struct Cuenta { actual: int, fin: int }

impl Iterator<int> for Cuenta {
    fn next(self) -> Option<int> {
        if (self.actual >= self.fin) {
            Option.None
        } else {
            let v: int = self.actual;
            self.actual = self.actual + 1;
            Option.Some(v)
        }
    }
}

fn cuenta(desde: int, hasta: int) -> Cuenta {
    Cuenta { actual: desde, fin: hasta }
}

fn main() -> int {
    // Iterador de usuario con estado por referencia.
    var suma: int = 0;
    for n in cuenta(1, 6) {
        suma = suma + n;
    }
    print(suma);  // 15

    // `.iter()` sobre un arreglo.
    let xs: [int] = [10, 20, 30];
    for x in xs.iter() {
        print(x);  // 10 20 30
    }

    // `range` como iterador de primera clase.
    for i in range(1, 4) {
        print(i);  // 1 2 3
    }

    // Encadenado: map y filter sobre iteradores.
    for y in [1, 2, 3, 4].iter().map(fn(n: int) -> int { n * 10 }) {
        print(y);  // 10 20 30 40
    }
    for z in range(1, 10).filter(fn(n: int) -> bool { n < 4 }) {
        print(z);  // 1 2 3
    }
    0
}
