// Un carácter desde su code point; U+FFFD para 0 y los inválidos (como manda la spec).
fn char_from_cp(n: int) -> string {
    if (n <= 0) {
        return "�";
    }
    match (char_from_code(n)) {
        Option.Some(c) => to_string(c),
        Option.None => "�",
    }
}

// Si en `i` hay una referencia de entidad válida (`&amp;`, `&#35;`, `&#x1F;`): su texto y el
// índice tras el `;`.
fn entity_at(s: string, i: int) -> Option<(string, int)> {
    if (char_at(s, i) != '&') {
        return Option.None;
    }
    if (char_at(s, i + 1) == '#') {
        var j = i + 2;
        var v = 0;
        var digits = 0;
        if (char_at(s, j) == 'x' || char_at(s, j) == 'X') {
            j = j + 1;
            while (j < s.len() && is_hex_digit(s[j]) && digits < 7) {
                v = v * 16 + hex_digit(s[j]);
                j = j + 1;
                digits = digits + 1;
            }
            if (digits == 0 || digits > 6 || char_at(s, j) != ';') {
                return Option.None;
            }
        } else {
            while (j < s.len() && is_digit(s[j]) && digits < 8) {
                v = v * 10 + (char_code(s[j]) - 48);
                j = j + 1;
                digits = digits + 1;
            }
            if (digits == 0 || digits > 7 || char_at(s, j) != ';') {
                return Option.None;
            }
        }
        return Option.Some((char_from_cp(v), j + 1));
    }
    var j = i + 1;
    while (j < s.len() && is_alnum(s[j]) && j - i <= 32) {
        j = j + 1;
    }
    if (j == i + 1 || char_at(s, j) != ';') {
        return Option.None;
    }
    let name = s.substring(i + 1, j);
    match (ENTITIES.index_of(";" + name + "=")) {
        Option.Some(k) => {
            var m = k + name.len() + 2;
            var out = "";
            var v = 0;
            while (m < ENTITIES.len() && ENTITIES[m] != ';') {
                if (ENTITIES[m] == ',') {
                    out = out + char_from_cp(v);
                    v = 0;
                } else {
                    v = v * 10 + (char_code(ENTITIES[m]) - 48);
                }
                m = m + 1;
            }
            Option.Some((out + char_from_cp(v), j + 1))
        },
        Option.None => Option.None,
    }
}

// Decodifica las entidades de un string (destinos y títulos de enlace, ya sin escapes).
fn decode_entities(s: string) -> string {
    if (!s.contains("&")) {
        return s;
    }
    var out = "";
    var i = 0;
    while (i < s.len()) {
        if (s[i] == '&') {
            match (entity_at(s, i)) {
                Option.Some(e) => {
                    out = out + e.0;
                    i = e.1;
                },
                Option.None => {
                    out = out + "&";
                    i = i + 1;
                },
            }
        } else {
            out = out + to_string(s[i]);
            i = i + 1;
        }
    }
    out
}

// Escapes de backslash + entidades: la normalización de destinos y títulos.
fn clean_dest(s: string) -> string {
    decode_entities(unescape_backslashes(s))
}

// M241: los inlines con las definiciones de referencia del documento.
fn parse_inline_refs(s: string, refs: Map<string, [string]>) -> [Inline] {
    let p = Ip { s: rtrim(s), pos: 0, toks: [], refs: refs };
    while (p.pos < p.s.len()) {
        let c = p.s[p.pos];
        if (c == '\\') {
            scan_backslash(p);
        } else if (c == '`') {
            scan_code_span(p);
        } else if (c == '*' || c == '_' || c == '~') {
            scan_delim_run(p);
        } else if (c == '[') {
            let t = tok_text("");
            t.kind = T_BRACKET;
            t.active = true;
            t.pos = p.pos + 1;
            p.toks.push(t);
            p.pos = p.pos + 1;
        } else if (c == '!' && char_at(p.s, p.pos + 1) == '[') {
            let t = tok_text("");
            t.kind = T_BRACKET;
            t.image = true;
            t.active = true;
            t.pos = p.pos + 2;
            p.toks.push(t);
            p.pos = p.pos + 2;
        } else if (c == ']') {
            scan_close_bracket(p);
        } else if (c == '<') {
            if (!scan_autolink(p)) {
                push_text(p, "<");
                p.pos = p.pos + 1;
            }
        } else if (c == '&') {
            match (entity_at(p.s, p.pos)) {
                Option.Some(e) => {
                    push_text(p, e.0);
                    p.pos = e.1;
                },
                Option.None => {
                    push_text(p, "&");
                    p.pos = p.pos + 1;
                },
            }
        } else if (c == '\n') {
            scan_newline(p, false);
        } else {
            scan_text(p);
        }
    }
    process_emphasis(p, 0);
    var out = finish(p.toks);
    // Un salto duro al final del bloque no se renderiza.
    if (out.len() > 0) {
        match (out[out.len() - 1]) {
            Inline.HardBreak => {
                let _ = out.pop();
            },
            _ => { },
        }
    }
    out
}

/// Parses inline Markdown (emphasis, strong, code spans, links, images, escapes) into `Inline`s.
pub fn parse_inline(s: string) -> [Inline] {
    let refs: Map<string, [string]> = Map.new();
    parse_inline_refs(s, refs)
}

// Añade texto, fusionándolo con el token de texto anterior si lo hay.
fn push_text(p: Ip, t: string) {
    if (p.toks.len() > 0) {
        let last = p.toks[p.toks.len() - 1];
        if (last.kind == T_TEXT) {
            last.text = last.text + t;
            return;
        }
    }
    p.toks.push(tok_text(t));
}

// Texto ordinario hasta el siguiente carácter especial (con los autolinks extendidos de GFM:
// `www.`, `http://`, `https://` y correos, solo al inicio de palabra).
fn scan_text(p: Ip) {
    let s = p.s;
    let start = p.pos;
    var i = start;
    while (i < s.len()) {
        let c = s[i];
        if (c == '\\'
            || c == '`'
            || c == '*'
            || c == '_'
            || c == '~'
            || c == '['
            || c == ']'
            || c == '<'
            || c == '&'
            || c == '\n'
            || (c == '!' && char_at(s, i + 1) == '[')) {
            if (i == start) {
                // el llamador ya descartó estos en `start`; evita el bucle infinito
                i = i + 1;
            }
            push_text(p, s.substring(start, i));
            p.pos = i;
            return;
        }
        if ((c == 'w' || c == 'h' || c == 'f')
            && i > start
            && !is_word_boundary(char_at(s, i - 1))) {
            i = i + 1;
        } else if (c == 'w' || c == 'h' || c == 'f') {
            if (i > start) {
                push_text(p, s.substring(start, i));
            }
            p.pos = i;
            if (!scan_extended_autolink(p)) {
                push_text(p, to_string(c));
                p.pos = i + 1;
            }
            return;
        } else if (c == '@' && i > start) {
            let em = scan_email_autolink(p, start, i);
            if (em >= 0) {
                return;
            }
            i = i + 1;
        } else {
            i = i + 1;
        }
    }
    push_text(p, s.substring(start, i));
    p.pos = i;
}

// Los autolinks extendidos empiezan tras blanco o `*`, `_`, `~`, `(`.
fn is_word_boundary(c: char) -> bool {
    is_uws(c) || c == '*' || c == '_' || c == '~' || c == '('
}

// GFM: `www.…`, `http://…`, `https://…` sin `<…>`. Devuelve si se emitió un enlace.
fn scan_extended_autolink(p: Ip) -> bool {
    let s = p.s;
    let i = p.pos;
    if (i > 0 && !is_word_boundary(s[i - 1])) {
        return false;
    }
    var prefix = "";
    if (matches_at(s, i, "www.")) {
        prefix = "http://";
    } else if (!matches_at(s, i, "http://")
        && !matches_at(s, i, "https://")
        && !matches_at(s, i, "ftp://")) {
        return false;
    }
    let dom_start = if (prefix != "") {
        i
    } else {
        match (s.substring(i, s.len()).index_of("//")) {
            Option.Some(k) => i + k + 2,
            Option.None => i,
        }
    };
    // Dominio: alfanuméricos, `-`, `_` y `.`; al menos un punto; sin `_` en los dos últimos
    // segmentos.
    var j = dom_start;
    while (j < s.len() && (is_alnum(s[j]) || s[j] == '-' || s[j] == '_' || s[j] == '.')) {
        j = j + 1;
    }
    var domain = s.substring(dom_start, j);
    while (domain.ends_with(".")) {
        domain = domain.substring(0, domain.len() - 1);
    }
    if (!domain.contains(".")) {
        return false;
    }
    let segs = domain.split(".");
    if (segs.len() < 2
        || segs[segs.len() - 1].contains("_")
        || segs[segs.len() - 2].contains("_")) {
        return false;
    }
    // Resto: hasta blanco o `<`.
    while (j < s.len() && !is_ws(s[j]) && s[j] != '<') {
        j = j + 1;
    }
    // Puntuación final excluida; `)` solo si desbalancea; `;` si cierra una entidad.
    var end = j;
    var trimming = true;
    while (trimming && end > dom_start) {
        let c = s[end - 1];
        if (c == '?'
            || c == '!'
            || c == '.'
            || c == ','
            || c == ':'
            || c == '*'
            || c == '_'
            || c == '~'
            || c == '\''
            || c == '"') {
            end = end - 1;
        } else if (c == ')') {
            var opens = 0;
            var closes = 0;
            var k = i;
            while (k < end) {
                if (s[k] == '(') {
                    opens = opens + 1;
                } else if (s[k] == ')') {
                    closes = closes + 1;
                }
                k = k + 1;
            }
            if (closes > opens) {
                end = end - 1;
            } else {
                trimming = false;
            }
        } else if (c == ';') {
            var k = end - 2;
            while (k > i && is_alnum(s[k])) {
                k = k - 1;
            }
            if (s[k] == '&') {
                end = k;
            } else {
                trimming = false;
            }
        } else {
            trimming = false;
        }
    }
    let url = s.substring(i, end);
    p.toks.push(tok_done(Inline.Link([Inline.Text(url)], prefix + url, "")));
    p.pos = end;
    true
}

// GFM: correo desnudo `a.b@c.d`. `start` es el inicio del texto pendiente; `at` la posición
// del `@`. Devuelve el fin del enlace o -1.
fn scan_email_autolink(p: Ip, start: int, at: int) -> int {
    let s = p.s;
    // La parte local puede haber empezado ANTES de `start` (texto ya emitido): se retrocede
    // sobre la fuente y, si ese prefijo está al final del último token de texto, se recorta.
    var b = at;
    while (b > 0
        && (is_alnum(s[b - 1])
            || s[b - 1] == '.'
            || s[b - 1] == '-'
            || s[b - 1] == '_'
            || s[b - 1] == '+')) {
        b = b - 1;
    }
    if (b == at || (b > 0 && !is_word_boundary(s[b - 1]))) {
        return 0 - 1;
    }
    var j = at + 1;
    while (j < s.len() && (is_alnum(s[j]) || s[j] == '-' || s[j] == '_' || s[j] == '.')) {
        j = j + 1;
    }
    var end = j;
    while (end > at + 1 && s[end - 1] == '.') {
        end = end - 1;
    }
    let domain = s.substring(at + 1, end);
    if (!domain.contains(".") || domain.ends_with("-") || domain.ends_with("_")) {
        return 0 - 1;
    }
    if (b < start) {
        let prefix = s.substring(b, start);
        var ok = false;
        if (p.toks.len() > 0) {
            let last = p.toks[p.toks.len() - 1];
            if (last.kind == T_TEXT && last.text.ends_with(prefix)) {
                last.text = last.text.substring(0, last.text.len() - prefix.len());
                ok = true;
            }
        }
        if (!ok) {
            return 0 - 1;
        }
    }
    if (b > start) {
        push_text(p, s.substring(start, b));
    }
    let addr = s.substring(b, end);
    p.toks.push(tok_done(Inline.Link([Inline.Text(addr)], "mailto:" + addr, "")));
    p.pos = end;
    end
}

// `\` + puntuación ASCII → literal; `\` + fin de línea → salto duro; si no, una barra.
fn scan_backslash(p: Ip) {
    let n = char_at(p.s, p.pos + 1);
    if (p.pos + 1 < p.s.len() && is_ascii_punct(n)) {
        push_text(p, to_string(n));
        p.pos = p.pos + 2;
    } else if (n == '\n' && p.pos + 1 < p.s.len()) {
        p.pos = p.pos + 1;
        scan_newline(p, true);
    } else {
        push_text(p, "\\");
        p.pos = p.pos + 1;
    }
}

// Fin de línea: duro (`\` o 2+ espacios antes) o blando. Quita los espacios finales de la
// línea y los iniciales de la siguiente.
fn scan_newline(p: Ip, hard: bool) {
    var is_hard = hard;
    if (p.toks.len() > 0) {
        let last = p.toks[p.toks.len() - 1];
        if (last.kind == T_TEXT) {
            let t = last.text;
            var k = t.len();
            while (k > 0 && t[k - 1] == ' ') {
                k = k - 1;
            }
            if (t.len() - k >= 2) {
                is_hard = true;
            }
            last.text = t.substring(0, k);
        }
    }
    if (is_hard) {
        p.toks.push(tok_done(Inline.HardBreak));
    } else {
        push_text(p, "\n");
    }
    p.pos = p.pos + 1;
    while (p.pos < p.s.len() && (p.s[p.pos] == ' ' || p.s[p.pos] == '\t')) {
        p.pos = p.pos + 1;
    }
}

// Code span: una tira de N backticks hasta la siguiente tira de exactamente N.
fn scan_code_span(p: Ip) {
    let s = p.s;
    var n = 0;
    while (p.pos + n < s.len() && s[p.pos + n] == '`') {
        n = n + 1;
    }
    var j = p.pos + n;
    var close = 0 - 1;
    while (j < s.len() && close < 0) {
        if (s[j] == '`') {
            var m = 0;
            while (j + m < s.len() && s[j + m] == '`') {
                m = m + 1;
            }
            if (m == n) {
                close = j;
            }
            j = j + m;
        } else {
            j = j + 1;
        }
    }
    if (close < 0) {
        push_text(p, "`".repeat(n));
        p.pos = p.pos + n;
        return;
    }
    var content = s.substring(p.pos + n, close).replace("\n", " ");
    if (content.len() >= 2
        && content[0] == ' '
        && content[content.len() - 1] == ' '
        && content.trim() != "") {
        content = content.substring(1, content.len() - 1);
    }
    p.toks.push(tok_done(Inline.Code(content)));
    p.pos = close + n;
}

// Una tira de `*`, `_` o `~`: registra el delimitador con su flanqueo.
fn scan_delim_run(p: Ip) {
    let s = p.s;
    let c = s[p.pos];
    var n = 0;
    while (p.pos + n < s.len() && s[p.pos + n] == c) {
        n = n + 1;
    }
    let before = char_at(s, p.pos - 1);
    let after = char_at(s, p.pos + n);
    let left = !is_uws(after) && (!is_punct(after) || is_uws(before) || is_punct(before));
    let right = !is_uws(before) && (!is_punct(before) || is_uws(after) || is_punct(after));
    var can_open = left;
    var can_close = right;
    if (c == '_') {
        can_open = left && (!right || is_punct(before));
        can_close = right && (!left || is_punct(after));
    }
    if (c == '~' && n > 2) {
        can_open = false;
        can_close = false;
    }
    if (!can_open && !can_close) {
        push_text(p, to_string(c).repeat(n));
    } else {
        let t = tok_text("");
        t.kind = T_DELIM;
        t.ch = c;
        t.count = n;
        t.orig = n;
        t.can_open = can_open;
        t.can_close = can_close;
        p.toks.push(t);
    }
    p.pos = p.pos + n;
}

// `<esquema:…>` o `<correo>`; el HTML crudo NO se interpreta (queda como texto escapado).
fn scan_autolink(p: Ip) -> bool {
    let s = p.s;
    let i = p.pos;
    var j = i + 1;
    while (j < s.len()
        && s[j] != '>'
        && s[j] != '<'
        && s[j] != ' '
        && s[j] != '\n'
        && char_code(s[j]) >= 32) {
        j = j + 1;
    }
    if (j >= s.len() || s[j] != '>' || j == i + 1) {
        return false;
    }
    let body = s.substring(i + 1, j);
    // Esquema: letra + 1..31 de [letras dígitos + . -] y `:`.
    var k = 0;
    while (k < body.len()
        && (is_alnum(body[k]) || body[k] == '+' || body[k] == '.' || body[k] == '-')) {
        k = k + 1;
    }
    let scheme_ok = k >= 2
        && k <= 32
        && k < body.len()
        && body[k] == ':'
        && !is_digit(body[0])
        && body[0] != '+'
        && body[0] != '.'
        && body[0] != '-';
    if (scheme_ok) {
        p.toks.push(tok_done(Inline.Link([Inline.Text(body)], body, "")));
        p.pos = j + 1;
        return true;
    }
    // Correo: local@dominio (segmentos alfanuméricos con guiones interiores).
    match (body.index_of("@")) {
        Option.Some(at) => {
            if (at == 0 || at == body.len() - 1) {
                return false;
            }
            var m = 0;
            while (m < at) {
                let c = body[m];
                if (!(is_alnum(c) || ".!#$%&'*+/=?^_`{|}~-".contains(to_string(c)))) {
                    return false;
                }
                m = m + 1;
            }
            let segs = body.substring(at + 1, body.len()).split(".");
            for seg in segs {
                if (seg == "" || seg.starts_with("-") || seg.ends_with("-") || seg.len() > 63) {
                    return false;
                }
                for c in seg.chars() {
                    if (!(is_alnum(c) || c == '-')) {
                        return false;
                    }
                }
            }
            p.toks.push(tok_done(Inline.Link([Inline.Text(body)], "mailto:" + body, "")));
            p.pos = j + 1;
            true
        },
        Option.None => false,
    }
}

// `]`: cierra el `[`/`![` activo más cercano como enlace/imagen/nota, o queda literal.
fn scan_close_bracket(p: Ip) {
    let s = p.s;
    var oi = p.toks.len() - 1;
    while (oi >= 0 && p.toks[oi].kind != T_BRACKET) {
        oi = oi - 1;
    }
    if (oi < 0) {
        push_text(p, "]");
        p.pos = p.pos + 1;
        return;
    }
    let opener = p.toks[oi];
    if (!opener.active) {
        drop_bracket(p, oi);
        push_text(p, "]");
        p.pos = p.pos + 1;
        return;
    }
    let raw = s.substring(opener.pos, p.pos);
    // Nota al pie `[^etiqueta]` (solo si está definida).
    if (!opener.image
        && raw.starts_with("^")
        && raw.len() > 1
        && p.refs.contains_key("^" + raw.substring(1, raw.len()))) {
        truncate_toks(p, oi);
        p.toks.push(tok_done(Inline.FootnoteRef(raw.substring(1, raw.len()))));
        p.pos = p.pos + 1;
        return;
    }
    var dest = "";
    var title = "";
    var end = 0 - 1;
    // 1. Enlace inline `(destino "título")`.
    if (char_at(s, p.pos + 1) == '(') {
        match (parse_inline_link(s, p.pos + 2)) {
            Option.Some(r) => {
                dest = r.0;
                title = r.1;
                end = r.2;
            },
            Option.None => { },
        }
    }
    // 2. Referencia completa `[etiqueta]`, colapsada `[]` o atajo.
    if (end < 0) {
        var label = raw;
        var consumed = p.pos + 1;
        var shortcut = true;
        if (char_at(s, p.pos + 1) == '[') {
            match (scan_link_label(s, p.pos + 1)) {
                Option.Some(l) => {
                    shortcut = false;
                    consumed = l.1;
                    if (l.0 != "") {
                        label = l.0;
                    }
                },
                Option.None => { },
            }
        }
        let key = normalize_label(label);
        let valid = key != "" && label.len() <= 999 && (!shortcut || !raw.contains("["));
        if (valid && p.refs.contains_key(key)) {
            let def = p.refs.get_or(key, ["", ""]);
            dest = decode_entities(def[0]);
            title = decode_entities(def[1]);
            end = consumed;
        }
    }
    if (end < 0) {
        drop_bracket(p, oi);
        push_text(p, "]");
        p.pos = p.pos + 1;
        return;
    }
    process_emphasis(p, oi + 1);
    var kids: [Tok] = [];
    var k = oi + 1;
    while (k < p.toks.len()) {
        kids.push(p.toks[k]);
        k = k + 1;
    }
    let inner = finish(kids);
    truncate_toks(p, oi);
    if (opener.image) {
        p.toks.push(tok_done(Inline.Image(inline_plain_text(inner), dest, title)));
    } else {
        p.toks.push(tok_done(Inline.Link(inner, dest, title)));
        // Sin enlaces anidados: los `[` anteriores quedan inactivos.
        var m = 0;
        while (m < p.toks.len()) {
            if (p.toks[m].kind == T_BRACKET && !p.toks[m].image) {
                p.toks[m].active = false;
            }
            m = m + 1;
        }
    }
    p.pos = end;
}

// Un corchete que no formó enlace pasa a texto literal.
fn drop_bracket(p: Ip, i: int) {
    let t = p.toks[i];
    t.kind = T_TEXT;
    t.text = if (t.image) { "![" } else { "[" };
}

fn truncate_toks(p: Ip, n: int) {
    var nt: [Tok] = [];
    var i = 0;
    while (i < n) {
        nt.push(p.toks[i]);
        i = i + 1;
    }
    p.toks = nt;
}

// Una etiqueta `[…]` en `i` (sin corchetes sin escapar dentro, ≤ 999 chars): (contenido, fin).
fn scan_link_label(s: string, i: int) -> Option<(string, int)> {
    if (char_at(s, i) != '[') {
        return Option.None;
    }
    var j = i + 1;
    while (j < s.len()) {
        let c = s[j];
        if (c == '\\' && j + 1 < s.len()) {
            j = j + 2;
        } else if (c == ']') {
            let label = s.substring(i + 1, j);
            if (label.len() > 999) {
                return Option.None;
            }
            return Option.Some((label, j + 1));
        } else if (c == '[') {
            return Option.None;
        } else {
            j = j + 1;
        }
    }
    Option.None
}

// El `(destino "título")` de un enlace inline, empezando tras el `(`: (destino, título, fin).
fn parse_inline_link(s: string, start: int) -> Option<(string, string, int)> {
    var i = start;
    while (i < s.len() && is_ws(s[i])) {
        i = i + 1;
    }
    if (i >= s.len()) {
        return Option.None;
    }
    if (s[i] == ')') {
        return Option.Some(("", "", i + 1));
    }
    var dest = "";
    if (s[i] == '<') {
        var k = i + 1;
        var closed = false;
        while (k < s.len() && !closed) {
            let c = s[k];
            if (c == '\\' && k + 1 < s.len()) {
                dest = dest + s.substring(k, k + 2);
                k = k + 2;
            } else if (c == '>') {
                closed = true;
            } else if (c == '<' || c == '\n') {
                return Option.None;
            } else {
                dest = dest + to_string(c);
                k = k + 1;
            }
        }
        if (!closed) {
            return Option.None;
        }
        i = k + 1;
    } else {
        var k = i;
        var depth = 0;
        var stop = false;
        while (k < s.len() && !stop) {
            let c = s[k];
            if (c == '\\' && k + 1 < s.len() && is_ascii_punct(s[k + 1])) {
                dest = dest + s.substring(k, k + 2);
                k = k + 2;
            } else if (is_ws(c) || char_code(c) < 32) {
                stop = true;
            } else if (c == '(') {
                depth = depth + 1;
                dest = dest + "(";
                k = k + 1;
            } else if (c == ')') {
                if (depth == 0) {
                    stop = true;
                } else {
                    depth = depth - 1;
                    dest = dest + ")";
                    k = k + 1;
                }
            } else {
                dest = dest + to_string(c);
                k = k + 1;
            }
        }
        if (depth != 0) {
            return Option.None;
        }
        i = k;
    }
    let after_dest = i;
    while (i < s.len() && is_ws(s[i])) {
        i = i + 1;
    }
    var title = "";
    if (i < s.len() && i > after_dest && (s[i] == '"' || s[i] == '\'' || s[i] == '(')) {
        let close = if (s[i] == '(') { ')' } else { s[i] };
        var k = i + 1;
        var closed = false;
        while (k < s.len() && !closed) {
            let c = s[k];
            if (c == '\\' && k + 1 < s.len()) {
                title = title + s.substring(k, k + 2);
                k = k + 2;
            } else if (c == close) {
                closed = true;
            } else if (c == '(' && close == ')') {
                return Option.None;
            } else {
                title = title + to_string(c);
                k = k + 1;
            }
        }
        if (!closed) {
            return Option.None;
        }
        i = k + 1;
        while (i < s.len() && is_ws(s[i])) {
            i = i + 1;
        }
    }
    if (i >= s.len() || s[i] != ')') {
        return Option.None;
    }
    Option.Some((clean_dest(dest), clean_dest(title), i + 1))
}

// ¿Pueden emparejarse este opener y este closer? (regla del múltiplo de 3 de la spec; los
// `~` exigen la misma longitud.)
fn emph_can_match(o: Tok, c: Tok) -> bool {
    if (o.ch == '~') {
        return o.count == c.count;
    }
    if ((o.can_close || c.can_open) && (o.orig + c.orig) % 3 == 0) {
        return o.orig % 3 == 0 && c.orig % 3 == 0;
    }
    true
}

// Empareja delimitadores de énfasis en `toks[start..]` construyendo Emph/Strong/Strike.
fn process_emphasis(p: Ip, start: int) {
    var i = start;
    while (i < p.toks.len()) {
        let t = p.toks[i];
        if (t.kind != T_DELIM || !t.can_close) {
            i = i + 1;
        } else {
            var j = i - 1;
            var found = 0 - 1;
            while (j >= start && found < 0) {
                let o = p.toks[j];
                if (o.kind == T_DELIM && o.ch == t.ch && o.can_open && emph_can_match(o, t)) {
                    found = j;
                }
                j = j - 1;
            }
            if (found < 0) {
                if (!t.can_open) {
                    t.kind = T_TEXT;
                    t.text = to_string(t.ch).repeat(t.count);
                }
                i = i + 1;
            } else {
                let o = p.toks[found];
                let use = if (t.ch == '~') {
                    t.count
                } else if (o.count >= 2 && t.count >= 2) {
                    2
                } else {
                    1
                };
                var kids: [Tok] = [];
                var k = found + 1;
                while (k < i) {
                    kids.push(p.toks[k]);
                    k = k + 1;
                }
                let inner = finish(kids);
                let node = if (t.ch == '~') {
                    Inline.Strike(inner)
                } else if (use == 2) {
                    Inline.Strong(flatten_strong(inner))
                } else {
                    Inline.Emph(inner)
                };
                o.count = o.count - use;
                t.count = t.count - use;
                var nt: [Tok] = [];
                var m = 0;
                while (m < found) {
                    nt.push(p.toks[m]);
                    m = m + 1;
                }
                if (o.count > 0) {
                    nt.push(o);
                }
                nt.push(tok_done(node));
                let next = nt.len();
                if (t.count > 0) {
                    nt.push(t);
                }
                m = i + 1;
                while (m < p.toks.len()) {
                    nt.push(p.toks[m]);
                    m = m + 1;
                }
                p.toks = nt;
                i = next;
            }
        }
    }
}

// cmark-gfm aplana la negrita directamente anidada en negrita (`****foo****` → un solo
// <strong>): los hijos Strong se sustituyen por su contenido.
fn flatten_strong(xs: [Inline]) -> [Inline] {
    var out: [Inline] = [];
    for x in xs {
        match (x) {
            Inline.Strong(inner) => {
                for y in inner {
                    out.push(y);
                }
            },
            _ => {
                out.push(x);
            },
        }
    }
    out
}

// Convierte los tokens restantes en inlines (delimitadores y corchetes sueltos → texto),
// fusionando textos adyacentes.
fn finish(toks: [Tok]) -> [Inline] {
    var out: [Inline] = [];
    var text = "";
    var i = 0;
    while (i < toks.len()) {
        let t = toks[i];
        if (t.kind == T_DONE) {
            if (text != "") {
                out.push(Inline.Text(text));
                text = "";
            }
            out.push(t.node[0]);
        } else if (t.kind == T_TEXT) {
            text = text + t.text;
        } else if (t.kind == T_DELIM) {
            text = text + to_string(t.ch).repeat(t.count);
        } else {
            text = text + if (t.image) { "![" } else { "[" };
        }
        i = i + 1;
    }
    if (text != "") {
        out.push(Inline.Text(text));
    }
    out
}

// El texto plano de unos inlines (para el alt de una imagen).
fn inline_plain_text(xs: [Inline]) -> string {
    var out = "";
    var i = 0;
    while (i < xs.len()) {
        match (xs[i]) {
            Inline.Text(t) => {
                out = out + t;
            },
            Inline.Code(t) => {
                out = out + t;
            },
            Inline.Emph(inner) => {
                out = out + inline_plain_text(inner);
            },
            Inline.Strong(inner) => {
                out = out + inline_plain_text(inner);
            },
            Inline.Link(inner, _, _) => {
                out = out + inline_plain_text(inner);
            },
            Inline.Image(alt, _, _) => {
                out = out + alt;
            },
            Inline.Strike(inner) => {
                out = out + inline_plain_text(inner);
            },
            Inline.HardBreak => {
                out = out + "\n";
            },
            Inline.Check(_) => { },
            Inline.FootnoteRef(_) => { },
        }
        i = i + 1;
    }
    out
}

// ---------------------------------------------------------------------------------------------
// Render a HTML
// ---------------------------------------------------------------------------------------------

// Escapa texto para HTML (y comillas: sirve también en atributos).
fn escape_html(s: string) -> string {
    s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&quot;")
}

// Codifica un URL como hace cmark: percent-encoding UTF-8 de todo lo que no sea seguro en un
// href (se conservan los `%` y la puntuación reservada).
fn encode_url(u: string) -> string {
    var out = "";
    for c in u.chars() {
        if (is_alnum(c) || "-._~:/?#@!$&'()*+,;=%".contains(to_string(c))) {
            out = out + to_string(c);
        } else {
            for b in utf8_bytes(char_code(c)) {
                out = out + "%" + hex_byte(b);
            }
        }
    }
    out
}

// Los bytes UTF-8 de un code point.
fn utf8_bytes(n: int) -> [int] {
    if (n < 128) {
        [n]
    } else if (n < 2048) {
        [192 + n / 64, 128 + n % 64]
    } else if (n < 65536) {
        [224 + n / 4096, 128 + (n / 64) % 64, 128 + n % 64]
    } else {
        [240 + n / 262144, 128 + (n / 4096) % 64, 128 + (n / 64) % 64, 128 + n % 64]
    }
}

fn hex_byte(b: int) -> string {
    let digits = "0123456789ABCDEF";
    to_string(digits[b / 16]) + to_string(digits[b % 16])
}

// Neutraliza URLs peligrosas (javascript:, vbscript:, data: no-imagen) → "#".
fn safe_url(u: string) -> string {
    let l = u.to_lower().trim();
    if (l.starts_with("javascript:") || l.starts_with("vbscript:")) {
        return "#";
    }
    if (l.starts_with("data:") && !l.starts_with("data:image/")) {
        return "#";
    }
    u
}

// El atributo title de un enlace/imagen ("" = sin atributo).
fn title_attr(t: string) -> string {
    if (t == "") { "" } else { " title=\"" + escape_html(t) + "\"" }
}

// El atributo de alineación de una celda (formato GFM: align="…"; "" = sin atributo).
fn align_attr(a: string) -> string {
    if (a == "") { "" } else { " align=\"" + a + "\"" }
}

fn render_inlines(xs: [Inline]) -> string {
    var out = "";
    var i = 0;
    while (i < xs.len()) {
        match (xs[i]) {
            Inline.Text(t) => {
                out = out + escape_html(t);
            },
            Inline.Code(t) => {
                out = out + "<code>" + escape_html(t) + "</code>";
            },
            Inline.Emph(inner) => {
                out = out + "<em>" + render_inlines(inner) + "</em>";
            },
            Inline.Strong(inner) => {
                out = out + "<strong>" + render_inlines(inner) + "</strong>";
            },
            Inline.Link(inner, url, title) => {
                out = out
                    + "<a href=\""
                    + escape_html(encode_url(safe_url(url)))
                    + "\""
                    + title_attr(title)
                    + ">"
                    + render_inlines(inner)
                    + "</a>";
            },
            Inline.Image(alt, src, title) => {
                out = out
                    + "<img src=\""
                    + escape_html(encode_url(safe_url(src)))
                    + "\" alt=\""
                    + escape_html(alt)
                    + "\""
                    + title_attr(title)
                    + " />";
            },
            Inline.Strike(inner) => {
                out = out + "<del>" + render_inlines(inner) + "</del>";
            },
            Inline.HardBreak => {
                out = out + "<br />\n";
            },
            Inline.Check(on) => {
                out = out + if (on) {
                    "<input checked=\"\" disabled=\"\" type=\"checkbox\"> "
                } else {
                    "<input disabled=\"\" type=\"checkbox\"> "
                };
            },
            Inline.FootnoteRef(label) => {
                out = out
                    + "<sup><a href=\"#fn-"
                    + escape_html(label)
                    + "\" id=\"fnref-"
                    + escape_html(label)
                    + "\">"
                    + escape_html(label)
                    + "</a></sup>";
            },
        }
        i = i + 1;
    }
    out
}

/// Renders a parsed document back to HTML.
pub fn render(blocks: [Block]) -> string {
    var main: [Block] = [];
    var foots: [Block] = [];
    for b in blocks {
        match (b) {
            Block.FootnoteDef(_, _) => {
                foots.push(b);
            },
            _ => {
                main.push(b);
            },
        }
    }
    var out = render_blocks(main);
    if (foots.len() > 0) {
        out = out + "<section class=\"footnotes\">\n<ol>\n";
        for f in foots {
            match (f) {
                Block.FootnoteDef(label, body) => {
                    out = out
                        + "<li id=\"fn-"
                        + escape_html(label)
                        + "\">\n"
                        + render_blocks(body)
                        + "<a href=\"#fnref-"
                        + escape_html(label)
                        + "\" class=\"footnote-backref\">↩</a>\n</li>\n";
                },
                _ => { },
            }
        }
        out = out + "</ol>\n</section>\n";
    }
    out
}

fn render_blocks(blocks: [Block]) -> string {
    var out = "";
    var i = 0;
    while (i < blocks.len()) {
        out = out + render_block(blocks[i]);
        i = i + 1;
    }
    out
}

// El HTML de un bloque, terminado en '\n' (convenciones del spec de CommonMark).
fn render_block(b: Block) -> string {
    match (b) {
        Block.Heading(lvl, xs) => {
            "<h" + to_string(lvl) + ">" + render_inlines(xs) + "</h" + to_string(lvl) + ">\n"
        },
        Block.Paragraph(xs) => "<p>" + render_inlines(xs) + "</p>\n",
        Block.Plain(xs) => render_inlines(xs) + "\n",
        Block.Code(lang, body) => {
            // M111.c: una cerca ```mermaid emite el contenedor que mermaid.js busca en la
            // página (<pre class="mermaid">, texto escapado) — el render del diagrama es
            // client-side; reimplementarlo server-side no tiene sentido. En el AST sigue
            // siendo Block.Code("mermaid", …): quien renderice distinto decide él.
            if (lang == "mermaid") {
                "<pre class=\"mermaid\">" + escape_html(body) + "</pre>\n"
            } else {
                let cls = if (lang == "") {
                    ""
                } else {
                    " class=\"language-" + escape_html(lang) + "\""
                };
                "<pre><code" + cls + ">" + escape_html(body) + "</code></pre>\n"
            }
        },
        Block.Quote(inner) => "<blockquote>\n" + render_blocks(inner) + "</blockquote>\n",
        Block.Alert(kind, inner) => {
            "<div class=\"markdown-alert markdown-alert-"
                + kind
                + "\">\n<p class=\"markdown-alert-title\">"
                + capitalize(kind)
                + "</p>\n"
                + render_blocks(inner)
                + "</div>\n"
        },
        Block.List(ordered, start, items) => {
            let tag = if (ordered) { "ol" } else { "ul" };
            let attrs = if (ordered && start != 1) {
                " start=\"" + to_string(start) + "\""
            } else {
                ""
            };
            var out = "<" + tag + attrs + ">\n";
            var k = 0;
            while (k < items.len()) {
                out = out + render_item(items[k]);
                k = k + 1;
            }
            out + "</" + tag + ">\n"
        },
        Block.Rule => "<hr />\n",
        Block.Table(aligns, header, rows) => {
            var out = "<table>\n<thead>\n<tr>\n";
            var c = 0;
            while (c < header.len()) {
                out = out
                    + "<th"
                    + align_attr(aligns[c])
                    + ">"
                    + render_inlines(header[c])
                    + "</th>\n";
                c = c + 1;
            }
            out = out + "</tr>\n</thead>\n";
            if (rows.len() > 0) {
                out = out + "<tbody>\n";
                var r = 0;
                while (r < rows.len()) {
                    out = out + "<tr>\n";
                    var k = 0;
                    while (k < rows[r].len()) {
                        out = out
                            + "<td"
                            + align_attr(aligns[k])
                            + ">"
                            + render_inlines(rows[r][k])
                            + "</td>\n";
                        k = k + 1;
                    }
                    out = out + "</tr>\n";
                    r = r + 1;
                }
                out = out + "</tbody>\n";
            }
            out + "</table>\n"
        },
        Block.FootnoteDef(_, _) => "",
    }
}

fn capitalize(s: string) -> string {
    if (s == "") { s } else { s.substring(0, 1).to_upper() + s.substring(1, s.len()) }
}

// Un ítem: `<li>` pegado al texto en las listas apretadas, en línea propia en las sueltas.
fn render_item(blocks: [Block]) -> string {
    if (blocks.len() == 0) {
        return "<li></li>\n";
    }
    var out = "<li>";
    var i = 0;
    while (i < blocks.len()) {
        let html = render_block(blocks[i]);
        match (blocks[i]) {
            Block.Plain(_) => {
                // Texto apretado: sin '\n' antes; el '\n' de cierre solo si sigue otro bloque.
                let text = html.substring(0, html.len() - 1);
                out = out + text;
                if (i + 1 < blocks.len()) {
                    out = out + "\n";
                }
            },
            _ => {
                if (i == 0) {
                    out = out + "\n";
                }
                out = out + html;
            },
        }
        i = i + 1;
    }
    out + "</li>\n"
}

/// Converts Markdown straight to HTML (`render(parse(md))`).
pub fn to_html(md: string) -> string {
    render(parse(md))
}
