// Contraseñas con std/crypto (M290): PBKDF2-HMAC-SHA256, vectores oficiales (RFC 7914 §11) y el
// flujo password_hash/password_verify. Golden de tres motores: tests/password_hash_cli.rs.
import std/crypto;
import std/hex;

fn or_empty(o: Option<bytes>) -> bytes {
    match (o) {
        Option.Some(b) => b,
        Option.None => {
            let none: [int] = [];
            bytes_of(none)
        },
    }
}

fn main() -> int {
    // RFC 7914 §11: PBKDF2-HMAC-SHA256 ("passwd", "salt", c = 1, dkLen = 64) y ("Password", "NaCl", 80000, 64).
    let v1 = crypto.pbkdf2_hmac_sha256("passwd".to_bytes(), "salt".to_bytes(), 1, 64);
    let v2 = crypto.pbkdf2_hmac_sha256("Password".to_bytes(), "NaCl".to_bytes(), 80000, 64);
    print("v1 ${hex.hex_encode(or_empty(v1))}");
    print("v2 ${hex.hex_encode(or_empty(v2))}");
    print(
        "iteraciones 0: ${crypto.pbkdf2_hmac_sha256("x".to_bytes(), "s".to_bytes(), 0, 32).is_none()}"
    );
    print(
        "len 1025:      ${crypto.pbkdf2_hmac_sha256("x".to_bytes(), "s".to_bytes(), 1, 1025).is_none()}"
    );

    // El flujo de una app: guardar `h`, comprobar después. Iteraciones bajas SOLO para el ejemplo.
    let h = crypto.password_hash_with("correct horse battery staple", 1000);
    print("formato:       ${h.starts_with("$pbkdf2-sha256$1000$")} ${h.len()}");
    print("verify ok:     ${crypto.password_verify("correct horse battery staple", h)}");
    print("verify mal:    ${crypto.password_verify("Correct horse battery staple", h)}");
    print(
        "malformado:    ${crypto.password_verify("x", "$pbkdf2-sha256$1000$zz$zz")} ${crypto.password_verify("x", "")} ${crypto.password_verify("x", "$md5$1$00$00")}"
    );
    print("default:       ${crypto.PASSWORD_ITERATIONS}");
    0
}
