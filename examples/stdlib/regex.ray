// M29.1 — motor de expresiones regulares en raylang puro.
//
// Enfoque: la "máquina virtual de regex" de Russ Cox (Thompson NFA). El patrón se compila a un
// pequeño programa de bytecode (Char/Any/Class/Match/Jmp/Split + aserciones de posición) y se simula
// manteniendo el CONJUNTO de hilos activos a la vez → tiempo lineal, sin el blowup exponencial del
// backtracking. Cero cambios de runtime: solo enums, structs, arreglos y recursión.
//
// M29.1a (núcleo): literales, `.`, `*` `+` `?`, alternancia `|`, grupos `( )`, concatenación.
// M29.1b: clases `[...]`/`[^...]` con rangos, escapes `\d`/`\w`/`\s` (y `\D`/`\W`/`\S`), anclas `^`/`$`.
// M81: **Pike VM** — grupos de CAPTURA (`captures`/`captures_str`; `(?:)` no captura),
// cuantificadores `{n}`/`{n,}`/`{n,m}` (expandidos en el parser, tope 512) y LAZY
// (`*?` `+?` `??` `{n,m}?`). Semántica **leftmost-first** (Perl): la prioridad de los hilos
// (orden de brazos del Split) decide, greedy prefiere repetir y lazy salir. (Antes:
// leftmost-longest; para los patrones habituales greedy coinciden.)
// M59.2: `compile(pat) -> Result<Regex, string>` (patrón compilado como valor, error como valor)
// + trait `Matcher` con los mismos seis nombres como métodos (sin recompilar por llamada).
// Las funciones libres (patrón string) se conservan: compilan en cada llamada y PANICAN con
// patrón malformado (contrato histórico); para patrones de usuario/config, `compile`.
// Un rango de caracteres `lo..hi` (ambos inclusive). Un carácter suelto es el rango `c..c`.
struct Range {
    lo: char,
    hi: char,
}

// Una clase de caracteres `[...]`: un conjunto de rangos, opcionalmente negado (`[^...]`).
struct Class {
    neg: bool,
    ranges: [Range],
}

// Una instrucción de la máquina. op:
//   0 Char(c):    si el carácter de entrada es `c`, el hilo avanza a pc+1; si no, muere.
//   1 Any:        casa con cualquier carácter; avanza a pc+1.
//   2 Match:      estado de aceptación.
//   3 Jmp(x):     salto incondicional (epsilon) a `x`.
//   4 Split(x,y): bifurca en dos hilos (epsilon), a `x` y a `y`.
//   5 Class(x):   casa si el carácter satisface `classes[x]`; avanza a pc+1.
//   6 AssertStart: aserción de ancho cero `^`; el hilo sigue solo en la posición 0.
//   7 AssertEnd:   aserción de ancho cero `$`; el hilo sigue solo al final del texto.
//   8 Save(x):     M81 — guarda la posición actual en la ranura de captura `x` (epsilon).
struct Inst {
    op: int,
    x: int,
    y: int,
    c: char,
}

// El programa compilado: las instrucciones y la tabla de clases (a la que apuntan las Class
// por índice). M81: `nsaves` = ranuras de captura (2 por grupo, incluido el 0 = match entero);
// `ngroups` = grupos de captura + 1 (para dimensionar el resultado de `captures`).
struct Prog {
    insts: [Inst],
    classes: [Class],
    nsaves: int,
    ngroups: int,
    // R5 (perf, 22 jul 2026): el patrón FUENTE. En la VM no se usa (la Pike VM ejecuta insts);
    // el backend nativo intercepta las funciones `run_*` y ejecuta este patrón —ya VALIDADO por
    // el parser de arriba— con el crate `regex` de ray-runtime (semántica traducida; ver
    // docs/bench-regex-plan.md §R5). El parseo/los errores siguen siendo los de esta librería.
    pat: string,
}

// El AST del patrón. Recursivo: en raylang los enums son objetos del heap (semántica de referencia),
// así que un payload puede volver a ser un `Re` sin tamaño infinito.
// M81: `Star`/`Plus`/`Opt` llevan el flag **lazy** (`*?` `+?` `??`: prefieren salir del
// bucle antes que repetir — con la Pike VM la pereza es solo el ORDEN de los brazos del
// Split). `Group(re, g)` es un grupo de CAPTURA con índice `g` (1..; el 0 es el match
// entero); `(?:...)` agrupa sin capturar (no genera nodo Group). `{n,m}` no tiene nodo:
// el parser lo EXPANDE (los nodos se comparten — compilar el mismo nodo dos veces emite
// dos copias, sin clonar).
enum Re {
    Empty,
    Lit(char),
    Any,
    ClassRe(Class),
    AnchorStart,
    AnchorEnd,
    Concat(Re, Re),
    Alt(Re, Re),
    Star(Re, bool),
    Plus(Re, bool),
    Opt(Re, bool),
    Group(Re, int),
}

// ---------------------------------------------------------------------------
// Clases predefinidas: `\d` `\w` `\s`. Devuelven la lista de rangos correspondiente.
// ---------------------------------------------------------------------------
fn ranges_digit() -> [Range] {
    var r: [Range] = [];
    r.push(Range { lo: '0', hi: '9' });
    r
}

fn ranges_word() -> [Range] {
    var r: [Range] = [];
    r.push(Range { lo: '0', hi: '9' });
    r.push(Range { lo: 'A', hi: 'Z' });
    r.push(Range { lo: 'a', hi: 'z' });
    r.push(Range { lo: '_', hi: '_' });
    r
}

fn ranges_space() -> [Range] {
    var r: [Range] = [];
    r.push(Range { lo: ' ', hi: ' ' });
    r.push(Range { lo: '\t', hi: '\t' });
    r.push(Range { lo: '\n', hi: '\n' });
    r.push(Range { lo: '\r', hi: '\r' });
    r
}

// ---------------------------------------------------------------------------
// Parser del patrón (descenso recursivo).
//   alt    := concat ('|' concat)*
//   concat := repeat*
//   repeat := atom ('*' | '+' | '?')*
//   atom   := '(' alt ')' | '[' class ']' | '.' | '^' | '$' | '\' esc | char
// ---------------------------------------------------------------------------
struct PS {
    pat: [char],
    pos: int,
    // M81: contador de grupos de captura (el siguiente índice libre; empieza en 1 —
    // el 0 es el match entero). Se asigna por orden del '(' de APERTURA, como Perl.
    ngroups: int,
}

fn ps_at_end(p: PS) -> bool { p.pos >= p.pat.len() }

fn ps_peek(p: PS) -> char { p.pat[p.pos] }  // el llamador comprueba at_end antes

fn ps_peek2(p: PS) -> char { p.pat[p.pos + 1] }  // el llamador garantiza que hay 2 más

fn ps_advance(p: PS) -> char {
    let c = p.pat[p.pos];
    p.pos = p.pos + 1;
    c
}

// Traduce un carácter escapado a su valor (dentro o fuera de una clase): `\n` `\t` `\r`, o el propio
// carácter para un metacarácter literal (`\.` `\*` `\[` `\\` `\-` `\^` …).
fn unescape(e: char) -> char {
    if (e == 'n') { '\n' } else if (e == 't') { '\t' } else if (e == 'r') { '\r' } else { e }
}

// M59.2: el parser del patrón devuelve Result (errores como valores); los antiguos `panic`
// pasan a `Err` con el mismo mensaje. Propagación con `?` fase a fase.
fn parse_alt(p: PS) -> Result<Re, string> {
    var node = parse_concat(p)?;
    while (!ps_at_end(p) && ps_peek(p) == '|') {
        ps_advance(p);
        let rhs = parse_concat(p)?;
        node = Re.Alt(node, rhs);
    }
    Result.Ok(node)
}

fn parse_concat(p: PS) -> Result<Re, string> {
    var node = Re.Empty;
    var primero = true;
    while (!ps_at_end(p) && ps_peek(p) != '|' && ps_peek(p) != ')') {
        let r = parse_repeat(p)?;
        if (primero) {
            node = r;
            primero = false;
        } else {
            node = Re.Concat(node, r);
        }
    }
    Result.Ok(node)
}

// M81: tras `* + ?` (y `{n,m}`) un `?` extra hace el cuantificador LAZY. Un `{` solo
// es cuantificador si le sigue un dígito (si no, es un `{` literal, como en Perl).
fn parse_repeat(p: PS) -> Result<Re, string> {
    var node = parse_atom(p)?;
    while (!ps_at_end(p) && (ps_peek(p) == '*' || ps_peek(p) == '+' || ps_peek(p) == '?' || rep_abre(p))) {
        let op = ps_advance(p);
        if (op == '{') {
            node = parse_bounds(p, node)?;
        } else {
            let lazy = quant_lazy(p);
            if (op == '*') {
                node = Re.Star(node, lazy);
            } else if (op == '+') {
                node = Re.Plus(node, lazy);
            } else {
                node = Re.Opt(node, lazy);
            }
        }
    }
    Result.Ok(node)
}

// ¿El cursor está sobre un `{` de cuantificador (`{` + dígito)?
fn rep_abre(p: PS) -> bool {
    if (ps_peek(p) != '{') {
        return false;
    }
    p.pos + 1 < p.pat.len() && es_digito(p.pat[p.pos + 1])
}

fn es_digito(c: char) -> bool { '0' <= c && c <= '9' }

// ¿Sigue un `?` (sufijo lazy)? Lo consume si está.
fn quant_lazy(p: PS) -> bool {
    if (!ps_at_end(p) && ps_peek(p) == '?') {
        ps_advance(p);
        return true;
    }
    false
}

// Lee un entero decimal del patrón (al menos un dígito, garantizado por el llamador).
fn parse_num(p: PS) -> int {
    var v = 0;
    while (!ps_at_end(p) && es_digito(ps_peek(p))) {
        let c = ps_advance(p);
        v = v * 10 + ((c as int) - ('0' as int));
    }
    v
}

// M81: `{n}` / `{n,}` / `{n,m}` (el `{` ya se consumió; el llamador garantizó el dígito).
// Se EXPANDE en el parser: X{n} = n copias; X{n,} = n copias + X*; X{n,m} = n copias +
// (m−n) opcionales anidados (X(X(X)?)?…). El sufijo `?` hace lazy los opcionales/estrella.
// Tope m ≤ 512 (la expansión es código emitido; un tope evita el blowup).
fn parse_bounds(p: PS, node: Re) -> Result<Re, string> {
    let n = parse_num(p);
    var m = n;
    var abierto = false;  // `{n,}`
    if (!ps_at_end(p) && ps_peek(p) == ',') {
        ps_advance(p);
        if (!ps_at_end(p) && es_digito(ps_peek(p))) {
            m = parse_num(p);
        } else {
            abierto = true;
        }
    }
    if (ps_at_end(p) || ps_peek(p) != '}') {
        return Result.Err("regex: falta '}' en el cuantificador {n,m}");
    }
    ps_advance(p);  // '}'
    let lazy = quant_lazy(p);
    if (!abierto && m < n) {
        return Result.Err("regex: cuantificador {n,m} con m < n");
    }
    if (m > 512 || n > 512) {
        return Result.Err("regex: cuantificador {n,m} demasiado grande (tope 512)");
    }
    // n copias obligatorias…
    var out = Re.Empty;
    var primero = true;
    var i = 0;
    while (i < n) {
        if (primero) {
            out = node;
            primero = false;
        } else {
            out = Re.Concat(out, node);
        }
        i = i + 1;
    }
    // …y la cola: `X*` si es abierto, o (m−n) opcionales anidados de dentro afuera.
    if (abierto) {
        let cola = Re.Star(node, lazy);
        if (primero) {
            return Result.Ok(cola);
        }
        return Result.Ok(Re.Concat(out, cola));
    }
    var extra = m - n;
    var cola = Re.Empty;
    var hay_cola = false;
    while (extra > 0) {
        if (hay_cola) {
            cola = Re.Opt(Re.Concat(node, cola), lazy);
        } else {
            cola = Re.Opt(node, lazy);
            hay_cola = true;
        }
        extra = extra - 1;
    }
    if (hay_cola) {
        if (primero) {
            return Result.Ok(cola);
        }
        return Result.Ok(Re.Concat(out, cola));
    }
    Result.Ok(out)
}

fn parse_atom(p: PS) -> Result<Re, string> {
    let c = ps_peek(p);
    if (c == '(') {
        ps_advance(p);
        // M81: `(?:...)` agrupa SIN capturar; `(...)` captura con índice por orden
        // de apertura (1..; el 0 es el match entero).
        var g = 0 - 1;
        if (p.pos + 1 < p.pat.len() && ps_peek(p) == '?' && ps_peek2(p) == ':') {
            ps_advance(p);
            ps_advance(p);
        } else {
            g = p.ngroups;
            p.ngroups = p.ngroups + 1;
        }
        let inner = parse_alt(p)?;
        if (!ps_at_end(p) && ps_peek(p) == ')') {
            ps_advance(p);
        } else {
            return Result.Err("regex: falta ')'");
        }
        if (g >= 0) {
            return Result.Ok(Re.Group(inner, g));
        }
        return Result.Ok(inner);
    }
    if (c == '[') {
        ps_advance(p);
        return Result.Ok(Re.ClassRe(parse_class(p)?));
    }
    if (c == '.') {
        ps_advance(p);
        return Result.Ok(Re.Any);
    }
    if (c == '^') {
        ps_advance(p);
        return Result.Ok(Re.AnchorStart);
    }
    if (c == '$') {
        ps_advance(p);
        return Result.Ok(Re.AnchorEnd);
    }
    if (c == '\\') {
        ps_advance(p);  // consume la barra
        if (ps_at_end(p)) {
            return Result.Err("regex: '\\' al final del patrón");
        }
        let e = ps_advance(p);
        return Result.Ok(escape_atom(e));
    }
    ps_advance(p);
    Result.Ok(Re.Lit(c))
}

// Un escape en posición de átomo: clase predefinida (`\d`/`\w`/`\s` y negadas) o literal (`\.` `\n` …).
fn escape_atom(e: char) -> Re {
    if (e == 'd') { Re.ClassRe(Class { neg: false, ranges: ranges_digit() }) } else if (e == 'D') { Re.ClassRe(Class { neg: true, ranges: ranges_digit() }) } else if (e == 'w') { Re.ClassRe(Class { neg: false, ranges: ranges_word() }) } else if (e == 'W') { Re.ClassRe(Class { neg: true, ranges: ranges_word() }) } else if (e == 's') { Re.ClassRe(Class { neg: false, ranges: ranges_space() }) } else if (e == 'S') { Re.ClassRe(Class { neg: true, ranges: ranges_space() }) } else { Re.Lit(unescape(e)) }
}

// Parsea el interior de `[...]` (el '[' ya se consumió); deja el cursor tras el ']'.
fn parse_class(p: PS) -> Result<Class, string> {
    var neg = false;
    if (!ps_at_end(p) && ps_peek(p) == '^') {
        ps_advance(p);
        neg = true;
    }
    var ranges: [Range] = [];
    while (!ps_at_end(p) && ps_peek(p) != ']') {
        if (ps_peek(p) == '\\') {
            ps_advance(p);  // barra
            if (ps_at_end(p)) {
                return Result.Err("regex: '\\' al final de la clase");
            }
            let e = ps_advance(p);
            // Clases predefinidas dentro de la clase: se fusionan sus rangos.
            if (e == 'd') {
                append_all(ranges, ranges_digit());
            } else if (e == 'w') {
                append_all(ranges, ranges_word());
            } else if (e == 's') {
                append_all(ranges, ranges_space());
            } else {
                push_item(p, ranges, unescape(e))?;
            }
        } else {
            let c = ps_advance(p);
            push_item(p, ranges, c)?;
        }
    }
    if (ps_at_end(p)) {
        return Result.Err("regex: falta ']' para cerrar la clase");
    }
    ps_advance(p);  // consume ']'
    Result.Ok(Class { neg: neg, ranges: ranges })
}

fn append_all(dst: [Range], src: [Range]) {
    var i = 0;
    while (i < src.len()) {
        dst.push(src[i]);
        i = i + 1;
    }
}

// Añade `lo` como rango: si le sigue `-` y el carácter tras el guion no es `]`, es un rango `lo-hi`.
// (Devuelve Result para propagar el error de un `\` colgante; el Ok(0) es solo relleno —
// `unit` no es nombrable como argumento de tipo.)
fn push_item(p: PS, ranges: [Range], lo: char) -> Result<int, string> {
    if (!ps_at_end(p) && ps_peek(p) == '-' && p.pos + 1 < p.pat.len() && ps_peek2(p) != ']') {
        ps_advance(p);  // '-'
        var hi = ps_advance(p);
        if (hi == '\\') {
            if (ps_at_end(p)) {
                return Result.Err("regex: '\\' al final de la clase");
            }
            hi = unescape(ps_advance(p));
        }
        ranges.push(Range { lo: lo, hi: hi });
    } else {
        ranges.push(Range { lo: lo, hi: lo });
    }
    Result.Ok(0)
}

// ---------------------------------------------------------------------------
// Compilación Re → programa (con parcheo de saltos hacia delante).
// ---------------------------------------------------------------------------
fn emit(prog: Prog, op: int, x: int, y: int, c: char) -> int {
    let pos = prog.insts.len();
    prog.insts.push(Inst { op: op, x: x, y: y, c: c });
    pos
}

fn compile_re(re: Re, prog: Prog) {
    match (re) {
        Re.Empty => { },
        Re.Lit(c) => {
            emit(prog, 0, 0, 0, c);
        },
        Re.Any => {
            emit(prog, 1, 0, 0, ' ');
        },
        Re.ClassRe(cl) => {
            let idx = prog.classes.len();
            prog.classes.push(cl);
            emit(prog, 5, idx, 0, ' ');
        },
        Re.AnchorStart => {
            emit(prog, 6, 0, 0, ' ');
        },
        Re.AnchorEnd => {
            emit(prog, 7, 0, 0, ' ');
        },
        Re.Concat(a, b) => {
            compile_re(a, prog);
            compile_re(b, prog);
        },
        Re.Alt(a, b) => {
            // Split L1, L2 ; L1: <a> ; Jmp L3 ; L2: <b> ; L3:
            let sp = emit(prog, 4, 0, 0, ' ');
            let si = prog.insts[sp];
            si.x = prog.insts.len();
            compile_re(a, prog);
            let jp = emit(prog, 3, 0, 0, ' ');
            si.y = prog.insts.len();
            compile_re(b, prog);
            let ji = prog.insts[jp];
            ji.x = prog.insts.len();
        },
        // M81: en la Pike VM la prioridad es el ORDEN de los brazos del Split (x antes
        // que y). Greedy prefiere el cuerpo (repetir); lazy prefiere la salida.
        Re.Star(a, lazy) => {
            // L1: Split L2, L3 ; L2: <a> ; Jmp L1 ; L3:   (lazy: Split L3, L2)
            let sp = emit(prog, 4, 0, 0, ' ');
            let si = prog.insts[sp];
            let cuerpo = prog.insts.len();
            compile_re(a, prog);
            emit(prog, 3, sp, 0, ' ');
            let salida = prog.insts.len();
            if (lazy) {
                si.x = salida;
                si.y = cuerpo;
            } else {
                si.x = cuerpo;
                si.y = salida;
            }
        },
        Re.Plus(a, lazy) => {
            // L1: <a> ; Split L1, L3 ; L3:   (lazy: Split L3, L1)
            let l1 = prog.insts.len();
            compile_re(a, prog);
            let sp = emit(prog, 4, l1, 0, ' ');
            let si = prog.insts[sp];
            let salida = prog.insts.len();
            if (lazy) {
                si.x = salida;
                si.y = l1;
            } else {
                si.y = salida;
            }
        },
        Re.Opt(a, lazy) => {
            // Split L1, L2 ; L1: <a> ; L2:   (lazy: Split L2, L1)
            let sp = emit(prog, 4, 0, 0, ' ');
            let si = prog.insts[sp];
            let cuerpo = prog.insts.len();
            compile_re(a, prog);
            let salida = prog.insts.len();
            if (lazy) {
                si.x = salida;
                si.y = cuerpo;
            } else {
                si.x = cuerpo;
                si.y = salida;
            }
        },
        Re.Group(a, g) => {
            // Save(2g) ; <a> ; Save(2g+1)
            emit(prog, 8, 2 * g, 0, ' ');
            compile_re(a, prog);
            emit(prog, 8, 2 * g + 1, 0, ' ');
        },
    }
}

fn compile_pattern(pattern: string) -> Result<Prog, string> {
    let p = PS { pat: pattern.chars(), pos: 0, ngroups: 1 };
    let re = parse_alt(p)?;
    if (!ps_at_end(p)) {
        return Result.Err("regex: carácter inesperado en el patrón (¿')' de más?)");
    }
    var insts: [Inst] = [];
    var classes: [Class] = [];
    let prog = Prog { insts: insts, classes: classes, nsaves: 2 * p.ngroups, ngroups: p.ngroups, pat: pattern };
    // M81: el match entero es el grupo 0 — Save(0) al entrar, Save(1) antes del Match.
    emit(prog, 8, 0, 0, ' ');
    compile_re(re, prog);
    emit(prog, 8, 1, 0, ' ');
    emit(prog, 2, 0, 0, ' ');  // Match final
    Result.Ok(prog)
}

// M59.2 — el patrón compilado como VALOR: compila una vez, casa muchas (las funciones libres
// de abajo recompilan el patrón en CADA llamada; con un Regex el coste de compilar se paga una).
/// A compiled regular expression. Build one with `compile`; then match with the
/// `Matcher` methods (`full_match`/`search`/`find`/`find_str`/`find_all`/`replace_all`)
/// without recompiling the pattern on every call.
pub struct Regex {
    prog: Prog,
}

// Compila un patrón a un `Regex`, con el error como VALOR (las funciones libres panican).
/// Compiles a pattern into a reusable `Regex`. Err (instead of panicking, unlike the
/// free-function API) on a malformed pattern: unbalanced `(`/`)`, unclosed `[...]`,
/// or a trailing `\`.
pub fn compile(pattern: string) -> Result<Regex, string> {
    match (compile_pattern(pattern)) {
        Result.Ok(p) => Result.Ok(Regex { prog: p }),
        Result.Err(e) => Result.Err(e),
    }
}

// El puente de compat: las funciones libres (patrón como string) compilan en cada llamada y
// conservan su contrato histórico (patrón malformado = panic, con el mismo mensaje).
fn must_compile(pattern: string) -> Prog {
    match (compile_pattern(pattern)) {
        Result.Ok(p) => p,
        Result.Err(e) => panic(e),
    }
}

// ---------------------------------------------------------------------------
// Simulación (Thompson): conjunto de hilos activos. `pos`/`n` dan la posición para las aserciones.
// ---------------------------------------------------------------------------
// R1 (perf, 22 jul 2026): el set `seen` de la Pike VM funciona por GENERACIONES — un solo
// `[int]` asignado por ejecución (0 = nunca visto) y un contador que se incrementa por posición;
// `seen[pc] == gen` marca "visto en esta posición". Antes era un `[bool]` RE-ALOCADO y re-llenado
// con un bucle de push POR POSICIÓN del texto (el hotspot nº 1 del perfil: ~7.4M allocs en el
// bench regex de 200k líneas).
fn new_ints(n: int) -> [int] {
    var b: [int] = [];
    var i = 0;
    while (i < n) {
        b.push(0);
        i = i + 1;
    }
    b
}

fn class_matches(cl: Class, ch: char) -> bool {
    var m = false;
    var i = 0;
    while (i < cl.ranges.len()) {
        let r = cl.ranges[i];
        if (r.lo <= ch && ch <= r.hi) {
            m = true;
        }
        i = i + 1;
    }
    if (cl.neg) { !m } else { m }
}

// M81 — la simulación pasa de conjuntos de pc a la **Pike VM**: cada hilo lleva sus
// ranuras de captura, y la LISTA está ordenada por PRIORIDAD (el hilo k manda sobre el
// k+1). La prioridad la fija el orden de los brazos de cada Split (greedy/lazy) y da la
// semántica **leftmost-first** de Perl (antes: leftmost-longest); las capturas y los
// cuantificadores lazy solo tienen sentido con ella. Sigue siendo tiempo lineal: el
// dedup por `seen` acota los hilos a |insts| por posición.

// Copia las ranuras de captura de un hilo (copy-on-write en Save).
// R4 (perf, 22 jul 2026): copiar vía la CONCATENACIÓN nativa de arreglos (`s + []` es un solo
// opcode que clona en Rust) en vez de un bucle de push por elemento (interpretado en la VM,
// con growth por duplicación en ambos motores). copy_saves corre una vez por `Save` cruzado
// por hilo (copy-on-write) — es el 3er hotspot del perfil.
fn copy_saves(s: [int]) -> [int] {
    var empty: [int] = [];
    s + empty
}

fn new_saves(n: int) -> [int] {
    var s: [int] = [];
    var i = 0;
    while (i < n) {
        s.push(0 - 1);
        i = i + 1;
    }
    s
}

// Sigue los epsilon (Jmp/Split/Save) y las aserciones (`^`/`$`) desde `pc`, añadiendo los
// pc "consumidores" (Char/Any/Class/Match) a las listas paralelas `pcs`/`svs` EN ORDEN de
// prioridad. `seen` deduplica: el primer hilo (mayor prioridad) que llega a un pc gana.
// R4b (reusar las listas de hilos entre posiciones vía un struct con longitud manual) se EVALUÓ
// y DESCARTÓ por medición (22 jul 2026): nativo −9%, pero la VM +17% — el acceso a campos por
// nombre (GetField) por hilo cuesta más que las 2 allocs/posición ahorradas. Reevaluar solo si
// la VM gana acceso a campos por índice (P1.3, GetFieldIdx).
fn add_thread(prog: Prog, pcs: [int], svs: [[int]], seen: [int], gen: int, pc: int, saves: [int], pos: int, n: int) {
    if (seen[pc] == gen) {
        return;
    }
    seen[pc] = gen;
    let ins = prog.insts[pc];
    if (ins.op == 3) {
        // Jmp
        add_thread(prog, pcs, svs, seen, gen, ins.x, saves, pos, n);
    } else if (ins.op == 4) {
        // Split: x primero (mayor prioridad), y después.
        add_thread(prog, pcs, svs, seen, gen, ins.x, saves, pos, n);
        add_thread(prog, pcs, svs, seen, gen, ins.y, saves, pos, n);
    } else if (ins.op == 6) {
        // AssertStart `^`
        if (pos == 0) {
            add_thread(prog, pcs, svs, seen, gen, pc + 1, saves, pos, n);
        }
    } else if (ins.op == 7) {
        // AssertEnd `$`
        if (pos == n) {
            add_thread(prog, pcs, svs, seen, gen, pc + 1, saves, pos, n);
        }
    } else if (ins.op == 8) {
        // Save: copia las ranuras (otros hilos comparten las viejas) y sigue.
        let ns = copy_saves(saves);
        ns[ins.x] = pos;
        add_thread(prog, pcs, svs, seen, gen, pc + 1, ns, pos, n);
    } else {
        // Char / Any / Class / Match
        pcs.push(pc);
        svs.push(saves);
    }
}

// El corazón del motor: corre la Pike VM sobre `txt[start..]` y devuelve las ranuras de
// captura del match (leftmost-first), o None.
//   `seed`: siembra un hilo nuevo por posición (búsqueda NO anclada) mientras no haya match.
//   `full`: solo acepta un Match al consumir TODO el texto (full_match) — y entonces un
//           Match prematuro no corta (el hilo muere; los demás siguen).

// R2 (perf, 22 jul 2026): ¿el programa está ANCLADO a `^`? Cierto si desde pc 0, siguiendo solo
// Save (8) y Jmp (3), se llega a AssertStart (6) — sin Splits por medio (una alternancia podría
// tener un brazo no anclado). Con ancla, sembrar un hilo por posición es trabajo muerto: el hilo
// muere en la aserción (pos != 0), pero ya pagó `new_saves` + `add_thread` en CADA posición.
fn is_anchored(prog: Prog) -> bool {
    var pc = 0;
    var pasos = 0;
    while (pasos < prog.insts.len()) {
        let ins = prog.insts[pc];
        if (ins.op == 6) {
            return true;
        } else if (ins.op == 8) {
            pc = pc + 1;
        } else if (ins.op == 3) {
            pc = ins.x;
        } else {
            return false;
        }
        pasos = pasos + 1;
    }
    false
}

fn run_pike(prog: Prog, txt: [char], n: int, start: int, seed: bool, full: bool) -> Option<[int]> {
    var pcs: [int] = [];
    var svs: [[int]] = [];
    let seen = new_ints(prog.insts.len());
    var gen = 1;
    let sembrar = seed && !is_anchored(prog);
    add_thread(prog, pcs, svs, seen, gen, 0, new_saves(prog.nsaves), start, n);
    var matched: Option<[int]> = Option.None;
    var pos = start;
    while (true) {
        var npcs: [int] = [];
        var nsvs: [[int]] = [];
        gen = gen + 1;
        var k = 0;
        var corta = false;
        while (k < pcs.len() && !corta) {
            let pc = pcs[k];
            let ins = prog.insts[pc];
            if (ins.op == 2) {
                // Match. Leftmost-first: registra y CORTA los hilos de menor prioridad
                // (un match posterior solo puede venir de un hilo de mayor prioridad, que
                // ya está en `npcs`, y entonces sobreescribe). En modo `full` solo vale al
                // final del texto; antes, el hilo simplemente muere (sin cortar).
                if (!full) {
                    matched = Option.Some(svs[k]);
                    corta = true;
                } else if (pos == n) {
                    matched = Option.Some(svs[k]);
                    corta = true;
                }
            } else if (pos < n) {
                let ch = txt[pos];
                var consume = false;
                if (ins.op == 0 && ins.c == ch) {
                    consume = true;
                } else if (ins.op == 1) {
                    consume = true;
                } else if (ins.op == 5 && class_matches(prog.classes[ins.x], ch)) {
                    consume = true;
                }
                if (consume) {
                    add_thread(prog, npcs, nsvs, seen, gen, pc + 1, svs[k], pos + 1, n);
                }
            }
            k = k + 1;
        }
        if (pos >= n) {
            return matched;
        }
        // Siembra de búsqueda: un arranque nuevo en pos+1, con MENOR prioridad que todos
        // los hilos vivos (leftmost). Tras un match ya no se siembra.
        if (sembrar && matched.is_none()) {
            add_thread(prog, npcs, nsvs, seen, gen, 0, new_saves(prog.nsaves), pos + 1, n);
        }
        if (npcs.len() == 0) {
            return matched;
        }
        pcs = npcs;
        svs = nsvs;
        pos = pos + 1;
    }
    Option.None
}

// El motor de full_match sobre un programa YA compilado (lo comparten la función libre y el método).
fn run_full(prog: Prog, text: string) -> bool {
    let txt = text.chars();
    match (run_pike(prog, txt, txt.len(), 0, false, true)) {
        Option.Some(sv) => true,
        Option.None => false,
    }
}

// ¿Casa el patrón con TODO el texto (anclado a ambos extremos)?
/// Tests whether the pattern matches the ENTIRE text (anchored at both ends).
/// Thompson NFA simulation — linear time, no backtracking blowup. Supported syntax:
/// literals, `.`, `*` `+` `?`, `|`, `( )`, `[...]`/`[^...]` with ranges, `\d \w \s` (and negations), `^` `$`.
/// Panics on a malformed pattern (compiles it on every call); prefer `compile` + `Matcher`
/// for user-supplied patterns or repeated matching.
pub fn full_match(pattern: string, text: string) -> bool {
    run_full(must_compile(pattern), text)
}

// El motor de search sobre un programa ya compilado.
fn run_search(prog: Prog, text: string) -> bool {
    let txt = text.chars();
    match (run_pike(prog, txt, txt.len(), 0, true, false)) {
        Option.Some(sv) => true,
        Option.None => false,
    }
}

// ¿Casa el patrón con ALGÚN substring del texto (búsqueda no anclada)?
/// Tests whether the pattern matches SOME substring of the text (unanchored search).
/// Linear time (Thompson NFA); same supported syntax as `full_match`. Panics on a
/// malformed pattern; prefer `compile` + `Matcher` for user-supplied patterns.
pub fn search(pattern: string, text: string) -> bool {
    run_search(must_compile(pattern), text)
}

// ---------------------------------------------------------------------------
// M29.1c — localización: find / find_all / replace_all. (M81: sobre la Pike VM,
// semántica leftmost-first; el span del match sale de las ranuras 0/1.)
// ---------------------------------------------------------------------------
// La primera coincidencia buscando desde `s`: sus ranuras de captura, o None.
fn find_from(prog: Prog, txt: [char], n: int, s: int) -> Option<[int]> {
    run_pike(prog, txt, n, s, true, false)
}

// El motor de find sobre un programa ya compilado.
fn run_find(prog: Prog, text: string) -> Option<(int, int)> {
    let txt = text.chars();
    match (find_from(prog, txt, txt.len(), 0)) {
        Option.Some(sv) => Option.Some((sv[0], sv[1])),
        Option.None => Option.None,
    }
}

// La primera coincidencia (leftmost): `Some((inicio, fin))` con índices por carácter, o `None`.
/// Finds the first (leftmost-first, Perl semantics — greedy quantifiers prefer to repeat,
/// lazy ones to stop) match. Returns `Some((start, end))` as character
/// indices (end exclusive), or `None` if the pattern does not match anywhere.
/// Panics on a malformed pattern; prefer `compile` + `Matcher` for user-supplied patterns.
pub fn find(pattern: string, text: string) -> Option<(int, int)> {
    run_find(must_compile(pattern), text)
}

// El substring de la primera coincidencia, o `None`.
/// Returns the substring of the first match, or `None` if there is no match.
pub fn find_str(pattern: string, text: string) -> Option<string> {
    match (find(pattern, text)) {
        Option.Some(par) => Option.Some(text.substring(par.0, par.1)),
        Option.None => Option.None,
    }
}

// El motor de find_all sobre un programa ya compilado.
fn run_find_all(prog: Prog, text: string) -> [string] {
    let txt = text.chars();
    let n = txt.len();
    var out: [string] = [];
    var s = 0;
    while (s <= n) {
        match (find_from(prog, txt, n, s)) {
            Option.Some(sv) => {
                let a = sv[0];
                let b = sv[1];
                out.push(text.substring(a, b));
                if (b > a) {
                    s = b;  // continúa tras la coincidencia (no solapada)
                } else {
                    s = a + 1;  // coincidencia de ancho cero: avanza uno
                }
            },
            Option.None => {
                s = n + 1;  // sin más coincidencias
            },
        }
    }
    out
}

// Todas las coincidencias NO solapadas, de izquierda a derecha, como substrings.
/// Returns all non-overlapping matches, left to right, as substrings.
/// A zero-width match advances one character to guarantee progress.
/// Panics on a malformed pattern; prefer `compile` + `Matcher` for user-supplied patterns.
pub fn find_all(pattern: string, text: string) -> [string] {
    run_find_all(must_compile(pattern), text)
}

// El motor de replace_all sobre un programa ya compilado.
fn run_replace_all(prog: Prog, text: string, repl: string) -> string {
    let txt = text.chars();
    let n = txt.len();
    var out = "";
    var s = 0;
    while (s <= n) {
        match (find_from(prog, txt, n, s)) {
            Option.Some(sv) => {
                let a = sv[0];
                let b = sv[1];
                out = out + text.substring(s, a);  // el tramo sin coincidencia, tal cual
                out = out + repl;
                if (b > a) {
                    s = b;
                } else {
                    // coincidencia vacía: copia el carácter actual y avanza uno.
                    if (a < n) {
                        out = out + text.substring(a, a + 1);
                    }
                    s = a + 1;
                }
            },
            Option.None => {
                out = out + text.substring(s, n);  // resto sin coincidencias
                s = n + 1;
            },
        }
    }
    out
}

// Reemplaza cada coincidencia NO solapada por `repl` y devuelve el texto resultante.
/// Replaces every non-overlapping match with `repl` (a plain string, no capture references)
/// and returns the resulting text.
/// Panics on a malformed pattern; prefer `compile` + `Matcher` for user-supplied patterns.
pub fn replace_all(pattern: string, text: string, repl: string) -> string {
    run_replace_all(must_compile(pattern), text, repl)
}

// ---------------------------------------------------------------------------
// M81 — grupos de captura.
// ---------------------------------------------------------------------------
// Traduce las ranuras a la lista de spans por grupo: el grupo i son las ranuras 2i/2i+1;
// un grupo que no participó en el match (p. ej. la rama no tomada de un `|`) queda None.
fn saves_to_groups(prog: Prog, sv: [int]) -> [Option<(int, int)>] {
    var out: [Option<(int, int)>] = [];
    var g = 0;
    while (g < prog.ngroups) {
        let a = sv[2 * g];
        let b = sv[2 * g + 1];
        if (a >= 0 && b >= 0) {
            out.push(Option.Some((a, b)));
        } else {
            // Gotcha: `push(Option.None)` no infiere T → se materializa anotado.
            var nada: Option<(int, int)> = Option.None;
            out.push(nada);
        }
        g = g + 1;
    }
    out
}

// El motor de captures sobre un programa ya compilado.
fn run_captures(prog: Prog, text: string) -> Option<[Option<(int, int)>]> {
    let txt = text.chars();
    match (find_from(prog, txt, txt.len(), 0)) {
        Option.Some(sv) => Option.Some(saves_to_groups(prog, sv)),
        Option.None => Option.None,
    }
}

// Los grupos de captura de la primera coincidencia: el grupo 0 es el match entero y
// cada `( )` numera por orden de apertura; `(?:)` no captura. Índices por carácter.
/// Capture groups of the first (leftmost-first) match: element 0 is the whole match,
/// each capturing `( )` gets the next index in order of the opening paren (`(?:...)`
/// does not capture). Each group is `Some((start, end))` in character indices, or
/// `None` if the group did not participate in the match. `None` overall if the
/// pattern does not match. Panics on a malformed pattern; prefer `compile` + `Matcher`.
pub fn captures(pattern: string, text: string) -> Option<[Option<(int, int)>]> {
    run_captures(must_compile(pattern), text)
}

// El motor de captures_str sobre un programa ya compilado.
fn run_captures_str(prog: Prog, text: string) -> Option<[Option<string>]> {
    match (run_captures(prog, text)) {
        Option.Some(grupos) => {
            var out: [Option<string>] = [];
            var i = 0;
            while (i < grupos.len()) {
                match (grupos[i]) {
                    Option.Some(par) => { out.push(Option.Some(text.substring(par.0, par.1))); },
                    Option.None => {
                        var nada: Option<string> = Option.None;
                        out.push(nada);
                    },
                }
                i = i + 1;
            }
            Option.Some(out)
        },
        Option.None => Option.None,
    }
}

// Los grupos de la primera coincidencia como substrings (misma numeración que `captures`).
/// Capture groups of the first match as substrings (same numbering as `captures`).
pub fn captures_str(pattern: string, text: string) -> Option<[Option<string>]> {
    run_captures_str(must_compile(pattern), text)
}

// ---------------------------------------------------------------------------
// M59.2 — la API compilada: los mismos seis nombres como MÉTODOS de `Regex` (un método de
// trait gana a la función libre homónima en la resolución por punto, así conviven sin
// sobrecarga). Ninguno recompila: el `Regex` ya trae el programa.
// ---------------------------------------------------------------------------
/// Matching methods over a compiled `Regex` (see `compile`). Same semantics as the
/// free functions of the same name, but the pattern is compiled once, not per call,
/// and a malformed pattern was already rejected as a value by `compile`.
pub trait Matcher {
    /// Does the pattern match the ENTIRE text (anchored at both ends)?
    fn full_match(self, text: string) -> bool;
    /// Does the pattern match SOME substring of the text (unanchored search)?
    fn search(self, text: string) -> bool;
    /// First (leftmost-first) match as `Some((start, end))` character indices, or `None`.
    fn find(self, text: string) -> Option<(int, int)>;
    /// The substring of the first match, or `None`.
    fn find_str(self, text: string) -> Option<string>;
    /// All non-overlapping matches, left to right, as substrings.
    fn find_all(self, text: string) -> [string];
    /// Replaces every non-overlapping match with `repl` (no capture references).
    fn replace_all(self, text: string, repl: string) -> string;
    /// Capture groups of the first match as `(start, end)` spans (M81). Element 0 is
    /// the whole match; a group that did not participate is `None`.
    fn captures(self, text: string) -> Option<[Option<(int, int)>]>;
    /// Capture groups of the first match as substrings (M81).
    fn captures_str(self, text: string) -> Option<[Option<string>]>;
}

impl Matcher for Regex {
    fn full_match(self, text: string) -> bool { run_full(self.prog, text) }
    fn search(self, text: string) -> bool { run_search(self.prog, text) }
    fn find(self, text: string) -> Option<(int, int)> { run_find(self.prog, text) }
    fn find_str(self, text: string) -> Option<string> {
        match (run_find(self.prog, text)) {
            Option.Some(par) => Option.Some(text.substring(par.0, par.1)),
            Option.None => Option.None,
        }
    }
    fn find_all(self, text: string) -> [string] { run_find_all(self.prog, text) }
    fn replace_all(self, text: string, repl: string) -> string { run_replace_all(self.prog, text, repl) }
    fn captures(self, text: string) -> Option<[Option<(int, int)>]> { run_captures(self.prog, text) }
    fn captures_str(self, text: string) -> Option<[Option<string>]> { run_captures_str(self.prog, text) }
}
