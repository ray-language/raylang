// M7.3 — stdlib: orden superior escrito EN raylang (map / filter / fold)
//
// `map`, `filter` y `fold` no están incrustados en el compilador: viven en el prelude
// (src/prelude.rs), escritos en el propio raylang con lo que ya teníamos —genéricos
// (M6), closures (M4) y los builtins `len`/`push`—. Son la prueba de que el lenguaje
// ya basta para construir su biblioteca, y de que UFCS (M7.1) y pipelines (M7.2) la
// vuelven ergonómica. El runtime no cambió.
//
// Sus firmas (del prelude):
//   fn map<T, U>(xs: [T], f: fn(T) -> U) -> [U]
//   fn filter<T>(xs: [T], pred: fn(T) -> bool) -> [T]
//   fn fold<T, A>(xs: [T], init: A, f: fn(A, T) -> A) -> A
//
// Ejecuta con:
//   cargo run --quiet -- examples/stdlib/stdlib.ray
//   cargo run --quiet -- --vm examples/stdlib/stdlib.ray
fn doble(x: int) -> int { x * 2 }

fn es_par(x: int) -> bool { x % 2 == 0 }

fn suma(a: int, b: int) -> int { a + b }

fn main() -> int {
  let xs: [int] = [1, 2, 3, 4, 5, 6];

  // --- Estilo UFCS: se lee como métodos encadenados ---
  //   dobla cada uno -> [2,4,6,8,10,12], filtra pares (todos) -> suma
  let a: int = xs.map(doble).filter(es_par).fold(0, suma);  // 42

  // --- Estilo pipeline: el mismo cálculo como una tubería ---
  let b: int = fold(map(filter(xs, es_par), doble), 0, suma);
  //   filtra pares [2,4,6] -> dobla [4,8,12] -> suma = 24
  // --- Con closures anónimos en línea ---
  let c: int = fold(filter(map(xs, fn(x: int) -> int { x * x }), fn(x: int) -> bool { x > 10 }), 0, suma);
  // [1,4,9,16,25,36]
  // [16,25,36]
  // 77
  a + b + c  // 42 + 24 + 77 = 143
}
