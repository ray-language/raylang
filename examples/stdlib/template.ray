// Motor de plantillas HTML (M32.3; optimizado para SSR jul 2026) escrito EN raylang. Puro cómputo,
// cero runtime. Sintaxis estilo Jinja/Django: interpolación `{{ var }}` (con **autoescape** HTML),
// sin escapar `{{& var }}`, condicionales `{% if c %}…{% elif c2 %}…{% else %}…{% endif %}` y bucles
// `{% for x in lista %}…{% endfor %}`.
//
// API en dos niveles (SSR: compilar UNA vez, renderizar por request):
//   - `compile(tpl) -> Result<Template, string>` + `render(t, ctx) -> string`
//   - `render_template(tpl, ctx)` = azúcar de una vez (compila + renderiza).
//
// Reparto de roles con `ray build --templates-only` (M55): los templates COMPILADOS (`.ray.html` → función tipada)
// son la opción por defecto y además soportan `{% include %}`/`{% extends %}`/`{% block %}`/
// `{% let %}`; este motor runtime es un SUBCONJUNTO (interpolación + if/for) para plantillas
// **dinámicas** — cargadas de disco/BD en caliente, editables por el usuario — que `ray build --templates-only`
// no puede cubrir (necesita el template en build time). Los compilados importan `escape_html`
// de aquí: este módulo es también su librería de soporte.
//
// El contexto son variables tipadas (`enum TVal`): raylang es estáticamente tipado, así que los valores
// heterogéneos van en un enum y el contexto es una lista de `(nombre, valor)`.
//
// Rendimiento (la lección de la optimización): NADA se acumula con `s = s + trozo` en bucle (eso es
// O(n²): cada `+` copia el string entero). El tokenizador extrae los tramos con `substring` (un corte
// por tramo), y el render y el escape emiten PARTES en un `[string]` compartido que se une UNA vez con
// `join` al final. El binding del `for` se crea una vez y se MUTA por iteración (semántica de
// referencia), en vez de copiar el contexto entero en cada vuelta.
// Un valor de plantilla.
/// A template value: string, int, bool, or list (heterogeneous context values in a typed enum).
pub enum TVal {
    VStr(string),
    VInt(int),
    VBool(bool),
    VList([TVal]),
}

// Una asociación nombre → valor en el contexto.
/// A name → value binding in the template context (the context is a `[Bind]` list).
pub struct Bind {
    name: string,
    value: TVal,
}

// Un token del tokenizador: texto literal, interpolación (escapada / cruda), o una etiqueta `{% … %}`.
enum Tok {
    TText(string),
    TVar(string),
    TRaw(string),
    TTag(string),
}

// Un nodo del árbol de la plantilla.
enum Node {
    NText(string),
    NVar(string),
    NRaw(string),
    NIf(string, [Node], [Node]),
    NFor(string, string, [Node]),
}

// Una plantilla COMPILADA (tokenizada + parseada): renderizable N veces sin re-parsear.
/// A compiled template: parse once with `compile`, then `render` it many times (SSR: compile at
/// startup, render per request). The tree is opaque; treat this as a handle.
pub struct Template {
    nodes: [Node],
}

// ---- Constructores del contexto (API) ----
/// Creates a string binding for the template context.
pub fn ctx_str(name: string, s: string) -> Bind { Bind { name: name, value: TVal.VStr(s) } }

/// Creates an int binding for the template context.
pub fn ctx_int(name: string, n: int) -> Bind { Bind { name: name, value: TVal.VInt(n) } }

/// Creates a bool binding for the template context.
pub fn ctx_bool(name: string, b: bool) -> Bind { Bind { name: name, value: TVal.VBool(b) } }

/// Creates a list binding for the template context (for `{% for %}` loops).
pub fn ctx_list(name: string, xs: [TVal]) -> Bind { Bind { name: name, value: TVal.VList(xs) } }

/// Wraps a string as a `TVal` (for building list elements).
pub fn val_str(s: string) -> TVal { TVal.VStr(s) }

/// Wraps an int as a `TVal` (for building list elements).
pub fn val_int(n: int) -> TVal { TVal.VInt(n) }

// ---- Tokenizador ----
//
// Recorre los caracteres UNA vez y extrae cada tramo (texto/hueco/etiqueta) con `substring` sobre
// los índices (un corte por tramo; nunca carácter a carácter).
fn tokenize(tpl: string) -> Result<[Tok], string> {
    let cs = tpl.chars();
    let n = cs.len();
    var toks: [Tok] = [];
    var start = 0;  // inicio del tramo de texto en curso
    var i = 0;
    while (i < n) {
        if (i + 1 < n && cs[i] == '{' && (cs[i + 1] == '{' || cs[i + 1] == '%')) {
            if (i > start) {
                toks.push(Tok.TText(tpl.substring(start, i)));
            }
            let es_tag = cs[i + 1] == '%';
            let cierre = if (es_tag) { '%' } else { '}' };
            let ini = i + 2;
            // Buscar el par de cierre (`%}` o `}}`) desde `ini`.
            var fin = 0 - 1;
            var j = ini;
            while (fin < 0 && j + 1 < n) {
                if (cs[j] == cierre && cs[j + 1] == '}') {
                    fin = j;
                } else {
                    j = j + 1;
                }
            }
            if (fin < 0) {
                if (es_tag) {
                    return Result.Err("unterminated '{%'");
                }
                return Result.Err("unterminated '{{'");
            }
            let inner = tpl.substring(ini, fin).trim();
            i = fin + 2;
            start = i;
            if (es_tag) {
                toks.push(Tok.TTag(inner));
            } else {
                if (inner.len() > 0 && inner[0] == '&') {
                    toks.push(Tok.TRaw(inner.substring(1, inner.len()).trim()));
                } else {
                    toks.push(Tok.TVar(inner));
                }
            }
        } else {
            i = i + 1;
        }
    }
    if (n > start) {
        toks.push(Tok.TText(tpl.substring(start, n)));
    }
    Result.Ok(toks)
}

// ---- Parser (tokens → árbol) ----
struct PC {
    toks: [Tok],
    pos: int,
}

// El resultado de parsear una secuencia: los nodos + la etiqueta que la detuvo (con su texto
// completo, para leer la condición de un `elif`).
struct SeqResult {
    nodes: [Node],
    stop: string,
    stop_tag: string,
}

fn first_word(s: string) -> string {
    let parts = s.split(" ");
    parts[0]
}

// Parsea una cadena `if`: el cuerpo hasta elif/else/endif; un `elif` se vuelve un `if` anidado en
// la rama else (recursivo), así `{% elif %}` no necesita nodo propio.
fn parse_if(pc: PC, cond: string) -> Result<Node, string> {
    let thenr = match (parse_seq(pc, ["elif", "else", "endif"])) {
        Result.Ok(x) => x,
        Result.Err(e) => {
            return Result.Err(e);
        },
    };
    var elsebody: [Node] = [];
    if (thenr.stop == "elif") {
        let cond2 = thenr.stop_tag.substring(4, thenr.stop_tag.len()).trim();
        let anidado = match (parse_if(pc, cond2)) {
            Result.Ok(x) => x,
            Result.Err(e) => {
                return Result.Err(e);
            },
        };
        elsebody.push(anidado);
    } else {
        if (thenr.stop == "else") {
            let elser = match (parse_seq(pc, ["endif"])) {
                Result.Ok(x) => x,
                Result.Err(e) => {
                    return Result.Err(e);
                },
            };
            elsebody = elser.nodes;
        }
    }
    Result.Ok(Node.NIf(cond, thenr.nodes, elsebody))
}

fn parse_seq(pc: PC, stops: [string]) -> Result<SeqResult, string> {
    var nodes: [Node] = [];
    var stop = "";
    var stop_tag = "";
    var done = false;
    while (!done) {
        if (pc.pos >= pc.toks.len()) {
            done = true;
        } else {
            let tok = pc.toks[pc.pos];
            match (tok) {
                Tok.TText(s) => {
                    nodes.push(Node.NText(s));
                    pc.pos = pc.pos + 1;
                },
                Tok.TVar(s) => {
                    nodes.push(Node.NVar(s));
                    pc.pos = pc.pos + 1;
                },
                Tok.TRaw(s) => {
                    nodes.push(Node.NRaw(s));
                    pc.pos = pc.pos + 1;
                },
                Tok.TTag(s) => {
                    let kw = first_word(s);
                    if (stops.contains(kw)) {
                        pc.pos = pc.pos + 1;
                        stop = kw;
                        stop_tag = s;
                        done = true;
                    } else if (kw == "if") {
                        pc.pos = pc.pos + 1;
                        let cond = s.substring(2, s.len()).trim();
                        let nodo = match (parse_if(pc, cond)) {
                            Result.Ok(x) => x,
                            Result.Err(e) => {
                                return Result.Err(e);
                            },
                        };
                        nodes.push(nodo);
                    } else if (kw == "for") {
                        pc.pos = pc.pos + 1;
                        let parts = s.split(" ");  // ["for", x, "in", lista]
                        if (parts.len() < 4) {
                            return Result.Err("malformed 'for' (expected 'for x in list')");
                        }
                        let bodyr = match (parse_seq(pc, ["endfor"])) {
                            Result.Ok(x) => x,
                            Result.Err(e) => {
                                return Result.Err(e);
                            },
                        };
                        nodes.push(Node.NFor(parts[1], parts[3], bodyr.nodes));
                    } else {
                        return Result.Err("unknown tag: '" + kw + "'");
                    }
                },
            }
        }
    }
    Result.Ok(SeqResult { nodes: nodes, stop: stop, stop_tag: stop_tag })
}

// ---- Render ----
// Escape HTML apoyado en los builtins NATIVOS (`contains`/`replace` corren en Rust): el caso común
// (texto limpio) devuelve el string original tras 5 escaneos O(n); el sucio, 5 pasadas de replace.
// (No iterar `s[i]` en bucle: indexar un string es O(len) por acceso → un bucle así es cuadrático.)
// Pub: también lo usan los módulos GENERADOS por `ray build --templates-only` (M55).
/// Escapes HTML special characters (`& < > " '`) as entities. Clean text is returned as-is.
pub fn escape_html(s: string) -> string {
    if (!(s.contains(
        "&"
    ) || s.contains("<") || s.contains(">") || s.contains("\"") || s.contains("'"))) {
        return s;
    }
    // `&` primero (si no, re-escaparía las entidades recién emitidas).
    s
        .replace("&", "&amp;")
        .replace("<", "&lt;")
        .replace(">", "&gt;")
        .replace("\"", "&quot;")
        .replace("'", "&#39;")
}

fn lookup(ctx: [Bind], name: string) -> Option<TVal> {
    var i = 0;
    while (i < ctx.len()) {
        if (ctx[i].name == name) {
            return Option.Some(ctx[i].value);
        }
        i = i + 1;
    }
    Option.None
}

fn truthy(v: TVal) -> bool {
    match (v) {
        TVal.VBool(b) => b,
        TVal.VInt(n) => n != 0,
        TVal.VStr(s) => s != "",
        TVal.VList(xs) => xs.len() > 0,
    }
}

fn render_val(v: TVal) -> string {
    match (v) {
        TVal.VStr(s) => s,
        TVal.VInt(n) => to_string(n),
        TVal.VBool(b) => if (b) { "true" } else { "false" },
        TVal.VList(xs) => {
            var out: [string] = [];
            var i = 0;
            while (i < xs.len()) {
                if (i > 0) {
                    out.push(", ");
                }
                out.push(render_val(xs[i]));
                i = i + 1;
            }
            out.join("")
        },
    }
}

// Emite los nodos como PARTES en `out` (compartido por referencia); el join final es del llamador.
fn emit_nodes(nodes: [Node], ctx: [Bind], out: [string]) {
    var i = 0;
    while (i < nodes.len()) {
        emit_node(nodes[i], ctx, out);
        i = i + 1;
    }
}

fn emit_node(node: Node, ctx: [Bind], out: [string]) {
    match (node) {
        Node.NText(s) => {
            out.push(s);
        },
        Node.NVar(name) => {
            match (lookup(ctx, name)) {
                Option.Some(v) => {
                    out.push(escape_html(render_val(v)));
                },
                Option.None => { },
            }
        },
        Node.NRaw(name) => {
            match (lookup(ctx, name)) {
                Option.Some(v) => {
                    out.push(render_val(v));
                },
                Option.None => { },
            }
        },
        Node.NIf(cond, entonces, sino) => {
            let t = match (lookup(ctx, cond)) {
                Option.Some(v) => truthy(v),
                Option.None => false,
            };
            if (t) {
                emit_nodes(entonces, ctx, out);
            } else {
                emit_nodes(sino, ctx, out);
            }
        },
        Node.NFor(vname, lname, body) => {
            match (lookup(ctx, lname)) {
                Option.Some(v) => {
                    match (v) {
                        TVal.VList(xs) => {
                            // Contexto extendido UNA vez (el binding al frente, para que
                            // shadowee); por iteración solo se MUTA su valor (referencia).
                            var ext: [Bind] = [Bind { name: vname, value: TVal.VInt(0) }];
                            var k = 0;
                            while (k < ctx.len()) {
                                ext.push(ctx[k]);
                                k = k + 1;
                            }
                            var i = 0;
                            while (i < xs.len()) {
                                ext[0].value = xs[i];
                                emit_nodes(body, ext, out);
                                i = i + 1;
                            }
                        },
                        _ => { },
                    }
                },
                Option.None => { },
            }
        },
    }
}

// ---- API ----
// Compila la plantilla (tokeniza + parsea). En SSR: una vez al arrancar.
/// Compiles a template (tokenize + parse). For SSR, compile once at startup and `render` per
/// request — rendering never re-parses.
pub fn compile(tpl: string) -> Result<Template, string> {
    let toks = match (tokenize(tpl)) {
        Result.Ok(t) => t,
        Result.Err(e) => {
            return Result.Err(e);
        },
    };
    let pc = PC { toks: toks, pos: 0 };
    let seq = match (parse_seq(pc, [])) {
        Result.Ok(s) => s,
        Result.Err(e) => {
            return Result.Err(e);
        },
    };
    Result.Ok(Template { nodes: seq.nodes })
}

// Renderiza una plantilla ya compilada con el contexto dado.
/// Renders a compiled template with the given context. Missing variables render as `""`.
pub fn render(t: Template, ctx: [Bind]) -> string {
    var out: [string] = [];
    emit_nodes(t.nodes, ctx, out);
    out.join("")
}

// Compila y renderiza de una vez (azúcar; para render repetido usa compile + render).
/// Renders a Jinja-style template with the given context in one shot: `{{ var }}` interpolation
/// (HTML-autoescaped), `{{& var }}` raw, `{% if %}…{% elif %}…{% else %}…{% endif %}`, and
/// `{% for x in list %}…{% endfor %}`. Missing variables render as ""; `Err` on syntax errors.
/// For repeated rendering (SSR), prefer `compile` once + `render` per request.
pub fn render_template(tpl: string, ctx: [Bind]) -> Result<string, string> {
    let t = match (compile(tpl)) {
        Result.Ok(x) => x,
        Result.Err(e) => {
            return Result.Err(e);
        },
    };
    Result.Ok(render(t, ctx))
}
