// TOML (subconjunto) escrito EN raylang (M32.2b). Parsea un documento de configuración a una lista de
// entradas `clave = valor`, con la clave como ruta con puntos (`server.port`) para las tablas. Puro
// cómputo, cero runtime. Importable: `from toml import parse_toml, toml_get, toml_show, TomlValue, TomlEntry;`.
//
// Soporta: comentarios `#`, tablas `[a.b]`, claves desnudas, y valores string (`"..."` con los escapes
// completos de la spec — \b \f \n \r \t \" \\ \uXXXX \UXXXXXXXX; escape desconocido = Err, M63.1),
// string LITERAL `'...'` (sin escapes), entero, flotante, booleano (`true`/`false`) y arreglo
// `[v, v, …]` (posiblemente multilínea). M91.3: **tablas en línea** `{k = v, …}` (como valor de una
// entrada se APLANAN a rutas con puntos — `point = {x = 1}` ≡ `point.x = 1`, la semántica de la spec;
// dentro de un arreglo viven como valor `TTable`) y **arreglos de tablas** `[[t]]` (cada aparición
// abre un elemento nuevo con ruta INDEXADA: `t.0`, `t.1`, …; una cabecera `[t.sub]` posterior resuelve
// a través del último elemento: `t.1.sub`). Diferido: fechas, strings multilínea. (El manifiesto
// `ray.toml` NO usa este parser: el CLI trae su lector mínimo propio en Rust, `src/manifest.rs`.)
// Un valor TOML. Recursivo (los arreglos contienen valores; una tabla en línea, entradas).
/// A TOML value: string, int, float, bool, array (recursive), or inline table (only as an
/// array element — an inline table that is the value of an entry is flattened into dotted keys).
pub enum TomlValue {
    TStr(string),
    TInt(int),
    TFloat(float),
    TBool(bool),
    TArray([TomlValue]),
    TTable([TomlEntry]),
}

// Una entrada del documento: la ruta con puntos y su valor.
/// One document entry: the dotted key path (tables prefix their keys, e.g. `server.port`)
/// and its value.
pub struct TomlEntry {
    key: string,
    value: TomlValue,
}

// El estado del parser: los caracteres y la posición.
struct TS {
    cs: [char],
    pos: int,
}

fn ts_end(t: TS) -> bool { t.pos >= t.cs.len() }

fn ts_peek(t: TS) -> char { t.cs[t.pos] }

fn ts_adv(t: TS) -> char {
    let c = t.cs[t.pos];
    t.pos = t.pos + 1;
    c
}

fn es_espacio(c: char) -> bool { c == ' ' || c == '\t' || c == '\r' || c == '\n' }

// Salta espacios, saltos de línea y comentarios (`#` hasta fin de línea).
fn skip_trivia(t: TS) {
    var seguir = true;
    while (seguir && !ts_end(t)) {
        let c = ts_peek(t);
        if (es_espacio(c)) {
            ts_adv(t);
        } else if (c == '#') {
            while (!ts_end(t) && ts_peek(t) != '\n') {
                ts_adv(t);
            }
        } else {
            seguir = false;
        }
    }
}

// Salta solo espacios/tabs (no saltos de línea), dentro de una línea `key = valor`.
fn skip_spaces(t: TS) {
    while (!ts_end(t) && (ts_peek(t) == ' ' || ts_peek(t) == '\t')) {
        ts_adv(t);
    }
}

// ¿Es `c` parte de una clave desnuda o de la ruta de una tabla? (letras, dígitos, `_`, `-`, `.`)
fn es_clave(c: char) -> bool {
    c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || c == '_' || c == '-' || c == '.'
}

fn parse_key(t: TS) -> string {
    var k = "";
    while (!ts_end(t) && es_clave(ts_peek(t))) {
        k = k + to_string(ts_adv(t));
    }
    k
}

// El valor de un dígito hex (mayúsculas o minúsculas); -1 si no lo es (para \uXXXX).
fn hex_val(c: char) -> int {
    let code = char_code(c);
    if (code >= 48 && code <= 57) {
        code - 48
    } else if (code >= 97 && code <= 102) {
        code - 87
    } else if (code >= 65 && code <= 70) {
        code - 55
    } else {
        0 - 1
    }
}

// Lee exactamente `n` dígitos hex y construye el carácter del code point (\uXXXX / \UXXXXXXXX).
fn parse_u_escape(t: TS, n: int) -> Result<string, string> {
    var v = 0;
    var k = 0;
    while (k < n) {
        if (ts_end(t)) {
            return Result.Err("escape \\u incompleto");
        }
        let d = hex_val(ts_adv(t));
        if (d < 0) {
            return Result.Err("escape \\u con dígito no hexadecimal");
        }
        v = v * 16 + d;
        k = k + 1;
    }
    match (char_from_code(v)) {
        Option.Some(c) => Result.Ok(to_string(c)),
        Option.None => Result.Err("escape \\u con code point inválido"),
    }
}

// Parsea un string básico `"..."` con los escapes de la spec: \b \f \n \r \t \" \\ \uXXXX
// \UXXXXXXXX. M63.1: un escape DESCONOCIDO es error (antes se tragaba la barra y dejaba el
// resto — `"café"` salía `"cafu00E9"`: corrupción silenciosa de TOML legal).
fn parse_string(t: TS) -> Result<string, string> {
    ts_adv(t);  // comilla de apertura
    var s = "";
    var cerrado = false;
    while (!cerrado && !ts_end(t)) {
        let c = ts_adv(t);
        if (c == '"') {
            cerrado = true;
        } else if (c == '\\') {
            if (ts_end(t)) {
                return Result.Err("escape al final del string");
            }
            let e = ts_adv(t);
            if (e == 'n') {
                s = s + "\n";
            } else if (e == 't') {
                s = s + "\t";
            } else if (e == 'r') {
                s = s + "\r";
            } else if (e == '"') {
                s = s + "\"";
            } else if (e == '\\') {
                s = s + "\\";
            } else if (e == 'b') {
                s = s + ctrl(8);
            } else if (e == 'f') {
                s = s + ctrl(12);
            } else if (e == 'u') {
                s = s + parse_u_escape(t, 4)?;
            } else if (e == 'U') {
                s = s + parse_u_escape(t, 8)?;
            } else {
                return Result.Err("escape desconocido '\\" + to_string(e) + "' en el string");
            }
        } else {
            s = s + to_string(c);
        }
    }
    if (!cerrado) {
        return Result.Err("string sin cerrar");
    }
    Result.Ok(s)
}

// El string de un code point de control (\b/\f, sin literal de escape en raylang).
fn ctrl(n: int) -> string {
    match (char_from_code(n)) {
        Option.Some(c) => to_string(c),
        Option.None => "",
    }
}

// Parsea un string LITERAL `'...'` (M63.1; core TOML): SIN escapes — lo que ves es lo que hay
// (rutas Windows, regex). Termina en la siguiente comilla simple; no admite saltos de línea.
fn parse_literal_string(t: TS) -> Result<string, string> {
    ts_adv(t);  // comilla simple de apertura
    var s = "";
    while (!ts_end(t)) {
        let c = ts_adv(t);
        if (c == '\'') {
            return Result.Ok(s);
        }
        if (c == '\n') {
            return Result.Err("salto de línea en un string literal '...'");
        }
        s = s + to_string(c);
    }
    Result.Err("string literal sin cerrar")
}

fn es_digito(c: char) -> bool { c >= '0' && c <= '9' }

// M63.2: quita los separadores `_` de un número (`1_000`), validando la regla de la spec —
// cada `_` debe ir ENTRE dígitos (`_1`, `1_`, `1__0` o `1_.5` son errores).
fn quitar_separadores(tok: string) -> Result<string, string> {
    if (!tok.contains("_")) {
        return Result.Ok(tok);
    }
    let cs = tok.chars();
    var out = "";
    var i = 0;
    while (i < cs.len()) {
        let c = cs[i];
        if (c == '_') {
            let antes = i > 0 && es_digito(cs[i - 1]);
            let despues = i + 1 < cs.len() && es_digito(cs[i + 1]);
            if (!antes || !despues) {
                return Result.Err("separador '_' mal colocado en el número: " + tok);
            }
        } else {
            out = out + to_string(c);
        }
        i = i + 1;
    }
    Result.Ok(out)
}

// Clasifica un token escalar (número o booleano) ya leído. M63.2: acepta `inf`/`nan` (con
// signo) como flotantes de la spec y los separadores `_` de los números.
fn clasificar_escalar(tok: string) -> Result<TomlValue, string> {
    if (tok == "true") {
        return Result.Ok(TomlValue.TBool(true));
    }
    if (tok == "false") {
        return Result.Ok(TomlValue.TBool(false));
    }
    if (tok == "inf" || tok == "+inf" || tok == "-inf" || tok == "nan" || tok == "+nan" || tok == "-nan") {
        return match (parse_float(tok)) {
            Option.Some(f) => Result.Ok(TomlValue.TFloat(f)),
            Option.None => Result.Err("flotante inválido: " + tok),
        };
    }
    let limpio = quitar_separadores(tok)?;
    // ¿Flotante? (tiene '.' o 'e'/'E')
    var es_float = false;
    var i = 0;
    while (i < limpio.len()) {
        let c = limpio[i];
        if (c == '.' || c == 'e' || c == 'E') {
            es_float = true;
        }
        i = i + 1;
    }
    if (es_float) {
        match (parse_float(limpio)) {
            Option.Some(f) => Result.Ok(TomlValue.TFloat(f)),
            Option.None => Result.Err("flotante inválido: " + tok),
        }
    } else {
        match (parse_int(limpio)) {
            Option.Some(n) => Result.Ok(TomlValue.TInt(n)),
            Option.None => Result.Err("entero inválido: " + tok),
        }
    }
}

// Lee un token escalar hasta un delimitador (espacio, coma, `]`, salto de línea o `#`).
fn read_scalar(t: TS) -> string {
    var tok = "";
    while (!ts_end(t)) {
        let c = ts_peek(t);
        if (es_espacio(c) || c == ',' || c == ']' || c == '#') {
            return tok;
        }
        tok = tok + to_string(ts_adv(t));
    }
    tok
}

fn parse_value(t: TS) -> Result<TomlValue, string> {
    skip_spaces(t);
    if (ts_end(t)) {
        return Result.Err("valor esperado");
    }
    let c = ts_peek(t);
    if (c == '"') {
        match (parse_string(t)) {
            Result.Ok(s) => Result.Ok(TomlValue.TStr(s)),
            Result.Err(e) => Result.Err(e),
        }
    } else if (c == '\'') {
        match (parse_literal_string(t)) {
            Result.Ok(s) => Result.Ok(TomlValue.TStr(s)),
            Result.Err(e) => Result.Err(e),
        }
    } else if (c == '[') {
        parse_array(t)
    } else if (c == '{') {
        match (parse_inline_table(t)) {
            Result.Ok(es) => Result.Ok(TomlValue.TTable(es)),
            Result.Err(e) => Result.Err(e),
        }
    } else {
        clasificar_escalar(read_scalar(t))
    }
}

// M91.3: una tabla en línea `{k = v, k2 = v2}` (spec: UNA línea, sin coma final). Devuelve sus
// entradas con claves LOCALES; una tabla en línea anidada se aplana con su prefijo
// (`a = {b = {c = 1}}` → `b.c = 1` local, que el llamador prefijará con `a`).
fn parse_inline_table(t: TS) -> Result<[TomlEntry], string> {
    ts_adv(t);  // '{'
    var out: [TomlEntry] = [];
    skip_spaces(t);
    if (!ts_end(t) && ts_peek(t) == '}') {
        ts_adv(t);
        return Result.Ok(out);  // `{}` válido: tabla vacía (aplanada = cero entradas)
    }
    while (true) {
        skip_spaces(t);
        if (!ts_end(t) && ts_peek(t) == '\n') {
            return Result.Err("salto de línea dentro de una tabla en línea {…}");
        }
        let key = parse_key(t);
        if (key == "") {
            return Result.Err("clave inválida en la tabla en línea");
        }
        skip_spaces(t);
        if (ts_end(t) || ts_peek(t) != '=') {
            return Result.Err("falta '=' tras la clave '" + key + "' en la tabla en línea");
        }
        ts_adv(t);
        let val = parse_value(t)?;
        push_aplanado(out, key, val)?;
        skip_spaces(t);
        if (ts_end(t)) {
            return Result.Err("tabla en línea sin cerrar (falta '}')");
        }
        let c = ts_peek(t);
        if (c == '}') {
            ts_adv(t);
            return Result.Ok(out);
        }
        if (c != ',') {
            return Result.Err("se esperaba ',' o '}' en la tabla en línea");
        }
        ts_adv(t);  // ','
    }
    Result.Err("inalcanzable")
}

// Añade `key = val` a `out`, aplanando si `val` es una tabla en línea (sus entradas cuelgan de
// `key.`); valida claves duplicadas dentro del grupo. Una tabla en línea VACÍA no aporta entradas.
fn push_aplanado(out: [TomlEntry], key: string, val: TomlValue) -> Result<int, string> {
    return match (val) {
        TomlValue.TTable(sub) => {
            var i = 0;
            while (i < sub.len()) {
                let full = key + "." + sub[i].key;
                if (clave_repetida(out, full)) {
                    return Result.Err("clave duplicada: '" + full + "'");
                }
                out.push(TomlEntry { key: full, value: sub[i].value });
                i = i + 1;
            }
            Result.Ok(0)
        },
        _ => {
            if (clave_repetida(out, key)) {
                return Result.Err("clave duplicada: '" + key + "'");
            }
            out.push(TomlEntry { key: key, value: val });
            Result.Ok(0)
        },
    };
}

fn parse_array(t: TS) -> Result<TomlValue, string> {
    ts_adv(t);  // '['
    var elems: [TomlValue] = [];
    skip_trivia(t);
    while (!ts_end(t) && ts_peek(t) != ']') {
        let v = match (parse_value(t)) {
            Result.Ok(x) => x,
            Result.Err(e) => {
                return Result.Err(e);
            },
        };
        elems.push(v);
        skip_trivia(t);
        if (!ts_end(t) && ts_peek(t) == ',') {
            ts_adv(t);
            skip_trivia(t);
        }
    }
    if (ts_end(t)) {
        return Result.Err("arreglo sin cerrar");
    }
    ts_adv(t);  // ']'
    Result.Ok(TomlValue.TArray(elems))
}

// M63.3: tras un valor o una cabecera de tabla solo puede venir espacio, un comentario o el fin
// de línea — la spec exige un salto de línea entre entradas (`a = 1 b = 2` es error, no dos
// entradas). El comentario de cola se consume aquí; el `\n` lo consume skip_trivia después.
fn expect_eol(t: TS, que: string) -> Result<int, string> {
    skip_spaces(t);
    if (!ts_end(t) && ts_peek(t) == '#') {
        while (!ts_end(t) && ts_peek(t) != '\n') {
            ts_adv(t);
        }
    }
    if (ts_end(t) || ts_peek(t) == '\n' || ts_peek(t) == '\r') {
        // El '\r' de un CRLF cuenta como fin de línea (lo consume skip_trivia después).
        return Result.Ok(0);
    }
    Result.Err("se esperaba fin de línea tras " + que)
}

// ¿Ya existe una entrada con esta ruta? (M63.3: la spec prohíbe redefinir una clave.)
fn clave_repetida(entries: [TomlEntry], key: string) -> bool {
    var i = 0;
    while (i < entries.len()) {
        if (entries[i].key == key) {
            return true;
        }
        i = i + 1;
    }
    false
}

// Parsea un documento TOML a una lista de entradas (ruta con puntos → valor).
/// Parses a TOML document (subset) into a flat list of entries (dotted key path → value).
/// Supports `#` comments, `[a.b]` tables, bare keys, and string (basic with full escapes, or
/// literal `'...'`) / int / float / bool / array values. Strict where it counts: duplicate
/// keys, an empty table header, or a second entry on the same line are errors.
/// Not supported: inline tables, arrays of tables, dates, multiline strings.
pub fn parse_toml(src: string) -> Result<[TomlEntry], string> {
    let t = TS { cs: src.chars(), pos: 0 };
    var entries: [TomlEntry] = [];
    var table = "";
    // M91.3: nº de elementos abiertos por cada array-de-tablas (clave = su ruta RESUELTA).
    var at_counts: Map<string, int> = Map.new();
    skip_trivia(t);
    while (!ts_end(t)) {
        if (ts_peek(t) == '[') {
            ts_adv(t);
            // M91.3: `[[t]]` = arreglo de tablas (cada aparición abre un elemento nuevo).
            var es_array = false;
            if (!ts_end(t) && ts_peek(t) == '[') {
                ts_adv(t);
                es_array = true;
            }
            let ruta = parse_key(t);
            if (ruta == "") {
                // M63.3: `[]` reseteaba la tabla a la raíz en silencio.
                return Result.Err("cabecera de tabla vacía");
            }
            skip_spaces(t);
            if (ts_end(t) || ts_peek(t) != ']') {
                return Result.Err("falta ']' en la cabecera de tabla");
            }
            ts_adv(t);
            if (es_array) {
                if (ts_end(t) || ts_peek(t) != ']') {
                    return Result.Err("falta ']]' en la cabecera de arreglo de tablas");
                }
                ts_adv(t);
            }
            table = resolver_tabla(at_counts, ruta, es_array);
            expect_eol(t, "la cabecera de tabla [" + ruta + "]")?;
        } else {
            let key = parse_key(t);
            if (key == "") {
                return Result.Err("clave inválida");
            }
            skip_spaces(t);
            if (ts_end(t) || ts_peek(t) != '=') {
                return Result.Err("falta '=' tras la clave '" + key + "'");
            }
            ts_adv(t);
            let val = match (parse_value(t)) {
                Result.Ok(v) => v,
                Result.Err(e) => {
                    return Result.Err(e);
                },
            };
            var full = key;
            if (table != "") {
                full = table + "." + key;
            }
            // M91.3: una tabla en línea como valor se APLANA a rutas con puntos (la semántica
            // de la spec: `point = {x = 1}` ≡ `[point] x = 1`); el resto va tal cual.
            let aplanadas: [TomlEntry] = match (val) {
                TomlValue.TTable(sub) => {
                    var xs: [TomlEntry] = [];
                    var k = 0;
                    while (k < sub.len()) {
                        xs.push(TomlEntry { key: full + "." + sub[k].key, value: sub[k].value });
                        k = k + 1;
                    }
                    xs
                },
                _ => [TomlEntry { key: full, value: val }],
            };
            var k = 0;
            while (k < aplanadas.len()) {
                if (clave_repetida(entries, aplanadas[k].key)) {
                    // M63.3: antes se aceptaban ambas y toml_get devolvía la PRIMERA.
                    return Result.Err("clave duplicada: '" + aplanadas[k].key + "'");
                }
                entries.push(aplanadas[k]);
                k = k + 1;
            }
            expect_eol(t, "el valor de '" + full + "'")?;
        }
        skip_trivia(t);
    }
    Result.Ok(entries)
}

// M91.3: resuelve la ruta de una cabecera contra los arreglos de tablas conocidos. Cada
// segmento acumulado que sea un array-de-tablas se reescribe a su elemento ACTUAL (índice
// n-1); el último segmento de un `[[t]]` ABRE un elemento nuevo (índice n, contador+1).
// Así `[[fruit]] … [fruit.physical]` resuelve a `fruit.0` y `fruit.0.physical`, y un
// `[[fruit.variety]]` anidado a `fruit.0.variety.0` (como la spec).
fn resolver_tabla(at_counts: Map<string, int>, ruta: string, es_array: bool) -> string {
    let segs = ruta.split(".");
    var path = "";
    var i = 0;
    while (i < segs.len()) {
        path = if (path == "") { segs[i] } else { path + "." + segs[i] };
        if (es_array && i == segs.len() - 1) {
            let n = match (at_counts.get(path)) {
                Option.Some(k) => k,
                Option.None => 0,
            };
            at_counts.insert(path, n + 1);
            path = path + "." + to_string(n);
        } else {
            match (at_counts.get(path)) {
                Option.Some(k) => {
                    path = path + "." + to_string(k - 1);
                },
                Option.None => { },
            }
        }
        i = i + 1;
    }
    path
}

// Busca el valor de una ruta con puntos.
/// Looks up the value of a dotted key path (e.g. `"server.port"`).
/// Returns `None` if the key is not present.
pub fn toml_get(entries: [TomlEntry], key: string) -> Option<TomlValue> {
    var i = 0;
    while (i < entries.len()) {
        if (entries[i].key == key) {
            return Option.Some(entries[i].value);
        }
        i = i + 1;
    }
    Option.None
}

// Representación textual de un valor (para depurar/testear).
/// Renders a `TomlValue` as text (strings quoted, arrays as `[a, b]`) — for debugging and tests.
pub fn toml_show(v: TomlValue) -> string {
    match (v) {
        TomlValue.TStr(s) => "\"" + s + "\"",
        TomlValue.TInt(n) => to_string(n),
        TomlValue.TFloat(f) => to_string(f),
        TomlValue.TBool(b) => if (b) { "true" } else { "false" },
        TomlValue.TArray(xs) => {
            var s = "[";
            var i = 0;
            while (i < xs.len()) {
                if (i > 0) {
                    s = s + ", ";
                }
                s = s + toml_show(xs[i]);
                i = i + 1;
            }
            s + "]"
        },
        // M91.3: una tabla en línea (solo aparece como elemento de arreglo).
        TomlValue.TTable(es) => {
            var s = "{";
            var i = 0;
            while (i < es.len()) {
                if (i > 0) {
                    s = s + ", ";
                }
                s = s + es[i].key + " = " + toml_show(es[i].value);
                i = i + 1;
            }
            s + "}"
        },
    }
}
