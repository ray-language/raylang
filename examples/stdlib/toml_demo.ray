// Demo de TOML: parsea un documento con comentarios, tablas, y valores string/int/float/bool/array,
// y muestra cada valor por su ruta con puntos.
from toml import parse_toml, toml_get, toml_show, TomlValue, TomlEntry;

fn show_key(entries: [TomlEntry], key: string) {
    match (toml_get(entries, key)) {
        Option.Some(v) => print(key + " = " + toml_show(v)),
        Option.None => print(key + " = <none>"),
    }
}

fn main() {
    let doc = "# configuración de ejemplo\ntitle = \"raylang\"\n\n[server]\nhost = \"localhost\"  # el host\nport = 8080\ndebug = true\nratio = 1.5\ntags = [\"a\", \"b\", \"c\"]\nports = [80, 443, 8080]\n";
    match (parse_toml(doc)) {
        Result.Ok(entries) => {
            show_key(entries, "title");
            show_key(entries, "server.host");
            show_key(entries, "server.port");
            show_key(entries, "server.debug");
            show_key(entries, "server.ratio");
            show_key(entries, "server.tags");
            show_key(entries, "server.ports");
        },
        Result.Err(e) => print("err: " + e),
    }

    // M63.1 — strings conformes: escapes \uXXXX/\b/\f, literal '...', y escape desconocido = Err.
    match (parse_toml("s = \"caf\\u00E9 \\U0001F600\"\np = 'C:\\ruta\\ne'\n")) {
        Result.Ok(entries) => {
            show_key(entries, "s");
            show_key(entries, "p");
        },
        Result.Err(e) => print("err: " + e),
    }
    match (parse_toml("x = \"mal\\q\"")) {
        Result.Ok(entries) => print("no debería parsear"),
        Result.Err(e) => print("err: " + e),
    }
    match (parse_toml("x = \"corto\\u12\"")) {
        Result.Ok(entries) => print("no debería parsear"),
        Result.Err(e) => print("err: " + e),
    }

    // M63.2 — números conformes: separadores `_` (validados: entre dígitos) e inf/nan.
    match (parse_toml("n = 1_000_000\nf = 1_024.5\na = inf\nb = -inf\nc = nan\n")) {
        Result.Ok(entries) => {
            show_key(entries, "n");
            show_key(entries, "f");
            show_key(entries, "a");
            show_key(entries, "b");
            show_key(entries, "c");
        },
        Result.Err(e) => print("err: " + e),
    }
    match (parse_toml("m = 1__0")) {
        Result.Ok(entries) => print("no debería parsear"),
        Result.Err(e) => print("err: " + e),
    }

    // M63.3 — rigor: clave duplicada, cabecera vacía y segunda entrada en la misma línea = Err.
    match (parse_toml("a = 1\na = 2")) {
        Result.Ok(entries) => print("no debería parsear"),
        Result.Err(e) => print("err: " + e),
    }
    match (parse_toml("[]\na = 1")) {
        Result.Ok(entries) => print("no debería parsear"),
        Result.Err(e) => print("err: " + e),
    }
    match (parse_toml("a = 1 b = 2")) {
        Result.Ok(entries) => print("no debería parsear"),
        Result.Err(e) => print("err: " + e),
    }

    // M91.3 — tablas en línea (aplanadas; dentro de arreglos como valor) y arreglos de tablas
    // [[t]] (rutas indexadas t.0, t.1, …; las cabeceras posteriores resuelven por el último).
    let doc = "point = { x = 1, meta = { tag = \"a\" } }\npuntos = [{ x = 1 }, { x = 2 }]\n[[fruit]]\nname = \"apple\"\n[fruit.physical]\ncolor = \"red\"\n[[fruit.variety]]\nvname = \"red delicious\"\n[[fruit]]\nname = \"banana\"\n[[fruit.variety]]\nvname = \"plantain\"\n";
    match (parse_toml(doc)) {
        Result.Ok(entries) => {
            show_key(entries, "point.x");
            show_key(entries, "point.meta.tag");
            show_key(entries, "puntos");
            show_key(entries, "fruit.0.name");
            show_key(entries, "fruit.0.physical.color");
            show_key(entries, "fruit.0.variety.0.vname");
            show_key(entries, "fruit.1.name");
            show_key(entries, "fruit.1.variety.0.vname");
        },
        Result.Err(e) => print("err: " + e),
    }
    match (parse_toml("p = { x = 1,\n y = 2 }")) {
        Result.Ok(entries) => print("no debería parsear"),
        Result.Err(e) => print("err: " + e),
    }
}
