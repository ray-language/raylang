// M28.2 — `?` con conversión de error vía `From<S>`.
//
// El operador `?` sobre un `Result<_, E1>` dentro de una función que devuelve `Result<_, E2>`
// convierte el error automáticamente si existe `impl From<E1> for E2`. Así una librería expone
// su propio enum de error y compone `?` sobre operaciones que fallan con otro tipo (aquí, string).
//
// `From<S>` es un trait con parámetro de tipo (M28.2); su método `desde` no tiene `self` (es
// asociado; se llama `desde` porque `from` es palabra clave del import). El usuario nunca lo
// invoca directamente: solo el `?` lo usa al convertir.
enum AppError {
    Lectura(string),
    Vacio,
}

// Conversión string -> AppError: cualquier `?` sobre un Result con error string, dentro de una
// función que devuelva Result<_, AppError>, envuelve el string en AppError.Lectura.
impl From<string> for AppError {
    fn desde(origen: string) -> AppError { AppError.Lectura(origen) }
}

// Operación de bajo nivel que falla con un `string`.
fn leer_config(ok: bool) -> Result<int, string> {
    if (ok) { Result.Ok(42) } else { Result.Err("no se pudo abrir config") }
}

// Operación de alto nivel que expone AppError. El `?` convierte el error string -> AppError.
fn cargar(ok: bool) -> Result<int, AppError> {
    let valor = leer_config(ok)?;  // string -> AppError automático
    if (valor == 0) {
        return Result.Err(AppError.Vacio);
    }
    Result.Ok(valor * 2)
}

fn show(r: Result<int, AppError>) {
    match (r) {
        Result.Ok(v) => print("ok: " + to_string(v)),
        Result.Err(e) => match (e) {
            AppError.Lectura(msg) => print("error de lectura: " + msg),
            AppError.Vacio => print("config vacía"),
        },
    }
}

fn main() {
    show(cargar(true));  // ok: 84
    show(cargar(false));  // error de lectura: no se pudo abrir config
}
