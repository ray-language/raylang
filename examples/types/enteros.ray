// M28.3 — enteros sin signo con tamaño: u8 / u32 / u64.
//
// `int` sigue siendo el i64 con signo por defecto. Los tipos `u8`/`u32`/`u64` dan aritmética
// **con wrapping** dentro de su ancho (sin panic al desbordar) y bitops sin signo — justo lo que
// la criptografía y el hashing necesitan, eliminando el enmascarado a mano (`& 0xFF`, `& 0xFFFFFFFF`).
//
// No hay promoción implícita: mezclar anchos (o u8 con int) es error; se convierte con `as`.
// FNV-1a de 32 bits: el ejemplo canónico de aritmética u32 con wrapping. Sin u32 habría que
// enmascarar cada paso con `& 0xFFFFFFFF`; aquí el wrapping es automático. Los literales adoptan
// el ancho por el contexto (M28.3b): `h: u32 = 2166136261` sin escribir `as u32`.
fn fnv1a(datos: [u8]) -> u32 {
    var h: u32 = 2166136261;  // offset basis
    let primo: u32 = 16777619;  // FNV prime
    for b in datos {
        h = (h ^ b as u32) * primo;  // XOR + multiplicación, ambos envuelven a 32 bits
    }
    h
}

fn main() {
    // El wrapping de u8: 200 + 100 = 300 → 44 (mod 256), sin error de overflow. Los literales
    // adoptan u8 por el tipo declarado (sin `as`).
    let a: u8 = 200;
    let b: u8 = 100;
    print("u8 wrap: " + to_string((a + b) as int));  // 44

    // ~ y máscara implícita del ancho.
    let cero: u8 = 0;
    print("~0u8 = " + to_string(~cero as int));  // 255

    // FNV-1a sobre unos octetos.
    var datos: [u8] = [104, 105];  // 'h', 'i' (literales coercionados a u8)
    let hash = fnv1a(datos);
    print("fnv1a(\"hi\") = " + to_string(hash as int));

    // u64: aritmética de 64 bits sin signo.
    let grande: u64 = 1000000 * 1000000;  // 10^12 (literales u64)
    print("u64: " + to_string(grande as int));
}
