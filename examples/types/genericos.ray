// Funciones genéricas (M6): un mismo código sirve para cualquier tipo. Los argumentos
// de tipo se INFIEREN de los valores —no se escriben en la llamada—. Con borrado de
// tipos, en runtime no hay rastro de T: una función genérica solo mueve valores, así
// que el intérprete y la VM la ejecutan sin saber qué tipo es.
// La identidad: el ejemplo mínimo de un parámetro de tipo.
fn identidad<T>(x: T) -> T { x }

// Orden superior, genérica en la entrada y en la salida.
fn aplicar<T, U>(f: fn(T) -> U, x: T) -> U { f(x) }

// El último elemento de un arreglo, sea de lo que sea.
fn ultimo<T>(xs: [T]) -> T { xs[xs.len() - 1] }

// Un arreglo de dos elementos del mismo tipo.
fn par<T>(a: T, b: T) -> [T] { [a, b] }

fn doble(n: int) -> int { n * 2 }

fn negar(b: bool) -> bool { !b }

fn main() -> int {
    let a: int = identidad(5);  // T = int, inferido del argumento
    let b: bool = identidad(true);  // T = bool

    print(b);  // true
    print(aplicar(negar, false));  // true  (T=bool, U=bool)

    let xs: [int] = par(10, 20);  // T = int
    print(ultimo(xs));  // 20

    a + aplicar(doble, 18) + ultimo(xs)  // 5 + 36 + 20 = 61
}
