// M28.1 — sobrecarga de operadores vía traits.
//
// Un tipo de usuario puede usar los operadores aritméticos `+ - * /` y el `-` unario si
// implementa los traits del prelude `Add`/`Sub`/`Mul`/`Div`/`Neg`. El checker baja `a + b`
// (con `a`/`b` de ese tipo) a `a.add(b)`, una llamada ordinaria: cero cambios en el runtime.
struct Vec2 {
    x: int,
    y: int,
}

impl Add for Vec2 {
    fn add(self, o: Vec2) -> Vec2 { Vec2 { x: self.x + o.x, y: self.y + o.y } }
}

impl Sub for Vec2 {
    fn sub(self, o: Vec2) -> Vec2 { Vec2 { x: self.x - o.x, y: self.y - o.y } }
}

impl Mul for Vec2 {
    // Producto componente a componente.
    fn mul(self, o: Vec2) -> Vec2 { Vec2 { x: self.x * o.x, y: self.y * o.y } }
}

impl Neg for Vec2 {
    fn neg(self) -> Vec2 { Vec2 { x: 0 - self.x, y: 0 - self.y } }
}

impl Show for Vec2 {
    fn show(self) -> string { "(${self.x}, ${self.y})" }
}

fn main() {
    let a = Vec2 { x: 1, y: 2 };
    let b = Vec2 { x: 3, y: 4 };

    print((a + b).show());  // (4, 6)
    print((b - a).show());  // (2, 2)
    print((a * b).show());  // (3, 8)
    print((-a).show());  // (-1, -2)

    // Encadenado: los operadores componen como cualquier expresión.
    let s = a + b + Vec2 { x: 10, y: 10 };
    print(s.show());  // (14, 16)
}
