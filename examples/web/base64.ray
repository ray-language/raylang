// base64 (RFC 4648) escrito EN raylang. Cero runtime nuevo: puro cómputo sobre los operadores
// bit a bit (M19.3a) y la stdlib de strings. Importable: `from base64 import base64;`.
// M59.5: el encode acumula en StringBuilder (O(n), no O(n²) de `s = s + …`).

// M380 (rayplay #151): el cómputo vive en Rust (`ray_runtime::b64`, builtins `__base64_encode` /
// `__base64_decode`): la versión raylang decodificaba a ~15 MB/s en nativo (~1,7 MB/s en la VM) y
// retenía ~14× la entrada (un `[int]` por octeto antes de `bytes_of`) — 75 MB de base64 eran 1,1 GB
// de pico en un iPhone. La API, la estrictez (M59.3) y los mensajes de error no cambian.

/// Encodes `bytes` as standard base64 (RFC 4648) with `=` padding.
pub fn base64(data: bytes) -> string {
    __base64_encode(data, false)
}

/// Encodes `bytes` as unpadded base64url (RFC 4648 §5, `-`/`_` alphabet) — the JWT/JWS form.
pub fn base64url(data: bytes) -> string {
    __base64_encode(data, true)
}

// El [bytes] etiquetado del builtin → Result (el mensaje de error viaja como bytes UTF-8).
fn decoded(r: [bytes]) -> Result<bytes, string> {
    if (r[0] == b"ok") {
        Result.Ok(r[1])
    } else {
        match (from_utf8(r[1])) {
            Result.Ok(m) => Result.Err(m),
            Result.Err(_) => Result.Err("base64: invalid input"),
        }
    }
}

/// Decodes a standard base64 string (RFC 4648, `+`/`/` alphabet) into `bytes`.
/// Strict: rejects characters outside the alphabet, data after the `=` padding, a length
/// that is not a multiple of 4, over-padding, and non-zero trailing bits (non-canonical
/// encodings), so each payload has exactly one accepted representation. One pass in Rust:
/// ~1× the input in memory, hundreds of MB/s (M380).
pub fn base64_decode(s: string) -> Result<bytes, string> {
    decoded(__base64_decode(s, false))
}

/// Decodes the octet range `[from, to)` of `data` (clamped like `sub_bytes`) as standard base64,
/// without copying the range or going through a `string`: the body of a request that arrived as
/// `bytes` is decoded in place (`b.index_of(b"\n")` + `base64_decode_bytes(b, cut + 1, b.len())`).
/// Same strictness and errors as `base64_decode` (M395, rayplay #161).
pub fn base64_decode_bytes(data: bytes, from: int, to: int) -> Result<bytes, string> {
    decoded(__base64_decode_bytes(data, from, to, false))
}

/// Decodes the octet range `[from, to)` of `data` (clamped like `sub_bytes`) as unpadded base64url,
/// without copying the range or going through a `string`. Same strictness as `base64url_decode`.
pub fn base64url_decode_bytes(data: bytes, from: int, to: int) -> Result<bytes, string> {
    decoded(__base64_decode_bytes(data, from, to, true))
}

/// Decodes an unpadded base64url string (RFC 4648 §5, `-`/`_` alphabet) into `bytes`.
/// Strict: rejects characters outside the alphabet (including `=`), a 1-character tail,
/// and non-zero trailing bits (non-canonical encodings), so each payload has exactly one
/// accepted representation — this matters for JWT, where the signature covers the encoding.
pub fn base64url_decode(s: string) -> Result<bytes, string> {
    decoded(__base64_decode(s, true))
}
