// ChaCha20 (RFC 8439 §2.4) escrito EN raylang. El cifrador de flujo moderno de Bernstein: 20 rondas
// de suma/XOR/rotación sobre palabras de 32 bits. Cero runtime nuevo.
//
// **Showcase de los enteros con tamaño (M28.3)**: ChaCha20 es aritmética de 32 bits pura. Antes habría
// que enmascarar cada suma con `& 0xFFFFFFFF` (como en `sha256.ray`); con `u32` el wrapping es
// automático y el código queda idéntico al pseudocódigo del RFC.
//
// Entrada/salida de octetos como `[int]` (0..255). La clave son 32 octetos, el nonce 12. Importable:
// `from chacha20 import chacha20_encrypt, chacha20_block;`.
// Rotación de 32 bits a la IZQUIERDA (la que usa ChaCha20).
fn rotl32(x: u32, n: u32) -> u32 {
    x << n | x >> 32 - n
}

// El "quarter round": el corazón de ChaCha20. Muta 4 palabras del estado `st` en las posiciones a,b,c,d.
fn quarter_round(st: [u32], a: int, b: int, c: int, d: int) {
    st[a] = st[a] + st[b];
    st[d] = rotl32(st[d] ^ st[a], 16);
    st[c] = st[c] + st[d];
    st[b] = rotl32(st[b] ^ st[c], 12);
    st[a] = st[a] + st[b];
    st[d] = rotl32(st[d] ^ st[a], 8);
    st[c] = st[c] + st[d];
    st[b] = rotl32(st[b] ^ st[c], 7);
}

// Lee 4 octetos de `b` desde el índice `i` como una palabra u32 en little-endian.
fn word_le(b: [int], i: int) -> u32 {
    b[i] as u32 | b[i + 1] as u32 << 8 | b[i + 2] as u32 << 16 | b[i + 3] as u32 << 24
}

// El bloque ChaCha20: dada clave (32 octetos), contador y nonce (12 octetos), produce 64 octetos de
// flujo de clave. El estado inicial son 16 palabras: 4 constantes + 8 de clave + contador + 3 de nonce.
pub fn chacha20_block(key: [int], counter: u32, nonce: [int]) -> [int] {
    var st: [u32] = [];
    st.push(1634760805 as u32);  // "expa" (0x61707865)
    st.push(857760878 as u32);  // "nd 3" (0x3320646e)
    st.push(2036477234 as u32);  // "2-by" (0x79622d32)
    st.push(1797285236 as u32);  // "te k" (0x6b206574)
    var i = 0;
    while (i < 8) {
        st.push(word_le(key, i * 4));
        i = i + 1;
    }
    st.push(counter);
    st.push(word_le(nonce, 0));
    st.push(word_le(nonce, 4));
    st.push(word_le(nonce, 8));

    // Copia de trabajo sobre la que se aplican las rondas.
    var work: [u32] = [];
    i = 0;
    while (i < 16) {
        work.push(st[i]);
        i = i + 1;
    }

    // 20 rondas = 10 dobles rondas (columnas + diagonales).
    var r = 0;
    while (r < 10) {
        quarter_round(work, 0, 4, 8, 12);
        quarter_round(work, 1, 5, 9, 13);
        quarter_round(work, 2, 6, 10, 14);
        quarter_round(work, 3, 7, 11, 15);
        quarter_round(work, 0, 5, 10, 15);
        quarter_round(work, 1, 6, 11, 12);
        quarter_round(work, 2, 7, 8, 13);
        quarter_round(work, 3, 4, 9, 14);
        r = r + 1;
    }

    // Suma el estado original (u32, con wrapping) y serializa en little-endian.
    var out: [int] = [];
    i = 0;
    while (i < 16) {
        let w = work[i] + st[i];
        out.push((w & 255) as int);
        out.push((w >> 8 & 255) as int);
        out.push((w >> 16 & 255) as int);
        out.push((w >> 24 & 255) as int);
        i = i + 1;
    }
    out
}

// Cifra (o descifra: es XOR, la operación es su propia inversa) `data` con ChaCha20. `counter` es el
// contador de bloque inicial (1 en el AEAD del RFC; 0 para el flujo puro).
pub fn chacha20_encrypt(key: [int], counter: u32, nonce: [int], data: [int]) -> [int] {
    var out: [int] = [];
    let n = data.len();
    var bc = counter;
    var i = 0;
    while (i < n) {
        let ks = chacha20_block(key, bc, nonce);
        var j = 0;
        while (j < 64 && i + j < n) {
            out.push(data[i + j] ^ ks[j]);
            j = j + 1;
        }
        i = i + 64;
        bc = bc + 1;
    }
    out
}
