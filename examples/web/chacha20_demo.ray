// Demo de ChaCha20 (RFC 8439 §2.4.2): cifra el texto de ejemplo del RFC con la clave/nonce/contador
// del estándar y verifica que el criptograma coincide byte a byte con el vector oficial. Además hace
// round-trip (descifrar el criptograma recupera el texto).

from chacha20 import chacha20_encrypt;
from hex import hex_encode;

// Convierte una cadena ASCII en octetos.
fn str_bytes(s: string) -> [int] {
    var b: [int] = [];
    for c in s {
        push(b, c as int);
    }
    b
}

fn main() {
    // Clave: los octetos 0..31.
    var key: [int] = [];
    var i = 0;
    while (i < 32) {
        push(key, i);
        i = i + 1;
    }
    // Nonce (12 octetos): 00 00 00 00 00 00 00 4a 00 00 00 00.
    let nonce: [int] = [0, 0, 0, 0, 0, 0, 0, 74, 0, 0, 0, 0];
    // Contador inicial: 1.
    let counter = 1 as u32;

    let texto = "Ladies and Gentlemen of the class of '99: If I could offer you only one tip for the future, sunscreen would be it.";
    let pt = str_bytes(texto);

    let ct = chacha20_encrypt(key, counter, nonce, pt);
    print(hex_encode(ct));

    // Round-trip: descifrar (XOR de nuevo) recupera el texto original.
    let back = chacha20_encrypt(key, counter, nonce, ct);
    var igual = len(back) == len(pt);
    var j = 0;
    while (j < len(pt)) {
        if (back[j] != pt[j]) {
            igual = false;
        }
        j = j + 1;
    }
    if (igual) {
        print("roundtrip ok");
    } else {
        print("roundtrip FALLO");
    }
}
