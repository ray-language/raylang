// Cookies HTTP escritas EN raylang. Cero runtime nuevo. Parsea la cabecera `Cookie:` de petición y
// construye valores `Set-Cookie:` de respuesta. Importable:
//   from cookie import parse_cookies, cookie, set_cookie, with_path, with_max_age, with_http_only, with_secure, with_same_site;
from url import url_encode, url_decode;

// `url_decode` tolerante (devuelve el crudo si falla).
fn decode_or(s: string) -> string {
    match (url_decode(s)) {
        Result.Ok(v) => v,
        Result.Err(_) => s,
    }
}

// Parsea la cabecera de petición `Cookie: a=1; b=hola%20mundo` en un `Map<string,string>`.
pub fn parse_cookies(header: string) -> Map<string, string> {
    var m: Map<string, string> = Map.new();
    let parts = header.split(";");
    var i = 0;
    while (i < parts.len()) {
        let p = parts[i].trim();
        if (p.len() > 0) {
            match (index_of(p, "=")) {
                Option.Some(eq) => {
                    let k = p.substring(0, eq).trim();
                    let v = decode_or(p.substring(eq + 1, p.len()).trim());
                    m.insert(k, v);
                },
                Option.None => { },
            }
        }
        i = i + 1;
    }
    m
}

// Una cookie a emitir (`Set-Cookie`). Los atributos opcionales se ponen con los setters `with_*`,
// encadenables vía UFCS: `cookie("sid","abc").with_path("/").with_http_only()`.
struct Cookie {
    name: string,
    value: string,
    path: string,
    max_age: int,
    http_only: bool,
    secure: bool,
    same_site: string,
}

// < 0 = sin Max-Age; same_site "" = sin el atributo
// M71: quita los caracteres que permitirían inyectar cabeceras (CR, LF) o romper el
// framing del Set-Cookie (`;`), como el saneo silencioso de `net/http` de Go. El VALOR se
// protege aparte con url_encode; el nombre y el Path no se codifican, así que se sanean aquí.
fn sanitize(s: string) -> string {
    let cs = s.chars();
    var out: [string] = [];
    var i = 0;
    while (i < cs.len()) {
        let c = cs[i];
        if (c != '\r' && c != '\n' && c != ';') {
            out.push(to_string(c));
        }
        i = i + 1;
    }
    join(out, "")
}

// Crea una cookie con solo nombre y valor (sin atributos).
pub fn cookie(name: string, value: string) -> Cookie {
    Cookie {
        name: name,
        value: value,
        path: "",
        max_age: 0 - 1,
        http_only: false,
        secure: false,
        same_site: ""
    }
}

// Setters encadenables (mutan por referencia y devuelven la cookie). Nombres `with_*` para no chocar
// con los campos homónimos (en UFCS el campo ganaría a la función).
pub fn with_path(c: Cookie, p: string) -> Cookie {
    c.path = p;
    c
}

pub fn with_max_age(c: Cookie, n: int) -> Cookie {
    c.max_age = n;
    c
}

pub fn with_http_only(c: Cookie) -> Cookie {
    c.http_only = true;
    c
}

pub fn with_secure(c: Cookie) -> Cookie {
    c.secure = true;
    c
}

// M71: SameSite (Strict/Lax/None), el atributo anti-CSRF de facto. Un valor no reconocido se
// ignora (se deja "") para no emitir un Set-Cookie inválido.
pub fn with_same_site(c: Cookie, v: string) -> Cookie {
    if (v == "Strict" || v == "Lax") {
        c.same_site = v;
    } else if (v == "None") {
        c.same_site = v;
        c.secure = true;  // los navegadores rechazan SameSite=None sin Secure
    }
    c
}

// Serializa la cookie a un valor de cabecera `Set-Cookie`. El valor se url-codifica; el nombre y
// el Path se sanean (M71: sin CR/LF/`;` → no se pueden inyectar cabeceras).
pub fn set_cookie(c: Cookie) -> string {
    var s = sanitize(c.name) + "=" + url_encode(c.value);
    if (c.path.len() > 0) {
        s = s + "; Path=" + sanitize(c.path);
    }
    if (c.max_age >= 0) {
        s = s + "; Max-Age=" + to_string(c.max_age);
    }
    if (c.http_only) {
        s = s + "; HttpOnly";
    }
    if (c.secure) {
        s = s + "; Secure";
    }
    if (c.same_site.len() > 0) {
        s = s + "; SameSite=" + c.same_site;
    }
    s
}
