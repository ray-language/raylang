// Demo/verificación de las librerías SHA-1 y base64 (M19.3b) contra vectores conocidos.
// Lo ejecuta `tests/websocket_cli.rs`. Cada línea de salida se compara con su valor de referencia.
from sha1 import sha1, sha1_hex;
from base64 import base64;

// Octetos (`[int]`) de un string (vía `to_bytes` + indexado de bytes).
fn str_octets(s: string) -> [int] {
    let b = s.to_bytes();
    var out: [int] = [];
    var i = 0;
    while (i < b.len()) {
        out.push(b[i]);
        i = i + 1;
    }
    out
}

fn main() {
    // --- SHA-1 (RFC 3174 / vectores estándar) ---
    print(sha1_hex("".to_bytes()));  // da39a3ee5e6b4b0d3255bfef95601890afd80709
    print(sha1_hex("abc".to_bytes()));  // a9993e364706816aba3e25717850c26c9cd0d89d
    print(sha1_hex("The quick brown fox jumps over the lazy dog".to_bytes()));  // 2fd4e1c6...
    // Mensaje multi-bloque (56 'a' → cruza el límite de 64 octetos con el padding).
    print(sha1_hex("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa".to_bytes()));

    // --- base64 (RFC 4648) ---
    print(base64(str_octets("Man")));  // TWFu  (sin relleno)
    print(base64(str_octets("Ma")));  // TWE=  (un '=')
    print(base64(str_octets("M")));  // TQ==  (dos '=')
    print(base64(str_octets("any carnal pleasure.")));  // YW55IGNhcm5hbCBwbGVhc3VyZS4=

    // --- handshake de WebSocket (RFC 6455 §1.3): base64(SHA-1(key + GUID)) ---
    let key = "dGhlIHNhbXBsZSBub25jZQ==";
    let guid = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11";
    print(base64(sha1((key + guid).to_bytes())));  // s3pPLMBiTxaQ9kYGzzhZRbK+xOo=
}
