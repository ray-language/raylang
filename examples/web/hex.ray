// Codificación hexadecimal (RFC 4648 §8) escrita EN raylang. Cero runtime nuevo. Convierte entre
// `bytes` y su representación hexadecimal en minúsculas (M60: la API habla `bytes`, no `[int]`).
// Importable: `from hex import hex_encode, hex_decode;`. Útil para digests, claves, fingerprints.
// M59.5: hex_encode acumula en StringBuilder (O(n), no O(n²) de `s = s + …`).

// El dígito hexadecimal (minúscula) del valor `d` (0..15).
fn hex_digit(d: int) -> string {
    let digits = "0123456789abcdef";
    to_string(digits[d])
}

// El valor (0..15) de un dígito hexadecimal, o -1 si el carácter no es hexadecimal. raylang no
// permite aritmética sobre `char` → se busca el carácter (en minúscula) en la tabla de dígitos.
fn hex_val(c: char) -> int {
    match (index_of("0123456789abcdef", to_string(c).to_lower())) {
        Option.Some(i) => i,
        Option.None => 0 - 1,
    }
}

// Octetos → string hexadecimal (2 dígitos por octeto, minúsculas).
/// Encodes `bytes` as a lowercase hexadecimal string (RFC 4648 §8).
/// Each byte produces exactly two hex digits.
pub fn hex_encode(data: bytes) -> string {
    // M359 (raylb L13): los códigos de los dígitos en un arreglo de ints y UNA conversión al final
    // (`bytes_of` + `from_utf8`), sin un string por octeto — 111 µs → unos pocos µs por id de traza.
    let digits = b"0123456789abcdef";
    var out: [int] = [];
    var i = 0;
    while (i < data.len()) {
        let o = data[i];
        out.push(digits[o >> 4 & 15]);
        out.push(digits[o & 15]);
        i = i + 1;
    }
    match (from_utf8(bytes_of(out))) {
        Result.Ok(s) => s,
        Result.Err(_) => "",
    }
}

// String hexadecimal → octetos. `Err` si la longitud es impar o hay un carácter no hexadecimal.
/// Decodes a hexadecimal string (upper- or lowercase) into `bytes`.
/// Returns `Err` if the string has odd length or contains a non-hex character.
pub fn hex_decode(s: string) -> Result<bytes, string> {
    let n = s.len();
    if (n % 2 != 0) {
        return Result.Err("odd-length hex string");
    }
    var out: [int] = [];
    var i = 0;
    while (i < n) {
        let hi = hex_val(s[i]);
        let lo = hex_val(s[i + 1]);
        if (hi < 0 || lo < 0) {
            return Result.Err("invalid hex character");
        }
        out.push(hi << 4 | lo);
        i = i + 2;
    }
    Result.Ok(bytes_of(out))
}
