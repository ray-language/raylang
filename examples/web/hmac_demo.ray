// Demo/verificación de HMAC-SHA256, base64url y hex (M20.2) contra vectores conocidos.
// Lo ejecuta `tests/hmac_cli.rs`. Cada línea de salida se compara con su valor de referencia
// (RFC 4231 para HMAC, `openssl`/`python base64.urlsafe_b64encode` para el resto).
from hmac import hmac_sha256_hex, hmac_sha256;
from base64 import base64url, base64url_decode;
from hex import hex_encode, hex_decode;

fn main() {
    // --- HMAC-SHA256 (RFC 4231 §4.3 + vectores de openssl) ---
    print(hmac_sha256_hex("Jefe".to_bytes(), "what do ya want for nothing?".to_bytes()));
    // 5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843
    print(hmac_sha256_hex("key".to_bytes(), "The quick brown fox jumps over the lazy dog".to_bytes()));
    // f7bc83f430538424b13298e6aa6fb143ef4d59a14946175997479dbc2d1a3cd8
    // Clave más larga que el bloque (>64 octetos) → se hashea antes.
    print(hmac_sha256_hex("clave-larguisima-de-mas-de-sesenta-y-cuatro-octetos-para-forzar-el-hash-previo".to_bytes(), "mensaje".to_bytes()));
    // 7d5c78edf5aae49e5d1bf1106e250485811585bcad0d78ebbea235d9f320a0dd
    // --- base64url (sin relleno, alfabeto URL-safe) ---
    print(base64url(hex_decode_ok("4d616e")));  // TWFu  ("Man")
    print(base64url(bytes_of([251, 255, 191])));  // -_-_  (ejerce '-' y '_')
    print(base64url("{\"alg\":\"HS256\"}".to_bytes()));  // eyJhbGciOiJIUzI1NiJ9 (cabecera JWT)

    // --- round-trip: base64url_decode(base64url(x)) == x ---
    let original = bytes_of(hmac_sha256("key".to_bytes(), "dato".to_bytes()));
    match (base64url_decode(base64url(original))) {
        Result.Ok(vuelta) => print(hex_encode(vuelta) == hex_encode(original)),  // true
        Result.Err(e) => print(e),
    }

    // --- hex round-trip ---
    match (hex_decode("deadbeef")) {
        Result.Ok(o) => print(hex_encode(o)),  // deadbeef
        Result.Err(e) => print(e),
    }
}


// hex_decode que asume entrada válida (para la demo).
fn hex_decode_ok(s: string) -> bytes {
    match (hex_decode(s)) {
        Result.Ok(o) => o,
        Result.Err(e) => {
            panic(e);
            b""
        },
    }
}
