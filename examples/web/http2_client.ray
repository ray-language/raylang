// Cliente HTTP/2 vivo (RFC 7540) escrito EN raylang. Cablea el framing (`http2.ray`) + HPACK
// (`hpack.ray`) sobre una conexión TLS con ALPN `h2` (M31.2a). Hace un GET completo: connection
// preface + intercambio de SETTINGS + HEADERS (petición) + lectura de la respuesta (HEADERS + DATA),
// hasta END_STREAM. Importable: `from http2_client import http2_get, Http2Response;`.
//
// Es el transporte que necesita un cliente gRPC (M31.3): gRPC = HTTP/2 + framing de mensajes en DATA.
from http2 import preface, settings_empty, settings_ack, headers_frame, parse_frame, frame_size, window_update_frame, ping_ack, rst_error_code, ft_settings, ft_headers, ft_data, ft_goaway, ft_ping, ft_rst_stream, fl_ack, fl_end_stream, Http2Frame;
from hpack import new_hpack, encode, decode, header, HEntry;
import std/net;

// La respuesta: el código de estado (`:status`) y el cuerpo (concatenación de los frames DATA).
pub struct Http2Response {
    status: int,
    body: bytes,
}

// M73: topes anti-bomba (como grpc_client). Un servidor malicioso/roto podría enviar frames DATA
// indefinidos o declarar un frame gigante (24 bits ⇒ hasta 16 MB) → agotamiento de memoria.
fn max_response() -> int {
    67108864  // 64 MiB de cuerpo acumulado
}

fn max_frame() -> int {
    1048576  // 1 MiB por frame (>> el max-frame por defecto de HTTP/2, 16 KiB)
}

// Busca el pseudo-header `:status` en una lista de cabeceras decodificadas.
fn extract_status(hs: [HEntry]) -> int {
    var st = 0;
    var i = 0;
    while (i < hs.len()) {
        if (hs[i].name == ":status") {
            match (parse_int(hs[i].value)) {
                Option.Some(n) => {
                    st = n;
                },
                Option.None => {
                    st = 0;
                },
            }
        }
        i = i + 1;
    }
    st
}

// Hace un GET sobre HTTP/2 a `host:port` con la ruta dada (por TLS, ALPN `h2`).
pub fn http2_get(host: string, port: int, path: string) -> Result<Http2Response, string> {
    let h = match (net.tls_connect_h2(host, port)) {
        Result.Ok(x) => x,
        Result.Err(e) => {
            return Result.Err(e);
        },
    };

    // Petición: preface + SETTINGS del cliente + HEADERS (stream 1, END_STREAM porque el GET no lleva
    // cuerpo). Las pseudo-cabeceras van en orden: :method, :path, :scheme, :authority.
    let enc = new_hpack();
    let reqhdrs = [header(":method", "GET"), header(":path", path), header(":scheme", "https"), header(":authority", host)];
    let block = encode(enc, reqhdrs);
    let salida = preface() + settings_empty() + headers_frame(1, block, true);
    match (net.socket_write_bytes(h, salida)) {
        Result.Ok(n) => { },
        Result.Err(e) => {
            close(h);
            return Result.Err(e);
        },
    }

    // Respuesta: acumula bytes, extrae frames completos y procesa hasta END_STREAM en el stream 1.
    let dec = new_hpack();
    var buf = b"";
    var status = 0;
    var body = b"";
    var done = false;
    while (!done) {
        match (net.socket_read_bytes(h)) {
            Result.Ok(chunk) => {
                if (chunk.len() == 0) {
                    done = true;  // el peer cerró
                }
                buf = buf + chunk;
            },
            Result.Err(e) => {
                close(h);
                return Result.Err(e);
            },
        }
        // M73: un frame que declara más que el tope se rechaza antes de acumular sus octetos.
        if (frame_size(buf) > max_frame()) {
            close(h);
            return Result.Err("frame HTTP/2 excede el límite (" + to_string(frame_size(buf)) + " octetos)");
        }
        while (frame_size(buf) > 0 && buf.len() >= frame_size(buf)) {
            let fsz = frame_size(buf);
            let fbytes = buf.sub_bytes(0, fsz);
            buf = buf.sub_bytes(fsz, buf.len());
            match (parse_frame(fbytes)) {
                Result.Ok(fr) => {
                    if (fr.ftype == ft_settings()) {
                        if ((fr.flags & fl_ack()) == 0) {
                            // SETTINGS del servidor → responder ACK.
                            match (net.socket_write_bytes(h, settings_ack())) {
                                Result.Ok(x) => { },
                                Result.Err(e) => {
                                    close(h);
                                    return Result.Err(e);
                                },
                            }
                        }
                    } else if (fr.ftype == ft_headers()) {
                        match (decode(dec, fr.payload)) {
                            Result.Ok(hs) => {
                                status = extract_status(hs);
                            },
                            Result.Err(e) => {
                                close(h);
                                return Result.Err("HPACK: " + e);
                            },
                        }
                    } else if (fr.ftype == ft_data()) {
                        // M73: tope de respuesta acumulada (anti-bomba de memoria).
                        if (body.len() + fr.payload.len() > max_response()) {
                            close(h);
                            return Result.Err("respuesta HTTP/2 excede el límite (posible bomba de memoria)");
                        }
                        body = body + fr.payload;
                        // M58.3 — flow control: devolver la ventana consumida (conexión + stream);
                        // sin esto, el servidor se para a los 65535 octetos iniciales (§6.9).
                        // Best effort: si el peer ya envió todo y cerró, el crédito es irrelevante
                        // (el EOF/fin de stream sale por la lectura, no por esta escritura).
                        if (fr.payload.len() > 0) {
                            let wu = window_update_frame(0, fr.payload.len()) + window_update_frame(fr.stream_id, fr.payload.len());
                            match (net.socket_write_bytes(h, wu)) {
                                Result.Ok(x) => { },
                                Result.Err(x) => { },
                            }
                        }
                    } else if (fr.ftype == ft_ping()) {
                        // M58.3: un PING del servidor exige ACK (sonda de vida en transferencias largas).
                        if ((fr.flags & fl_ack()) == 0) {
                            match (net.socket_write_bytes(h, ping_ack(fr.payload))) {
                                Result.Ok(x) => { },
                                Result.Err(x) => { },
                            }
                        }
                    } else if (fr.ftype == ft_rst_stream()) {
                        // M58.3: un stream reseteado es un error con causa (antes: leer hasta EOF).
                        if (fr.stream_id == 1) {
                            close(h);
                            return Result.Err("el servidor reseteó el stream (RST_STREAM, código " + to_string(rst_error_code(fr.payload)) + ")");
                        }
                    } else if (fr.ftype == ft_goaway()) {
                        close(h);
                        return Result.Err("el servidor envió GOAWAY");
                    }
                    if (fr.stream_id == 1 && (fr.flags & fl_end_stream()) != 0) {
                        done = true;
                    }
                },
                Result.Err(e) => {
                    close(h);
                    return Result.Err(e);
                },
            }
        }
    }
    close(h);
    Result.Ok(Http2Response { status: status, body: body })
}
