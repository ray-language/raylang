// Demo/verificación de HPACK (RFC 7541) + framing HTTP/2 (RFC 7540) (M26). HPACK se verifica contra los
// vectores oficiales del Apéndice C.3 (las tres peticiones con tabla dinámica compartida). Determinista,
// lo ejecuta `tests/http2_cli.rs`. (HTTP/2 completo necesita además HPACK-Huffman y el transporte vivo;
// aquí: framing + HPACK no-Huffman, suficiente para construir una petición HTTP/2 / gRPC.)
from hpack import HEntry, Hpack, header, new_hpack, encode, decode;
from hex import hex_decode;
from http2 import preface, parse_frame, Http2Frame, headers_frame;

fn req1() -> [HEntry] {
    [
        header(":method", "GET"),
        header(":scheme", "http"),
        header(":path", "/"),
        header(":authority", "www.example.com")
    ]
}

// Decodifica un bloque HPACK dado en hex y imprime sus cabeceras (todas, o solo la última).
fn decode_and_print(dec: Hpack, hex_block: string, all: bool) {
    let block = match (hex_decode(hex_block)) {
        Result.Ok(b) => b,
        Result.Err(e) => {
            print("ERR hex: " + e);
            return;
        },
    };
    match (decode(dec, block)) {
        Result.Ok(hs) => {
            var i = if (all) { 0 } else { hs.len() - 1 };
            while (i < hs.len()) {
                print(hs[i].name + ": " + hs[i].value);
                i = i + 1;
            }
        },
        Result.Err(e) => print("ERR decode: " + e),
    }
}

fn main() {
    // --- HPACK: las 3 peticiones del RFC 7541 §C.3, con la MISMA tabla dinámica (encoder). ---
    let enc = new_hpack();
    let block1 = encode(enc, req1());
    print(to_string(block1));  // 828684410f7777772e6578616d706c652e636f6d

    print(
        to_string(
            encode(
                enc,
                [
                    header(":method", "GET"),
                    header(":scheme", "http"),
                    header(":path", "/"),
                    header(":authority", "www.example.com"),
                    header("cache-control", "no-cache")
                ]
            )
        )
    );
    // 828684be58086e6f2d6361636865
    print(
        to_string(
            encode(
                enc,
                [
                    header(":method", "GET"),
                    header(":scheme", "https"),
                    header(":path", "/index.html"),
                    header(":authority", "www.example.com"),
                    header("custom-key", "custom-value")
                ]
            )
        )
    );
    // 828785bf400a637573746f6d2d6b65790c637573746f6d2d76616c7565
    // --- Decodificación: el bloque de C.3.1 → la lista original (round-trip). ---
    let dec = new_hpack();
    match (decode(dec, block1)) {
        Result.Ok(hs) => {
            var i = 0;
            while (i < hs.len()) {
                print(hs[i].name + ": " + hs[i].value);
                i = i + 1;
            }
        },
        Result.Err(e) => print("ERR decode: " + e),
    }

    // --- M133: los vectores CON Huffman (RFC 7541 §C.4) — la misma serie de peticiones, con
    // los literales de string comprimidos. Los servidores reales (grpc-go) codifican así. ---
    let dec4 = new_hpack();
    decode_and_print(dec4, "828684418cf1e3c2e5f23a6ba0ab90f4ff", true);
    decode_and_print(dec4, "828684be5886a8eb10649cbf", false);
    decode_and_print(dec4, "828785bf408825a849e95ba97d7f8925a849e95bb8e8b4bf", false);

    // --- HTTP/2 framing: round-trip de un HEADERS frame (stream 1, END_HEADERS+END_STREAM). ---
    let block = encode(new_hpack(), [header(":method", "GET"), header(":path", "/")]);
    let frame = headers_frame(1, block, true);
    match (parse_frame(
        frame
    )) {
        Result.Ok(f) => print(
            "HEADERS type=" + to_string(f.ftype) + " stream=" + to_string(f.stream_id) + " flags=" + to_string(f.flags) + " blocklen=" + to_string(f.payload.len())
        ),
        Result.Err(e) => print("ERR frame: " + e),
    }

    // La connection preface del cliente (los 24 octetos mágicos).
    print(to_string(preface()));
}
