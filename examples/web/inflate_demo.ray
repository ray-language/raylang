// Demo/verificación de INFLATE (M20.10): descomprime blobs gzip generados por Python (`gzip.compress`)
// y comprueba que el texto recuperado es exacto. Cubre los TRES tipos de bloque DEFLATE: almacenado
// (nivel 0), Huffman fijo (texto corto nivel 9) y Huffman dinámico (texto largo). Lo ejecuta
// `tests/inflate_cli.rs`. Salida determinista (cómputo puro).

from inflate import gunzip, inflate_raw, crc32;

fn main() {
    // --- Bloque Huffman FIJO (BTYPE=1): texto corto comprimido a nivel 9. ---
    let g_fijo = b"\x1f\x8b\x08\x00\x00\x00\x00\x00\x02\xff\x2b\x4a\xac\xcc\x49\xcc\x4b\x57\x48\x2d\x56\x28\xcd\x53\xc8\x49\xcd\x4b\x2f\x4d\xcc\x4a\x55\x48\x49\x55\x48\x2c\x28\x4a\xcd\x4b\xc9\xac\x02\x72\xf5\x14\x8a\x10\xca\x52\x32\xcb\x52\x8b\x4a\x32\x53\xf2\x11\xa2\x68\xb4\x22\x00\xa8\x6c\xc0\x03\x55\x00\x00\x00";
    print(texto(g_fijo));

    // --- Bloque ALMACENADO (BTYPE=0): el mismo texto comprimido a nivel 0. ---
    let g_stored = b"\x1f\x8b\x08\x00\x00\x00\x00\x00\x04\xff\x01\x55\x00\xaa\xff\x72\x61\x79\x6c\x61\x6e\x67\x20\x65\x73\x20\x75\x6e\x20\x6c\x65\x6e\x67\x75\x61\x6a\x65\x20\x64\x65\x20\x61\x70\x72\x65\x6e\x64\x69\x7a\x61\x6a\x65\x2e\x20\x72\x61\x79\x6c\x61\x6e\x67\x20\x65\x73\x20\x64\x69\x76\x65\x72\x74\x69\x64\x6f\x2e\x20\x72\x61\x79\x6c\x61\x6e\x67\x20\x72\x61\x79\x6c\x61\x6e\x67\x20\x72\x61\x79\x6c\x61\x6e\x67\x21\xa8\x6c\xc0\x03\x55\x00\x00\x00";
    print(texto(g_stored));

    // --- Bloque Huffman DINÁMICO (BTYPE=2): texto largo y variado. ---
    let g_din = b"\x1f\x8b\x08\x00\x00\x00\x00\x00\x02\xff\xed\x8e\xd9\x72\x01\x51\x18\x06\x5f\xe5\x4b\x59\x0a\x17\x63\x8b\xa0\x2a\x15\x82\x21\x8b\x9d\x24\x96\xa2\xea\x77\xe6\xe0\xf0\x9b\x93\xcc\x12\x5b\x79\x77\xf3\x12\xee\x5c\x75\xf7\x5d\x9b\x8c\x7f\xc9\xfa\x84\x9d\xef\x08\x25\x99\x56\x1a\x6b\x65\x5b\x3e\x84\xde\x29\xc2\x52\xb2\x3a\x41\x90\x63\x29\x66\x8d\x23\xb6\x6a\xaf\x0c\x34\x09\x42\xad\x7c\x69\x13\x3c\x2d\x68\x41\x90\x0c\x97\x0e\x7a\xa9\x6d\x58\xd2\x73\xc8\x0d\xc0\xf8\x25\x96\xf6\x9f\x2f\x83\x08\x7c\x43\x06\x52\xe9\x4c\xf6\x31\xf7\x94\x2f\x14\xf1\x5a\xa9\xd6\xcc\x7a\xe3\xed\xfd\xe3\xb3\xd9\x6a\x77\xba\xbd\xfe\x60\xf8\xf5\xfd\x33\x1a\x4f\xf0\x50\x0e\x85\x23\xf3\x68\x22\x16\xc7\xf9\x32\x9d\x3d\xbf\x94\x92\x06\xcc\xfb\xeb\x4d\x5e\xaf\x3e\x86\x35\x96\x04\x02\x00\x00";
    let t = texto(g_din);
    print(len(t));            // 516 (longitud del texto descomprimido)
    print(substring(t, 0, 41)); // El veloz murcielago hindu comia feliz...

    // --- CRC-32 (vector estándar: crc32("123456789") = 0xcbf43926 = 3421780262). ---
    print(to_string(crc32(to_bytes("123456789"))));
}

// gunzip + decodifica a texto; aborta con el error si algo falla (la demo asume blobs válidos).
fn texto(g: bytes) -> string {
    match (gunzip(g)) {
        Result.Ok(b) => match (from_utf8(b)) {
            Result.Ok(s) => s,
            Result.Err(e) => { panic("utf8: " + e); "" },
        },
        Result.Err(e) => { panic("gunzip: " + e); "" },
    }
}
