// M15.4a — una librería JSON escrita ENTERAMENTE en raylang.
//
// Demuestra el cambio de registro de M15: los protocolos no son builtins (Rust), se escriben en el
// propio lenguaje y se traen con `import`. parse/stringify sobre la stdlib (string, Map, Result);
// cero código de runtime. Los objetos usan Map<string, Json> → claves ordenadas al serializar
// (stringify canónico, round-trip estable). Errores como valores (Result), nunca panic.
//
// Limitación: los escapes \uXXXX no se soportan (convertir un code point a char pediría un builtin).
pub enum Json {
    JNull,
    JBool(bool),
    JNum(float),
    JStr(string),
    JArray([Json]),
    JObject(Map<string, Json>),
}

// --- Parser de descenso recursivo. El estado (texto + cursor) se muta por referencia. ---
struct P {
    s: string,
    i: int,
    n: int,
}

fn at_end(p: P) -> bool { p.i >= p.n }

fn cur(p: P) -> char { p.s[p.i] }

fn skip_ws(p: P) {
    var seguir: bool = true;
    while (seguir) {
        if (at_end(p)) {
            seguir = false;
        } else {
            let c: char = cur(p);
            if (c == ' ' || c == '\n' || c == '\t' || c == '\r') {
                p.i = p.i + 1;
            } else {
                seguir = false;
            }
        }
    }
}

// ¿El texto en el cursor empieza por `kw`? Si sí, avanza el cursor y devuelve true.
fn lit(p: P, kw: string) -> bool {
    let m: int = len(kw);
    if (p.i + m > p.n) {
        false
    } else if (substring(p.s, p.i, p.i + m) == kw) {
        p.i = p.i + m;
        true
    } else {
        false
    }
}

fn parse_value(p: P) -> Result<Json, string> {
    skip_ws(p);
    if (at_end(p)) {
        return Result.Err("fin inesperado del texto");
    }
    let c: char = cur(p);
    if (c == '{') {
        parse_object(p)
    } else if (c == '[') {
        parse_array(p)
    } else if (c == '"') {
        parse_string_value(p)
    } else if (c == 't' || c == 'f') {
        parse_bool(p)
    } else if (c == 'n') {
        if (lit(p, "null")) { Result.Ok(Json.JNull) } else { Result.Err("se esperaba 'null'") }
    } else {
        parse_number(p)
    }
}

fn parse_bool(p: P) -> Result<Json, string> {
    if (lit(p, "true")) {
        Result.Ok(Json.JBool(true))
    } else if (lit(p, "false")) {
        Result.Ok(Json.JBool(false))
    } else {
        Result.Err("se esperaba 'true' o 'false'")
    }
}

fn is_num_char(c: char) -> bool {
    c >= '0' && c <= '9' || c == '-' || c == '+' || c == '.' || c == 'e' || c == 'E'
}

fn parse_number(p: P) -> Result<Json, string> {
    let inicio: int = p.i;
    var seguir: bool = true;
    while (seguir) {
        if (at_end(p)) {
            seguir = false;
        } else if (is_num_char(cur(p))) {
            p.i = p.i + 1;
        } else {
            seguir = false;
        }
    }
    if (p.i == inicio) {
        return Result.Err("se esperaba un número");
    }
    let trozo: string = substring(p.s, inicio, p.i);
    match (parse_float(trozo)) {
        Option.Some(f) => Result.Ok(Json.JNum(f)),
        Option.None => Result.Err("número inválido: " + trozo),
    }
}

// El reemplazo de un escape `\<e>`, o None si no se soporta.
fn unescape(e: char) -> Option<string> {
    if (e == '"') { Option.Some("\"") } else if (e == '\\') { Option.Some("\\") } else if (e == '/') { Option.Some("/") } else if (e == 'n') { Option.Some("\n") } else if (e == 't') { Option.Some("\t") } else if (e == 'r') { Option.Some("\r") } else { Option.None }
}

// Lee un string entre comillas (el cursor está en la comilla de apertura). Devuelve el texto crudo.
fn parse_str_raw(p: P) -> Result<string, string> {
    p.i = p.i + 1;  // saltar la comilla de apertura
    var out: string = "";
    var seguir: bool = true;
    var err: string = "";
    while (seguir) {
        if (at_end(p)) {
            err = "string sin cerrar";
            seguir = false;
        } else {
            let c: char = cur(p);
            if (c == '"') {
                p.i = p.i + 1;
                seguir = false;
            } else if (c == '\\') {
                p.i = p.i + 1;
                if (at_end(p)) {
                    err = "escape sin cerrar";
                    seguir = false;
                } else {
                    match (unescape(cur(p))) {
                        Option.Some(rep) => {
                            out = out + rep;
                            p.i = p.i + 1;
                        },
                        Option.None => {
                            err = "secuencia de escape no soportada";
                            seguir = false;
                        },
                    }
                }
            } else {
                out = out + to_string(c);
                p.i = p.i + 1;
            }
        }
    }
    if (err == "") { Result.Ok(out) } else { Result.Err(err) }
}

fn parse_string_value(p: P) -> Result<Json, string> {
    match (parse_str_raw(p)) {
        Result.Ok(s) => Result.Ok(Json.JStr(s)),
        Result.Err(e) => Result.Err(e),
    }
}

fn parse_array(p: P) -> Result<Json, string> {
    p.i = p.i + 1;  // saltar '['
    var items: [Json] = [];
    skip_ws(p);
    if (!at_end(p) && cur(p) == ']') {
        p.i = p.i + 1;
        return Result.Ok(Json.JArray(items));
    }
    var seguir: bool = true;
    var err: string = "";
    while (seguir) {
        match (parse_value(p)) {
            Result.Ok(v) => {
                push(items, v);
            },
            Result.Err(e) => {
                err = e;
                seguir = false;
            },
        }
        if (seguir) {
            skip_ws(p);
            if (at_end(p)) {
                err = "arreglo sin cerrar";
                seguir = false;
            } else {
                let c: char = cur(p);
                if (c == ',') {
                    p.i = p.i + 1;
                } else if (c == ']') {
                    p.i = p.i + 1;
                    seguir = false;
                } else {
                    err = "se esperaba ',' o ']'";
                    seguir = false;
                }
            }
        }
    }
    if (err == "") { Result.Ok(Json.JArray(items)) } else { Result.Err(err) }
}

fn parse_object(p: P) -> Result<Json, string> {
    p.i = p.i + 1;  // saltar '{'
    var obj: Map<string, Json> = map_new();
    skip_ws(p);
    if (!at_end(p) && cur(p) == '}') {
        p.i = p.i + 1;
        return Result.Ok(Json.JObject(obj));
    }
    var seguir: bool = true;
    var err: string = "";
    while (seguir) {
        skip_ws(p);
        if (at_end(p) || cur(p) != '"') {
            err = "se esperaba una clave string";
            seguir = false;
        } else {
            match (parse_str_raw(p)) {
                Result.Ok(k) => {
                    skip_ws(p);
                    if (at_end(p) || cur(p) != ':') {
                        err = "se esperaba ':'";
                        seguir = false;
                    } else {
                        p.i = p.i + 1;  // saltar ':'
                        match (parse_value(p)) {
                            Result.Ok(v) => {
                                insert(obj, k, v);
                                skip_ws(p);
                                if (at_end(p)) {
                                    err = "objeto sin cerrar";
                                    seguir = false;
                                } else {
                                    let c: char = cur(p);
                                    if (c == ',') {
                                        p.i = p.i + 1;
                                    } else if (c == '}') {
                                        p.i = p.i + 1;
                                        seguir = false;
                                    } else {
                                        err = "se esperaba ',' o '}'";
                                        seguir = false;
                                    }
                                }
                            },
                            Result.Err(e) => {
                                err = e;
                                seguir = false;
                            },
                        }
                    }
                },
                Result.Err(e) => {
                    err = e;
                    seguir = false;
                },
            }
        }
    }
    if (err == "") { Result.Ok(Json.JObject(obj)) } else { Result.Err(err) }
}

// Punto de entrada: parsea un documento JSON completo (sin texto sobrante).
pub fn parse(s: string) -> Result<Json, string> {
    var p: P = P { s: s, i: 0, n: len(s) };
    match (parse_value(p)) {
        Result.Ok(j) => {
            skip_ws(p);
            if (at_end(p)) { Result.Ok(j) } else { Result.Err("texto sobrante tras el JSON") }
        },
        Result.Err(e) => Result.Err(e),
    }
}

// --- Serialización. Salida canónica: claves de objeto ordenadas. ---
// Escapa un string y lo envuelve en comillas para la salida JSON.
fn quote(s: string) -> string {
    var out: string = "\"";
    let cs: [char] = chars(s);
    var i: int = 0;
    while (i < len(cs)) {
        let c: char = cs[i];
        if (c == '"') {
            out = out + "\\\"";
        } else if (c == '\\') {
            out = out + "\\\\";
        } else if (c == '\n') {
            out = out + "\\n";
        } else if (c == '\t') {
            out = out + "\\t";
        } else if (c == '\r') {
            out = out + "\\r";
        } else {
            out = out + to_string(c);
        }
        i = i + 1;
    }
    out + "\""
}

fn stringify_array(items: [Json]) -> string {
    var out: string = "[";
    var i: int = 0;
    while (i < len(items)) {
        if (i > 0) {
            out = out + ",";
        }
        out = out + stringify(items[i]);
        i = i + 1;
    }
    out + "]"
}

fn stringify_object(obj: Map<string, Json>) -> string {
    var out: string = "{";
    let ks: [string] = keys(obj);
    var i: int = 0;
    while (i < len(ks)) {
        if (i > 0) {
            out = out + ",";
        }
        let k: string = ks[i];
        out = out + quote(k) + ":";
        match (get(obj, k)) {
            Option.Some(v) => {
                out = out + stringify(v);
            },
            Option.None => { },
        }
        i = i + 1;
    }
    out + "}"
}

pub fn stringify(j: Json) -> string {
    match (j) {
        Json.JNull => "null",
        Json.JBool(b) => if (b) { "true" } else { "false" },
        Json.JNum(f) => to_string(f),
        Json.JStr(s) => quote(s),
        Json.JArray(items) => stringify_array(items),
        Json.JObject(obj) => stringify_object(obj),
    }
}
