// M15.4a — una librería JSON escrita ENTERAMENTE en raylang.
//
// Demuestra el cambio de registro de M15: los protocolos no son builtins (Rust), se escriben en el
// propio lenguaje y se traen con `import`. parse/stringify sobre la stdlib (string, Map, Result);
// cero código de runtime. Los objetos usan Map<string, Json> → claves ordenadas al serializar
// (stringify canónico, round-trip estable). Errores como valores (Result), nunca panic.
//
// Los escapes \uXXXX se soportan (diferido JSON-1), incluidos los pares surrogate de los astrales
// (p. ej. "😀" → 😀), vía char_from_code (el inverso de char_code, del prelude). M59.1: los nueve
// escapes de la RFC 8259 §7 (" \ / b f n r t uXXXX) en el parse, y quote escapa TODO control
// < 0x20 en la salida (\b \f \n \r \t o \u00XX) — nunca emite JSON inválido.
// M59.5: los strings se construyen con StringBuilder + rachas (`substring`) en vez de `s = s + c`
// por carácter (cada `+` copia lo acumulado → O(n²); con payloads de cientos de KB muerde de verdad).
// M90.3: pretty-print (`stringify_pretty`) + helpers de acceso (`member`/`at`, `as_*`, `get_*`) —
// navegar un Json sin `match` anidado, con UFCS: `j.get_string("nombre")`.
import std/collections/stringbuilder as sb;

/// A JSON value: null, bool, number (float), string, array, or object (`Map<string, Json>`).
/// Objects use a Map, so keys come out sorted when serializing (canonical, stable round-trips).
pub enum Json {
    JNull,
    JBool(bool),
    JNum(float),
    JStr(string),
    JArray([Json]),
    JObject(Map<string, Json>),
}

// --- Parser de descenso recursivo. El estado (texto + cursor) se muta por referencia. ---
// M59.5 corría el cursor sobre `[char]` (indexar un string es por carácter, O(i)). M379 (rayplay
// #150): corre sobre `bytes` — `b[i]` es O(1) y un octeto — y los strings salen en RACHAS
// (`sub_bytes` + `from_utf8`), no carácter a carácter: con `[char]` un string de 32 MB costaba
// 1,7 GB (55× en nativo, 85× en la VM: un valor del arreglo por carácter y un string de un
// carácter por `push`). JSON es ASCII fuera de los strings, así que comparar octetos basta; el
// UTF-8 solo vive dentro de los strings y lo valida `from_utf8` al cortar cada racha.
struct P {
    b: bytes,
    i: int,
    n: int,
    // M218 (ray-sublime #5): modo relajado — comentarios `//` `/* */` y comas finales.
    relaxed: bool,
    // M291 (IDEAS §96 #4): niveles de arreglo/objeto abiertos. El parser es recursivo: sin tope, un
    // `[[[[…` de miles de niveles agota la pila — en la VM es un error de ejecución que mata el
    // programa; en el binario nativo, un desbordamiento de la pila de la fibra. Se rechaza como
    // VALOR (`Err`) al cruzar `max_depth()`, como hace `db/bson`.
    depth: int,
}

/// The maximum nesting of arrays/objects `parse` accepts (200, as `db/bson`); deeper input is an
/// `Err("nesting too deep …")`, never a stack overflow. (A function, not a `const`: the
/// self-hosted parser that mirrors this file does not support top-level constants yet.)
pub fn max_depth() -> int {
    200
}

fn at_end(p: P) -> bool { p.i >= p.n }

// El octeto bajo el cursor (JSON es ASCII fuera de los strings: 34 `"`, 92 `\`, 123 `{`, …).
fn cur(p: P) -> int { p.b[p.i] }

fn skip_ws(p: P) {
    var keep_going: bool = true;
    while (keep_going) {
        if (at_end(p)) {
            keep_going = false;
        } else {
            let c = cur(p);
            if (c == 32 || c == 10 || c == 9 || c == 13) {
                p.i = p.i + 1;
            } else if (p.relaxed && c == 47 && p.i + 1 < p.n && p.b[p.i + 1] == 47) {
                // M218: comentario de línea.
                while (!at_end(p) && cur(p) != 10) {
                    p.i = p.i + 1;
                }
            } else if (p.relaxed && c == 47 && p.i + 1 < p.n && p.b[p.i + 1] == 42) {
                // M218: comentario de bloque (sin cerrar → hasta el final; el parser fallará después).
                p.i = p.i + 2;
                while (!at_end(p) && !(cur(p) == 42 && p.i + 1 < p.n && p.b[p.i + 1] == 47)) {
                    p.i = p.i + 1;
                }
                if (!at_end(p)) {
                    p.i = p.i + 2;
                }
            } else {
                keep_going = false;
            }
        }
    }
}

// ¿El texto en el cursor empieza por `kw`? Si sí, avanza el cursor y devuelve true.
fn lit(p: P, kw: string) -> bool {
    let kb = kw.to_bytes();
    let m: int = kb.len();
    if (p.i + m > p.n) {
        return false;
    }
    var k = 0;
    while (k < m) {
        if (p.b[p.i + k] != kb[k]) {
            return false;
        }
        k = k + 1;
    }
    p.i = p.i + m;
    true
}

fn parse_value(p: P) -> Result<Json, string> {
    skip_ws(p);
    if (at_end(p)) {
        return Result.Err("unexpected end of input");
    }
    let c = cur(p);
    if (c == 123 || c == 91) {
        p.depth = p.depth + 1;
        if (p.depth > max_depth()) {
            return Result.Err(
                "nesting too deep (possible DoS): more than " + to_string(max_depth()) + " levels"
            );
        }
        let r = if (c == 123) { parse_object(p) } else { parse_array(p) };
        p.depth = p.depth - 1;
        r
    } else if (c == 34) {
        parse_string_value(p)
    } else if (c == 116 || c == 102) {
        parse_bool(p)
    } else if (c == 110) {
        if (lit(p, "null")) { Result.Ok(Json.JNull) } else { Result.Err("expected 'null'") }
    } else {
        parse_number(p)
    }
}

fn parse_bool(p: P) -> Result<Json, string> {
    if (lit(p, "true")) {
        Result.Ok(Json.JBool(true))
    } else if (lit(p, "false")) {
        Result.Ok(Json.JBool(false))
    } else {
        Result.Err("expected 'true' or 'false'")
    }
}

// Dígitos, `-`, `+`, `.`, `e`, `E`.
fn is_num_char(c: int) -> bool {
    c >= 48 && c <= 57 || c == 45 || c == 43 || c == 46 || c == 101 || c == 69
}

fn parse_number(p: P) -> Result<Json, string> {
    let start: int = p.i;
    var keep_going: bool = true;
    while (keep_going) {
        if (at_end(p)) {
            keep_going = false;
        } else if (is_num_char(cur(p))) {
            p.i = p.i + 1;
        } else {
            keep_going = false;
        }
    }
    if (p.i == start) {
        return Result.Err("expected a number");
    }
    // La racha es ASCII (solo caracteres numéricos): `from_utf8` no puede fallar.
    let text = from_utf8(p.b.sub_bytes(start, p.i)).unwrap_or("");
    match (parse_float(text)) {
        Option.Some(f) => Result.Ok(Json.JNum(f)),
        Option.None => Result.Err("invalid number: " + text),
    }
}

fn ctrl(n: int) -> string {
    match (char_from_code(n)) {
        Option.Some(c) => to_string(c),
        Option.None => "",
    }
}

// El reemplazo de un escape de un carácter (`\"` `\\` `\/` `\n` `\t` `\r` `\b` `\f`), por su octeto.
fn unescape(e: int) -> Option<string> {
    if (e == 34) {
        Option.Some("\"")
    } else if (e == 92) {
        Option.Some("\\")
    } else if (e == 47) {
        Option.Some("/")
    } else if (e == 110) {
        Option.Some("\n")
    } else if (e == 116) {
        Option.Some("\t")
    } else if (e == 114) {
        Option.Some("\r")
    } else if (e == 98) {
        Option.Some(ctrl(8))
    } else if (e == 102) {
        Option.Some(ctrl(12))
    } else {
        Option.None
    }
}

fn hex_val(code: int) -> int {
    if (code >= 48 && code <= 57) {
        code - 48
    } else if (code >= 97 && code <= 102) {
        code - 87
    } else if (code >= 65 && code <= 70) {
        code - 55
    } else {
        0 - 1
    }
}

fn hex4(p: P) -> Result<int, string> {
    var v = 0;
    var k = 0;
    while (k < 4) {
        if (at_end(p)) {
            return Result.Err("incomplete \\u escape");
        }
        let d = hex_val(cur(p));
        if (d < 0) {
            return Result.Err("non-hex digit in \\u escape");
        }
        v = v * 16 + d;
        p.i = p.i + 1;
        k = k + 1;
    }
    Result.Ok(v)
}

fn parse_u_escape(p: P) -> Result<string, string> {
    let hi = hex4(p)?;
    if (hi >= 56320 && hi <= 57343) {
        return Result.Err("lone surrogate in \\u escape");
    }
    var cp = hi;
    if (hi >= 55296 && hi <= 56319) {
        if (at_end(p) || cur(p) != 92) {
            return Result.Err("incomplete surrogate pair in \\u");
        }
        p.i = p.i + 1;
        if (at_end(p) || cur(p) != 117) {
            return Result.Err("incomplete surrogate pair in \\u");
        }
        p.i = p.i + 1;
        let lo = hex4(p)?;
        if (lo < 56320 || lo > 57343) {
            return Result.Err("invalid surrogate pair in \\u");
        }
        cp = 65536 + (hi - 55296) * 1024 + (lo - 56320);
    }
    return match (char_from_code(cp)) {
        Option.Some(c) => Result.Ok(to_string(c)),
        Option.None => Result.Err("invalid code point in \\u escape"),
    };
}

// Una racha de octetos del texto [from, to) como string: UNA copia y UNA validación UTF-8.
fn run(p: P, from: int, to: int) -> Result<string, string> {
    match (from_utf8(p.b.sub_bytes(from, to))) {
        Result.Ok(s) => Result.Ok(s),
        Result.Err(_) => Result.Err("invalid UTF-8 in string"),
    }
}

// Avanza `k` hasta la comilla de cierre o el primer escape (el fin de la racha actual).
fn run_end(p: P, start: int) -> int {
    var k = start;
    while (k < p.n && p.b[k] != 34 && p.b[k] != 92) {
        k = k + 1;
    }
    k
}

// El contenido de un string JSON (el cursor en la comilla de apertura; al salir, tras la de cierre).
fn parse_str_raw(p: P) -> Result<string, string> {
    p.i = p.i + 1;  // saltar la comilla de apertura
    // Camino rápido (el común, y el de un payload de MB): sin escapes → una sola racha.
    let j = run_end(p, p.i);
    if (j >= p.n) {
        return Result.Err("unterminated string");
    }
    if (p.b[j] == 34) {
        let r = run(p, p.i, j);
        p.i = j + 1;
        return r;
    }
    // Con escapes: rachas + reemplazos en un StringBuilder.
    let out = sb.new();
    var keep_going: bool = true;
    var err: string = "";
    while (keep_going) {
        let k = run_end(p, p.i);
        if (k > p.i) {
            match (run(p, p.i, k)) {
                Result.Ok(s) => {
                    sb.push(out, s);
                },
                Result.Err(e) => {
                    err = e;
                    keep_going = false;
                },
            }
            p.i = k;
        }
        if (keep_going) {
            if (at_end(p)) {
                err = "unterminated string";
                keep_going = false;
            } else if (cur(p) == 34) {
                p.i = p.i + 1;
                keep_going = false;
            } else {
                // `\`
                p.i = p.i + 1;
                if (at_end(p)) {
                    err = "unterminated escape";
                    keep_going = false;
                } else if (cur(p) == 117) {
                    // \uXXXX (con par surrogate si es un astral).
                    p.i = p.i + 1;
                    match (parse_u_escape(p)) {
                        Result.Ok(rep) => {
                            sb.push(out, rep);
                        },
                        Result.Err(m) => {
                            err = m;
                            keep_going = false;
                        },
                    }
                } else {
                    match (unescape(cur(p))) {
                        Option.Some(rep) => {
                            sb.push(out, rep);
                            p.i = p.i + 1;
                        },
                        Option.None => {
                            err = "unsupported escape sequence";
                            keep_going = false;
                        },
                    }
                }
            }
        }
    }
    if (err == "") { Result.Ok(sb.build(out)) } else { Result.Err(err) }
}

fn parse_string_value(p: P) -> Result<Json, string> {
    match (parse_str_raw(p)) {
        Result.Ok(s) => Result.Ok(Json.JStr(s)),
        Result.Err(e) => Result.Err(e),
    }
}

fn parse_array(p: P) -> Result<Json, string> {
    p.i = p.i + 1;  // saltar '['
    var items: [Json] = [];
    skip_ws(p);
    if (!at_end(p) && cur(p) == 93) {
        p.i = p.i + 1;
        return Result.Ok(Json.JArray(items));
    }
    var keep_going: bool = true;
    var err: string = "";
    while (keep_going) {
        match (parse_value(p)) {
            Result.Ok(v) => {
                items.push(v);
            },
            Result.Err(e) => {
                err = e;
                keep_going = false;
            },
        }
        if (keep_going) {
            skip_ws(p);
            if (at_end(p)) {
                err = "unterminated array";
                keep_going = false;
            } else {
                let c = cur(p);
                if (c == 44) {
                    p.i = p.i + 1;
                    if (p.relaxed) {
                        skip_ws(p);
                        if (!at_end(p) && cur(p) == 93) {
                            p.i = p.i + 1;
                            keep_going = false;
                        }
                    }
                } else if (c == 93) {
                    p.i = p.i + 1;
                    keep_going = false;
                } else {
                    err = "expected ',' or ']'";
                    keep_going = false;
                }
            }
        }
    }
    if (err == "") { Result.Ok(Json.JArray(items)) } else { Result.Err(err) }
}

fn parse_object(p: P) -> Result<Json, string> {
    p.i = p.i + 1;  // saltar '{'
    var obj: Map<string, Json> = Map.new();
    skip_ws(p);
    if (!at_end(p) && cur(p) == 125) {
        p.i = p.i + 1;
        return Result.Ok(Json.JObject(obj));
    }
    var keep_going: bool = true;
    var err: string = "";
    while (keep_going) {
        skip_ws(p);
        if (at_end(p) || cur(p) != 34) {
            err = "expected a string key";
            keep_going = false;
        } else {
            match (parse_str_raw(p)) {
                Result.Ok(k) => {
                    skip_ws(p);
                    if (at_end(p) || cur(p) != 58) {
                        err = "expected ':'";
                        keep_going = false;
                    } else {
                        p.i = p.i + 1;  // saltar ':'
                        match (parse_value(p)) {
                            Result.Ok(v) => {
                                obj.insert(k, v);
                                skip_ws(p);
                                if (at_end(p)) {
                                    err = "unterminated object";
                                    keep_going = false;
                                } else {
                                    let c = cur(p);
                                    if (c == 44) {
                                        p.i = p.i + 1;
                                        if (p.relaxed) {
                                            skip_ws(p);
                                            if (!at_end(p) && cur(p) == 125) {
                                                p.i = p.i + 1;
                                                keep_going = false;
                                            }
                                        }
                                    } else if (c == 125) {
                                        p.i = p.i + 1;
                                        keep_going = false;
                                    } else {
                                        err = "expected ',' or '}'";
                                        keep_going = false;
                                    }
                                }
                            },
                            Result.Err(e) => {
                                err = e;
                                keep_going = false;
                            },
                        }
                    }
                },
                Result.Err(e) => {
                    err = e;
                    keep_going = false;
                },
            }
        }
    }
    if (err == "") { Result.Ok(Json.JObject(obj)) } else { Result.Err(err) }
}

/// Parses a complete JSON document into a `Json` value. Returns `Err` with a message on
/// malformed input or trailing text after the value. `\uXXXX` escapes are supported, including
/// surrogate pairs for astral code points. Memory: a few × the input while parsing (the text as
/// bytes plus each string value copied once) — a string value of N MB costs ~N MB (M379).
pub fn parse(s: string) -> Result<Json, string> {
    parse_with(s, false)
}

/// Parses JSON with the relaxed dialect of `tsconfig.json`, `.vscode/*.json`, `.eslintrc` or
/// Sublime's `.sublime-settings`: `//` and `/* */` comments and trailing commas in arrays and
/// objects are accepted (M218). Everything else is strict JSON, as in `parse`.
pub fn parse_relaxed(s: string) -> Result<Json, string> {
    parse_with(s, true)
}

fn parse_with(s: string, relaxed: bool) -> Result<Json, string> {
    let b = s.to_bytes();
    var p: P = P { b: b, i: 0, n: b.len(), relaxed: relaxed, depth: 0 };
    match (parse_value(p)) {
        Result.Ok(j) => {
            skip_ws(p);
            if (at_end(p)) { Result.Ok(j) } else { Result.Err("trailing text after the JSON") }
        },
        Result.Err(e) => Result.Err(e),
    }
}

// --- Serialización. Salida canónica: claves de objeto ordenadas. ---
// El dígito hex (minúscula) de un valor 0..15 (para escapar controles como \u00XX).
fn hex_digit(v: int) -> string {
    "0123456789abcdef".substring(v, v + 1)
}

// ¿Debe escaparse `c` en la salida JSON? (comilla, barra o control < 0x20).
fn necesita_escape(c: char) -> bool {
    c == '"' || c == '\\' || char_code(c) < 32
}

// El escape JSON de un carácter que lo necesita: corto (\" \\ \n \t \r \b \f) o \u00XX.
fn escape_de(c: char) -> string {
    if (c == '"') {
        "\\\""
    } else if (c == '\\') {
        "\\\\"
    } else if (c == '\n') {
        "\\n"
    } else if (c == '\t') {
        "\\t"
    } else if (c == '\r') {
        "\\r"
    } else {
        let code = char_code(c);
        if (code == 8) {
            "\\b"
        } else if (code == 12) {
            "\\f"
        } else {
            "\\u00" + hex_digit(code / 16) + hex_digit(code % 16)
        }
    }
}

// Escapa un string y lo envuelve en comillas para la salida JSON. La RFC 8259 (§7) EXIGE
// escapar `"`, `\` y todo control < 0x20: los que tienen escape corto salen como \b \f \n
// \r \t; el resto de controles, como \u00XX (si no, la salida sería JSON inválido).
// M59.5: acumula en un StringBuilder (O(n); ver la nota de parse_str_raw sobre substring).
fn quote(s: string) -> string {
    let b = sb.new();
    sb.push(b, "\"");
    let cs: [char] = s.chars();
    let n = cs.len();
    var i: int = 0;
    while (i < n) {
        let c: char = cs[i];
        if (necesita_escape(c)) {
            sb.push(b, escape_de(c));
        } else {
            sb.push(b, to_string(c));
        }
        i = i + 1;
    }
    sb.push(b, "\"");
    sb.build(b)
}

fn stringify_array(items: [Json]) -> string {
    let b = sb.new();
    sb.push(b, "[");
    var i: int = 0;
    while (i < items.len()) {
        if (i > 0) {
            sb.push(b, ",");
        }
        sb.push(b, stringify(items[i]));
        i = i + 1;
    }
    sb.push(b, "]");
    sb.build(b)
}

fn stringify_object(obj: Map<string, Json>) -> string {
    let b = sb.new();
    sb.push(b, "{");
    let ks: [string] = obj.keys();
    var i: int = 0;
    while (i < ks.len()) {
        if (i > 0) {
            sb.push(b, ",");
        }
        let k: string = ks[i];
        sb.push(b, quote(k));
        sb.push(b, ":");
        match (get(obj, k)) {
            Option.Some(v) => {
                sb.push(b, stringify(v));
            },
            Option.None => { },
        }
        i = i + 1;
    }
    sb.push(b, "}");
    sb.build(b)
}

/// Serializes a `Json` value to compact JSON text (no whitespace).
/// Canonical output: object keys are emitted in sorted order.
pub fn stringify(j: Json) -> string {
    match (j) {
        Json.JNull => "null",
        Json.JBool(b) => if (b) { "true" } else { "false" },
        Json.JNum(f) => to_string(f),
        Json.JStr(s) => quote(s),
        Json.JArray(items) => stringify_array(items),
        Json.JObject(obj) => stringify_object(obj),
    }
}

// ── Helpers de acceso (M90.3) ────────────────────────────────────────────────────────
//
// Navegar un Json sin `match` anidado: `member`/`at` bajan un nivel (Option), los `as_*`
// extraen el payload si el valor es del tipo pedido, y los `get_*` combinan ambos para el
// caso común (campo tipado de un objeto). Componen con UFCS: `j.get_string("nombre")`.
/// The member `key` of a JSON object, or None (not an object / key absent).
pub fn member(j: Json, key: string) -> Option<Json> {
    match (j) {
        Json.JObject(obj) => get(obj, key),
        _ => Option.None,
    }
}

/// The element `i` of a JSON array, or None (not an array / index out of bounds).
pub fn at(j: Json, i: int) -> Option<Json> {
    match (j) {
        Json.JArray(items) => {
            if (i >= 0 && i < items.len()) { Option.Some(items[i]) } else { Option.None }
        },
        _ => Option.None,
    }
}

/// The string payload, or None if the value is not a JSON string.
pub fn as_string(j: Json) -> Option<string> {
    match (j) {
        Json.JStr(s) => Option.Some(s),
        _ => Option.None,
    }
}

/// The number payload, or None if the value is not a JSON number.
pub fn as_float(j: Json) -> Option<float> {
    match (j) {
        Json.JNum(f) => Option.Some(f),
        _ => Option.None,
    }
}

/// The number as an int, or None if the value is not a number, not integral (3.5 → None) or
/// beyond ±(2^53 − 1): a JSON number is a float, so a bigger integer (a 64-bit id) may already
/// be a different one after `parse` — read those with `raw_at`, which keeps the text.
pub fn as_int(j: Json) -> Option<int> {
    match (j) {
        // rayreq #257: por encima de 2^53 − 1 el float ya no distingue enteros consecutivos
        // (9007199254740993 se lee 9007199254740992): None antes que otro número.
        Json.JNum(f) => {
            if (f > 9007199254740991.0 || f < 0.0 - 9007199254740991.0) {
                Option.None
            } else {
                // Un float integral se muestra sin decimales ("3") → parse_int lo acepta; "3.5" no.
                parse_int(to_string(f))
            }
        },
        _ => Option.None,
    }
}

/// The bool payload, or None if the value is not a JSON bool.
pub fn as_bool(j: Json) -> Option<bool> {
    match (j) {
        Json.JBool(b) => Option.Some(b),
        _ => Option.None,
    }
}

/// The elements of a JSON array, or None if the value is not an array.
pub fn as_array(j: Json) -> Option<[Json]> {
    match (j) {
        Json.JArray(items) => Option.Some(items),
        _ => Option.None,
    }
}

/// The members of a JSON object, or None if the value is not an object.
pub fn as_object(j: Json) -> Option<Map<string, Json>> {
    match (j) {
        Json.JObject(obj) => Option.Some(obj),
        _ => Option.None,
    }
}

/// True if the value is JSON null.
pub fn is_null(j: Json) -> bool {
    match (j) {
        Json.JNull => true,
        _ => false,
    }
}

/// The member `key` as a string: `member` + `as_string`.
pub fn get_string(j: Json, key: string) -> Option<string> {
    match (member(j, key)) {
        Option.Some(v) => as_string(v),
        Option.None => Option.None,
    }
}

/// The member `key` as a float: `member` + `as_float`.
pub fn get_float(j: Json, key: string) -> Option<float> {
    match (member(j, key)) {
        Option.Some(v) => as_float(v),
        Option.None => Option.None,
    }
}

/// The member `key` as an int: `member` + `as_int`.
pub fn get_int(j: Json, key: string) -> Option<int> {
    match (member(j, key)) {
        Option.Some(v) => as_int(v),
        Option.None => Option.None,
    }
}

/// The member `key` as a bool: `member` + `as_bool`.
pub fn get_bool(j: Json, key: string) -> Option<bool> {
    match (member(j, key)) {
        Option.Some(v) => as_bool(v),
        Option.None => Option.None,
    }
}

/// The member `key` as an array: `member` + `as_array`.
pub fn get_array(j: Json, key: string) -> Option<[Json]> {
    match (member(j, key)) {
        Option.Some(v) => as_array(v),
        Option.None => Option.None,
    }
}

/// The member `key` as an object: `member` + `as_object`.
pub fn get_object(j: Json, key: string) -> Option<Map<string, Json>> {
    match (member(j, key)) {
        Option.Some(v) => as_object(v),
        Option.None => Option.None,
    }
}

// ── Pretty-print (M90.3) ─────────────────────────────────────────────────────────────
/// Serializes a `Json` value to indented multi-line JSON, `indent` spaces per level
/// (canonical sorted keys, like `stringify` — which remains the compact form).
pub fn stringify_pretty(j: Json, indent: int) -> string {
    let b = sb.new();
    pretty_into(b, j, indent, 0);
    sb.build(b)
}

// Emite `j` en el builder al nivel `depth`. Las hojas salen en su forma compacta; arreglos
// y objetos no vacíos abren bloque multilínea con una entrada por línea.
fn pretty_into(b: sb.StringBuilder, j: Json, indent: int, depth: int) {
    match (j) {
        Json.JArray(items) => {
            if (items.len() == 0) {
                sb.push(b, "[]");
            } else {
                sb.push(b, "[\n");
                var i: int = 0;
                while (i < items.len()) {
                    sb.push(b, " ".repeat(indent * (depth + 1)));
                    pretty_into(b, items[i], indent, depth + 1);
                    if (i + 1 < items.len()) {
                        sb.push(b, ",");
                    }
                    sb.push(b, "\n");
                    i = i + 1;
                }
                sb.push(b, " ".repeat(indent * depth));
                sb.push(b, "]");
            }
        },
        Json.JObject(obj) => {
            let ks: [string] = obj.keys();
            if (ks.len() == 0) {
                sb.push(b, "{}");
            } else {
                sb.push(b, "{\n");
                var i: int = 0;
                while (i < ks.len()) {
                    sb.push(b, " ".repeat(indent * (depth + 1)));
                    sb.push(b, quote(ks[i]));
                    sb.push(b, ": ");
                    match (get(obj, ks[i])) {
                        Option.Some(v) => {
                            pretty_into(b, v, indent, depth + 1);
                        },
                        Option.None => { },
                    }
                    if (i + 1 < ks.len()) {
                        sb.push(b, ",");
                    }
                    sb.push(b, "\n");
                    i = i + 1;
                }
                sb.push(b, " ".repeat(indent * depth));
                sb.push(b, "}");
            }
        },
        _ => {
            sb.push(b, stringify(j));
        },
    }
}

// --- ToJson (M93.4, subido desde web/framework): un valor que sabe su representación JSON ---
// El trait vive en la stdlib para que cualquier librería (y un futuro `@derive(ToJson)`) lo use
// sin depender de un paquete. Los impls de primitivos delegan en el serializador del módulo
// (comillas y escapes correctos para string).
/// A value that knows its JSON representation. Implement it for your own types (compose with
/// `stringify` for correct string escaping); the web framework responds with `r.json_of(v)`.
pub trait ToJson {
    /// The value serialized as a JSON document.
    fn to_json(self) -> string;
}

impl ToJson for int {
    fn to_json(self) -> string { to_string(self) }
}

impl ToJson for float {
    fn to_json(self) -> string { to_string(self) }
}

impl ToJson for bool {
    fn to_json(self) -> string { to_string(self) }
}

impl ToJson for string {
    fn to_json(self) -> string { stringify(Json.JStr(self)) }
}

// M304 (IDEAS §97 #24): un `Json` ya parseado o construido (`Json.JNull`, el resultado de
// `parse`) se incrusta tal cual en el builder: `json.obj().field("d", Json.JNull)`.
impl ToJson for Json {
    fn to_json(self) -> string { stringify(self) }
}

// --- Builders de objeto/arreglo (M93.5): JSON ad-hoc con escapado por construcción ---
// Para el JSON que no espeja un struct (claves calculadas, payloads compuestos):
//   obj().field("id", 7).field("name", name).render()
// Cada valor pasa por su `to_json()` (bound ToJson) → imposible olvidar el escapado. El orden de
// inserción se PRESERVA (a diferencia de JObject, cuyo Map ordena las claves). `Obj`/`Arr`
// implementan ToJson → los builders anidan y `r.json_of(o)` del framework los acepta.
/// A JSON object under construction: `obj().field("k", v)…` (insertion order preserved; values
/// go through their `to_json()` — escaping by construction). Render with `render`/`to_json`.
pub struct Obj {
    parts: [string],
}

/// A JSON array under construction: `arr().item(v)…` or `list(values)`.
pub struct Arr {
    items: [string],
}

/// Starts an empty JSON object.
pub fn obj() -> Obj {
    var ps: [string] = [];
    Obj { parts: ps }
}

/// Adds a field (any `ToJson` value: primitives, derived structs, nested `Obj`/`Arr`). Chainable.
pub fn field<T: ToJson>(o: Obj, key: string, v: T) -> Obj {
    o.parts.push(stringify(Json.JStr(key)) + ":" + v.to_json());
    o
}

/// The object as a JSON document, in the same compact form as `stringify` (`{"k":1,"a":[1,2]}`).
pub fn render(o: Obj) -> string {
    "{" + join(o.parts, ",") + "}"
}

/// Starts an empty JSON array.
pub fn arr() -> Arr {
    var vs: [string] = [];
    Arr { items: vs }
}

/// Appends one `ToJson` value. Chainable.
pub fn item<T: ToJson>(a: Arr, v: T) -> Arr {
    a.items.push(v.to_json());
    a
}

/// A JSON array from a whole `[T]` of `ToJson` values.
pub fn list<T: ToJson>(vs: [T]) -> Arr {
    var a = arr();
    var i = 0;
    while (i < vs.len()) {
        a = item(a, vs[i]);
        i = i + 1;
    }
    a
}

/// The array as a JSON document.
pub fn render_arr(a: Arr) -> string {
    "[" + join(a.items, ",") + "]"
}

// #122 (ray-ds): indentar RESPETANDO el orden del autor. `stringify_pretty` pasa por `Json`, cuyo
// objeto es un `Map` ordenado por clave; para un artefacto que se lee a mano (tokens, manifiestos)
// el orden de inserción del builder importa. Esto re-indenta el TEXTO compacto sin reordenar nada.
/// `render(o)` indented with `indent` spaces per level, keeping the insertion order of the keys
/// (`stringify_pretty` sorts them, since a parsed object is a `Map`).
pub fn render_pretty(o: Obj, indent: int) -> string {
    reindent(render(o), indent)
}

/// `render_arr(a)` indented with `indent` spaces per level, keeping the order of the items and of
/// the keys of any object inside.
pub fn render_arr_pretty(a: Arr, indent: int) -> string {
    reindent(render_arr(a), indent)
}

/// Re-indents compact JSON text (`render`, `stringify`, a file) with `indent` spaces per level
/// WITHOUT parsing it into a `Json`: objects keep the order of their keys and numbers keep their
/// text. Empty `{}`/`[]` stay on one line. `indent <= 0` compacts it instead (no whitespace at
/// all, like `compact`). The text must be valid JSON; strings are copied verbatim.
pub fn reindent(json: string, indent: int) -> string {
    if (indent <= 0) {
        return compact(json);
    }
    let b = sb.new();
    let cs = json.chars();
    var depth = 0;
    var i = 0;
    var in_str = false;
    var esc = false;
    while (i < cs.len()) {
        let c = cs[i];
        if (in_str) {
            sb.push(b, to_string(c));
            if (esc) {
                esc = false;
            } else if (c == '\\') {
                esc = true;
            } else if (c == '"') {
                in_str = false;
            }
        } else if (c == '"') {
            in_str = true;
            sb.push(b, "\"");
        } else if (c == '{' || c == '[') {
            let close = if (c == '{') { '}' } else { ']' };
            // `{}`/`[]` vacíos (saltando espacios) quedan en una línea.
            var k = i + 1;
            while (k < cs.len()
                && (cs[k] == ' ' || cs[k] == '\n' || cs[k] == '\t' || cs[k] == '\r')) {
                k = k + 1;
            }
            if (k < cs.len() && cs[k] == close) {
                sb.push(b, to_string(c));
                sb.push(b, to_string(close));
                i = k;
            } else {
                depth = depth + 1;
                sb.push(b, to_string(c));
                sb.push(b, "\n");
                sb.push(b, " ".repeat(indent * depth));
            }
        } else if (c == '}' || c == ']') {
            depth = depth - 1;
            sb.push(b, "\n");
            sb.push(b, " ".repeat(indent * depth));
            sb.push(b, to_string(c));
        } else if (c == ',') {
            sb.push(b, ",\n");
            sb.push(b, " ".repeat(indent * depth));
        } else if (c == ':') {
            sb.push(b, ": ");
        } else if (c == ' ' || c == '\n' || c == '\t' || c == '\r') {
            // el blanco del original no se conserva: lo pone la indentación
        } else {
            sb.push(b, to_string(c));
        }
        i = i + 1;
    }
    sb.build(b)
}

/// Compact JSON text: the same document without any whitespace outside strings, WITHOUT
/// parsing it (key order and the text of each number are kept). The text must be valid JSON.
pub fn compact(json: string) -> string {
    let b = sb.new();
    let cs = json.chars();
    var start = 0;
    var i = 0;
    var in_str = false;
    var esc = false;
    while (i < cs.len()) {
        let c = cs[i];
        if (in_str) {
            if (esc) {
                esc = false;
            } else if (c == '\\') {
                esc = true;
            } else if (c == '"') {
                in_str = false;
            }
        } else if (c == '"') {
            in_str = true;
        } else if (c == ' ' || c == '\n' || c == '\t' || c == '\r') {
            // rayreq #257: los tramos sin blanco se copian enteros (no carácter a carácter).
            sb.push(b, chars_to_string(cs, start, i));
            start = i + 1;
        }
        i = i + 1;
    }
    sb.push(b, chars_to_string(cs, start, cs.len()));
    sb.build(b)
}

// rayreq #257 — el TEXTO de un subvalor. Saltar blancos desde `i`.
fn raw_skip_ws(cs: [char], i: int) -> int {
    var k = i;
    while (k < cs.len() && (cs[k] == ' ' || cs[k] == '\n' || cs[k] == '\t' || cs[k] == '\r')) {
        k = k + 1;
    }
    k
}

// El fin (exclusivo) del string que abre en `i` (`cs[i] == '"'`), o -1 si no cierra.
fn raw_string_end(cs: [char], i: int) -> int {
    var k = i + 1;
    while (k < cs.len()) {
        if (cs[k] == '\\') {
            k = k + 2;
        } else if (cs[k] == '"') {
            return k + 1;
        } else {
            k = k + 1;
        }
    }
    0 - 1
}

// El fin (exclusivo) del valor que empieza en `i` (ya sin blancos delante), o -1 si no cierra.
fn raw_value_end(cs: [char], i: int) -> int {
    if (i >= cs.len()) {
        return 0 - 1;
    }
    let c = cs[i];
    if (c == '"') {
        return raw_string_end(cs, i);
    }
    if (c == '{' || c == '[') {
        var depth = 0;
        var k = i;
        while (k < cs.len()) {
            let d = cs[k];
            if (d == '"') {
                let e = raw_string_end(cs, k);
                if (e < 0) {
                    return 0 - 1;
                }
                k = e;
            } else {
                if (d == '{' || d == '[') {
                    depth = depth + 1;
                } else if (d == '}' || d == ']') {
                    depth = depth - 1;
                    if (depth == 0) {
                        return k + 1;
                    }
                }
                k = k + 1;
            }
        }
        return 0 - 1;
    }
    // número, true, false, null: hasta el siguiente separador.
    var k = i;
    while (k < cs.len()
        && cs[k] != ','
        && cs[k] != '}'
        && cs[k] != ']'
        && cs[k] != ' '
        && cs[k] != '\n'
        && cs[k] != '\t'
        && cs[k] != '\r') {
        k = k + 1;
    }
    if (k == i) { 0 - 1 } else { k }
}

// Un token de JSON Pointer: `~1` → `/`, `~0` → `~` (RFC 6901 §4).
fn pointer_token(t: string) -> string {
    t.replace("~1", "/").replace("~0", "~")
}

/// The TEXT of the value at the JSON Pointer `pointer` (RFC 6901: `""` is the whole document,
/// `"/data/0/id"` the member `id` of the first element of `data`), exactly as written in `json`
/// — a 64-bit id or a long decimal keeps every digit, which `parse` (numbers are floats) cannot
/// promise. None if the path does not exist or the text is not valid there. Strings come back
/// with their quotes; `parse` the result to read it as a `Json`.
pub fn raw_at(json: string, pointer: string) -> Option<string> {
    if (pointer != "" && !pointer.starts_with("/")) {
        return Option.None;
    }
    let cs = json.chars();
    var i = raw_skip_ws(cs, 0);
    let tokens: [string] = if (pointer == "") {
        []
    } else {
        pointer.substring(1, pointer.len()).split("/")
    };
    var t = 0;
    while (t < tokens.len()) {
        let token = pointer_token(tokens[t]);
        t = t + 1;
        if (i >= cs.len()) {
            return Option.None;
        }
        if (cs[i] == '{') {
            i = raw_skip_ws(cs, i + 1);
            var found = false;
            while (!found) {
                if (i >= cs.len() || cs[i] != '"') {
                    return Option.None;
                }
                let key_end = raw_string_end(cs, i);
                if (key_end < 0) {
                    return Option.None;
                }
                let key = match (parse(chars_to_string(cs, i, key_end))) {
                    Result.Ok(k) => as_string(k).unwrap_or(""),
                    Result.Err(_) => {
                        return Option.None;
                    },
                };
                i = raw_skip_ws(cs, key_end);
                if (i >= cs.len() || cs[i] != ':') {
                    return Option.None;
                }
                i = raw_skip_ws(cs, i + 1);
                if (key == token) {
                    found = true;
                } else {
                    let e = raw_value_end(cs, i);
                    if (e < 0) {
                        return Option.None;
                    }
                    i = raw_skip_ws(cs, e);
                    if (i < cs.len() && cs[i] == ',') {
                        i = raw_skip_ws(cs, i + 1);
                    } else {
                        return Option.None;
                    }
                }
            }
        } else if (cs[i] == '[') {
            let want = match (parse_int(token)) {
                Option.Some(n) => n,
                Option.None => {
                    return Option.None;
                },
            };
            if (want < 0 || token.starts_with("+") || token.len() > 1 && token.starts_with("0")) {
                return Option.None;
            }
            i = raw_skip_ws(cs, i + 1);
            var k = 0;
            while (k < want) {
                let e = raw_value_end(cs, i);
                if (e < 0) {
                    return Option.None;
                }
                i = raw_skip_ws(cs, e);
                if (i < cs.len() && cs[i] == ',') {
                    i = raw_skip_ws(cs, i + 1);
                } else {
                    return Option.None;
                }
                k = k + 1;
            }
            if (i < cs.len() && cs[i] == ']') {
                return Option.None;
            }
        } else {
            return Option.None;
        }
    }
    let e = raw_value_end(cs, i);
    if (e < 0) {
        return Option.None;
    }
    Option.Some(chars_to_string(cs, i, e))
}

impl ToJson for Obj {
    fn to_json(self) -> string { render(self) }
}

impl ToJson for Arr {
    fn to_json(self) -> string { render_arr(self) }
}

// M347 (rayauth R18): un arreglo de valores `ToJson` es `ToJson` — `json.obj().field("amr", ["pwd"])`
// sin envolverlo en `json.list(...)`.
impl<T: ToJson> ToJson for [T] {
    fn to_json(self) -> string { render_arr(list(self)) }
}
