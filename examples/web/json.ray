// M15.4a — una librería JSON escrita ENTERAMENTE en raylang.
//
// Demuestra el cambio de registro de M15: los protocolos no son builtins (Rust), se escriben en el
// propio lenguaje y se traen con `import`. parse/stringify sobre la stdlib (string, Map, Result);
// cero código de runtime. Los objetos usan Map<string, Json> → claves ordenadas al serializar
// (stringify canónico, round-trip estable). Errores como valores (Result), nunca panic.
//
// Los escapes \uXXXX se soportan (diferido JSON-1), incluidos los pares surrogate de los astrales
// (p. ej. "😀" → 😀), vía char_from_code (el inverso de char_code, del prelude). M59.1: los nueve
// escapes de la RFC 8259 §7 (" \ / b f n r t uXXXX) en el parse, y quote escapa TODO control
// < 0x20 en la salida (\b \f \n \r \t o \u00XX) — nunca emite JSON inválido.
// M59.5: los strings se construyen con StringBuilder + rachas (`substring`) en vez de `s = s + c`
// por carácter (cada `+` copia lo acumulado → O(n²); con payloads de cientos de KB muerde de verdad).
// M90.3: pretty-print (`stringify_pretty`) + helpers de acceso (`member`/`at`, `as_*`, `get_*`) —
// navegar un Json sin `match` anidado, con UFCS: `j.get_string("nombre")`.
import std/collections/stringbuilder as sb;

/// A JSON value: null, bool, number (float), string, array, or object (`Map<string, Json>`).
/// Objects use a Map, so keys come out sorted when serializing (canonical, stable round-trips).
pub enum Json {
    JNull,
    JBool(bool),
    JNum(float),
    JStr(string),
    JArray([Json]),
    JObject(Map<string, Json>),
}

// --- Parser de descenso recursivo. El estado (texto + cursor) se muta por referencia. ---
// M59.5: el cursor corre sobre `[char]`, NO sobre el string — indexar un string (`s[i]`) es por
// carácter sobre UTF-8 y escanea desde 0 (O(i)), así que `cur` por carácter hacía el parse O(n²).
struct P {
    cs: [char],
    i: int,
    n: int,
}

fn at_end(p: P) -> bool { p.i >= p.n }

fn cur(p: P) -> char { p.cs[p.i] }

fn skip_ws(p: P) {
    var seguir: bool = true;
    while (seguir) {
        if (at_end(p)) {
            seguir = false;
        } else {
            let c: char = cur(p);
            if (c == ' ' || c == '\n' || c == '\t' || c == '\r') {
                p.i = p.i + 1;
            } else {
                seguir = false;
            }
        }
    }
}

// ¿El texto en el cursor empieza por `kw`? Si sí, avanza el cursor y devuelve true.
fn lit(p: P, kw: string) -> bool {
    let ks = kw.chars();
    let m: int = ks.len();
    if (p.i + m > p.n) {
        return false;
    }
    var k = 0;
    while (k < m) {
        if (p.cs[p.i + k] != ks[k]) {
            return false;
        }
        k = k + 1;
    }
    p.i = p.i + m;
    true
}

fn parse_value(p: P) -> Result<Json, string> {
    skip_ws(p);
    if (at_end(p)) {
        return Result.Err("fin inesperado del texto");
    }
    let c: char = cur(p);
    if (c == '{') {
        parse_object(p)
    } else if (c == '[') {
        parse_array(p)
    } else if (c == '"') {
        parse_string_value(p)
    } else if (c == 't' || c == 'f') {
        parse_bool(p)
    } else if (c == 'n') {
        if (lit(p, "null")) { Result.Ok(Json.JNull) } else { Result.Err("se esperaba 'null'") }
    } else {
        parse_number(p)
    }
}

fn parse_bool(p: P) -> Result<Json, string> {
    if (lit(p, "true")) {
        Result.Ok(Json.JBool(true))
    } else if (lit(p, "false")) {
        Result.Ok(Json.JBool(false))
    } else {
        Result.Err("se esperaba 'true' o 'false'")
    }
}

fn is_num_char(c: char) -> bool {
    c >= '0' && c <= '9' || c == '-' || c == '+' || c == '.' || c == 'e' || c == 'E'
}

fn parse_number(p: P) -> Result<Json, string> {
    let inicio: int = p.i;
    var seguir: bool = true;
    while (seguir) {
        if (at_end(p)) {
            seguir = false;
        } else if (is_num_char(cur(p))) {
            p.i = p.i + 1;
        } else {
            seguir = false;
        }
    }
    if (p.i == inicio) {
        return Result.Err("se esperaba un número");
    }
    // El token es corto: reconstruirlo por carácter es O(largo del número).
    var trozo: string = "";
    var k = inicio;
    while (k < p.i) {
        trozo = trozo + to_string(p.cs[k]);
        k = k + 1;
    }
    match (parse_float(trozo)) {
        Option.Some(f) => Result.Ok(Json.JNum(f)),
        Option.None => Result.Err("número inválido: " + trozo),
    }
}

// El string de un code point (para los controles \b/\f, sin literal de escape en raylang).
fn ctrl(n: int) -> string {
    match (char_from_code(n)) {
        Option.Some(c) => to_string(c),
        Option.None => "",
    }
}

// El reemplazo de un escape `\<e>`, o None si no se soporta. Cubre los OCHO escapes de un
// carácter de la RFC 8259 (§7): " \ / b f n r t (el noveno, \uXXXX, va en parse_u_escape).
fn unescape(e: char) -> Option<string> {
    if (e == '"') { Option.Some("\"") } else if (e == '\\') { Option.Some("\\") } else if (e == '/') { Option.Some("/") } else if (e == 'n') { Option.Some("\n") } else if (e == 't') { Option.Some("\t") } else if (e == 'r') { Option.Some("\r") } else if (e == 'b') { Option.Some(ctrl(8)) } else if (e == 'f') { Option.Some(ctrl(12)) } else { Option.None }
}

// El valor de un dígito hex (mayúsculas o minúsculas); -1 si no lo es.
fn hex_val(c: char) -> int {
    let code = char_code(c);
    if (code >= 48 && code <= 57) {
        code - 48
    } else if (code >= 97 && code <= 102) {
        code - 87
    } else if (code >= 65 && code <= 70) {
        code - 55
    } else {
        0 - 1
    }
}

// Lee exactamente 4 dígitos hex en el cursor (la unidad de un \uXXXX).
fn hex4(p: P) -> Result<int, string> {
    var v = 0;
    var k = 0;
    while (k < 4) {
        if (at_end(p)) {
            return Result.Err("escape \\u incompleto");
        }
        let d = hex_val(cur(p));
        if (d < 0) {
            return Result.Err("escape \\u con dígito no hexadecimal");
        }
        v = v * 16 + d;
        p.i = p.i + 1;
        k = k + 1;
    }
    Result.Ok(v)
}

// Un escape \uXXXX (el cursor está tras la 'u'). Una unidad BMP va directa; un high surrogate
// (D800–DBFF) exige el low surrogate (\uDC00–DFFF) a continuación → code point astral.
fn parse_u_escape(p: P) -> Result<string, string> {
    let hi = hex4(p)?;
    if (hi >= 56320 && hi <= 57343) {
        // 0xDC00–0xDFFF: un low surrogate suelto no es un code point.
        return Result.Err("escape \\u con surrogate suelto");
    }
    var cp = hi;
    if (hi >= 55296 && hi <= 56319) {
        // 0xD800–0xDBFF: par surrogate — debe venir \uDC00–DFFF.
        if (at_end(p) || cur(p) != '\\') {
            return Result.Err("par surrogate incompleto en \\u");
        }
        p.i = p.i + 1;
        if (at_end(p) || cur(p) != 'u') {
            return Result.Err("par surrogate incompleto en \\u");
        }
        p.i = p.i + 1;
        let lo = hex4(p)?;
        if (lo < 56320 || lo > 57343) {
            return Result.Err("par surrogate inválido en \\u");
        }
        cp = 65536 + (hi - 55296) * 1024 + (lo - 56320);
    }
    return match (char_from_code(cp)) {
        Option.Some(c) => Result.Ok(to_string(c)),
        Option.None => Result.Err("escape \\u con code point inválido"),
    };
}

// Lee un string entre comillas (el cursor está en la comilla de apertura). Devuelve el texto crudo.
// M59.5: acumula en un StringBuilder (push O(1) amortizado + join final) — O(n). Ojo: NO se copia
// por rachas con `substring(i, j)`: substring indexa por CARÁCTER sobre UTF-8 y escanea desde 0,
// así que con posiciones grandes vuelve a ser cuadrático (medido: peor que el `+` original).
fn parse_str_raw(p: P) -> Result<string, string> {
    p.i = p.i + 1;  // saltar la comilla de apertura
    let b = sb.new();
    var seguir: bool = true;
    var err: string = "";
    while (seguir) {
        if (at_end(p)) {
            err = "string sin cerrar";
            seguir = false;
        } else {
            let c: char = cur(p);
            if (c == '"') {
                p.i = p.i + 1;
                seguir = false;
            } else if (c == '\\') {
                p.i = p.i + 1;
                if (at_end(p)) {
                    err = "escape sin cerrar";
                    seguir = false;
                } else if (cur(p) == 'u') {
                    // \uXXXX (con par surrogate si es un astral).
                    p.i = p.i + 1;
                    match (parse_u_escape(p)) {
                        Result.Ok(rep) => {
                            sb.push(b, rep);
                        },
                        Result.Err(m) => {
                            err = m;
                            seguir = false;
                        },
                    }
                } else {
                    match (unescape(cur(p))) {
                        Option.Some(rep) => {
                            sb.push(b, rep);
                            p.i = p.i + 1;
                        },
                        Option.None => {
                            err = "secuencia de escape no soportada";
                            seguir = false;
                        },
                    }
                }
            } else {
                sb.push(b, to_string(c));
                p.i = p.i + 1;
            }
        }
    }
    if (err == "") { Result.Ok(sb.build(b)) } else { Result.Err(err) }
}

fn parse_string_value(p: P) -> Result<Json, string> {
    match (parse_str_raw(p)) {
        Result.Ok(s) => Result.Ok(Json.JStr(s)),
        Result.Err(e) => Result.Err(e),
    }
}

fn parse_array(p: P) -> Result<Json, string> {
    p.i = p.i + 1;  // saltar '['
    var items: [Json] = [];
    skip_ws(p);
    if (!at_end(p) && cur(p) == ']') {
        p.i = p.i + 1;
        return Result.Ok(Json.JArray(items));
    }
    var seguir: bool = true;
    var err: string = "";
    while (seguir) {
        match (parse_value(p)) {
            Result.Ok(v) => {
                items.push(v);
            },
            Result.Err(e) => {
                err = e;
                seguir = false;
            },
        }
        if (seguir) {
            skip_ws(p);
            if (at_end(p)) {
                err = "arreglo sin cerrar";
                seguir = false;
            } else {
                let c: char = cur(p);
                if (c == ',') {
                    p.i = p.i + 1;
                } else if (c == ']') {
                    p.i = p.i + 1;
                    seguir = false;
                } else {
                    err = "se esperaba ',' o ']'";
                    seguir = false;
                }
            }
        }
    }
    if (err == "") { Result.Ok(Json.JArray(items)) } else { Result.Err(err) }
}

fn parse_object(p: P) -> Result<Json, string> {
    p.i = p.i + 1;  // saltar '{'
    var obj: Map<string, Json> = Map.new();
    skip_ws(p);
    if (!at_end(p) && cur(p) == '}') {
        p.i = p.i + 1;
        return Result.Ok(Json.JObject(obj));
    }
    var seguir: bool = true;
    var err: string = "";
    while (seguir) {
        skip_ws(p);
        if (at_end(p) || cur(p) != '"') {
            err = "se esperaba una clave string";
            seguir = false;
        } else {
            match (parse_str_raw(p)) {
                Result.Ok(k) => {
                    skip_ws(p);
                    if (at_end(p) || cur(p) != ':') {
                        err = "se esperaba ':'";
                        seguir = false;
                    } else {
                        p.i = p.i + 1;  // saltar ':'
                        match (parse_value(p)) {
                            Result.Ok(v) => {
                                obj.insert(k, v);
                                skip_ws(p);
                                if (at_end(p)) {
                                    err = "objeto sin cerrar";
                                    seguir = false;
                                } else {
                                    let c: char = cur(p);
                                    if (c == ',') {
                                        p.i = p.i + 1;
                                    } else if (c == '}') {
                                        p.i = p.i + 1;
                                        seguir = false;
                                    } else {
                                        err = "se esperaba ',' o '}'";
                                        seguir = false;
                                    }
                                }
                            },
                            Result.Err(e) => {
                                err = e;
                                seguir = false;
                            },
                        }
                    }
                },
                Result.Err(e) => {
                    err = e;
                    seguir = false;
                },
            }
        }
    }
    if (err == "") { Result.Ok(Json.JObject(obj)) } else { Result.Err(err) }
}

// Punto de entrada: parsea un documento JSON completo (sin texto sobrante).
/// Parses a complete JSON document into a `Json` value. Returns `Err` with a message on
/// malformed input or trailing text after the value. `\uXXXX` escapes are supported, including
/// surrogate pairs for astral code points.
pub fn parse(s: string) -> Result<Json, string> {
    let cs = s.chars();
    var p: P = P { cs: cs, i: 0, n: cs.len() };
    match (parse_value(p)) {
        Result.Ok(j) => {
            skip_ws(p);
            if (at_end(p)) { Result.Ok(j) } else { Result.Err("texto sobrante tras el JSON") }
        },
        Result.Err(e) => Result.Err(e),
    }
}

// --- Serialización. Salida canónica: claves de objeto ordenadas. ---
// El dígito hex (minúscula) de un valor 0..15 (para escapar controles como \u00XX).
fn hex_digit(v: int) -> string {
    "0123456789abcdef".substring(v, v + 1)
}

// ¿Debe escaparse `c` en la salida JSON? (comilla, barra o control < 0x20).
fn necesita_escape(c: char) -> bool {
    c == '"' || c == '\\' || char_code(c) < 32
}

// El escape JSON de un carácter que lo necesita: corto (\" \\ \n \t \r \b \f) o \u00XX.
fn escape_de(c: char) -> string {
    if (c == '"') {
        "\\\""
    } else if (c == '\\') {
        "\\\\"
    } else if (c == '\n') {
        "\\n"
    } else if (c == '\t') {
        "\\t"
    } else if (c == '\r') {
        "\\r"
    } else {
        let code = char_code(c);
        if (code == 8) {
            "\\b"
        } else if (code == 12) {
            "\\f"
        } else {
            "\\u00" + hex_digit(code / 16) + hex_digit(code % 16)
        }
    }
}

// Escapa un string y lo envuelve en comillas para la salida JSON. La RFC 8259 (§7) EXIGE
// escapar `"`, `\` y todo control < 0x20: los que tienen escape corto salen como \b \f \n
// \r \t; el resto de controles, como \u00XX (si no, la salida sería JSON inválido).
// M59.5: acumula en un StringBuilder (O(n); ver la nota de parse_str_raw sobre substring).
fn quote(s: string) -> string {
    let b = sb.new();
    sb.push(b, "\"");
    let cs: [char] = s.chars();
    let n = cs.len();
    var i: int = 0;
    while (i < n) {
        let c: char = cs[i];
        if (necesita_escape(c)) {
            sb.push(b, escape_de(c));
        } else {
            sb.push(b, to_string(c));
        }
        i = i + 1;
    }
    sb.push(b, "\"");
    sb.build(b)
}

fn stringify_array(items: [Json]) -> string {
    let b = sb.new();
    sb.push(b, "[");
    var i: int = 0;
    while (i < items.len()) {
        if (i > 0) {
            sb.push(b, ",");
        }
        sb.push(b, stringify(items[i]));
        i = i + 1;
    }
    sb.push(b, "]");
    sb.build(b)
}

fn stringify_object(obj: Map<string, Json>) -> string {
    let b = sb.new();
    sb.push(b, "{");
    let ks: [string] = obj.keys();
    var i: int = 0;
    while (i < ks.len()) {
        if (i > 0) {
            sb.push(b, ",");
        }
        let k: string = ks[i];
        sb.push(b, quote(k));
        sb.push(b, ":");
        match (get(obj, k)) {
            Option.Some(v) => {
                sb.push(b, stringify(v));
            },
            Option.None => { },
        }
        i = i + 1;
    }
    sb.push(b, "}");
    sb.build(b)
}

/// Serializes a `Json` value to compact JSON text (no whitespace).
/// Canonical output: object keys are emitted in sorted order.
pub fn stringify(j: Json) -> string {
    match (j) {
        Json.JNull => "null",
        Json.JBool(b) => if (b) { "true" } else { "false" },
        Json.JNum(f) => to_string(f),
        Json.JStr(s) => quote(s),
        Json.JArray(items) => stringify_array(items),
        Json.JObject(obj) => stringify_object(obj),
    }
}

// ── Helpers de acceso (M90.3) ────────────────────────────────────────────────────────
//
// Navegar un Json sin `match` anidado: `member`/`at` bajan un nivel (Option), los `as_*`
// extraen el payload si el valor es del tipo pedido, y los `get_*` combinan ambos para el
// caso común (campo tipado de un objeto). Componen con UFCS: `j.get_string("nombre")`.

/// The member `key` of a JSON object, or None (not an object / key absent).
pub fn member(j: Json, key: string) -> Option<Json> {
    match (j) {
        Json.JObject(obj) => get(obj, key),
        _ => Option.None,
    }
}

/// The element `i` of a JSON array, or None (not an array / index out of bounds).
pub fn at(j: Json, i: int) -> Option<Json> {
    match (j) {
        Json.JArray(items) => {
            if (i >= 0 && i < items.len()) { Option.Some(items[i]) } else { Option.None }
        },
        _ => Option.None,
    }
}

/// The string payload, or None if the value is not a JSON string.
pub fn as_string(j: Json) -> Option<string> {
    match (j) {
        Json.JStr(s) => Option.Some(s),
        _ => Option.None,
    }
}

/// The number payload, or None if the value is not a JSON number.
pub fn as_float(j: Json) -> Option<float> {
    match (j) {
        Json.JNum(f) => Option.Some(f),
        _ => Option.None,
    }
}

/// The number as an int, or None if the value is not a number or not integral (3.5 → None).
pub fn as_int(j: Json) -> Option<int> {
    match (j) {
        // Un float integral se muestra sin decimales ("3") → parse_int lo acepta; "3.5" no.
        Json.JNum(f) => parse_int(to_string(f)),
        _ => Option.None,
    }
}

/// The bool payload, or None if the value is not a JSON bool.
pub fn as_bool(j: Json) -> Option<bool> {
    match (j) {
        Json.JBool(b) => Option.Some(b),
        _ => Option.None,
    }
}

/// The elements of a JSON array, or None if the value is not an array.
pub fn as_array(j: Json) -> Option<[Json]> {
    match (j) {
        Json.JArray(items) => Option.Some(items),
        _ => Option.None,
    }
}

/// The members of a JSON object, or None if the value is not an object.
pub fn as_object(j: Json) -> Option<Map<string, Json>> {
    match (j) {
        Json.JObject(obj) => Option.Some(obj),
        _ => Option.None,
    }
}

/// True if the value is JSON null.
pub fn is_null(j: Json) -> bool {
    match (j) {
        Json.JNull => true,
        _ => false,
    }
}

/// The member `key` as a string: `member` + `as_string`.
pub fn get_string(j: Json, key: string) -> Option<string> {
    match (member(j, key)) {
        Option.Some(v) => as_string(v),
        Option.None => Option.None,
    }
}

/// The member `key` as a float: `member` + `as_float`.
pub fn get_float(j: Json, key: string) -> Option<float> {
    match (member(j, key)) {
        Option.Some(v) => as_float(v),
        Option.None => Option.None,
    }
}

/// The member `key` as an int: `member` + `as_int`.
pub fn get_int(j: Json, key: string) -> Option<int> {
    match (member(j, key)) {
        Option.Some(v) => as_int(v),
        Option.None => Option.None,
    }
}

/// The member `key` as a bool: `member` + `as_bool`.
pub fn get_bool(j: Json, key: string) -> Option<bool> {
    match (member(j, key)) {
        Option.Some(v) => as_bool(v),
        Option.None => Option.None,
    }
}

/// The member `key` as an array: `member` + `as_array`.
pub fn get_array(j: Json, key: string) -> Option<[Json]> {
    match (member(j, key)) {
        Option.Some(v) => as_array(v),
        Option.None => Option.None,
    }
}

/// The member `key` as an object: `member` + `as_object`.
pub fn get_object(j: Json, key: string) -> Option<Map<string, Json>> {
    match (member(j, key)) {
        Option.Some(v) => as_object(v),
        Option.None => Option.None,
    }
}

// ── Pretty-print (M90.3) ─────────────────────────────────────────────────────────────

/// Serializes a `Json` value to indented multi-line JSON, `indent` spaces per level
/// (canonical sorted keys, like `stringify` — which remains the compact form).
pub fn stringify_pretty(j: Json, indent: int) -> string {
    let b = sb.new();
    pretty_into(b, j, indent, 0);
    sb.build(b)
}

// Emite `j` en el builder al nivel `depth`. Las hojas salen en su forma compacta; arreglos
// y objetos no vacíos abren bloque multilínea con una entrada por línea.
fn pretty_into(b: sb.StringBuilder, j: Json, indent: int, depth: int) {
    match (j) {
        Json.JArray(items) => {
            if (items.len() == 0) {
                sb.push(b, "[]");
            } else {
                sb.push(b, "[\n");
                var i: int = 0;
                while (i < items.len()) {
                    sb.push(b, " ".repeat(indent * (depth + 1)));
                    pretty_into(b, items[i], indent, depth + 1);
                    if (i + 1 < items.len()) {
                        sb.push(b, ",");
                    }
                    sb.push(b, "\n");
                    i = i + 1;
                }
                sb.push(b, " ".repeat(indent * depth));
                sb.push(b, "]");
            }
        },
        Json.JObject(obj) => {
            let ks: [string] = obj.keys();
            if (ks.len() == 0) {
                sb.push(b, "{}");
            } else {
                sb.push(b, "{\n");
                var i: int = 0;
                while (i < ks.len()) {
                    sb.push(b, " ".repeat(indent * (depth + 1)));
                    sb.push(b, quote(ks[i]));
                    sb.push(b, ": ");
                    match (get(obj, ks[i])) {
                        Option.Some(v) => {
                            pretty_into(b, v, indent, depth + 1);
                        },
                        Option.None => { },
                    }
                    if (i + 1 < ks.len()) {
                        sb.push(b, ",");
                    }
                    sb.push(b, "\n");
                    i = i + 1;
                }
                sb.push(b, " ".repeat(indent * depth));
                sb.push(b, "}");
            }
        },
        _ => {
            sb.push(b, stringify(j));
        },
    }
}
