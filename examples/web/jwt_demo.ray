// Demo/verificación de JWT (HS256) y UUID v4 (M20.3). Lo ejecuta `tests/jwt_cli.rs`. La salida es
// determinista (el JWT con un secreto fijo es reproducible; el UUID se prueba por su FORMA, no su valor).
from jwt import jwt_sign, jwt_verify;
from uuid import uuid_v4, is_uuid_v4, uuid_v7, uuid_v7_at, is_uuid_v7;

fn main() {
    let secreto = "super-secreto-de-pruebas".to_bytes();
    let claims = "{\"sub\":\"1234567890\",\"name\":\"Ada\",\"admin\":true}";

    // Firma: el JWT compacto h.p.s. Reproducible con el mismo secreto y claims (verificable con jwt.io).
    let token = jwt_sign(secreto, claims);
    print(token);

    // Verificación con el secreto correcto → Ok(payload_json).
    match (jwt_verify(secreto, token)) {
        Result.Ok(payload) => print(payload),  // == claims
        Result.Err(e) => print("ERR: " + e),
    }

    // Verificación con un secreto incorrecto → Err("firma inválida").
    match (jwt_verify("otro-secreto".to_bytes(), token)) {
        Result.Ok(_) => print("ERR: debería fallar"),
        Result.Err(e) => print(e),  // firma inválida
    }

    // Token manipulado (se altera el último carácter de la firma) → Err.
    let manipulado = token.substring(0, token.len() - 1) + manipular(token);
    match (jwt_verify(secreto, manipulado)) {
        Result.Ok(_) => print("ERR: tamper no detectado"),
        Result.Err(_) => print("tamper detectado"),
    }

    // Token mal formado (sin los 3 segmentos) → Err.
    match (jwt_verify(secreto, "no.es")) {
        Result.Ok(_) => print("ERR"),
        Result.Err(_) => print("mal formado detectado"),
    }

    // UUID v4: dos generados son válidos por su forma y distintos entre sí.
    let u1 = uuid_v4();
    let u2 = uuid_v4();
    print(is_uuid_v4(u1) && is_uuid_v4(u2));  // true
    print(u1 != u2);  // true (colisión astronómicamente improbable)

    // UUID v7 (M57.3): válido por su forma, y ORDENABLE por tiempo — el prefijo son los 48 bits
    // del timestamp en ms, big-endian (vector de la RFC 9562: 2022-02-22T19:22:22Z = 0x017F22E279B0).
    let s1 = uuid_v7();
    print(is_uuid_v7(s1));  // true
    print(uuid_v7_at(1645557742000).starts_with("017f22e2-79b0-7"));  // true (prefijo del vector RFC)
    print(uuid_v7_at(1645557742000) < uuid_v7_at(1645557742001));  // true (orden lexicográfico = temporal)
}

// Devuelve un carácter distinto al último de `token` (para invertir la firma sin adivinar hex).
fn manipular(token: string) -> string {
    let ultimo = token[token.len() - 1];
    if (ultimo == 'A') { "B" } else { "A" }
}
