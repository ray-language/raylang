// Métricas estilo Prometheus, escritas EN raylang. Cero runtime nuevo. Un registro de counters, gauges
// e histogramas que se renderiza al **formato de exposición de texto** de Prometheus (`# HELP`/`# TYPE`
// + series), listo para servir en `/metrics` (con `webserver.ray`). Importable:
//   from metrics import registry, register_counter, register_gauge, register_histogram,
//                       inc, add, set, observe, render, no_labels, labels1, labels2;
//
// Modelo simple con arreglos paralelos + búsqueda lineal (suficiente para unos pocos cientos de series).
// Counters/gauges admiten labels; los histogramas (por simplicidad) son sin labels. El orden de salida
// es determinista (métricas en orden de registro; series en orden de creación; labels ordenados).
pub struct Registry {
    names: [string],
    helps: [string],
    kinds: [int],
    bucketses: [[float]],
    s_metric: [int],
    s_text: [string],
    s_val: [float],
}

// métricas registradas, en orden
// 0=counter, 1=gauge, 2=histogram
// límites de bucket (solo histogramas; [] para los demás)
// serie → índice de su métrica
// prefijo de la línea: "nombre{labels}" / "nombre_bucket{le=...}" / "_sum" / "_count"
// valor de la serie
pub fn registry() -> Registry {
    Registry { names: [], helps: [], kinds: [], bucketses: [], s_metric: [], s_text: [], s_val: [] }
}

fn no_buckets() -> [float] {
    var e: [float] = [];
    e
}

// --- Helpers de labels ---
pub fn no_labels() -> Map<string, string> {
    Map.new()
}

pub fn labels1(k: string, v: string) -> Map<string, string> {
    var m: Map<string, string> = Map.new();
    m.insert(k, v);
    m
}

pub fn labels2(k1: string, v1: string, k2: string, v2: string) -> Map<string, string> {
    var m: Map<string, string> = Map.new();
    m.insert(k1, v1);
    m.insert(k2, v2);
    m
}

// M70: escapa el texto de `# HELP` (el formato de exposición exige `\\` y `\n`; un help con
// salto de línea rompía el scrape entero).
fn help_escape(s: string) -> string {
    var out = "";
    var i = 0;
    while (i < s.len()) {
        let c = s[i];
        if (c == '\\') {
            out = out + "\\\\";
        } else if (c == '\n') {
            out = out + "\\n";
        } else {
            out = out + to_string(c);
        }
        i = i + 1;
    }
    out
}

// Escapa un valor de label (Prometheus: barra, comilla, salto de línea).
fn label_escape(s: string) -> string {
    var out = "";
    var i = 0;
    while (i < s.len()) {
        let c = s[i];
        if (c == '\\') {
            out = out + "\\\\";
        } else {
            if (c == '"') {
                out = out + "\\\"";
            } else {
                if (c == '\n') {
                    out = out + "\\n";
                } else {
                    out = out + to_string(c);
                }
            }
        }
        i = i + 1;
    }
    out
}

// Renderiza un conjunto de labels como `{k="v",...}` (claves ordenadas) o "" si está vacío.
fn render_labels(labels: Map<string, string>) -> string {
    let ks = labels.keys();
    if (ks.len() == 0) {
        return "";
    }
    var out = "{";
    var i = 0;
    while (i < ks.len()) {
        if (i > 0) {
            out = out + ",";
        }
        let k = ks[i];
        let v = match (get(labels, k)) {
            Option.Some(x) => x,
            Option.None => "",
        };
        out = out + k + "=\"" + label_escape(v) + "\"";
        i = i + 1;
    }
    out + "}"
}

// --- Registro de métricas ---
fn add_metric(reg: Registry, name: string, help: string, kind: int, buckets: [float]) -> int {
    reg.names.push(name);
    reg.helps.push(help);
    reg.kinds.push(kind);
    reg.bucketses.push(buckets);
    reg.names.len() - 1
}

pub fn register_counter(reg: Registry, name: string, help: string) {
    add_metric(reg, name, help, 0, no_buckets());
}

pub fn register_gauge(reg: Registry, name: string, help: string) {
    add_metric(reg, name, help, 1, no_buckets());
}

fn fmt_float(v: float) -> string {
    to_string(v)
}

// Crea una serie (valor 0) y devuelve su índice.
fn create_series(reg: Registry, mi: int, text: string) -> int {
    reg.s_metric.push(mi);
    reg.s_text.push(text);
    reg.s_val.push(0.0);
    reg.s_metric.len() - 1
}

pub fn register_histogram(reg: Registry, name: string, help: string, buckets: [float]) {
    // Las series NO se crean aquí: el conjunto de labels no se conoce al registrar. Se crean en orden
    // canónico la primera vez que se observa cada conjunto de labels (`ensure_hist_series`).
    add_metric(reg, name, help, 2, buckets);
}

// --- Búsqueda ---
fn find_metric(reg: Registry, name: string) -> int {
    var i = 0;
    while (i < reg.names.len()) {
        if (reg.names[i] == name) {
            return i;
        }
        i = i + 1;
    }
    0 - 1
}

// Índice de la serie con ese texto dentro de la métrica `mi`, o -1 si no existe.
fn find_series(reg: Registry, mi: int, text: string) -> int {
    var i = 0;
    while (i < reg.s_text.len()) {
        if (reg.s_metric[i] == mi && reg.s_text[i] == text) {
            return i;
        }
        i = i + 1;
    }
    0 - 1
}

// Como `find_series` pero creando la serie (valor 0) si no existe.
fn touch_series(reg: Registry, mi: int, text: string) -> int {
    let idx = find_series(reg, mi, text);
    if (idx >= 0) {
        idx
    } else {
        create_series(reg, mi, text)
    }
}

// Copia un conjunto de labels añadiéndole `le` (para las series _bucket de un histograma).
fn with_le(labels: Map<string, string>, le: string) -> Map<string, string> {
    var m: Map<string, string> = Map.new();
    let ks = labels.keys();
    var i = 0;
    while (i < ks.len()) {
        match (get(labels, ks[i])) {
            Option.Some(v) => {
                m.insert(ks[i], v);
            },
            Option.None => { },
        }
        i = i + 1;
    }
    m.insert("le", le);
    m
}

// Crea, en orden canónico (buckets ascendentes, +Inf, _sum, _count), la familia de series de un
// histograma para un conjunto de labels dado — solo la primera vez (idempotente).
fn ensure_hist_series(reg: Registry, mi: int, name: string, buckets: [float], labels: Map<string, string>) {
    if (find_series(reg, mi, name + "_count" + render_labels(labels)) >= 0) {
        return;
    }
    var i = 0;
    while (i < buckets.len()) {
        create_series(reg, mi, name + "_bucket" + render_labels(with_le(labels, fmt_float(buckets[i]))));
        i = i + 1;
    }
    create_series(reg, mi, name + "_bucket" + render_labels(with_le(labels, "+Inf")));
    create_series(reg, mi, name + "_sum" + render_labels(labels));
    create_series(reg, mi, name + "_count" + render_labels(labels));
}

// --- Operaciones ---
pub fn add(reg: Registry, name: string, labels: Map<string, string>, v: float) {
    let mi = find_metric(reg, name);
    if (mi < 0) {
        panic("unregistered metric: " + name);
    }
    // M70: el tipo debe cuadrar — antes `add` sobre un histograma creaba una serie espuria
    // (`nombre{}` mezclada con `nombre_bucket{…}`) que corrompía la exposición en silencio.
    if (reg.kinds[mi] == 2) {
        panic("'" + name + "' es un histogram; usa observe_l/observe");
    }
    let si = touch_series(reg, mi, name + render_labels(labels));
    reg.s_val[si] = reg.s_val[si] + v;
}

pub fn inc(reg: Registry, name: string, labels: Map<string, string>) {
    add(reg, name, labels, 1.0);
}

pub fn set(reg: Registry, name: string, labels: Map<string, string>, v: float) {
    let mi = find_metric(reg, name);
    if (mi < 0) {
        panic("unregistered metric: " + name);
    }
    // M70: `set` es de gauges — sobre un counter viola la monotonía; sobre un histograma
    // crearía una serie espuria.
    if (reg.kinds[mi] != 1) {
        panic("'" + name + "' no es un gauge; set solo aplica a gauges");
    }
    let si = touch_series(reg, mi, name + render_labels(labels));
    reg.s_val[si] = v;
}

// Observa un valor en un histograma con un conjunto de labels: incrementa los buckets cuyo `le` ≥ v,
// el bucket +Inf y _count, y suma a _sum. Las series del conjunto de labels se crean en orden canónico
// la primera vez (`ensure_hist_series`). Los buckets llevan los labels + `le`; _sum/_count solo los labels.
pub fn observe_l(reg: Registry, name: string, labels: Map<string, string>, v: float) {
    let mi = find_metric(reg, name);
    if (mi < 0) {
        panic("unregistered histogram: " + name);
    }
    // M70: observar un counter/gauge crearía series _bucket espurias.
    if (reg.kinds[mi] != 2) {
        panic("'" + name + "' no es un histogram; usa inc/add/set");
    }
    let bks = reg.bucketses[mi];
    ensure_hist_series(reg, mi, name, bks, labels);
    var i = 0;
    while (i < bks.len()) {
        if (v <= bks[i]) {
            let si = touch_series(reg, mi, name + "_bucket" + render_labels(with_le(labels, fmt_float(bks[i]))));
            reg.s_val[si] = reg.s_val[si] + 1.0;
        }
        i = i + 1;
    }
    let inf = touch_series(reg, mi, name + "_bucket" + render_labels(with_le(labels, "+Inf")));
    reg.s_val[inf] = reg.s_val[inf] + 1.0;
    let ss = touch_series(reg, mi, name + "_sum" + render_labels(labels));
    reg.s_val[ss] = reg.s_val[ss] + v;
    let sc = touch_series(reg, mi, name + "_count" + render_labels(labels));
    reg.s_val[sc] = reg.s_val[sc] + 1.0;
}

// Observa un valor en un histograma sin labels (azúcar de `observe_l` con el conjunto vacío).
pub fn observe(reg: Registry, name: string, v: float) {
    observe_l(reg, name, no_labels(), v);
}

fn kind_name(k: int) -> string {
    if (k == 0) { "counter" } else {
        if (k == 1) { "gauge" } else { "histogram" }
    }
}

// Renderiza todo el registro al formato de exposición de Prometheus.
pub fn render(reg: Registry) -> string {
    var out = "";
    var mi = 0;
    while (mi < reg.names.len()) {
        out = out + "# HELP " + reg.names[mi] + " " + help_escape(reg.helps[mi]) + "\n";
        out = out + "# TYPE " + reg.names[mi] + " " + kind_name(reg.kinds[mi]) + "\n";
        var si = 0;
        while (si < reg.s_metric.len()) {
            if (reg.s_metric[si] == mi) {
                out = out + reg.s_text[si] + " " + fmt_float(reg.s_val[si]) + "\n";
            }
            si = si + 1;
        }
        mi = mi + 1;
    }
    out
}
