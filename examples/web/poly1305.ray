// Poly1305 (RFC 8439 §2.5) — el autenticador (MAC) de una sola vez que acompaña a ChaCha20.
//
// Aritmética modular de 130 bits (mod 2^130 − 5). Port de `poly1305-donna` (variante de 32 bits):
// el acumulador y la clave `r` se guardan en **5 limbs de 26 bits**, y los productos se acumulan en
// **u64** (52..55 bits) → otro showcase de los enteros con tamaño (M28.3): antes esto exigiría emular
// los 64 bits a mano; ahora `u64` lo hace nativo (mismo `u64` de Rust en ambos motores → oráculo).
//
// Entrada: clave de 32 octetos (`r` clampeada ‖ `s`) y el mensaje. Salida: tag de 16 octetos.
// Importable: `from poly1305 import poly1305_mac;`.
// Lee 4 octetos de `b` desde `i` como palabra de 32 bits (en un u64) little-endian.
fn le32(b: [int], i: int) -> u64 {
    b[i] as u64 | b[i + 1] as u64 << 8 | b[i + 2] as u64 << 16 | b[i + 3] as u64 << 24
}

// Añade los 4 octetos little-endian de la palabra de 32 bits `w` al final de `out`.
fn push_le32(out: [int], w: u64) {
    out.push((w & 255) as int);
    out.push((w >> 8 & 255) as int);
    out.push((w >> 16 & 255) as int);
    out.push((w >> 24 & 255) as int);
}

pub fn poly1305_mac(key: [int], msg: [int]) -> [int] {
    // `r` clampeada, leída directamente en 5 limbs de 26 bits (las máscaras embeben el clamping).
    let r0 = le32(key, 0) & 67108863;  // & 0x3ffffff
    let r1 = le32(key, 3) >> 2 & 67108611;  // & 0x3ffff03
    let r2 = le32(key, 6) >> 4 & 67092735;  // & 0x3ffc0ff
    let r3 = le32(key, 9) >> 6 & 66076671;  // & 0x3f03fff
    let r4 = le32(key, 12) >> 8 & 1048575;  // & 0x00fffff
    // s_i = r_i * 5 (aparece al reducir mod 2^130−5).
    let s1 = r1 * 5;
    let s2 = r2 * 5;
    let s3 = r3 * 5;
    let s4 = r4 * 5;

    // Acumulador h en 5 limbs.
    var h0: u64 = 0;
    var h1: u64 = 0;
    var h2: u64 = 0;
    var h3: u64 = 0;
    var h4: u64 = 0;

    let n = msg.len();
    var i = 0;
    while (i < n) {
        // Bloque de 16 octetos (el último se rellena con un 0x01 tras el mensaje).
        var blk: [int] = [];
        var j = 0;
        while (j < 16) {
            if (i + j < n) {
                blk.push(msg[i + j]);
            } else {
                blk.push(0);
            }
            j = j + 1;
        }
        var hibit: u64 = 16777216;  // 1<<24: el bit alto implícito de un bloque completo
        if (i + 16 > n) {
            blk[n - i] = 1;  // bloque parcial: el 0x01 va tras el mensaje
            hibit = 0;
        }

        // Suma el bloque (como número de 130 bits) al acumulador.
        let t0 = le32(blk, 0);
        let t1 = le32(blk, 4);
        let t2 = le32(blk, 8);
        let t3 = le32(blk, 12);
        h0 = h0 + (t0 & 67108863);
        h1 = h1 + ((t0 >> 26 | t1 << 6) & 67108863);
        h2 = h2 + ((t1 >> 20 | t2 << 12) & 67108863);
        h3 = h3 + ((t2 >> 14 | t3 << 18) & 67108863);
        h4 = h4 + (t3 >> 8 | hibit);

        // h = (h * r) mod (2^130 − 5). Los productos caben en u64.
        let d0 = h0 * r0 + h1 * s4 + h2 * s3 + h3 * s2 + h4 * s1;
        let d1 = h0 * r1 + h1 * r0 + h2 * s4 + h3 * s3 + h4 * s2;
        let d2 = h0 * r2 + h1 * r1 + h2 * r0 + h3 * s4 + h4 * s3;
        let d3 = h0 * r3 + h1 * r2 + h2 * r1 + h3 * r0 + h4 * s4;
        let d4 = h0 * r4 + h1 * r3 + h2 * r2 + h3 * r1 + h4 * r0;

        // Propaga los acarreos entre limbs.
        var c = d0 >> 26;
        h0 = d0 & 67108863;
        let e1 = d1 + c;
        c = e1 >> 26;
        h1 = e1 & 67108863;
        let e2 = d2 + c;
        c = e2 >> 26;
        h2 = e2 & 67108863;
        let e3 = d3 + c;
        c = e3 >> 26;
        h3 = e3 & 67108863;
        let e4 = d4 + c;
        c = e4 >> 26;
        h4 = e4 & 67108863;
        h0 = h0 + c * 5;
        c = h0 >> 26;
        h0 = h0 & 67108863;
        h1 = h1 + c;

        i = i + 16;
    }

    // Acarreo final completo.
    var c = h1 >> 26;
    h1 = h1 & 67108863;
    h2 = h2 + c;
    c = h2 >> 26;
    h2 = h2 & 67108863;
    h3 = h3 + c;
    c = h3 >> 26;
    h3 = h3 & 67108863;
    h4 = h4 + c;
    c = h4 >> 26;
    h4 = h4 & 67108863;
    h0 = h0 + c * 5;
    c = h0 >> 26;
    h0 = h0 & 67108863;
    h1 = h1 + c;

    // g = h − p (con p = 2^130−5): se calcula h + (−p) y se mira el préstamo.
    var g0 = h0 + 5;
    c = g0 >> 26;
    g0 = g0 & 67108863;
    var g1 = h1 + c;
    c = g1 >> 26;
    g1 = g1 & 67108863;
    var g2 = h2 + c;
    c = g2 >> 26;
    g2 = g2 & 67108863;
    var g3 = h3 + c;
    c = g3 >> 26;
    g3 = g3 & 67108863;
    var g4 = h4 + c - 67108864;  // − (1<<26): si hay préstamo, el bit 63 queda a 1

    // Selección en tiempo constante: si h < p, mask = 0 (elige h); si no, mask = todo-unos (elige g).
    var mask = (g4 >> 63) - 1;
    g0 = g0 & mask;
    g1 = g1 & mask;
    g2 = g2 & mask;
    g3 = g3 & mask;
    g4 = g4 & mask;
    let nmask = ~mask;
    h0 = h0 & nmask | g0;
    h1 = h1 & nmask | g1;
    h2 = h2 & nmask | g2;
    h3 = h3 & nmask | g3;
    h4 = h4 & nmask | g4;

    // h mod 2^128, recompuesto en 4 palabras de 32 bits.
    h0 = (h0 | h1 << 26) & 4294967295;
    h1 = (h1 >> 6 | h2 << 20) & 4294967295;
    h2 = (h2 >> 12 | h3 << 14) & 4294967295;
    h3 = (h3 >> 18 | h4 << 8) & 4294967295;

    // tag = (h + s) mod 2^128.
    let p0 = le32(key, 16);
    let p1 = le32(key, 20);
    let p2 = le32(key, 24);
    let p3 = le32(key, 28);
    var f = h0 + p0;
    h0 = f & 4294967295;
    f = h1 + p1 + (f >> 32);
    h1 = f & 4294967295;
    f = h2 + p2 + (f >> 32);
    h2 = f & 4294967295;
    f = h3 + p3 + (f >> 32);
    h3 = f & 4294967295;

    var out: [int] = [];
    push_le32(out, h0);
    push_le32(out, h1);
    push_le32(out, h2);
    push_le32(out, h3);
    out
}
