// Protocol Buffers (proto3) — códec del formato wire + framing de gRPC, escrito EN raylang. Cero
// runtime nuevo. Es el corazón de la carga útil de gRPC (los mensajes van como protobuf). Importable:
//   from protobuf import writer, write_varint, write_string, write_bytes, finish,
//                        parse, PbField, get_int, get_string, grpc_frame, grpc_unframe;
//
// El formato wire es schema-LESS: cada campo es un *tag* (varint = `número<<3 | wire_type`) seguido del
// valor. Wire types: 0 varint (LEB128: int/bool/enum), 1 fixed64 (8 octetos LE), 2 length-delimited
// (string/bytes/submensaje: varint de longitud + octetos), 5 fixed32 (4 octetos LE). Sin schema, el
// decodificador devuelve los campos crudos (número + valor) y el llamador los interpreta.
//
// Cubre proto3: varints con signo (un negativo son 10 octetos, el int64 en complemento a dos),
// `sint` (zigzag), float/double, campos repetidos empaquetados y submensajes (raygrpc #389).
import std/math;

// --- Codificación (constructor de mensaje) ---
/// A protobuf message builder: accumulates wire-format bytes as fields are written.
/// Create with `writer()`, add fields with `write_*`, and get the bytes with `finish`.
pub struct PbWriter {
    out: [int],
}

/// Creates an empty `PbWriter` to start building a protobuf message.
pub fn writer() -> PbWriter {
    PbWriter { out: [] }
}

// Codifica un varint (LEB128): 7 bits por octeto, bit alto = continuación. Un negativo es su
// int64 en complemento a dos: 10 octetos (nueve de 7 bits y el bit 63), como manda el formato
// para `int32`/`int64` (raygrpc #389; antes era un panic que mandaba a `write_fixed64`, que es
// OTRO tipo wire y el receptor lo descarta como campo desconocido).
fn encode_varint(out: [int], value: int) {
    if (value < 0) {
        var k = 0;
        while (k < 9) {
            out.push(value >> k * 7 & 127 | 128);
            k = k + 1;
        }
        out.push(1);
        return;
    }
    var v = value;
    while (v >= 128) {
        out.push(v & 127 | 128);
        v = v >> 7;
    }
    out.push(v & 127);
}

fn write_tag(out: [int], field: int, wire: int) {
    encode_varint(out, field << 3 | wire);
}

fn append_bytes(out: [int], b: bytes) {
    var i = 0;
    while (i < b.len()) {
        out.push(b[i]);
        i = i + 1;
    }
}

// Campo varint (wire 0): int32/int64/uint/bool/enum.
/// Writes a varint field (wire type 0, LEB128): int32/int64/uint32/uint64/bool/enum. A
/// negative value takes 10 bytes (the two's complement of the int64), as the format defines
/// for `int32`/`int64`; a field declared `sint32`/`sint64` uses `write_sint` instead.
pub fn write_varint(w: PbWriter, field: int, value: int) {
    write_tag(w.out, field, 0);
    encode_varint(w.out, value);
}

/// The zigzag encoding of a signed integer (`sint32`/`sint64`): 0, -1, 1, -2… → 0, 1, 2, 3…,
/// so that small negative numbers stay short as varints.
pub fn zigzag(n: int) -> int {
    if (n < 0) { (0 - 1 - n) << 1 | 1 } else { n << 1 }
}

/// The inverse of `zigzag`: the signed value of a decoded `sint32`/`sint64` varint.
pub fn unzigzag(n: int) -> int {
    let half = n >> 1 & 0x7FFFFFFFFFFFFFFF;
    if ((n & 1) == 1) { 0 - 1 - half } else { half }
}

/// Writes a `sint32`/`sint64` field: the zigzag of `value` as a varint. Read it back with
/// `unzigzag(get_int(fields, number))`.
pub fn write_sint(w: PbWriter, field: int, value: int) {
    write_varint(w, field, zigzag(value));
}

/// Writes a `float` field (wire type 5): `value` rounded to single precision, 4 bytes.
pub fn write_float(w: PbWriter, field: int, value: float) {
    write_fixed32(w, field, math.float32_bits(value));
}

/// Writes a `double` field (wire type 1): the 8 bytes of `value`.
pub fn write_double(w: PbWriter, field: int, value: float) {
    write_fixed64(w, field, math.float_bits(value));
}

/// Writes a packed repeated field of varints (wire type 2: the values back to back), the
/// default encoding of `repeated int32/int64/bool/enum` in proto3. For `sint`, pass the
/// `zigzag` of each value. Read it back with `read_packed_varints(get_bytes(fields, number))`.
pub fn write_packed_varints(w: PbWriter, field: int, values: [int]) {
    var body: [int] = [];
    for v in values {
        encode_varint(body, v);
    }
    write_tag(w.out, field, 2);
    encode_varint(w.out, body.len());
    for octet in body {
        w.out.push(octet);
    }
}

/// Embeds the message built in `inner` as a nested message field (wire type 2). Read it back
/// with `get_message(fields, number)`.
pub fn write_message(w: PbWriter, field: int, inner: PbWriter) {
    write_tag(w.out, field, 2);
    encode_varint(w.out, inner.out.len());
    for octet in inner.out {
        w.out.push(octet);
    }
}

/// A bare varint (no tag): the length prefix of a delimited stream, or one element of a
/// hand-built packed field.
pub fn varint(value: int) -> bytes {
    var out: [int] = [];
    encode_varint(out, value);
    bytes_of(out)
}

// Campo length-delimited (wire 2) a partir de un string (UTF-8).
/// Writes a length-delimited field (wire type 2) from a string, encoded as UTF-8 bytes.
pub fn write_string(w: PbWriter, field: int, s: string) {
    write_tag(w.out, field, 2);
    let b = s.to_bytes();
    encode_varint(w.out, b.len());
    append_bytes(w.out, b);
}

// Campo length-delimited (wire 2) a partir de bytes crudos (o un submensaje ya serializado).
/// Writes a length-delimited field (wire type 2) from raw bytes — also how a
/// nested message (already serialized) is embedded.
pub fn write_bytes(w: PbWriter, field: int, b: bytes) {
    write_tag(w.out, field, 2);
    encode_varint(w.out, b.len());
    append_bytes(w.out, b);
}

// Campo fixed64 (wire 1): 8 octetos little-endian.
/// Writes a fixed64 field (wire type 1): 8 little-endian bytes.
pub fn write_fixed64(w: PbWriter, field: int, value: int) {
    write_tag(w.out, field, 1);
    var k = 0;
    while (k < 8) {
        w.out.push(value >> k * 8 & 255);
        k = k + 1;
    }
}

// Campo fixed32 (wire 5): 4 octetos little-endian.
/// Writes a fixed32 field (wire type 5): 4 little-endian bytes.
pub fn write_fixed32(w: PbWriter, field: int, value: int) {
    write_tag(w.out, field, 5);
    var k = 0;
    while (k < 4) {
        w.out.push(value >> k * 8 & 255);
        k = k + 1;
    }
}

// El mensaje serializado.
/// Returns the serialized protobuf message accumulated in the writer.
pub fn finish(w: PbWriter) -> bytes {
    bytes_of(w.out)
}

// --- Decodificación ---
// Un campo decodificado: número, wire type, y el valor (entero para varint/fixed; bytes para len-delim).
/// A decoded protobuf field: field number, wire type, and the raw value —
/// `int_val` for varint (wire 0), fixed64 (wire 1) and fixed32 (wire 5: the 32 bits, never
/// negative), `bytes_val` for length-delimited (wire 2). The wire format is schema-less, so
/// interpreting the value is up to the caller: `wire` tells a fixed32 from a fixed64.
/// `show()` gives `#3 varint 150`, `#2 bytes(4)`, `#5 fixed32 1`.
pub struct PbField {
    number: int,
    wire: int,
    int_val: int,
    bytes_val: bytes,
}

impl Show for PbField {
    fn show(self) -> string {
        if (self.wire == 2) {
            "#${self.number} bytes(${self.bytes_val.len()})"
        } else if (self.wire == 0) {
            "#${self.number} varint ${self.int_val}"
        } else if (self.wire == 1) {
            "#${self.number} fixed64 ${self.int_val}"
        } else {
            "#${self.number} fixed32 ${self.int_val}"
        }
    }
}

struct VarintResult {
    value: int,
    next: int,
}

// Decodifica un varint desde `pos`; devuelve el valor y la posición siguiente. `next` vale -1 si
// el varint se corta antes de su último octeto, -2 si pasa de 10 octetos y -3 si el décimo trae
// bits que no caben en 64 (solo puede valer 0 o 1; #463): `parse` es total y esto viene de la
// red (#388).
fn decode_varint(data: bytes, pos: int) -> VarintResult {
    var result = 0;
    var shift = 0;
    var p = pos;
    let n = data.len();
    while (p < n) {
        if (shift > 63) {
            return VarintResult { value: 0, next: -2 };
        }
        let b = data[p];
        if (shift == 63 && (b & 128) == 0 && b > 1) {
            return VarintResult { value: 0, next: -3 };
        }
        result = result | (b & 127) << shift;
        p = p + 1;
        if ((b & 128) == 0) {
            return VarintResult { value: result, next: p };
        }
        shift = shift + 7;
    }
    VarintResult { value: 0, next: -1 }
}

fn varint_error(what: string, v: VarintResult, pos: int) -> string {
    if (v.next == -2) {
        "protobuf: the varint of the ${what} at byte ${pos} is longer than 10 bytes"
    } else if (v.next == -3) {
        "protobuf: the varint of the ${what} at byte ${pos} does not fit in 64 bits"
    } else {
        "protobuf: truncated varint of the ${what} at byte ${pos}"
    }
}

// Lee `nbytes` octetos little-endian como entero desde `pos`.
fn read_le(data: bytes, pos: int, nbytes: int) -> int {
    var v = 0;
    var k = 0;
    while (k < nbytes) {
        v = v | data[pos + k] << k * 8;
        k = k + 1;
    }
    v
}

/// Reads a bare varint at `pos`: `Ok((value, next))` with the position after it, or `Err` when
/// it is cut short, longer than 10 bytes or does not fit in 64 bits. The cursor of a hand-written reader: a delimited
/// stream, a packed field.
pub fn read_varint(data: bytes, pos: int) -> Result<(int, int), string> {
    let v = decode_varint(data, pos);
    if (v.next < 0) {
        return Result.Err(varint_error("value", v, pos));
    }
    Result.Ok((v.value, v.next))
}

/// The values of a packed repeated field of varints (the `bytes` of a wire type 2 field).
/// `Err` when the last varint is cut short. For `sint`, `unzigzag` each value.
pub fn read_packed_varints(body: bytes) -> Result<[int], string> {
    var out: [int] = [];
    var pos = 0;
    while (pos < body.len()) {
        let v = read_varint(body, pos)?;
        out.push(v.0);
        pos = v.1;
    }
    Result.Ok(out)
}

// Parsea un mensaje protobuf a una lista de campos crudos (sin schema).
/// Parses a protobuf message into its raw fields (schema-less: number + wire type + value).
/// Supports wire types 0 (varint), 1 (fixed64), 2 (length-delimited), and 5 (fixed32).
/// Total: malformed input is always an `Err` that names the byte — a truncated or over-long
/// varint, one whose tenth byte overflows 64 bits, a value that runs past the end of the data, field number 0, or any other wire type.
pub fn parse(data: bytes) -> Result<[PbField], string> {
    var fields: [PbField] = [];
    var pos = 0;
    let n = data.len();
    while (pos < n) {
        let at = pos;
        let tag = decode_varint(data, pos);
        if (tag.next < 0) {
            return Result.Err(varint_error("tag", tag, at));
        }
        pos = tag.next;
        let number = tag.value >> 3;
        let wire = tag.value & 7;
        if (number <= 0) {
            return Result.Err("protobuf: invalid field number ${number} at byte ${at}");
        }
        if (wire == 0) {
            let v = decode_varint(data, pos);
            if (v.next < 0) {
                return Result.Err(varint_error("value of field ${number}", v, pos));
            }
            pos = v.next;
            fields.push(PbField { number: number, wire: 0, int_val: v.value, bytes_val: b"" });
        } else if (wire == 2) {
            let lenv = decode_varint(data, pos);
            if (lenv.next < 0) {
                return Result.Err(varint_error("length of field ${number}", lenv, pos));
            }
            pos = lenv.next;
            if (lenv.value < 0 || lenv.value > n - pos) {
                return Result.Err(
                    "protobuf: field ${number} at byte ${at} announces ${lenv.value} bytes and ${n - pos} remain"
                );
            }
            let b = data.sub_bytes(pos, pos + lenv.value);
            pos = pos + lenv.value;
            fields.push(PbField { number: number, wire: 2, int_val: 0, bytes_val: b });
        } else if (wire == 1 || wire == 5) {
            let width = if (wire == 1) { 8 } else { 4 };
            if (width > n - pos) {
                return Result.Err(
                    "protobuf: truncated fixed${width * 8} of field ${number} at byte ${pos}"
                );
            }
            fields.push(
                PbField {
                    number: number,
                    wire: wire,
                    int_val: read_le(data, pos, width),
                    bytes_val: b""
                }
            );
            pos = pos + width;
        } else {
            return Result.Err(
                "protobuf: unsupported wire type ${wire} of field ${number} at byte ${at}"
            );
        }
    }
    Result.Ok(fields)
}

// --- Accesores por número de campo (primer campo que coincide) ---
/// Returns the integer value of the first field with the given number, or 0 if absent
/// (proto3 default).
pub fn get_int(fields: [PbField], number: int) -> int {
    var i = 0;
    while (i < fields.len()) {
        if (fields[i].number == number) {
            return fields[i].int_val;
        }
        i = i + 1;
    }
    0
}

/// The value of the first `float` (wire type 5) or `double` (wire type 1) field with the given
/// number, or 0.0 if absent: the fixed bits read as IEEE 754, by the wire type of the field.
pub fn get_float(fields: [PbField], number: int) -> float {
    for f in fields {
        if (f.number == number) {
            return if (f.wire == 5) {
                math.float32_from_bits(f.int_val)
            } else {
                math.float_from_bits(f.int_val)
            };
        }
    }
    0.0
}

/// Every field with the given number, in order: the occurrences of a `repeated` field that is
/// not packed (strings, bytes, messages).
pub fn get_all(fields: [PbField], number: int) -> [PbField] {
    var out: [PbField] = [];
    for f in fields {
        if (f.number == number) {
            out.push(f);
        }
    }
    out
}

/// Parses the nested message in the first field with the given number. An absent field is an
/// empty message (the proto3 default); `Err` when its bytes are not a valid message.
pub fn get_message(fields: [PbField], number: int) -> Result<[PbField], string> {
    parse(get_bytes(fields, number))
}

/// Returns the bytes value of the first field with the given number, or empty bytes if absent.
pub fn get_bytes(fields: [PbField], number: int) -> bytes {
    var i = 0;
    while (i < fields.len()) {
        if (fields[i].number == number) {
            return fields[i].bytes_val;
        }
        i = i + 1;
    }
    b""
}

/// Returns the string value (UTF-8) of the first field with the given number,
/// or "" if the field is absent or not valid UTF-8.
pub fn get_string(fields: [PbField], number: int) -> string {
    match (from_utf8(get_bytes(fields, number))) {
        Result.Ok(s) => s,
        Result.Err(_) => "",
    }
}

// --- Framing de gRPC ---
// Un mensaje gRPC sobre HTTP/2 va con un prefijo de 5 octetos: 1 octeto de flag de compresión (0 = sin
// comprimir) + 4 octetos big-endian con la longitud del mensaje, seguidos del protobuf.
/// Wraps a serialized message in the gRPC length-prefixed frame: 1 compression flag byte
/// (0 = uncompressed) + 4 big-endian length bytes + the message.
pub fn grpc_frame(message: bytes) -> bytes {
    var out: [int] = [];
    out.push(0);  // sin comprimir
    let n = message.len();
    out.push(n >> 24 & 255);
    out.push(n >> 16 & 255);
    out.push(n >> 8 & 255);
    out.push(n & 255);
    bytes_of(out) + message
}

/// Extracts the message from a gRPC frame (strips the 5-byte prefix).
/// Returns `Err` if the frame is shorter than 5 bytes.
pub fn grpc_unframe(data: bytes) -> Result<bytes, string> {
    if (data.len() < 5) {
        return Result.Err("gRPC frame too short");
    }
    let n = data[1] << 24 | data[2] << 16 | data[3] << 8 | data[4];
    Result.Ok(data.sub_bytes(5, 5 + n))
}
