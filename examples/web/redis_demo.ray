// Demo del cliente Redis (M20.6). Se conecta a `127.0.0.1:<puerto>` (el puerto llega como argumento)
// y ejecuta una secuencia de comandos, imprimiendo cada respuesta. Lo lanza `tests/redis_cli.rs`
// contra un servidor RESP de juguete (en Rust), por ambos motores.
//
//   raylang --vm examples/web/redis_demo.ray 6379   # contra un Redis real en el 6379
from redis import connect, command, close_conn, Conn, Reply, reply_str;

fn main() -> int {
    let puerto = puerto_de_args();
    match (connect("127.0.0.1", puerto)) {
        Result.Err(e) => {
            eprint("could not connect: " + e);
            1
        },
        Result.Ok(c) => {
            print(reply_str(ejec(c, ["PING"])));  // PONG
            print(reply_str(ejec(c, ["SET", "clave", "valor"])));  // OK
            print(reply_str(ejec(c, ["GET", "clave"])));  // valor
            print(reply_str(ejec(c, ["GET", "noexiste"])));  // (nil)
            print(reply_str(ejec(c, ["INCR", "contador"])));  // 1
            print(reply_str(ejec(c, ["INCR", "contador"])));  // 2
            print(reply_str(ejec(c, ["RPUSH", "lista", "a", "b", "c"])));  // 3
            print(reply_str(ejec(c, ["LRANGE", "lista", "0", "-1"])));  // [a, b, c]
            print(reply_str(ejec(c, ["DEL", "clave"])));  // 1
            // M69: round-trip multibyte — el framing cuenta OCTETOS ("añejo ñandú" = 12 chars,
            // 14 octetos; la versión pre-M69 declaraba $12 y desincronizaba el protocolo).
            print(reply_str(ejec(c, ["SET", "múlti", "añejo ñandú"])));  // OK
            print(reply_str(ejec(c, ["GET", "múlti"])));  // añejo ñandú
            close_conn(c);
            0
        },
    }
}

// Ejecuta un comando o aborta con su error (la demo asume un servidor sano).
fn ejec(c: Conn, args: [string]) -> Reply {
    match (command(c, args)) {
        Result.Ok(r) => r,
        Result.Err(e) => {
            panic(e);
            Reply.Nil
        },
    }
}

fn puerto_de_args() -> int {
    let a = args();
    if (a.len() == 0) {
        return 6379;
    }
    match (parse_int(a[0])) {
        Option.Some(p) => p,
        Option.None => 6379,
    }
}
