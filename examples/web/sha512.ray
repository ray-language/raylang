// SHA-512 (FIPS 180-4) escrito EN raylang. Prerrequisito de Ed25519 (M30.2). Aritmética de 64 bits:
// **showcase de los `u64` de M28.3** — como en SHA-256 pero SIN el `& mask` tras cada operación, porque
// el wrapping de `u64` es exactamente la aritmética mod 2^64 que pide el algoritmo.
//
// Entrada: octetos `[int]`. Salida: `[int]` de 64 octetos (el digest), o su hex con `sha512_hex`.
// Las constantes de 64 bits superan i64::MAX, así que se componen de dos mitades de 32 bits con `w64`.
// Importable: `from sha512 import sha512, sha512_hex, sha512_octets;`.
from std/hex import hex_encode;

// Compone una palabra de 64 bits a partir de sus mitades alta y baja de 32 bits.
fn w64(hi: int, lo: int) -> u64 {
    hi as u64 << 32 | lo as u64
}

// Rotación de 64 bits a la derecha.
fn rotr64(x: u64, n: u64) -> u64 {
    x >> n | x << 64 - n
}

// Valores iniciales de hash H0..H7 (parte fraccionaria de la raíz cuadrada de los 8 primeros primos).
fn h_init() -> [u64] {
    [w64(1779033703, 4089235720), w64(3144134277, 2227873595), w64(1013904242, 4271175723), w64(2773480762, 1595750129), w64(1359893119, 2917565137), w64(2600822924, 725511199), w64(528734635, 4215389547), w64(1541459225, 327033209)]
}

// Las 80 constantes de ronda (raíz cúbica de los 80 primeros primos).
fn k_table() -> [u64] {
    [w64(1116352408, 3609767458), w64(1899447441, 602891725), w64(3049323471, 3964484399), w64(3921009573, 2173295548), w64(961987163, 4081628472), w64(1508970993, 3053834265), w64(2453635748, 2937671579), w64(2870763221, 3664609560), w64(3624381080, 2734883394), w64(310598401, 1164996542), w64(607225278, 1323610764), w64(1426881987, 3590304994), w64(1925078388, 4068182383), w64(2162078206, 991336113), w64(2614888103, 633803317), w64(3248222580, 3479774868), w64(3835390401, 2666613458), w64(4022224774, 944711139), w64(264347078, 2341262773), w64(604807628, 2007800933), w64(770255983, 1495990901), w64(1249150122, 1856431235), w64(1555081692, 3175218132), w64(1996064986, 2198950837), w64(2554220882, 3999719339), w64(2821834349, 766784016), w64(2952996808, 2566594879), w64(3210313671, 3203337956), w64(3336571891, 1034457026), w64(3584528711, 2466948901), w64(113926993, 3758326383), w64(338241895, 168717936), w64(666307205, 1188179964), w64(773529912, 1546045734), w64(1294757372, 1522805485), w64(1396182291, 2643833823), w64(1695183700, 2343527390), w64(1986661051, 1014477480), w64(2177026350, 1206759142), w64(2456956037, 344077627), w64(2730485921, 1290863460), w64(2820302411, 3158454273), w64(3259730800, 3505952657), w64(3345764771, 106217008), w64(3516065817, 3606008344), w64(3600352804, 1432725776), w64(4094571909, 1467031594), w64(275423344, 851169720), w64(430227734, 3100823752), w64(506948616, 1363258195), w64(659060556, 3750685593), w64(883997877, 3785050280), w64(958139571, 3318307427), w64(1322822218, 3812723403), w64(1537002063, 2003034995), w64(1747873779, 3602036899), w64(1955562222, 1575990012), w64(2024104815, 1125592928), w64(2227730452, 2716904306), w64(2361852424, 442776044), w64(2428436474, 593698344), w64(2756734187, 3733110249), w64(3204031479, 2999351573), w64(3329325298, 3815920427), w64(3391569614, 3928383900), w64(3515267271, 566280711), w64(3940187606, 3454069534), w64(4118630271, 4000239992), w64(116418474, 1914138554), w64(174292421, 2731055270), w64(289380356, 3203993006), w64(460393269, 320620315), w64(685471733, 587496836), w64(852142971, 1086792851), w64(1017036298, 365543100), w64(1126000580, 2618297676), w64(1288033470, 3409855158), w64(1501505948, 4234509866), w64(1607167915, 987167468), w64(1816402316, 1246189591)]
}

// Lee 8 octetos de `b` desde `i` como palabra de 64 bits big-endian.
fn word_be(b: [int], i: int) -> u64 {
    b[i] as u64 << 56 | b[i + 1] as u64 << 48 | b[i + 2] as u64 << 40 | b[i + 3] as u64 << 32 | b[i + 4] as u64 << 24 | b[i + 5] as u64 << 16 | b[i + 6] as u64 << 8 | b[i + 7] as u64
}

// Añade los 8 octetos big-endian de la palabra de 64 bits `w` al final de `out`.
fn push_be64(out: [int], w: u64) {
    var j = 56;
    while (j >= 0) {
        out.push((w >> j as u64 & 255) as int);
        j = j - 8;
    }
}

// Rellena el mensaje: los octetos, un 0x80, ceros hasta longitud ≡ 112 (mod 128), y 16 octetos con la
// longitud en bits big-endian (los 8 altos son 0 para mensajes normales).
fn pad(msg: [int]) -> [int] {
    let n = msg.len();
    var m: [int] = [];
    var i = 0;
    while (i < n) {
        m.push(msg[i]);
        i = i + 1;
    }
    m.push(128);
    while (m.len() % 128 != 112) {
        m.push(0);
    }
    var k = 0;
    while (k < 8) {
        m.push(0);  // los 8 octetos altos de la longitud de 128 bits
        k = k + 1;
    }
    let bitlen = n * 8;
    k = 7;
    while (k >= 0) {
        m.push(bitlen >> k * 8 & 255);
        k = k - 1;
    }
    m
}

// Los 64 octetos del digest.
pub fn sha512_octets(msg: [int]) -> [int] {
    let m = pad(msg);
    let k = k_table();
    var h = h_init();
    var off = 0;
    while (off < m.len()) {
        // Agenda de mensaje W[0..79].
        var w: [u64] = [];
        var t = 0;
        while (t < 16) {
            w.push(word_be(m, off + t * 8));
            t = t + 1;
        }
        while (t < 80) {
            let s0 = rotr64(w[t - 15], 1) ^ rotr64(w[t - 15], 8) ^ w[t - 15] >> 7;
            let s1 = rotr64(w[t - 2], 19) ^ rotr64(w[t - 2], 61) ^ w[t - 2] >> 6;
            w.push(w[t - 16] + s0 + w[t - 7] + s1);
            t = t + 1;
        }
        // Compresión: 80 rondas sobre el estado a..h.
        var a = h[0];
        var b = h[1];
        var c = h[2];
        var d = h[3];
        var e = h[4];
        var f = h[5];
        var g = h[6];
        var hh = h[7];
        var i = 0;
        while (i < 80) {
            let up1 = rotr64(e, 14) ^ rotr64(e, 18) ^ rotr64(e, 41);
            let ch = e & f ^ ~e & g;
            let t1 = hh + up1 + ch + k[i] + w[i];
            let up0 = rotr64(a, 28) ^ rotr64(a, 34) ^ rotr64(a, 39);
            let maj = a & b ^ a & c ^ b & c;
            let t2 = up0 + maj;
            hh = g;
            g = f;
            f = e;
            e = d + t1;
            d = c;
            c = b;
            b = a;
            a = t1 + t2;
            i = i + 1;
        }
        h[0] = h[0] + a;
        h[1] = h[1] + b;
        h[2] = h[2] + c;
        h[3] = h[3] + d;
        h[4] = h[4] + e;
        h[5] = h[5] + f;
        h[6] = h[6] + g;
        h[7] = h[7] + hh;
        off = off + 128;
    }
    var out: [int] = [];
    var i = 0;
    while (i < 8) {
        push_be64(out, h[i]);
        i = i + 1;
    }
    out
}

// Alias con nombre corto.
pub fn sha512(msg: [int]) -> [int] {
    sha512_octets(msg)
}

// El digest en hexadecimal.
pub fn sha512_hex(msg: [int]) -> string {
    hex_encode(bytes_of(sha512_octets(msg)))
}
