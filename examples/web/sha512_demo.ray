// Demo de SHA-512: comprueba los digests de "abc" y del mensaje vacío contra los vectores conocidos
// (FIPS 180-4 / NIST). Prerrequisito de Ed25519.
from sha512 import sha512_hex;

fn str_bytes(s: string) -> [int] {
    var b: [int] = [];
    for c in s {
        b.push(c as int);
    }
    b
}

fn main() {
    print(sha512_hex(str_bytes("abc")));
    // esperado: ddaf35a1...54ca49f
    print(sha512_hex(str_bytes("")));
    // esperado: cf83e135...927da3e
    print(sha512_hex(str_bytes("The quick brown fox jumps over the lazy dog")));
}
