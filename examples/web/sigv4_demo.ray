// Demo/verificación de AWS Signature V4 (M20.9). Salida determinista (credenciales/fecha fijas), la
// ejecuta `tests/sigv4_cli.rs`. El primer caso es el vector oficial `get-vanilla` de la suite de AWS;
// el segundo ejercita el ordenamiento de la query y el hash del cuerpo (referencia de Python).
from sigv4 import credentials, authorization_header;

fn main() {
    let cred = credentials("AKIDEXAMPLE", "wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY", "us-east-1", "service");

    var h: Map<string, string> = Map.new();
    h.insert("host", "example.amazonaws.com");
    h.insert("x-amz-date", "20150830T123600Z");

    // Caso 1: GET / sin query ni cuerpo (vector oficial get-vanilla).
    print(authorization_header(cred, "GET", "/", "", h, "".to_bytes(), "20150830T123600Z"));
    // Signature=5fa00fa31553b73ebf1942676e86291e8372ff2a2260956d9b8aae1d763fbf31
    // Caso 2: POST con query desordenada (b=2&a=1 → debe ordenarse) y cuerpo "datos".
    print(authorization_header(cred, "POST", "/", "b=2&a=1", h, "datos".to_bytes(), "20150830T123600Z"));
    // Signature=9eb84a4204a201b2eee292a6fd7bd72b820d6580ec32367b8ad37f7be64f8aed
}
