// `ray templ <path>`. The template is the source of truth.
from std/template import escape_html;
import vistas/tarjeta;

/// Renders the `vista_inicio` template (generated; the `.ray.html` file is the source of truth).
pub fn render_vista_inicio(titulo: string, saludo: string, popular: bool, lenguajes: [string]) -> string {
    var out: [string] = [];
    out.push("<!DOCTYPE html>\n<html>\n<head>\n    <meta charset=\"utf-8\">\n    <title>");
    out.push(escape_html(to_string(titulo)));
    out.push("</title>\n    <style>\n        body { font-family: sans-serif; margin: 2rem; }\n        .tarjeta { border: 1px solid #ccc; padding: 0.25rem 0.5rem; margin: 0.25rem 0; list-style: none; }\n        footer { color: #888; }\n    </style>\n</head>\n<body>\n");
    out.push("\n    <h1>");
    out.push(escape_html(to_string(titulo)));
    out.push("</h1>\n    <p>");
    out.push(escape_html(to_string(saludo)));
    out.push("</p>\n    ");
    if (popular) {
        out.push("\n        <p><strong>¡Un lenguaje popular!</strong></p>\n    ");
    } else {
        out.push("\n        <p>Un lenguaje de nicho.</p>\n    ");
    }
    out.push("\n    <ul>\n    ");
    for lang in lenguajes {
        out.push("\n        ");
        out.push(to_string(tarjeta.render_tarjeta(lang)));
        out.push("\n    ");
    }
    out.push("\n    </ul>\n");
    out.push("\n<footer>servido por raylang &middot; ");
    out.push(escape_html(to_string(titulo)));
    out.push("</footer>\n</body>\n</html>\n");
    out.join("")
}
