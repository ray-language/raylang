// Demo/verificación de fechas/horas UTC (M20.5). Salida determinista (timestamps fijos), la ejecuta
// `tests/time_cli.rs`. Referencias de `datetime.utcfromtimestamp` (Python).
from time import from_epoch_millis, to_iso8601, to_rfc1123, to_epoch_millis, parse_iso8601, parse_iso8601_millis, now_utc, format_duration;
from std/time import millis, seconds, minutes, hours, days;
import std/time;

fn main() {
    // --- conversión epoch → fecha civil (ISO 8601 + RFC 1123) ---
    print(iso(0));  // 1970-01-01T00:00:00Z
    print(rfc(0));  // Thu, 01 Jan 1970 00:00:00 GMT
    print(iso(784111777000));  // 1994-11-06T08:49:37Z
    print(rfc(784111777000));  // Sun, 06 Nov 1994 08:49:37 GMT
    print(iso(1719748177000));  // 2024-06-30T11:49:37Z
    print(rfc(1719748177000));  // Sun, 30 Jun 2024 11:49:37 GMT
    // 2024 es bisiesto: el 1 de marzo verifica el manejo del 29 de febrero.
    print(rfc(1709251200000));  // Fri, 01 Mar 2024 00:00:00 GMT

    // --- round-trip: to_epoch_millis(from_epoch_millis(x)) == x (al segundo) ---
    let x = 1719748177000;
    print(to_epoch_millis(from_epoch_millis(x)) == x);  // true

    // --- parse_iso8601 → epoch ---
    match (parse_iso8601("1994-11-06T08:49:37Z")) {
        Result.Ok(dt) => print(to_epoch_millis(dt) == 784111777000),  // true
        Result.Err(e) => print(e),
    }

    // --- parse endurecido (M57.1): offsets, fracción y errores reales ---
    // Un offset +02:00 se normaliza a UTC (10:49:37+02:00 == 08:49:37Z).
    match (parse_iso8601("1994-11-06T10:49:37+02:00")) {
        Result.Ok(dt) => print(to_iso8601(dt)),  // 1994-11-06T08:49:37Z
        Result.Err(e) => print("err: " + e),
    }
    // Offset negativo (05:49:37-03:00 == 08:49:37Z).
    match (parse_iso8601("1994-11-06T05:49:37-03:00")) {
        Result.Ok(dt) => print(to_iso8601(dt)),  // 1994-11-06T08:49:37Z
        Result.Err(e) => print("err: " + e),
    }
    // La fracción aporta los ms en parse_iso8601_millis (y dígitos de más se truncan).
    match (parse_iso8601_millis("1970-01-01T00:00:00.123456Z")) {
        Result.Ok(ms) => print(ms),  // 123
        Result.Err(e) => print("err: " + e),
    }
    // Errores reales (antes: 0 en silencio): mes 13, fecha inexistente, campo no numérico, sin offset.
    print(es_err(parse_iso8601_millis("2024-13-01T00:00:00Z")));       // true (mes 13)
    print(es_err(parse_iso8601_millis("2023-02-29T00:00:00Z")));       // true (2023 no es bisiesto)
    print(es_err(parse_iso8601_millis("2024-0x-01T00:00:00Z")));       // true (no numérico)
    print(es_err(parse_iso8601_millis("2024-06-30T11:49:37")));        // true (falta el offset)
    print(es_err(parse_iso8601_millis("2024-06-30T11:49:37Zx")));      // true (texto sobrante)
    // Y el 29-feb de un año bisiesto SÍ parsea.
    match (parse_iso8601("2024-02-29T00:00:00Z")) {
        Result.Ok(dt) => print(to_rfc1123(dt)),  // Thu, 29 Feb 2024 00:00:00 GMT
        Result.Err(e) => print("err: " + e),
    }

    // --- now_utc coherente con time.now() (propiedad, no valor) ---
    let ahora = now_utc();
    let delta = time.now() - to_epoch_millis(ahora);
    print(delta >= 0 && delta < 1000);  // true (la diferencia es solo el resto sub-segundo)

    // --- duraciones ---
    print(format_duration(3723000));  // 1h2m3s
    print(format_duration(45000));  // 45s
    print(format_duration(500));  // 500ms

    // --- constructores de duración (azúcar UFCS → ms) ---
    print(500.millis());  // 500
    print(30.seconds());  // 30000
    print(5.minutes());  // 300000
    print(2.hours());  // 7200000
    print(1.days());  // 86400000
    // Componen con format_duration (el inverso: ms → texto).
    print(format_duration(1.hours() + 2.minutes() + 3.seconds()));  // 1h2m3s
}

fn iso(ms: int) -> string { to_iso8601(from_epoch_millis(ms)) }

fn rfc(ms: int) -> string { to_rfc1123(from_epoch_millis(ms)) }

fn es_err(r: Result<int, string>) -> bool {
    match (r) {
        Result.Ok(_) => false,
        Result.Err(_) => true,
    }
}
