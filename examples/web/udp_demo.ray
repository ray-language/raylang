// Demo del cliente UDP (M20.8). Enlaza un socket efímero, envía un datagrama a un servidor de eco
// (cuyo puerto llega como argumento) y muestra la respuesta. Lo lanza `tests/udp_cli.rs` por ambos
// motores contra un servidor UDP de eco en Rust (que devuelve el payload en MAYÚSCULAS).
from udp import bind, send_to, recv_from;

fn main() -> int {
    let puerto = puerto_de_args();
    match (bind("127.0.0.1", 0)) {
        Result.Err(e) => {
            eprint("bind: " + e);
            1
        },
        Result.Ok(h) => {
            match (send_to(h, "127.0.0.1", puerto, "hola udp".to_bytes())) {
                Result.Err(e) => {
                    eprint("send: " + e);
                    1
                },
                Result.Ok(n) => {
                    print(to_string(n));  // 8 (octetos enviados)
                    match (recv_from(h)) {
                        Result.Ok(p) => {
                            match (from_utf8(p.data)) {
                                Result.Ok(s) => print(s),  // HOLA UDP (el servidor lo pasa a mayúsculas)
                                Result.Err(e) => print("utf8: " + e),
                            }
                        },
                        Result.Err(e) => print("recv: " + e),
                    }
                    close(h);
                    0
                },
            }
        },
    }
}

fn puerto_de_args() -> int {
    let a = args();
    if (a.len() == 0) {
        return 9999;
    }
    match (parse_int(a[0])) {
        Option.Some(p) => p,
        Option.None => 9999,
    }
}
