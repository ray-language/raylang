// Demo del TIMEOUT de lectura UDP (M121). Dos fases, contra el servidor de eco cuyo puerto llega
// como argumento (lo lanza `tests/udp_cli.rs`):
//   1) plazo VENCIDO: nadie envía → `recv_from` responde `Err("read timeout")` en ~el plazo
//      (antes esperaba PARA SIEMPRE: un datagrama perdido colgaba la fibra sin remedio);
//   2) el dato GANA al plazo: con timeout puesto, un send+recv normal sigue funcionando.
import std/net;
import std/time;
from udp import bind, send_to, recv_from, Packet;

fn port_from_args() -> int {
    let xs = args();
    if (xs.len() < 1) {
        return 0;
    }
    match (parse_int(xs[0])) {
        Option.Some(n) => n,
        Option.None => 0,
    }
}

fn main() -> int {
    let echo_port = port_from_args();
    let h = match (bind("127.0.0.1", 0)) {
        Result.Ok(x) => x,
        Result.Err(e) => {
            print("bind err: " + e);
            return 1;
        },
    };
    // Fase 1: plazo vencido (nadie envía nada a este socket todavía).
    net.set_read_timeout(h, 150);
    let t0 = time.monotonic();
    match (recv_from(h)) {
        Result.Ok(_) => print("unexpected packet"),
        Result.Err(e) => print("err: " + e),
    }
    let dt = time.monotonic() - t0;
    // Venció "a tiempo": ni antes del plazo ni órdenes de magnitud después.
    print(dt >= 100 && dt < 5000);
    // Fase 2: el dato gana al plazo (el timeout sigue puesto; el eco responde enseguida).
    net.set_read_timeout(h, 3000);
    match (send_to(h, "127.0.0.1", echo_port, "hola plazo".to_bytes())) {
        Result.Ok(_) => {},
        Result.Err(e) => {
            print("send err: " + e);
            return 1;
        },
    }
    match (recv_from(h)) {
        Result.Ok(pkt) => match (from_utf8(pkt.data)) {
            Result.Ok(s) => print(s),
            Result.Err(_) => print("non-utf8 reply"),
        },
        Result.Err(e) => print("recv err: " + e),
    }
    0
}
