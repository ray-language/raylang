// Demo de la CESIÓN cooperativa de udp_recv_from (M20.11, solo VM). Dos fibras esperan un datagrama en
// sockets UDP distintos a la vez. Si recv_from bloqueara el hilo del scheduler, la 2.ª fibra nunca
// correría (deadlock) y su puerto no se imprimiría → el test colgaría. Que ambas avancen prueba que
// recv_from CEDE la fibra al scheduler mientras espera. Lo lanza `tests/udp_yield_cli.rs`.
from udp import bind, send_to, recv_from, Packet;

fn texto(d: bytes) -> string {
    match (from_utf8(d)) {
        Result.Ok(s) => s,
        Result.Err(_) => "",
    }
}

// Fibra trabajadora: enlaza su propio socket, anuncia su puerto y espera un datagrama.
fn worker() {
    match (bind("127.0.0.1", 0)) {
        Result.Ok(hb) => {
            print("B " + to_string(local_port(hb)));
            match (recv_from(hb)) {
                Result.Ok(p) => print("B:" + texto(p.data)),
                Result.Err(e) => print("Berr:" + e),
            }
        },
        Result.Err(e) => print("Bbind:" + e),
    }
}

fn main() -> int {
    match (bind("127.0.0.1", 0)) {
        Result.Ok(ha) => {
            print("A " + to_string(local_port(ha)));
            let t = spawn(worker);
            // recv_from cede aquí → el worker corre, enlaza B y también cede. Ambas fibras esperan.
            match (recv_from(ha)) {
                Result.Ok(p) => print("A:" + texto(p.data)),
                Result.Err(e) => print("Aerr:" + e),
            }
            join(t);  // espera a que el worker termine antes de salir (si no, la VM cerraría)
            0
        },
        Result.Err(e) => {
            eprint(e);
            1
        },
    }
}
