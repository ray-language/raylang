// Codificación de URL (percent-encoding, RFC 3986) y query strings, escritas EN raylang. Cero runtime
// nuevo. Importable: `from url import url_encode, url_decode, parse_query, build_query;`.
//
// `url_encode` deja pasar los caracteres "unreserved" (A-Z a-z 0-9 - _ . ~) y codifica el resto como
// `%XX` (hex en mayúscula de cada octeto UTF-8). `url_decode` revierte `%XX` y, siguiendo
// application/x-www-form-urlencoded, decodifica `+` como espacio (lo habitual al leer query/body).
// Dígito hexadecimal en MAYÚSCULA (convención de las URLs) del valor `d` (0..15).
fn hex_up(d: int) -> string {
    let digits = "0123456789ABCDEF";
    to_string(digits[d])
}

// Los dos dígitos hex (mayúscula) de un octeto.
fn hex2(o: int) -> string {
    hex_up(o >> 4 & 15) + hex_up(o & 15)
}

// Valor (0..15) de un dígito hexadecimal, o -1 si no lo es (acepta mayúscula y minúscula).
fn hex_val(c: char) -> int {
    match (index_of("0123456789abcdef", to_string(c).to_lower())) {
        Option.Some(i) => i,
        Option.None => 0 - 1,
    }
}

// ¿Es `c` un carácter "unreserved" (no necesita escaparse)?
fn is_unreserved(c: char) -> bool {
    match (index_of(
    "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_.~",
    to_string(c)
)) {
        Option.Some(_) => true,
        Option.None => false,
    }
}

/// Percent-encodes a string per RFC 3986: unreserved characters (A-Z a-z 0-9 - _ . ~) pass
/// through; everything else becomes `%XX` (uppercase hex of each UTF-8 byte).
pub fn url_encode(s: string) -> string {
    var out = "";
    var i = 0;
    while (i < s.len()) {
        let c = s[i];
        if (is_unreserved(c)) {
            out = out + to_string(c);
        } else {
            // Cada carácter no-unreserved se codifica por sus octetos UTF-8 (1+ octetos).
            let b = to_string(c).to_bytes();
            var j = 0;
            while (j < b.len()) {
                out = out + "%" + hex2(b[j]);
                j = j + 1;
            }
        }
        i = i + 1;
    }
    out
}

// M56.2: decodifica SOLO los escapes %XX; un `+` queda como `+` literal. Es la regla de las
// RUTAS de URL (el `+`=espacio es exclusivo de application/x-www-form-urlencoded → `url_decode`).
/// Decodes percent escapes (`%XX`) only; a `+` stays a literal plus — the rule for URL *paths*
/// (`+` means space only in application/x-www-form-urlencoded; for that, use `url_decode`).
/// Returns `Err` on an incomplete or invalid `%XX` escape, or if the bytes are not valid UTF-8.
pub fn percent_decode(s: string) -> Result<string, string> {
    var oct: [int] = [];
    let n = s.len();
    var i = 0;
    while (i < n) {
        let c = s[i];
        if (c == '%') {
            if (i + 2 >= n) {
                return Result.Err("escape % incompleto");
            }
            let hi = hex_val(s[i + 1]);
            let lo = hex_val(s[i + 2]);
            if (hi < 0 || lo < 0) {
                return Result.Err("escape % inválido");
            }
            oct.push(hi << 4 | lo);
            i = i + 3;
        } else {
            let b = to_string(c).to_bytes();
            var j = 0;
            while (j < b.len()) {
                oct.push(b[j]);
                j = j + 1;
            }
            i = i + 1;
        }
    }
    from_utf8(bytes_of(oct))
}

/// Decodes a percent-encoded string; `+` decodes to a space (application/x-www-form-urlencoded).
/// Returns `Err` on an incomplete or invalid `%XX` escape, or if the bytes are not valid UTF-8.
pub fn url_decode(s: string) -> Result<string, string> {
    // Un `+` literal pasa a espacio ANTES de decodificar; el `%2B` (el + codificado) no se toca
    // (no contiene el carácter `+`), así que decodifica a `+` como debe.
    percent_decode(s.replace("+", " "))
}

// `url_decode` tolerante: si la entrada está mal formada, devuelve el texto crudo (no rompe el parseo).
fn url_decode_or(s: string) -> string {
    match (url_decode(s)) {
        Result.Ok(v) => v,
        Result.Err(_) => s,
    }
}

// Parsea una query string (`a=1&b=hola%20mundo`) en un `Map<string,string>` (la última clave gana).
// Cada clave/valor se url-decodifica. Una clave sin `=` queda con valor "".
/// Parses a query string (`a=1&b=hola%20mundo`) into a `Map<string,string>`; the last duplicate
/// key wins. Keys and values are URL-decoded (malformed escapes fall back to the raw text);
/// a key without `=` gets the value "".
pub fn parse_query(qs: string) -> Map<string, string> {
    var m: Map<string, string> = Map.new();
    if (qs.len() == 0) {
        return m;
    }
    let pairs = qs.split("&");
    var i = 0;
    while (i < pairs.len()) {
        let p = pairs[i];
        if (p.len() > 0) {
            // Se parte por el PRIMER `=` (el valor puede contener más).
            match (index_of(p, "=")) {
                Option.Some(eq) => {
                    let k = url_decode_or(p.substring(0, eq));
                    let v = url_decode_or(p.substring(eq + 1, p.len()));
                    m.insert(k, v);
                },
                Option.None => {
                    m.insert(url_decode_or(p), "");
                },
            }
        }
        i = i + 1;
    }
    m
}

// Construye una query string a partir de un `Map<string,string>`. Las claves salen ORDENADAS
// (`keys` es determinista) → salida reproducible. Clave y valor se url-codifican.
/// Builds a query string from a `Map<string,string>`; keys and values are percent-encoded.
/// Keys come out sorted, so the output is deterministic and reproducible.
pub fn build_query(m: Map<string, string>) -> string {
    let ks = m.keys();
    var out = "";
    var i = 0;
    while (i < ks.len()) {
        if (i > 0) {
            out = out + "&";
        }
        let k = ks[i];
        let v = match (get(m, k)) {
            Option.Some(x) => x,
            Option.None => "",
        };
        out = out + url_encode(k) + "=" + url_encode(v);
        i = i + 1;
    }
    out
}
