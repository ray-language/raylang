// Demo/verificación de url (percent-encoding + query) y cookies (M20.4). Salida determinista,
// la ejecuta `tests/url_cli.rs`. Referencias de `urllib.parse.quote`.
from url import url_encode, url_decode, parse_query, build_query;
from cookie import parse_cookies, cookie, set_cookie, with_path, with_max_age, with_http_only, with_secure;

fn main() {
    // --- percent-encoding ---
    print(url_encode("hola mundo & más=cosas/ñ"));  // hola%20mundo%20%26%20m%C3%A1s%3Dcosas%2F%C3%B1
    print(url_encode("a-b_c.d~e"));  // a-b_c.d~e  (todos unreserved → sin tocar)

    // round-trip de decode (incl. UTF-8 multibyte y '+' como espacio).
    match (url_decode("hola%20mundo%20%26%20m%C3%A1s")) {
        Result.Ok(v) => print(v),  // hola mundo & más
        Result.Err(e) => print(e),
    }
    match (url_decode("a+b")) {
        Result.Ok(v) => print(v),  // "a b"  (+ → espacio)
        Result.Err(e) => print(e),
    }

    // --- query string ---
    let q = parse_query("nombre=Ada+Lovelace&rol=admin&x=1%262");
    print(get_or(q, "nombre"));  // Ada Lovelace
    print(get_or(q, "rol"));  // admin
    print(get_or(q, "x"));  // 1&2  (el %26 decodificado dentro del valor)

    // build_query: claves ordenadas → reproducible.
    var m: Map<string, string> = Map.new();
    insert(m, "q", "raylang lang");
    insert(m, "page", "2");
    print(build_query(m));  // page=2&q=raylang%20lang

    // --- cookies ---
    let cs = parse_cookies("session=abc123; theme=dark; lang=es");
    print(get_or(cs, "session"));  // abc123
    print(get_or(cs, "theme"));  // dark

    // Set-Cookie encadenado por UFCS (cross-module).
    print(set_cookie(cookie("sid", "a b/c").with_path("/").with_max_age(3600).with_http_only().with_secure()));
    // sid=a%20b%2Fc; Path=/; Max-Age=3600; HttpOnly; Secure
    print(set_cookie(cookie("plain", "x")));  // plain=x  (sin atributos)
}

// get de un Map con defecto "" (para imprimir sin Option).
fn get_or(m: Map<string, string>, k: string) -> string {
    match (get(m, k)) {
        Option.Some(v) => v,
        Option.None => "",
    }
}
