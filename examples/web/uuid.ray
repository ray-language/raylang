// UUID versión 4 (RFC 4122, aleatorios) escritos EN raylang. Apila sobre `random_int` (PRNG del
// runtime) + `hex`. Importable: `from uuid import uuid_v4, is_uuid_v4;`.
//
// 16 octetos aleatorios con dos campos fijos: los 4 bits altos del octeto 6 = 0100 (versión 4) y los
// 2 bits altos del octeto 8 = 10 (variante RFC 4122). Formato canónico 8-4-4-4-12 en hex minúscula.

from hex import hex_encode;

pub fn uuid_v4() -> string {
    var b: [int] = [];
    var i = 0;
    while (i < 16) {
        push(b, random_int(256));
        i = i + 1;
    }
    b[6] = (b[6] & 15) | 64;   // versión 4: 0x40 en el nibble alto
    b[8] = (b[8] & 63) | 128;  // variante 10xx: 0x80 en los bits altos
    let h = hex_encode(b);     // 32 dígitos hex
    substring(h, 0, 8) + "-" + substring(h, 8, 12) + "-" + substring(h, 12, 16) + "-"
        + substring(h, 16, 20) + "-" + substring(h, 20, 32)
}

// ¿Es `c` un dígito hexadecimal en minúscula (0-9 a-f)?
fn is_hex_lower(c: char) -> bool {
    match (index_of("0123456789abcdef", to_string(c))) {
        Option.Some(_) => true,
        Option.None => false,
    }
}

// Valida la forma de un UUID v4 canónico (longitud, guiones, nibble de versión, bits de variante,
// resto hexadecimal). Permite probar `uuid_v4` de forma determinista pese a su aleatoriedad.
pub fn is_uuid_v4(s: string) -> bool {
    if (len(s) != 36) {
        return false;
    }
    if (s[8] != '-' || s[13] != '-' || s[18] != '-' || s[23] != '-') {
        return false;
    }
    if (s[14] != '4') { // primer dígito del 3.er grupo = versión
        return false;
    }
    let v = s[19]; // primer dígito del 4.º grupo = variante (8,9,a,b)
    if (!(v == '8' || v == '9' || v == 'a' || v == 'b')) {
        return false;
    }
    // Todo lo que no es guion debe ser hex minúscula.
    var i = 0;
    while (i < 36) {
        if (i != 8 && i != 13 && i != 18 && i != 23) {
            if (!is_hex_lower(s[i])) {
                return false;
            }
        }
        i = i + 1;
    }
    true
}
