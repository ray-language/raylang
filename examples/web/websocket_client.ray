// Cliente WebSocket (RFC 6455) sobre `ws://`, escrito EN raylang. El espejo del servidor de M19.3c:
// el CLIENTE debe **enmascarar** las tramas que envía (§5.3) y lee tramas del servidor SIN enmascarar
// (que `websocket.decode_frame` ya maneja). Importable:
//   from websocket_client import connect, send_text, recv_text, close_ws;
//
// Reusa la cripto del handshake (`sha1`/`base64` vía `accept_key`) y el framing de lectura de
// `websocket.ray`. Sobre los sockets TCP (M15): funciona en ambos motores (cliente bloqueante). Sin TLS
// (`wss` añadiría `tls_connect`), sin fragmentación.
from sha1 import sha1;
from base64 import base64;
from websocket import accept_key, decode_frame, Frame, op_text, op_close;

// --- Handshake del cliente ---
// Genera una `Sec-WebSocket-Key`: 16 octetos aleatorios en base64 (RFC 6455 §4.1).
fn make_key() -> string {
    var b: [int] = [];
    var i = 0;
    while (i < 16) {
        push(b, random_int(256));
        i = i + 1;
    }
    base64(b)
}

// La petición de upgrade del cliente.
fn upgrade_request(host: string, path: string, key: string) -> string {
    "GET " + path + " HTTP/1.1\r\n" + "Host: " + host + "\r\n" + "Upgrade: websocket\r\n" + "Connection: Upgrade\r\n" + "Sec-WebSocket-Key: " + key + "\r\n" + "Sec-WebSocket-Version: 13\r\n\r\n"
}

// Verifica la respuesta 101: estado correcto + `Sec-WebSocket-Accept` == base64(SHA-1(key + GUID)).
fn verify_handshake(response: string, key: string) -> bool {
    if (!contains(response, "101")) {
        return false;
    }
    let esperado = accept_key(key);
    let lineas = split(response, "\r\n");
    var i = 0;
    while (i < len(lineas)) {
        if (starts_with(lineas[i], "Sec-WebSocket-Accept:")) {
            match (index_of(lineas[i], ":")) {
                Option.Some(idx) => {
                    return trim(substring(lineas[i], idx + 1, len(lineas[i]))) == esperado;
                },
                Option.None => { },
            }
        }
        i = i + 1;
    }
    false
}

// Lee la respuesta del handshake hasta el fin de cabeceras (\r\n\r\n).
fn read_handshake(h: int) -> Result<string, string> {
    var acc: bytes = b"";
    var seguir = true;
    while (seguir) {
        match (from_utf8(acc)) {
            Result.Ok(s) => {
                match (index_of(s, "\r\n\r\n")) {
                    Option.Some(_) => {
                        return Result.Ok(s);
                    },
                    Option.None => { },
                }
            },
            Result.Err(_) => { },  // bytes UTF-8 a medias → seguir leyendo
        }
        match (socket_read_bytes(h)) {
            Result.Ok(trozo) => {
                if (len(trozo) == 0) {
                    seguir = false;
                } else {
                    acc = acc + trozo;
                }
            },
            Result.Err(e) => {
                return Result.Err("error al leer el handshake: " + e);
            },
        }
    }
    from_utf8(acc)
}

// Hace el handshake de WebSocket sobre un handle ya conectado (TCP o TLS). El I/O usa
// socket_read_bytes/socket_write_bytes, que para un handle TLS van cifrados (M19.4) → el mismo código
// sirve para ws:// y wss://.
fn do_handshake(h: int, host: string, port: int, path: string) -> Result<int, string> {
    let key = make_key();
    let req = upgrade_request(host + ":" + to_string(port), path, key);
    match (socket_write_bytes(h, to_bytes(req))) {
        Result.Err(e) => {
            close(h);
            Result.Err("upgrade: " + e)
        },
        Result.Ok(_) => {
            match (read_handshake(h)) {
                Result.Err(e) => {
                    close(h);
                    Result.Err(e)
                },
                Result.Ok(resp) => {
                    if (verify_handshake(resp, key)) {
                        Result.Ok(h)
                    } else {
                        close(h);
                        Result.Err("handshake de WebSocket inválido")
                    }
                },
            }
        },
    }
}

// Conecta a `host:port` por TCP (ws://), hace el handshake y devuelve el handle.
pub fn connect(host: string, port: int, path: string) -> Result<int, string> {
    match (tcp_connect(host, port)) {
        Result.Err(e) => Result.Err("connect: " + e),
        Result.Ok(h) => do_handshake(h, host, port, path),
    }
}

// Conecta a `host:port` por TLS (wss://), hace el handshake y devuelve el handle. El handle TLS enruta
// socket_read_bytes/socket_write_bytes/close por la sesión cifrada (M19.4) → el framing no cambia.
pub fn connect_tls(host: string, port: int, path: string) -> Result<int, string> {
    match (tls_connect(host, port)) {
        Result.Err(e) => Result.Err("tls connect: " + e),
        Result.Ok(h) => do_handshake(h, host, port, path),
    }
}

// --- Framing del cliente (enmascarado) ---
// Codifica una trama del CLIENTE: FIN + opcode, bit MASK activo, clave de máscara de 4 octetos
// aleatorios, y la carga enmascarada (payload[i] XOR mask[i % 4]).
fn encode_masked(opcode: int, payload: bytes) -> bytes {
    let plen = len(payload);
    var out: [int] = [];
    push(out, 128 | opcode);  // FIN=1 + opcode
    if (plen < 126) {
        push(out, 128 | plen);  // bit MASK + longitud
    } else {
        if (plen < 65536) {
            push(out, 128 | 126);
            push(out, plen >> 8 & 255);
            push(out, plen & 255);
        } else {
            push(out, 128 | 127);
            var k = 7;
            while (k >= 0) {
                push(out, plen >> k * 8 & 255);
                k = k - 1;
            }
        }
    }
    // Clave de máscara (4 octetos aleatorios).
    var mask: [int] = [];
    var i = 0;
    while (i < 4) {
        push(mask, random_int(256));
        i = i + 1;
    }
    var m = 0;
    while (m < 4) {
        push(out, mask[m]);
        m = m + 1;
    }
    // Carga enmascarada.
    i = 0;
    while (i < plen) {
        push(out, payload[i] ^ mask[i % 4]);
        i = i + 1;
    }
    bytes_of(out)
}

// Envía un mensaje de texto (trama enmascarada).
pub fn send_text(h: int, message: string) -> Result<int, string> {
    socket_write_bytes(h, encode_masked(op_text(), to_bytes(message)))
}

// Recibe el siguiente mensaje de texto (decodifica una trama; asume una trama por lectura).
pub fn recv_text(h: int) -> Result<string, string> {
    match (socket_read_bytes(h)) {
        Result.Err(e) => Result.Err("error al leer la trama: " + e),
        Result.Ok(data) => {
            if (len(data) < 2) {
                Result.Err("conexión cerrada o trama incompleta")
            } else {
                from_utf8(decode_frame(data).payload)
            }
        },
    }
}

// Cierra la conexión: envía una trama close (enmascarada) y cierra el socket.
pub fn close_ws(h: int) {
    match (socket_write_bytes(h, encode_masked(op_close(), to_bytes("")))) {
        Result.Ok(_) => { },
        Result.Err(_) => { },
    }
    close(h);
}
