// M19.3c — un echo server de WebSocket (`ws://`) escrito EN raylang, sobre la librería `websocket.ray`
// (handshake con SHA-1/base64 de M19.3b) y los sockets/scheduler de M15/M17. **Solo VM** (concurrencia).
//
// Ejecútalo:  cargo run -- --vm examples/web/websocket_echo.ray
// Imprime el puerto efímero en la primera línea; luego acepta conexiones y, por cada una, completa el
// handshake y reenvía (eco) cada trama de texto hasta que el cliente cierra. Una conexión a la vez
// (secuencial: suficiente para un demo; la versión concurrente usaría `spawn` como webserver.ray).
import websocket;
import std/net;

// Completa el handshake en `conn` (lee la petición de upgrade, responde 101). True si fue bien.
fn handshake(conn: int) -> bool {
    match (net.socket_read(conn)) {
        Result.Err(e) => {
            eprint(e);
            false
        },
        Result.Ok(req) => {
            let clave = websocket.extract_key(req);
            match (net.socket_write(conn, websocket.handshake_response(clave))) {
                Result.Ok(_) => true,
                Result.Err(e) => {
                    eprint(e);
                    false
                },
            }
        },
    }
}

// Bucle de eco: lee MENSAJES con el lector robusto (M58.1: tramas partidas/pegadas, ping→pong
// automático, fragmentación reensamblada, close-handshake ya contestado) y los reenvía.
fn eco(conn: int) {
    let ws = websocket.server_conn(conn);
    var seguir = true;
    while (seguir) {
        match (websocket.read_message(ws)) {
            Result.Err(_) => {
                seguir = false;
            },
            Result.Ok(f) => {
                if (f.opcode == websocket.op_close()) {
                    // read_message ya devolvió el close de cortesía; solo queda terminar.
                    seguir = false;
                } else {
                    // Eco: reenvía el mismo texto en una trama de texto del servidor.
                    match (from_utf8(f.payload)) {
                        Result.Ok(txt) => {
                            match (net.socket_write_bytes(conn, websocket.encode_text(txt))) {
                                Result.Ok(_) => { },
                                Result.Err(_) => {
                                    seguir = false;
                                },
                            }
                        },
                        Result.Err(_) => {
                            seguir = false;
                        },
                    }
                }
            },
        }
    }
}

fn main() -> int {
    match (net.tcp_listen("127.0.0.1", 0)) {
        Result.Err(e) => {
            eprint("no se pudo escuchar: " + e);
            1
        },
        Result.Ok(srv) => {
            print(to_string(net.local_port(srv)));  // primera línea: el puerto efímero
            var seguir = true;
            while (seguir) {
                match (net.tcp_accept(srv)) {
                    Result.Err(e) => {
                        eprint(e);
                        seguir = false;
                    },
                    Result.Ok(conn) => {
                        if (handshake(conn)) {
                            eco(conn);
                        }
                        close(conn);
                    },
                }
            }
            close(srv);
            0
        },
    }
}
