// M19.3c — un echo server de WebSocket (`ws://`) escrito EN raylang, sobre la librería `websocket.ray`
// (handshake con SHA-1/base64 de M19.3b) y los sockets/scheduler de M15/M17. **Solo VM** (concurrencia).
//
// Ejecútalo:  cargo run -- --vm examples/websocket_echo.ray
// Imprime el puerto efímero en la primera línea; luego acepta conexiones y, por cada una, completa el
// handshake y reenvía (eco) cada trama de texto hasta que el cliente cierra. Una conexión a la vez
// (secuencial: suficiente para un demo; la versión concurrente usaría `spawn` como webserver.ray).

import websocket;

// Completa el handshake en `conn` (lee la petición de upgrade, responde 101). True si fue bien.
fn handshake(conn: int) -> bool {
    match (socket_read(conn)) {
        Result.Err(e) => { eprint(e); false },
        Result.Ok(req) => {
            let clave = websocket.extract_key(req);
            match (socket_write(conn, websocket.handshake_response(clave))) {
                Result.Ok(_) => true,
                Result.Err(e) => { eprint(e); false },
            }
        },
    }
}

// Bucle de eco: lee tramas y las reenvía hasta un `close` o un error de lectura.
fn eco(conn: int) {
    var seguir = true;
    while (seguir) {
        match (socket_read_bytes(conn)) {
            Result.Err(_) => { seguir = false; },
            Result.Ok(datos) => {
                if (len(datos) < 2) {
                    seguir = false; // conexión cerrada o trama incompleta
                } else {
                    let f = websocket.decode_frame(datos);
                    if (f.opcode == websocket.op_close()) {
                        // Devuelve un close de cortesía y termina esta conexión.
                        let cierre = websocket.encode_frame(websocket.op_close(), to_bytes(""));
                        match (socket_write_bytes(conn, cierre)) { Result.Ok(_) => {}, Result.Err(_) => {}, }
                        seguir = false;
                    } else {
                        // Eco: reenvía el mismo texto en una trama de texto del servidor.
                        match (from_utf8(f.payload)) {
                            Result.Ok(txt) => {
                                match (socket_write_bytes(conn, websocket.encode_text(txt))) {
                                    Result.Ok(_) => {},
                                    Result.Err(_) => { seguir = false; },
                                }
                            },
                            Result.Err(_) => { seguir = false; },
                        }
                    }
                }
            },
        }
    }
}

fn main() -> int {
    match (tcp_listen("127.0.0.1", 0)) {
        Result.Err(e) => { eprint("no se pudo escuchar: " + e); 1 },
        Result.Ok(srv) => {
            print(to_string(local_port(srv))); // primera línea: el puerto efímero
            var seguir = true;
            while (seguir) {
                match (tcp_accept(srv)) {
                    Result.Err(e) => { eprint(e); seguir = false; },
                    Result.Ok(conn) => {
                        if (handshake(conn)) { eco(conn); }
                        close(conn);
                    },
                }
            }
            close(srv);
            0
        },
    }
}
