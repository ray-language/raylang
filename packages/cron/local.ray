// packages/cron/local.ray — cron en HORA LOCAL (M86b), sobre packages/tz.
//
// Módulo SEPARADO de cron/cron a propósito: el cron UTC no arrastra la dependencia de
// tz. El consumidor que quiera hora local declara AMBOS paquetes (cron y tz, hermanos
// de path o del índice) e importa `cron/local`.
//
// Política DST (IDEAS §42; M416 afina el solape con la de raycron #202):
// - una hora civil que cae en el HUECO de primavera (no existe) dispara al TERMINAR el
//   hueco — la primera hora local válida;
// - una hora civil del SOLAPE de otoño (ocurre dos veces) dispara solo la PRIMERA vez si
//   el schedule fija la hora (`30 2 * * *`: «a las 2:30» es un evento del día), y en LAS
//   DOS pasadas si corre cada hora (`0 * * * *`, `*/15 * * * *`): así el espaciado se
//   mantiene en tiempo real (sin un hueco de dos horas la noche del cambio).
import cron/cron;
import tz/tz;
import std/time;

// El siguiente disparo del schedule en la hora CIVIL de la zona, como instante UTC
// (epoch-ms), estrictamente posterior a `ms`.
/// The next fire time of the schedule evaluated in the zone's CIVIL local time, as a
/// UTC instant (epoch-ms) strictly after `ms`. DST policy: a civil time falling in the
/// spring-forward gap fires when the gap ends; one in the fall-back overlap fires only on
/// its first occurrence when the schedule pins the hour, and on both occurrences when it
/// runs every hour (`0 * * * *`), so the real-time spacing is kept.
pub fn next_after_in(s: cron.Schedule, z: tz.Zone, ms: int) -> Result<int, string> {
    // La búsqueda normal: el cursor civil arranca en la hora local de `ms` y el solape de
    // otoño cuenta solo su primera ocurrencia.
    let main = civil_search(s, z, ms, ms + tz.offset_at(z, ms))?;
    if (!every_hour(s)) {
        return Result.Ok(main);
    }
    // M416 (raycron #202): schedule horario. Si estamos en las horas previas a un retraso del
    // reloj (otoño), la SEGUNDA pasada de la hora repetida también dispara: se busca con el
    // cursor civil retrasado al offset de después del cambio, aceptando solo segundas
    // ocurrencias (`Ambiguous(_, b)` con `b > ms`), y gana la más temprana.
    let later = tz.offset_at(z, ms + 3 * 3600000);
    let current = tz.offset_at(z, ms);
    if (later >= current) {
        return Result.Ok(main);
    }
    var naive = ms + later;
    let limit = ms + current;
    var guard = 0;
    while (guard < 240) {
        let cand = cron.next_after(s, naive)?;
        if (cand > limit) {
            return Result.Ok(main);
        }
        match (tz.to_utc(z, time.from_epoch_millis(cand))) {
            tz.LocalResult.Ambiguous(a, b) => {
                if (b > ms && b < main) {
                    return Result.Ok(b);
                }
            },
            tz.LocalResult.Single(t) => { },
            tz.LocalResult.Gap => { },
        }
        naive = cand;
        guard = guard + 1;
    }
    Result.Ok(main)
}

// La búsqueda civil desde el cursor `naive` (hora local ingenua): el matcher puro avanza en
// tiempo civil y cada candidato se resuelve a UTC con la política del hueco y del solape
// (primera ocurrencia).
fn civil_search(s: cron.Schedule, z: tz.Zone, ms: int, start: int) -> Result<int, string> {
    var naive = start;
    var guard = 0;
    while (guard < 8) {
        let cand = cron.next_after(s, naive)?;  // el matcher puro, sobre el civil local
        let civil = time.from_epoch_millis(cand);
        match (tz.to_utc(z, civil)) {
            tz.LocalResult.Single(t) => {
                if (t > ms) {
                    return Result.Ok(t);
                }
            },
            tz.LocalResult.Ambiguous(a, b) => {
                // Solo la PRIMERA ocurrencia; si ya pasó, este disparo civil ya corrió
                // (la segunda, para los horarios, la aporta `next_after_in`).
                if (a > ms) {
                    return Result.Ok(a);
                }
            },
            tz.LocalResult.Gap => {
                // La hora civil no existe: dispara al acabar el hueco (el primer minuto
                // civil válido después; un hueco real dura minutos u horas, acotamos).
                var c2 = cand + 60000;
                var step = 0;
                while (step < 240) {
                    match (tz.to_utc(z, time.from_epoch_millis(c2))) {
                        tz.LocalResult.Single(t2) => {
                            if (t2 > ms) {
                                return Result.Ok(t2);
                            }
                            step = 240;  // válido pero pasado: fuera del hueco, aborta el escaneo
                        },
                        tz.LocalResult.Ambiguous(a2, b2) => {
                            if (a2 > ms) {
                                return Result.Ok(a2);
                            }
                            step = 240;
                        },
                        tz.LocalResult.Gap => { },
                    }
                    c2 = c2 + 60000;
                    step = step + 1;
                }
            },
        }
        naive = cand;
        guard = guard + 1;
    }
    Result.Err("cron: no trigger found in local time (impossible expression?)")
}

// ¿Corre el schedule a cada hora (campo hora = `*`)? Entonces el solape de otoño dispara dos veces.
fn every_hour(s: cron.Schedule) -> bool {
    var i = 0;
    while (i < s.hours.len()) {
        if (!s.hours[i]) {
            return false;
        }
        i = i + 1;
    }
    true
}

// Corre `job` en cada disparo LOCAL de `s` en la zona `z`, para siempre (cede la fibra
// entre disparos). Úsese dentro de un `spawn`.
/// Runs `job` at every LOCAL fire time of the schedule in zone `z`, forever, sleeping
/// cooperatively between fires — call it inside `spawn`.
pub fn run_in(s: cron.Schedule, z: tz.Zone, job: fn()) {
    var alive = true;
    while (alive) {
        match (next_after_in(s, z, time.now())) {
            Result.Ok(t) => {
                let delta = t - time.now();
                if (delta > 0) {
                    time.sleep(delta);
                }
                job();
            },
            Result.Err(e) => {
                alive = false;
            },
        }
    }
}
