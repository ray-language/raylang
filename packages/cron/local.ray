// packages/cron/local.ray — cron en HORA LOCAL (M86b), sobre packages/tz.
//
// Módulo SEPARADO de cron/cron a propósito: el cron UTC no arrastra la dependencia de
// tz. El consumidor que quiera hora local declara AMBOS paquetes (cron y tz, hermanos
// de path o del índice) e importa `cron/local`.
//
// Política DST (IDEAS §42; M416 afina el solape con la de raycron #202; raycron #226 la arregla):
// - una hora civil que cae en el HUECO de primavera (no existe) dispara al TERMINAR el
//   hueco — la primera hora local válida;
// - una hora civil del SOLAPE de otoño (ocurre dos veces) dispara solo la PRIMERA vez si
//   el schedule fija la hora (`30 2 * * *`: «a las 2:30» es un evento del día), y en LAS
//   DOS pasadas si corre cada hora (`0 * * * *`, `*/15 * * * *`): así el espaciado se
//   mantiene en tiempo real (sin un hueco de dos horas la noche del cambio).
import cron/cron;
import tz/tz;
import std/time;

// El siguiente disparo del schedule en la hora CIVIL de la zona, como instante UTC
// (epoch-ms), estrictamente posterior a `ms`.
/// The next fire time of the schedule evaluated in the zone's CIVIL local time, as a UTC instant
/// (epoch-ms) strictly after `ms`. DST policy, one rule for every schedule:
/// - a civil time in the spring-forward GAP (it never happens) fires once, when the gap ends;
/// - a civil time in the fall-back OVERLAP (it happens twice) fires on its first occurrence and,
///   only when the schedule runs every hour (hour field `*`: `0 * * * *`, `*/15 * * * *`), also on
///   the second, so the real-time spacing is kept; a schedule that pins the hour (`30 2 * * *`)
///   fires once.
pub fn next_after_in(s: cron.Schedule, z: tz.Zone, ms: int) -> Result<int, string> {
    let hourly = every_hour(s);
    // raycron #226: los offsets de la ventana (un día a cada lado cubre cualquier cambio cercano).
    // Un disparo `t > ms` viene de un minuto civil `c` con `c - off = t`, así que basta mirar los
    // `c` desde `ms + off_min`; y como cada disparo es `>= c - off_max`, en cuanto `c - off_max`
    // supera al mejor encontrado no hay uno más temprano.
    let o1 = tz.offset_at(z, ms - 86400000);
    let o2 = tz.offset_at(z, ms);
    let o3 = tz.offset_at(z, ms + 86400000);
    let off_min = min3(o1, o2, o3);
    let off_max = max3(o1, o2, o3);
    var civil = ms + off_min - 60000;
    var best = -1;
    var guard = 0;
    while (guard < 5000) {
        let cand = cron.next_after(s, civil)?;
        if (best >= 0 && cand - off_max > best) {
            return Result.Ok(best);
        }
        best = earliest_after(fires_of(z, cand, hourly), ms, best);
        civil = cand;
        guard = guard + 1;
    }
    if (best >= 0) {
        return Result.Ok(best);
    }
    Result.Err("cron: no trigger found in local time (impossible expression?)")
}

// Los instantes UTC en que dispara el minuto civil `cand` según la política de la zona.
fn fires_of(z: tz.Zone, cand: int, hourly: bool) -> [int] {
    match (tz.to_utc(z, time.from_epoch_millis(cand))) {
        tz.LocalResult.Single(t) => [t],
        tz.LocalResult.Ambiguous(a, b) => if (hourly) {
            [a, b]
        } else {
            [a]
        },
        tz.LocalResult.Gap => {
            // No existe: dispara al acabar el hueco, el primer minuto civil válido después (un hueco
            // real dura minutos u horas; se acota a un día).
            var c2 = cand + 60000;
            var step = 0;
            while (step < 1440) {
                match (tz.to_utc(z, time.from_epoch_millis(c2))) {
                    tz.LocalResult.Single(t2) => {
                        return [t2];
                    },
                    tz.LocalResult.Ambiguous(a2, b2) => {
                        return [a2];
                    },
                    tz.LocalResult.Gap => { },
                }
                c2 = c2 + 60000;
                step = step + 1;
            }
            []
        },
    }
}

// El menor de `fires` estrictamente posterior a `ms`, comparado con `best` (-1 = ninguno aún).
fn earliest_after(fires: [int], ms: int, best: int) -> int {
    var b = best;
    for t in fires {
        if (t > ms && (b < 0 || t < b)) {
            b = t;
        }
    }
    b
}

fn min3(a: int, b: int, c: int) -> int {
    var m = a;
    if (b < m) {
        m = b;
    }
    if (c < m) {
        m = c;
    }
    m
}

fn max3(a: int, b: int, c: int) -> int {
    var m = a;
    if (b > m) {
        m = b;
    }
    if (c > m) {
        m = c;
    }
    m
}

// ¿Corre el schedule a cada hora (campo hora = `*`)? Entonces el solape de otoño dispara dos veces.
fn every_hour(s: cron.Schedule) -> bool {
    var i = 0;
    while (i < s.hours.len()) {
        if (!s.hours[i]) {
            return false;
        }
        i = i + 1;
    }
    true
}

// Corre `job` en cada disparo LOCAL de `s` en la zona `z`, para siempre (cede la fibra
// entre disparos). Úsese dentro de un `spawn`.
/// Runs `job` at every LOCAL fire time of the schedule in zone `z`, forever, sleeping
/// cooperatively between fires — call it inside `spawn`.
pub fn run_in(s: cron.Schedule, z: tz.Zone, job: fn()) {
    var alive = true;
    while (alive) {
        match (next_after_in(s, z, time.now())) {
            Result.Ok(t) => {
                let delta = t - time.now();
                if (delta > 0) {
                    time.sleep(delta);
                }
                job();
            },
            Result.Err(e) => {
                alive = false;
            },
        }
    }
}
