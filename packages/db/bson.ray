// BSON (M54.1) — el formato de documentos de MongoDB (bsonspec.org), en raylang puro.
//
// Un documento BSON es: [longitud total: int32 LE][elementos…][0x00], y cada elemento es
// [tipo: 1 octeto][nombre: cstring][valor]. La representación en raylang es el enum recursivo
// `Bson` + `Field` (nombre → valor); la superficie es `encode(doc) -> bytes` y
// `decode(bytes) -> Result<[Field], string>` (errores como valores, con la posición del octeto).
//
// Decisiones v1 (plan M54, IDEAS §15):
//   - `Int` único: se CODIFICA como int64 (0x12) y se DECODIFICAN ambos (int32 0x10 e int64) a
//     `Int` — el int de raylang es i64; el servidor acepta int64 donde acepta int32. La fidelidad
//     de round-trip es semántica, no de octetos.
//   - `Double` usa los bits IEEE 754 (`float_bits`/`float_from_bits` de std/math, M54.1a). Es
//     obligatorio para un cliente: el propio servidor responde `{ ok: 1.0 }` como double.
//   - `Bin` es el binario genérico (subtipo 0). Cualquier otro subtipo (UUID 4, el antiguo 2, MD5…)
//     es `BinSub(subtipo, octetos)` al decodificar y al codificar (raycdc #402, db 0.9.0; antes el
//     subtipo se descartaba y todo volvía como `Bin`).
//   - `Date` (0x09, epoch-ms) y `Timestamp` (0x11, interno) soportados.
//   - `Decimal128` (0x13) lleva sus 16 octetos tal cual (IEEE 754-2008 BID, little-endian);
//     `decimal128_to_string` / `decimal128_from_string` lo pasan a texto y de vuelta sin perder
//     dígitos. Los no soportados (Regex, …) → error claro al decodificar.
//
// Gramática (recordatorios): el enum recursivo va por el heap ([Field]/[Bson]); los enteros LE
// se arman por mitades de 32 bits (b7<<56 desbordaría i64; hi*2^32+lo es exacto y total).
import std/math;
import std/collections/bytesbuilder;
from std/collections/bytesbuilder import BytesBuilder;
from std/json import Json, parse;
from net/time import from_epoch_millis, to_iso8601;

/// A BSON value. `Doc` and `Arr` are recursive; `ObjectId` carries the raw 12 bytes.
pub enum Bson {
    Double(float),
    Str(string),
    Doc([Field]),
    Arr([Bson]),
    Bin(bytes),
    ObjectId(bytes),
    Bool(bool),
    Null,
    Int(int),
    /// UTC datetime: milliseconds since the Unix epoch (BSON type 0x09). What MongoDB stores
    /// for date fields; `dump` renders it as ISO 8601.
    Date(int),
    /// MongoDB's internal timestamp (type 0x11): `(seconds << 32) | counter`, kept raw
    /// (it is for replication/oplog bookkeeping, not a wall-clock value).
    Timestamp(int),
    /// A 32-bit integer (type 0x10) for ENCODING only — what commands like `saslContinue`
    /// (`conversationId`) demand on MongoDB 6+. Decoded int32 values still come back as `Int`.
    Int32(int),
    /// Binary data with a subtype other than 0 (type 0x05): `BinSub(4, uuid_bytes)` is a UUID,
    /// 2 the legacy binary, 5 an MD5. `Bin(b)` stays the generic subtype 0; decoding yields
    /// `BinSub` for every other subtype (before db 0.9.0 the subtype was dropped).
    BinSub(int, bytes),
    /// A `NumberDecimal` (type 0x13): the 16 raw octets of an IEEE 754-2008 decimal128 (BID,
    /// little-endian, as on the wire). `decimal128_to_string` gives its text (`"12.50"`) and
    /// `decimal128_from_string` builds one; `dump` shows `decimal(12.50)`.
    Decimal128(bytes),
    /// A document that is ALREADY encoded (the bytes `encode` returns), for ENCODING only: it is
    /// embedded as it is, as a sub-document (type 0x03), without decoding and encoding it again —
    /// what a writer that encodes each row once and then batches them needs (db 0.10.1, raycdc
    /// #471). Decoding never yields it: a sub-document comes back as `Doc`.
    Raw(bytes),
}

/// One element of a document: a name and its value.
pub struct Field {
    name: string,
    value: Bson,
}

/// Builds a `Field` (sugar for the struct literal, reads better in call chains).
pub fn field(name: string, value: Bson) -> Field {
    Field { name: name, value: value }
}

/// Looks up a field by name (first match). The reply-inspection workhorse of the MongoDB client.
pub fn get(fields: [Field], name: string) -> Option<Bson> {
    var i = 0;
    while (i < fields.len()) {
        if (fields[i].name == name) {
            return Option.Some(fields[i].value);
        }
        i = i + 1;
    }
    Option.None
}

// ── Codificación ─────────────────────────────────────────────────────────────
// El octeto de tipo de cada variante (bsonspec.org §element).
fn type_byte(v: Bson) -> int {
    return match (v) {
        Bson.Double(_) => 1,
        Bson.Str(_) => 2,
        Bson.Doc(_) => 3,
        Bson.Arr(_) => 4,
        Bson.Bin(_) => 5,
        Bson.ObjectId(_) => 7,
        Bson.Bool(_) => 8,
        Bson.Null => 10,
        Bson.Int(_) => 18,
        Bson.Date(_) => 9,
        Bson.Timestamp(_) => 17,
        Bson.Int32(_) => 16,
        Bson.BinSub(_, _) => 5,
        Bson.Decimal128(_) => 19,
        Bson.Raw(_) => 3,
    };
}

// raycdc #402: el codificador escribe sobre un `BytesBuilder`. Antes armaba un `[int]` octeto a
// octeto (2375 ms frente a 148 ms en la VM para 2000 documentos de 10,9 KB): un string o un binario
// entran ahora como UN trozo.
fn enc_le32(out: BytesBuilder, n: int) {
    bytesbuilder.push_byte(out, n);
    bytesbuilder.push_byte(out, n >> 8);
    bytesbuilder.push_byte(out, n >> 16);
    bytesbuilder.push_byte(out, n >> 24);
}

fn enc_le64(out: BytesBuilder, n: int) {
    var i = 0;
    while (i < 8) {
        bytesbuilder.push_byte(out, n >> 8 * i);
        i = i + 1;
    }
}

// Un cstring: los octetos UTF-8 + el terminador 0. (BSON prohíbe 0x00 dentro de un nombre;
// no lo validamos: un nombre raylang legítimo no lo trae.)
fn enc_cstring(out: BytesBuilder, s: string) {
    bytesbuilder.push(out, s.to_bytes());
    bytesbuilder.push_byte(out, 0);
}

fn enc_binary(out: BytesBuilder, subtype: int, b: bytes) {
    // binary: int32 longitud + subtipo + octetos.
    enc_le32(out, b.len());
    bytesbuilder.push_byte(out, subtype);
    bytesbuilder.push(out, b);
}

fn enc_value(out: BytesBuilder, v: Bson) {
    match (v) {
        Bson.Double(f) => {
            enc_le64(out, math.float_bits(f));
        },
        Bson.Str(s) => {
            // string: int32 (longitud en octetos + 1) + UTF-8 + 0x00.
            let bs = s.to_bytes();
            enc_le32(out, bs.len() + 1);
            bytesbuilder.push(out, bs);
            bytesbuilder.push_byte(out, 0);
        },
        Bson.Doc(fields) => {
            bytesbuilder.push(out, enc_doc(fields));
        },
        Bson.Arr(items) => {
            // Un arreglo ES un documento con claves "0", "1", … (así lo define el spec).
            var fields: [Field] = [];
            var i = 0;
            while (i < items.len()) {
                fields.push(Field { name: to_string(i), value: items[i] });
                i = i + 1;
            }
            bytesbuilder.push(out, enc_doc(fields));
        },
        Bson.Bin(b) => {
            enc_binary(out, 0, b);
        },
        Bson.BinSub(subtype, b) => {
            if (subtype < 0 || subtype > 255) {
                panic("a BSON binary subtype is one octet (0..255), not " + to_string(subtype));
            }
            enc_binary(out, subtype, b);
        },
        Bson.ObjectId(b) => {
            // 12 octetos exactos; menos/más es un error del programador, no un dato → panic.
            if (b.len() != 12) {
                panic("ObjectId must have 12 bytes, has " + to_string(b.len()));
            }
            bytesbuilder.push(out, b);
        },
        Bson.Decimal128(b) => {
            if (b.len() != 16) {
                panic("Decimal128 must have 16 bytes, has " + to_string(b.len()));
            }
            bytesbuilder.push(out, b);
        },
        Bson.Raw(b) => {
            // Un documento codificado lleva su longitud en los 4 primeros octetos y acaba en 0x00.
            let declared = if (b.len() >= 5) {
                b[0] | b[1] << 8 | b[2] << 16 | b[3] << 24
            } else {
                0 - 1
            };
            if (declared != b.len() || b[b.len() - 1] != 0) {
                panic(
                    "Bson.Raw must hold one encoded document ("
                        + to_string(b.len())
                        + " bytes given)"
                );
            }
            bytesbuilder.push(out, b);
        },
        Bson.Bool(x) => {
            bytesbuilder.push_byte(out, if (x) { 1 } else { 0 });
        },
        Bson.Null => { },
        Bson.Int(n) => {
            enc_le64(out, n);
        },
        Bson.Date(ms) => {
            enc_le64(out, ms);
        },
        Bson.Int32(n) => {
            enc_le32(out, n);
        },
        Bson.Timestamp(t) => {
            enc_le64(out, t);
        },
    }
}

// Codifica un documento completo (la longitud va delante, así que el cuerpo se arma aparte).
fn enc_doc(fields: [Field]) -> bytes {
    let body = bytesbuilder.new();
    var i = 0;
    while (i < fields.len()) {
        let f = fields[i];
        bytesbuilder.push_byte(body, type_byte(f.value));
        enc_cstring(body, f.name);
        enc_value(body, f.value);
        i = i + 1;
    }
    // longitud total = 4 (la propia longitud) + cuerpo + 1 (el 0x00 final).
    let out = bytesbuilder.new();
    enc_le32(out, bytesbuilder.len(body) + 5);
    bytesbuilder.push(out, bytesbuilder.build(body));
    bytesbuilder.push_byte(out, 0);
    bytesbuilder.build(out)
}

/// Encodes a document (a list of fields) as BSON bytes.
pub fn encode(fields: [Field]) -> bytes {
    enc_doc(fields)
}

// ── Decodificación ───────────────────────────────────────────────────────────
// El cursor de lectura; se muta por referencia (semántica de referencia de structs).
struct Dec {
    b: bytes,
    pos: int,
}

fn dec_err(msg: string, pos: int) -> string {
    "invalid BSON (byte " + to_string(pos) + "): " + msg
}

// Tope de anidamiento al decodificar. Un documento con documentos/arreglos anidados sin fin
// (0x03/0x04 recursivos) haría que `rd_doc`/`rd_value` recurran hasta agotar la pila del proceso
// → un servidor malicioso/roto podría tumbar al cliente con una respuesta pequeña. Se rechaza como
// valor (`Err`) en cuanto se cruza. 200 supera con holgura el límite propio de MongoDB (~100) y se
// queda muy por debajo de la profundidad de pila de raylang.
fn max_depth() -> int {
    200
}

fn rd_u8(d: Dec) -> Result<int, string> {
    if (d.pos >= d.b.len()) {
        return Result.Err(dec_err("unexpected end of data", d.pos));
    }
    let v = d.b[d.pos];
    d.pos = d.pos + 1;
    Result.Ok(v)
}

fn rd_exact(d: Dec, n: int) -> Result<bytes, string> {
    if (d.pos + n > d.b.len()) {
        return Result.Err(
            dec_err("unexpected end of data (missing " + to_string(n) + " bytes)", d.pos)
        );
    }
    let out = d.b.sub_bytes(d.pos, d.pos + n);
    d.pos = d.pos + n;
    Result.Ok(out)
}

// int32 LE con signo (complemento a dos).
fn rd_le32(d: Dec) -> Result<int, string> {
    let bs = rd_exact(d, 4)?;
    var v = bs[0] | bs[1] << 8 | bs[2] << 16 | bs[3] << 24;
    if (v >= 2147483648) {
        v = v - 4294967296;
    }
    Result.Ok(v)
}

// int64 LE con signo. Por mitades: hi (int32 con signo) * 2^32 + lo (sin signo) es exacto y
// total; armarlo con b[7] << 56 desbordaría el i64.
fn rd_le64(d: Dec) -> Result<int, string> {
    let bs = rd_exact(d, 8)?;
    let lo = bs[0] | bs[1] << 8 | bs[2] << 16 | bs[3] << 24;
    var hi = bs[4] | bs[5] << 8 | bs[6] << 16 | bs[7] << 24;
    if (hi >= 2147483648) {
        hi = hi - 4294967296;
    }
    Result.Ok(hi * 4294967296 + lo)
}

// cstring: octetos hasta el 0x00 (excluido), decodificados como UTF-8.
fn rd_cstring(d: Dec) -> Result<string, string> {
    var end = d.pos;
    while (end < d.b.len() && d.b[end] != 0) {
        end = end + 1;
    }
    if (end >= d.b.len()) {
        return Result.Err(dec_err("cstring without terminator", d.pos));
    }
    let raw = d.b.sub_bytes(d.pos, end);
    d.pos = end + 1;
    return match (from_utf8(raw)) {
        Result.Ok(s) => Result.Ok(s),
        Result.Err(_) => Result.Err(dec_err("cstring is not valid UTF-8", d.pos)),
    };
}

fn rd_string(d: Dec) -> Result<string, string> {
    let start = d.pos;
    let n = rd_le32(d)?;
    if (n < 1) {
        return Result.Err(dec_err("invalid string length: " + to_string(n), start));
    }
    let raw = rd_exact(d, n)?;
    if (raw[n - 1] != 0) {
        return Result.Err(dec_err("string without 0x00 terminator", start));
    }
    return match (from_utf8(raw.sub_bytes(0, n - 1))) {
        Result.Ok(s) => Result.Ok(s),
        Result.Err(_) => Result.Err(dec_err("string is not valid UTF-8", start)),
    };
}

fn rd_value(d: Dec, t: int, depth: int) -> Result<Bson, string> {
    if (t == 1) {
        let bits = rd_le64(d)?;
        return Result.Ok(Bson.Double(math.float_from_bits(bits)));
    }
    if (t == 2) {
        let s = rd_string(d)?;
        return Result.Ok(Bson.Str(s));
    }
    if (t == 3) {
        let fields = rd_doc(d, depth + 1)?;
        return Result.Ok(Bson.Doc(fields));
    }
    if (t == 4) {
        // Un arreglo llega como documento con claves "0", "1", …: se descartan los nombres
        // (el spec exige ese orden; confiamos en el emisor, como los drivers oficiales).
        let fields = rd_doc(d, depth + 1)?;
        var items: [Bson] = [];
        var i = 0;
        while (i < fields.len()) {
            items.push(fields[i].value);
            i = i + 1;
        }
        return Result.Ok(Bson.Arr(items));
    }
    if (t == 5) {
        let start = d.pos;
        let n = rd_le32(d)?;
        if (n < 0) {
            return Result.Err(dec_err("negative binary length", start));
        }
        let subtype = rd_u8(d)?;
        let raw = rd_exact(d, n)?;
        if (subtype == 0) {
            return Result.Ok(Bson.Bin(raw));
        }
        return Result.Ok(Bson.BinSub(subtype, raw));
    }
    if (t == 7) {
        let raw = rd_exact(d, 12)?;
        return Result.Ok(Bson.ObjectId(raw));
    }
    if (t == 8) {
        let v = rd_u8(d)?;
        return Result.Ok(Bson.Bool(v != 0));
    }
    if (t == 10) {
        return Result.Ok(Bson.Null);
    }
    if (t == 16) {
        let v = rd_le32(d)?;
        return Result.Ok(Bson.Int(v));
    }
    if (t == 18) {
        let v = rd_le64(d)?;
        return Result.Ok(Bson.Int(v));
    }
    if (t == 9) {
        let ms = rd_le64(d)?;
        return Result.Ok(Bson.Date(ms));
    }
    if (t == 17) {
        let v = rd_le64(d)?;
        return Result.Ok(Bson.Timestamp(v));
    }
    if (t == 19) {
        let raw = rd_exact(d, 16)?;
        return Result.Ok(Bson.Decimal128(raw));
    }
    Result.Err(dec_err("unsupported BSON type: " + to_string(t), d.pos - 1))
}

fn rd_doc(d: Dec, depth: int) -> Result<[Field], string> {
    if (depth > max_depth()) {
        return Result.Err(
            dec_err(
                "nesting too deep (possible DoS): more than " + to_string(max_depth()) + " levels",
                d.pos
            )
        );
    }
    let start = d.pos;
    let total = rd_le32(d)?;
    if (total < 5 || start + total > d.b.len()) {
        return Result.Err(dec_err("invalid document length: " + to_string(total), start));
    }
    let end = start + total;
    var fields: [Field] = [];
    while (d.pos < end - 1) {
        let t = rd_u8(d)?;
        let name = rd_cstring(d)?;
        let v = rd_value(d, t, depth)?;
        fields.push(Field { name: name, value: v });
    }
    let term = rd_u8(d)?;
    if (term != 0) {
        return Result.Err(dec_err("document without the final 0x00", end - 1));
    }
    Result.Ok(fields)
}

/// Decodes BSON bytes into a document. Fails as a value (`Result.Err` with the byte offset)
/// on truncated data, bad lengths, or unsupported types.
pub fn decode(b: bytes) -> Result<[Field], string> {
    var d = Dec { b: b, pos: 0 };
    let fields = rd_doc(d, 0)?;
    if (d.pos != b.len()) {
        return Result.Err(dec_err("leftover data after the document", d.pos));
    }
    Result.Ok(fields)
}

// ── Decimal128 (IEEE 754-2008, BID) ──────────────────────────────────────────
//
// 128 bits, little-endian en el cable: signo (bit 127), exponente con sesgo 6176 (14 bits) y
// coeficiente entero de hasta 34 dígitos (113 bits). El coeficiente no cabe en un `int`: se
// trata como 15 octetos (los 14 bajos y el bit 112) y se divide/multiplica por 10 a mano.
const DECIMAL_BIAS: int = 6176;

const DECIMAL_DIGITS: int = 34;

// Los dígitos decimales de un entero sin signo dado por sus octetos big-endian ("0" si es cero).
fn magnitude_digits(big_endian: [int]) -> string {
    var n = big_endian;
    var digits: [int] = [];
    var nonzero = true;
    while (nonzero) {
        var rem = 0;
        nonzero = false;
        var i = 0;
        while (i < n.len()) {
            let cur = rem * 256 + n[i];
            n[i] = cur / 10;
            rem = cur % 10;
            if (n[i] != 0) {
                nonzero = true;
            }
            i = i + 1;
        }
        digits.push(rem);
    }
    var s = "";
    var k = digits.len() - 1;
    while (k >= 0) {
        s = s + to_string(digits[k]);
        k = k - 1;
    }
    s
}

/// The text of a decimal128 (the 16 octets of a `Bson.Decimal128`), as MongoDB prints a
/// `NumberDecimal`: `12.50`, `-0.001`, `1E+3`, `1.234E-10`, `Infinity`, `-Infinity`, `NaN`. Every
/// digit is kept (the trailing zeros too). Anything that is not 16 octets gives `"NaN"`.
pub fn decimal128_to_string(b: bytes) -> string {
    if (b.len() != 16) {
        return "NaN";
    }
    let top = b[15];
    let sign = if ((top & 128) != 0) { "-" } else { "" };
    var exponent = 0;
    var digits = "0";
    if ((top >> 5 & 3) == 3) {
        let special = top >> 2 & 31;
        if (special == 30) {
            return sign + "Infinity";
        }
        if (special == 31) {
            return "NaN";
        }
        // La forma con el coeficiente por encima de 2^113 no es canónica: vale cero.
        exponent = ((top & 31) << 9 | b[14] << 1 | b[13] >> 7) - DECIMAL_BIAS;
    } else {
        exponent = ((top & 127) << 7 | b[14] >> 1) - DECIMAL_BIAS;
        var magnitude: [int] = [b[14] & 1];
        var i = 13;
        while (i >= 0) {
            magnitude.push(b[i]);
            i = i - 1;
        }
        digits = magnitude_digits(magnitude);
        if (digits.len() > DECIMAL_DIGITS) {
            // Más de 34 dígitos tampoco es canónico: cero.
            digits = "0";
        }
    }
    let adjusted = exponent + digits.len() - 1;
    if (exponent > 0 || adjusted < 0 - 6) {
        // Notación científica: un dígito, el resto tras el punto y el exponente ajustado.
        var out = sign + digits.substring(0, 1);
        if (digits.len() > 1) {
            out = out + "." + digits.substring(1, digits.len());
        }
        return out + "E" + if (adjusted >= 0) { "+" } else { "" } + to_string(adjusted);
    }
    if (exponent == 0) {
        return sign + digits;
    }
    let point = digits.len() + exponent;
    if (point > 0) {
        return sign + digits.substring(0, point) + "." + digits.substring(point, digits.len());
    }
    var zeros = "";
    var z = point;
    while (z < 0) {
        zeros = zeros + "0";
        z = z + 1;
    }
    sign + "0." + zeros + digits
}

/// Builds the 16 octets of a decimal128 from its text: an optional sign, digits with an
/// optional decimal point and an optional exponent (`"12.50"`, `"-0.001"`, `"1E+3"`, `"1.5e-7"`),
/// or `Infinity` / `-Infinity` / `NaN`. Exact: `Err` when the number has more than 34 significant
/// digits or does not fit the exponent range, instead of rounding.
/// `Bson.Decimal128(decimal128_from_string("12.50")?)` is `NumberDecimal("12.50")`.
pub fn decimal128_from_string(text: string) -> Result<bytes, string> {
    let invalid = "invalid decimal128: '" + text + "'";
    var out: [int] = [];
    var i = 0;
    while (i < 16) {
        out.push(0);
        i = i + 1;
    }
    var s = text.trim();
    var negative = false;
    if (s.starts_with("-")) {
        negative = true;
        s = s.substring(1, s.len());
    } else if (s.starts_with("+")) {
        s = s.substring(1, s.len());
    }
    let lower = s.to_lower();
    if (lower == "infinity" || lower == "inf") {
        out[15] = if (negative) { 248 } else { 120 };
        return Result.Ok(bytes_of(out));
    }
    if (lower == "nan") {
        out[15] = 124;
        return Result.Ok(bytes_of(out));
    }
    // Mantisa y exponente.
    var mantissa = lower;
    var exponent = 0;
    match (lower.index_of("e")) {
        Option.Some(at) => {
            mantissa = lower.substring(0, at);
            var exp_text = lower.substring(at + 1, lower.len());
            if (exp_text.starts_with("+")) {
                exp_text = exp_text.substring(1, exp_text.len());
            }
            match (parse_int(exp_text)) {
                Option.Some(e) => {
                    exponent = e;
                },
                Option.None => {
                    return Result.Err(invalid);
                },
            }
        },
        Option.None => { },
    }
    var digits = "";
    var seen_point = false;
    var seen_digit = false;
    var k = 0;
    while (k < mantissa.len()) {
        let c = mantissa[k];
        if (c == '.') {
            if (seen_point) {
                return Result.Err(invalid);
            }
            seen_point = true;
        } else if (c >= '0' && c <= '9') {
            seen_digit = true;
            // Los ceros a la izquierda no cuentan como dígitos significativos.
            if (digits != "" || c != '0') {
                digits = digits + to_string(c);
            }
            if (seen_point) {
                exponent = exponent - 1;
            }
        } else {
            return Result.Err(invalid);
        }
        k = k + 1;
    }
    if (!seen_digit) {
        return Result.Err(invalid);
    }
    // raycdc #470: los ceros finales no son cifras significativas — pasan al exponente
    // (`1234…234000` son 34 cifras × 10³, como lo guarda MongoDB). Solo si aún sobran, es `Err`.
    while (digits.len() > DECIMAL_DIGITS && digits.ends_with("0")) {
        digits = digits.substring(0, digits.len() - 1);
        exponent = exponent + 1;
    }
    if (digits.len() > DECIMAL_DIGITS) {
        return Result.Err(
            "decimal128 holds 34 significant digits, '" + text + "' has " + to_string(digits.len())
        );
    }
    // Un exponente fuera de -6176..6111 aún es exacto si el coeficiente lo absorbe: ceros a la
    // derecha hacia arriba (`1E+6112` = `10E+6111`) o quitándolos hacia abajo (`10E-6177`).
    if (digits == "") {
        if (exponent > 6111) {
            exponent = 6111;
        }
        if (exponent < 0 - DECIMAL_BIAS) {
            exponent = 0 - DECIMAL_BIAS;
        }
    }
    while (exponent > 6111 && digits.len() < DECIMAL_DIGITS) {
        digits = digits + "0";
        exponent = exponent - 1;
    }
    while (exponent < 0 - DECIMAL_BIAS && digits.ends_with("0")) {
        digits = digits.substring(0, digits.len() - 1);
        exponent = exponent + 1;
    }
    if (exponent < 0 - DECIMAL_BIAS || exponent > 6111) {
        return Result.Err(
            "decimal128 cannot hold '" + text + "' exactly: its exponent is out of range"
        );
    }
    // Coeficiente: out = out * 10 + dígito, sobre los octetos little-endian.
    var d = 0;
    while (d < digits.len()) {
        var carry = char_code(digits[d]) - 48;
        var j = 0;
        while (j < 15) {
            let cur = out[j] * 10 + carry;
            out[j] = cur & 255;
            carry = cur >> 8;
            j = j + 1;
        }
        d = d + 1;
    }
    // Exponente sesgado en los bits 113..126 y el signo en el 127.
    let biased = exponent + DECIMAL_BIAS << 1;
    out[14] = out[14] | biased & 255;
    out[15] = biased >> 8 & 127;
    if (negative) {
        out[15] = out[15] | 128;
    }
    Result.Ok(bytes_of(out))
}

// ── Puente Json ↔ Bson (diferido JSON-2) ─────────────────────────────────────
//
// La ergonomía de "armo mi filtro como string JSON" sin perder la fidelidad del enum. La
// degradación es EXPLÍCITA y solo en la dirección Bson → Json (JSON no puede representar
// ObjectId/Bin/int64): ver `to_json`.
/// Converts a JSON value to BSON. JSON numbers become `Double` (JSON has a single number type;
/// MongoDB compares ints and doubles numerically, so filters still match). Object keys come out
/// sorted (Json objects are Maps).
pub fn from_json(j: Json) -> Bson {
    return match (j) {
        Json.JNull => Bson.Null,
        Json.JBool(b) => Bson.Bool(b),
        Json.JNum(f) => Bson.Double(f),
        Json.JStr(s) => Bson.Str(s),
        Json.JArray(items) => {
            var out: [Bson] = [];
            var i = 0;
            while (i < items.len()) {
                out.push(from_json(items[i]));
                i = i + 1;
            }
            Bson.Arr(out)
        },
        Json.JObject(m) => {
            var fields: [Field] = [];
            let ks = m.keys();
            var i = 0;
            while (i < ks.len()) {
                match (m.get(ks[i])) {
                    Option.Some(v) => {
                        fields.push(Field { name: ks[i], value: from_json(v) });
                    },
                    Option.None => { },
                }
                i = i + 1;
            }
            Bson.Doc(fields)
        },
    };
}

/// Parses a JSON string straight into a BSON document — the ergonomic path for filters:
/// `mongo.find(c, coll, bson.doc_from_json("{\"nombre\": \"ada\"}")?)`. The top-level JSON
/// value must be an object.
pub fn doc_from_json(s: string) -> Result<[Field], string> {
    let j = parse(s)?;
    return match (from_json(j)) {
        Bson.Doc(fields) => Result.Ok(fields),
        _ => Result.Err("a document's JSON must be an object"),
    };
}

// int → float vía texto (exacto hasta 2^53; más allá redondea, la degradación documentada).
fn int_to_float(n: int) -> float {
    return match (parse_float(to_string(n))) {
        Option.Some(f) => f,
        Option.None => 0.0,
    };
}

/// Converts BSON to JSON, with documented degradation (JSON is the smaller type system):
/// `Int` becomes a JSON number (precision loss beyond 2^53), `ObjectId`, `Bin` and `BinSub` become
/// hex strings, `Decimal128` its decimal text (a string, to keep every digit), and `Doc` field order is lost (Json objects are Maps → keys sorted on output).
pub fn to_json(v: Bson) -> Json {
    return match (v) {
        Bson.Double(f) => Json.JNum(f),
        Bson.Str(s) => Json.JStr(s),
        Bson.Doc(fields) => Json.JObject(json_obj_of(fields)),
        Bson.Arr(items) => {
            var out: [Json] = [];
            var i = 0;
            while (i < items.len()) {
                out.push(to_json(items[i]));
                i = i + 1;
            }
            Json.JArray(out)
        },
        Bson.Bin(b) => Json.JStr(hex_of(b)),
        Bson.ObjectId(b) => Json.JStr(hex_of(b)),
        Bson.Bool(x) => Json.JBool(x),
        Bson.Null => Json.JNull,
        Bson.Int(n) => Json.JNum(int_to_float(n)),
        Bson.Date(ms) => Json.JStr(iso_ms(ms)),
        Bson.Timestamp(t) => Json.JNum(int_to_float(t)),
        Bson.Int32(n) => Json.JNum(int_to_float(n)),
        Bson.BinSub(_, b) => Json.JStr(hex_of(b)),
        Bson.Decimal128(b) => Json.JStr(decimal128_to_string(b)),
        Bson.Raw(b) => match (decode(b)) {
            Result.Ok(fields) => Json.JObject(json_obj_of(fields)),
            Result.Err(_) => Json.JNull,
        },
    };
}

fn json_obj_of(fields: [Field]) -> Map<string, Json> {
    var m: Map<string, Json> = Map.new();
    var i = 0;
    while (i < fields.len()) {
        m.insert(fields[i].name, to_json(fields[i].value));
        i = i + 1;
    }
    m
}

// ── Volcado para depuración/tests ────────────────────────────────────────────
fn hex_of(b: bytes) -> string {
    let digits = "0123456789abcdef";
    var s = "";
    var i = 0;
    while (i < b.len()) {
        s = s + to_string(digits[b[i] >> 4]) + to_string(digits[b[i] & 15]);
        i = i + 1;
    }
    s
}

/// Renders a value as compact JSON-ish text (deterministic; used by the tests' oracle).
pub fn dump(v: Bson) -> string {
    return match (v) {
        Bson.Double(f) => to_string(f),
        Bson.Str(s) => "\"" + s + "\"",
        Bson.Doc(fields) => dump_doc(fields),
        Bson.Arr(items) => {
            var s = "[";
            var i = 0;
            while (i < items.len()) {
                if (i > 0) {
                    s = s + ", ";
                }
                s = s + dump(items[i]);
                i = i + 1;
            }
            s + "]"
        },
        Bson.Bin(b) => "bin(" + hex_of(b) + ")",
        Bson.ObjectId(b) => "oid(" + hex_of(b) + ")",
        Bson.Bool(x) => to_string(x),
        Bson.Null => "null",
        Bson.Int(n) => to_string(n),
        Bson.Date(ms) => "date(" + iso_ms(ms) + ")",
        Bson.Timestamp(t) => "timestamp(" + to_string(t >> 32) + "," + to_string(t & 4294967295) + ")",
        Bson.Int32(n) => to_string(n),
        Bson.BinSub(subtype, b) => "bin(" + to_string(subtype) + ":" + hex_of(b) + ")",
        Bson.Decimal128(b) => "decimal(" + decimal128_to_string(b) + ")",
        Bson.Raw(b) => match (decode(b)) {
            Result.Ok(fields) => dump_doc(fields),
            Result.Err(_) => "raw(" + to_string(b.len()) + " bytes)",
        },
    };
}

// Un epoch-ms como ISO 8601 (con los milisegundos si los hay). Antes de 1970, el crudo.
fn iso_ms(ms: int) -> string {
    if (ms < 0) {
        return to_string(ms) + "ms";
    }
    let iso = to_iso8601(from_epoch_millis(ms));
    let rem = ms % 1000;
    if (rem == 0) {
        return iso;
    }
    // Los milisegundos van antes de la 'Z' final.
    return iso.substring(0, iso.len() - 1) + "." + pad3(rem) + "Z";
}

fn pad3(n: int) -> string {
    if (n < 10) {
        return "00" + to_string(n);
    }
    if (n < 100) {
        return "0" + to_string(n);
    }
    to_string(n)
}

/// Renders a whole document (see `dump`).
pub fn dump_doc(fields: [Field]) -> string {
    var s = "{";
    var i = 0;
    while (i < fields.len()) {
        if (i > 0) {
            s = s + ", ";
        }
        s = s + fields[i].name + ": " + dump(fields[i].value);
        i = i + 1;
    }
    s + "}"
}
