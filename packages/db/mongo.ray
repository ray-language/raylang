// Cliente MongoDB (M54.2) — conexión + autenticación, en raylang puro.
//
// El wire moderno es **OP_MSG** (opCode 2013, MongoDB ≥ 3.6):
//   [longitud total: int32 LE][requestID: int32][responseTo: int32][opCode: int32]
//   [flagBits: int32][kind: 1 octeto = 0][documento BSON]
// Todo comando es un documento BSON (db/bson) que incluye `$db`; toda respuesta es otro documento
// con `ok: 1.0` (¡un double! por eso BSON necesitaba float_bits) o `ok: 0.0` + `errmsg`.
//
// La autenticación es **SCRAM-SHA-256 vía SASL** (`saslStart`/`saslContinue`) — el MISMO mecanismo
// que PostgreSQL → se reusa `net/scram` tal cual (client-first/proof/verificación de la firma del
// servidor). Solo cambia el sobre: los mensajes SCRAM viajan como campo `payload` (binario) de un
// comando, no como mensajes propios del protocolo.
//
// v1 (plan M54, IDEAS §15): sin compresión (OP_COMPRESSED), sin checksum (flagBits = 0), una sola
// sección kind 0 por mensaje, `hello` mínimo (solo se exige `ok`). El CRUD llega en M54.3.

import db/bson;
from net/scram import scram_first, scram_client_first_message, scram_final, scram_verify, Scram;
import std/net;

/// An open, authenticated connection. Carries the read buffer (a reply may arrive split across
/// socket reads), the request-id counter, and the database name (stamped as `$db` on commands).
pub struct Conn {
    handle: int,
    buf: bytes,
    req_id: int,
    db: string,
}

// ── Enteros LE y framing ─────────────────────────────────────────────────────

fn le32_of(n: int) -> [int] {
    [n & 255, (n >> 8) & 255, (n >> 16) & 255, (n >> 24) & 255]
}

fn le32_at(b: bytes, off: int) -> int {
    b[off] | (b[off + 1] << 8) | (b[off + 2] << 16) | (b[off + 3] << 24)
}

fn bytes_to_ints(b: bytes) -> [int] {
    var out: [int] = [];
    var i = 0;
    while (i < b.len()) {
        out.push(b[i]);
        i = i + 1;
    }
    out
}

// Envía un comando como OP_MSG (una sección kind 0 con el documento).
fn send_msg(c: Conn, doc: [bson.Field]) -> Result<int, string> {
    let body = bson.encode(doc);
    // 16 (cabecera) + 4 (flags) + 1 (kind) + el documento.
    var m: [int] = le32_of(21 + body.len()) + le32_of(c.req_id) + le32_of(0) + le32_of(2013) + le32_of(0);
    m.push(0);
    m = m + bytes_to_ints(body);
    c.req_id = c.req_id + 1;
    net.socket_write_bytes(c.handle, bytes_of(m))
}

// Lee una respuesta OP_MSG COMPLETA (acumulando en el búfer) y decodifica su documento.
fn read_msg(c: Conn) -> Result<[bson.Field], string> {
    while (true) {
        if (c.buf.len() >= 4) {
            let total = le32_at(c.buf, 0);
            if (total < 21) {
                return Result.Err("mongo: mensaje demasiado corto (" + to_string(total) + " octetos)");
            }
            if (c.buf.len() >= total) {
                let op = le32_at(c.buf, 12);
                if (op != 2013) {
                    return Result.Err("mongo: opCode inesperado: " + to_string(op));
                }
                if (c.buf[20] != 0) {
                    return Result.Err("mongo: sección OP_MSG no soportada: " + to_string(c.buf[20]));
                }
                let raw = c.buf.sub_bytes(21, total);
                c.buf = c.buf.sub_bytes(total, c.buf.len());
                return bson.decode(raw);
            }
        }
        let chunk = net.socket_read_bytes(c.handle)?;
        if (chunk.len() == 0) {
            return Result.Err("mongo: el servidor cerró la conexión");
        }
        c.buf = c.buf + chunk;
    }
    Result.Err("inalcanzable")
}

/// Sends a raw command document and returns the reply document. The building block of every
/// operation; exposed for commands the client does not wrap.
pub fn run_command(c: Conn, doc: [bson.Field]) -> Result<[bson.Field], string> {
    let _ = send_msg(c, doc)?;
    read_msg(c)
}

// ── Inspección de respuestas ─────────────────────────────────────────────────

// ¿La respuesta trae ok: 1? (El servidor lo manda como double 1.0; se acepta también int.)
fn is_ok(fields: [bson.Field]) -> bool {
    return match (bson.get(fields, "ok")) {
        Option.Some(v) => match (v) {
            bson.Bson.Double(f) => f == 1.0,
            bson.Bson.Int(n) => n == 1,
            _ => false,
        },
        Option.None => false,
    };
}

// El errmsg de una respuesta fallida (o un genérico si no viene).
fn error_of(fields: [bson.Field]) -> string {
    return match (bson.get(fields, "errmsg")) {
        Option.Some(v) => match (v) {
            bson.Bson.Str(s) => s,
            _ => "error de MongoDB",
        },
        Option.None => "error de MongoDB",
    };
}

// El payload SASL (campo `payload`, binario) como texto.
fn payload_str(fields: [bson.Field]) -> Result<string, string> {
    return match (bson.get(fields, "payload")) {
        Option.Some(v) => match (v) {
            bson.Bson.Bin(b) => match (from_utf8(b)) {
                Result.Ok(s) => Result.Ok(s),
                Result.Err(_) => Result.Err("mongo: el payload SASL no es UTF-8"),
            },
            _ => Result.Err("mongo: la respuesta SASL no trae payload binario"),
        },
        Option.None => Result.Err("mongo: la respuesta SASL no trae payload"),
    };
}

// Un campo entero de la respuesta (0 si falta o no es entero): conversationId, n, nModified…
fn int_field(fields: [bson.Field], name: string) -> int {
    return match (bson.get(fields, name)) {
        Option.Some(v) => match (v) {
            bson.Bson.Int(n) => n,
            _ => 0,
        },
        Option.None => 0,
    };
}

// Valida `ok` y convierte el fallo en Result.Err con el errmsg del servidor.
fn check_ok(fields: [bson.Field]) -> Result<int, string> {
    if (!is_ok(fields)) {
        return Result.Err("mongo: " + error_of(fields));
    }
    Result.Ok(0)
}

// ── Conexión ─────────────────────────────────────────────────────────────────

/// Connects and authenticates with SCRAM-SHA-256 (`hello`, then `saslStart`/`saslContinue`).
/// The nonce must be random in production. Authenticates against `database`.
pub fn connect(host: string, port: int, user: string, password: string, database: string, nonce: string) -> Result<Conn, string> {
    let handle = net.tcp_connect(host, port)?;
    let c = Conn { handle: handle, buf: b"", req_id: 1, db: database };

    // 1. hello: presentación. v1 solo exige ok (sin negociar compresión/versiones).
    let hr = run_command(c, [
        bson.field("hello", bson.Bson.Int(1)),
        bson.field("$db", bson.Bson.Str(database)),
    ])?;
    if (!is_ok(hr)) {
        close(handle);
        return Result.Err("mongo: " + error_of(hr));
    }

    // 2. saslStart con el client-first de SCRAM (reusa net/scram, como PostgreSQL).
    let sc = scram_first(user, nonce);
    let cf = scram_client_first_message(sc);
    let r1 = run_command(c, [
        bson.field("saslStart", bson.Bson.Int(1)),
        bson.field("mechanism", bson.Bson.Str("SCRAM-SHA-256")),
        bson.field("payload", bson.Bson.Bin(cf.to_bytes())),
        bson.field("$db", bson.Bson.Str(database)),
    ])?;
    if (!is_ok(r1)) {
        close(handle);
        return Result.Err("mongo: " + error_of(r1));
    }
    let conv = int_field(r1, "conversationId");
    let server_first = match (payload_str(r1)) {
        Result.Ok(s) => s,
        Result.Err(e) => { close(handle); return Result.Err(e); },
    };

    // 3. saslContinue con el client-final (el proof calculado con la contraseña).
    let final_msg = match (scram_final(sc, password, server_first)) {
        Result.Ok(f) => f,
        Result.Err(e) => { close(handle); return Result.Err(e); },
    };
    let r2 = run_command(c, [
        bson.field("saslContinue", bson.Bson.Int(1)),
        bson.field("conversationId", bson.Bson.Int(conv)),
        bson.field("payload", bson.Bson.Bin(final_msg.to_bytes())),
        bson.field("$db", bson.Bson.Str(database)),
    ])?;
    if (!is_ok(r2)) {
        close(handle);
        return Result.Err("mongo: " + error_of(r2));
    }

    // 4. Verificar la firma del servidor (prueba que ÉL también conoce la credencial).
    let server_final = match (payload_str(r2)) {
        Result.Ok(s) => s,
        Result.Err(e) => { close(handle); return Result.Err(e); },
    };
    if (!scram_verify(sc, server_final)) {
        close(handle);
        return Result.Err("mongo: la firma del servidor no verifica (autenticación fallida)");
    }
    Result.Ok(c)
}

// ── CRUD (M54.3) ─────────────────────────────────────────────────────────────
//
// Cada operación es un comando (bsonspec + MongoDB command reference) sobre `run_command`; la
// colección va como valor del campo homónimo y `$db` sale de la `Conn`. Los filtros y documentos
// son `[bson.Field]` — el usuario arma `{$set: {...}}` y compañía explícitamente (fiel al
// protocolo, sin azúcar que esconda semántica).

/// Inserts documents into a collection; returns how many were inserted. Leave `_id` out and the
/// server assigns one.
pub fn insert(c: Conn, coll: string, docs: [[bson.Field]]) -> Result<int, string> {
    var arr: [bson.Bson] = [];
    var i = 0;
    while (i < docs.len()) {
        arr.push(bson.Bson.Doc(docs[i]));
        i = i + 1;
    }
    let r = run_command(c, [
        bson.field("insert", bson.Bson.Str(coll)),
        bson.field("documents", bson.Bson.Arr(arr)),
        bson.field("$db", bson.Bson.Str(c.db)),
    ])?;
    let _ = check_ok(r)?;
    Result.Ok(int_field(r, "n"))
}

// El documento `cursor` de una respuesta de find/getMore.
fn cursor_of(fields: [bson.Field]) -> Result<[bson.Field], string> {
    return match (bson.get(fields, "cursor")) {
        Option.Some(v) => match (v) {
            bson.Bson.Doc(f) => Result.Ok(f),
            _ => Result.Err("mongo: la respuesta no trae cursor"),
        },
        Option.None => Result.Err("mongo: la respuesta no trae cursor"),
    };
}

// Añade a `out` los documentos del batch `key` (firstBatch/nextBatch) del cursor.
fn append_batch(out: [[bson.Field]], cursor: [bson.Field], key: string) -> Result<int, string> {
    let batch = match (bson.get(cursor, key)) {
        Option.Some(v) => match (v) {
            bson.Bson.Arr(items) => items,
            _ => { return Result.Err("mongo: el cursor no trae " + key); },
        },
        Option.None => { return Result.Err("mongo: el cursor no trae " + key); },
    };
    var i = 0;
    while (i < batch.len()) {
        match (batch[i]) {
            bson.Bson.Doc(f) => { out.push(f); },
            _ => { return Result.Err("mongo: el batch trae un elemento que no es documento"); },
        }
        i = i + 1;
    }
    Result.Ok(0)
}

/// Finds every document matching the filter (`[]` = all). Exhausts the cursor: reads the
/// `firstBatch` and keeps issuing `getMore` until the server reports cursor id 0.
pub fn find(c: Conn, coll: string, filter: [bson.Field]) -> Result<[[bson.Field]], string> {
    let r = run_command(c, [
        bson.field("find", bson.Bson.Str(coll)),
        bson.field("filter", bson.Bson.Doc(filter)),
        bson.field("$db", bson.Bson.Str(c.db)),
    ])?;
    let _ = check_ok(r)?;
    var out: [[bson.Field]] = [];
    var cursor = cursor_of(r)?;
    let _ = append_batch(out, cursor, "firstBatch")?;
    // id != 0 = el cursor sigue vivo en el servidor: pedir el resto por rondas. (El id es un
    // int64 del wire — 0x12, justo lo que codifica nuestro Int.)
    var id = int_field(cursor, "id");
    while (id != 0) {
        let more = run_command(c, [
            bson.field("getMore", bson.Bson.Int(id)),
            bson.field("collection", bson.Bson.Str(coll)),
            bson.field("$db", bson.Bson.Str(c.db)),
        ])?;
        let _ = check_ok(more)?;
        cursor = cursor_of(more)?;
        let _ = append_batch(out, cursor, "nextBatch")?;
        id = int_field(cursor, "id");
    }
    Result.Ok(out)
}

/// Updates documents matching the filter with the update document (e.g. a `$set` doc);
/// returns how many were modified. `multi: true` updates every match, `false` only the first.
pub fn update(c: Conn, coll: string, filter: [bson.Field], u: [bson.Field], multi: bool) -> Result<int, string> {
    var arr: [bson.Bson] = [];
    arr.push(bson.Bson.Doc([
        bson.field("q", bson.Bson.Doc(filter)),
        bson.field("u", bson.Bson.Doc(u)),
        bson.field("multi", bson.Bson.Bool(multi)),
    ]));
    let r = run_command(c, [
        bson.field("update", bson.Bson.Str(coll)),
        bson.field("updates", bson.Bson.Arr(arr)),
        bson.field("$db", bson.Bson.Str(c.db)),
    ])?;
    let _ = check_ok(r)?;
    Result.Ok(int_field(r, "nModified"))
}

/// Deletes every document matching the filter; returns how many were deleted.
pub fn delete(c: Conn, coll: string, filter: [bson.Field]) -> Result<int, string> {
    var arr: [bson.Bson] = [];
    arr.push(bson.Bson.Doc([
        bson.field("q", bson.Bson.Doc(filter)),
        bson.field("limit", bson.Bson.Int(0)),
    ]));
    let r = run_command(c, [
        bson.field("delete", bson.Bson.Str(coll)),
        bson.field("deletes", bson.Bson.Arr(arr)),
        bson.field("$db", bson.Bson.Str(c.db)),
    ])?;
    let _ = check_ok(r)?;
    Result.Ok(int_field(r, "n"))
}

/// Closes the connection (no farewell message in the protocol; just the socket).
pub fn disconnect(c: Conn) {
    close(c.handle);
}
