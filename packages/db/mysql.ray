// Cliente MySQL (M53.1) — protocolo wire de MySQL sobre TCP, en raylang puro.
//
// Habla el protocolo cliente/servidor clásico (handshake v10 + COM_QUERY en protocolo de texto):
//   - Framing: paquetes de [longitud:3 LE][secuencia:1][carga].
//   - Auth: `mysql_native_password` (SHA1, completa) y `caching_sha2_password` — fast-path
//     (SHA256) por cualquier conexión, y full-path vía `connect_tls` (SSLRequest a mitad del
//     handshake + `net.tls_upgrade`; la contraseña en claro viaja solo dentro del canal cifrado).
//   - Consultas SIN parámetros: `COM_QUERY` (protocolo de texto), como siempre.
//   - Consultas CON parámetros: **protocolo binario** (prepared statements de una ronda:
//     COM_STMT_PREPARE → COM_STMT_EXECUTE → COM_STMT_CLOSE). Los `?` se enlazan aparte del SQL
//     (anti-inyección por binding); los parámetros van como VAR_STRING (texto). La fila binaria
//     se decodifica POR TIPO de columna (ints con/sin signo, float/double vía bits IEEE 754,
//     DATE/DATETIME/TIMESTAMP/TIME empaquetados, el resto length-encoded) y se entrega como
//     texto — la misma API `[[string]]` (un NULL → "").
//
// API (uniforme con el resto de `packages/db`): `connect`/`connect_tls` → `Conn`,
// `query(c, sql, params)` → filas `[[string]]`, `exec(c, sql, params)` → filas afectadas,
// `disconnect` (no se llama `close` para no tapar, dentro del módulo, al builtin global `close`
// que cierra el socket).

import std/net;
import std/crypto;
import std/math;

/// Una conexión abierta: el socket, la secuencia de paquete en curso y el búfer de lectura
/// (los sockets entregan trozos arbitrarios; el framing exige leer cantidades exactas).
pub struct Conn {
    sock: int,
    seq: int,
    buf: [int],
    pos: int,
}

// ── Búfer de lectura: cantidades exactas sobre trozos arbitrarios ─────────────────────

// Asegura que el búfer tenga al menos `need` octetos sin consumir (lee del socket si faltan).
fn fill(c: Conn, need: int) -> Result<int, string> {
    while (c.buf.len() - c.pos < need) {
        let chunk = net.socket_read_bytes(c.sock)?;
        if (chunk.len() == 0) {
            return Result.Err("mysql: el servidor cerró la conexión");
        }
        var i = 0;
        while (i < chunk.len()) {
            c.buf.push(chunk[i]);
            i = i + 1;
        }
    }
    Result.Ok(0)
}

// Consume exactamente `n` octetos del búfer.
fn take(c: Conn, n: int) -> Result<[int], string> {
    let _ = fill(c, n)?;
    var out: [int] = [];
    var i = 0;
    while (i < n) {
        out.push(c.buf[c.pos + i]);
        i = i + 1;
    }
    c.pos = c.pos + n;
    Result.Ok(out)
}

// ── Framing de paquetes ────────────────────────────────────────────────────────────────

// Lee un paquete completo: cabecera [len:3 LE][seq:1] + carga. Actualiza la secuencia esperada.
fn read_packet(c: Conn) -> Result<[int], string> {
    let hdr = take(c, 4)?;
    let len = hdr[0] | hdr[1] << 8 | hdr[2] << 16;
    c.seq = hdr[3] + 1;
    take(c, len)
}

// Escribe un paquete con la secuencia en curso.
fn write_packet(c: Conn, payload: [int]) -> Result<int, string> {
    let len = payload.len();
    let hdr = [len & 255, len >> 8 & 255, len >> 16 & 255, c.seq & 255];
    c.seq = c.seq + 1;
    net.socket_write_bytes(c.sock, bytes_of(hdr + payload))
}

// ── Primitivas del protocolo ───────────────────────────────────────────────────────────

// Entero length-encoded en `p[i]`: (valor, octetos consumidos). 0xfb (NULL) lo trata el llamador.
fn lenc_int(p: [int], i: int) -> (int, int) {
    let b = p[i];
    if (b < 251) {
        return (b, 1);
    }
    if (b == 252) {
        return (p[i + 1] | p[i + 2] << 8, 3);
    }
    if (b == 253) {
        return (p[i + 1] | p[i + 2] << 8 | p[i + 3] << 16, 4);
    }
    // 254: 8 octetos LE.
    var v = 0;
    var k = 7;
    while (k >= 0) {
        v = v << 8 | p[i + 1 + k];
        k = k - 1;
    }
    return (v, 9);
}

// String NUL-terminado en `p[i]`: (string, posición tras el NUL). Camino feliz: UTF-8 válido.
fn nul_str(p: [int], i: int) -> (string, int) {
    var out: [int] = [];
    var j = i;
    while (j < p.len() && p[j] != 0) {
        out.push(p[j]);
        j = j + 1;
    }
    let s = match (from_utf8(bytes_of(out))) {
        Result.Ok(t) => t,
        Result.Err(_) => "",
    };
    return (s, j + 1);
}

// XOR octeto a octeto de dos digests del mismo largo.
fn xor_digest(a: bytes, b: bytes) -> [int] {
    var out: [int] = [];
    var i = 0;
    while (i < a.len()) {
        out.push(a[i] ^ b[i]);
        i = i + 1;
    }
    out
}

fn bytes_to_ints(b: bytes) -> [int] {
    var out: [int] = [];
    var i = 0;
    while (i < b.len()) {
        out.push(b[i]);
        i = i + 1;
    }
    out
}

// ── Autenticación ──────────────────────────────────────────────────────────────────────

// `mysql_native_password`: SHA1(pass) XOR SHA1(scramble + SHA1(SHA1(pass))). Vacía → vacía.
fn native_auth(scramble: [int], password: string) -> [int] {
    if (password.len() == 0) {
        let empty: [int] = [];
        return empty;
    }
    let h1 = crypto.sha1(password.to_bytes());
    let h2 = crypto.sha1(h1);
    let h3 = crypto.sha1(bytes_of(scramble + bytes_to_ints(h2)));
    xor_digest(h1, h3)
}

// Fast-path de `caching_sha2_password`: SHA256(pass) XOR SHA256(SHA256(SHA256(pass)) + scramble).
fn sha2_auth(scramble: [int], password: string) -> [int] {
    if (password.len() == 0) {
        let empty: [int] = [];
        return empty;
    }
    let h1 = crypto.sha256(password.to_bytes());
    let h2 = crypto.sha256(crypto.sha256(h1));
    let h3 = crypto.sha256(bytes_of(bytes_to_ints(h2) + scramble));
    xor_digest(h1, h3)
}

fn auth_for(plugin: string, scramble: [int], password: string) -> Result<[int], string> {
    if (plugin == "mysql_native_password") {
        return Result.Ok(native_auth(scramble, password));
    }
    if (plugin == "caching_sha2_password") {
        return Result.Ok(sha2_auth(scramble, password));
    }
    Result.Err("mysql: plugin de autenticación no soportado: '" + plugin + "'")
}

// El mensaje de un paquete ERR: [0xff][código:2][#estado:6][texto].
fn err_msg(p: [int]) -> string {
    var i = 3; // 0xff + código
    if (i < p.len() && p[i] == 35) {
        i = i + 6; // '#' + 5 de sqlstate
    }
    var out: [int] = [];
    while (i < p.len()) {
        out.push(p[i]);
        i = i + 1;
    }
    match (from_utf8(bytes_of(out))) {
        Result.Ok(s) => "mysql: " + s,
        Result.Err(_) => "mysql: error del servidor",
    }
}

// ── Conexión ───────────────────────────────────────────────────────────────────────────

/// Abre una conexión y autentica. `database` puede ser "" (sin esquema por defecto).
pub fn connect(host: string, port: int, user: string, password: string, database: string) -> Result<Conn, string> {
    connect_opts(host, port, user, password, database, false)
}

/// Connects over TLS: sends the protocol's SSLRequest packet after the server handshake, upgrades
/// the socket (certificate verified against `host`), and completes the handshake over the
/// encrypted channel. Enables the `caching_sha2_password` **full path** (the cleartext password
/// travels only inside TLS), so it works even when the server has not cached the credential.
pub fn connect_tls(host: string, port: int, user: string, password: string, database: string) -> Result<Conn, string> {
    connect_opts(host, port, user, password, database, true)
}

// La conexión real; `tls` decide si se intercala el SSLRequest + upgrade antes de la respuesta.
fn connect_opts(host: string, port: int, user: string, password: string, database: string, tls: bool) -> Result<Conn, string> {
    let sock = net.tcp_connect(host, port)?;
    let empty: [int] = [];
    let c = Conn { sock: sock, seq: 0, buf: empty, pos: 0 };

    // 1. Handshake inicial v10 del servidor.
    let hs = read_packet(c)?;
    if (hs[0] == 255) {
        return Result.Err(err_msg(hs));
    }
    if (hs[0] != 10) {
        return Result.Err("mysql: versión de protocolo no soportada: " + to_string(hs[0]));
    }
    let sv = nul_str(hs, 1); // versión del servidor (informativa)
    var i = sv.1 + 4;        // thread id
    var scramble: [int] = [];
    var k = 0;
    while (k < 8) {
        scramble.push(hs[i + k]); // auth-data parte 1
        k = k + 1;
    }
    i = i + 8 + 1 + 2; // parte1 + filler + capacidades bajas
    var plugin = "mysql_native_password";
    if (i < hs.len()) {
        i = i + 1 + 2 + 2; // charset + estado + capacidades altas
        let auth_len = hs[i];
        i = i + 1 + 10; // longitud + reservado
        // Parte 2 del scramble: auth_len - 8 - 1 octetos (el último es un NUL).
        var p2 = auth_len - 9;
        if (p2 < 12) {
            p2 = 12;
        }
        k = 0;
        while (k < p2) {
            scramble.push(hs[i + k]);
            k = k + 1;
        }
        i = i + p2;
        if (i < hs.len() && hs[i] == 0) {
            i = i + 1; // NUL del scramble
        }
        if (i < hs.len()) {
            let pn = nul_str(hs, i);
            plugin = pn.0;
        }
    }

    // 2. Respuesta del handshake (protocolo 41 + conexión segura + plugin auth).
    var caps = 512 | 32768 | 524288; // CLIENT_PROTOCOL_41 | SECURE_CONNECTION | PLUGIN_AUTH
    if (database.len() > 0) {
        caps = caps | 8; // CLIENT_CONNECT_WITH_DB
    }
    if (tls) {
        caps = caps | 2048; // CLIENT_SSL
    }
    // Prefijo común: capacidades + paquete máximo + charset + 23 reservados. Es también el
    // paquete SSLRequest completo (la respuesta truncada antes del usuario).
    var pre: [int] = [];
    pre.push(caps & 255);
    pre.push(caps >> 8 & 255);
    pre.push(caps >> 16 & 255);
    pre.push(caps >> 24 & 255);
    pre = pre + [0, 0, 0, 1]; // paquete máximo 16 MiB (LE)
    pre.push(33); // charset utf8_general_ci
    k = 0;
    while (k < 23) {
        pre.push(0); // reservado
        k = k + 1;
    }
    if (tls) {
        // SSLRequest en claro (sigue la secuencia: handshake=0, SSLRequest=1, respuesta=2);
        // después el MISMO socket sube a TLS y el resto de la sesión va cifrado.
        let _ = write_packet(c, pre)?;
        let _ = match (net.tls_upgrade(sock, host)) {
            Result.Ok(h) => h,
            Result.Err(e) => { close(sock); return Result.Err("mysql: " + e); },
        };
    }
    var out = pre + bytes_to_ints(user.to_bytes()) + [0];
    let auth = auth_for(plugin, scramble, password)?;
    out.push(auth.len());
    out = out + auth;
    if (database.len() > 0) {
        out = out + bytes_to_ints(database.to_bytes()) + [0];
    }
    out = out + bytes_to_ints(plugin.to_bytes()) + [0];
    let _ = write_packet(c, out)?;

    // 3. Resultado de la autenticación (con posibles vueltas extra).
    var vueltas = 0;
    while (vueltas < 4) {
        let r = read_packet(c)?;
        if (r[0] == 0) {
            return Result.Ok(c); // OK
        }
        if (r[0] == 255) {
            return Result.Err(err_msg(r));
        }
        if (r[0] == 254) {
            // AuthSwitchRequest: [0xfe][plugin NUL][scramble nuevo (con NUL final)].
            let pn = nul_str(r, 1);
            var sc: [int] = [];
            var j = pn.1;
            while (j < r.len() && r[j] != 0) {
                sc.push(r[j]);
                j = j + 1;
            }
            let a2 = auth_for(pn.0, sc, password)?;
            let _ = write_packet(c, a2)?;
        } else {
            if (r[0] == 1) {
                // AuthMoreData (caching_sha2): 0x03 = fast-path OK (sigue un OK), 0x04 = full auth.
                if (r.len() > 1 && r[1] == 3) {
                    // sigue el OK en el bucle
                } else {
                    if (tls) {
                        // Full-path por el canal cifrado: la contraseña en claro (con NUL). Solo
                        // es seguro DENTRO de TLS; en claro exigiría el intercambio RSA (diferido).
                        let _ = write_packet(c, bytes_to_ints(password.to_bytes()) + [0])?;
                        // sigue el OK/ERR en el bucle
                    } else {
                        return Result.Err(
                            "mysql: caching_sha2_password exige el full-path; usa connect_tls (la "
                                + "contraseña viaja cifrada), un usuario con mysql_native_password, o "
                                + "calienta la caché del servidor con otro cliente");
                    }
                }
            } else {
                return Result.Err("mysql: respuesta de autenticación inesperada");
            }
        }
        vueltas = vueltas + 1;
    }
    Result.Err("mysql: la autenticación no convergió")
}

// ── Consultas ──────────────────────────────────────────────────────────────────────────

// ¿El paquete es un EOF clásico? (0xfe con carga corta; los lenc-int de 8 octetos también
// empiezan por 0xfe, por eso el límite de longitud.)
fn is_eof(p: [int]) -> bool {
    p.len() > 0 && p[0] == 254 && p.len() < 9
}

// Manda COM_QUERY y devuelve el primer paquete de la respuesta.
fn send_query(c: Conn, sql: string) -> Result<[int], string> {
    c.seq = 0; // cada comando resetea la secuencia
    let _ = write_packet(c, [3] + bytes_to_ints(sql.to_bytes()))?;
    read_packet(c)
}

/// Runs a query that returns rows. With `params` the statement is prepared and the `?` markers
/// are bound apart from the SQL (binary protocol → injection-proof); with `[]` it goes through
/// the classic text protocol. Rows arrive as text either way (a NULL becomes `""`).
pub fn query(c: Conn, sql: string, params: [string]) -> Result<[[string]], string> {
    if (params.len() == 0) {
        return query_text(c, sql);
    }
    query_prepared(c, sql, params)
}

/// Runs a statement that returns no rows (INSERT/UPDATE/DELETE/DDL); returns the affected-row
/// count. Same rule as `query`: with `params`, prepared (binary); with `[]`, plain text.
pub fn exec(c: Conn, sql: string, params: [string]) -> Result<int, string> {
    if (params.len() == 0) {
        return exec_text(c, sql);
    }
    exec_prepared(c, sql, params)
}

// El camino clásico de texto (COM_QUERY), para consultas sin parámetros.
fn query_text(c: Conn, sql: string) -> Result<[[string]], string> {
    let first = send_query(c, sql)?;
    if (first[0] == 255) {
        return Result.Err(err_msg(first));
    }
    if (first[0] == 0) {
        return Result.Err("mysql: la consulta no devuelve filas; usa exec");
    }
    let nc = lenc_int(first, 0);
    let ncols = nc.0;
    // Definiciones de columna + EOF.
    var k = 0;
    while (k < ncols) {
        let _ = read_packet(c)?;
        k = k + 1;
    }
    let eof1 = read_packet(c)?;
    if (!is_eof(eof1)) {
        return Result.Err("mysql: se esperaba EOF tras las columnas");
    }
    // Filas hasta el EOF final.
    var rows: [[string]] = [];
    var seguir = true;
    while (seguir) {
        let p = read_packet(c)?;
        if (is_eof(p)) {
            seguir = false;
        } else {
            if (p[0] == 255) {
                return Result.Err(err_msg(p));
            }
            var row: [string] = [];
            var i = 0;
            var col = 0;
            while (col < ncols) {
                if (p[i] == 251) {
                    row.push(""); // NULL
                    i = i + 1;
                } else {
                    let ln = lenc_int(p, i);
                    i = i + ln.1;
                    var cell: [int] = [];
                    var j = 0;
                    while (j < ln.0) {
                        cell.push(p[i + j]);
                        j = j + 1;
                    }
                    i = i + ln.0;
                    row.push(match (from_utf8(bytes_of(cell))) {
                        Result.Ok(s) => s,
                        Result.Err(_) => "",
                    });
                }
                col = col + 1;
            }
            rows.push(row);
        }
    }
    Result.Ok(rows)
}

// El camino clásico de texto para sentencias sin filas.
fn exec_text(c: Conn, sql: string) -> Result<int, string> {
    let first = send_query(c, sql)?;
    if (first[0] == 255) {
        return Result.Err(err_msg(first));
    }
    if (first[0] != 0) {
        return Result.Err("mysql: la sentencia devuelve filas; usa query");
    }
    let af = lenc_int(first, 1); // OK: [0x00][afectadas lenc][last_insert_id lenc]…
    Result.Ok(af.0)
}

// ── Protocolo binario: prepared statements de una ronda ─────────────────────────────────
//
// prepare → execute → close por llamada (sin estado de sentencia, como el portal anónimo de
// postgres). Los parámetros se enlazan todos como VAR_STRING (texto; la afinidad del servidor
// convierte); la FILA de respuesta llega en formato binario y se decodifica por el TIPO de cada
// columna (que viaja en su definición) de vuelta a texto → misma API [[string]] que el texto.

// Codifica un entero length-encoded (el inverso de lenc_int).
fn lenc_of(n: int) -> [int] {
    if (n < 251) {
        return [n];
    }
    if (n < 65536) {
        return [252, n & 255, (n >> 8) & 255];
    }
    // `return` explícito: un literal `[…]` en cola tras un if-sentencia se parsearía como
    // indexación (mismo compromiso gramatical que el de las tuplas, DESIGN §55.1).
    return [253, n & 255, (n >> 8) & 255, (n >> 16) & 255];
}

// COM_STMT_PREPARE (0x16): devuelve (stmt_id, num_params). Las definiciones de parámetros y
// columnas del prepare se saltan (el execute trae las suyas).
fn stmt_prepare(c: Conn, sql: string) -> Result<(int, int), string> {
    c.seq = 0;
    let _ = write_packet(c, [22] + bytes_to_ints(sql.to_bytes()))?;
    let ok = read_packet(c)?;
    if (ok[0] == 255) {
        return Result.Err(err_msg(ok));
    }
    if (ok[0] != 0) {
        return Result.Err("mysql: respuesta de prepare inesperada");
    }
    let stmt_id = ok[1] | (ok[2] << 8) | (ok[3] << 16) | (ok[4] << 24);
    let ncols = ok[5] | (ok[6] << 8);
    let nparams = ok[7] | (ok[8] << 8);
    var k = 0;
    while (k < nparams) {
        let _ = read_packet(c)?;
        k = k + 1;
    }
    if (nparams > 0) {
        let _ = read_packet(c)?; // EOF del bloque de parámetros
    }
    k = 0;
    while (k < ncols) {
        let _ = read_packet(c)?;
        k = k + 1;
    }
    if (ncols > 0) {
        let _ = read_packet(c)?; // EOF del bloque de columnas
    }
    return Result.Ok((stmt_id, nparams));
}

// COM_STMT_EXECUTE (0x17): todos los parámetros como VAR_STRING (0xfd). El bitmap de NULLs va a
// cero (la API no distingue NULL de ""; mismo compromiso que las celdas). Devuelve el primer
// paquete de la respuesta.
fn stmt_execute(c: Conn, stmt_id: int, params: [string]) -> Result<[int], string> {
    c.seq = 0;
    var out: [int] = [23];
    out.push(stmt_id & 255);
    out.push((stmt_id >> 8) & 255);
    out.push((stmt_id >> 16) & 255);
    out.push((stmt_id >> 24) & 255);
    out.push(0); // flags: CURSOR_TYPE_NO_CURSOR
    out = out + [1, 0, 0, 0]; // iteration count = 1
    if (params.len() > 0) {
        var k = 0;
        let nb = (params.len() + 7) / 8;
        while (k < nb) {
            out.push(0); // bitmap de NULLs: ninguno
            k = k + 1;
        }
        out.push(1); // new-params-bound
        k = 0;
        while (k < params.len()) {
            out.push(253); // MYSQL_TYPE_VAR_STRING
            out.push(0);   // con signo
            k = k + 1;
        }
        k = 0;
        while (k < params.len()) {
            let pb = params[k].to_bytes();
            out = out + lenc_of(pb.len()) + bytes_to_ints(pb);
            k = k + 1;
        }
    }
    let _ = write_packet(c, out)?;
    read_packet(c)
}

// COM_STMT_CLOSE (0x19): libera la sentencia en el servidor. No hay respuesta.
fn stmt_close(c: Conn, stmt_id: int) {
    c.seq = 0;
    let _ = write_packet(c, [25, stmt_id & 255, (stmt_id >> 8) & 255, (stmt_id >> 16) & 255, (stmt_id >> 24) & 255]);
}

// El tipo y los flags de una definición de columna (lo único que necesita la fila binaria).
// Layout: 6 strings lenc (catálogo/esquema/tabla/tabla orig/nombre/nombre orig) + lenc del bloque
// fijo (0x0c) + charset:2 + longitud:4 + TIPO:1 + FLAGS:2 + decimales:1 + relleno:2.
fn col_type_flags(p: [int]) -> (int, int) {
    var i = 0;
    var k = 0;
    while (k < 6) {
        let ln = lenc_int(p, i);
        i = i + ln.1 + ln.0;
        k = k + 1;
    }
    let fl = lenc_int(p, i);
    i = i + fl.1 + 2 + 4; // bloque fijo + charset + longitud de columna
    return (p[i], p[i + 1] | (p[i + 2] << 8));
}

// int → float (exacto hasta 2^53; los operandos aquí caben de sobra).
fn to_f(n: int) -> float {
    return match (parse_float(to_string(n))) {
        Option.Some(f) => f,
        Option.None => 0.0,
    };
}

// Entero LE SIN signo de hasta 4 octetos.
fn int_le(p: [int], i: int, w: int) -> int {
    var v = 0;
    var k = 0;
    while (k < w) {
        v = v | (p[i + k] << (8 * k));
        k = k + 1;
    }
    v
}

// Una celda entera de ancho w (1/2/4), con o sin signo → (texto, nueva posición).
fn int_cell(p: [int], i: int, w: int, unsigned: bool) -> (string, int) {
    var v = int_le(p, i, w);
    if (!unsigned) {
        let lim = 1 << (8 * w - 1);
        if (v >= lim) {
            v = v - lim * 2;
        }
    }
    return (to_string(v), i + w);
}

// Reconstruye un f32 desde sus 4 octetos (raylang solo tiene bits de f64): la aritmética
// (mantisa + 2^exp) es exacta en f64 para cualquier f32.
fn f32_of(bits: int) -> float {
    let neg = ((bits >> 31) & 1) == 1;
    let e = (bits >> 23) & 255;
    let m = bits & 8388607;
    var v = 0.0;
    if (e == 255) {
        // Inf/NaN: se construye el f64 equivalente por bits.
        if (m == 0) {
            v = math.float_from_bits(9218868437227405312); // +inf
        } else {
            v = math.float_from_bits(9221120237041090560); // NaN
        }
    } else {
        if (e == 0) {
            v = to_f(m) * math.pow(2.0, 0.0 - 149.0); // subnormal
        } else {
            v = (to_f(m) + 8388608.0) * math.pow(2.0, to_f(e - 150));
        }
    }
    if (neg) { 0.0 - v } else { v }
}

fn pad2(n: int) -> string {
    if (n < 10) { "0" + to_string(n) } else { to_string(n) }
}

fn pad4(n: int) -> string {
    if (n < 10) { return "000" + to_string(n); }
    if (n < 100) { return "00" + to_string(n); }
    if (n < 1000) { return "0" + to_string(n); }
    to_string(n)
}

fn pad6(n: int) -> string {
    var s = to_string(n);
    while (s.len() < 6) {
        s = "0" + s;
    }
    s
}

// DATE binaria: [len][year:2][month][day]; len 0 = fecha cero.
fn dec_date(p: [int], i: int, ln: int) -> string {
    if (ln < 4) {
        return "0000-00-00";
    }
    pad4(p[i] | (p[i + 1] << 8)) + "-" + pad2(p[i + 2]) + "-" + pad2(p[i + 3])
}

// DATETIME/TIMESTAMP binarios: fecha + [hour][min][sec] (len>=7) + [micro:4] (len=11).
fn dec_datetime(p: [int], i: int, ln: int) -> string {
    var s = dec_date(p, i, ln) + " ";
    if (ln >= 7) {
        s = s + pad2(p[i + 4]) + ":" + pad2(p[i + 5]) + ":" + pad2(p[i + 6]);
    } else {
        s = s + "00:00:00";
    }
    if (ln >= 11) {
        s = s + "." + pad6(int_le(p, i + 7, 4));
    }
    s
}

// TIME binario: [len][neg][days:4][hour][min][sec] (+ [micro:4]); las horas acumulan los días.
fn dec_time(p: [int], i: int, ln: int) -> string {
    if (ln == 0) {
        return "00:00:00";
    }
    let sign = if (p[i] == 1) { "-" } else { "" };
    let hours = int_le(p, i + 1, 4) * 24 + p[i + 5];
    var s = sign + pad2(hours) + ":" + pad2(p[i + 6]) + ":" + pad2(p[i + 7]);
    if (ln >= 12) {
        s = s + "." + pad6(int_le(p, i + 8, 4));
    }
    s
}

// Una celda de la fila binaria, por tipo de columna → (texto, nueva posición).
fn bin_cell(p: [int], i: int, t: int, flags: int) -> (string, int) {
    let unsigned = (flags & 32) != 0;
    if (t == 1) { return int_cell(p, i, 1, unsigned); }          // TINY
    if (t == 2 || t == 13) { return int_cell(p, i, 2, unsigned); } // SHORT / YEAR
    if (t == 3 || t == 9) { return int_cell(p, i, 4, unsigned); }  // LONG / INT24
    if (t == 8) {
        // LONGLONG: por mitades (b7<<56 desbordaría). Un BIGINT UNSIGNED ≥ 2^63 no cabe en el
        // int de raylang y se muestra envuelto (limitación documentada).
        let lo = int_le(p, i, 4);
        var hi = int_le(p, i + 4, 4);
        if (!unsigned && hi >= 2147483648) {
            hi = hi - 4294967296;
        }
        return (to_string(hi * 4294967296 + lo), i + 8);
    }
    if (t == 4) {
        // FLOAT (f32)
        let cell = (to_string(f32_of(int_le(p, i, 4))), i + 4);
        return cell;
    }
    if (t == 5) {
        // DOUBLE (f64): por mitades → bits → float.
        let lo = int_le(p, i, 4);
        var hi = int_le(p, i + 4, 4);
        if (hi >= 2147483648) {
            hi = hi - 4294967296;
        }
        return (to_string(math.float_from_bits(hi * 4294967296 + lo)), i + 8);
    }
    if (t == 10) {
        let ln = p[i];
        return (dec_date(p, i + 1, ln), i + 1 + ln);
    }
    if (t == 7 || t == 12) {
        // TIMESTAMP / DATETIME
        let ln = p[i];
        return (dec_datetime(p, i + 1, ln), i + 1 + ln);
    }
    if (t == 11) {
        let ln = p[i];
        return (dec_time(p, i + 1, ln), i + 1 + ln);
    }
    // El resto (DECIMAL/NEWDECIMAL/VARCHAR/BIT/ENUM/SET/BLOB/TEXT/STRING/JSON…): length-encoded.
    let ln = lenc_int(p, i);
    var cell: [int] = [];
    var j = 0;
    while (j < ln.0) {
        cell.push(p[i + ln.1 + j]);
        j = j + 1;
    }
    let s = match (from_utf8(bytes_of(cell))) {
        Result.Ok(x) => x,
        Result.Err(_) => "",
    };
    return (s, i + ln.1 + ln.0);
}

// SELECT preparado: execute → definiciones de columna (capturando tipo+flags) → filas binarias.
fn query_prepared(c: Conn, sql: string, params: [string]) -> Result<[[string]], string> {
    let pr = stmt_prepare(c, sql)?;
    let first = stmt_execute(c, pr.0, params)?;
    if (first[0] == 255) {
        stmt_close(c, pr.0);
        return Result.Err(err_msg(first));
    }
    if (first[0] == 0) {
        stmt_close(c, pr.0);
        return Result.Err("mysql: la consulta no devuelve filas; usa exec");
    }
    let nc = lenc_int(first, 0);
    let ncols = nc.0;
    var types: [int] = [];
    var cflags: [int] = [];
    var k = 0;
    while (k < ncols) {
        let cd = read_packet(c)?;
        let tf = col_type_flags(cd);
        types.push(tf.0);
        cflags.push(tf.1);
        k = k + 1;
    }
    let eof1 = read_packet(c)?;
    if (!is_eof(eof1)) {
        stmt_close(c, pr.0);
        return Result.Err("mysql: se esperaba EOF tras las columnas");
    }
    var rows: [[string]] = [];
    var seguir = true;
    while (seguir) {
        let p = read_packet(c)?;
        if (is_eof(p)) {
            seguir = false;
        } else {
            if (p[0] == 255) {
                stmt_close(c, pr.0);
                return Result.Err(err_msg(p));
            }
            // Fila binaria: [0x00][bitmap de NULLs, desplazado 2 bits][valores por tipo].
            var row: [string] = [];
            var i = 1 + (ncols + 9) / 8;
            var col = 0;
            while (col < ncols) {
                let bit = col + 2;
                if (((p[1 + bit / 8] >> (bit % 8)) & 1) == 1) {
                    row.push(""); // NULL
                } else {
                    let cell = bin_cell(p, i, types[col], cflags[col]);
                    row.push(cell.0);
                    i = cell.1;
                }
                col = col + 1;
            }
            rows.push(row);
        }
    }
    stmt_close(c, pr.0);
    Result.Ok(rows)
}

// Sentencia sin filas preparada: la respuesta al execute es un OK ordinario.
fn exec_prepared(c: Conn, sql: string, params: [string]) -> Result<int, string> {
    let pr = stmt_prepare(c, sql)?;
    let first = stmt_execute(c, pr.0, params)?;
    stmt_close(c, pr.0);
    if (first[0] == 255) {
        return Result.Err(err_msg(first));
    }
    if (first[0] != 0) {
        return Result.Err("mysql: la sentencia devuelve filas; usa query");
    }
    let af = lenc_int(first, 1);
    Result.Ok(af.0)
}

/// Despide la sesión (COM_QUIT) y cierra el socket. (No se llama `close` para no tapar,
/// dentro del módulo, al builtin global que cierra el socket.)
pub fn disconnect(c: Conn) {
    c.seq = 0;
    let _ = write_packet(c, [1]); // COM_QUIT (el servidor no responde)
    close(c.sock);
}
