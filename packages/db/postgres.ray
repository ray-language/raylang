// Cliente PostgreSQL v2 (M53.2) — protocolo wire v3 sobre TCP, en raylang puro.
//
// Evoluciona el cliente de una-consulta de `net/postgres.ray` (M32.1) a una API con **conexión
// persistente** y el **protocolo extendido** (Parse/Bind/Describe/Execute/Sync), que trae
// **parámetros** (`$1`, `$2`, … enlazados aparte del SQL → anti-inyección) y devuelve **todas** las
// filas. Autentica con SCRAM-SHA-256 (reusa `net/scram`).
//
//   - Mensajes: `[tipo:1][longitud:4][carga]` (la longitud incluye sus 4 octetos, no el tipo); el
//     StartupMessage no lleva octeto de tipo.
//   - Auth: SCRAM-SHA-256 (AuthenticationSASL → SASLContinue → SASLFinal, con verificación de la
//     firma del servidor).
//   - Extendido: los parámetros van en **formato texto** (v1); un parámetro se enlaza como cadena.
//     El SQL usa marcadores `$1`, `$2`, … El protocolo simple (`net/postgres`) se conserva aparte.
//
// API uniforme con `db/mysql`: `connect` → `Conn`, `query`/`exec` (con `params: [string]`),
// `disconnect`. Las transacciones son SQL corriente: `exec(c, "BEGIN", [])` / `"COMMIT"` / `"ROLLBACK"`.

from net/scram import scram_first, scram_client_first_message, scram_final, scram_verify, Scram;
import std/net;

/// Una conexión abierta y autenticada, con su búfer de lectura (un mensaje puede partirse entre
/// lecturas del socket, o venir varios juntos).
pub struct Conn {
    handle: int,
    buf: bytes,
    // M91.5: caché de sentencias preparadas CON NOMBRE (arreglos paralelos sql→nombre): una
    // consulta repetida se enlaza a su sentencia ya parseada en el servidor (que así reusa el
    // plan) en vez de re-parsearse anónima en cada ronda.
    stmt_sqls: [string],
    stmt_names: [string],
    stmt_seq: int,
}

// Un mensaje del servidor: su octeto de tipo y la carga (sin el tipo ni la longitud).
struct PgMsg {
    mtype: int,
    payload: bytes,
}

// ── Enteros y cadenas del protocolo ──────────────────────────────────────────────────────

fn be32(b: bytes, off: int) -> int {
    b[off] << 24 | b[off + 1] << 16 | b[off + 2] << 8 | b[off + 3]
}

fn be32_bytes(n: int) -> [int] {
    [n >> 24 & 255, n >> 16 & 255, n >> 8 & 255, n & 255]
}

fn be16_bytes(n: int) -> [int] {
    [n >> 8 & 255, n & 255]
}

// Octetos de una cadena terminada en NUL.
fn cstr(s: string) -> [int] {
    var o = bytes_to_ints(s.to_bytes());
    o.push(0);
    o
}

fn bytes_to_ints(b: bytes) -> [int] {
    var out: [int] = [];
    var i = 0;
    while (i < b.len()) {
        out.push(b[i]);
        i = i + 1;
    }
    out
}

// ── Framing ──────────────────────────────────────────────────────────────────────────────

// Envía un mensaje con octeto de tipo: `[tipo][longitud=4+len(carga)][carga]`.
fn send(c: Conn, mtype: int, payload: [int]) -> Result<int, string> {
    var m: [int] = [mtype];
    m = m + be32_bytes(4 + payload.len()) + payload;
    net.socket_write_bytes(c.handle, bytes_of(m))
}

// Tope de tamaño de un mensaje del servidor (anti-bomba de memoria). La longitud la fija el
// servidor; sin cota, un valor enorme haría que `read_msg` acumule octetos del socket sin fin hasta
// agotar la memoria. Se rechaza en cuanto se lee la cabecera, antes de acumular nada.
fn max_message() -> int {
    67108864
}

// Lee un mensaje COMPLETO del servidor (acumulando en el búfer lo que haga falta).
fn read_msg(c: Conn) -> Result<PgMsg, string> {
    while (true) {
        if (c.buf.len() >= 5) {
            let mlen = be32(c.buf, 1); // longitud (incluye sus 4 octetos)
            // La longitud incluye sus propios 4 octetos → un valor < 4 es inválido (evita un `total`
            // que deje `sub_bytes` con fin < inicio). Y un valor enorme = bomba de memoria.
            if (mlen < 4) {
                return Result.Err("postgres: longitud de mensaje inválida (" + to_string(mlen) + ")");
            }
            if (mlen > max_message()) {
                return Result.Err("postgres: mensaje excede el límite (" + to_string(mlen) + " octetos, posible bomba de memoria)");
            }
            let total = 1 + mlen;
            if (c.buf.len() >= total) {
                let out = PgMsg { mtype: c.buf[0], payload: c.buf.sub_bytes(5, total) };
                c.buf = c.buf.sub_bytes(total, c.buf.len());
                return Result.Ok(out);
            }
        }
        let chunk = net.socket_read_bytes(c.handle)?;
        if (chunk.len() == 0) {
            return Result.Err("postgres: el servidor cerró la conexión");
        }
        c.buf = c.buf + chunk;
    }
    Result.Err("inalcanzable")
}

// El texto de un ErrorResponse ('E'): campos [tipo:1][valor NUL]…, hasta un tipo 0. El campo 'M'
// es el mensaje humano.
fn error_text(payload: bytes) -> string {
    var i = 0;
    while (i < payload.len() && payload[i] != 0) {
        let campo = payload[i];
        i = i + 1;
        var val: [int] = [];
        while (i < payload.len() && payload[i] != 0) {
            val.push(payload[i]);
            i = i + 1;
        }
        i = i + 1; // NUL
        if (campo == 77) {
            // 'M'
            return match (from_utf8(bytes_of(val))) {
                Result.Ok(s) => "postgres: " + s,
                Result.Err(_) => "postgres: error del servidor",
            };
        }
    }
    "postgres: error del servidor"
}

// ── DataRow ────────────────────────────────────────────────────────────────────────────────

// Parsea un DataRow ('D'): `[nº columnas:2]` y por columna `[longitud:4][valor]` (-1 = NULL → "").
// Falla como valor ante un payload truncado o una longitud fuera de rango (datos del servidor).
fn parse_datarow(payload: bytes) -> Result<[string], string> {
    if (payload.len() < 2) {
        return Result.Err("postgres: DataRow truncado (sin cuenta de columnas)");
    }
    var cols: [string] = [];
    let ncol = payload[0] << 8 | payload[1];
    var pos = 2;
    var i = 0;
    while (i < ncol) {
        if (pos + 4 > payload.len()) {
            return Result.Err("postgres: DataRow truncado (longitud de columna)");
        }
        // La longitud es int32 CON SIGNO: -1 (0xFFFFFFFF) marca NULL. `be32` no extiende el signo,
        // así que hay que reinterpretarlo — sin esto, el NULL se leía como 4294967295 y `sub_bytes`
        // reventaba el cliente ante CUALQUIER columna NULL.
        var vlen = be32(payload, pos);
        if (vlen >= 2147483648) {
            vlen = vlen - 4294967296;
        }
        pos = pos + 4;
        if (vlen < 0) {
            cols.push(""); // NULL
        } else {
            if (pos + vlen > payload.len()) {
                return Result.Err("postgres: DataRow con longitud de columna fuera de rango");
            }
            let v = payload.sub_bytes(pos, pos + vlen);
            cols.push(match (from_utf8(v)) {
                Result.Ok(s) => s,
                Result.Err(_) => "",
            });
            pos = pos + vlen;
        }
        i = i + 1;
    }
    Result.Ok(cols)
}

// ── Conexión + autenticación SCRAM ─────────────────────────────────────────────────────────

/// Abre una conexión, autentica con SCRAM-SHA-256 y la deja lista para consultas. `nonce` es el
/// nonce del cliente (usa uno aleatorio en producción).
pub fn connect(host: string, port: int, user: string, password: string, database: string, nonce: string) -> Result<Conn, string> {
    let handle = net.tcp_connect(host, port)?;
    startup_and_auth(handle, user, password, database, nonce)
}

/// Connects over TLS: sends the protocol's sslRequest on the plain socket, expects 'S', upgrades
/// the SAME handle to a client TLS session (the certificate is verified against `host`), and runs
/// the normal startup + SCRAM handshake over the encrypted channel.
pub fn connect_tls(host: string, port: int, user: string, password: string, database: string, nonce: string) -> Result<Conn, string> {
    let handle = net.tcp_connect(host, port)?;
    // SSLRequest (sin octeto de tipo): [longitud=8][código 80877103]. El servidor responde UN
    // octeto en claro: 'S' (adelante con TLS) o 'N' (no soporta).
    let _ = net.socket_write_bytes(handle, bytes_of(be32_bytes(8) + be32_bytes(80877103)))?;
    let resp = net.socket_read_bytes(handle)?;
    if (resp.len() < 1 || resp[0] != 83) {
        close(handle);
        return Result.Err("postgres: el servidor no acepta TLS (sslRequest rechazado)");
    }
    let _ = match (net.tls_upgrade(handle, host)) {
        Result.Ok(h) => h,
        Result.Err(e) => { close(handle); return Result.Err("postgres: " + e); },
    };
    startup_and_auth(handle, user, password, database, nonce)
}

// El StartupMessage + handshake SCRAM hasta ReadyForQuery, sobre un handle ya conectado
// (plano o TLS — el I/O se desvía solo por el tipo del handle).
fn startup_and_auth(handle: int, user: string, password: string, database: string, nonce: string) -> Result<Conn, string> {
    let c = Conn { handle: handle, buf: b"", stmt_sqls: [], stmt_names: [], stmt_seq: 0 };

    // StartupMessage (sin octeto de tipo): [longitud][versión 3.0 = 196608][params NUL][0].
    var body = be32_bytes(196608) + cstr("user") + cstr(user) + cstr("database") + cstr(database);
    body.push(0);
    var startup = be32_bytes(4 + body.len()) + body;
    let _ = net.socket_write_bytes(handle, bytes_of(startup))?;

    // Bucle de handshake hasta ReadyForQuery.
    let sc = scram_first(user, nonce);
    while (true) {
        let msg = read_msg(c)?;
        if (msg.mtype == 82) {
            // 'R' Authentication
            let code = be32(msg.payload, 0);
            if (code == 10) {
                // AuthenticationSASL → SASLInitialResponse ('p')
                let cf = scram_client_first_message(sc);
                let pl = cstr("SCRAM-SHA-256") + be32_bytes(cf.to_bytes().len()) + bytes_to_ints(cf.to_bytes());
                let _ = send(c, 112, pl)?;
            } else {
                if (code == 11) {
                    // AuthenticationSASLContinue (server-first) → SASLResponse
                    let sf = match (from_utf8(msg.payload.sub_bytes(4, msg.payload.len()))) {
                        Result.Ok(s) => s,
                        Result.Err(_) => { close(handle); return Result.Err("postgres: server-first no es UTF-8"); },
                    };
                    let final_msg = match (scram_final(sc, password, sf)) {
                        Result.Ok(f) => f,
                        Result.Err(e) => { close(handle); return Result.Err(e); },
                    };
                    let _ = send(c, 112, bytes_to_ints(final_msg.to_bytes()))?;
                } else {
                    if (code == 12) {
                        // AuthenticationSASLFinal (server-final): verificar la firma del servidor.
                        let sfin = match (from_utf8(msg.payload.sub_bytes(4, msg.payload.len()))) {
                            Result.Ok(s) => s,
                            Result.Err(_) => { close(handle); return Result.Err("postgres: server-final no es UTF-8"); },
                        };
                        if (!scram_verify(sc, sfin)) {
                            close(handle);
                            return Result.Err("postgres: la firma del servidor no verifica (autenticación fallida)");
                        }
                    }
                    // code 0 = AuthenticationOk: nada que hacer.
                }
            }
        } else {
            if (msg.mtype == 90) {
                // 'Z' ReadyForQuery → listo.
                return Result.Ok(c);
            } else {
                if (msg.mtype == 69) {
                    // 'E' ErrorResponse
                    close(handle);
                    return Result.Err(error_text(msg.payload));
                }
                // 'S' ParameterStatus, 'K' BackendKeyData, 'N' NoticeResponse: se ignoran.
            }
        }
    }
    Result.Err("inalcanzable")
}

// ── Protocolo extendido: Parse / Bind / Describe / Execute / Sync ───────────────────────────

// M91.5: nombre de sentencia preparada para `sql`: el cacheado si ya se preparó en esta
// conexión, o "" (hay que parsear). La caché se acota a 64 entradas; por encima se cae al
// comportamiento anónimo de siempre (una consulta por ronda, sin estado).
fn stmt_cached(c: Conn, sql: string) -> string {
    var i = 0;
    while (i < c.stmt_sqls.len()) {
        if (c.stmt_sqls[i] == sql) {
            return c.stmt_names[i];
        }
        i = i + 1;
    }
    ""
}

// Manda la secuencia extendida para `sql` con `params` (formato texto). M91.5: la sentencia va
// CON NOMBRE y se cachea por conexión (`stmt_cached`): en un hit se salta el Parse (el servidor
// reusa el plan); en un miss se parsea con un nombre FRESCO ("s0", "s1", …) que `query`/`exec`
// cachean solo si la ronda termina bien (un Parse fallido no envenena la caché, y un nombre
// nunca se re-parsea: re-Parse de un nombre existente es error de protocolo). Devuelve el
// nombre parseado en esta ronda ("" si fue un hit o se agotó la caché).
fn send_extended(c: Conn, sql: string, params: [string]) -> Result<string, string> {
    var name = stmt_cached(c, sql);
    var parsed = "";
    if (name == "") {
        if (c.stmt_sqls.len() < 64) {
            name = "s" + to_string(c.stmt_seq);
            c.stmt_seq = c.stmt_seq + 1;
            parsed = name;
        }
        // Parse ('P'): [nombre NUL][query NUL][nº tipos param:2 = 0].
        let parse_pl = cstr(name) + cstr(sql) + be16_bytes(0);
        let _ = send(c, 80, parse_pl)?;
    }

    // Bind ('B'): [portal NUL][sentencia NUL][nº formatos:2 = 0 (todos texto)]
    //             [nº params:2][por param: longitud:4 + valor][nº formatos de resultado:2 = 0].
    var bind_pl = cstr("") + cstr(name) + be16_bytes(0) + be16_bytes(params.len());
    var i = 0;
    while (i < params.len()) {
        let pb = params[i].to_bytes();
        bind_pl = bind_pl + be32_bytes(pb.len()) + bytes_to_ints(pb);
        i = i + 1;
    }
    bind_pl = bind_pl + be16_bytes(0);
    let _ = send(c, 66, bind_pl)?;

    // Describe ('D') del portal ('P') anónimo → obtenemos RowDescription (o NoData).
    let _ = send(c, 68, cstr("P"))?;
    // Execute ('E'): [portal NUL][máx filas:4 = 0 (todas)].
    let _ = send(c, 69, cstr("") + be32_bytes(0))?;
    // Sync ('S').
    let _ = send(c, 83, [])?;
    Result.Ok(parsed)
}

// El nº de filas afectadas del tag de CommandComplete: "INSERT 0 3" / "UPDATE 5" / "SELECT 2" → el
// último entero del tag; 0 si no lo hay.
fn affected_from_tag(payload: bytes) -> int {
    // El tag lleva un NUL final: recórtalo a nivel de octetos antes de decodificar.
    var fin = payload.len();
    if (fin > 0 && payload[fin - 1] == 0) {
        fin = fin - 1;
    }
    let tag = match (from_utf8(payload.sub_bytes(0, fin))) {
        Result.Ok(s) => s,
        Result.Err(_) => "",
    };
    let partes = tag.split(" ");
    if (partes.len() == 0) {
        return 0;
    }
    match (parse_int(partes[partes.len() - 1])) {
        Option.Some(n) => n,
        Option.None => 0,
    }
}

// Recorre la respuesta a una consulta extendida hasta ReadyForQuery, recogiendo filas y el tag.
// Devuelve (filas, filas_afectadas).
fn collect_response(c: Conn) -> Result<([[string]], int), string> {
    var rows: [[string]] = [];
    var affected = 0;
    while (true) {
        let msg = read_msg(c)?;
        if (msg.mtype == 68) {
            // 'D' DataRow
            rows.push(parse_datarow(msg.payload)?);
        } else {
            if (msg.mtype == 67) {
                // 'C' CommandComplete
                affected = affected_from_tag(msg.payload);
            } else {
                if (msg.mtype == 69) {
                    // 'E' ErrorResponse: hay que drenar hasta ReadyForQuery igualmente.
                    let e = error_text(msg.payload);
                    let _ = drain_until_ready(c);
                    return Result.Err(e);
                } else {
                    if (msg.mtype == 90) {
                        // 'Z' ReadyForQuery → fin de la ronda.
                        return Result.Ok((rows, affected));
                    }
                    // '1' ParseComplete, '2' BindComplete, 'T' RowDescription, 'n' NoData: se ignoran.
                }
            }
        }
    }
    Result.Err("inalcanzable")
}

fn drain_until_ready(c: Conn) -> Result<int, string> {
    while (true) {
        let msg = read_msg(c)?;
        if (msg.mtype == 90) {
            return Result.Ok(0);
        }
    }
    Result.Ok(0)
}

// ── API pública de consulta ─────────────────────────────────────────────────────────────────

/// Ejecuta una consulta con filas (SELECT…) y parámetros (`$1`, `$2`, … enlazados aparte, en
/// formato texto → anti-inyección). Devuelve **todas** las filas; un NULL llega como "".
pub fn query(c: Conn, sql: string, params: [string]) -> Result<[[string]], string> {
    let parsed = send_extended(c, sql, params)?;
    let r = collect_response(c)?;
    cache_stmt(c, sql, parsed);
    Result.Ok(r.0)
}

// M91.5: cachea la sentencia parseada en esta ronda, SOLO tras una ronda exitosa (si la ronda
// erró, el nombre queda huérfano en el servidor y la siguiente re-parsea con nombre fresco).
fn cache_stmt(c: Conn, sql: string, parsed: string) {
    if (parsed != "") {
        c.stmt_sqls.push(sql);
        c.stmt_names.push(parsed);
    }
}

/// Ejecuta una sentencia sin filas (INSERT/UPDATE/DELETE/DDL, o BEGIN/COMMIT/ROLLBACK) con
/// parámetros, y devuelve las filas afectadas (0 para DDL/transacciones).
pub fn exec(c: Conn, sql: string, params: [string]) -> Result<int, string> {
    let parsed = send_extended(c, sql, params)?;
    let r = collect_response(c)?;
    cache_stmt(c, sql, parsed);
    Result.Ok(r.1)
}

/// Cierra la sesión (Terminate 'X') y el socket.
pub fn disconnect(c: Conn) {
    let _ = send(c, 88, []); // 'X' Terminate
    close(c.handle);
}
