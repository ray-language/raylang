// db/sessions — M350/M352 (IDEAS §102 R9): los backends de base de datos del almacén de sesiones de
// `web` (`net/session_store`): SQLite (M350) y PostgreSQL (M352), con el MISMO actor y el mismo
// esquema — `ray_sessions(sid, key, value, expires_at)` — y el dialecto como único punto de
// variación (marcadores `?n` / `$n`). Una fibra dueña de la conexión atiende el protocolo, así la
// conexión no se comparte; con un pool de Postgres cada orden toma una conexión del pool (varias
// réplicas sobre la misma base comparten las sesiones).
import db/sqlite;
import db/postgres;
import net/session_store;
from net/session_store import SessionStore, Msg;

// La conexión que posee el actor.
enum Db {
    Sqlite(sqlite.Conn),
    Pg(postgres.Conn),
    PgPool(postgres.Pool),
}

/// A session store on SQLite: `sessions.sqlite(conn, ttl_s)` creates the `ray_sessions` table if
/// needed and serves it from an owner fiber. `ttl_s` seconds of inactivity expire a session (`0` =
/// never); expired sessions are swept every minute. Hand the result to `web.sessions_with`.
pub fn sqlite(c: sqlite.Conn, ttl_s: int) -> Result<SessionStore, string> {
    start(Db.Sqlite(c), ttl_s)
}

/// A session store on PostgreSQL over one connection (M352): same table and behaviour as `sqlite`.
/// For a server with several workers prefer `postgres_pool`.
pub fn postgres(c: postgres.Conn, ttl_s: int) -> Result<SessionStore, string> {
    start(Db.Pg(c), ttl_s)
}

/// A session store on PostgreSQL over a `postgres.pool` (M352): every operation takes a connection
/// from the pool, so the store does not hold one hostage and survives a database restart (the pool
/// re-dials). Several replicas on the same database share the sessions.
pub fn postgres_pool(p: postgres.Pool, ttl_s: int) -> Result<SessionStore, string> {
    start(Db.PgPool(p), ttl_s)
}

fn start(db: Db, ttl_s: int) -> Result<SessionStore, string> {
    // SQL portable a servidores antiguos (sin `IF NOT EXISTS`, 9.1/9.5+, ni `ON CONFLICT`, 9.5+): se
    // crea y, si ya existía, se ignora el error; el upsert es UPDATE y, si no tocó filas, INSERT (el
    // actor serializa las órdenes, así que no hay carrera entre los dos pasos).
    ensure(
        exec(
            db,
            "CREATE TABLE ray_sessions (sid TEXT NOT NULL, key TEXT NOT NULL, value TEXT NOT NULL, expires_at BIGINT NOT NULL, PRIMARY KEY (sid, key))",
            []
        )
    )?;
    ensure(exec(db, "CREATE INDEX ray_sessions_exp ON ray_sessions (expires_at)", []))?;
    let ch: Channel<Msg> = Channel.new();
    spawn(fn() {
        actor(db, ch);
    });
    let st = session_store.from_channel(ch, ttl_s);
    if (ttl_s > 0) {
        session_store.start_sweeper(st, 60);
    }
    Result.Ok(st)
}

// Un CREATE que falla porque el objeto ya existe no es un error.
fn ensure(r: Result<int, string>) -> Result<int, string> {
    match (r) {
        Result.Ok(n) => Result.Ok(n),
        Result.Err(e) => if (e.to_lower().contains("already exists")) {
            Result.Ok(0)
        } else {
            Result.Err(e)
        },
    }
}

// El SQL se escribe con `$n` (Postgres); SQLite entiende `?n`.
fn dialect(db: Db, sql: string) -> string {
    match (db) {
        Db.Sqlite(_) => sql.replace("$", "?"),
        _ => sql,
    }
}

fn exec(db: Db, sql: string, params: [string]) -> Result<int, string> {
    let q = dialect(db, sql);
    match (db) {
        Db.Sqlite(c) => sqlite.exec(c, q, params),
        Db.Pg(c) => postgres.exec(c, q, params),
        Db.PgPool(p) => postgres.pool_exec(p, q, params),
    }
}

fn query(db: Db, sql: string, params: [string]) -> Result<[[string]], string> {
    let q = dialect(db, sql);
    match (db) {
        Db.Sqlite(c) => sqlite.query(c, q, params),
        Db.Pg(c) => postgres.query(c, q, params),
        Db.PgPool(p) => postgres.pool_query(p, q, params),
    }
}

fn actor(db: Db, ch: Channel<Msg>) {
    var running = true;
    while (running) {
        match (recv(ch)) {
            Option.Some(msg) => {
                match (msg) {
                    Msg.Get(sid, key, reply) => {
                        let now = to_string(session_store.now_s());
                        let v = match (query(
                            db,
                            "SELECT value FROM ray_sessions WHERE sid = $1 AND key = $2 AND (expires_at = 0 OR expires_at > $3)",
                            [sid, key, now]
                        )) {
                            Result.Ok(rows) => if (rows.len() > 0) {
                                Option.Some(rows[0][0])
                            } else {
                                Option.None
                            },
                            Result.Err(e) => {
                                eprint("sessions: " + e);
                                Option.None
                            },
                        };
                        send(reply, v);
                    },
                    Msg.Set(sid, key, value, expires_at) => {
                        let exp = to_string(expires_at);
                        let updated = report(
                            exec(
                                db,
                                "UPDATE ray_sessions SET value = $3, expires_at = $4 WHERE sid = $1 AND key = $2",
                                [sid, key, value, exp]
                            )
                        );
                        if (updated == 0) {
                            let _ = report(
                                exec(
                                    db,
                                    "INSERT INTO ray_sessions (sid, key, value, expires_at) VALUES ($1, $2, $3, $4)",
                                    [sid, key, value, exp]
                                )
                            );
                        }
                        // TTL deslizante: toda la sesión se renueva.
                        let _ = report(
                            exec(
                                db,
                                "UPDATE ray_sessions SET expires_at = $2 WHERE sid = $1",
                                [sid, exp]
                            )
                        );
                    },
                    Msg.Delete(sid, key) => {
                        let _ = report(
                            exec(
                                db,
                                "DELETE FROM ray_sessions WHERE sid = $1 AND key = $2",
                                [sid, key]
                            )
                        );
                    },
                    Msg.Drop(sid) => {
                        let _ = report(exec(db, "DELETE FROM ray_sessions WHERE sid = $1", [sid]));
                    },
                    Msg.Sweep(now, reply) => {
                        let n = report(
                            exec(
                                db,
                                "DELETE FROM ray_sessions WHERE expires_at <> 0 AND expires_at <= $1",
                                [to_string(now)]
                            )
                        );
                        send(reply, n);
                    },
                }
            },
            Option.None => {
                running = false;
            },
        }
    }
}

fn report(r: Result<int, string>) -> int {
    match (r) {
        Result.Ok(n) => n,
        Result.Err(e) => {
            eprint("sessions: " + e);
            0
        },
    }
}
