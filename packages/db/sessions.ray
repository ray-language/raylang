// db/sessions — M350 (IDEAS §102 R9): el backend SQLite del almacén de sesiones de `web`
// (`net/session_store`). Una tabla `ray_sessions(sid, key, value, expires_at)`; una fibra dueña de la
// conexión atiende el protocolo (SQLite serializa de todos modos, y así la `Conn` no se comparte).
// Las sesiones sobreviven al reinicio del servidor y se comparten entre réplicas que monten el
// mismo archivo (o, mañana, el mismo Postgres con el mismo esquema).
import db/sqlite;
import net/session_store;
from net/session_store import SessionStore, Msg;

/// A session store on SQLite: `sessions.sqlite(conn, ttl_s)` creates the `ray_sessions` table if
/// needed and serves it from an owner fiber. `ttl_s` seconds of inactivity expire a session (`0` =
/// never); expired sessions are swept every minute. Hand the result to `web.sessions_with`.
pub fn sqlite(c: sqlite.Conn, ttl_s: int) -> Result<SessionStore, string> {
    let _ = sqlite.exec(
        c,
        "CREATE TABLE IF NOT EXISTS ray_sessions (sid TEXT NOT NULL, key TEXT NOT NULL, value TEXT NOT NULL, expires_at INTEGER NOT NULL, PRIMARY KEY (sid, key))",
        []
    )?;
    let _ = sqlite.exec(
        c,
        "CREATE INDEX IF NOT EXISTS ray_sessions_exp ON ray_sessions (expires_at)",
        []
    )?;
    let ch: Channel<Msg> = Channel.new();
    spawn(fn() {
        actor(c, ch);
    });
    let st = session_store.from_channel(ch, ttl_s);
    if (ttl_s > 0) {
        session_store.start_sweeper(st, 60);
    }
    Result.Ok(st)
}

fn actor(c: sqlite.Conn, ch: Channel<Msg>) {
    var running = true;
    while (running) {
        match (recv(ch)) {
            Option.Some(msg) => {
                match (msg) {
                    Msg.Get(sid, key, reply) => {
                        let now = to_string(session_store.now_s());
                        let v = match (sqlite.query(
                            c,
                            "SELECT value FROM ray_sessions WHERE sid = ?1 AND key = ?2 AND (expires_at = 0 OR expires_at > ?3)",
                            [sid, key, now]
                        )) {
                            Result.Ok(rows) => if (rows.len() > 0) {
                                Option.Some(rows[0][0])
                            } else {
                                Option.None
                            },
                            Result.Err(e) => {
                                eprint("sessions: " + e);
                                Option.None
                            },
                        };
                        send(reply, v);
                    },
                    Msg.Set(sid, key, value, expires_at) => {
                        let _ = report(
                            sqlite.exec(
                                c,
                                "INSERT INTO ray_sessions (sid, key, value, expires_at) VALUES (?1, ?2, ?3, ?4) ON CONFLICT(sid, key) DO UPDATE SET value = excluded.value, expires_at = excluded.expires_at",
                                [sid, key, value, to_string(expires_at)]
                            )
                        );
                        // TTL deslizante: toda la sesión se renueva.
                        let _ = report(
                            sqlite.exec(
                                c,
                                "UPDATE ray_sessions SET expires_at = ?2 WHERE sid = ?1",
                                [sid, to_string(expires_at)]
                            )
                        );
                    },
                    Msg.Delete(sid, key) => {
                        let _ = report(
                            sqlite.exec(
                                c,
                                "DELETE FROM ray_sessions WHERE sid = ?1 AND key = ?2",
                                [sid, key]
                            )
                        );
                    },
                    Msg.Drop(sid) => {
                        let _ = report(
                            sqlite.exec(c, "DELETE FROM ray_sessions WHERE sid = ?1", [sid])
                        );
                    },
                    Msg.Sweep(now, reply) => {
                        let n = report(
                            sqlite.exec(
                                c,
                                "DELETE FROM ray_sessions WHERE expires_at <> 0 AND expires_at <= ?1",
                                [to_string(now)]
                            )
                        );
                        send(reply, n);
                    },
                }
            },
            Option.None => {
                running = false;
            },
        }
    }
}

fn report(r: Result<int, string>) -> int {
    match (r) {
        Result.Ok(n) => n,
        Result.Err(e) => {
            eprint("sessions: " + e);
            0
        },
    }
}
