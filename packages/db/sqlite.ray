// Cliente SQLite (M53.4) — base de datos EMBEBIDA, sin servidor ni socket.
//
// A diferencia de `db/mysql` y `db/postgres` (protocolo wire en raylang puro), SQLite es una
// librería C: los primitivos `__sqlite_*` viven en el host sobre `rusqlite` (patrón `ring`/M43 —
// el binding maduro resuelve dobles punteros, lifetimes de statements y destructores de bind, que
// envueltos a mano serían peor ingeniería). SQLite va COMPILADO dentro del binario (`bundled`):
// cero dependencias del sistema, versión determinista.
//
// API uniforme con los otros dos clientes: `connect` → `Conn`, `query`/`exec` (con
// `params: [string]`: marcadores `?1`, `?2`, … enlazados aparte del SQL → anti-inyección),
// `disconnect`. Las transacciones son SQL corriente: `exec(c, "BEGIN", [])` / `"COMMIT"` /
// `"ROLLBACK"`. Las celdas llegan como texto (INTEGER/REAL → repr decimal, NULL → "", BLOB → hex).
/// An open SQLite database. The handle lives in the host's process registry (like file handles);
/// `disconnect` closes it. `":memory:"` opens an in-memory database.
///
/// **Fibers and threads.** A `Conn` may be used from any fiber or task, VM and native alike: the
/// runtime serializes every `exec`/`query` on the handle (each call holds the registry lock for
/// its whole prepare→bind→step→finalize cycle; no statement outlives a call). Two consequences:
/// a single `Conn` shared by many fibers is SAFE but gives no parallelism (calls queue up), and a
/// multi-statement transaction (`BEGIN` … `COMMIT`) is only yours if no other fiber touches the
/// same `Conn` in between — give each transaction its own connection. For concurrent fibers use
/// `net/pool` (`pool.new<Conn>(n)` + `pool.run`, one `Conn` per slot, dialed with `connect`);
/// SQLite itself locks the file per write, so reads scale and writes serialize. The bundled
/// SQLite runs in its serialized threading mode.
pub struct Conn {
    handle: int,
}

// Decodifica el handle del arreglo etiquetado de `__sqlite_open` (viene como string).
fn parse_handle(s: string) -> int {
    return match (parse_int(s)) {
        Option.Some(n) => n,
        Option.None => {
            panic("corrupt SQLite handle: " + s);
        },
    };
}

/// Opens (or creates) the database at `path` (`":memory:"` = in-memory). Returns a connection or
/// an error message. The `Conn` may be used from any fiber (the runtime serializes every call on
/// it); for parallel work or transactions see the notes on `Conn` and use `net/pool` or one
/// connection per transaction.
pub fn connect(path: string) -> Result<Conn, string> {
    let r = __sqlite_open(path);
    if (r[0] != "ok") {
        return Result.Err(r[1]);
    }
    Result.Ok(Conn { handle: parse_handle(r[1]) })
}

/// Runs a statement that returns no rows (INSERT/UPDATE/DELETE/DDL/BEGIN/…) with positional
/// parameters (`?1`, `?2`, … bound as text). Returns the number of affected rows.
pub fn exec(c: Conn, sql: string, params: [string]) -> Result<int, string> {
    let r = __sqlite_exec(c.handle, sql, params);
    if (r[0] != "ok") {
        return Result.Err(r[1]);
    }
    return match (parse_int(r[1])) {
        Option.Some(n) => Result.Ok(n),
        Option.None => Result.Err("corrupt SQLite response: " + r[1]),
    };
}

/// Runs a query with positional parameters and returns all rows as text cells
/// (NULL becomes `""`, BLOB becomes hex). A `NULL` is therefore indistinguishable from an empty
/// string here: use `query_opt` when the difference matters.
pub fn query(c: Conn, sql: string, params: [string]) -> Result<[[string]], string> {
    let r = __sqlite_query(c.handle, sql, params);
    if (r[0] != "ok") {
        return Result.Err(r[1]);
    }
    // r = ["ok", ncols, celda0, celda1, …]: las celdas vienen aplanadas fila a fila.
    let ncols = match (parse_int(r[1])) {
        Option.Some(n) => n,
        Option.None => {
            return Result.Err("corrupt SQLite response: " + r[1]);
        },
    };
    var rows: [[string]] = [];
    if (ncols == 0) {
        return Result.Ok(rows);
    }
    var i = 2;
    while (i < r.len()) {
        var row: [string] = [];
        var j = 0;
        while (j < ncols) {
            row.push(r[i + j]);
            j = j + 1;
        }
        rows.push(row);
        i = i + ncols;
    }
    Result.Ok(rows)
}

// M347 (rayauth R6): la misma consulta, pero distinguiendo NULL — el primitivo añade una máscara de
// 'n'/'v' por celda delante de las celdas.
/// Like `query`, but every cell is an `Option<string>`: `None` for SQL `NULL`, `Some(text)`
/// otherwise (same text conversion as `query`). The way to tell a NULL from an empty string.
pub fn query_opt(c: Conn, sql: string, params: [string]) -> Result<[[Option<string>]], string> {
    let r = __sqlite_query_nulls(c.handle, sql, params);
    if (r[0] != "ok") {
        return Result.Err(r[1]);
    }
    // r = ["ok", ncols, mask, celda0, celda1, …]; mask[k] == 'n' ⇔ la celda k era NULL.
    let ncols = match (parse_int(r[1])) {
        Option.Some(n) => n,
        Option.None => {
            return Result.Err("corrupt SQLite response: " + r[1]);
        },
    };
    let mask = r[2];
    var rows: [[Option<string>]] = [];
    if (ncols == 0) {
        return Result.Ok(rows);
    }
    var i = 3;
    var k = 0;
    while (i < r.len()) {
        var row: [Option<string>] = [];
        var j = 0;
        while (j < ncols) {
            row.push(if (mask[k] == 'n') { Option.None } else { Option.Some(r[i + j]) });
            j = j + 1;
            k = k + 1;
        }
        rows.push(row);
        i = i + ncols;
    }
    Result.Ok(rows)
}

/// The rowid generated by the last successful INSERT on this connection. Pure SQL under the
/// hood (`SELECT last_insert_rowid()` runs on the same connection), so it needs no host support.
pub fn last_insert_rowid(c: Conn) -> Result<int, string> {
    let no_args: [string] = [];
    let rows = query(c, "SELECT last_insert_rowid()", no_args)?;
    if (rows.len() == 0 || rows[0].len() == 0) {
        return Result.Err("empty SQLite response");
    }
    return match (parse_int(rows[0][0])) {
        Option.Some(n) => Result.Ok(n),
        Option.None => Result.Err("corrupt SQLite response: " + rows[0][0]),
    };
}

/// Closes the database (releases the handle; further calls on this connection fail cleanly).
pub fn disconnect(c: Conn) {
    close(c.handle);
}
