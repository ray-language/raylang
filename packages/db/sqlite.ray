// Cliente SQLite (M53.4) — base de datos EMBEBIDA, sin servidor ni socket.
//
// A diferencia de `db/mysql` y `db/postgres` (protocolo wire en raylang puro), SQLite es una
// librería C: los primitivos `__sqlite_*` viven en el host sobre `rusqlite` (patrón `ring`/M43 —
// el binding maduro resuelve dobles punteros, lifetimes de statements y destructores de bind, que
// envueltos a mano serían peor ingeniería). SQLite va COMPILADO dentro del binario (`bundled`):
// cero dependencias del sistema, versión determinista.
//
// API uniforme con los otros dos clientes: `connect` → `Conn`, `query`/`exec` (con
// `params: [string]`: marcadores `?1`, `?2`, … enlazados aparte del SQL → anti-inyección),
// `disconnect`. Las transacciones son SQL corriente: `exec(c, "BEGIN", [])` / `"COMMIT"` /
// `"ROLLBACK"`. Las celdas llegan como texto (INTEGER/REAL → repr decimal, NULL → "", BLOB → hex).
import std/time;

/// An open SQLite database. The handle lives in the host's process registry (like file handles);
/// `disconnect` closes it. `":memory:"` opens an in-memory database.
///
/// **Fibers and threads.** A `Conn` may be used from any fiber or task, VM and native alike: the
/// runtime serializes every `exec`/`query` on the handle (each call holds the registry lock for
/// its whole prepare→bind→step→finalize cycle; no statement outlives a call). Two consequences:
/// a single `Conn` shared by many fibers is SAFE but gives no parallelism (calls queue up), and a
/// multi-statement transaction (`BEGIN` … `COMMIT`) is only yours if no other fiber touches the
/// same `Conn` in between — give each transaction its own connection. For concurrent fibers use
/// `net/pool` (`pool.new<Conn>(n)` + `pool.run`, one `Conn` per slot, dialed with `connect`);
/// SQLite itself locks the file per write, so reads scale and writes serialize. The bundled
/// SQLite runs in its serialized threading mode.
///
/// **Waiting for a lock.** When another connection holds the write lock, a call RETRIES for up to
/// the connection's busy timeout — 5 s by default; change it with `busy_timeout(c, ms)` or the
/// usual `PRAGMA busy_timeout = 2000` (through `exec` or `query`, on its own or inside a script),
/// 0 = fail at once — and then fails with `database is locked`. Between attempts the fiber is
/// parked, so the fiber that holds the lock keeps running (db 0.11 on raylang 1.27.114; on an
/// older toolchain the wait is SQLite's own, as before, and holds the thread).
/// - A multi-statement script that finds the lock halfway waits the same way and then goes on
///   from the statement that found it; the ones before it are not run again. If the timeout
///   passes, the error says that part of the script had run (a `BEGIN` it ran is still open).
/// - A transaction that has already read and now wants to write while another connection holds
///   the write lock is not waited for: waiting cannot help (SQLite reports it at once). The error
///   reads `database is locked (not waited for: …)`: roll back and retry, or start such
///   transactions with `BEGIN IMMEDIATE`.
///
/// **A call that waits keeps its connection.** While a call is parked waiting for a lock, other
/// fibers that share the `Conn` wait for it to finish: nothing else runs on its connection in the
/// middle of it. That holds per CALL, not per transaction — a transaction spread over several
/// calls still wants its own connection.
pub struct Conn {
    handle: int,
}

fn parse_handle(s: string) -> int {
    return match (parse_int(s)) {
        Option.Some(n) => n,
        Option.None => {
            panic("corrupt SQLite handle: " + s);
        },
    };
}

/// Opens (or creates) the database at `path` (`":memory:"` = in-memory). Returns a connection or
/// an error message. The `Conn` may be used from any fiber (the runtime serializes every call on
/// it); for parallel work or transactions see the notes on `Conn` and use `net/pool` or one
/// connection per transaction.
pub fn connect(path: string) -> Result<Conn, string> {
    let r = __sqlite_open(path);
    if (r[0] != "ok") {
        return Result.Err(r[1]);
    }
    let handle = parse_handle(r[1]);
    // Pide al runtime el modo «aparcado»: un candado deja de esperarse dentro de SQLite (reteniendo
    // el hilo) y lo espera este módulo, aparcando la fibra (ver `Conn`).
    let no_args: [string] = [];
    let _ = __sqlite_exec(handle, "PRAGMA ray_busy_wait = park", no_args);
    Result.Ok(Conn { handle: handle })
}

/// Sets how long (ms) the calls on this connection wait for a database locked by another
/// connection before failing with `database is locked` (5000 by default); 0 fails at once. The
/// wait parks the fiber, so other fibers — the lock holder included — keep running. The same as
/// `exec(c, "PRAGMA busy_timeout = <ms>", [])`.
pub fn busy_timeout(c: Conn, ms: int) {
    let no_args: [string] = [];
    let _ = __sqlite_exec(c.handle, "PRAGMA busy_timeout = " + to_string(if (ms < 0) {
        // SQLite lee un entero de 32 bits: más allá lo tomaría por 0 («falla en el acto»).
        0
    } else if (ms > 2147483647) {
        2147483647
    } else {
        ms
    }), no_args);
}

// El plazo de la conexión, que lleva el runtime (es quien ve cada `PRAGMA busy_timeout`, llegue
// por donde llegue). Solo se pregunta cuando una llamada se topa con un candado.
fn busy_ms(c: Conn) -> int {
    let no_args: [string] = [];
    let r = __sqlite_query(c.handle, "PRAGMA busy_timeout", no_args);
    if (r[0] != "ok" || r.len() < 3) {
        return 0;
    }
    parse_int(r[2]).unwrap_or(0)
}

// La espera de una llamada cuya primera respuesta (`first`) no fue `ok`. `call` recibe el SQL a
// ejecutar y devuelve la respuesta etiquetada del primitivo:
// - `["busy", C, N, prefix]`: encontró un candado que se puede esperar. Si era un script, aplicó
//   sus primeras sentencias (N filas) y la que lo encontró empieza en el carácter C. La conexión
//   queda RESERVADA para esta llamada, que se identifica anteponiendo `prefix` al SQL: se aparca
//   la fibra (1, 2, 4… hasta 50 ms) y se repite con el resto del texto, hasta el plazo. Por dónde
//   va lo guarda ESTA función, en la pila de la fibra; la conexión no recuerda el script.
// - `["turn"]`: otra llamada tiene la conexión reservada mientras espera: se aparca y se repite.
// - cualquier otra cosa es la respuesta final. Un `ok` tras reanudar lleva las filas de todo el
//   script.
fn waiting(c: Conn, sql: string, call: fn(string) -> [string], first: [string]) -> [string] {
    var r = first;
    var rest = sql;
    var prefix = "";
    var changed = 0;
    var resumed = false;
    var timed = false;
    var deadline = 0;
    var pause = 1;
    while (true) {
        if (r[0] == "busy") {
            let at = parse_int(r[1]).unwrap_or(0);
            if (at > 0) {
                rest = rest.substring(at, rest.len());
                changed = changed + parse_int(r[2]).unwrap_or(0);
                resumed = true;
                // Otra sentencia que espera: plazo nuevo (un PRAGMA del script pudo cambiarlo).
                timed = false;
            }
            prefix = r[3];
            if (!timed) {
                timed = true;
                deadline = time.monotonic() + busy_ms(c);
                pause = 1;
            }
            if (time.monotonic() >= deadline) {
                // Suelta la reserva: la conexión vuelve a ser de todos.
                let no_args: [string] = [];
                let _ = __sqlite_exec(c.handle, prefix + "PRAGMA ray_busy_wait = release", no_args);
                if (resumed) {
                    return [
                        "err",
                        "database is locked (part of the script had run; the rest did not run)"
                    ];
                }
                return ["err", "database is locked"];
            }
        } else if (r[0] != "turn") {
            if (resumed && r[0] == "ok") {
                return ["ok", to_string(changed + parse_int(r[1]).unwrap_or(0))];
            }
            return r;
        }
        time.sleep(pause);
        if (pause < 50) {
            pause = pause * 2;
        }
        r = call(prefix + rest);
    }
    ["err", "unreachable"]
}

// Los cuatro primitivos, esperando (ver `waiting`). Aparte de las funciones públicas a propósito:
// una función que contiene un cierre paga por sus variables capturadas en cada llamada, y el
// camino de siempre —sin candado— no debe pagarlo.
fn wait_exec(c: Conn, sql: string, params: [string], first: [string]) -> [string] {
    waiting(c, sql, fn(rest: string) -> [string] { __sqlite_exec(c.handle, rest, params) }, first)
}

fn wait_exec_opt(
    c: Conn,
    sql: string,
    values: [string],
    mask: string,
    first: [string]
) -> [string] {
    waiting(
        c,
        sql,
        fn(rest: string) -> [string] { __sqlite_exec_opt(c.handle, rest, values, mask) },
        first
    )
}

fn wait_query(c: Conn, sql: string, params: [string], first: [string]) -> [string] {
    waiting(c, sql, fn(rest: string) -> [string] { __sqlite_query(c.handle, rest, params) }, first)
}

fn wait_query_nulls(c: Conn, sql: string, params: [string], first: [string]) -> [string] {
    waiting(
        c,
        sql,
        fn(rest: string) -> [string] { __sqlite_query_nulls(c.handle, rest, params) },
        first
    )
}

/// Runs SQL that returns no rows (INSERT/UPDATE/DELETE/DDL/BEGIN/PRAGMA/…) and returns the
/// number of affected rows. With parameters (`?1`, `?2`, … bound as text) the SQL must be ONE
/// statement — more is an `Err` before anything runs. Without parameters every statement runs in
/// order, like a migration script (`"CREATE TABLE a (…); CREATE TABLE b (…);"`); rows a statement
/// returns (a `PRAGMA`, a `SELECT`) are discarded, and the count is the sum. If one fails, the
/// ones before it stay applied: wrap a script in `BEGIN; …; COMMIT;` to make it all-or-nothing.
/// Needs raylang 1.27.80 (before, only the first statement ran and the call returned `Ok`).
pub fn exec(c: Conn, sql: string, params: [string]) -> Result<int, string> {
    var r = __sqlite_exec(c.handle, sql, params);
    if (r[0] != "ok") {
        r = wait_exec(c, sql, params, r);
        if (r[0] != "ok") {
            return Result.Err(r[1]);
        }
    }
    return match (parse_int(r[1])) {
        Option.Some(n) => Result.Ok(n),
        Option.None => Result.Err("corrupt SQLite response: " + r[1]),
    };
}

/// Like `exec`, with parameters that may be SQL `NULL`: `Option.None` binds `NULL`,
/// `Option.Some(text)` binds the text (rayreq #248) — an optional foreign key without writing
/// `NULL` into the SQL. Same one-statement rule as `exec` with parameters. Needs raylang 1.27.81 (db 0.6).
pub fn exec_opt(c: Conn, sql: string, params: [Option<string>]) -> Result<int, string> {
    var values: [string] = [];
    var mask = "";
    for p in params {
        match (p) {
            Option.Some(v) => {
                values.push(v);
                mask = mask + "v";
            },
            Option.None => {
                values.push("");
                mask = mask + "n";
            },
        }
    }
    var r = __sqlite_exec_opt(c.handle, sql, values, mask);
    if (r[0] != "ok") {
        r = wait_exec_opt(c, sql, values, mask, r);
        if (r[0] != "ok") {
            return Result.Err(r[1]);
        }
    }
    return match (parse_int(r[1])) {
        Option.Some(n) => Result.Ok(n),
        Option.None => Result.Err("corrupt SQLite response: " + r[1]),
    };
}

/// Runs a query with positional parameters and returns all rows as text cells
/// (NULL becomes `""`, BLOB becomes hex). A `NULL` is therefore indistinguishable from an empty
/// string here: use `query_opt` when the difference matters.
pub fn query(c: Conn, sql: string, params: [string]) -> Result<[[string]], string> {
    var r = __sqlite_query(c.handle, sql, params);
    if (r[0] != "ok") {
        r = wait_query(c, sql, params, r);
        if (r[0] != "ok") {
            return Result.Err(r[1]);
        }
    }
    // r = ["ok", ncols, celda0, celda1, …]: las celdas vienen aplanadas fila a fila.
    let ncols = match (parse_int(r[1])) {
        Option.Some(n) => n,
        Option.None => {
            return Result.Err("corrupt SQLite response: " + r[1]);
        },
    };
    var rows: [[string]] = [];
    if (ncols == 0) {
        return Result.Ok(rows);
    }
    var i = 2;
    while (i < r.len()) {
        var row: [string] = [];
        var j = 0;
        while (j < ncols) {
            row.push(r[i + j]);
            j = j + 1;
        }
        rows.push(row);
        i = i + ncols;
    }
    Result.Ok(rows)
}

// M347 (rayauth R6): la misma consulta, pero distinguiendo NULL — el primitivo añade una máscara de
// 'n'/'v' por celda delante de las celdas.
/// Like `query`, but every cell is an `Option<string>`: `None` for SQL `NULL`, `Some(text)`
/// otherwise (same text conversion as `query`). The way to tell a NULL from an empty string.
pub fn query_opt(c: Conn, sql: string, params: [string]) -> Result<[[Option<string>]], string> {
    var r = __sqlite_query_nulls(c.handle, sql, params);
    if (r[0] != "ok") {
        r = wait_query_nulls(c, sql, params, r);
        if (r[0] != "ok") {
            return Result.Err(r[1]);
        }
    }
    // r = ["ok", ncols, mask, celda0, celda1, …]; mask[k] == 'n' ⇔ la celda k era NULL.
    let ncols = match (parse_int(r[1])) {
        Option.Some(n) => n,
        Option.None => {
            return Result.Err("corrupt SQLite response: " + r[1]);
        },
    };
    let mask = r[2];
    var rows: [[Option<string>]] = [];
    if (ncols == 0) {
        return Result.Ok(rows);
    }
    var i = 3;
    var k = 0;
    while (i < r.len()) {
        var row: [Option<string>] = [];
        var j = 0;
        while (j < ncols) {
            row.push(if (mask[k] == 'n') { Option.None } else { Option.Some(r[i + j]) });
            j = j + 1;
            k = k + 1;
        }
        rows.push(row);
        i = i + ncols;
    }
    Result.Ok(rows)
}

/// The rowid generated by the last successful INSERT on this connection. Pure SQL under the
/// hood (`SELECT last_insert_rowid()` runs on the same connection), so it needs no host support.
pub fn last_insert_rowid(c: Conn) -> Result<int, string> {
    let no_args: [string] = [];
    let rows = query(c, "SELECT last_insert_rowid()", no_args)?;
    if (rows.len() == 0 || rows[0].len() == 0) {
        return Result.Err("empty SQLite response");
    }
    return match (parse_int(rows[0][0])) {
        Option.Some(n) => Result.Ok(n),
        Option.None => Result.Err("corrupt SQLite response: " + rows[0][0]),
    };
}

/// Closes the database (releases the handle; further calls on this connection fail cleanly).
pub fn disconnect(c: Conn) {
    close(c.handle);
}
