// Cookies HTTP escritas EN raylang. Cero runtime nuevo. Parsea la cabecera `Cookie:` de petición y
// construye valores `Set-Cookie:` de respuesta. Importable:
//   from cookie import parse_cookies, cookie, set_cookie, with_path, with_max_age, with_http_only, with_secure;

from std/url import url_encode, url_decode;

// `url_decode` tolerante (devuelve el crudo si falla).
fn decode_or(s: string) -> string {
    match (url_decode(s)) {
        Result.Ok(v) => v,
        Result.Err(_) => s,
    }
}

// Parsea la cabecera de petición `Cookie: a=1; b=hola%20mundo` en un `Map<string,string>`.
pub fn parse_cookies(header: string) -> Map<string, string> {
    var m: Map<string, string> = map_new();
    let parts = split(header, ";");
    var i = 0;
    while (i < len(parts)) {
        let p = trim(parts[i]);
        if (len(p) > 0) {
            match (index_of(p, "=")) {
                Option.Some(eq) => {
                    let k = trim(substring(p, 0, eq));
                    let v = decode_or(trim(substring(p, eq + 1, len(p))));
                    insert(m, k, v);
                },
                Option.None => {},
            }
        }
        i = i + 1;
    }
    m
}

// Una cookie a emitir (`Set-Cookie`). Los atributos opcionales se ponen con los setters `with_*`,
// encadenables vía UFCS: `cookie("sid","abc").with_path("/").with_http_only()`.
struct Cookie {
    name: string,
    value: string,
    path: string,
    max_age: int,  // < 0 = sin Max-Age
    http_only: bool,
    secure: bool,
}

// Crea una cookie con solo nombre y valor (sin atributos).
pub fn cookie(name: string, value: string) -> Cookie {
    Cookie { name: name, value: value, path: "", max_age: 0 - 1, http_only: false, secure: false }
}

// Setters encadenables (mutan por referencia y devuelven la cookie). Nombres `with_*` para no chocar
// con los campos homónimos (en UFCS el campo ganaría a la función).
pub fn with_path(c: Cookie, p: string) -> Cookie { c.path = p; c }
pub fn with_max_age(c: Cookie, n: int) -> Cookie { c.max_age = n; c }
pub fn with_http_only(c: Cookie) -> Cookie { c.http_only = true; c }
pub fn with_secure(c: Cookie) -> Cookie { c.secure = true; c }

// Serializa la cookie a un valor de cabecera `Set-Cookie`. El valor se url-codifica.
pub fn set_cookie(c: Cookie) -> string {
    var s = c.name + "=" + url_encode(c.value);
    if (len(c.path) > 0) {
        s = s + "; Path=" + c.path;
    }
    if (c.max_age >= 0) {
        s = s + "; Max-Age=" + to_string(c.max_age);
    }
    if (c.http_only) {
        s = s + "; HttpOnly";
    }
    if (c.secure) {
        s = s + "; Secure";
    }
    s
}
