// Cripto de PRODUCCIÓN para el paquete `net` (M43.5). Adaptadores finos sobre los builtins de `ring`
// (`sha256`/`sha512`/`sha1`/`hmac_sha256`/`ed25519_*`/`chacha20poly1305_*`) que presentan la API en
// `[int]`/hex que los módulos del `net` ya consumían de la cripto pura. Reemplaza a esa cripto pura
// (`examples/web/sha256.ray`, etc.), que queda SOLO como demostración del lenguaje: aquí las operaciones
// son de **tiempo constante y auditadas** (requisito para tocar secretos reales), no bit-twiddling sobre
// la VM. Nombres distintos de los builtins a propósito: un builtin gana a una función homónima, así que
// un envoltorio con el mismo nombre quedaría muerto (por eso `hmac_sha256_octets`, `sha1_octets`, `ed_*`).

// Octetos (`[int]`) de un `bytes`. El puente entre el mundo `bytes` de los builtins y el `[int]` del `net`.
fn octetos(b: bytes) -> [int] {
    var out: [int] = [];
    var i = 0;
    while (i < len(b)) {
        push(out, b[i]);
        i = i + 1;
    }
    out
}

// --- Hashes ---

// SHA-256 de un mensaje dado como octetos, devuelto como octetos (como el `sha256_octets` pedagógico).
pub fn sha256_octets(msg: [int]) -> [int] {
    octetos(sha256(bytes_of(msg)))
}

// SHA-256 en hexadecimal (`to_string` de un `bytes` ya da hex).
pub fn sha256_hex(msg: bytes) -> string {
    to_string(sha256(msg))
}

// SHA-1 (legado; solo para el accept-key de WebSocket, RFC 6455) como octetos.
pub fn sha1_octets(msg: bytes) -> [int] {
    octetos(sha1(msg))
}

// --- HMAC ---

// HMAC-SHA256 como octetos (renombrado desde `hmac_sha256` para no chocar con el builtin homónimo).
pub fn hmac_sha256_octets(key: bytes, msg: bytes) -> [int] {
    octetos(hmac_sha256(key, msg))
}

// HMAC-SHA256 en hexadecimal.
pub fn hmac_sha256_hex(key: bytes, msg: bytes) -> string {
    to_string(hmac_sha256(key, msg))
}

// --- Ed25519 (API en `[int]`, como la usaba `jwt_eddsa`) ---
//
// `ring` deriva la clave pública de la semilla al firmar, así que `ed_sign` NO recibe la clave pública
// (a diferencia del `ed25519_sign` pedagógico de 3 argumentos). La semilla son 32 octetos; una semilla
// de mal tamaño da `[]` (degradación honesta; los consumidores pasan semillas válidas).

pub fn ed_public_key(seed: [int]) -> [int] {
    match (ed25519_public_key(bytes_of(seed))) {
        Option.Some(pk) => octetos(pk),
        Option.None => [],
    }
}

pub fn ed_sign(seed: [int], msg: [int]) -> [int] {
    match (ed25519_sign(bytes_of(seed), bytes_of(msg))) {
        Option.Some(sig) => octetos(sig),
        Option.None => [],
    }
}

pub fn ed_verify(pubkey: [int], msg: [int], sig: [int]) -> bool {
    ed25519_verify(bytes_of(pubkey), bytes_of(msg), bytes_of(sig))
}
