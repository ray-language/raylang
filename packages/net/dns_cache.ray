// Caché DNS por TTL, escrita EN raylang. Cero runtime nuevo: envuelve el resolver `dns.ray` y guarda
// las respuestas hasta que caduca su TTL (el mínimo de la respuesta, en segundos, vía `query_full`).
// Importable: `from dns_cache import Cache, new_cache, resolve;`.
//
// Respeta el TTL como pide el DNS: una entrada se sirve de la caché mientras `now() < expiración`; al
// caducar (o si nunca se vio) se consulta y se reescribe. Clave de caché = "qtype:nombre". Lleva
// contadores de aciertos/fallos (útiles para métricas o para verificar el comportamiento).
from net/dns import Record, DnsResult, query_full;

/// A TTL-respecting DNS cache bound to one server. Entries are keyed by "qtype:name" and expire at
/// `now() + ttl` (the response's minimum TTL, in seconds). Tracks hit/miss counters for metrics.
pub struct Cache {
    server: string,
    port: int,
    keys: [string],
    records: [[Record]],
    expiry: [int],
    hits: int,
    misses: int,
}

// "qtype:nombre"
// registros cacheados por clave
// instante de expiración (ms epoch) por clave
/// Creates an empty cache that resolves against the DNS server at `server:port`.
pub fn new_cache(server: string, port: int) -> Cache {
    Cache { server: server, port: port, keys: [], records: [], expiry: [], hits: 0, misses: 0 }
}

fn find_key(c: Cache, key: string) -> int {
    var i = 0;
    while (i < len(c.keys)) {
        if (c.keys[i] == key) {
            return i;
        }
        i = i + 1;
    }
    0 - 1
}

// Resuelve `name`/`qtype` usando la caché: devuelve los registros cacheados si no han caducado, o
// consulta el servidor y los guarda con expiración `now() + ttl`.
/// Resolves `name`/`qtype` through the cache: returns the cached records if the entry has not expired
/// (counts a hit); otherwise queries the server, stores the result with expiry `now() + ttl`, and counts a miss.
/// Err comes from the underlying network query; a failed query does not overwrite an existing entry.
pub fn resolve(c: Cache, name: string, qtype: int) -> Result<[Record], string> {
    let key = to_string(qtype) + ":" + name;
    let idx = find_key(c, key);
    if (idx >= 0 && now() < c.expiry[idx]) {
        c.hits = c.hits + 1;
        return Result.Ok(c.records[idx]);
    }
    // Fallo de caché o entrada caducada → consultar y (re)guardar.
    match (query_full(c.server, c.port, name, qtype)) {
        Result.Err(e) => Result.Err(e),
        Result.Ok(res) => {
            c.misses = c.misses + 1;
            let exp = now() + res.ttl * 1000;
            if (idx >= 0) {
                c.records[idx] = res.records;
                c.expiry[idx] = exp;
            } else {
                push(c.keys, key);
                push(c.records, res.records);
                push(c.expiry, exp);
            }
            Result.Ok(res.records)
        },
    }
}

// Vacía la caché (descarta todas las entradas). Las asignaciones no propagan el tipo del campo a `[]`,
// así que se usan variables anotadas.
/// Empties the cache, discarding all entries. Hit/miss counters are preserved.
pub fn clear(c: Cache) {
    var ks: [string] = [];
    var rs: [[Record]] = [];
    var es: [int] = [];
    c.keys = ks;
    c.records = rs;
    c.expiry = es;
}
