// Cliente gRPC unario escrito EN raylang (cierra M31 / el diferido de M26+M25). gRPC = HTTP/2 +
// mensajes protobuf gRPC-framed en los frames DATA. Apila TODO lo construido: TLS+ALPN h2 (M31.2a),
// framing HTTP/2 (`http2.ray`) + HPACK (`hpack.ray`, M26), y protobuf + grpc_frame (`protobuf.ray`, M25).
//
// Una llamada unaria: HEADERS (POST /paquete.Servicio/Metodo, content-type application/grpc, te
// trailers) + DATA (grpc_frame(mensaje)) con END_STREAM; la respuesta trae HEADERS (:status) + DATA
// (mensaje gRPC-framed) + un HEADERS de **trailers** con `grpc-status`. Importable:
//   from grpc_client import grpc_call, GrpcResponse;
from net/http2 import preface, settings_empty, settings_ack, encode_frame, parse_frame, frame_size, window_update_frame, ping_ack, rst_error_code, ft_settings, ft_headers, ft_data, ft_goaway, ft_ping, ft_rst_stream, fl_ack, fl_end_stream, fl_end_headers, Http2Frame;
from net/hpack import new_hpack, encode, decode, header, HEntry;
from std/protobuf import grpc_frame, grpc_unframe;
import std/net;

// La respuesta de una llamada gRPC: el mensaje (bytes protobuf) y el `grpc-status` (0 = OK).
/// The response of a unary gRPC call: the serialized protobuf response message
/// and the `grpc-status` code from the trailers (0 = OK).
pub struct GrpcResponse {
    message: bytes,
    grpc_status: int,
}

// M73: topes anti-bomba. Un servidor malicioso/roto podría enviar frames DATA indefinidos (body
// crece sin cota) o declarar un frame gigante (hasta 16 MB en 24 bits) → agotamiento de memoria.
// El de respuesta es generoso (64 MiB, como M64.2); el de frame acota lo que se espera acumular.
fn max_response() -> int {
    67108864
}

fn max_frame() -> int {
    1048576  // 1 MiB por frame — muy por encima del max-frame por defecto de HTTP/2 (16 KiB)
}

// Extrae un header (por nombre) de una lista decodificada; "" si no está.
fn find_header(hs: [HEntry], name: string) -> string {
    var v = "";
    var i = 0;
    while (i < hs.len()) {
        if (hs[i].name == name) {
            v = hs[i].value;
        }
        i = i + 1;
    }
    v
}

// Hace una llamada gRPC unaria a `host:port` con la ruta `/paquete.Servicio/Metodo` y el `mensaje`
// protobuf ya serializado. Devuelve el mensaje de respuesta + el grpc-status.
/// Performs a unary gRPC call to `host:port` (TLS + ALPN `h2`, blocking I/O): POSTs the
/// gRPC-framed `message` to `path` ("/package.Service/Method") and reads until END_STREAM.
/// Err on connect/I-O/HPACK errors, GOAWAY, a non-200 `:status`, or a malformed gRPC frame.
pub fn grpc_call(host: string, port: int, path: string, message: bytes) -> Result<GrpcResponse, string> {
    let h = match (net.tls_connect_h2(host, port)) {
        Result.Ok(x) => x,
        Result.Err(e) => {
            return Result.Err(e);
        },
    };

    // HEADERS de la petición (sin END_STREAM: sigue un DATA con el mensaje).
    let enc = new_hpack();
    let reqhdrs = [header(":method", "POST"), header(":path", path), header(":scheme", "https"), header(":authority", host), header("te", "trailers"), header("content-type", "application/grpc"), header("user-agent", "grpc-raylang/1")];
    let block = encode(enc, reqhdrs);
    let hframe = encode_frame(ft_headers(), fl_end_headers(), 1, block);
    let dframe = encode_frame(ft_data(), fl_end_stream(), 1, grpc_frame(message));
    match (net.socket_write_bytes(h, preface() + settings_empty() + hframe + dframe)) {
        Result.Ok(n) => { },
        Result.Err(e) => {
            close(h);
            return Result.Err(e);
        },
    }

    // Respuesta.
    let dec = new_hpack();
    var buf = b"";
    var body = b"";  // acumulado de los DATA (mensaje gRPC-framed)
    var status = 0;
    var grpc_status = 0;
    var has_grpc_status = false;
    var done = false;
    while (!done) {
        match (net.socket_read_bytes(h)) {
            Result.Ok(chunk) => {
                if (chunk.len() == 0) {
                    done = true;
                }
                buf = buf + chunk;
            },
            Result.Err(e) => {
                close(h);
                return Result.Err(e);
            },
        }
        // M73: un frame que declara más que el tope se rechaza ANTES de acumular sus octetos.
        if (frame_size(buf) > max_frame()) {
            close(h);
            return Result.Err("HTTP/2 frame exceeds the limit (" + to_string(frame_size(buf)) + " bytes)");
        }
        while (frame_size(buf) > 0 && buf.len() >= frame_size(buf)) {
            let fsz = frame_size(buf);
            let fbytes = buf.sub_bytes(0, fsz);
            buf = buf.sub_bytes(fsz, buf.len());
            match (parse_frame(fbytes)) {
                Result.Ok(fr) => {
                    if (fr.ftype == ft_settings()) {
                        if ((fr.flags & fl_ack()) == 0) {
                            match (net.socket_write_bytes(h, settings_ack())) {
                                Result.Ok(x) => { },
                                Result.Err(e) => {
                                    close(h);
                                    return Result.Err(e);
                                },
                            }
                        }
                    } else if (fr.ftype == ft_headers()) {
                        // Puede ser el HEADERS inicial (:status) o el de trailers (grpc-status).
                        match (decode(dec, fr.payload)) {
                            Result.Ok(hs) => {
                                let st = find_header(hs, ":status");
                                if (st != "") {
                                    match (parse_int(st)) {
                                        Option.Some(n) => {
                                            status = n;
                                        },
                                        Option.None => {
                                            status = 0;
                                        },
                                    }
                                }
                                let gs = find_header(hs, "grpc-status");
                                if (gs != "") {
                                    has_grpc_status = true;
                                    match (parse_int(gs)) {
                                        Option.Some(n) => {
                                            grpc_status = n;
                                        },
                                        Option.None => {
                                            grpc_status = 0;
                                        },
                                    }
                                }
                            },
                            Result.Err(e) => {
                                close(h);
                                return Result.Err("HPACK: " + e);
                            },
                        }
                    } else if (fr.ftype == ft_data()) {
                        // M73: tope de respuesta acumulada (anti-bomba de memoria).
                        if (body.len() + fr.payload.len() > max_response()) {
                            close(h);
                            return Result.Err("gRPC response exceeds the limit (possible memory bomb)");
                        }
                        body = body + fr.payload;
                        // M58.3 — flow control: devolver la ventana consumida (conexión + stream).
                        // Best effort: si el peer ya envió todo y cerró, el crédito es irrelevante
                        // (el EOF/fin de stream sale por la lectura, no por esta escritura).
                        if (fr.payload.len() > 0) {
                            let wu = window_update_frame(0, fr.payload.len()) + window_update_frame(fr.stream_id, fr.payload.len());
                            match (net.socket_write_bytes(h, wu)) {
                                Result.Ok(x) => { },
                                Result.Err(x) => { },
                            }
                        }
                    } else if (fr.ftype == ft_ping()) {
                        // M58.3: ACK del PING del servidor (sonda de vida).
                        if ((fr.flags & fl_ack()) == 0) {
                            match (net.socket_write_bytes(h, ping_ack(fr.payload))) {
                                Result.Ok(x) => { },
                                Result.Err(x) => { },
                            }
                        }
                    } else if (fr.ftype == ft_rst_stream()) {
                        // M58.3: stream reseteado = error con causa (antes: leer hasta EOF).
                        if (fr.stream_id == 1) {
                            close(h);
                            return Result.Err("the server reset the stream (RST_STREAM, code " + to_string(rst_error_code(fr.payload)) + ")");
                        }
                    } else if (fr.ftype == ft_goaway()) {
                        close(h);
                        return Result.Err("the server sent GOAWAY");
                    }
                    if (fr.stream_id == 1 && (fr.flags & fl_end_stream()) != 0) {
                        done = true;
                    }
                },
                Result.Err(e) => {
                    close(h);
                    return Result.Err(e);
                },
            }
        }
    }
    close(h);

    if (status != 200) {
        return Result.Err("HTTP/2 status " + to_string(status));
    }
    // M73: un servidor gRPC SIEMPRE cierra con `grpc-status` en los trailers. Su ausencia
    // (protocolo violado, trailers truncados) era indistinguible de un OK (`tuvo_grpc_status`
    // se computaba pero no se leía) → ahora es un error explícito.
    if (!has_grpc_status) {
        return Result.Err("gRPC response without grpc-status in the trailers");
    }
    // Desenmarca el mensaje gRPC de la respuesta.
    match (grpc_unframe(body)) {
        Result.Ok(msg) => Result.Ok(GrpcResponse { message: msg, grpc_status: grpc_status }),
        Result.Err(e) => Result.Err("grpc: " + e),
    }
}
