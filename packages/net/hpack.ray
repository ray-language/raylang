// HPACK (RFC 7541) — compresión de cabeceras de HTTP/2, escrita EN raylang. Cero runtime nuevo. Es la
// parte difícil del transporte HTTP/2. Importable:
//   from hpack import HEntry, header, new_hpack, encode, decode;
//
// Cubre: tabla ESTÁTICA (61 entradas), tabla DINÁMICA (inserción + evicción por tamaño), enteros con
// prefijo de N bits (§5.1), literales de string SIN Huffman (§5.2), y las representaciones de campo:
// indexado, literal con indexado incremental, literal sin indexado / nunca indexado, y actualización de
// tamaño de la tabla. M133: el decodificador acepta literales **Huffman** (bit H=1; la tabla del
// RFC 7541 vive en std/huffman) — obligatorio contra servidores reales (grpc-go comprime siempre);
// el CODIFICADOR sigue emitiendo literales crudos (válidos). Verificado contra los vectores
// oficiales del RFC 7541 Apéndice C (C.2.1, C.3 crudos; C.4/C.6 con Huffman).
import std/huffman;

// Una cabecera (nombre, valor).
/// A single header field: a (name, value) pair, as used in HPACK header lists (RFC 7541).
pub struct HEntry {
    name: string,
    value: string,
}

/// Convenience constructor for an `HEntry` header field from a name and a value.
pub fn header(name: string, value: string) -> HEntry {
    HEntry { name: name, value: value }
}

// La tabla estática (RFC 7541 Apéndice A): el índice HPACK 1 es el elemento 0, etc.
fn static_table() -> [HEntry] {
    [
        header(":authority", ""),
        header(":method", "GET"),
        header(":method", "POST"),
        header(":path", "/"),
        header(":path", "/index.html"),
        header(":scheme", "http"),
        header(":scheme", "https"),
        header(":status", "200"),
        header(":status", "204"),
        header(":status", "206"),
        header(":status", "304"),
        header(":status", "400"),
        header(":status", "404"),
        header(":status", "500"),
        header("accept-charset", ""),
        header("accept-encoding", "gzip, deflate"),
        header("accept-language", ""),
        header("accept-ranges", ""),
        header("accept", ""),
        header("access-control-allow-origin", ""),
        header("age", ""),
        header("allow", ""),
        header("authorization", ""),
        header("cache-control", ""),
        header("content-disposition", ""),
        header("content-encoding", ""),
        header("content-language", ""),
        header("content-length", ""),
        header("content-location", ""),
        header("content-range", ""),
        header("content-type", ""),
        header("cookie", ""),
        header("date", ""),
        header("etag", ""),
        header("expect", ""),
        header("expires", ""),
        header("from", ""),
        header("host", ""),
        header("if-match", ""),
        header("if-modified-since", ""),
        header("if-none-match", ""),
        header("if-range", ""),
        header("if-unmodified-since", ""),
        header("last-modified", ""),
        header("link", ""),
        header("location", ""),
        header("max-forwards", ""),
        header("proxy-authenticate", ""),
        header("proxy-authorization", ""),
        header("range", ""),
        header("referer", ""),
        header("refresh", ""),
        header("retry-after", ""),
        header("server", ""),
        header("set-cookie", ""),
        header("strict-transport-security", ""),
        header("transfer-encoding", ""),
        header("user-agent", ""),
        header("vary", ""),
        header("via", ""),
        header("www-authenticate", "")
    ]
}

// El estado HPACK de un extremo: su tabla dinámica (más reciente primero) + el tamaño máximo y actual.
/// The HPACK state of one endpoint (RFC 7541): its dynamic table (most recent first)
/// plus the current and maximum table size. Mutated by `encode`/`decode`;
/// use a separate instance per direction (encoder and decoder).
pub struct Hpack {
    dyn_names: [string],
    dyn_values: [string],
    max_size: int,
    size: int,
}

/// Creates a fresh HPACK state with an empty dynamic table and the default
/// maximum table size of 4096 octets (RFC 7541 / RFC 7540 SETTINGS default).
pub fn new_hpack() -> Hpack {
    Hpack { dyn_names: [], dyn_values: [], max_size: 4096, size: 0 }
}

// --- Tabla dinámica ---
// El tamaño de una entrada (RFC 7541 §4.1): longitudes de nombre y valor + 32.
fn entry_size(name: string, value: string) -> int {
    name.to_bytes().len() + value.to_bytes().len() + 32
}

// Evicta entradas (de la más antigua) hasta que el tamaño no supere el máximo.
fn evict(h: Hpack) {
    while (h.size > h.max_size && h.dyn_names.len() > 0) {
        let last = h.dyn_names.len() - 1;
        h.size = h.size - entry_size(h.dyn_names[last], h.dyn_values[last]);
        var nn: [string] = [];
        var nv: [string] = [];
        var i = 0;
        while (i < last) {
            nn.push(h.dyn_names[i]);
            nv.push(h.dyn_values[i]);
            i = i + 1;
        }
        h.dyn_names = nn;
        h.dyn_values = nv;
    }
}

// Inserta una entrada al frente de la tabla dinámica (la más reciente).
fn add_dynamic(h: Hpack, name: string, value: string) {
    var nn: [string] = [name];
    var nv: [string] = [value];
    var i = 0;
    while (i < h.dyn_names.len()) {
        nn.push(h.dyn_names[i]);
        nv.push(h.dyn_values[i]);
        i = i + 1;
    }
    h.dyn_names = nn;
    h.dyn_values = nv;
    h.size = h.size + entry_size(name, value);
    evict(h);
}

fn set_max_size(h: Hpack, new: int) {
    h.max_size = new;
    evict(h);
}

// El nombre y valor del índice HPACK `idx` (1-basado): estático 1..61, dinámico 62+.
fn table_lookup(h: Hpack, idx: int) -> Result<HEntry, string> {
    let st = static_table();
    if (idx >= 1 && idx <= st.len()) {
        Result.Ok(st[idx - 1])
    } else {
        let d = idx - st.len() - 1;  // 0-basado en la tabla dinámica
        if (d >= 0 && d < h.dyn_names.len()) {
            Result.Ok(header(h.dyn_names[d], h.dyn_values[d]))
        } else {
            Result.Err("HPACK index out of range: " + to_string(idx))
        }
    }
}

// --- Codificación ---
// Codifica un entero con prefijo de `prefix_bits` bits; `high` son los bits altos ya puestos del 1.er octeto.
fn enc_int(out: [int], prefix_bits: int, high: int, value: int) {
    let max = (1 << prefix_bits) - 1;
    if (value < max) {
        out.push(high | value);
    } else {
        out.push(high | max);
        var v = value - max;
        while (v >= 128) {
            out.push(v & 127 | 128);
            v = v >> 7;
        }
        out.push(v);
    }
}

// Codifica un literal de string (sin Huffman): bit H=0 + longitud (prefijo 7) + octetos crudos.
fn enc_str(out: [int], s: string) {
    let b = s.to_bytes();
    enc_int(out, 7, 0, b.len());
    var i = 0;
    while (i < b.len()) {
        out.push(b[i]);
        i = i + 1;
    }
}

// Índice de la entrada EXACTA (nombre+valor) en estática+dinámica, o -1.
fn find_exact(h: Hpack, name: string, value: string) -> int {
    let st = static_table();
    var i = 0;
    while (i < st.len()) {
        if (st[i].name == name && st[i].value == value) {
            return i + 1;
        }
        i = i + 1;
    }
    i = 0;
    while (i < h.dyn_names.len()) {
        if (h.dyn_names[i] == name && h.dyn_values[i] == value) {
            return st.len() + 1 + i;
        }
        i = i + 1;
    }
    0 - 1
}

// Índice de la primera entrada con ese NOMBRE en estática+dinámica, o -1.
fn find_name(h: Hpack, name: string) -> int {
    let st = static_table();
    var i = 0;
    while (i < st.len()) {
        if (st[i].name == name) {
            return i + 1;
        }
        i = i + 1;
    }
    i = 0;
    while (i < h.dyn_names.len()) {
        if (h.dyn_names[i] == name) {
            return st.len() + 1 + i;
        }
        i = i + 1;
    }
    0 - 1
}

fn encode_one(h: Hpack, out: [int], name: string, value: string) {
    let exact = find_exact(h, name, value);
    if (exact >= 0) {
        enc_int(out, 7, 128, exact);  // indexado: 1xxxxxxx
    } else {
        // Literal con indexado incremental: 01xxxxxx (prefijo de nombre de 6 bits).
        let nidx = find_name(h, name);
        if (nidx >= 0) {
            enc_int(out, 6, 64, nidx);
        } else {
            enc_int(out, 6, 64, 0);
            enc_str(out, name);
        }
        enc_str(out, value);
        add_dynamic(h, name, value);
    }
}

// Codifica una lista de cabeceras a un bloque HPACK (actualizando la tabla dinámica del emisor).
/// Encodes a header list into an HPACK header block (RFC 7541), updating the encoder's dynamic table.
/// Uses indexed fields when possible, otherwise literals with incremental indexing;
/// string literals are always emitted raw (Huffman-coded literals are accepted when decoding).
pub fn encode(h: Hpack, headers: [HEntry]) -> bytes {
    var out: [int] = [];
    var i = 0;
    while (i < headers.len()) {
        encode_one(h, out, headers[i].name, headers[i].value);
        i = i + 1;
    }
    bytes_of(out)
}

// --- Decodificación ---
struct IntResult {
    value: int,
    next: int,
}

// Decodifica un entero con prefijo (RFC 7541 §5.1) sobre datos del PEER (no confiables): falla como
// valor si el entero está truncado o es absurdamente grande, en vez de leer fuera de rango o
// desbordar el i64 al desplazar (un bloque de octetos de continuación 0xFF llevaría `shift` a millones).
fn dec_int(data: bytes, pos: int, prefix_bits: int) -> Result<IntResult, string> {
    if (pos >= data.len()) {
        return Result.Err("HPACK: truncated integer");
    }
    let max = (1 << prefix_bits) - 1;
    let first = data[pos] & max;
    if (first < max) {
        return Result.Ok(IntResult { value: first, next: pos + 1 });
    }
    var v = max;
    var shift = 0;
    var p = pos + 1;
    var follow = true;
    while (follow) {
        if (p >= data.len()) {
            return Result.Err("HPACK: truncated integer (continuation without end)");
        }
        // Más de ~5 octetos de continuación = entero fuera de cualquier uso legítimo (índice,
        // longitud acotada por el bloque, tamaño de tabla ≤ 4096) → corta antes de desbordar.
        if (shift > 28) {
            return Result.Err("HPACK: integer too large");
        }
        let b = data[p];
        p = p + 1;
        v = v + ((b & 127) << shift);
        shift = shift + 7;
        if ((b & 128) == 0) {
            follow = false;
        }
    }
    Result.Ok(IntResult { value: v, next: p })
}

struct StrResult {
    value: string,
    next: int,
}

fn dec_str(data: bytes, pos: int) -> Result<StrResult, string> {
    if (pos >= data.len()) {
        return Result.Err("HPACK: truncated string literal");
    }
    let huff = data[pos] >> 7 & 1;
    let lr = dec_int(data, pos, 7)?;
    // La longitud viene del peer: validar el rango antes de `sub_bytes` (evita el OOB).
    if (lr.value < 0 || lr.next + lr.value > data.len()) {
        return Result.Err("HPACK: string length out of range");
    }
    var raw = data.sub_bytes(lr.next, lr.next + lr.value);
    // M133 (dogfood gRPC real): literal HUFFMAN (bit H=1) — grpc-go/nghttp2 comprimen SIEMPRE
    // sus cabeceras de respuesta. La tabla del RFC 7541 ya vivía en std/huffman (HPACK la usa
    // por [int]: par interno); aquí solo se puentea bytes → [int] → decode → bytes.
    if (huff == 1) {
        var ints: [int] = [];
        var i = 0;
        while (i < raw.len()) {
            ints.push(raw[i]);
            i = i + 1;
        }
        match (huffman.huffman_decode(ints)) {
            Result.Ok(out) => {
                raw = bytes_of(out);
            },
            Result.Err(e) => {
                return Result.Err("HPACK: " + e);
            },
        }
    }
    match (from_utf8(raw)) {
        Result.Ok(s) => Result.Ok(StrResult { value: s, next: lr.next + lr.value }),
        Result.Err(e) => Result.Err("HPACK: string is not UTF-8: " + e),
    }
}

// Decodifica el nombre de un campo literal: si el índice es 0, es un string literal; si no, viene de la tabla.
fn decode_name(h: Hpack, data: bytes, ir: IntResult) -> Result<StrResult, string> {
    if (ir.value == 0) {
        dec_str(data, ir.next)
    } else {
        match (table_lookup(h, ir.value)) {
            Result.Ok(e) => Result.Ok(StrResult { value: e.name, next: ir.next }),
            Result.Err(er) => Result.Err(er),
        }
    }
}

// Decodifica un bloque HPACK a la lista de cabeceras (actualizando la tabla dinámica del receptor).
/// Decodes an HPACK header block into its header list (RFC 7541), updating the decoder's dynamic table.
/// Handles indexed fields, all literal forms, and dynamic table size updates.
/// Err on an out-of-range index, invalid UTF-8, or a malformed Huffman-coded string literal.
pub fn decode(h: Hpack, data: bytes) -> Result<[HEntry], string> {
    var headers: [HEntry] = [];
    var pos = 0;
    let n = data.len();
    while (pos < n) {
        let b = data[pos];
        if ((b & 128) != 0) {
            // Campo indexado.
            let ir = dec_int(data, pos, 7)?;
            match (table_lookup(h, ir.value)) {
                Result.Ok(e) => {
                    headers.push(e);
                },
                Result.Err(er) => {
                    return Result.Err(er);
                },
            }
            pos = ir.next;
        } else {
            if ((b & 64) != 0) {
                // Literal con indexado incremental (prefijo de nombre 6 bits).
                let ni = dec_int(data, pos, 6)?;
                match (decode_name(h, data, ni)) {
                    Result.Err(er) => {
                        return Result.Err(er);
                    },
                    Result.Ok(nr) => {
                        match (dec_str(data, nr.next)) {
                            Result.Err(er) => {
                                return Result.Err(er);
                            },
                            Result.Ok(vr) => {
                                headers.push(header(nr.value, vr.value));
                                add_dynamic(h, nr.value, vr.value);
                                pos = vr.next;
                            },
                        }
                    },
                }
            } else {
                if ((b & 32) != 0) {
                    // Actualización del tamaño máximo de la tabla dinámica (prefijo 5 bits).
                    let ir = dec_int(data, pos, 5)?;
                    // RFC 7541 §6.3: una actualización no puede exceder el tamaño que el decodificador
                    // anunció por SETTINGS (por defecto 4096). Sin este tope, un peer sube el máximo y
                    // la tabla dinámica crece sin evicción a lo largo de la conexión (bomba de memoria).
                    if (ir.value > 4096) {
                        return Result.Err("HPACK: table size update exceeds the maximum (4096)");
                    }
                    set_max_size(h, ir.value);
                    pos = ir.next;
                } else {
                    // Literal sin indexado / nunca indexado (prefijo de nombre 4 bits), no toca la tabla.
                    let ni = dec_int(data, pos, 4)?;
                    match (decode_name(h, data, ni)) {
                        Result.Err(er) => {
                            return Result.Err(er);
                        },
                        Result.Ok(nr) => {
                            match (dec_str(data, nr.next)) {
                                Result.Err(er) => {
                                    return Result.Err(er);
                                },
                                Result.Ok(vr) => {
                                    headers.push(header(nr.value, vr.value));
                                    pos = vr.next;
                                },
                            }
                        },
                    }
                }
            }
        }
    }
    Result.Ok(headers)
}
