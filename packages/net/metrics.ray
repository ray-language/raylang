// Métricas estilo Prometheus, escritas EN raylang. Cero runtime nuevo. Un registro de counters, gauges
// e histogramas que se renderiza al **formato de exposición de texto** de Prometheus (`# HELP`/`# TYPE`
// + series), listo para servir en `/metrics` (con `webserver.ray`). Importable:
//   from metrics import registry, register_counter, register_gauge, register_histogram,
//                       inc, add, set, observe, render, no_labels, labels1, labels2;
//
// Modelo: arreglos paralelos (el ORDEN de salida: métricas en orden de registro, series en orden de
// creación) + índices por `Map` (M359, raylb L11: antes cada actualización recorría la lista de
// series y renderizaba las etiquetas POR BUCKET — 82 µs por `observe_l` con 20 series; ahora una
// búsqueda en `Map` por actualización y el render de etiquetas una sola vez por llamada). Con un
// handle `Series` (`series(reg, name, labels)`) ni eso: la clave se resuelve una vez y cada
// actualización es O(1) (O(buckets) en un histograma).
/// A metrics registry holding counters, gauges and histograms with their time series.
/// Metrics are stored in registration order; series in creation order. Lookups go through an
/// index (one `Map` probe per update); a `Series` handle skips even that.
pub struct Registry {
    names: [string],
    helps: [string],
    kinds: [int],
    bucketses: [[float]],
    s_metric: [int],
    s_text: [string],
    s_val: [float],
    m_index: Map<string, int>,
    s_index: Map<string, int>,
    h_families: Map<string, [int]>,
}

// métricas registradas, en orden
// 0=counter, 1=gauge, 2=histogram
// límites de bucket (solo histogramas; [] para los demás)
// serie → índice de su métrica
// prefijo de la línea: "nombre{labels}" / "nombre_bucket{le=...}" / "_sum" / "_count"
// valor de la serie
// m_index: nombre de métrica → índice; s_index: texto de serie → índice;
// h_families: "nombre{labels}" de un histograma → [buckets…, +Inf, _sum, _count] (índices de serie)
/// Creates a new, empty metrics registry.
pub fn registry() -> Registry {
    Registry {
        names: [],
        helps: [],
        kinds: [],
        bucketses: [],
        s_metric: [],
        s_text: [],
        s_val: [],
        m_index: Map.new(),
        s_index: Map.new(),
        h_families: Map.new()
    }
}

fn no_buckets() -> [float] {
    var e: [float] = [];
    e
}

// --- Helpers de labels ---
/// Returns an empty label set (for metrics without labels).
pub fn no_labels() -> Map<string, string> {
    Map.new()
}

/// Builds a label set with a single key/value pair.
pub fn labels1(k: string, v: string) -> Map<string, string> {
    var m: Map<string, string> = Map.new();
    m.insert(k, v);
    m
}

/// Builds a label set with two key/value pairs.
pub fn labels2(k1: string, v1: string, k2: string, v2: string) -> Map<string, string> {
    var m: Map<string, string> = Map.new();
    m.insert(k1, v1);
    m.insert(k2, v2);
    m
}

// M70: escapa el texto de `# HELP` (el formato de exposición exige `\\` y `\n`; un help con
// salto de línea rompía el scrape entero).
fn help_escape(s: string) -> string {
    var out = "";
    var i = 0;
    while (i < s.len()) {
        let c = s[i];
        if (c == '\\') {
            out = out + "\\\\";
        } else if (c == '\n') {
            out = out + "\\n";
        } else {
            out = out + to_string(c);
        }
        i = i + 1;
    }
    out
}

// Escapa un valor de label (Prometheus: barra, comilla, salto de línea).
fn label_escape(s: string) -> string {
    var out = "";
    var i = 0;
    while (i < s.len()) {
        let c = s[i];
        if (c == '\\') {
            out = out + "\\\\";
        } else {
            if (c == '"') {
                out = out + "\\\"";
            } else {
                if (c == '\n') {
                    out = out + "\\n";
                } else {
                    out = out + to_string(c);
                }
            }
        }
        i = i + 1;
    }
    out
}

// Renderiza un conjunto de labels como `{k="v",...}` (claves ordenadas) o "" si está vacío.
fn render_labels(labels: Map<string, string>) -> string {
    let ks = labels.keys();
    if (ks.len() == 0) {
        return "";
    }
    var out = "{";
    var i = 0;
    while (i < ks.len()) {
        if (i > 0) {
            out = out + ",";
        }
        let k = ks[i];
        let v = match (get(labels, k)) {
            Option.Some(x) => x,
            Option.None => "",
        };
        out = out + k + "=\"" + label_escape(v) + "\"";
        i = i + 1;
    }
    out + "}"
}

// --- Registro de métricas ---
fn add_metric(reg: Registry, name: string, help: string, kind: int, buckets: [float]) -> int {
    reg.names.push(name);
    reg.helps.push(help);
    reg.kinds.push(kind);
    reg.bucketses.push(buckets);
    let mi = reg.names.len() - 1;
    reg.m_index.insert(name, mi);
    mi
}

/// Registers a counter metric under `name` with the given help text.
/// Series are created lazily, on first `inc`/`add` per label set.
pub fn register_counter(reg: Registry, name: string, help: string) {
    add_metric(reg, name, help, 0, no_buckets());
}

/// Registers a gauge metric under `name` with the given help text.
/// Series are created lazily, on first `set`/`add` per label set.
pub fn register_gauge(reg: Registry, name: string, help: string) {
    add_metric(reg, name, help, 1, no_buckets());
}

fn fmt_float(v: float) -> string {
    to_string(v)
}

// Crea una serie (valor 0) y devuelve su índice.
fn create_series(reg: Registry, mi: int, text: string) -> int {
    reg.s_metric.push(mi);
    reg.s_text.push(text);
    reg.s_val.push(0.0);
    let si = reg.s_metric.len() - 1;
    reg.s_index.insert(text, si);
    si
}

/// Registers a histogram metric with the given ascending bucket upper bounds (`le` limits).
/// The +Inf bucket, `_sum` and `_count` series are added automatically per label set on
/// first observation.
pub fn register_histogram(reg: Registry, name: string, help: string, buckets: [float]) {
    // Las series NO se crean aquí: el conjunto de labels no se conoce al registrar. Se crean en orden
    // canónico la primera vez que se observa cada conjunto de labels (`ensure_hist_series`).
    add_metric(reg, name, help, 2, buckets);
}

// --- Búsqueda ---
fn find_metric(reg: Registry, name: string) -> int {
    reg.m_index.get_or(name, 0 - 1)
}

// Índice de la serie con ese texto (el texto lleva el nombre de la métrica: es único), o -1.
fn find_series(reg: Registry, mi: int, text: string) -> int {
    let si = reg.s_index.get_or(text, 0 - 1);
    if (si >= 0 && reg.s_metric[si] == mi) { si } else { 0 - 1 }
}

// Como `find_series` pero creando la serie (valor 0) si no existe.
fn touch_series(reg: Registry, mi: int, text: string) -> int {
    let idx = find_series(reg, mi, text);
    if (idx >= 0) {
        idx
    } else {
        create_series(reg, mi, text)
    }
}

// Copia un conjunto de labels añadiéndole `le` (para las series _bucket de un histograma).
fn with_le(labels: Map<string, string>, le: string) -> Map<string, string> {
    var m: Map<string, string> = Map.new();
    let ks = labels.keys();
    var i = 0;
    while (i < ks.len()) {
        match (get(labels, ks[i])) {
            Option.Some(v) => {
                m.insert(ks[i], v);
            },
            Option.None => { },
        }
        i = i + 1;
    }
    m.insert("le", le);
    m
}

// La familia de series de un histograma para un conjunto de labels — `[buckets…, +Inf, _sum,
// _count]` como índices de serie — creada en orden canónico la primera vez y recordada por su
// clave `nombre{labels}` (M359: una búsqueda por observación, sin re-renderizar por bucket).
fn hist_family(
    reg: Registry,
    mi: int,
    name: string,
    buckets: [float],
    labels: Map<string, string>
) -> [int] {
    let key = name + render_labels(labels);
    match (get(reg.h_families, key)) {
        Option.Some(f) => f,
        Option.None => {
            var fam: [int] = [];
            var i = 0;
            while (i < buckets.len()) {
                fam.push(
                    create_series(
                        reg,
                        mi,
                        name + "_bucket" + render_labels(with_le(labels, fmt_float(buckets[i])))
                    )
                );
                i = i + 1;
            }
            fam.push(
                create_series(reg, mi, name + "_bucket" + render_labels(with_le(labels, "+Inf")))
            );
            fam.push(create_series(reg, mi, name + "_sum" + render_labels(labels)));
            fam.push(create_series(reg, mi, name + "_count" + render_labels(labels)));
            reg.h_families.insert(key, fam);
            fam
        },
    }
}

// Aplica una observación a una familia de histograma: buckets con `le >= v`, +Inf, _sum y _count.
fn observe_family(reg: Registry, buckets: [float], fam: [int], v: float) {
    let n = buckets.len();
    var i = 0;
    while (i < n) {
        if (v <= buckets[i]) {
            let si = fam[i];
            reg.s_val[si] = reg.s_val[si] + 1.0;
        }
        i = i + 1;
    }
    let inf = fam[n];
    reg.s_val[inf] = reg.s_val[inf] + 1.0;
    let ss = fam[n + 1];
    reg.s_val[ss] = reg.s_val[ss] + v;
    let sc = fam[n + 2];
    reg.s_val[sc] = reg.s_val[sc] + 1.0;
}

// --- Operaciones ---
/// Adds `v` to the series of metric `name` with the given labels (creating it at 0 if new).
/// Panics if the metric was never registered or is a histogram (use `observe_l`).
pub fn add(reg: Registry, name: string, labels: Map<string, string>, v: float) {
    let mi = find_metric(reg, name);
    if (mi < 0) {
        panic("unregistered metric: " + name);
    }
    // M70: el tipo debe cuadrar — antes `add` sobre un histograma creaba una serie espuria
    // (`nombre{}` mezclada con `nombre_bucket{…}`) que corrompía la exposición en silencio.
    if (reg.kinds[mi] == 2) {
        panic("'" + name + "' is a histogram; use observe_l/observe");
    }
    let si = touch_series(reg, mi, name + render_labels(labels));
    reg.s_val[si] = reg.s_val[si] + v;
}

/// Increments a counter by 1 for the given label set (sugar for `add(reg, name, labels, 1.0)`).
pub fn inc(reg: Registry, name: string, labels: Map<string, string>) {
    add(reg, name, labels, 1.0);
}

/// Sets a gauge to `v` for the given label set (creating the series if new).
/// Panics if the metric was never registered or is not a gauge (a counter only goes up).
pub fn set(reg: Registry, name: string, labels: Map<string, string>, v: float) {
    let mi = find_metric(reg, name);
    if (mi < 0) {
        panic("unregistered metric: " + name);
    }
    // M70: `set` es de gauges — sobre un counter viola la monotonía; sobre un histograma
    // crearía una serie espuria.
    if (reg.kinds[mi] != 1) {
        panic("'" + name + "' is not a gauge; set only applies to gauges");
    }
    let si = touch_series(reg, mi, name + render_labels(labels));
    reg.s_val[si] = v;
}

// Observa un valor en un histograma con un conjunto de labels: incrementa los buckets cuyo `le` ≥ v,
// el bucket +Inf y _count, y suma a _sum. Las series del conjunto de labels se crean en orden canónico
// la primera vez (`ensure_hist_series`). Los buckets llevan los labels + `le`; _sum/_count solo los labels.
/// Records an observation `v` in a histogram for the given label set: increments every
/// bucket with `le >= v`, the +Inf bucket and `_count`, and adds `v` to `_sum`.
/// Panics if the histogram was never registered.
pub fn observe_l(reg: Registry, name: string, labels: Map<string, string>, v: float) {
    let mi = find_metric(reg, name);
    if (mi < 0) {
        panic("unregistered histogram: " + name);
    }
    // M70: observar un counter/gauge crearía series _bucket espurias.
    if (reg.kinds[mi] != 2) {
        panic("'" + name + "' is not a histogram; use inc/add/set");
    }
    let bks = reg.bucketses[mi];
    observe_family(reg, bks, hist_family(reg, mi, name, bks, labels), v);
}

// --- Handles de serie (M359, raylb L11) ---
/// A resolved time series: the metric and label set looked up once, so each update is O(1)
/// (O(buckets) for a histogram) with no label rendering. Get one with `series`; update it with
/// `s.inc()`, `s.add(v)`, `s.set(v)` or `s.observe(v)`. The handle stays valid for the life of
/// the registry.
pub struct Series {
    reg: Registry,
    kind: int,
    idx: int,
    family: [int],
    buckets: [float],
}

/// Resolves the series of metric `name` with `labels` once (creating it at 0 if new) and returns
/// a handle for O(1) updates — the hot-path form of `inc`/`add`/`set`/`observe_l`. Panics if the
/// metric was never registered.
pub fn series(reg: Registry, name: string, labels: Map<string, string>) -> Series {
    let mi = find_metric(reg, name);
    if (mi < 0) {
        panic("unregistered metric: " + name);
    }
    let kind = reg.kinds[mi];
    if (kind == 2) {
        let bks = reg.bucketses[mi];
        Series {
            reg: reg,
            kind: kind,
            idx: 0 - 1,
            family: hist_family(reg, mi, name, bks, labels),
            buckets: bks
        }
    } else {
        let idx = touch_series(reg, mi, name + render_labels(labels));
        Series { reg: reg, kind: kind, idx: idx, family: [], buckets: [] }
    }
}

/// The O(1) updates of a resolved `Series`.
pub trait SeriesOps {
    /// Adds `v` to a counter or gauge series. Panics on a histogram (use `observe`).
    fn add(self, v: float);
    /// Increments a counter (or gauge) series by 1.
    fn inc(self);
    /// Sets a gauge series to `v`. Panics unless the series is a gauge.
    fn set(self, v: float);
    /// Records an observation in a histogram series. Panics unless the series is a histogram.
    fn observe(self, v: float);
}

impl SeriesOps for Series {
    fn add(self, v: float) {
        if (self.kind == 2) {
            panic("the series is a histogram; use observe");
        }
        self.reg.s_val[self.idx] = self.reg.s_val[self.idx] + v;
    }

    fn inc(self) {
        self.add(1.0);
    }

    fn set(self, v: float) {
        if (self.kind != 1) {
            panic("the series is not a gauge; set only applies to gauges");
        }
        self.reg.s_val[self.idx] = v;
    }

    fn observe(self, v: float) {
        if (self.kind != 2) {
            panic("the series is not a histogram; use inc/add/set");
        }
        observe_family(self.reg, self.buckets, self.family, v);
    }
}

// Observa un valor en un histograma sin labels (azúcar de `observe_l` con el conjunto vacío).
/// Records an observation in a histogram without labels (sugar for `observe_l` with an empty set).
pub fn observe(reg: Registry, name: string, v: float) {
    observe_l(reg, name, no_labels(), v);
}

fn kind_name(k: int) -> string {
    if (k == 0) { "counter" } else {
        if (k == 1) { "gauge" } else { "histogram" }
    }
}

// Renderiza todo el registro al formato de exposición de Prometheus.
/// Renders the whole registry in the Prometheus text exposition format
/// (`# HELP`/`# TYPE` headers plus one line per series), ready to serve at `/metrics`.
/// Output is deterministic: metrics in registration order, series in creation order.
pub fn render(reg: Registry) -> string {
    var out = "";
    var mi = 0;
    while (mi < reg.names.len()) {
        out = out + "# HELP " + reg.names[mi] + " " + help_escape(reg.helps[mi]) + "\n";
        out = out + "# TYPE " + reg.names[mi] + " " + kind_name(reg.kinds[mi]) + "\n";
        var si = 0;
        while (si < reg.s_metric.len()) {
            if (reg.s_metric[si] == mi) {
                out = out + reg.s_text[si] + " " + fmt_float(reg.s_val[si]) + "\n";
            }
            si = si + 1;
        }
        mi = mi + 1;
    }
    out
}
