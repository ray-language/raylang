// Cliente PostgreSQL (protocolo wire v3) escrito EN raylang (M32.1). Startup + autenticación
// **SCRAM-SHA-256** (`scram.ray`) + consulta simple (simple query protocol) con parseo de filas.
// Es el "cliente cloud" con autenticación, al estilo del de Redis (M20.6) pero con handshake cripto.
//
// El protocolo: mensajes `[tipo:1][longitud:4][carga]` (la longitud incluye sus 4 octetos, no el tipo);
// el StartupMessage no lleva octeto de tipo. Importable: `from postgres import pg_query;`.
from net/scram import scram_first, scram_client_first_message, scram_final, scram_verify, Scram;
import std/net;

// Una conexión con su buffer de lectura (los mensajes pueden partirse entre lecturas del socket).
struct PgConn {
    handle: int,
    buf: bytes,
}

// Un mensaje del servidor: su octeto de tipo y la carga (sin el tipo ni la longitud).
struct PgMsg {
    mtype: int,
    payload: bytes,
}

// Un entero de 32 bits big-endian desde `b[off]`.
fn be32(b: bytes, off: int) -> int {
    b[off] << 24 | b[off + 1] << 16 | b[off + 2] << 8 | b[off + 3]
}

// Los 4 octetos big-endian de `n`.
fn be32_bytes(n: int) -> [int] {
    var o: [int] = [];
    o.push(n >> 24 & 255);
    o.push(n >> 16 & 255);
    o.push(n >> 8 & 255);
    o.push(n & 255);
    o
}

// Octetos de una cadena terminada en NUL.
fn cstr(s: string) -> [int] {
    var o: [int] = [];
    let b = s.to_bytes();
    var i = 0;
    while (i < b.len()) {
        o.push(b[i]);
        i = i + 1;
    }
    o.push(0);
    o
}

// Envía un mensaje con octeto de tipo: `[tipo][longitud=4+len(carga)][carga]`.
fn pg_send(c: PgConn, mtype: int, payload: [int]) -> Result<int, string> {
    var m: [int] = [];
    m.push(mtype);
    var lb = be32_bytes(4 + payload.len());
    var i = 0;
    while (i < 4) {
        m.push(lb[i]);
        i = i + 1;
    }
    i = 0;
    while (i < payload.len()) {
        m.push(payload[i]);
        i = i + 1;
    }
    net.socket_write_bytes(c.handle, bytes_of(m))
}

// Tope de tamaño de un mensaje del servidor (anti-bomba de memoria): la longitud la fija el
// servidor y sin cota `pg_read` acumularía octetos del socket sin fin. Se rechaza al leer la cabecera.
fn max_message() -> int {
    67108864
}

// Lee un mensaje COMPLETO del servidor (acumulando en el buffer lo que haga falta).
fn pg_read(c: PgConn) -> Result<PgMsg, string> {
    var out = PgMsg { mtype: 0, payload: b"" };
    var ready = false;
    while (!ready) {
        if (c.buf.len() >= 5) {
            let mlen = be32(c.buf, 1);  // longitud (incluye sus 4 octetos)
            if (mlen < 4) {
                return Result.Err("invalid message length (" + to_string(mlen) + ")");
            }
            if (mlen > max_message()) {
                return Result.Err("message exceeds the limit (" + to_string(mlen) + " bytes, possible memory bomb)");
            }
            let total = 1 + mlen;
            if (c.buf.len() >= total) {
                out = PgMsg { mtype: c.buf[0], payload: c.buf.sub_bytes(5, total) };
                c.buf = c.buf.sub_bytes(total, c.buf.len());
                ready = true;
            }
        }
        if (!ready) {
            match (net.socket_read_bytes(c.handle)) {
                Result.Ok(chunk) => {
                    if (chunk.len() == 0) {
                        return Result.Err("connection closed by the server");
                    }
                    c.buf = c.buf + chunk;
                },
                Result.Err(e) => {
                    return Result.Err(e);
                },
            }
        }
    }
    Result.Ok(out)
}

// Parsea un DataRow ('D'): `[nº columnas:2]` y por columna `[longitud:4][valor]` (-1 = NULL → "").
// Falla como valor ante un payload truncado o una longitud fuera de rango (datos del servidor).
fn parse_datarow(payload: bytes) -> Result<[string], string> {
    if (payload.len() < 2) {
        return Result.Err("truncated DataRow (no column count)");
    }
    var cols: [string] = [];
    let ncol = payload[0] << 8 | payload[1];
    var pos = 2;
    var i = 0;
    while (i < ncol) {
        if (pos + 4 > payload.len()) {
            return Result.Err("truncated DataRow (column length)");
        }
        // La longitud es int32 CON SIGNO: -1 (0xFFFFFFFF) marca NULL. `be32` no extiende el signo,
        // así que hay que reinterpretarlo — sin esto, el NULL se leía como 4294967295 y `sub_bytes`
        // reventaba el cliente ante CUALQUIER columna NULL.
        var vlen = be32(payload, pos);
        if (vlen >= 2147483648) {
            vlen = vlen - 4294967296;
        }
        pos = pos + 4;
        if (vlen < 0) {
            cols.push("");
        } else {
            if (pos + vlen > payload.len()) {
                return Result.Err("DataRow with column length out of range");
            }
            let v = payload.sub_bytes(pos, pos + vlen);
            match (from_utf8(v)) {
                Result.Ok(s) => {
                    cols.push(s);
                },
                Result.Err(e) => {
                    cols.push("");
                },
            }
            pos = pos + vlen;
        }
        i = i + 1;
    }
    Result.Ok(cols)
}

// Ejecuta `sql` como consulta simple tras autenticar con SCRAM-SHA-256, y devuelve la PRIMERA fila
// como lista de columnas (strings). `nonce` es el nonce del cliente (aleatorio en producción).
/// Connects to PostgreSQL at `host:port`, authenticates as `user` against `db` with
/// SCRAM-SHA-256 (`nonce` = client nonce; use a random one in production), runs `sql` via
/// the simple query protocol, and returns the FIRST row as column strings (NULL -> "").
/// Blocking network I/O; Err on connection/auth failure or any server ErrorResponse.
pub fn pg_query(host: string, port: int, user: string, db: string, password: string, nonce: string, sql: string) -> Result<[string], string> {
    let handle = match (net.tcp_connect(host, port)) {
        Result.Ok(h) => h,
        Result.Err(e) => {
            return Result.Err(e);
        },
    };
    let c = PgConn { handle: handle, buf: b"" };

    // StartupMessage (sin octeto de tipo): [longitud][versión 3.0 = 196608][params][0].
    var body: [int] = [];
    var pv = be32_bytes(196608);
    var i = 0;
    while (i < 4) {
        body.push(pv[i]);
        i = i + 1;
    }
    let params = cstr("user") + cstr(user) + cstr("database") + cstr(db);
    i = 0;
    while (i < params.len()) {
        body.push(params[i]);
        i = i + 1;
    }
    body.push(0);
    var startup: [int] = [];
    var sl = be32_bytes(4 + body.len());
    i = 0;
    while (i < 4) {
        startup.push(sl[i]);
        i = i + 1;
    }
    i = 0;
    while (i < body.len()) {
        startup.push(body[i]);
        i = i + 1;
    }
    match (net.socket_write_bytes(c.handle, bytes_of(startup))) {
        Result.Ok(n) => { },
        Result.Err(e) => {
            close(handle);
            return Result.Err(e);
        },
    }

    let sc = scram_first(user, nonce);
    var query_sent = false;
    var row: [string] = [];
    var has_row = false;
    var done = false;
    while (!done) {
        let msg = match (pg_read(c)) {
            Result.Ok(m) => m,
            Result.Err(e) => {
                close(handle);
                return Result.Err(e);
            },
        };
        if (msg.mtype == 82) {
            // 'R' Authentication
            let code = be32(msg.payload, 0);
            if (code == 10) {
                // AuthenticationSASL
                let cf = scram_client_first_message(sc);
                let ir = cstr("SCRAM-SHA-256") + be32_bytes(cf.to_bytes().len());
                var pl: [int] = [];
                var k = 0;
                while (k < ir.len()) {
                    pl.push(ir[k]);
                    k = k + 1;
                }
                let cfb = cf.to_bytes();
                k = 0;
                while (k < cfb.len()) {
                    pl.push(cfb[k]);
                    k = k + 1;
                }
                match (pg_send(c, 112, pl)) {
                    // 'p'
                    Result.Ok(x) => { },
                    Result.Err(e) => {
                        close(handle);
                        return Result.Err(e);
                    },
                }
            } else if (code == 11) {
                // AuthenticationSASLContinue (server-first)
                let sf = match (from_utf8(msg.payload.sub_bytes(4, msg.payload.len()))) {
                    Result.Ok(s) => s,
                    Result.Err(e) => {
                        close(handle);
                        return Result.Err("server-first not utf8");
                    },
                };
                let final_msg = match (scram_final(sc, password, sf)) {
                    Result.Ok(f) => f,
                    Result.Err(e) => {
                        close(handle);
                        return Result.Err(e);
                    },
                };
                let fb = final_msg.to_bytes();
                var pl: [int] = [];
                var k = 0;
                while (k < fb.len()) {
                    pl.push(fb[k]);
                    k = k + 1;
                }
                match (pg_send(c, 112, pl)) {
                    // 'p'
                    Result.Ok(x) => { },
                    Result.Err(e) => {
                        close(handle);
                        return Result.Err(e);
                    },
                }
            } else if (code == 12) {
                // AuthenticationSASLFinal (server-final)
                let sfin = match (from_utf8(msg.payload.sub_bytes(4, msg.payload.len()))) {
                    Result.Ok(s) => s,
                    Result.Err(e) => {
                        close(handle);
                        return Result.Err("server-final not utf8");
                    },
                };
                if (!scram_verify(sc, sfin)) {
                    close(handle);
                    return Result.Err("the server signature does not verify (authentication failed)");
                }
            }
            // code 0 = AuthenticationOk: nada que hacer.
        } else if (msg.mtype == 90) {
            // 'Z' ReadyForQuery
            if (!query_sent) {
                match (pg_send(c, 81, cstr(sql))) {
                    // 'Q'
                    Result.Ok(x) => { },
                    Result.Err(e) => {
                        close(handle);
                        return Result.Err(e);
                    },
                }
                query_sent = true;
            } else {
                done = true;  // ya llegó la respuesta a la consulta
            }
        } else if (msg.mtype == 68) {
            // 'D' DataRow
            if (!has_row) {
                row = parse_datarow(msg.payload)?;
                has_row = true;
            }
        } else if (msg.mtype == 69) {
            // 'E' ErrorResponse
            close(handle);
            return Result.Err("PostgreSQL server error");
        }
        // 'S' ParameterStatus, 'K' BackendKeyData, 'T' RowDescription, 'C' CommandComplete: se ignoran.
    }
    close(handle);
    Result.Ok(row)
}
