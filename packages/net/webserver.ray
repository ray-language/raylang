// M19.1 — un servidor web HTTP/1.1 CONCURRENTE escrito EN raylang, con soporte de SSE.
//
// Como http.ray/json.ray: cero runtime, cero builtins nuevos; puro raylang + stdlib, importable. Se
// apoya en el servidor concurrente de M15.5/M17 (tcp_listen/tcp_accept/socket_read/socket_write ceden
// al scheduler → muchas conexiones a la vez en un hilo, readiness por kqueue/epoll). **Solo VM** (la
// concurrencia es VM-only).
//
// M19.2: el cuerpo (de la petición y de la respuesta) es **bytes** → binario correcto (imágenes, etc.),
// no solo texto. Las cabeceras siguen siendo texto (ASCII). Los atajos de respuesta de texto (ok/text/
// json_response) aceptan string y lo codifican; bytes_response acepta bytes crudos. TLS (https) es M19.4.
import std/net;
import std/url;
import std/time;
import std/fs;

// M56.2: `path` llega DECODIFICADO (%XX; un `+` es literal en rutas) y SIN la query string, que
// va aparte en `query` (cruda, sin el `?`) — así el enrutado por ruta funciona con `?x=1` y el
// usuario parsea la query solo si la necesita (`query_params`). M56.6: `version` es la de la
// línea de petición ("HTTP/1.1"; "" si falta) — decide el keep-alive.
/// An incoming HTTP request: method, request path (percent-decoded, WITHOUT the query string),
/// the raw query string (after `?`, empty if none — parse it with `query_params`), the HTTP
/// version from the request line ("HTTP/1.1"; "" if absent), headers (names lowercased for
/// case-insensitive lookup), and the raw body as bytes (use `request_text` to decode it as UTF-8).
pub struct Request {
    method: string,
    path: string,
    query: string,
    version: string,
    headers: Map<string, string>,
    body: bytes,
}

/// Parses the request's query string into a `Map<string,string>` (keys and values URL-decoded,
/// last duplicate key wins, `+` decodes to space). Empty map if there was no query.
pub fn query_params(req: Request) -> Map<string, string> {
    url.parse_query(req.query)
}

// M56.1: límites de la frontera de seguridad. Sin ellos, un cliente hostil puede pedir memoria
// ilimitada (cabeceras sin fin o un Content-Length gigante) o agotar los descriptores (conexiones
// sin tope). M56.4: `read_timeout_millis` acota el TIEMPO TOTAL de leer una petición (anti-
// slowloris: una conexión que gotea octetos ya no retiene su fibra para siempre). `serve`/
// `serve_raw` usan `default_limits()`; las variantes `*_limits` los configuran.
/// Safety limits for the server: maximum header bytes, maximum body bytes (as declared by
/// `Content-Length`), maximum simultaneous connections (`max_conns <= 0` = unbounded), and the
/// total time budget in ms for reading one request (`read_timeout_millis <= 0` = no timeout).
/// `serve`/`serve_raw` use `default_limits()`; pass your own via `serve_limits`/`serve_raw_limits`.
pub struct Limits {
    max_header_bytes: int,
    max_body_bytes: int,
    max_conns: int,
    read_timeout_millis: int,
}

/// The default safety limits: 64 KiB of headers, 10 MiB of body, 1024 simultaneous connections,
/// 10 s to read a request.
pub fn default_limits() -> Limits {
    Limits { max_header_bytes: 65536, max_body_bytes: 10485760, max_conns: 1024, read_timeout_millis: 10000 }
}

// M56.7: `headers` es un Map (una cabecera por nombre, ergonómico) y la ÚNICA cabecera que en la
// práctica se repite —`Set-Cookie` (varias cookies en una respuesta: sesión + flash…)— tiene su
// campo dedicado `set_cookie` (una línea por cookie, en orden de inserción; `with_cookie` para
// encadenar). Decisión fijada con el usuario (DESIGN §60).
/// An outgoing HTTP response: status code, extra headers (one per name), the `Set-Cookie` lines
/// (one per cookie, sent in insertion order — the one response header that legitimately repeats;
/// add them with `with_cookie`), and the body as raw bytes. `Content-Length` and `Connection`
/// are added automatically by `send_response`.
pub struct Response {
    status: int,
    headers: Map<string, string>,
    set_cookie: [string],
    body: bytes,
}

// --- Respuestas: atajos para los casos comunes ---
// Respuesta de texto: el cuerpo se codifica a UTF-8.
/// Builds a text response with the given status: the body string is encoded to UTF-8 bytes, no extra headers.
pub fn text(status: int, body: string) -> Response {
    Response { status: status, headers: Map.new(), set_cookie: [], body: body.to_bytes() }
}

// Respuesta binaria: el cuerpo va tal cual (octetos crudos).
/// Builds a binary response with the given status: the body bytes are sent verbatim (images, downloads, etc.).
pub fn bytes_response(status: int, body: bytes) -> Response {
    Response { status: status, headers: Map.new(), set_cookie: [], body: body }
}

/// Appends one `Set-Cookie` line to the response and returns it (chainable with UFCS:
/// `ok(html).with_cookie("sid=…; Path=/; HttpOnly").with_cookie("flash=…")`).
pub fn with_cookie(r: Response, line: string) -> Response {
    r.set_cookie.push(line);
    r
}

/// Builds a 200 OK text response with the given body.
pub fn ok(body: string) -> Response {
    text(200, body)
}

/// Builds a 404 Not Found text response with the body "Not Found".
pub fn not_found() -> Response {
    text(404, "Not Found")
}

/// Builds a 200 response with `Content-Type: application/json`. `body` must already be serialized JSON text.
pub fn json_response(body: string) -> Response {
    var h: Map<string, string> = Map.new();
    h.insert("Content-Type", "application/json; charset=utf-8");
    Response { status: 200, headers: h, set_cookie: [], body: body.to_bytes() }
}

// Respuesta HTML con el charset declarado. `text`/`ok` NO ponen Content-Type → el navegador adivina
// el encoding (Latin-1 en la práctica), que estropea el UTF-8 (acentos, «—»). Para servir HTML usa
// esto, que declara `text/html; charset=utf-8`. El cuerpo es UTF-8 (los strings de raylang lo son).
/// Builds an HTML response with the given status and `Content-Type: text/html; charset=utf-8` — the
/// header a browser needs to render UTF-8 correctly. Prefer this over `text`/`ok` for HTML.
pub fn html_response(status: int, body: string) -> Response {
    var h: Map<string, string> = Map.new();
    h.insert("Content-Type", "text/html; charset=utf-8");
    Response { status: status, headers: h, set_cookie: [], body: body.to_bytes() }
}

// El cuerpo de una petición decodificado como texto UTF-8 (para formularios/JSON entrantes). Para datos
// binarios entrantes, usa `req.body` (bytes) directamente.
/// Decodes the request body as UTF-8 text (for incoming forms/JSON).
/// Err if the body is not valid UTF-8; for binary payloads use `req.body` directly.
pub fn request_text(req: Request) -> Result<string, string> {
    from_utf8(req.body)
}

// --- Archivos estáticos (M56.8) ---
// El Content-Type por extensión del archivo (los tipos comunes de una web; el resto, octet-stream).
fn mime_of(file: string) -> string {
    let f = file.to_lower();
    if (f.ends_with(".html") || f.ends_with(".htm")) { return "text/html; charset=utf-8"; }
    if (f.ends_with(".css")) { return "text/css; charset=utf-8"; }
    if (f.ends_with(".js") || f.ends_with(".mjs")) { return "text/javascript; charset=utf-8"; }
    if (f.ends_with(".json")) { return "application/json; charset=utf-8"; }
    if (f.ends_with(".txt")) { return "text/plain; charset=utf-8"; }
    if (f.ends_with(".svg")) { return "image/svg+xml"; }
    if (f.ends_with(".png")) { return "image/png"; }
    if (f.ends_with(".jpg") || f.ends_with(".jpeg")) { return "image/jpeg"; }
    if (f.ends_with(".gif")) { return "image/gif"; }
    if (f.ends_with(".ico")) { return "image/x-icon"; }
    if (f.ends_with(".pdf")) { return "application/pdf"; }
    if (f.ends_with(".wasm")) { return "application/wasm"; }
    if (f.ends_with(".woff2")) { return "font/woff2"; }
    "application/octet-stream"
}

// Sirve un archivo estático de `dir` según la ruta de la petición, con SANEO: un segmento `..` o
// `.` es 404 directo (nunca se sale de `dir`; el path ya llega percent-decodificado, así que
// `%2e%2e` también cae aquí). Una ruta que termina en `/` sirve su `index.html`.
/// Serves a static file from `dir` for the given request path (use inside a handler:
/// `webserver.static_response("public", req.path)`). Path-traversal safe: any `..`/`.` segment is
/// a 404 (the path arrives percent-decoded, so `%2e%2e` is covered); a trailing `/` serves the
/// directory's `index.html`. Sets `Content-Type` by extension; unknown files are octet-stream;
/// missing/unreadable files are 404.
pub fn static_response(dir: string, path: string) -> Response {
    var ruta: string = path;
    if (ruta.ends_with("/")) {
        ruta = ruta + "index.html";
    }
    let segs: [string] = ruta.split("/");
    var limpio: [string] = [];
    var i: int = 0;
    while (i < segs.len()) {
        let s: string = segs[i];
        if (s == ".." || s == ".") {
            return not_found();
        }
        if (s != "") {
            limpio.push(s);
        }
        i = i + 1;
    }
    var file: string = dir;
    var j: int = 0;
    while (j < limpio.len()) {
        file = file + "/" + limpio[j];
        j = j + 1;
    }
    match (fs.read_file_bytes(file)) {
        Result.Ok(datos) => {
            let r: Response = bytes_response(200, datos);
            r.headers.insert("Content-Type", mime_of(file));
            r
        },
        Result.Err(_) => not_found(),
    }
}

// La frase de estado para los códigos comunes (HTTP la exige tras el número). M56.1: cubre
// también redirecciones (3xx), auth (401/403), 405/413/429/431 y los 5xx de gateway.
fn status_text(code: int) -> string {
    if (code == 200) { "OK" }
    else if (code == 201) { "Created" }
    else if (code == 204) { "No Content" }
    else if (code == 301) { "Moved Permanently" }
    else if (code == 302) { "Found" }
    else if (code == 303) { "See Other" }
    else if (code == 304) { "Not Modified" }
    else if (code == 307) { "Temporary Redirect" }
    else if (code == 308) { "Permanent Redirect" }
    else if (code == 400) { "Bad Request" }
    else if (code == 401) { "Unauthorized" }
    else if (code == 403) { "Forbidden" }
    else if (code == 404) { "Not Found" }
    else if (code == 405) { "Method Not Allowed" }
    else if (code == 409) { "Conflict" }
    else if (code == 413) { "Content Too Large" }
    else if (code == 415) { "Unsupported Media Type" }
    else if (code == 422) { "Unprocessable Content" }
    else if (code == 429) { "Too Many Requests" }
    else if (code == 431) { "Request Header Fields Too Large" }
    else if (code == 500) { "Internal Server Error" }
    else if (code == 501) { "Not Implemented" }
    else if (code == 502) { "Bad Gateway" }
    else if (code == 503) { "Service Unavailable" }
    else if (code == 504) { "Gateway Timeout" }
    else { "Status" }
}

// --- Lectura de la petición ---
// El índice del primer "\r\n\r\n" (fin de cabeceras) en bytes desde `desde`, o -1. Escanea por
// octetos (CR=13, LF=10): no se puede usar index_of (es de string) porque el cuerpo binario
// rompería from_utf8 del buffer entero. `desde` permite REANUDAR el escaneo donde quedó el trozo
// anterior (M56.1): sin él, re-escanear todo el acumulado por trozo es O(n²) — un amplificador
// del ataque de cabeceras gigantes.
fn find_fin_cabeceras(b: bytes, desde: int) -> int {
    var i: int = desde;
    if (i < 0) { i = 0; }
    while (i + 3 < b.len()) {
        if (b[i] == 13 && b[i + 1] == 10 && b[i + 2] == 13 && b[i + 3] == 10) {
            return i;
        }
        i = i + 1;
    }
    0 - 1
}

// Lee una petición HTTP completa de la conexión: acumula bytes hasta el fin de cabeceras (\r\n\r\n),
// decodifica SOLO las cabeceras como texto para parsearlas, y —si hay Content-Length— sigue leyendo
// hasta completar el cuerpo (bytes crudos, octetos). M19.2: cuerpo binario correcto.
/// Reads one full HTTP request from connection `conn`: accumulates bytes until the end of headers (\r\n\r\n),
/// parses the request line and headers (header names lowercased), then keeps reading until `Content-Length` bytes of body.
/// Blocks (yielding to the scheduler) on socket reads; Err on read failure, malformed request line, or non-UTF-8 headers.
/// Uses `default_limits()`; to configure them, use `read_request_limits`.
pub fn read_request(conn: int) -> Result<Request, string> {
    read_request_limits(conn, default_limits())
}

// --- Cuerpo chunked entrante (M56.8, Transfer-Encoding: chunked) ---
// El índice del primer "\r\n" en `b` desde `desde`, o -1 (escaneo por octetos, como el fin de cabeceras).
fn buscar_crlf(b: bytes, desde: int) -> int {
    var i: int = desde;
    while (i + 1 < b.len()) {
        if (b[i] == 13 && b[i + 1] == 10) {
            return i;
        }
        i = i + 1;
    }
    0 - 1
}

// El valor de un dígito hexadecimal (octeto ASCII), o -1.
fn hex_digito(b: int) -> int {
    if (b >= 48 && b <= 57) { return b - 48; }        // 0-9
    if (b >= 97 && b <= 102) { return b - 97 + 10; }  // a-f
    if (b >= 65 && b <= 70) { return b - 65 + 10; }   // A-F
    0 - 1
}

// El tamaño de un chunk: hex desde el inicio de la línea hasta `;` (extensiones, se ignoran) o el
// fin de línea. -1 si no hay ni un dígito válido.
fn tam_chunk(b: bytes, ini: int, fin: int) -> int {
    var n: int = 0;
    var i: int = ini;
    var alguno: bool = false;
    while (i < fin) {
        if (b[i] == 59) {  // ';' → extensión de chunk: ignorar el resto
            i = fin;
        } else {
            let d: int = hex_digito(b[i]);
            if (d < 0) {
                return 0 - 1;
            }
            n = n * 16 + d;
            alguno = true;
            i = i + 1;
        }
    }
    if (alguno) { n } else { 0 - 1 }
}

// Decodifica un cuerpo `Transfer-Encoding: chunked`: líneas `tamaño-hex\r\n` + datos + `\r\n`,
// terminado por el chunk 0 (los trailers, raros, no se soportan: tras el 0 se exige `\r\n`).
// `inicial` son los octetos que llegaron pegados a las cabeceras; el tamaño DECODIFICADO acumulado
// respeta `max` y toda la lectura el plazo total.
fn leer_cuerpo_chunked(conn: int, inicial: bytes, plazo_fin: int, max: int) -> Result<bytes, string> {
    var acc: bytes = inicial;
    var out: bytes = b"";
    var seguir: bool = true;
    while (seguir) {
        let nl: int = buscar_crlf(acc, 0);
        if (nl < 0) {
            match (leer_con_plazo(conn, plazo_fin)) {
                Result.Ok(t) => {
                    if (t.len() == 0) {
                        return Result.Err("cuerpo chunked incompleto (la conexión se cerró)");
                    }
                    acc = acc + t;
                },
                Result.Err(e) => {
                    return Result.Err("error al leer el cuerpo chunked: " + e);
                },
            }
        } else {
            let n: int = tam_chunk(acc, 0, nl);
            if (n < 0) {
                return Result.Err("cuerpo chunked malformado (tamaño no hexadecimal)");
            }
            if (n == 0) {
                seguir = false;
            } else {
                if (out.len() + n > max) {
                    return Result.Err("cuerpo demasiado grande (chunked > " + to_string(max) + ")");
                }
                // Asegurar el chunk completo + su \r\n final.
                var falta: bool = acc.len() < nl + 2 + n + 2;
                while (falta) {
                    match (leer_con_plazo(conn, plazo_fin)) {
                        Result.Ok(t) => {
                            if (t.len() == 0) {
                                return Result.Err("cuerpo chunked incompleto (la conexión se cerró)");
                            }
                            acc = acc + t;
                            falta = acc.len() < nl + 2 + n + 2;
                        },
                        Result.Err(e) => {
                            return Result.Err("error al leer el cuerpo chunked: " + e);
                        },
                    }
                }
                out = out + acc.sub_bytes(nl + 2, nl + 2 + n);
                acc = acc.sub_bytes(nl + 2 + n + 2, acc.len());
            }
        }
    }
    Result.Ok(out)
}

// M56.4: una lectura respetando el plazo TOTAL de la petición (`plazo_fin` en el reloj monotónico;
// 0 = sin plazo). El primitivo del timeout es por-lectura (`net.set_read_timeout`), así que antes
// de cada lectura se fija a lo que RESTA del plazo — un cliente que gotea octetos no lo renueva.
fn leer_con_plazo(conn: int, plazo_fin: int) -> Result<bytes, string> {
    if (plazo_fin > 0) {
        let restante: int = plazo_fin - time.monotonic();
        if (restante <= 0) {
            return Result.Err("tiempo de espera de lectura agotado");
        }
        net.set_read_timeout(conn, restante);
    }
    net.socket_read_bytes(conn)
}

// M56.1: la versión con límites. Cabeceras acotadas por `max_header_bytes` (si el separador no
// aparece dentro del tope, se corta), cuerpo acotado por `max_body_bytes` (contra el
// Content-Length declarado, ANTES de leerlo), y un cuerpo que el peer no completa es Err (antes:
// Ok silencioso con el cuerpo a medias). M56.4: leer la petición ENTERA (cabeceras + cuerpo) debe
// caber en `read_timeout_millis`.
/// Like `read_request`, with explicit safety limits: Err if the headers exceed
/// `max_header_bytes`, if `Content-Length` exceeds `max_body_bytes`, if the peer closes
/// the connection before sending the full declared body, or if reading the whole request
/// takes longer than `read_timeout_millis`.
pub fn read_request_limits(conn: int, limits: Limits) -> Result<Request, string> {
    // El plazo total: instante monotónico en que la lectura de ESTA petición vence (0 = sin plazo).
    let plazo_fin: int = if (limits.read_timeout_millis > 0) { time.monotonic() + limits.read_timeout_millis } else { 0 };
    var acc: bytes = b"";
    var sep: int = 0 - 1;
    var desde: int = 0;
    var seguir: bool = true;
    while (seguir) {
        let s: int = find_fin_cabeceras(acc, desde);
        if (s >= 0) {
            sep = s;
            seguir = false;
        } else {
            // Reanudar 3 octetos atrás: el "\r\n\r\n" puede quedar partido entre dos trozos.
            desde = acc.len() - 3;
            if (acc.len() > limits.max_header_bytes) {
                return Result.Err("cabeceras demasiado grandes (más de " + to_string(limits.max_header_bytes) + " octetos)");
            }
            match (leer_con_plazo(conn, plazo_fin)) {
                Result.Ok(trozo) => {
                    if (trozo.len() == 0) {
                        seguir = false;
                    } else {
                        acc = acc + trozo;
                    }
                },
                Result.Err(e) => {
                    // M56.6: EOF/timeout SIN haber recibido nada = el peer no va a pedir más (el
                    // caso normal de una conexión keep-alive que se cierra u ociosa) — error
                    // distinguible para que el servidor cierre en silencio, sin 400 ni ruido.
                    if (acc.len() == 0) {
                        return Result.Err("conexión cerrada");
                    }
                    return Result.Err("error al leer: " + e);
                },
            }
        }
    }
    if (sep < 0) {
        if (acc.len() == 0) {
            return Result.Err("conexión cerrada");
        }
        return Result.Err("petición incompleta (sin fin de cabeceras)");
    }
    // El tope también sobre el separador encontrado: sin esto, unas cabeceras que llegan en un
    // solo trozo grande pasarían y el límite dependería del troceo de la red (no determinista).
    if (sep + 4 > limits.max_header_bytes) {
        return Result.Err("cabeceras demasiado grandes (más de " + to_string(limits.max_header_bytes) + " octetos)");
    }

    var body: bytes = acc.sub_bytes(sep + 4, acc.len());
    match (from_utf8(acc.sub_bytes(0, sep))) {
        Result.Err(e) => Result.Err("cabeceras de la petición no son UTF-8: " + e),
        Result.Ok(cabeceras_raw) => {
            let lineas: [string] = cabeceras_raw.split("\r\n");

            // Línea de petición: "GET /ruta?query HTTP/1.1". M56.2: se parte en el PRIMER `?`
            // (la query cruda va aparte) y la ruta se decodifica (%XX; un escape inválido es 400,
            // no una ruta corrupta silenciosa).
            let partes: [string] = lineas[0].split(" ");
            if (partes.len() < 2) {
                return Result.Err("línea de petición malformada: " + lineas[0]);
            }
            let method: string = partes[0];
            let target: string = partes[1];
            let version: string = if (partes.len() >= 3) { partes[2] } else { "" };
            var path_raw: string = target;
            var query: string = "";
            match (index_of(target, "?")) {
                Option.Some(q) => {
                    path_raw = target.substring(0, q);
                    query = target.substring(q + 1, target.len());
                },
                Option.None => { },
            }
            var path: string = path_raw;
            match (url.percent_decode(path_raw)) {
                Result.Ok(p) => { path = p; },
                Result.Err(e) => {
                    return Result.Err("ruta malformada (" + e + "): " + path_raw);
                },
            }

            // Cabeceras (nombre en minúsculas para lookup case-insensitive).
            var headers: Map<string, string> = Map.new();
            var i: int = 1;
            while (i < lineas.len()) {
                match (index_of(lineas[i], ":")) {
                    Option.Some(c) => {
                        let nombre: string = lineas[i].substring(0, c).trim().to_lower();
                        let valor: string = lineas[i].substring(c + 1, lineas[i].len()).trim();
                        headers.insert(nombre, valor);
                    },
                    Option.None => { },
                }
                i = i + 1;
            }

            // M56.8: un cuerpo `Transfer-Encoding: chunked` se decodifica (antes llegaba vacío en
            // silencio). Tiene prioridad sobre Content-Length (RFC 7230 §3.3.3).
            var chunked: bool = false;
            match (get(headers, "transfer-encoding")) {
                Option.Some(te) => {
                    chunked = te.to_lower().contains("chunked");
                },
                Option.None => { },
            }
            if (chunked) {
                match (leer_cuerpo_chunked(conn, body, plazo_fin, limits.max_body_bytes)) {
                    Result.Ok(b2) => {
                        body = b2;
                    },
                    Result.Err(e) => {
                        return Result.Err(e);
                    },
                }
            }
            // Cuerpo: si hay Content-Length (octetos), completar la lectura hasta esa longitud.
            // M56.1: el tope se comprueba contra lo DECLARADO (antes de leer nada); un peer que
            // cierra sin completar el cuerpo es error (no un Ok truncado); y el cuerpo se recorta
            // a n (un trozo puede traer octetos de más).
            if (!chunked) { match (get(headers, "content-length")) {
                Option.Some(cl) => {
                    match (parse_int(cl)) {
                        Option.Some(n) => {
                            if (n > limits.max_body_bytes) {
                                return Result.Err("cuerpo demasiado grande (Content-Length " + to_string(n) + " > " + to_string(limits.max_body_bytes) + ")");
                            }
                            while (body.len() < n) {
                                match (leer_con_plazo(conn, plazo_fin)) {
                                    Result.Ok(trozo) => {
                                        if (trozo.len() == 0) {
                                            return Result.Err("cuerpo incompleto: la conexión se cerró con " + to_string(body.len()) + " de " + to_string(n) + " octetos");
                                        }
                                        body = body + trozo;
                                    },
                                    Result.Err(e) => {
                                        return Result.Err("error al leer el cuerpo: " + e);
                                    },
                                }
                            }
                            if (body.len() > n) {
                                body = body.sub_bytes(0, n);
                            }
                        },
                        Option.None => { },
                    }
                },
                Option.None => { },
            } }

            // Petición leída: quitar el timeout (el handler puede retener la conexión — SSE — o un
            // handler crudo leer más; que no herede un plazo casi vencido).
            if (plazo_fin > 0) {
                net.set_read_timeout(conn, 0);
            }
            Result.Ok(Request { method: method, path: path, query: query, version: version, headers: headers, body: body })
        },
    }
}

// --- Escritura de la respuesta ---
/// Writes response `r` to connection `conn` as an HTTP/1.1 message: status line, automatic `Content-Length`
/// and `Connection: close`, the user headers (in sorted key order, deterministic), then the raw body bytes.
/// Returns the underlying socket write result; Err on write failure. (The keep-alive variant is what
/// `serve` uses internally, M56.6; raw handlers keep one-response-per-connection semantics.)
pub fn send_response(conn: int, r: Response) -> Result<int, string> {
    send_response_keep(conn, r, false, false)
}

// M56.6: la escritura real, con el header `Connection` según si la conexión sigue viva (keep-alive
// del camino `serve`) o se cierra (el default histórico y el de los handlers crudos). M56.8:
// `omit_body` = respuesta a un HEAD — cabeceras completas (incl. el Content-Length que tendría el
// GET) pero SIN el cuerpo (RFC 9110 §9.3.2).
fn send_response_keep(conn: int, r: Response, keep: bool, omit_body: bool) -> Result<int, string> {
    // Cabecera = texto (Content-Length en octetos, ya correcto); cuerpo = bytes crudos. Se envía todo
    // junto como bytes para no corromper un cuerpo binario.
    var head: string = "HTTP/1.1 " + to_string(r.status) + " " + status_text(r.status) + "\r\n";
    head = head + "Content-Length: " + to_string(r.body.len()) + "\r\n";
    head = head + "Connection: " + (if (keep) { "keep-alive" } else { "close" }) + "\r\n";
    // Cabeceras del usuario (keys() está ordenada → salida determinista).
    let ks: [string] = r.headers.keys();
    var i: int = 0;
    while (i < ks.len()) {
        match (get(r.headers, ks[i])) {
            Option.Some(v) => {
                head = head + ks[i] + ": " + v + "\r\n";
            },
            Option.None => { },
        }
        i = i + 1;
    }
    // M56.7: una línea Set-Cookie por cookie, en orden de inserción (la única cabecera repetible).
    var c: int = 0;
    while (c < r.set_cookie.len()) {
        head = head + "Set-Cookie: " + r.set_cookie[c] + "\r\n";
        c = c + 1;
    }
    head = head + "\r\n";
    if (omit_body) {
        return net.socket_write_bytes(conn, head.to_bytes());
    }
    net.socket_write_bytes(conn, head.to_bytes() + r.body)
}

// --- SSE (server-sent events): HTTP que no cierra y va emitiendo eventos ---
// Abre un stream SSE: 200 + Content-Type: text/event-stream (mantiene la conexión viva).
/// Opens a server-sent events stream on `conn`: writes a 200 with `Content-Type: text/event-stream`
/// and keeps the connection alive. Follow with `sse_event` calls; Err on write failure.
pub fn sse_open(conn: int) -> Result<int, string> {
    var out: string = "HTTP/1.1 200 OK\r\n";
    out = out + "Content-Type: text/event-stream\r\n";
    out = out + "Cache-Control: no-cache\r\n";
    out = out + "Connection: keep-alive\r\n\r\n";
    net.socket_write(conn, out)
}

// Emite un evento SSE: "data: <texto>\n\n".
/// Emits one SSE event on an open stream: writes "data: <data>\n\n". Err on write failure (e.g. client disconnected).
pub fn sse_event(conn: int, data: string) -> Result<int, string> {
    net.socket_write(conn, "data: " + data + "\n\n")
}

// --- El bucle del servidor (concurrente: una fibra por conexión) ---
// Atiende UNA conexión: lee la petición y se la pasa al handler (que controla la conexión). Cierra al
// terminar. Lo usa serve_raw; cada conexión corre en su propia fibra. M56.1: una petición que no se
// pudo leer responde 400 antes de cerrar (best effort, sin filtrar el detalle interno al cliente).
// M56.5: el handler corre en su PROPIA tarea y su fallo se observa con try_join (sin re-lanzar) →
// un panic del handler ya no mata la fibra de la conexión: se loguea, se responde 500 best-effort
// y SIEMPRE se cierra la conexión (antes: fd fugado + token del semáforo fugado + cliente colgado).
fn atender(conn: int, handler: fn(Request, int), limits: Limits) {
    match (read_request_limits(conn, limits)) {
        Result.Ok(req) => {
            let t = spawn(fn() { handler(req, conn) });
            match (try_join(t)) {
                Result.Ok(_) => { },
                Result.Err(e) => {
                    eprint("handler: " + e);
                    // Si el handler ya había respondido, el peer ignora/rechaza este extra.
                    match (send_response(conn, text(500, "Internal Server Error"))) {
                        Result.Ok(_) => { },
                        Result.Err(_) => { },
                    }
                },
            }
        },
        Result.Err(e) => {
            // "conexión cerrada" = el peer cerró sin pedir nada (o quedó ocioso): silencio.
            if (e != "conexión cerrada") {
                eprint("petición: " + e);
                match (send_response(conn, text(400, "Bad Request"))) {
                    Result.Ok(_) => { },
                    Result.Err(_) => { },
                }
            }
        },
    }
    close(conn);
}

// ¿La petición pide cerrar la conexión tras responder? Cerramos si no es HTTP/1.1 (el keep-alive
// de 1.0 es opt-in y declinarlo siempre es válido) o si trae `Connection: close`.
fn quiere_cerrar(req: Request) -> bool {
    if (req.version != "HTTP/1.1") {
        return true;
    }
    match (get(req.headers, "connection")) {
        Option.Some(v) => v.to_lower().contains("close"),
        Option.None => false,
    }
}

// M56.6: atiende una conexión del camino ergonómico (`serve`/`serve_tls`) con **keep-alive**: sirve
// peticiones en bucle sobre la MISMA conexión (HTTP/1.1) hasta que el cliente pida cerrar
// (`Connection: close`), cierre él mismo, quede ocioso (vence `read_timeout_millis`) o algo falle.
// Aquí sí podemos: la respuesta la escribe el servidor (el framing por Content-Length ya es
// correcto), así que el header `Connection` siempre dice la verdad. Cada petición corre su handler
// en su PROPIA tarea (M56.5): un panic responde 500 y cierra, sin fugar nada.
fn atender_http(conn: int, handler: fn(Request) -> Response, limits: Limits) {
    var seguir: bool = true;
    while (seguir) {
        match (read_request_limits(conn, limits)) {
            Result.Ok(req) => {
                let cerrar: bool = quiere_cerrar(req);
                // M56.8: a un HEAD se le responden las cabeceras del GET equivalente SIN el cuerpo.
                let es_head: bool = req.method == "HEAD";
                let t = spawn(fn() -> Response { handler(req) });
                match (try_join(t)) {
                    Result.Ok(resp) => {
                        match (send_response_keep(conn, resp, !cerrar, es_head)) {
                            Result.Ok(_) => { },
                            Result.Err(e) => {
                                eprint("respuesta: " + e);
                                seguir = false;
                            },
                        }
                    },
                    Result.Err(e) => {
                        eprint("handler: " + e);
                        match (send_response(conn, text(500, "Internal Server Error"))) {
                            Result.Ok(_) => { },
                            Result.Err(_) => { },
                        }
                        seguir = false;
                    },
                }
                if (cerrar) {
                    seguir = false;
                }
            },
            Result.Err(e) => {
                if (e != "conexión cerrada") {
                    eprint("petición: " + e);
                    match (send_response(conn, text(400, "Bad Request"))) {
                        Result.Ok(_) => { },
                        Result.Err(_) => { },
                    }
                }
                seguir = false;
            },
        }
    }
    close(conn);
}

// Servidor de bajo nivel: el handler recibe la petición Y la conexión (para responder o hacer streaming
// SSE). Bucle infinito; cada conexión en su fibra. **Solo VM.**
/// Low-level concurrent server: listens on `host:port` and runs each connection in its own fiber.
/// The handler receives the parsed request AND the connection, so it can reply itself or stream (SSE);
/// the connection is closed after the handler returns. Uses `default_limits()`. VM only (needs fibers).
pub fn serve_raw(host: string, port: int, handler: fn(Request, int)) -> Result<int, string> {
    serve_raw_limits(host, port, default_limits(), handler)
}

// M56.1: la versión con límites. Dos defensas nuevas en el bucle de accept:
//   - **Tope de conexiones simultáneas** vía un canal acotado como SEMÁFORO (M12.2): `send` mete
//     un token antes de spawnear y CEDE la fibra si el canal está lleno → backpressure natural
//     (se deja de aceptar hasta que alguna conexión termine y saque su token con `recv`). Sin
//     estado mutable compartido: compone con los actores de heap aislado (M38).
//   - **Accept resiliente**: un error transitorio de accept (p. ej. sin descriptores) ya no tumba
//     el servidor; se loguea y se sigue. Solo errores PERSISTENTES (100 seguidos, sin ningún
//     accept exitoso entre medias) rinden el bucle.
/// Like `serve_raw`, with explicit safety limits (`Limits`): bounds header/body sizes per request
/// and caps simultaneous connections (accept pauses while at the cap; `max_conns <= 0` = unbounded).
/// Transient accept errors are logged and retried; only persistent failure stops the server.
pub fn serve_raw_limits(host: string, port: int, limits: Limits, handler: fn(Request, int)) -> Result<int, string> {
    // TCP plano: la conexión aceptada se atiende tal cual (preparar = identidad).
    bucle_servidor(host, port, limits, fn(c: int) -> Result<int, string> { Result.Ok(c) }, fn(c: int) {
        atender(c, handler, limits);
    })
}

// El bucle de accept compartido por TCP plano y TLS (M56.3). `preparar` transforma la conexión
// recién aceptada antes de atenderla (identidad para HTTP; `net.tls_accept` para HTTPS) y corre
// DENTRO de la fibra de la conexión: un handshake TLS lento no frena el accept de las demás.
// M56.6: `atender_conn` es quien atiende la conexión preparada (una petición y cerrar —crudo— o
// el bucle keep-alive —ergonómico—); debe CERRAR la conexión al terminar.
fn bucle_servidor(host: string, port: int, limits: Limits, preparar: fn(int) -> Result<int, string>, atender_conn: fn(int)) -> Result<int, string> {
    match (net.tcp_listen(host, port)) {
        Result.Err(e) => Result.Err(e),
        Result.Ok(srv) => {
            print("escuchando en el puerto " + to_string(net.local_port(srv)));
            let acotado: bool = limits.max_conns > 0;
            let sem: Channel<int> = if (acotado) { Channel.bounded(limits.max_conns) } else { Channel.new() };
            var errores: int = 0;
            var seguir: bool = true;
            while (seguir) {
                match (net.tcp_accept(srv)) {
                    Result.Ok(conn) => {
                        errores = 0;
                        if (acotado) {
                            send(sem, 1);
                        }
                        spawn(fn() {
                            match (preparar(conn)) {
                                Result.Ok(c) => {
                                    atender_conn(c);
                                },
                                Result.Err(e) => {
                                    eprint("conexión: " + e);
                                    close(conn);
                                },
                            }
                            if (acotado) {
                                recv(sem);
                            }
                        });
                    },
                    Result.Err(e) => {
                        eprint("aceptar: " + e);
                        errores = errores + 1;
                        if (errores >= 100) {
                            seguir = false;
                        }
                    },
                }
            }
            close(srv);
            Result.Ok(0)
        },
    }
}

// Servidor ergonómico: el handler es petición → respuesta; serve escribe la respuesta y —desde
// M56.6— mantiene la conexión viva entre peticiones (keep-alive HTTP/1.1; honra `Connection:
// close` y el ocio lo corta `read_timeout_millis`). **Solo VM.**
/// Ergonomic concurrent server: the handler maps a Request to a Response, which is sent
/// automatically. Connections are kept alive between requests (HTTP/1.1 keep-alive; honors
/// `Connection: close`; idle connections are closed by the read timeout). One fiber per
/// connection; `default_limits()`. Blocks forever; VM only.
pub fn serve(host: string, port: int, handler: fn(Request) -> Response) -> Result<int, string> {
    serve_limits(host, port, default_limits(), handler)
}

/// Like `serve`, with explicit safety limits (see `Limits`/`serve_raw_limits`).
pub fn serve_limits(host: string, port: int, limits: Limits, handler: fn(Request) -> Response) -> Result<int, string> {
    bucle_servidor(host, port, limits, fn(c: int) -> Result<int, string> { Result.Ok(c) }, fn(c: int) {
        atender_http(c, handler, limits);
    })
}

// --- HTTPS (M56.3): el mismo servidor sobre TLS ---
// Cierra el hueco "tls_accept existe pero serve_raw no deja insertarlo": el upgrade TLS es el
// paso `preparar` del bucle compartido, dentro de la fibra de cada conexión. `cert`/`key` son los
// PEM (contenido, no ruta), como `net.tls_accept`. El handshake real ocurre en la primera I/O
// (cede al scheduler, M19.4b); un cliente que habla HTTP plano contra el puerto TLS falla su
// conexión con error logueado, sin tocar a las demás.
/// HTTPS server: like `serve`, but each accepted connection is upgraded to server-side TLS with
/// the given PEM certificate chain and private key (contents, not paths) before reading the
/// request. Keep-alive like `serve`. Uses `default_limits()`. Blocks forever; VM only.
pub fn serve_tls(host: string, port: int, cert: string, key: string, handler: fn(Request) -> Response) -> Result<int, string> {
    serve_tls_limits(host, port, cert, key, default_limits(), handler)
}

/// Like `serve_tls`, with explicit safety limits (see `Limits`).
pub fn serve_tls_limits(host: string, port: int, cert: string, key: string, limits: Limits, handler: fn(Request) -> Response) -> Result<int, string> {
    bucle_servidor(host, port, limits, fn(c: int) -> Result<int, string> {
        net.tls_accept(c, cert, key)
    }, fn(c: int) {
        atender_http(c, handler, limits);
    })
}

/// Low-level HTTPS server: like `serve_raw` over TLS — the handler receives the request AND the
/// (TLS) connection, so it can stream (SSE over HTTPS). Uses `default_limits()`. VM only.
pub fn serve_raw_tls(host: string, port: int, cert: string, key: string, handler: fn(Request, int)) -> Result<int, string> {
    serve_raw_tls_limits(host, port, cert, key, default_limits(), handler)
}

/// Like `serve_raw_tls`, with explicit safety limits (see `Limits`).
pub fn serve_raw_tls_limits(host: string, port: int, cert: string, key: string, limits: Limits, handler: fn(Request, int)) -> Result<int, string> {
    bucle_servidor(host, port, limits, fn(c: int) -> Result<int, string> {
        net.tls_accept(c, cert, key)
    }, fn(c: int) {
        atender(c, handler, limits);
    })
}
