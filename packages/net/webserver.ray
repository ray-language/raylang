// M19.1 — un servidor web HTTP/1.1 CONCURRENTE escrito EN raylang, con soporte de SSE.
//
// Como http.ray/json.ray: cero runtime, cero builtins nuevos; puro raylang + stdlib, importable. Se
// apoya en el servidor concurrente de M15.5/M17 (tcp_listen/tcp_accept/socket_read/socket_write ceden
// al scheduler → muchas conexiones a la vez en un hilo, readiness por kqueue/epoll). **Solo VM** (la
// concurrencia es VM-only).
//
// M19.2: el cuerpo (de la petición y de la respuesta) es **bytes** → binario correcto (imágenes, etc.),
// no solo texto. Las cabeceras siguen siendo texto (ASCII). Los atajos de respuesta de texto (ok/text/
// json_response) aceptan string y lo codifican; bytes_response acepta bytes crudos. TLS (https) es M19.4.
import std/net;
import std/url;
import std/time;
import std/fs;
import net/trace;

// M56.2: `path` llega DECODIFICADO (%XX; un `+` es literal en rutas) y SIN la query string, que
// va aparte en `query` (cruda, sin el `?`) — así el enrutado por ruta funciona con `?x=1` y el
// usuario parsea la query solo si la necesita (`query_params`). M56.6: `version` es la de la
// línea de petición ("HTTP/1.1"; "" si falta) — decide el keep-alive.
/// An incoming HTTP request: method, request path (percent-decoded, WITHOUT the query string),
/// the raw query string (after `?`, empty if none — parse it with `query_params`), the HTTP
/// version from the request line ("HTTP/1.1"; "" if absent), headers (names lowercased for
/// case-insensitive lookup), and the raw body as bytes (use `request_text` to decode it as UTF-8).
pub struct Request {
    method: string,
    path: string,
    query: string,
    version: string,
    headers: Map<string, string>,
    body: bytes,
}

/// Parses the request's query string into a `Map<string,string>` (keys and values URL-decoded,
/// last duplicate key wins, `+` decodes to space). Empty map if there was no query.
pub fn query_params(req: Request) -> Map<string, string> {
    url.parse_query(req.query)
}

// M88.3: el lado servidor del tracing distribuido. El handler lo llama una vez y enhebra el
// Trace a sus logs (`log.with_trace`) y a sus llamadas salientes (`http.request_traced`).
/// The request's W3C trace context: adopts the incoming `traceparent` header, or starts a new
/// root trace if absent or malformed. Thread it through your logs (`log.with_trace(lg,
/// t.trace_id)`) and outgoing calls (`http.request_traced(..., t)`) to correlate a request
/// end-to-end across services.
pub fn trace_of(req: Request) -> trace.Trace {
    trace.from_headers(req.headers)
}

// M56.1: límites de la frontera de seguridad. Sin ellos, un cliente hostil puede pedir memoria
// ilimitada (cabeceras sin fin o un Content-Length gigante) o agotar los descriptores (conexiones
// sin tope). M56.4: `read_timeout_millis` acota el TIEMPO TOTAL de leer una petición (anti-
// slowloris: una conexión que gotea octetos ya no retiene su fibra para siempre). `serve`/
// `serve_raw` usan `default_limits()`; las variantes `*_limits` los configuran.
/// Safety limits for the server: maximum header bytes, maximum body bytes (as declared by
/// `Content-Length`), maximum simultaneous connections (`max_conns <= 0` = unbounded), and the
/// total time budget in ms for reading one request (`read_timeout_millis <= 0` = no timeout).
/// `serve`/`serve_raw` use `default_limits()`; pass your own via `serve_limits`/`serve_raw_limits`.
pub struct Limits {
    max_header_bytes: int,
    max_body_bytes: int,
    max_conns: int,
    read_timeout_millis: int,
}

/// The default safety limits: 64 KiB of headers, 10 MiB of body, 1024 simultaneous connections,
/// 10 s to read a request.
pub fn default_limits() -> Limits {
    Limits {
        max_header_bytes: 65536,
        max_body_bytes: 10485760,
        max_conns: 1024,
        read_timeout_millis: 10000
    }
}

// M56.7: `headers` es un Map (una cabecera por nombre, ergonómico) y la ÚNICA cabecera que en la
// práctica se repite —`Set-Cookie` (varias cookies en una respuesta: sesión + flash…)— tiene su
// campo dedicado `set_cookie` (una línea por cookie, en orden de inserción; `with_cookie` para
// encadenar). Decisión fijada con el usuario (DESIGN §60).
/// An outgoing HTTP response: status code, extra headers (one per name), the `Set-Cookie` lines
/// (one per cookie, sent in insertion order — the one response header that legitimately repeats;
/// add them with `with_cookie`), and the body as raw bytes. `Content-Length` and `Connection`
/// are added automatically by `send_response`.
pub struct Response {
    status: int,
    headers: Map<string, string>,
    set_cookie: [string],
    body: bytes,
    // M110: respuesta en STREAMING — si no está vacío, el cuerpo NO es `body` sino los trozos que
    // lleguen por el canal ([canal] = streaming; [] = respuesta normal): el bucle de servicio los
    // escribe con Transfer-Encoding: chunked según llegan y termina cuando el productor lo cierra.
    // Construir con `stream_response`.
    stream: [Channel<bytes>],
}

// --- Respuestas: atajos para los casos comunes ---
// Respuesta de texto: el cuerpo se codifica a UTF-8.
/// Builds a text response with the given status: the body string is encoded to UTF-8 bytes, no extra headers.
pub fn text(status: int, body: string) -> Response {
    Response {
        status: status,
        headers: Map.new(),
        set_cookie: [],
        body: body.to_bytes(),
        stream: []
    }
}

// Respuesta binaria: el cuerpo va tal cual (octetos crudos).
/// Builds a binary response with the given status: the body bytes are sent verbatim (images, downloads, etc.).
pub fn bytes_response(status: int, body: bytes) -> Response {
    Response { status: status, headers: Map.new(), set_cookie: [], body: body, stream: [] }
}

/// Appends one `Set-Cookie` line to the response and returns it (chainable with UFCS:
/// `ok(html).with_cookie("sid=…; Path=/; HttpOnly").with_cookie("flash=…")`).
pub fn with_cookie(r: Response, line: string) -> Response {
    r.set_cookie.push(line);
    r
}

// M110: respuesta en streaming — el cuerpo son los trozos del canal, en chunked, según llegan.
/// Builds a STREAMING response: the body is whatever arrives on `ch`, written to the client as
/// each piece arrives (`Transfer-Encoding: chunked`) until the producer `close`s the channel.
/// Spawn the producer and return immediately:
///
/// ```ray
/// let ch: Channel<bytes> = Channel.bounded(8);   // bounded = backpressure hacia el productor
/// spawn(fn() {
///     send(ch, b"chunk 1");
///     send(ch, b"chunk 2");
///     close(ch);
/// });
/// webserver.stream_response(200, ch)
/// ```
///
/// The connection always closes after a stream (no keep-alive); a HEAD request gets the headers
/// only (the channel is still drained so the producer never blocks forever). Set `Content-Type`
/// on the returned response as usual.
pub fn stream_response(status: int, ch: Channel<bytes>) -> Response {
    Response { status: status, headers: Map.new(), set_cookie: [], body: b"", stream: [ch] }
}

// Entero a hexadecimal en minúsculas (el tamaño de un chunk del framing).
fn to_hex(n0: int) -> string {
    if (n0 == 0) {
        return "0";
    }
    let digits: string = "0123456789abcdef";
    var n: int = n0;
    var out: string = "";
    while (n > 0) {
        out = to_string(digits[n % 16]) + out;
        n = n / 16;
    }
    out
}

/// Builds a 200 OK text response with the given body.
pub fn ok(body: string) -> Response {
    text(200, body)
}

/// Builds a 404 Not Found text response with the body "Not Found".
pub fn not_found() -> Response {
    text(404, "Not Found")
}

/// Builds a 200 response with `Content-Type: application/json`. `body` must already be serialized JSON text.
pub fn json_response(body: string) -> Response {
    var h: Map<string, string> = Map.new();
    h.insert("Content-Type", "application/json; charset=utf-8");
    Response { status: 200, headers: h, set_cookie: [], body: body.to_bytes(), stream: [] }
}

// Respuesta HTML con el charset declarado. `text`/`ok` NO ponen Content-Type → el navegador adivina
// el encoding (Latin-1 en la práctica), que estropea el UTF-8 (acentos, «—»). Para servir HTML usa
// esto, que declara `text/html; charset=utf-8`. El cuerpo es UTF-8 (los strings de raylang lo son).
/// Builds an HTML response with the given status and `Content-Type: text/html; charset=utf-8` — the
/// header a browser needs to render UTF-8 correctly. Prefer this over `text`/`ok` for HTML.
pub fn html_response(status: int, body: string) -> Response {
    var h: Map<string, string> = Map.new();
    h.insert("Content-Type", "text/html; charset=utf-8");
    Response { status: status, headers: h, set_cookie: [], body: body.to_bytes(), stream: [] }
}

// El cuerpo de una petición decodificado como texto UTF-8 (para formularios/JSON entrantes). Para datos
// binarios entrantes, usa `req.body` (bytes) directamente.
/// Decodes the request body as UTF-8 text (for incoming forms/JSON).
/// Err if the body is not valid UTF-8; for binary payloads use `req.body` directly.
pub fn request_text(req: Request) -> Result<string, string> {
    from_utf8(req.body)
}

// --- Archivos estáticos (M56.8; M56.9: mount con prefijo + caching ETag/304) ---
// El Content-Type por extensión del archivo (los tipos comunes de una web; el resto, octet-stream).
/// Content-Type for a file name, by extension (the common web types; anything else is
/// `application/octet-stream`). Public so custom handlers can reuse it when building their own
/// responses (e.g. serving generated files with the right type).
pub fn mime_of(file: string) -> string {
    let f = file.to_lower();
    if (f.ends_with(".html") || f.ends_with(".htm")) {
        return "text/html; charset=utf-8";
    }
    if (f.ends_with(".css")) {
        return "text/css; charset=utf-8";
    }
    if (f.ends_with(".js") || f.ends_with(".mjs")) {
        return "text/javascript; charset=utf-8";
    }
    if (f.ends_with(".json") || f.ends_with(".map")) {
        return "application/json; charset=utf-8";
    }
    if (f.ends_with(".txt")) {
        return "text/plain; charset=utf-8";
    }
    if (f.ends_with(".csv")) {
        return "text/csv; charset=utf-8";
    }
    if (f.ends_with(".xml")) {
        return "application/xml; charset=utf-8";
    }
    if (f.ends_with(".svg")) {
        return "image/svg+xml";
    }
    if (f.ends_with(".png")) {
        return "image/png";
    }
    if (f.ends_with(".jpg") || f.ends_with(".jpeg")) {
        return "image/jpeg";
    }
    if (f.ends_with(".gif")) {
        return "image/gif";
    }
    if (f.ends_with(".webp")) {
        return "image/webp";
    }
    if (f.ends_with(".avif")) {
        return "image/avif";
    }
    if (f.ends_with(".ico")) {
        return "image/x-icon";
    }
    if (f.ends_with(".pdf")) {
        return "application/pdf";
    }
    if (f.ends_with(".wasm")) {
        return "application/wasm";
    }
    if (f.ends_with(".woff2")) {
        return "font/woff2";
    }
    if (f.ends_with(".woff")) {
        return "font/woff";
    }
    if (f.ends_with(".ttf")) {
        return "font/ttf";
    }
    if (f.ends_with(".otf")) {
        return "font/otf";
    }
    if (f.ends_with(".mp4")) {
        return "video/mp4";
    }
    if (f.ends_with(".webm")) {
        return "video/webm";
    }
    if (f.ends_with(".mp3")) {
        return "audio/mpeg";
    }
    if (f.ends_with(".wav")) {
        return "audio/wav";
    }
    if (f.ends_with(".gz")) {
        return "application/gzip";
    }
    "application/octet-stream"
}

// El SANEO compartido: la ruta de la petición → ruta de archivo bajo `dir`, o None (= 404).
// Un segmento `..` o `.` es rechazo directo (nunca se sale de `dir`; el path ya llega
// percent-decodificado, así que `%2e%2e` también cae aquí). `/` final sirve su `index.html`.
fn static_file_of(dir: string, path: string) -> Option<string> {
    var path: string = path;
    if (path.ends_with("/") || path == "") {
        path = path + "index.html";
    }
    let segs: [string] = path.split("/");
    var clean: [string] = [];
    var i: int = 0;
    while (i < segs.len()) {
        let s: string = segs[i];
        if (s == ".." || s == ".") {
            return Option.None;
        }
        if (s != "") {
            clean.push(s);
        }
        i = i + 1;
    }
    var file: string = dir;
    var j: int = 0;
    while (j < clean.len()) {
        file = file + "/" + clean[j];
        j = j + 1;
    }
    Option.Some(file)
}

// Sirve un archivo estático de `dir` según la ruta de la petición, con SANEO: un segmento `..` o
// `.` es 404 directo (nunca se sale de `dir`; el path ya llega percent-decodificado, así que
// `%2e%2e` también cae aquí). Una ruta que termina en `/` sirve su `index.html`.
/// Serves a static file from `dir` for the given request path (use inside a handler:
/// `webserver.static_response("public", req.path)`). Path-traversal safe: any `..`/`.` segment is
/// a 404 (the path arrives percent-decoded, so `%2e%2e` is covered); a trailing `/` serves the
/// directory's `index.html`. Sets `Content-Type` by extension; unknown files are octet-stream;
/// missing/unreadable files are 404. For prefix mounting, method filtering and HTTP caching
/// (ETag/304), use `static_mount`.
pub fn static_response(dir: string, path: string) -> Response {
    match (static_file_of(dir, path)) {
        Option.Some(file) => {
            match (fs.read_file_bytes(file)) {
                Result.Ok(data) => {
                    let r: Response = bytes_response(200, data);
                    r.headers.insert("Content-Type", mime_of(file));
                    r
                },
                Result.Err(_) => not_found(),
            }
        },
        Option.None => not_found(),
    }
}

// M56.9: mount de estáticos con prefijo + caching HTTP. El ETag es fuerte "<tamaño>-<mtime_ms>"
// (estilo nginx: cambia si cambia el contenido o la fecha; evita hashear el archivo por petición).
/// Serves the static files of `dir` mounted under `prefix` (e.g.
/// `webserver.static_mount("/static/", "assets", req)` serves `/static/app.css` from
/// `assets/app.css`). On top of `static_response` it adds: 404 if the path is outside `prefix`;
/// 405 (`Allow: GET, HEAD`) for methods other than GET/HEAD; and HTTP caching — every 200 carries
/// a strong `ETag` (from the file's size and mtime) and a request whose `If-None-Match` matches
/// is answered `304 Not Modified` without re-reading or resending the body. Add your own
/// `Cache-Control` if you want one: `r.headers.insert("Cache-Control", "max-age=3600")`.
// M110: parsea `Range: bytes=a-b` (UN solo rango) contra un recurso de `size` octetos.
// Devuelve: [] = sin rango / no parseable / múltiple (→ 200 completo, permitido por RFC 9110);
// [a, b] = satisfacible, inclusive (→ 206); [-1] = insatisfacible (→ 416).
fn parse_range(v: string, size: int) -> [int] {
    if (!v.starts_with("bytes=")) {
        return [];
    }
    let spec: string = v.substring(6, v.len()).trim();
    if (spec.contains(",")) {
        return [];  // multi-rango: fuera de v1 → respuesta completa
    }
    match (index_of(
    spec,
    "-"
)) {
        Option.None => [],
        Option.Some(d) => {
            let a_s: string = spec.substring(0, d).trim();
            let b_s: string = spec.substring(d + 1, spec.len()).trim();
            if (a_s == "") {
                // Sufijo "-N": los últimos N octetos.
                match (parse_int(b_s)) {
                    Option.None => [],
                    Option.Some(n) => {
                        if (n <= 0) {
                            return [0 - 1];
                        }
                        let start: int = if (n >= size) { 0 } else { size - n };
                        if (size == 0) { [0 - 1] } else { [start, size - 1] }
                    },
                }
            } else {
                match (parse_int(
            a_s
        )) {
                    Option.None => [],
                    Option.Some(a) => {
                        if (a >= size) {
                            return [0 - 1];  // empieza más allá del final: 416
                        }
                        if (b_s == "") {
                            return [a, size - 1];  // "a-": hasta el final
                        }
                        match (parse_int(
                        b_s
                    )) {
                            Option.None => [],
                            Option.Some(b) => {
                                if (b < a) { [] } else { [a, if (b < size) { b } else { size - 1 }] }
                            },
                        }
                    },
                }
            }
        },
    }
}

pub fn static_mount(prefix: string, dir: string, req: Request) -> Response {
    if (req.method != "GET" && req.method != "HEAD") {
        let r: Response = text(405, "method not allowed\n");
        r.headers.insert("Allow", "GET, HEAD");
        return r;
    }
    if (!req.path.starts_with(prefix)) {
        return not_found();
    }
    let rest: string = req.path.substring(prefix.len(), req.path.len());
    match (static_file_of(
    dir,
    rest
)) {
        Option.Some(file) => {
            // El ETag sale de los metadatos (2 stats, sin leer el cuerpo): si no hay archivo, 404.
            let size: int = match (fs.file_size(file)) {
                Result.Ok(n) => n,
                Result.Err(_) => {
                    return not_found();
                },
            };
            let mtime: int = match (fs.mtime(file)) {
                Result.Ok(ms) => ms,
                Result.Err(_) => {
                    return not_found();
                },
            };
            let etag: string = "\"" + to_string(size) + "-" + to_string(mtime) + "\"";
            // If-None-Match puede traer una lista de ETags → basta que contenga el nuestro.
            match (get(req.headers, "if-none-match")) {
                Option.Some(inm) => {
                    if (inm.contains(etag)) {
                        let r: Response = bytes_response(304, b"");
                        r.headers.insert("ETag", etag);
                        return r;
                    }
                },
                Option.None => { },
            }
            match (fs.read_file_bytes(
            file
        )) {
                Result.Ok(data) => {
                    // M110: Range/206 (solo GET; en HEAD el Range se ignora, permitido por RFC).
                    // `If-Range` con validador distinto al nuestro → respuesta completa (el
                    // archivo cambió bajo una descarga reanudada; servir el trozo corrompería).
                    var range_v: string = "";
                    if (req.method == "GET") {
                        match (get(req.headers, "range")) {
                            Option.Some(rv) => {
                                range_v = rv;
                            },
                            Option.None => { },
                        }
                        match (get(req.headers, "if-range")) {
                            Option.Some(ir) => {
                                if (ir.trim() != etag) {
                                    range_v = "";
                                }
                            },
                            Option.None => { },
                        }
                    }
                    if (range_v != "") {
                        let rng: [int] = parse_range(range_v, data.len());
                        if (rng.len() == 1) {
                            let r416: Response = text(416, "range not satisfiable\n");
                            r416.headers.insert(
                                "Content-Range",
                                "bytes */" + to_string(data.len())
                            );
                            r416.headers.insert("ETag", etag);
                            return r416;
                        }
                        if (rng.len() == 2) {
                            let piece: bytes = data.sub_bytes(rng[0], rng[1] + 1);
                            let r206: Response = bytes_response(206, piece);
                            r206.headers.insert("Content-Type", mime_of(file));
                            r206.headers.insert("ETag", etag);
                            r206.headers.insert("Accept-Ranges", "bytes");
                            r206.headers.insert(
                                "Content-Range",
                                "bytes " + to_string(rng[0]) + "-" + to_string(rng[1]) + "/" + to_string(data.len())
                            );
                            return r206;
                        }
                    }
                    let r: Response = bytes_response(200, data);
                    r.headers.insert("Content-Type", mime_of(file));
                    r.headers.insert("ETag", etag);
                    r.headers.insert("Accept-Ranges", "bytes");
                    r
                },
                Result.Err(_) => not_found(),
            }
        },
        Option.None => not_found(),
    }
}

// La frase de estado para los códigos comunes (HTTP la exige tras el número). M56.1: cubre
// también redirecciones (3xx), auth (401/403), 405/413/429/431 y los 5xx de gateway.
fn status_text(code: int) -> string {
    if (code == 200) { "OK" } else if (code == 201) { "Created" } else if (code == 204) { "No Content" } else if (code == 206) { "Partial Content" } else if (code == 301) { "Moved Permanently" } else if (code == 302) { "Found" } else if (code == 303) { "See Other" } else if (code == 304) { "Not Modified" } else if (code == 307) { "Temporary Redirect" } else if (code == 308) { "Permanent Redirect" } else if (code == 400) { "Bad Request" } else if (code == 401) { "Unauthorized" } else if (code == 403) { "Forbidden" } else if (code == 404) { "Not Found" } else if (code == 405) { "Method Not Allowed" } else if (code == 409) { "Conflict" } else if (code == 413) { "Content Too Large" } else if (code == 415) { "Unsupported Media Type" } else if (code == 416) { "Range Not Satisfiable" } else if (code == 422) { "Unprocessable Content" } else if (code == 429) { "Too Many Requests" } else if (code == 431) { "Request Header Fields Too Large" } else if (code == 500) { "Internal Server Error" } else if (code == 501) { "Not Implemented" } else if (code == 502) { "Bad Gateway" } else if (code == 503) { "Service Unavailable" } else if (code == 504) { "Gateway Timeout" } else { "Status" }
}

// --- Lectura de la petición ---
// El índice del primer "\r\n\r\n" (fin de cabeceras) en bytes desde `desde`, o -1. Escanea por
// octetos (CR=13, LF=10): no se puede usar index_of (es de string) porque el cuerpo binario
// rompería from_utf8 del buffer entero. `desde` permite REANUDAR el escaneo donde quedó el trozo
// anterior (M56.1): sin él, re-escanear todo el acumulado por trozo es O(n²) — un amplificador
// del ataque de cabeceras gigantes.
fn find_fin_headers(b: bytes, start: int) -> int {
    var i: int = start;
    if (i < 0) {
        i = 0;
    }
    while (i + 3 < b.len()) {
        if (b[i] == 13 && b[i + 1] == 10 && b[i + 2] == 13 && b[i + 3] == 10) {
            return i;
        }
        i = i + 1;
    }
    0 - 1
}

// Lee una petición HTTP completa de la conexión: acumula bytes hasta el fin de cabeceras (\r\n\r\n),
// decodifica SOLO las cabeceras como texto para parsearlas, y —si hay Content-Length— sigue leyendo
// hasta completar el cuerpo (bytes crudos, octetos). M19.2: cuerpo binario correcto.
/// Reads one full HTTP request from connection `conn`: accumulates bytes until the end of headers (\r\n\r\n),
/// parses the request line and headers (header names lowercased), then keeps reading until `Content-Length` bytes of body.
/// Blocks (yielding to the scheduler) on socket reads; Err on read failure, malformed request line, or non-UTF-8 headers.
/// Uses `default_limits()`; to configure them, use `read_request_limits`.
pub fn read_request(conn: int) -> Result<Request, string> {
    read_request_limits(conn, default_limits())
}

// --- Cuerpo chunked entrante (M56.8, Transfer-Encoding: chunked) ---
// El índice del primer "\r\n" en `b` desde `desde`, o -1 (escaneo por octetos, como el fin de cabeceras).
fn find_crlf(b: bytes, start: int) -> int {
    var i: int = start;
    while (i + 1 < b.len()) {
        if (b[i] == 13 && b[i + 1] == 10) {
            return i;
        }
        i = i + 1;
    }
    0 - 1
}

// El valor de un dígito hexadecimal (octeto ASCII), o -1.
fn hex_digit(b: int) -> int {
    if (b >= 48 && b <= 57) {
        return b - 48;  // 0-9
    }
    if (b >= 97 && b <= 102) {
        return b - 97 + 10;  // a-f
    }
    if (b >= 65 && b <= 70) {
        return b - 65 + 10;  // A-F
    }
    0 - 1
}

// El tamaño de un chunk: hex desde el inicio de la línea hasta `;` (extensiones, se ignoran) o el
// fin de línea. -1 si no hay ni un dígito válido.
fn tam_chunk(b: bytes, ini: int, fin: int) -> int {
    var n: int = 0;
    var i: int = ini;
    var any_found: bool = false;
    while (i < fin) {
        if (b[i] == 59) {
            // ';' → extensión de chunk: ignorar el resto
            i = fin;
        } else {
            let d: int = hex_digit(b[i]);
            if (d < 0) {
                return 0 - 1;
            }
            n = n * 16 + d;
            any_found = true;
            i = i + 1;
        }
    }
    if (any_found) { n } else { 0 - 1 }
}

// Decodifica un cuerpo `Transfer-Encoding: chunked`: líneas `tamaño-hex\r\n` + datos + `\r\n`,
// terminado por el chunk 0 (los trailers, raros, no se soportan: tras el 0 se exige `\r\n`).
// `initial` son los octetos que llegaron pegados a las cabeceras; el tamaño DECODIFICADO acumulado
// respeta `max` y toda la lectura el plazo total.
fn read_body_chunked(conn: int, initial: bytes, deadline: int, max: int) -> Result<bytes, string> {
    var acc: bytes = initial;
    var out: bytes = b"";
    var follow: bool = true;
    while (follow) {
        let nl: int = find_crlf(acc, 0);
        if (nl < 0) {
            match (read_with_deadline(conn, deadline)) {
                Result.Ok(t) => {
                    if (t.len() == 0) {
                        return Result.Err("incomplete chunked body (the connection closed)");
                    }
                    acc = acc + t;
                },
                Result.Err(e) => {
                    return Result.Err("error reading the chunked body: " + e);
                },
            }
        } else {
            let n: int = tam_chunk(acc, 0, nl);
            if (n < 0) {
                return Result.Err("malformed chunked body (non-hex size)");
            }
            if (n == 0) {
                follow = false;
            } else {
                if (out.len() + n > max) {
                    return Result.Err("body too large (chunked > " + to_string(max) + ")");
                }
                // Asegurar el chunk completo + su \r\n final.
                var missing: bool = acc.len() < nl + 2 + n + 2;
                while (missing) {
                    match (read_with_deadline(conn, deadline)) {
                        Result.Ok(t) => {
                            if (t.len() == 0) {
                                return Result.Err(
                                    "incomplete chunked body (the connection closed)"
                                );
                            }
                            acc = acc + t;
                            missing = acc.len() < nl + 2 + n + 2;
                        },
                        Result.Err(e) => {
                            return Result.Err("error reading the chunked body: " + e);
                        },
                    }
                }
                out = out + acc.sub_bytes(nl + 2, nl + 2 + n);
                acc = acc.sub_bytes(nl + 2 + n + 2, acc.len());
            }
        }
    }
    Result.Ok(out)
}

// M56.4: una lectura respetando el plazo TOTAL de la petición (`deadline` en el reloj monotónico;
// 0 = sin plazo). El primitivo del timeout es por-lectura (`net.set_read_timeout`), así que antes
// de cada lectura se fija a lo que RESTA del plazo — un cliente que gotea octetos no lo renueva.
fn read_with_deadline(conn: int, deadline: int) -> Result<bytes, string> {
    if (deadline > 0) {
        let remaining: int = deadline - time.monotonic();
        if (remaining <= 0) {
            return Result.Err("read timeout");
        }
        net.set_read_timeout(conn, remaining);
    }
    net.socket_read_bytes(conn)
}

// M56.1: la versión con límites. Cabeceras acotadas por `max_header_bytes` (si el separador no
// aparece dentro del tope, se corta), cuerpo acotado por `max_body_bytes` (contra el
// Content-Length declarado, ANTES de leerlo), y un cuerpo que el peer no completa es Err (antes:
// Ok silencioso con el cuerpo a medias). M56.4: leer la petición ENTERA (cabeceras + cuerpo) debe
// caber en `read_timeout_millis`.
/// Like `read_request`, with explicit safety limits: Err if the headers exceed
/// `max_header_bytes`, if `Content-Length` exceeds `max_body_bytes`, if the peer closes
/// the connection before sending the full declared body, or if reading the whole request
/// takes longer than `read_timeout_millis`.
pub fn read_request_limits(conn: int, limits: Limits) -> Result<Request, string> {
    // El plazo total: instante monotónico en que la lectura de ESTA petición vence (0 = sin plazo).
    let deadline: int = if (limits.read_timeout_millis > 0) { time.monotonic() + limits.read_timeout_millis } else { 0 };
    var acc: bytes = b"";
    var sep: int = 0 - 1;
    var start: int = 0;
    var follow: bool = true;
    while (follow) {
        let s: int = find_fin_headers(acc, start);
        if (s >= 0) {
            sep = s;
            follow = false;
        } else {
            // Reanudar 3 octetos atrás: el "\r\n\r\n" puede quedar partido entre dos trozos.
            start = acc.len() - 3;
            if (acc.len() > limits.max_header_bytes) {
                return Result.Err(
                    "headers too large (more than " + to_string(limits.max_header_bytes) + " bytes)"
                );
            }
            match (read_with_deadline(conn, deadline)) {
                Result.Ok(trozo) => {
                    if (trozo.len() == 0) {
                        follow = false;
                    } else {
                        acc = acc + trozo;
                    }
                },
                Result.Err(e) => {
                    // M56.6: EOF/timeout SIN haber recibido nada = el peer no va a pedir más (el
                    // caso normal de una conexión keep-alive que se cierra u ociosa) — error
                    // distinguible para que el servidor cierre en silencio, sin 400 ni ruido.
                    if (acc.len() == 0) {
                        return Result.Err("connection closed");
                    }
                    return Result.Err("error reading: " + e);
                },
            }
        }
    }
    if (sep < 0) {
        if (acc.len() == 0) {
            return Result.Err("connection closed");
        }
        return Result.Err("incomplete request (no end of headers)");
    }
    // El tope también sobre el separador encontrado: sin esto, unas cabeceras que llegan en un
    // solo trozo grande pasarían y el límite dependería del troceo de la red (no determinista).
    if (sep + 4 > limits.max_header_bytes) {
        return Result.Err(
            "headers too large (more than " + to_string(limits.max_header_bytes) + " bytes)"
        );
    }

    var body: bytes = acc.sub_bytes(sep + 4, acc.len());
    match (from_utf8(
    acc.sub_bytes(0, sep)
)) {
        Result.Err(e) => Result.Err("request headers are not UTF-8: " + e),
        Result.Ok(headers_raw) => {
            let lines: [string] = headers_raw.split("\r\n");

            // Línea de petición: "GET /ruta?query HTTP/1.1". M56.2: se parte en el PRIMER `?`
            // (la query cruda va aparte) y la ruta se decodifica (%XX; un escape inválido es 400,
            // no una ruta corrupta silenciosa).
            let parts: [string] = lines[0].split(" ");
            if (parts.len() < 2) {
                return Result.Err("malformed request line: " + lines[0]);
            }
            let method: string = parts[0];
            let target: string = parts[1];
            let version: string = if (parts.len() >= 3) { parts[2] } else { "" };
            var path_raw: string = target;
            var query: string = "";
            match (index_of(target, "?")) {
                Option.Some(q) => {
                    path_raw = target.substring(0, q);
                    query = target.substring(q + 1, target.len());
                },
                Option.None => { },
            }
            var path: string = path_raw;
            match (url.percent_decode(path_raw)) {
                Result.Ok(p) => {
                    path = p;
                },
                Result.Err(e) => {
                    return Result.Err("path malformada (" + e + "): " + path_raw);
                },
            }

            // Cabeceras (nombre en minúsculas para lookup case-insensitive).
            var headers: Map<string, string> = Map.new();
            var i: int = 1;
            while (i < lines.len()) {
                match (index_of(lines[i], ":")) {
                    Option.Some(c) => {
                        let name: string = lines[i].substring(0, c).trim().to_lower();
                        let value: string = lines[i].substring(c + 1, lines[i].len()).trim();
                        headers.insert(name, value);
                    },
                    Option.None => { },
                }
                i = i + 1;
            }

            // M56.8: un cuerpo `Transfer-Encoding: chunked` se decodifica (antes llegaba vacío en
            // silencio). Tiene prioridad sobre Content-Length (RFC 7230 §3.3.3).
            var chunked: bool = false;
            match (get(headers, "transfer-encoding")) {
                Option.Some(te) => {
                    chunked = te.to_lower().contains("chunked");
                },
                Option.None => { },
            }
            if (chunked) {
                match (read_body_chunked(conn, body, deadline, limits.max_body_bytes)) {
                    Result.Ok(b2) => {
                        body = b2;
                    },
                    Result.Err(e) => {
                        return Result.Err(e);
                    },
                }
            }
            // Cuerpo: si hay Content-Length (octetos), completar la lectura hasta esa longitud.
            // M56.1: el tope se comprueba contra lo DECLARADO (antes de leer nada); un peer que
            // cierra sin completar el cuerpo es error (no un Ok truncado); y el cuerpo se recorta
            // a n (un trozo puede traer octetos de más).
            if (!chunked) {
                match (get(
                headers,
                "content-length"
            )) {
                    Option.Some(cl) => {
                        match (parse_int(
                        cl
                    )) {
                            Option.Some(n) => {
                                if (n > limits.max_body_bytes) {
                                    return Result.Err(
                                        "body too large (Content-Length " + to_string(n) + " > " + to_string(limits.max_body_bytes) + ")"
                                    );
                                }
                                while (body.len() < n) {
                                    match (read_with_deadline(
                                    conn,
                                    deadline
                                )) {
                                        Result.Ok(trozo) => {
                                            if (trozo.len() == 0) {
                                                return Result.Err(
                                                    "incomplete body: the connection closed with " + to_string(body.len()) + " de " + to_string(n) + " bytes"
                                                );
                                            }
                                            body = body + trozo;
                                        },
                                        Result.Err(e) => {
                                            return Result.Err("error reading the body: " + e);
                                        },
                                    }
                                }
                                if (body.len() > n) {
                                    body = body.sub_bytes(0, n);
                                }
                            },
                            Option.None => { },
                        }
                    },
                    Option.None => { },
                }
            }

            // Petición leída: quitar el timeout (el handler puede retener la conexión — SSE — o un
            // handler crudo leer más; que no herede un plazo casi vencido).
            if (deadline > 0) {
                net.set_read_timeout(conn, 0);
            }
            Result.Ok(
                Request {
                    method: method,
                    path: path,
                    query: query,
                    version: version,
                    headers: headers,
                    body: body
                }
            )
        },
    }
}

// --- Escritura de la respuesta ---
/// Writes response `r` to connection `conn` as an HTTP/1.1 message: status line, automatic `Content-Length`
/// and `Connection: close`, the user headers (in sorted key order, deterministic), then the raw body bytes.
/// Returns the underlying socket write result; Err on write failure. (The keep-alive variant is what
/// `serve` uses internally, M56.6; raw handlers keep one-response-per-connection semantics.)
pub fn send_response(conn: int, r: Response) -> Result<int, string> {
    send_response_keep(conn, r, false, false)
}

// M92.4 (live-reload): ¿la respuesta es text/html? (Content-Type, case-insensitive).
fn is_html_response(r: Response) -> bool {
    let ks: [string] = r.headers.keys();
    var i: int = 0;
    var html: bool = false;
    while (i < ks.len()) {
        if (ks[i].to_lower() == "content-type") {
            match (get(r.headers, ks[i])) {
                Option.Some(v) => {
                    if (v.to_lower().contains("text/html")) {
                        html = true;
                    }
                },
                Option.None => { },
            }
        }
        i = i + 1;
    }
    return html;
}

// Inserta `snippet` justo antes de `</body>` (o al final si no aparece).
fn inject_before_body_end(html: string, snippet: string) -> string {
    return match (html.to_lower().index_of("</body>")) {
        Option.Some(i) => html.substring(0, i) + snippet + html.substring(i, html.len()),
        Option.None => html + snippet,
    };
}

// M92.4: bajo `ray dev` con live-reload (`RAY_DEV_RELOAD=<puerto>`), inyecta en las respuestas text/html
// un `EventSource` que recarga la página cuando el supervisor emite `reload` al reiniciar. En producción
// (sin la variable) no hace nada: un solo `env()` por respuesta y retorno inmediato.
// M92.4: bajo `ray dev`, avisa al hub de live-reload (`GET /ready`) que este servidor YA escucha.
// El hub retiene el evento `reload` del reinicio hasta este aviso → el navegador recarga justo
// cuando el servidor nuevo está listo, sin sondear (cero fetch fallidos). Fuera de dev es un no-op.
fn dev_notify_ready() {
    match (env("RAY_DEV_RELOAD")) {
        Option.None => { },
        Option.Some(p) => {
            match (parse_int(p)) {
                Option.None => { },
                Option.Some(hub_port) => {
                    match (net.tcp_connect("127.0.0.1", hub_port)) {
                        Result.Ok(c) => {
                            let _ = net.socket_write(c, "GET /ready HTTP/1.0\r\n\r\n");
                            close(c);
                        },
                        Result.Err(e) => { },  // el hub murió → sin live-reload, el servidor sigue
                    }
                },
            }
        },
    }
}

fn inject_live_reload(r: Response) -> Response {
    return match (env(
        "RAY_DEV_RELOAD"
    )) {
        Option.None => r,
        Option.Some(port) => {
            if (is_html_response(
            r
        )) {
                match (from_utf8(
            r.body
        )) {
                    Result.Ok(html) => {
                        // Recarga directa: el hub retiene el evento hasta el `/ready` de este servidor
                        // (dev_notify_ready, emitido al bindear) → cuando llega, el servidor ya escucha.
                        let snippet: string = "<script>new EventSource(\"http://127.0.0.1:" + port + "/\").onmessage=function(){location.reload()}</script>";
                        Response {
                            status: r.status,
                            headers: r.headers,
                            set_cookie: r.set_cookie,
                            body: inject_before_body_end(html, snippet).to_bytes(),
                            stream: []
                        }
                    },
                    Result.Err(e) => r,  // cuerpo no-UTF8 → intacto
                }
            } else {
                r
            }
        },
    };
}

// M56.6: la escritura real, con el header `Connection` según si la conexión sigue viva (keep-alive
// del camino `serve`) o se cierra (el default histórico y el de los handlers crudos). M56.8:
// `omit_body` = respuesta a un HEAD — cabeceras completas (incl. el Content-Length que tendría el
// GET) pero SIN el cuerpo (RFC 9110 §9.3.2).
fn send_response_keep(conn: int, r0: Response, keep: bool, omit_body: bool) -> Result<int, string> {
    // M110: una respuesta en streaming va por su propio camino (chunked, sin Content-Length,
    // conexión SIEMPRE close). El live-reload no aplica (no hay cuerpo HTML bufferizado).
    if (r0.stream.len() > 0) {
        return send_stream_response(conn, r0, omit_body);
    }
    // M92.4: bajo `ray dev` inyecta el snippet de live-reload en las respuestas HTML (no-op en producción).
    // Se hace ANTES de calcular el Content-Length para que cuadre con el cuerpo ya inyectado.
    let r: Response = inject_live_reload(r0);
    // Cabecera = texto (Content-Length en octetos, ya correcto); cuerpo = bytes crudos. Se envía todo
    // junto como bytes para no corromper un cuerpo binario.
    var head: string = "HTTP/1.1 " + to_string(r.status) + " " + status_text(r.status) + "\r\n";
    head = head + "Content-Length: " + to_string(r.body.len()) + "\r\n";
    head = head + "Connection: " + if (keep) { "keep-alive" } else { "close" } + "\r\n";
    // M85a: la cabecera `Date:` (SHOULD de RFC 7231), en RFC 1123 sobre el reloj UTC.
    head = head + "Date: " + time.to_rfc1123(time.now_utc()) + "\r\n";
    // Cabeceras del usuario (keys() está ordenada → salida determinista).
    let ks: [string] = r.headers.keys();
    var i: int = 0;
    while (i < ks.len()) {
        match (get(r.headers, ks[i])) {
            Option.Some(v) => {
                head = head + ks[i] + ": " + v + "\r\n";
            },
            Option.None => { },
        }
        i = i + 1;
    }
    // M56.7: una línea Set-Cookie por cookie, en orden de inserción (la única cabecera repetible).
    var c: int = 0;
    while (c < r.set_cookie.len()) {
        head = head + "Set-Cookie: " + r.set_cookie[c] + "\r\n";
        c = c + 1;
    }
    head = head + "\r\n";
    if (omit_body) {
        return net.socket_write_bytes(conn, head.to_bytes());
    }
    net.socket_write_bytes(conn, head.to_bytes() + r.body)
}

// M110: escribe una respuesta en streaming — cabecera con Transfer-Encoding: chunked y luego un
// chunk por cada trozo del canal, hasta que el productor lo cierre. En un HEAD se envían solo las
// cabeceras, pero el canal SE DRENA igual: si no, un productor sobre un canal acotado se quedaría
// bloqueado en `send` para siempre (fuga de fibra).
fn send_stream_response(conn: int, r: Response, omit_body: bool) -> Result<int, string> {
    let ch: Channel<bytes> = r.stream[0];
    var head: string = "HTTP/1.1 " + to_string(r.status) + " " + status_text(r.status) + "\r\n";
    head = head + "Transfer-Encoding: chunked\r\n";
    head = head + "Connection: close\r\n";
    head = head + "Date: " + time.to_rfc1123(time.now_utc()) + "\r\n";
    let ks: [string] = r.headers.keys();
    var i: int = 0;
    while (i < ks.len()) {
        match (get(r.headers, ks[i])) {
            Option.Some(v) => {
                head = head + ks[i] + ": " + v + "\r\n";
            },
            Option.None => { },
        }
        i = i + 1;
    }
    var c: int = 0;
    while (c < r.set_cookie.len()) {
        head = head + "Set-Cookie: " + r.set_cookie[c] + "\r\n";
        c = c + 1;
    }
    head = head + "\r\n";
    match (net.socket_write_bytes(conn, head.to_bytes())) {
        Result.Err(e) => {
            drain_stream(ch);
            return Result.Err(e);
        },
        Result.Ok(_) => { },
    }
    var err: string = "";
    var go: bool = true;
    while (go) {
        match (recv(ch)) {
            Option.None => {
                go = false;
            },
            Option.Some(piece) => {
                if (!omit_body && piece.len() > 0 && err == "") {
                    // Un chunk por trozo: "<tamaño-hex>\r\n" + datos + "\r\n". Si el cliente
                    // cortó, se sigue DRENANDO el canal (el productor no debe quedar colgado)
                    // pero ya no se escribe.
                    let frame: bytes = (to_hex(piece.len()) + "\r\n").to_bytes() + piece + b"\r\n";
                    match (net.socket_write_bytes(conn, frame)) {
                        Result.Err(e) => {
                            err = e;
                        },
                        Result.Ok(_) => { },
                    }
                }
            },
        }
    }
    if (err != "") {
        return Result.Err(err);
    }
    if (omit_body) {
        return Result.Ok(0);
    }
    net.socket_write_bytes(conn, b"0\r\n\r\n")
}

// Drena un canal de stream hasta su cierre (libera al productor si algo falló antes de leerlo).
fn drain_stream(ch: Channel<bytes>) {
    var go: bool = true;
    while (go) {
        match (recv(ch)) {
            Option.None => {
                go = false;
            },
            Option.Some(_) => { },
        }
    }
}

// --- SSE (server-sent events): HTTP que no cierra y va emitiendo eventos ---
// Abre un stream SSE: 200 + Content-Type: text/event-stream (mantiene la conexión viva).
/// Opens a server-sent events stream on `conn`: writes a 200 with `Content-Type: text/event-stream`
/// and keeps the connection alive. Follow with `sse_event` calls; Err on write failure.
pub fn sse_open(conn: int) -> Result<int, string> {
    var out: string = "HTTP/1.1 200 OK\r\n";
    out = out + "Content-Type: text/event-stream\r\n";
    out = out + "Cache-Control: no-cache\r\n";
    out = out + "Connection: keep-alive\r\n\r\n";
    net.socket_write(conn, out)
}

// Emite un evento SSE: "data: <texto>\n\n".
/// Emits one SSE event on an open stream: writes "data: <data>\n\n". Err on write failure (e.g. client disconnected).
pub fn sse_event(conn: int, data: string) -> Result<int, string> {
    net.socket_write(conn, "data: " + data + "\n\n")
}

// --- El bucle del servidor (concurrente: una fibra por conexión) ---
// Atiende UNA conexión: lee la petición y se la pasa al handler (que controla la conexión). Cierra al
// terminar. Lo usa serve_raw; cada conexión corre en su propia fibra. M56.1: una petición que no se
// pudo leer responde 400 antes de cerrar (best effort, sin filtrar el detalle interno al cliente).
// M56.5: el handler corre en su PROPIA tarea y su fallo se observa con try_join (sin re-lanzar) →
// un panic del handler ya no mata la fibra de la conexión: se loguea, se responde 500 best-effort
// y SIEMPRE se cierra la conexión (antes: fd fugado + token del semáforo fugado + cliente colgado).
fn handle(conn: int, handler: fn(Request, int), limits: Limits) {
    match (read_request_limits(conn, limits)) {
        Result.Ok(req) => {
            let t = spawn(fn() { handler(req, conn) });
            match (try_join(t)) {
                Result.Ok(_) => { },
                Result.Err(e) => {
                    eprint("handler: " + e);
                    // Si el handler ya había respondido, el peer ignora/rechaza este extra.
                    match (send_response(conn, text(500, "Internal Server Error"))) {
                        Result.Ok(_) => { },
                        Result.Err(_) => { },
                    }
                },
            }
        },
        Result.Err(e) => {
            // "connection closed" = el peer cerró sin pedir nada (o quedó ocioso): silencio.
            if (e != "connection closed") {
                eprint("request: " + e);
                match (send_response(conn, text(400, "Bad Request"))) {
                    Result.Ok(_) => { },
                    Result.Err(_) => { },
                }
            }
        },
    }
    close(conn);
}

// ¿La petición pide cerrar la conexión tras responder? Cerramos si no es HTTP/1.1 (el keep-alive
// de 1.0 es opt-in y declinarlo siempre es válido) o si trae `Connection: close`.
fn wants_close(req: Request) -> bool {
    if (req.version != "HTTP/1.1") {
        return true;
    }
    match (get(req.headers, "connection")) {
        Option.Some(v) => v.to_lower().contains("close"),
        Option.None => false,
    }
}

// M56.6: atiende una conexión del camino ergonómico (`serve`/`serve_tls`) con **keep-alive**: sirve
// peticiones en bucle sobre la MISMA conexión (HTTP/1.1) hasta que el cliente pida cerrar
// (`Connection: close`), cierre él mismo, quede ocioso (vence `read_timeout_millis`) o algo falle.
// Aquí sí podemos: la respuesta la escribe el servidor (el framing por Content-Length ya es
// correcto), así que el header `Connection` siempre dice la verdad. Cada petición corre su handler
// en su PROPIO `try_call` (M56.5, cambiado en M97.2 de `spawn`+`try_join` a recuperación en la misma
// fibra): un panic responde 500 y cierra, sin fugar nada y sin cruzar de hilo.
fn handle_http(conn: int, handler: fn(Request) -> Response, limits: Limits) {
    var follow: bool = true;
    while (follow) {
        match (read_request_limits(conn, limits)) {
            Result.Ok(req) => {
                let close: bool = wants_close(req);
                // M56.8: a un HEAD se le responden las cabeceras del GET equivalente SIN el cuerpo.
                let is_head: bool = req.method == "HEAD";
                // M97.2: `try_call` en vez de `spawn`+`try_join`. Misma garantía (un handler que
                // revienta responde 500 y cierra, sin tumbar el servidor) sin cambio de hilo: en el
                // binario nativo el `spawn` iba al pool de hilos del SO, así que CADA petición
                // cruzaba dos hilos —send al canal, despertar de semáforo, join— y con 100
                // conexiones el proceso levantaba 198 hilos sobre 11 cores. Ese handoff era el
                // mecanismo medido detrás de la cola profunda (p99.9 2.5× peor que Go con p50 y p99
                // MEJORES); ver docs/investigacion-p999-webserver-nativo.md.
                // Contrapartida aceptada: `try_call` no aísla el heap, así que un handler que
                // revienta a mitad puede dejar estado suyo a medio mutar. Da igual aquí: ese estado
                // es por-petición y la conexión se cierra a continuación (`follow = false`), que es
                // lo que este código ya hacía.
                match (try_call(fn() -> Response { handler(req) })) {
                    Result.Ok(resp) => {
                        match (send_response_keep(conn, resp, !close, is_head)) {
                            Result.Ok(_) => { },
                            Result.Err(e) => {
                                eprint("response: " + e);
                                follow = false;
                            },
                        }
                        // M110: un stream anuncia y hace Connection: close → no reusar.
                        if (resp.stream.len() > 0) {
                            follow = false;
                        }
                    },
                    Result.Err(e) => {
                        eprint("handler: " + e);
                        match (send_response(conn, text(500, "Internal Server Error"))) {
                            Result.Ok(_) => { },
                            Result.Err(_) => { },
                        }
                        follow = false;
                    },
                }
                if (close) {
                    follow = false;
                }
            },
            Result.Err(e) => {
                if (e != "connection closed") {
                    eprint("request: " + e);
                    match (send_response(conn, text(400, "Bad Request"))) {
                        Result.Ok(_) => { },
                        Result.Err(_) => { },
                    }
                }
                follow = false;
            },
        }
    }
    close(conn);
}

// Servidor de bajo nivel: el handler recibe la petición Y la conexión (para responder o hacer streaming
// SSE). Bucle infinito; cada conexión en su fibra. **Solo VM.**
/// Low-level concurrent server: listens on `host:port` and runs each connection in its own fiber.
/// The handler receives the parsed request AND the connection, so it can reply itself or stream (SSE);
/// the connection is closed after the handler returns. Uses `default_limits()`. VM only (needs fibers).
pub fn serve_raw(host: string, port: int, handler: fn(Request, int)) -> Result<int, string> {
    serve_raw_limits(host, port, default_limits(), handler)
}

// M56.1: la versión con límites. Dos defensas nuevas en el bucle de accept:
//   - **Tope de conexiones simultáneas** vía un canal acotado como SEMÁFORO (M12.2): `send` mete
//     un token antes de spawnear y CEDE la fibra si el canal está lleno → backpressure natural
//     (se deja de aceptar hasta que alguna conexión termine y saque su token con `recv`). Sin
//     estado mutable compartido: compone con los actores de heap aislado (M38).
//   - **Accept resiliente**: un error transitorio de accept (p. ej. sin descriptores) ya no tumba
//     el servidor; se loguea y se sigue. Solo errores PERSISTENTES (100 seguidos, sin ningún
//     accept exitoso entre medias) rinden el bucle.
/// Like `serve_raw`, with explicit safety limits (`Limits`): bounds header/body sizes per request
/// and caps simultaneous connections (accept pauses while at the cap; `max_conns <= 0` = unbounded).
/// Transient accept errors are logged and retried; only persistent failure stops the server.
pub fn serve_raw_limits(
    host: string,
    port: int,
    limits: Limits,
    handler: fn(Request, int)
) -> Result<int, string> {
    // TCP plano: la conexión aceptada se atiende tal cual (prepare = identidad).
    loop_iter_server(host, port, limits, fn(c: int) -> Result<int, string> { Result.Ok(c) }, fn(c: int) {
        handle(c, handler, limits);
    })
}

// El bucle de accept compartido por TCP plano y TLS (M56.3). `prepare` transforma la conexión
// recién aceptada antes de atenderla (identidad para HTTP; `net.tls_accept` para HTTPS) y corre
// DENTRO de la fibra de la conexión: un handshake TLS lento no frena el accept de las demás.
// M56.6: `atender_conn` es quien atiende la conexión preparada (una petición y cerrar —crudo— o
// el bucle keep-alive —ergonómico—); debe CERRAR la conexión al terminar.
fn loop_iter_server(
    host: string,
    port: int,
    limits: Limits,
    prepare: fn(int) -> Result<int, string>,
    handle_conn: fn(int)
) -> Result<int, string> {
    match (net.tcp_listen(
    host,
    port
)) {
        Result.Err(e) => Result.Err(e),
        Result.Ok(srv) => {
            print("listening on port " + to_string(net.local_port(srv)));
            dev_notify_ready();
            let bounded: bool = limits.max_conns > 0;
            let sem: Channel<int> = if (bounded) { Channel.bounded(limits.max_conns) } else { Channel.new() };
            var errors: int = 0;
            var follow: bool = true;
            while (follow) {
                match (net.tcp_accept(srv)) {
                    Result.Ok(conn) => {
                        errors = 0;
                        if (bounded) {
                            send(sem, 1);
                        }
                        spawn(fn() {
                            match (prepare(conn)) {
                                Result.Ok(c) => {
                                    handle_conn(c);
                                },
                                Result.Err(e) => {
                                    eprint("connection: " + e);
                                    close(conn);
                                },
                            }
                            if (bounded) {
                                recv(sem);
                            }
                        });
                    },
                    Result.Err(e) => {
                        eprint("accept: " + e);
                        // Fds agotados (EMFILE/ENFILE): TRANSITORIO — las conexiones en vuelo van
                        // cerrando y liberan descriptores. Pausar (cede la fibra: las conexiones
                        // avanzan y el bucle no hot-spinea) y NO contar para la rendición: antes un
                        // `wrk -c500` sumaba 100 errores consecutivos en ms y APAGABA el servidor.
                        if (e.contains("Too many open files")) {
                            time.sleep(20);
                        } else {
                            errors = errors + 1;
                            if (errors >= 100) {
                                follow = false;
                            }
                            time.sleep(10);
                        }
                    },
                }
            }
            close(srv);
            Result.Ok(0)
        },
    }
}

// --- M88.1b: apagado ordenado (graceful shutdown) ---
//
// Al llegar la orden de apagado (una señal del SO vía `signals()`, o un valor en cualquier canal
// `stop`), el servidor (1) DEJA DE ACEPTAR (cierra el listener: un cliente nuevo ve rechazo, no
// un socket colgado), (2) DRENA las conexiones en vuelo con un plazo (`drain_ms`) y (3) devuelve
// Ok(0) para que main haga su limpieza y salga. Cero peticiones perdidas en un deploy.
//
// Modelo de actores (M38): cero estado mutable compartido. El contador de conexiones activas
// vive en la fibra del servidor; cada fibra de conexión avisa su fin por el canal `done`; y el
// accept corre en una BOMBA (fibra propia) que entrega por el canal `conns` — así el bucle
// principal puede hacer `select` entre stop/conns/done, imposible sobre el accept bloqueante.
//
// Keep-alive: el drenaje espera a que las conexiones CIERREN; una ociosa muere por
// `read_timeout_millis`, así que un `drain_ms` menor puede vencer con ociosas vivas (se cierran
// al salir el proceso). Solo VM, como serve.
fn loop_iter_server_drainable(
    host: string,
    port: int,
    limits: Limits,
    stop: Channel<int>,
    drain_ms: int,
    prepare: fn(int) -> Result<int, string>,
    handle_conn: fn(int)
) -> Result<int, string> {
    match (net.tcp_listen(
    host,
    port
)) {
        Result.Err(e) => Result.Err(e),
        Result.Ok(srv) => {
            print("listening on port " + to_string(net.local_port(srv)));
            dev_notify_ready();
            let bounded: bool = limits.max_conns > 0;
            let sem: Channel<int> = if (bounded) { Channel.bounded(limits.max_conns) } else { Channel.new() };
            let conns: Channel<int> = Channel.new();
            let done: Channel<int> = Channel.new();
            // Se CIERRA al apagar: un canal cerrado queda "listo" para siempre (gotcha de M12.4,
            // aquí a favor) → despierta a la bomba sin estado compartido.
            let off: Channel<int> = Channel.new();
            // La bomba de accept. Tras un error (transitorio, o el del cierre del listener en el
            // apagado) espera 10 ms U observa `apagado`; cerrado gana el select → sale en
            // silencio en vez de spamear el log con los errores del listener ya cerrado.
            spawn(fn() {
                var errors = 0;
                var follow = true;
                while (follow) {
                    match (net.tcp_accept(srv)) {
                        Result.Ok(c) => {
                            errors = 0;
                            send(conns, c);
                        },
                        Result.Err(e) => {
                            // EMFILE/ENFILE no cuenta para la rendición (transitorio; ver el bucle
                            // no-drenable). La pausa de abajo ya cede la fibra en ambos casos.
                            if (!e.contains("Too many open files")) {
                                errors = errors + 1;
                            }
                            if (errors >= 100) {
                                // Error persistente: rendir el servidor (cerrar `conns` se lo
                                // comunica al bucle principal, que devuelve como bucle_servidor).
                                eprint("accept: " + e);
                                close(conns);
                                follow = false;
                            } else {
                                let pause: Channel<int> = Channel.new();
                                spawn(fn() {
                                    time.sleep(10);
                                    send(pause, 1);
                                });
                                if (select([off, pause]) == 0) {
                                    follow = false;
                                } else {
                                    let _ = recv(pause);
                                    eprint("accept: " + e);
                                }
                            }
                        },
                    }
                }
            });
            var active = 0;
            var conns_open = true;
            var serving = true;
            while (serving) {
                let which = select([stop, conns, done]);
                if (which == 0) {
                    let _ = recv(stop);
                    serving = false;
                } else if (which == 1) {
                    match (recv(conns)) {
                        Option.Some(conn) => {
                            if (bounded) {
                                send(sem, 1);
                            }
                            active = active + 1;
                            spawn(fn() {
                                match (prepare(conn)) {
                                    Result.Ok(c) => {
                                        handle_conn(c);
                                    },
                                    Result.Err(e) => {
                                        eprint("connection: " + e);
                                        close(conn);
                                    },
                                }
                                if (bounded) {
                                    recv(sem);
                                }
                                send(done, 1);
                            });
                        },
                        Option.None => {
                            // La bomba murió por error persistente: rendirse (como bucle_servidor).
                            conns_open = false;
                            serving = false;
                        },
                    }
                } else {
                    let _ = recv(done);
                    active = active - 1;
                }
            }
            // Apagado: avisar a la bomba y dejar de aceptar (los clientes nuevos ven rechazo).
            close(off);
            close(srv);
            print("shutting down: " + to_string(active) + " connection(s) in flight");
            // Drenar con plazo. Una conexión aceptada y aún no atendida (ventana mínima entre el
            // accept de la bomba y este select) se cierra sin respuesta según asoma por `conns`.
            if (active > 0 && drain_ms > 0) {
                let deadline_ch: Channel<int> = Channel.new();
                spawn(fn() {
                    time.sleep(drain_ms);
                    send(deadline_ch, 1);
                });
                var waiting = true;
                while (waiting && active > 0) {
                    // Un canal CERRADO siempre está "listo" → si la bomba cerró `conns`, sacarlo
                    // de la lista del select (el gotcha de M12.4).
                    let which = if (conns_open) { select([deadline_ch, done, conns]) } else { select([deadline_ch, done]) };
                    if (which == 0) {
                        waiting = false;
                    } else if (which == 1) {
                        let _ = recv(done);
                        active = active - 1;
                    } else {
                        match (recv(conns)) {
                            Option.Some(c) => {
                                close(c);
                            },
                            Option.None => {
                                conns_open = false;
                            },
                        }
                    }
                }
                if (active > 0) {
                    eprint(
                        "off: " + to_string(active) + " connection(s) in flight when the deadline expired"
                    );
                }
            }
            Result.Ok(0)
        },
    }
}

/// Like `serve`, but with graceful shutdown on a channel: when a value arrives on `stop` (or it
/// is closed), the server stops accepting (new clients are refused), drains in-flight
/// connections for up to `drain_ms` ms, and returns Ok(0). Wire `stop` to `signals()` — or use
/// `serve_graceful`, which does exactly that. VM only.
pub fn serve_shutdown(
    host: string,
    port: int,
    stop: Channel<int>,
    drain_ms: int,
    handler: fn(Request) -> Response
) -> Result<int, string> {
    serve_shutdown_limits(host, port, default_limits(), stop, drain_ms, handler)
}

/// Like `serve_shutdown`, with explicit safety limits (see `Limits`).
pub fn serve_shutdown_limits(
    host: string,
    port: int,
    limits: Limits,
    stop: Channel<int>,
    drain_ms: int,
    handler: fn(Request) -> Response
) -> Result<int, string> {
    loop_iter_server_drainable(host, port, limits, stop, drain_ms, fn(c: int) -> Result<int, string> { Result.Ok(c) }, fn(c: int) {
        handle_http(c, handler, limits);
    })
}

// El patrón producción en una línea: serve + señales del SO (M88.1). Con SIGTERM (deploy,
// `kill`) o SIGINT (Ctrl-C) deja de aceptar, drena en vuelo con plazo y devuelve 0 → cero
// peticiones perdidas al desplegar.
/// The production pattern: `serve` wired to OS signals (`signals()`, M88.1). On SIGTERM/SIGINT
/// it stops accepting, drains in-flight connections for up to `drain_ms` ms, and returns Ok(0)
/// so `main` can clean up and exit — zero dropped requests on deploys. Unix + VM only.
pub fn serve_graceful(
    host: string,
    port: int,
    drain_ms: int,
    handler: fn(Request) -> Response
) -> Result<int, string> {
    serve_shutdown(host, port, signals(), drain_ms, handler)
}

// Servidor ergonómico: el handler es petición → respuesta; serve escribe la respuesta y —desde
// M56.6— mantiene la conexión viva entre peticiones (keep-alive HTTP/1.1; honra `Connection:
// close` y el ocio lo corta `read_timeout_millis`). **Solo VM.**
/// Ergonomic concurrent server: the handler maps a Request to a Response, which is sent
/// automatically. Connections are kept alive between requests (HTTP/1.1 keep-alive; honors
/// `Connection: close`; idle connections are closed by the read timeout). One fiber per
/// connection; `default_limits()`. Blocks forever; VM only.
pub fn serve(host: string, port: int, handler: fn(Request) -> Response) -> Result<int, string> {
    serve_limits(host, port, default_limits(), handler)
}

/// Like `serve`, with explicit safety limits (see `Limits`/`serve_raw_limits`).
pub fn serve_limits(
    host: string,
    port: int,
    limits: Limits,
    handler: fn(Request) -> Response
) -> Result<int, string> {
    loop_iter_server(host, port, limits, fn(c: int) -> Result<int, string> { Result.Ok(c) }, fn(c: int) {
        handle_http(c, handler, limits);
    })
}

// --- serve_with (M93.3): el handler viene de una FACTORÍA ---
// La factoría cruza los hilos como función plana (Send) y el handler (con sus closures/estado)
// nace DENTRO de la tarea de cada petición — compatible con el backend nativo (actores de heap
// aislado): el framework web arranca por aquí. Se construye POR PETICIÓN, no por conexión: el
// aislamiento panic→500 (M56.5) corre cada petición en su propia tarea, así que el handler
// cruzaría OTRO hilo igualmente. Handler por conexión (construir una vez y reusar en el
// keep-alive) queda diferido: exigiría catch_unwind en el nativo o defuncionalización.
/// Like `serve`, but takes a handler FACTORY: each request builds its handler via
/// `make_handler()` inside its own task. The factory crosses threads as a plain function while
/// the handler (closures, state) never does — the form that also compiles with
/// `ray build --native` (M93.3). Blocks forever.
pub fn serve_with(
    host: string,
    port: int,
    make_handler: fn() -> fn(Request) -> Response
) -> Result<int, string> {
    serve_with_limits(host, port, default_limits(), make_handler)
}

/// Like `serve_with`, with explicit safety limits (see `Limits`).
pub fn serve_with_limits(
    host: string,
    port: int,
    limits: Limits,
    make_handler: fn() -> fn(Request) -> Response
) -> Result<int, string> {
    serve_limits(host, port, limits, fn(req: Request) -> Response {
        let h: fn(Request) -> Response = make_handler();
        h(req)
    })
}

/// Like `serve_tls`, from a handler factory (see `serve_with`). Uses `default_limits()`.
pub fn serve_with_tls(
    host: string,
    port: int,
    cert: string,
    key: string,
    make_handler: fn() -> fn(Request) -> Response
) -> Result<int, string> {
    serve_tls_limits(host, port, cert, key, default_limits(), fn(req: Request) -> Response {
        let h: fn(Request) -> Response = make_handler();
        h(req)
    })
}

/// Like `serve_graceful`, from a handler factory (see `serve_with`). Uses `default_limits()`.
pub fn serve_with_graceful(
    host: string,
    port: int,
    drain_ms: int,
    make_handler: fn() -> fn(Request) -> Response
) -> Result<int, string> {
    serve_graceful(host, port, drain_ms, fn(req: Request) -> Response {
        let h: fn(Request) -> Response = make_handler();
        h(req)
    })
}

// --- HTTPS (M56.3): el mismo servidor sobre TLS ---
// Cierra el hueco "tls_accept existe pero serve_raw no deja insertarlo": el upgrade TLS es el
// paso `prepare` del bucle compartido, dentro de la fibra de cada conexión. `cert`/`key` son los
// PEM (contenido, no ruta), como `net.tls_accept`. El handshake real ocurre en la primera I/O
// (cede al scheduler, M19.4b); un cliente que habla HTTP plano contra el puerto TLS falla su
// conexión con error logueado, sin tocar a las demás.
/// HTTPS server: like `serve`, but each accepted connection is upgraded to server-side TLS with
/// the given PEM certificate chain and private key (contents, not paths) before reading the
/// request. Keep-alive like `serve`. Uses `default_limits()`. Blocks forever; VM only.
pub fn serve_tls(
    host: string,
    port: int,
    cert: string,
    key: string,
    handler: fn(Request) -> Response
) -> Result<int, string> {
    serve_tls_limits(host, port, cert, key, default_limits(), handler)
}

/// Like `serve_tls`, with explicit safety limits (see `Limits`).
pub fn serve_tls_limits(
    host: string,
    port: int,
    cert: string,
    key: string,
    limits: Limits,
    handler: fn(Request) -> Response
) -> Result<int, string> {
    loop_iter_server(host, port, limits, fn(c: int) -> Result<int, string> {
        net.tls_accept(c, cert, key)
    }, fn(c: int) {
        handle_http(c, handler, limits);
    })
}

/// Low-level HTTPS server: like `serve_raw` over TLS — the handler receives the request AND the
/// (TLS) connection, so it can stream (SSE over HTTPS). Uses `default_limits()`. VM only.
pub fn serve_raw_tls(
    host: string,
    port: int,
    cert: string,
    key: string,
    handler: fn(Request, int)
) -> Result<int, string> {
    serve_raw_tls_limits(host, port, cert, key, default_limits(), handler)
}

/// Like `serve_raw_tls`, with explicit safety limits (see `Limits`).
pub fn serve_raw_tls_limits(
    host: string,
    port: int,
    cert: string,
    key: string,
    limits: Limits,
    handler: fn(Request, int)
) -> Result<int, string> {
    loop_iter_server(host, port, limits, fn(c: int) -> Result<int, string> {
        net.tls_accept(c, cert, key)
    }, fn(c: int) {
        handle(c, handler, limits);
    })
}
