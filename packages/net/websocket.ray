// WebSocket (RFC 6455) sobre `ws://`, escrito EN raylang. Handshake + framing, **cero deps**: usa la
// criptografía de M19.3b (`sha1`/`base64`) y los operadores bit a bit de M19.3a. Importable.
//
// M58.1: el framing dejó de asumir "una trama = una lectura" (TCP no lo garantiza: una trama
// puede llegar PARTIDA o venir PEGADA a otra). El camino robusto es `WsConn` (conexión + buffer
// de sobrantes) + `read_frame` (acumula hasta tener la trama exacta) + `read_message` (además
// contesta ping→pong, hace el close-handshake de cortesía y reensambla mensajes FRAGMENTADOS),
// con límite de payload validado ANTES de leer. `decode_frame` (una trama ya completa) se
// conserva para quien ya tiene los octetos exactos. Sin extensiones (permessage-deflate).
from std/base64 import base64;
import std/crypto;
import std/net;
import std/random;

// --- Handshake ---
// El GUID mágico del protocolo (RFC 6455 §1.3): se concatena a la clave del cliente antes del SHA-1.
fn guid() -> string { "258EAFA5-E914-47DA-95CA-C5AB0DC85B11" }

// El valor `Sec-WebSocket-Accept` para la clave del cliente: base64(SHA-1(key + GUID)).
/// Computes the `Sec-WebSocket-Accept` value for a client's `Sec-WebSocket-Key` (RFC 6455 §4.2.2).
/// Returns base64(SHA-1(key + protocol GUID)).
pub fn accept_key(key: string) -> string {
    base64(crypto.sha1((key + guid()).to_bytes()))
}

// Extrae el valor de la cabecera `Sec-WebSocket-Key` de la petición de upgrade (o "" si no aparece).
// M58.1: el nombre casa case-insensitive (las cabeceras HTTP lo son; antes solo la grafía exacta).
/// Extracts the `Sec-WebSocket-Key` header value from an HTTP upgrade request
/// (header name matched case-insensitively). Returns the trimmed key, or "" if missing.
pub fn extract_key(request: string) -> string {
    let lineas = request.split("\r\n");
    var clave = "";
    var i = 0;
    while (i < lineas.len()) {
        let linea = lineas[i];
        if (linea.to_lower().starts_with("sec-websocket-key:")) {
            match (index_of(linea, ":")) {
                Option.Some(idx) => {
                    clave = linea.substring(idx + 1, linea.len()).trim();
                },
                Option.None => { },
            }
        }
        i = i + 1;
    }
    clave
}

// La respuesta HTTP 101 que completa el handshake para la clave dada.
/// Builds the complete HTTP `101 Switching Protocols` response that finishes the
/// server-side WebSocket handshake for the given client key (RFC 6455 §4.2.2).
pub fn handshake_response(key: string) -> string {
    "HTTP/1.1 101 Switching Protocols\r\n" + "Upgrade: websocket\r\n" + "Connection: Upgrade\r\n" + "Sec-WebSocket-Accept: " + accept_key(key) + "\r\n\r\n"
}

// --- Framing ---
// Opcodes de trama (RFC 6455 §5.2).
/// Frame opcode for a text message (RFC 6455 §5.2): 1.
pub fn op_text() -> int { 1 }

/// Frame opcode for a binary message (RFC 6455 §5.2): 2.
pub fn op_binary() -> int { 2 }

/// Frame opcode for a connection close control frame (RFC 6455 §5.2): 8.
pub fn op_close() -> int { 8 }

/// Frame opcode for a ping control frame (RFC 6455 §5.2): 9.
pub fn op_ping() -> int { 9 }

/// Frame opcode for a pong control frame (RFC 6455 §5.2): 10.
pub fn op_pong() -> int { 10 }

// Una trama decodificada: su opcode, su carga útil (ya des-enmascarada) y el bit FIN.
/// A decoded WebSocket frame: its opcode, the (already unmasked) payload, and the FIN bit.
pub struct Frame {
    opcode: int,
    payload: bytes,
    fin: bool,
}

// Decodifica una trama del **cliente** (siempre enmascarada, RFC 6455 §5.3) contenida en `data`.
// Devuelve la trama; sobre datos incompletos el comportamiento es indefinido (camino feliz).
/// Decodes a single WebSocket frame from `data`, unmasking the payload when the MASK
/// bit is set (client-to-server frames are always masked, RFC 6455 §5.3).
/// Happy path only: behavior on truncated/incomplete input is undefined.
pub fn decode_frame(data: bytes) -> Frame {
    let b0 = data[0];
    let b1 = data[1];
    let fin = (b0 >> 7 & 1) == 1;
    let opcode = b0 & 15;
    let masked = (b1 >> 7 & 1) == 1;
    let len7 = b1 & 127;
    // Longitud de la carga + desplazamiento al inicio de la clave de máscara.
    var plen = len7;
    var off = 2;
    if (len7 == 126) {
        plen = data[2] << 8 | data[3];
        off = 4;
    } else {
        if (len7 == 127) {
            // 8 octetos big-endian (en la práctica caben en el int de 64 bits).
            plen = 0;
            var k = 0;
            while (k < 8) {
                plen = plen << 8 | data[2 + k];
                k = k + 1;
            }
            off = 10;
        }
    }
    // Clave de máscara de 4 octetos (si la trama viene enmascarada, como manda el cliente).
    var mask: [int] = [0, 0, 0, 0];
    if (masked) {
        mask[0] = data[off];
        mask[1] = data[off + 1];
        mask[2] = data[off + 2];
        mask[3] = data[off + 3];
        off = off + 4;
    }
    // Des-enmascara la carga: payload[i] = data[off+i] XOR mask[i % 4].
    var octetos: [int] = [];
    var i = 0;
    while (i < plen) {
        if (masked) {
            octetos.push(data[off + i] ^ mask[i % 4]);
        } else {
            octetos.push(data[off + i]);
        }
        i = i + 1;
    }
    Frame { opcode: opcode, payload: bytes_of(octetos), fin: fin }
}

// Codifica una trama del **servidor** (sin máscara, FIN activo) con el opcode y la carga dados.
/// Encodes a server-to-client frame (unmasked, FIN=1) with the given opcode and payload,
/// choosing the 7-bit, 16-bit or 64-bit length encoding as needed (RFC 6455 §5.2).
pub fn encode_frame(opcode: int, payload: bytes) -> bytes {
    encode_frame_fin(opcode, payload, true)
}

// M91.4: como `encode_frame` pero con el bit FIN parametrizado (para fragmentar al enviar).
fn encode_frame_fin(opcode: int, payload: bytes, fin: bool) -> bytes {
    let plen = payload.len();
    var cabecera: [int] = [];
    var b0 = opcode;
    if (fin) {
        b0 = b0 | 128;
    }
    cabecera.push(b0);  // FIN + opcode
    if (plen < 126) {
        cabecera.push(plen);
    } else {
        if (plen < 65536) {
            cabecera.push(126);
            cabecera.push(plen >> 8 & 255);
            cabecera.push(plen & 255);
        } else {
            cabecera.push(127);
            var k = 7;
            while (k >= 0) {
                cabecera.push(plen >> k * 8 & 255);
                k = k - 1;
            }
        }
    }
    bytes_of(cabecera) + payload
}

// Atajo: una trama de texto del servidor.
/// Shortcut: encodes `texto` as an unmasked server text frame (opcode 1, FIN=1).
pub fn encode_text(texto: string) -> bytes {
    encode_frame(op_text(), texto.to_bytes())
}

// Codifica una trama del **cliente** (M58.1, movida desde websocket_client): bit MASK activo,
// clave de 4 octetos aleatorios y carga enmascarada (payload[i] XOR mask[i % 4], RFC 6455 §5.3).
/// Encodes a client-to-server frame (FIN=1, MASK bit set, random 4-byte masking key,
/// masked payload — clients MUST mask, RFC 6455 §5.3).
pub fn encode_frame_masked(opcode: int, payload: bytes) -> bytes {
    encode_frame_masked_fin(opcode, payload, true)
}

// M91.4: como `encode_frame_masked` pero con el bit FIN parametrizado.
fn encode_frame_masked_fin(opcode: int, payload: bytes, fin: bool) -> bytes {
    let plen = payload.len();
    var out: [int] = [];
    var b0 = opcode;
    if (fin) {
        b0 = b0 | 128;
    }
    out.push(b0);  // FIN + opcode
    if (plen < 126) {
        out.push(128 | plen);  // bit MASK + longitud
    } else {
        if (plen < 65536) {
            out.push(128 | 126);
            out.push(plen >> 8 & 255);
            out.push(plen & 255);
        } else {
            out.push(128 | 127);
            var k = 7;
            while (k >= 0) {
                out.push(plen >> k * 8 & 255);
                k = k - 1;
            }
        }
    }
    var mask: [int] = [];
    var i = 0;
    while (i < 4) {
        mask.push(random.below(256));
        i = i + 1;
    }
    var m = 0;
    while (m < 4) {
        out.push(mask[m]);
        m = m + 1;
    }
    i = 0;
    while (i < plen) {
        out.push(payload[i] ^ mask[i % 4]);
        i = i + 1;
    }
    bytes_of(out)
}

// --- Lectura robusta (M58.1): buffer entre lecturas + control + fragmentación ---

// El estado de una conexión WebSocket: el socket, el buffer de octetos sobrantes (una lectura
// puede traer media trama o trama y media) y el lado (los frames de control que emitimos —pong,
// close de cortesía— van enmascarados si somos el cliente).
/// A WebSocket connection: the socket handle, the buffer of leftover bytes between reads
/// (a read may deliver half a frame, or one and a half), and which side we are (`mask` = true
/// for a client: control frames we emit are masked). Create with `server_conn`/`client_conn`.
pub struct WsConn {
    conn: int,
    buf: bytes,
    mask: bool,
}

/// Wraps an accepted server-side connection (frames we send are unmasked).
pub fn server_conn(conn: int) -> WsConn {
    WsConn { conn: conn, buf: b"", mask: false }
}

/// Wraps a client-side connection (frames we send are masked). `websocket_client.connect`
/// returns one of these with the handshake already done.
pub fn client_conn(conn: int) -> WsConn {
    WsConn { conn: conn, buf: b"", mask: true }
}

// El tamaño TOTAL (cabecera + máscara + carga) de la trama al frente de `b`: Ok(total) si la
// cabecera ya está completa, Ok(-1) si aún faltan octetos de cabecera, Err si la carga declarada
// excede `max_payload` (se rechaza ANTES de leerla: una longitud hostil de 2^60 no asigna nada).
fn frame_total(b: bytes, max_payload: int) -> Result<int, string> {
    if (b.len() < 2) {
        return Result.Ok(0 - 1);
    }
    let masked = (b[1] >> 7 & 1) == 1;
    let len7 = b[1] & 127;
    var plen = len7;
    var off = 2;
    if (len7 == 126) {
        if (b.len() < 4) {
            return Result.Ok(0 - 1);
        }
        plen = b[2] << 8 | b[3];
        off = 4;
    } else {
        if (len7 == 127) {
            if (b.len() < 10) {
                return Result.Ok(0 - 1);
            }
            plen = 0;
            var k = 0;
            while (k < 8) {
                plen = plen << 8 | b[2 + k];
                k = k + 1;
            }
            off = 10;
        }
    }
    if (plen > max_payload || plen < 0) {
        return Result.Err("trama demasiado grande (" + to_string(plen) + " > " + to_string(max_payload) + " octetos)");
    }
    if (masked) {
        off = off + 4;
    }
    Result.Ok(off + plen)
}

/// Reads exactly ONE frame from the connection, buffering across socket reads (split frames are
/// accumulated; coalesced frames are kept for the next call). Default 16 MiB payload limit.
/// Err on read failure, a peer that closes mid-frame, or an oversized declared length.
pub fn read_frame(ws: WsConn) -> Result<Frame, string> {
    read_frame_limit(ws, 16777216)
}

/// Like `read_frame` with an explicit payload limit in bytes (checked against the DECLARED
/// length before reading the payload).
pub fn read_frame_limit(ws: WsConn, max_payload: int) -> Result<Frame, string> {
    while (true) {
        let total = frame_total(ws.buf, max_payload)?;
        if (total >= 0 && ws.buf.len() >= total) {
            let f = decode_frame(ws.buf.sub_bytes(0, total));
            ws.buf = ws.buf.sub_bytes(total, ws.buf.len());
            return Result.Ok(f);
        }
        match (net.socket_read_bytes(ws.conn)) {
            Result.Ok(trozo) => {
                if (trozo.len() == 0) {
                    if (ws.buf.len() == 0) {
                        return Result.Err("conexión cerrada");
                    }
                    return Result.Err("conexión cerrada a mitad de una trama");
                }
                ws.buf = ws.buf + trozo;
            },
            Result.Err(e) => {
                return Result.Err("error al leer la trama: " + e);
            },
        }
    }
    Result.Err("inalcanzable")
}

// Emite una trama de control con el enmascarado del lado que somos (best effort).
fn send_control(ws: WsConn, opcode: int, payload: bytes) {
    let trama = if (ws.mask) { encode_frame_masked(opcode, payload) } else { encode_frame(opcode, payload) };
    match (net.socket_write_bytes(ws.conn, trama)) {
        Result.Ok(_) => { },
        Result.Err(_) => { },
    }
}

// M91.4: envío FRAGMENTADO — el simétrico de `read_message`. Trocea `payload` en tramas de a
// lo sumo `max_frame` octetos: la primera lleva el opcode con FIN=0, las intermedias son
// continuaciones (opcode 0, FIN=0) y la última cierra con FIN=1. Con carga <= `max_frame` (o
// una trama de CONTROL, que la RFC prohíbe fragmentar y acota a 125 octetos) emite UNA trama.
// Enmascara según el lado (`ws.mask`, como todo envío).
/// Sends one message over the connection, fragmenting it into frames of at most `max_frame`
/// payload octets (first frame carries the opcode with FIN=0, continuations follow, the last
/// sets FIN=1). Control frames are never fragmented (RFC 6455). Ok = total octets written.
pub fn send_message(ws: WsConn, opcode: int, payload: bytes, max_frame: int) -> Result<int, string> {
    if (max_frame <= 0) {
        return Result.Err("max_frame debe ser positivo");
    }
    let n = payload.len();
    if (n <= max_frame || opcode >= 8) {
        return net.socket_write_bytes(ws.conn, encodear(ws, opcode, payload, true));
    }
    var enviados = 0;
    var pos = 0;
    var primero = true;
    while (pos < n) {
        var hasta = pos + max_frame;
        if (hasta > n) {
            hasta = n;
        }
        let op = if (primero) { opcode } else { 0 };  // 0 = continuación
        let k = net.socket_write_bytes(ws.conn, encodear(ws, op, payload.sub_bytes(pos, hasta), hasta == n))?;
        enviados = enviados + k;
        primero = false;
        pos = hasta;
    }
    Result.Ok(enviados)
}

// Codifica una trama con el enmascarado del lado que somos y el FIN dado.
fn encodear(ws: WsConn, opcode: int, payload: bytes, fin: bool) -> bytes {
    if (ws.mask) {
        encode_frame_masked_fin(opcode, payload, fin)
    } else {
        encode_frame_fin(opcode, payload, fin)
    }
}

/// Reads the next MESSAGE from the connection, handling the protocol chores (RFC 6455):
/// answers ping with pong (masked on the client side), skips pongs, echoes a close frame
/// (courtesy close-handshake) and returns it — check `opcode == op_close()` to stop —, and
/// reassembles FRAGMENTED messages (continuation frames until FIN; control frames may
/// interleave). The total reassembled payload also respects the 16 MiB limit.
pub fn read_message(ws: WsConn) -> Result<Frame, string> {
    read_message_limit(ws, 16777216)
}

/// Like `read_message` with an explicit payload limit (per frame AND for the reassembled total).
pub fn read_message_limit(ws: WsConn, max_payload: int) -> Result<Frame, string> {
    // Mensaje en curso (si el primero llegó con FIN=0): opcode del primero + carga acumulada.
    var fragmentado = false;
    var op_msg = 0;
    var acc: bytes = b"";
    while (true) {
        let f = read_frame_limit(ws, max_payload)?;
        if (f.opcode == op_ping()) {
            send_control(ws, op_pong(), f.payload);
        } else if (f.opcode == op_pong()) {
            // Respuesta a un ping nuestro (o unsolicited): se ignora.
        } else if (f.opcode == op_close()) {
            // Close-handshake de cortesía; el llamador decide cerrar el socket.
            send_control(ws, op_close(), b"");
            return Result.Ok(f);
        } else if (f.opcode == 0) {
            // Continuación de un mensaje fragmentado.
            if (!fragmentado) {
                return Result.Err("trama de continuación sin mensaje fragmentado en curso");
            }
            if (acc.len() + f.payload.len() > max_payload) {
                return Result.Err("mensaje fragmentado demasiado grande (> " + to_string(max_payload) + " octetos)");
            }
            acc = acc + f.payload;
            if (f.fin) {
                return Result.Ok(Frame { opcode: op_msg, payload: acc, fin: true });
            }
        } else {
            // Trama de datos (texto/binario).
            if (fragmentado) {
                return Result.Err("trama de datos en medio de un mensaje fragmentado");
            }
            if (f.fin) {
                return Result.Ok(f);
            }
            fragmentado = true;
            op_msg = f.opcode;
            acc = f.payload;
        }
    }
    Result.Err("inalcanzable")
}
