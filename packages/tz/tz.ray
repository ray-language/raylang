// packages/tz — hora local IANA (M85): zonas horarias leyendo los TZif del sistema.
//
// Parser de **TZif v2/v3** (RFC 8536) en raylang puro sobre `std/fs` (cero deps): lee
// `/usr/share/zoneinfo/<zona>` (o un archivo arbitrario — fixtures de test), extrae las
// TRANSICIONES (instantes en que cambia el offset: DST, reformas) y los TIPOS (offset,
// es-DST, abreviatura), y resuelve por búsqueda binaria.
//
// Decisiones (IDEAS §42):
// - **La ambigüedad del DST es API**: `to_utc(zona, civil)` devuelve `LocalResult` —
//   `Single(ms)` (lo normal), `Ambiguous(antes, despues)` (el solape de otoño: la hora
//   civil ocurre DOS veces) o `Gap` (el hueco de primavera: no ocurre nunca).
// - **Zona del sistema sin primitivo nuevo**: `system()` prueba `env("TZ")` como nombre
//   y cae a leer `/etc/localtime` POR CONTENIDO (es un TZif válido, aunque sin nombre).
// - **Windows honesto**: sin zoneinfo, `load` devuelve Err claro; UTC (std/time) sigue.
// - Alcance v1: transiciones EXPLÍCITAS del archivo (tzdata estándar las trae hasta
//   ~2037); más allá se extrapola el último tipo. El footer TZ-string (reglas POSIX
//   perpetuas) queda diferido (M85b). Pre-1970 hereda el límite de std/time.
//
// Moneda: instantes en **epoch-ms UTC** (como std/time); offsets en **ms**.
import std/fs;
import std/time;

// M85b: el FOOTER TZ-string del TZif (RFC 8536 §3.3) — las reglas PERPETUAS que rigen
// después de la última transición explícita (p. ej. `CET-1CEST,M3.5.0,M10.5.0/3`).
// Solo la forma `Mm.w.d[/hora]` (la que emite zic); un footer que no se entienda deja
// `valid = false` y la zona degrada al comportamiento v1 (extrapolar el último tipo).
struct Foot {
    valid: bool,
    std_off: int,
    std_abbr: string,
    has_dst: bool,
    dst_off: int,
    dst_abbr: string,
    sm: int,
    sw: int,
    sd: int,
    ssecs: int,
    em: int,
    ew: int,
    ed: int,
    esecs: int,
}

// offset UTC en segundos (ya con el signo IANA, no el POSIX)
// Regla de inicio/fin del DST: mes, semana (1-5; 5 = la última), día (0 = domingo)
// y el segundo del día LOCAL en que cambia (default 02:00:00).
// Una zona horaria cargada: transiciones (epoch-SEGUNDOS, ascendentes), el índice de tipo
// de cada transición, y por tipo su offset (segundos), si es DST y su abreviatura.
/// A loaded IANA time zone: transition table + offset types (binary search), plus the
/// TZif footer rules (M85b) that govern instants past the last explicit transition.
pub struct Zone {
    name: string,
    trans: [int],
    trans_type: [int],
    utoffs: [int],
    isdsts: [bool],
    abbrevs: [string],
    first_type: int,
    foot: Foot,
}

// El tipo vigente ANTES de la primera transición (RFC 8536: el primer tipo no-DST,
// o el tipo 0). También el usado si no hay transiciones (zonas fijas, p. ej. UTC).
// El resultado de convertir una hora CIVIL local a un instante UTC (la inversa no es
// total por el DST).
/// Result of resolving a civil local time to a UTC instant. Spring-forward gaps and
/// fall-back overlaps make the mapping non-total: `Ambiguous` carries both instants
/// (earlier first), `Gap` means the civil time never happens in that zone.
pub enum LocalResult {
    Single(int),
    Ambiguous(int, int),
    Gap,
}

// ---------------------------------------------------------------------------
// Carga
// ---------------------------------------------------------------------------
// ¿Nombre de zona válido? (`Europe/Madrid`, `America/Argentina/Ushuaia`, `UTC`…)
// Rechaza rutas absolutas y `..` (el nombre indexa dentro de zoneinfo).
fn valid_name(name: string) -> bool {
    if (name.len() == 0 || name.starts_with("/") || name.contains("..")) {
        return false;
    }
    var i = 0;
    let cs = name.chars();
    while (i < cs.len()) {
        let c = cs[i];
        let ok = 'a' <= c && c <= 'z' || 'A' <= c && c <= 'Z' || '0' <= c && c <= '9' || c == '/' || c == '_' || c == '-' || c == '+';
        if (!ok) {
            return false;
        }
        i = i + 1;
    }
    true
}

// Carga una zona por su nombre IANA desde el zoneinfo del sistema.
/// Loads a zone by IANA name (e.g. "Europe/Madrid") from the system zoneinfo database
/// (`/usr/share/zoneinfo`). Err with a clear message if the database or the zone is
/// missing (e.g. on Windows) or the file is not a valid TZif.
pub fn load(name: string) -> Result<Zone, string> {
    if (!valid_name(name)) {
        return Result.Err("tz: invalid zone name '" + name + "'");
    }
    load_named("/usr/share/zoneinfo/" + name, name)
}

// Carga una zona desde un archivo TZif arbitrario (fixtures de test, /etc/localtime).
/// Loads a zone from an arbitrary TZif file path (test fixtures, `/etc/localtime`).
pub fn load_file(path: string) -> Result<Zone, string> {
    load_named(path, path)
}

fn load_named(path: string, name: string) -> Result<Zone, string> {
    match (fs.read_file_bytes(path)) {
        Result.Ok(data) => parse_tzif(data, name),
        Result.Err(e) => Result.Err("tz: could not read '" + path + "': " + e),
    }
}

// La zona del sistema: `TZ` del entorno (como nombre IANA) o `/etc/localtime` (por
// contenido — es un TZif válido aunque no conozcamos su nombre).
/// The system's local zone: tries the `TZ` environment variable as an IANA name, then
/// falls back to reading `/etc/localtime` by content.
pub fn system() -> Result<Zone, string> {
    match (env("TZ")) {
        Option.Some(tz) => {
            if (tz.len() > 0 && valid_name(tz)) {
                return load(tz);
            }
        },
        Option.None => { },
    }
    load_named("/etc/localtime", "local")
}

// ---------------------------------------------------------------------------
// Parser TZif (RFC 8536)
// ---------------------------------------------------------------------------
// Entero SIN signo de `n` octetos big-endian en `b[at..]`.
fn be_uint(b: bytes, at: int, n: int) -> int {
    var v = 0;
    var i = 0;
    while (i < n) {
        v = v * 256 + b[at + i];
        i = i + 1;
    }
    v
}

// Entero CON signo (complemento a dos) de `n` octetos big-endian: el primer octeto
// aporta el signo (v arranca negativo) y el resto se acumula — sin desbordar el i64.
fn be_int(b: bytes, at: int, n: int) -> int {
    var v = b[at];
    if (v >= 128) {
        v = v - 256;
    }
    var i = 1;
    while (i < n) {
        v = v * 256 + b[at + i];
        i = i + 1;
    }
    v
}

// La cabecera TZif: los 6 contadores tras el magic. `at` apunta al inicio de la cabecera.
struct Header {
    isutcnt: int,
    isstdcnt: int,
    leapcnt: int,
    timecnt: int,
    typecnt: int,
    charcnt: int,
}

fn read_header(b: bytes, at: int) -> Result<Header, string> {
    if (at + 44 > b.len()) {
        return Result.Err("tz: truncated TZif (header)");
    }
    if (b[at] != 84 || b[at + 1] != 90 || b[at + 2] != 105 || b[at + 3] != 102) {
        return Result.Err("tz: not a TZif file (magic)");
    }
    Result.Ok(
        Header {
            isutcnt: be_uint(b, at + 20, 4),
            isstdcnt: be_uint(b, at + 24, 4),
            leapcnt: be_uint(b, at + 28, 4),
            timecnt: be_uint(b, at + 32, 4),
            typecnt: be_uint(b, at + 36, 4),
            charcnt: be_uint(b, at + 40, 4)
        }
    )
}

// El tamaño del bloque de datos de una cabecera, con tiempos de `tsize` octetos.
fn block_size(h: Header, tsize: int) -> int {
    h.timecnt * tsize + h.timecnt + h.typecnt * 6 + h.charcnt + h.leapcnt * (tsize + 4) + h.isstdcnt + h.isutcnt
}

fn parse_tzif(b: bytes, name: string) -> Result<Zone, string> {
    let h1 = read_header(b, 0)?;
    let version = b[4];  // 0 (v1), 50 ('2'), 51 ('3'), 52 ('4')
    var h = h1;
    var at = 44;
    var tsize = 4;
    if (version >= 50) {
        // v2+: el bloque v1 se SALTA y se usa el segundo (tiempos de 64 bits).
        let at2 = 44 + block_size(h1, 4);
        h = read_header(b, at2)?;
        at = at2 + 44;
        tsize = 8;
    }
    if (h.typecnt == 0) {
        return Result.Err("tz: TZif without offset types");
    }
    if (at + block_size(h, tsize) > b.len()) {
        return Result.Err("tz: truncated TZif (data)");
    }
    // Transiciones (epoch-segundos, ascendentes) y su índice de tipo.
    var trans: [int] = [];
    var i = 0;
    while (i < h.timecnt) {
        trans.push(be_int(b, at + i * tsize, tsize));
        i = i + 1;
    }
    at = at + h.timecnt * tsize;
    var trans_type: [int] = [];
    i = 0;
    while (i < h.timecnt) {
        let ti = b[at + i];
        if (ti >= h.typecnt) {
            return Result.Err("tz: type index out of range");
        }
        trans_type.push(ti);
        i = i + 1;
    }
    at = at + h.timecnt;
    // Tipos: (utoff i32, isdst u8, desigidx u8).
    var utoffs: [int] = [];
    var isdsts: [bool] = [];
    var desig: [int] = [];
    i = 0;
    while (i < h.typecnt) {
        let base = at + i * 6;
        utoffs.push(be_int(b, base, 4));
        isdsts.push(b[base + 4] != 0);
        desig.push(b[base + 5]);
        i = i + 1;
    }
    at = at + h.typecnt * 6;
    // Abreviaturas: charcnt octetos de strings NUL-terminadas; cada tipo apunta por índice.
    var abbrevs: [string] = [];
    i = 0;
    while (i < h.typecnt) {
        var j = desig[i];
        var s = "";
        while (j < h.charcnt && b[at + j] != 0) {
            match (from_utf8(b.sub_bytes(at + j, at + j + 1))) {
                Result.Ok(c) => {
                    s = s + c;
                },
                Result.Err(e) => { },
            }
            j = j + 1;
        }
        abbrevs.push(s);
        i = i + 1;
    }
    // El tipo "antes de la primera transición" (RFC 8536 §3.2): el primer tipo no-DST, o el 0.
    var first = 0;
    i = 0;
    var found = false;
    while (i < h.typecnt && !found) {
        if (!isdsts[i]) {
            first = i;
            found = true;
        }
        i = i + 1;
    }
    // M85b: el footer TZ-string (solo v2+): tras el bloque de datos viene "\n<tz>\n".
    var foot = no_foot();
    if (version >= 50) {
        at = at + h.charcnt + h.leapcnt * (tsize + 4) + h.isstdcnt + h.isutcnt;
        if (at < b.len() && b[at] == 10) {
            var j = at + 1;
            var fin = 0 - 1;
            while (j < b.len() && fin < 0) {
                if (b[j] == 10) {
                    fin = j;
                }
                j = j + 1;
            }
            if (fin > at + 1) {
                match (from_utf8(b.sub_bytes(at + 1, fin))) {
                    Result.Ok(tzs) => {
                        foot = parse_foot(tzs);
                    },
                    Result.Err(e) => { },
                }
            }
        }
    }
    Result.Ok(
        Zone {
            name: name,
            trans: trans,
            trans_type: trans_type,
            utoffs: utoffs,
            isdsts: isdsts,
            abbrevs: abbrevs,
            first_type: first,
            foot: foot
        }
    )
}

fn no_foot() -> Foot {
    Foot {
        valid: false,
        std_off: 0,
        std_abbr: "",
        has_dst: false,
        dst_off: 0,
        dst_abbr: "",
        sm: 0,
        sw: 0,
        sd: 0,
        ssecs: 0,
        em: 0,
        ew: 0,
        ed: 0,
        esecs: 0
    }
}

// ---------------------------------------------------------------------------
// M85b: parser del TZ-string POSIX (el footer). `STD off [DST [off] [,Mm.w.d[/t],Mm.w.d[/t]]]`.
// El offset POSIX es POSITIVO al oeste de Greenwich → el offset IANA es su negado.
// ---------------------------------------------------------------------------
struct FP {
    cs: [char],
    pos: int,
    bad: bool,
}

fn fp_end(p: FP) -> bool { p.pos >= p.cs.len() }

fn fp_peek(p: FP) -> char { p.cs[p.pos] }

fn fp_digit(c: char) -> bool { '0' <= c && c <= '9' }

fn fp_alpha(c: char) -> bool { 'a' <= c && c <= 'z' || 'A' <= c && c <= 'Z' }

// El nombre de la zona: letras, o `<...>` (nombres con signo, p. ej. `<+07>`).
fn fp_name(p: FP) -> string {
    var out = "";
    if (!fp_end(p) && fp_peek(p) == '<') {
        p.pos = p.pos + 1;
        while (!fp_end(p) && fp_peek(p) != '>') {
            out = out + to_string(fp_peek(p));
            p.pos = p.pos + 1;
        }
        if (fp_end(p)) {
            p.bad = true;
        } else {
            p.pos = p.pos + 1;  // '>'
        }
        return out;
    }
    while (!fp_end(p) && fp_alpha(fp_peek(p))) {
        out = out + to_string(fp_peek(p));
        p.pos = p.pos + 1;
    }
    if (out.len() == 0) {
        p.bad = true;
    }
    out
}

// Un offset/hora `[+|-]h[h][:mm[:ss]]`, en SEGUNDOS (con su signo textual).
fn fp_secs(p: FP) -> int {
    var sign = 1;
    if (!fp_end(p) && (fp_peek(p) == '+' || fp_peek(p) == '-')) {
        if (fp_peek(p) == '-') {
            sign = 0 - 1;
        }
        p.pos = p.pos + 1;
    }
    var h = fp_num(p);
    var m = 0;
    var s = 0;
    if (!fp_end(p) && fp_peek(p) == ':') {
        p.pos = p.pos + 1;
        m = fp_num(p);
        if (!fp_end(p) && fp_peek(p) == ':') {
            p.pos = p.pos + 1;
            s = fp_num(p);
        }
    }
    sign * (h * 3600 + m * 60 + s)
}

fn fp_num(p: FP) -> int {
    var v = 0;
    var any = false;
    while (!fp_end(p) && fp_digit(fp_peek(p))) {
        v = v * 10 + (fp_peek(p) as int - '0' as int);
        p.pos = p.pos + 1;
        any = true;
    }
    if (!any) {
        p.bad = true;
    }
    v
}

// Una regla `Mm.w.d[/hora]`. Devuelve (mes, semana, día, segundos-del-día). Solo la forma M.
fn fp_rule(p: FP) -> (int, int, int, int) {
    if (fp_end(p) || fp_peek(p) != 'M') {
        p.bad = true;
        return (0, 0, 0, 0);
    }
    p.pos = p.pos + 1;
    let m = fp_num(p);
    if (fp_end(p) || fp_peek(p) != '.') {
        p.bad = true;
        return (0, 0, 0, 0);
    }
    p.pos = p.pos + 1;
    let w = fp_num(p);
    if (fp_end(p) || fp_peek(p) != '.') {
        p.bad = true;
        return (0, 0, 0, 0);
    }
    p.pos = p.pos + 1;
    let d = fp_num(p);
    var t = 7200;  // default 02:00:00 local
    if (!fp_end(p) && fp_peek(p) == '/') {
        p.pos = p.pos + 1;
        t = fp_secs(p);
    }
    return (m, w, d, t);
}

fn parse_foot(tzs: string) -> Foot {
    let p = FP { cs: tzs.chars(), pos: 0, bad: false };
    var f = no_foot();
    f.std_abbr = fp_name(p);
    f.std_off = 0 - fp_secs(p);  // POSIX oeste-positivo → IANA
    if (p.bad) {
        return no_foot();
    }
    if (fp_end(p)) {
        f.valid = true;  // zona fija (p. ej. `UTC0`, `<+07>-7`)
        return f;
    }
    f.dst_abbr = fp_name(p);
    f.has_dst = true;
    f.dst_off = f.std_off + 3600;  // default: STD + 1h
    if (!fp_end(p) && fp_peek(p) != ',') {
        f.dst_off = 0 - fp_secs(p);
    }
    // Las reglas son obligatorias para nosotros (sin ellas aplicarían los defaults de
    // POSIX-TZ, que zic nunca emite) → sin coma, footer no soportado.
    if (fp_end(p) || fp_peek(p) != ',') {
        return no_foot();
    }
    p.pos = p.pos + 1;
    let sr = fp_rule(p);
    if (fp_end(p) || fp_peek(p) != ',') {
        return no_foot();
    }
    p.pos = p.pos + 1;
    let er = fp_rule(p);
    if (p.bad || !fp_end(p)) {
        return no_foot();
    }
    f.sm = sr.0;
    f.sw = sr.1;
    f.sd = sr.2;
    f.ssecs = sr.3;
    f.em = er.0;
    f.ew = er.1;
    f.ed = er.2;
    f.esecs = er.3;
    f.valid = true;
    f
}

// ---------------------------------------------------------------------------
// Resolución
// ---------------------------------------------------------------------------
// M85b: ¿rigen las reglas del footer en `secs`? (tras la última transición explícita,
// o sin transiciones — RFC 8536 §3.3).
fn foot_rules(z: Zone, secs: int) -> bool {
    z.foot.valid && (z.trans.len() == 0 || secs > z.trans[z.trans.len() - 1])
}

// (offset IANA en segundos, es-DST, abreviatura) según las reglas perpetuas del footer.
fn foot_type(z: Zone, secs: int) -> (int, bool, string) {
    let f = z.foot;
    if (!f.has_dst) {
        return (f.std_off, false, f.std_abbr);
    }
    // El año LOCAL (en hora estándar) del instante; las reglas se evalúan en ese año.
    let y = time.from_epoch_millis((secs + f.std_off) * 1000).year;
    let start = rule_utc(y, f.sm, f.sw, f.sd, f.ssecs, f.std_off);
    let end = rule_utc(y, f.em, f.ew, f.ed, f.esecs, f.dst_off);
    var dst = false;
    if (start < end) {
        dst = secs >= start && secs < end;  // hemisferio norte
    } else {
        dst = secs >= start || secs < end;  // hemisferio sur (el DST cruza el año)
    }
    if (dst) {
        return (f.dst_off, true, f.dst_abbr);
    }
    // Gotcha §55: la tupla en cola tras un if-sentencia parsearía como llamada.
    return (f.std_off, false, f.std_abbr);
}

// El instante UTC (epoch-segundos) de la regla `Mm.w.d/t` en el año `y`: la hora `t` es
// LOCAL con el offset vigente ANTES de la transición (`off_before`).
fn rule_utc(y: int, m: int, w: int, d: int, t: int, off_before: int) -> int {
    let day = rule_day(y, m, w, d);
    let naive = time.to_epoch_millis(
        time.DateTime { year: y, month: m, day: day, hour: 0, minute: 0, second: 0, weekday: 0 }
    ) / 1000;
    naive + t - off_before
}

fn days_in_month(y: int, m: int) -> int {
    if (m == 2) {
        if (y % 4 == 0 && (y % 100 != 0 || y % 400 == 0)) {
            return 29;
        }
        return 28;
    }
    if (m == 4 || m == 6 || m == 9 || m == 11) {
        return 30;
    }
    31
}

// El día del mes de la `w`-ésima ocurrencia del día de semana `d` (0 = domingo) en
// `y`-`m`; `w = 5` es LA ÚLTIMA (aunque sea la cuarta).
fn rule_day(y: int, m: int, w: int, d: int) -> int {
    let first = time.from_epoch_millis(
        time.to_epoch_millis(
            time.DateTime { year: y, month: m, day: 1, hour: 12, minute: 0, second: 0, weekday: 0 }
        )
    );
    var day = 1 + (d - first.weekday + 7) % 7 + (w - 1) * 7;
    while (day > days_in_month(y, m)) {
        day = day - 7;
    }
    day
}

// El índice de TIPO vigente en el instante `secs` (epoch-segundos): búsqueda binaria de
// la última transición <= secs; antes de la primera (o sin transiciones) → first_type.
fn type_at(z: Zone, secs: int) -> int {
    if (z.trans.len() == 0 || secs < z.trans[0]) {
        return z.first_type;
    }
    var lo = 0;
    var hi = z.trans.len() - 1;
    while (lo < hi) {
        let mid = (lo + hi + 1) / 2;
        if (z.trans[mid] <= secs) {
            lo = mid;
        } else {
            hi = mid - 1;
        }
    }
    z.trans_type[lo]
}

// El offset UTC de la zona en un instante, en MILISEGUNDOS (la moneda de std/time).
// M85b: pasado el horizonte de transiciones explícitas, rigen las reglas del footer.
/// The zone's UTC offset at `instant_ms` (epoch-ms), in milliseconds. Past the last
/// explicit transition, the TZif footer's perpetual rules apply (M85b).
pub fn offset_at(z: Zone, instant_ms: int) -> int {
    let secs = floor_div(instant_ms, 1000);
    if (foot_rules(z, secs)) {
        return foot_type(z, secs).0 * 1000;
    }
    z.utoffs[type_at(z, secs)] * 1000
}

// La abreviatura vigente en un instante (`CET`, `CEST`, `EST`…).
/// The zone abbreviation in effect at `instant_ms` (e.g. "CET", "CEST").
pub fn abbrev_at(z: Zone, instant_ms: int) -> string {
    let secs = floor_div(instant_ms, 1000);
    if (foot_rules(z, secs)) {
        return foot_type(z, secs).2;
    }
    z.abbrevs[type_at(z, secs)]
}

// ¿Está la zona en horario de verano en un instante?
/// Whether daylight saving time is in effect at `instant_ms`.
pub fn is_dst_at(z: Zone, instant_ms: int) -> bool {
    let secs = floor_div(instant_ms, 1000);
    if (foot_rules(z, secs)) {
        return foot_type(z, secs).1;
    }
    z.isdsts[type_at(z, secs)]
}

// División con REDONDEO HACIA ABAJO (el `/` de raylang trunca hacia cero; para ms
// negativos la conversión a segundos debe ir al segundo anterior).
fn floor_div(a: int, b: int) -> int {
    let q = a / b;
    if (a % b != 0 && a < 0 != b < 0) {
        return q - 1;
    }
    q
}

// La hora CIVIL local de un instante UTC.
/// Converts a UTC instant (epoch-ms) to the zone's civil local time.
pub fn to_local(z: Zone, instant_ms: int) -> time.DateTime {
    time.from_epoch_millis(instant_ms + offset_at(z, instant_ms))
}

// El instante UTC de una hora CIVIL local — no total por el DST: `Single`, `Ambiguous`
// (solape de otoño, ambos instantes con el más temprano primero) o `Gap` (hueco de
// primavera: esa hora civil no existe en la zona).
/// Resolves a civil local time to a UTC instant. Returns `Single(ms)`, or
/// `Ambiguous(earlier_ms, later_ms)` during the fall-back overlap, or `Gap` during
/// the spring-forward gap (that civil time never occurs in this zone).
pub fn to_utc(z: Zone, civil: time.DateTime) -> LocalResult {
    let naive = time.to_epoch_millis(civil);  // como si fuera UTC
    // Los offsets candidatos: los vigentes alrededor del instante ingenuo (un día a
    // cada lado cubre cualquier transición cercana). Un offset `o` es solución si
    // offset_at(naive - o) == o.
    var cands: [int] = [];
    var offs: [int] = [];
    offs.push(offset_at(z, naive - 86400000));
    offs.push(offset_at(z, naive));
    offs.push(offset_at(z, naive + 86400000));
    var i = 0;
    while (i < offs.len()) {
        let o = offs[i];
        // dedup (hasta 3 valores, lineal)
        var vist = false;
        var j = 0;
        while (j < i) {
            if (offs[j] == o) {
                vist = true;
            }
            j = j + 1;
        }
        if (!vist) {
            let t = naive - o;
            if (offset_at(z, t) == o) {
                cands.push(t);
            }
        }
        i = i + 1;
    }
    if (cands.len() == 0) {
        return LocalResult.Gap;
    }
    if (cands.len() == 1) {
        return LocalResult.Single(cands[0]);
    }
    // Dos candidatos (solape): el más temprano primero.
    if (cands[0] <= cands[1]) {
        return LocalResult.Ambiguous(cands[0], cands[1]);
    }
    LocalResult.Ambiguous(cands[1], cands[0])
}

// El nombre con el que se cargó la zona.
/// The name this zone was loaded under (IANA name, file path, or "local").
pub fn name(z: Zone) -> string { z.name }
