// M87: `hint` = el callee es una expresión de BLOQUE (if/match/while/bloque) — casi
// siempre el gotcha §55 (la cola con '(' tras una sentencia); el mensaje, byte-idéntico
// al del checker de Rust.
fn call_type(
    c: Checker,
    ty: Type,
    cargs: [Expr],
    hint: bool,
    line: int,
    col: int
) -> Result<Type, TypeError> {
    match (ty) {
        Type.TFn(params, ret) => check_args(
            c,
            params,
            ret,
            cargs,
            "the function",
            line,
            col
        ),
        _ => {
            var msg = "cannot call a value of type " + type_str(ty) + " (not a function)";
            if (hint) {
                msg = msg + "; note: a tail starting with '(' after an if/while/match/block parses as a call of its value — separate it with 'return' or 'let'";
            }
            Result.Err(terr(line, col, msg))
        },
    }
}

// M87 (gotcha §55): ¿es una expresión "de bloque"?
fn block_like(e: Expr) -> bool {
    match (e.kind) {
        EKind.EIf(cnd, tb, eb) => true,
        EKind.EMatch(sc, arms) => true,
        EKind.EWhile(cnd, b) => true,
        EKind.EBlock(b) => true,
        _ => false,
    }
}

fn check_args(
    c: Checker,
    params: [Type],
    ret: Type,
    cargs: [Expr],
    label: string,
    line: int,
    col: int
) -> Result<Type, TypeError> {
    if (cargs.len() != params.len()) {
        return Result.Err(
            terr(
                line,
                col,
                label + " expects " + to_string(params.len()) + " argument(s), received " + to_string(cargs.len())
            )
        );
    }
    var i = 0;
    while (i < cargs.len()) {
        // El tipo del parámetro es el esperado del argumento (propaga a `[]`, etc.).
        let at = check_expr_expected(c, cargs[i], params[i])?;
        if (!type_eq(
            at,
            params[i]
        )) {
            return Result.Err(
                terr(
                    cargs[i].line,
                    cargs[i].col,
                    "argument " + to_string(i + 1) + " of " + label + ": expected " + type_str(params[i]) + ", got " + type_str(at)
                )
            );
        }
        i = i + 1;
    }
    Result.Ok(ret)
}

// `if`. Con un tipo esperado, se propaga a ambas ramas (para construcciones indeterminadas dentro).
fn check_if(
    c: Checker,
    cond: Expr,
    then_b: Block,
    elseopt: Option<Expr>,
    expected: Option<Type>,
    line: int,
    col: int
) -> Result<Type, TypeError> {
    let ct = check_expr(c, cond)?;
    if (!type_eq(ct, Type.TBool)) {
        return Result.Err(
            terr(cond.line, cond.col, "the if condition must be bool, not " + type_str(ct))
        );
    }
    let then_ty = check_block_opt(c, then_b, expected)?;
    match (elseopt) {
        Option.None => {
            if (!type_eq(
                then_ty,
                Type.TUnit
            )) {
                return Result.Err(
                    terr(
                        line,
                        col,
                        "an if without else has type unit, but its branch produces " + type_str(then_ty) + " (add an else)"
                    )
                );
            }
            Result.Ok(Type.TUnit)
        },
        Option.Some(else_e) => {
            let else_ty = check_expr_opt(c, else_e, expected)?;
            if (block_diverges(then_b)) {
                return Result.Ok(else_ty);
            }
            if (expr_diverges(else_e)) {
                return Result.Ok(then_ty);
            }
            if (!type_eq(
                then_ty,
                else_ty
            )) {
                return Result.Err(
                    terr(
                        line,
                        col,
                        "the if branches have different types: " + type_str(then_ty) + " and " + type_str(else_ty)
                    )
                );
            }
            Result.Ok(then_ty)
        },
    }
}

// Chequea una expresión con un tipo esperado opcional: con `Some` propaga (bidireccional), con `None`
// es el chequeo normal. (Evita duplicar cada función en variante con/sin esperado.)
fn check_expr_opt(c: Checker, e: Expr, expected: Option<Type>) -> Result<Type, TypeError> {
    match (expected) {
        Option.Some(exp) => check_expr_expected(c, e, exp),
        Option.None => check_expr(c, e),
    }
}

// Como `check_expr_opt`, pero para un bloque.
fn check_block_opt(c: Checker, b: Block, expected: Option<Type>) -> Result<Type, TypeError> {
    match (expected) {
        Option.Some(exp) => check_block_expected(c, b, exp),
        Option.None => check_block(c, b),
    }
}

fn check_while(c: Checker, cond: Expr, body: Block, line: int, col: int) -> Result<Type, TypeError> {
    let ct = check_expr(c, cond)?;
    if (!type_eq(ct, Type.TBool)) {
        return Result.Err(
            terr(cond.line, cond.col, "the while condition must be bool, not " + type_str(ct))
        );
    }
    check_block(c, body)?;
    Result.Ok(Type.TUnit)
}

// Verifica un bloque en su propio ámbito y devuelve su tipo-valor (la expresión final, o unit).
fn check_block(c: Checker, block: Block) -> Result<Type, TypeError> {
    push_scope(c);
    var i = 0;
    while (i < block.stmts.len()) {
        check_stmt(c, block.stmts[i])?;
        i = i + 1;
    }
    var ty = Type.TUnit;
    match (block.tail) {
        Option.Some(e) => {
            ty = check_expr(c, e)?;
        },
        Option.None => { },
    }
    pop_scope(c);
    Result.Ok(ty)
}

// Como `check_block`, pero el valor final (la *tail*) se verifica con un tipo esperado.
fn check_block_expected(c: Checker, block: Block, expected: Type) -> Result<Type, TypeError> {
    push_scope(c);
    var i = 0;
    while (i < block.stmts.len()) {
        check_stmt(c, block.stmts[i])?;
        i = i + 1;
    }
    var ty = Type.TUnit;
    match (block.tail) {
        Option.Some(e) => {
            ty = check_expr_expected(c, e, expected)?;
        },
        Option.None => { },
    }
    pop_scope(c);
    Result.Ok(ty)
}

// =====================================================================
// Datos: arreglos, structs, enums, match (M14.3b)
// =====================================================================
// Un literal de arreglo `[e0, e1, ...]`. Todos los elementos deben ser del mismo tipo. El vacío `[]`
// es indeterminado aquí (necesita un tipo esperado, vía `check_expr_expected`).
fn check_array(c: Checker, elems: [Expr], line: int, col: int) -> Result<Type, TypeError> {
    if (elems.len() == 0) {
        return Result.Err(
            terr(
                line,
                col,
                "cannot infer the type of [] here; annotate it (e.g. let xs: [int] = [];)"
            )
        );
    }
    let first = check_expr(c, elems[0])?;
    var i = 1;
    while (i < elems.len()) {
        let t = check_expr(c, elems[i])?;
        if (!type_eq(
            t,
            first
        )) {
            return Result.Err(
                terr(
                    elems[i].line,
                    elems[i].col,
                    "the array elements must be of the same type: " + type_str(first) + " and " + type_str(t)
                )
            );
        }
        i = i + 1;
    }
    Result.Ok(Type.TArray(first))
}

// Indexar `a[i]`: el índice debe ser int; el receptor un arreglo (da el elemento) o un string (da
// char). Reusado por la indexación como expresión y como destino de asignación.
fn check_index(c: Checker, array: Expr, index: Expr) -> Result<Type, TypeError> {
    let at = check_expr(c, array)?;
    let it = check_expr(c, index)?;
    if (!type_eq(it, Type.TInt)) {
        return Result.Err(
            terr(index.line, index.col, "the index must be int, not " + type_str(it))
        );
    }
    match (at) {
        Type.TArray(elem) => Result.Ok(
            elem
        ),
        Type.TString => Result.Ok(Type.TChar),
        _ => {
            var msg = "cannot index a " + type_str(at) + " (not an array, string or bytes)";
            if (block_like(
                array
            )) {
                msg = msg + "; note: a tail starting with '[' after an if/while/match/block parses as an indexing of its value — separate it with 'return' or 'let'";
            }
            Result.Err(terr(array.line, array.col, msg))
        },
    }
}

// `obj.name`: el objeto debe ser un struct y `name` uno de sus campos. Para un struct genérico, el
// tipo del campo se SUSTITUYE con los args de tipo del objeto (el campo `primero: A` de
// `Par<int, bool>` es int).
fn check_field(c: Checker, object: Expr, name: string) -> Result<Type, TypeError> {
    let ot = check_expr(c, object)?;
    match (ot) {
        Type.TNamed(sname, targs) => {
            match (get(
            c.structs,
            sname
        )) {
                Option.Some(fields) => {
                    match (find_field(
                    fields,
                    name
                )) {
                        Option.Some(fty) => {
                            let sigma = build_sigma(struct_tparams(c, sname), targs);
                            Result.Ok(subst(fty, sigma))
                        },
                        Option.None => Result.Err(
                            terr(
                                object.line,
                                object.col,
                                "the struct '" + sname + "' has no field '" + name + "'"
                            )
                        ),
                    }
                },
                Option.None => Result.Err(
                    terr(
                        object.line,
                        object.col,
                        "cannot access '." + name + "' on a " + type_str(ot) + " (not a struct)"
                    )
                ),
            }
        },
        _ => Result.Err(
            terr(
                object.line,
                object.col,
                "cannot access '." + name + "' on a " + type_str(ot) + " (not a struct)"
            )
        ),
    }
}

// Los parámetros de tipo de un struct/enum registrado (lista vacía si monomórfico o desconocido).
fn struct_tparams(c: Checker, name: string) -> [string] {
    match (get(c.struct_tparams, name)) {
        Option.Some(tp) => tp,
        Option.None => no_tparams(),
    }
}

fn enum_tparams(c: Checker, name: string) -> [string] {
    match (get(c.enum_tparams, name)) {
        Option.Some(tp) => tp,
        Option.None => no_tparams(),
    }
}

// σ que liga cada parámetro de tipo con su argumento (zip), para sustituir campos/payloads.
fn build_sigma(tparams: [string], targs: [Type]) -> Map<string, Type> {
    let sigma: Map<string, Type> = Map.new();
    var i = 0;
    while (i < tparams.len() && i < targs.len()) {
        sigma.insert(tparams[i], targs[i]);
        i = i + 1;
    }
    sigma
}

// Siembra σ desde el tipo esperado: si se espera `Nombre<a, b>` (misma aridad), liga cada parámetro
// con su argumento esperado. Así `Caja.Vacia` con esperado `Caja<int>` fija `T = int`.
fn seed_sigma_from_expected(
    expected: Option<Type>,
    name: string,
    tparams: [string]
) -> Map<string, Type> {
    let sigma: Map<string, Type> = Map.new();
    match (expected) {
        Option.Some(t) => {
            match (t) {
                Type.TNamed(en, eargs) => {
                    if (en == name && eargs.len() == tparams.len()) {
                        var i = 0;
                        while (i < tparams.len()) {
                            sigma.insert(tparams[i], eargs[i]);
                            i = i + 1;
                        }
                    }
                },
                _ => { },
            }
        },
        Option.None => { },
    }
    sigma
}

// ¿Contiene `t` alguna variable de tipo sin resolver (un `TNamed(n, [])` con `n` en `holes`)?
fn type_has_var(t: Type, holes: [string]) -> bool {
    match (t) {
        Type.TNamed(n, args) => {
            if (args.len() == 0 && contains_str(
            holes,
            n
        )) { true } else { types_have_var(args, holes) }
        },
        Type.TArray(e) => type_has_var(e, holes),
        Type.TFn(ps, r) => types_have_var(ps, holes) || type_has_var(r, holes),
        _ => false,
    }
}

fn types_have_var(ts: [Type], holes: [string]) -> bool {
    var i = 0;
    while (i < ts.len()) {
        if (type_has_var(ts[i], holes)) {
            return true;
        }
        i = i + 1;
    }
    false
}

// Verifica el valor de un campo/payload propagándole como esperado el tipo declarado ya sustituido
// con lo inferido (σ), pero solo si ese tipo es concreto (sin incógnitas); si aún tiene variables,
// no aporta y se chequea normal.
fn check_value_against(
    c: Checker,
    value: Expr,
    declared: Type,
    sigma: Map<string, Type>,
    holes: [string]
) -> Result<Type, TypeError> {
    let exp = subst(declared, sigma);
    if (type_has_var(
    exp,
    holes
)) { check_expr(c, value) } else { check_expr_expected(c, value, exp) }
}

// Para cada parámetro de tipo, recupera lo inferido en σ (en orden), o error si quedó indeterminado.
fn finalize_type_args(
    tparams: [string],
    sigma: Map<string, Type>,
    label: string,
    line: int,
    col: int
) -> Result<[Type], TypeError> {
    var targs: [Type] = [];
    var i = 0;
    while (i < tparams.len()) {
        match (get(
            sigma,
            tparams[i]
        )) {
            Option.Some(t) => {
                targs.push(t);
            },
            Option.None => {
                return Result.Err(
                    terr(
                        line,
                        col,
                        "could not infer the type parameter '" + tparams[i] + "' of " + label + "; annotate the type"
                    )
                );
            },
        }
        i = i + 1;
    }
    Result.Ok(targs)
}

// El tipo del campo `name` en una lista de campos (`None` si no existe).
fn find_field(fields: [FieldDef], name: string) -> Option<Type> {
    var i = 0;
    while (i < fields.len()) {
        if (fields[i].name == name) {
            return Option.Some(fields[i].ty);
        }
        i = i + 1;
    }
    Option.None
}

// Un literal de struct `Nombre { campo: valor, ... }`. Cada campo declarado debe estar exactamente
// una vez; no debe haber campos desconocidos. Para un struct genérico, infiere los args de tipo de
// los valores (y del tipo esperado). Devuelve `TNamed(name, targs)`.
fn check_struct_lit(
    c: Checker,
    name: string,
    fields: [FieldInit],
    expected: Option<Type>,
    line: int,
    col: int
) -> Result<Type, TypeError> {
    match (get(c.structs, name)) {
        Option.None => Result.Err(terr(line, col, "struct '" + name + "' not declared")),
        Option.Some(declared) => {
            let tparams = struct_tparams(c, name);
            // No debe haber campos desconocidos.
            var i = 0;
            while (i < fields.len()) {
                let fi = fields[i];
                if (!field_declared(declared, fi.name)) {
                    return Result.Err(
                        terr(
                            fi.value.line,
                            fi.value.col,
                            "'" + name + "' has no field '" + fi.name + "'"
                        )
                    );
                }
                i = i + 1;
            }
            // σ se siembra del tipo esperado; cada valor unifica los parámetros de tipo del struct.
            let sigma = seed_sigma_from_expected(expected, name, tparams);
            var di = 0;
            while (di < declared.len()) {
                let df = declared[di];
                let cnt = count_field(fields, df.name);
                if (cnt == 0) {
                    return Result.Err(
                        terr(
                            line,
                            col,
                            "missing field '" + df.name + "' in the literal of '" + name + "'"
                        )
                    );
                }
                if (cnt > 1) {
                    return Result.Err(
                        terr(line, col, "field '" + df.name + "' of '" + name + "' repeated")
                    );
                }
                let value = field_value(fields, df.name);
                let vt = check_value_against(c, value, df.ty, sigma, tparams)?;
                match (unify(df.ty, vt, sigma, tparams)) {
                    Result.Ok(_) => { },
                    Result.Err(reason) => {
                        return Result.Err(
                            terr(
                                value.line,
                                value.col,
                                "field '" + df.name + "' of '" + name + "': " + reason
                            )
                        );
                    },
                }
                di = di + 1;
            }
            let targs = finalize_type_args(tparams, sigma, "the struct '" + name + "'", line, col)?;
            Result.Ok(Type.TNamed(name, targs))
        },
    }
}

// ¿Está `name` entre los campos declarados?
fn field_declared(declared: [FieldDef], name: string) -> bool {
    var i = 0;
    while (i < declared.len()) {
        if (declared[i].name == name) {
            return true;
        }
        i = i + 1;
    }
    false
}

// Cuántas veces aparece el campo `name` en el literal (para detectar faltantes/repetidos).
fn count_field(fields: [FieldInit], name: string) -> int {
    var n = 0;
    var i = 0;
    while (i < fields.len()) {
        if (fields[i].name == name) {
            n = n + 1;
        }
        i = i + 1;
    }
    n
}

// El valor (la primera aparición) del campo `name` en el literal (existe: se llamó con cnt == 1).
fn field_value(fields: [FieldInit], name: string) -> Expr {
    var i = 0;
    while (i < fields.len()) {
        if (fields[i].name == name) {
            return fields[i].value;
        }
        i = i + 1;
    }
    fields[0].value
}

// Construcción de una variante de enum `Enum.Variante(args)`. La variante debe existir y el payload
// (aridad + tipos) debe encajar. Para un enum genérico infiere los args de tipo del payload (y del
// tipo esperado, p. ej. `Caja.Vacia`). Devuelve `TNamed(enum_name, targs)`.
fn check_enum_lit(
    c: Checker,
    enum_name: string,
    variant: string,
    cargs: [Expr],
    expected: Option<Type>,
    line: int,
    col: int
) -> Result<Type, TypeError> {
    match (get(
    c.enums,
    enum_name
)) {
        Option.None => Result.Err(terr(line, col, "enum '" + enum_name + "' not declared")),
        Option.Some(variants) => {
            match (find_variant(
            variants,
            variant
        )) {
                Option.None => Result.Err(
                    terr(line, col, "the enum '" + enum_name + "' has no variant '" + variant + "'")
                ),
                Option.Some(payload) => {
                    if (cargs.len() != payload.len()) {
                        return Result.Err(
                            terr(
                                line,
                                col,
                                "the variant '" + enum_name + "." + variant + "' expects " + to_string(payload.len()) + " argument(s), got " + to_string(cargs.len())
                            )
                        );
                    }
                    let tparams = enum_tparams(c, enum_name);
                    let sigma = seed_sigma_from_expected(expected, enum_name, tparams);
                    var i = 0;
                    while (i < cargs.len()) {
                        let pty = payload[i];
                        let at = check_value_against(c, cargs[i], pty, sigma, tparams)?;
                        match (unify(pty, at, sigma, tparams)) {
                            Result.Ok(_) => { },
                            Result.Err(reason) => {
                                return Result.Err(
                                    terr(
                                        cargs[i].line,
                                        cargs[i].col,
                                        "'" + enum_name + "." + variant + "': " + reason
                                    )
                                );
                            },
                        }
                        i = i + 1;
                    }
                    let targs = finalize_type_args(
                        tparams,
                        sigma,
                        "the variant '" + enum_name + "." + variant + "'",
                        line,
                        col
                    )?;
                    Result.Ok(Type.TNamed(enum_name, targs))
                },
            }
        },
    }
}

// El payload de la variante `name` en una lista de variantes (`None` si no existe).
fn find_variant(variants: [VariantDef], name: string) -> Option<[Type]> {
    var i = 0;
    while (i < variants.len()) {
        if (variants[i].name == name) {
            return Option.Some(variants[i].payload);
        }
        i = i + 1;
    }
    Option.None
}

// `match (escrutinio) { patrón => cuerpo, ... }`. El escrutinio debe ser un enum; cada patrón debe
// pertenecer a ese enum (aridad correcta); los brazos convergen a un tipo común; debe ser exhaustivo.
fn check_match(
    c: Checker,
    scrut: Expr,
    arms: [MatchArm],
    expected: Option<Type>,
    line: int,
    col: int
) -> Result<Type, TypeError> {
    let scrut_ty = check_expr(c, scrut)?;
    var enum_name = "";
    var enum_targs: [Type] = [];
    match (scrut_ty) {
        Type.TNamed(n, targs) => {
            if (is_enum(c, n)) {
                enum_name = n;
                enum_targs = targs;
            } else {
                return Result.Err(
                    terr(
                        scrut.line,
                        scrut.col,
                        "match requires an enum, but the scrutinee is " + type_str(scrut_ty)
                    )
                );
            }
        },
        _ => {
            return Result.Err(
                terr(
                    scrut.line,
                    scrut.col,
                    "match requires an enum, but the scrutinee is " + type_str(scrut_ty)
                )
            );
        },
    }
    if (arms.len() == 0) {
        return Result.Err(terr(line, col, "a match cannot be empty"));
    }
    let variants = enum_variants(c, enum_name);
    // σ del enum: liga sus parámetros de tipo con los args del escrutinio, para sustituir los payloads
    // (`Some(T)` sobre `Option<int>` liga `T = int`).
    let enum_sigma = build_sigma(enum_tparams(c, enum_name), enum_targs);
    let st = MatchState { covered: [], catchall: false };
    var result_ty: Option<Type> = Option.None;
    var ai = 0;
    while (ai < arms.len()) {
        let arm = arms[ai];
        if (st.catchall) {
            return Result.Err(
                terr(arm.line, arm.col, "unreachable arm: a previous arm already covers all cases")
            );
        }
        let binds = check_pattern(c, arm.pat, scrut_ty, enum_name, variants, enum_sigma, st)?;
        push_scope(c);
        var bi = 0;
        while (bi < binds.len()) {
            declare(c, binds[bi].name, binds[bi].ty, false, arm.line, arm.col);
            bi = bi + 1;
        }
        let body_ty = check_expr_opt(c, arm.body, expected)?;
        pop_scope(c);
        // Un brazo que diverge (panic/return) no fija el tipo del match; lo ceden los demás.
        if (!expr_diverges(
            arm.body
        )) {
            match (result_ty) {
                Option.None => {
                    result_ty = Option.Some(body_ty);
                },
                Option.Some(prev) => {
                    if (!type_eq(
                    prev,
                    body_ty
                )) {
                        return Result.Err(
                            terr(
                                arm.body.line,
                                arm.body.col,
                                "the match arms produce different types: " + type_str(prev) + " and " + type_str(body_ty)
                            )
                        );
                    }
                },
            }
        }
        ai = ai + 1;
    }
    // Exhaustividad: sin catch-all, deben estar TODAS las variantes.
    if (!st.catchall) {
        var missing: [string] = [];
        var vi = 0;
        while (vi < variants.len()) {
            let vname = variants[vi].name;
            if (!contains_str(st.covered, vname)) {
                missing.push(vname);
            }
            vi = vi + 1;
        }
        if (missing.len() > 0) {
            return Result.Err(
                terr(
                    line,
                    col,
                    "non-exhaustive match on '" + enum_name + "': missing variants: " + join_comma(missing)
                )
            );
        }
    }
    match (result_ty) {
        Option.Some(t) => Result.Ok(t),
        Option.None => Result.Ok(Type.TUnit),
    }
}

// Comprueba un patrón contra el enum del escrutinio. Devuelve las variables que liga (para el cuerpo
// del brazo). Actualiza el estado (variantes cubiertas, catch-all) por referencia.
fn check_pattern(
    c: Checker,
    pat: Pattern,
    scrut_ty: Type,
    enum_name: string,
    variants: [VariantDef],
    enum_sigma: Map<string, Type>,
    st: MatchState
) -> Result<[Bind], TypeError> {
    match (pat.kind) {
        PKind.PWild => {
            st.catchall = true;
            Result.Ok([])
        },
        PKind.PBind(name) => {
            // Liga el escrutinio completo; cubre todo lo restante.
            st.catchall = true;
            var binds: [Bind] = [];
            binds.push(Bind { name: name, ty: scrut_ty });
            Result.Ok(binds)
        },
        PKind.PVariant(pat_enum, variant, bindings) => {
            if (pat_enum != enum_name) {
                return Result.Err(
                    terr(
                        pat.line,
                        pat.col,
                        "the pattern is of enum '" + pat_enum + "', but the scrutinee is '" + enum_name + "'"
                    )
                );
            }
            match (find_variant(
            variants,
            variant
        )) {
                Option.None => Result.Err(
                    terr(
                        pat.line,
                        pat.col,
                        "the enum '" + enum_name + "' has no variant '" + variant + "'"
                    )
                ),
                Option.Some(payload) => {
                    if (bindings.len() != payload.len()) {
                        return Result.Err(
                            terr(
                                pat.line,
                                pat.col,
                                "the pattern '" + enum_name + "." + variant + "' binds " + to_string(bindings.len()) + " value(s), but the variant has " + to_string(payload.len())
                            )
                        );
                    }
                    if (contains_str(st.covered, variant)) {
                        return Result.Err(
                            terr(
                                pat.line,
                                pat.col,
                                "the variant '" + variant + "' is already covered by a previous arm"
                            )
                        );
                    }
                    st.covered.push(variant);
                    // Cada sub-binding liga el payload ya SUSTITUIDO con los args de tipo del
                    // escrutinio (`x` en `Some(x)` sobre `Option<int>` es int).
                    var binds: [Bind] = [];
                    var i = 0;
                    while (i < bindings.len()) {
                        match (bindings[i]) {
                            Option.Some(bn) => {
                                binds.push(Bind { name: bn, ty: subst(payload[i], enum_sigma) });
                            },
                            Option.None => { },
                        }
                        i = i + 1;
                    }
                    Result.Ok(binds)
                },
            }
        },
    }
}

// =====================================================================
// Traits e impls (M14.3d-2: despacho estático, Self, métodos por defecto)
// =====================================================================
// Nombre manglado de un método: `Tipo#metodo` (`#` ilegal en identificadores → no choca con nombres
// del usuario). Es la clave de la tabla de métodos y el nombre que aparece en los errores de llamada.
fn mangle(type_key: string, method: string) -> string { type_key + "#" + method }

// Clave de tipo para la tabla de métodos: el nombre del struct/enum o el primitivo. `None` para los
// tipos que no pueden recibir un impl (arreglos, funciones, unit, Self).
fn type_key_of(t: Type) -> Option<string> {
    match (t) {
        Type.TInt => Option.Some("int"),
        Type.TFloat => Option.Some("float"),
        Type.TBool => Option.Some("bool"),
        Type.TString => Option.Some("string"),
        Type.TChar => Option.Some("char"),
        Type.TNamed(n, _) => Option.Some(n),
        _ => Option.None,
    }
}

// Sustituye `Self` (`TNamed("Self", [])`) por el tipo implementador, recursivamente.
fn subst_self(ty: Type, target: Type) -> Type {
    match (ty) {
        Type.TNamed(n, args) => {
            if (n == "Self" && args.len() == 0) { target } else {
                var ra: [Type] = [];
                var i = 0;
                while (i < args.len()) {
                    ra.push(subst_self(args[i], target));
                    i = i + 1;
                }
                Type.TNamed(n, ra)
            }
        },
        Type.TArray(e) => Type.TArray(subst_self(e, target)),
        Type.TFn(ps, r) => {
            var rps: [Type] = [];
            var i = 0;
            while (i < ps.len()) {
                rps.push(subst_self(ps[i], target));
                i = i + 1;
            }
            Type.TFn(rps, subst_self(r, target))
        },
        _ => ty,
    }
}

fn is_primitive(t: Type) -> bool {
    match (t) {
        Type.TInt => true,
        Type.TFloat => true,
        Type.TBool => true,
        Type.TString => true,
        Type.TChar => true,
        _ => false,
    }
}

// ¿La firma de trait `tm` trae cuerpo por defecto?
fn has_default(tm: MethodSig) -> bool {
    match (tm.default_body) {
        Option.Some(_) => true,
        Option.None => false,
    }
}

// La firma de trait con nombre `name` (o `None`).
fn find_method_sig(methods: [MethodSig], name: string) -> Option<MethodSig> {
    var i = 0;
    while (i < methods.len()) {
        if (methods[i].name == name) {
            return Option.Some(methods[i]);
        }
        i = i + 1;
    }
    Option.None
}

// ¿El impl redefine el método `name`?
fn impl_overrides(imp: ImplBlock, name: string) -> bool {
    var i = 0;
    while (i < imp.methods.len()) {
        if (imp.methods[i].name == name) {
            return true;
        }
        i = i + 1;
    }
    false
}

// La FnSig de un método (params con Self→target, self incluido; ret con Self→target). Un impl concreto
// pasa type_params/bounds vacíos; un impl genérico (M9.2b) pasa los suyos → el método ES una función
// genérica acotada (`Caja#medir<T: Medir>(self: Caja<T>)`), resuelta con la misma inferencia/bounds.
fn method_fnsig(
    params: [Param],
    ret: Type,
    target: Type,
    type_params: [string],
    bounds: [Bound]
) -> FnSig {
    var ps: [Type] = [];
    var i = 0;
    while (i < params.len()) {
        ps.push(resolve_type(subst_self(params[i].ty, target)));
        i = i + 1;
    }
    FnSig {
        params: ps,
        ret: resolve_type(subst_self(ret, target)),
        type_params: type_params,
        bounds: bounds
    }
}

// Registra los traits (firmas) y valida + tabula los impls. M14.3d-2: solo impls CONCRETOS (genéricos
// y bounds → d-3). Mismo orden/mensajes que Rust.
fn register_traits_impls(c: Checker, prog: Program) -> Result<int, TypeError> {
    // 1) Traits: nombres únicos (no chocan con tipos), métodos únicos.
    var ti = 0;
    while (ti < prog.traits.len()) {
        let t = prog.traits[ti];
        if (c.structs.contains_key(t.name) || c.enums.contains_key(t.name)) {
            return Result.Err(
                terr(t.line, t.col, "'" + t.name + "' is already a type; it cannot also be a trait")
            );
        }
        if (c.traits.contains_key(t.name)) {
            return Result.Err(terr(t.line, t.col, "trait '" + t.name + "' declared twice"));
        }
        var seen: [string] = [];
        var mi = 0;
        while (mi < t.methods.len()) {
            let m = t.methods[mi];
            if (contains_str(seen, m.name)) {
                return Result.Err(
                    terr(
                        m.line,
                        m.col,
                        "method '" + m.name + "' repeated in trait '" + t.name + "'"
                    )
                );
            }
            seen.push(m.name);
            mi = mi + 1;
        }
        c.traits.insert(t.name, t.methods);
        ti = ti + 1;
    }
    // 2) Impls: validar contra su trait y poblar la tabla de métodos.
    var ii = 0;
    while (ii < prog.impls.len()) {
        register_impl(c, prog.impls[ii])?;
        ii = ii + 1;
    }
    Result.Ok(0)
}

fn register_impl(c: Checker, imp: ImplBlock) -> Result<int, TypeError> {
    let trait_methods = match (get(c.traits, imp.trait_name)) {
        Option.Some(ms) => ms,
        Option.None => {
            return Result.Err(
                terr(imp.line, imp.col, "trait '" + imp.trait_name + "' not declared")
            );
        },
    };
    // M9.2b: los parámetros de tipo del impl entran en ámbito (`Caja<T>` y `x: T` válidos).
    c.tparams = imp.type_params;
    check_impl_bounds(c, imp)?;
    let target = resolve_type(imp.target);
    ensure_impl_target(c, target, imp.type_params, imp.line, imp.col)?;
    let key = type_key_str(target);
    // Nombres del impl sin repetir.
    var impl_names: [string] = [];
    var mi = 0;
    while (mi < imp.methods.len()) {
        let m = imp.methods[mi];
        if (contains_str(impl_names, m.name)) {
            return Result.Err(terr(m.line, m.col, "method '" + m.name + "' implemented twice"));
        }
        impl_names.push(m.name);
        mi = mi + 1;
    }
    // Cobertura: no faltan métodos del trait (salvo los que tienen defecto).
    var tj = 0;
    while (tj < trait_methods.len()) {
        let tm = trait_methods[tj];
        if (!contains_str(
            impl_names,
            tm.name
        ) && !has_default(tm)) {
            return Result.Err(
                terr(
                    imp.line,
                    imp.col,
                    "the impl of '" + imp.trait_name + "' for " + type_str(target) + " does not implement method '" + tm.name + "'"
                )
            );
        }
        tj = tj + 1;
    }
    // Métodos del impl: pertenecen al trait, firmas casan, registrar.
    mi = 0;
    while (mi < imp.methods.len()) {
        let m = imp.methods[mi];
        match (find_method_sig(
            trait_methods,
            m.name
        )) {
            Option.None => {
                return Result.Err(
                    terr(
                        m.line,
                        m.col,
                        "the trait '" + imp.trait_name + "' does not declare a method '" + m.name + "'"
                    )
                );
            },
            Option.Some(tm) => {
                check_method_sig(tm, m, target)?;
                let mangled = mangle(key, m.name);
                if (c.methods.contains_key(
                    mangled
                )) {
                    return Result.Err(
                        terr(
                            m.line,
                            m.col,
                            "method '" + m.name + "' ambiguous for " + type_str(target) + ": an impl already provides it"
                        )
                    );
                }
                c.methods.insert(
                    mangled,
                    method_fnsig(m.params, m.ret, target, imp.type_params, imp.bounds)
                );
            },
        }
        mi = mi + 1;
    }
    // Defectos no redefinidos: también van a la tabla de resolución.
    tj = 0;
    while (tj < trait_methods.len()) {
        let tm = trait_methods[tj];
        if (has_default(
            tm
        ) && !contains_str(impl_names, tm.name)) {
            let mangled = mangle(key, tm.name);
            if (c.methods.contains_key(
                mangled
            )) {
                return Result.Err(
                    terr(
                        imp.line,
                        imp.col,
                        "method '" + tm.name + "' ambiguous for " + type_str(target) + ": an impl already provides it"
                    )
                );
            }
            c.methods.insert(
                mangled,
                method_fnsig(tm.params, tm.ret, target, imp.type_params, imp.bounds)
            );
        }
        tj = tj + 1;
    }
    // Registrar que este tipo implementa este trait (M14.3d-3: satisfacción de bounds).
    c.impl_traits.insert(mangle(key, imp.trait_name), true);
    c.tparams = no_tparams();
    Result.Ok(0)
}

// Valida los bounds de un impl genérico: cada bound acota un parámetro de tipo que el impl declara,
// con un trait existente. (Análogo a `check_bounds` para funciones.)
fn check_impl_bounds(c: Checker, imp: ImplBlock) -> Result<int, TypeError> {
    var i = 0;
    while (i < imp.bounds.len()) {
        let b = imp.bounds[i];
        if (!contains_str(
            imp.type_params,
            b.param
        )) {
            return Result.Err(
                terr(
                    imp.line,
                    imp.col,
                    "the bound '" + b.param + ": " + b.trait_name + "' mentions a type parameter the impl does not declare"
                )
            );
        }
        if (!c.traits.contains_key(b.trait_name)) {
            return Result.Err(
                terr(
                    imp.line,
                    imp.col,
                    "the bound '" + b.param + ": " + b.trait_name + "' uses an undeclared trait"
                )
            );
        }
        i = i + 1;
    }
    Result.Ok(0)
}

// La clave de tipo de un objetivo de impl ya validado (siempre existe).
fn type_key_str(t: Type) -> string {
    match (type_key_of(t)) {
        Option.Some(k) => k,
        Option.None => "",
    }
}

// =====================================================================
// @derive y anotaciones (M14.3d-4c)
// =====================================================================
// Genera los impls de `@derive(Eq, Show)` sobre struct/enum no genérico: registra los métodos
// derivados (`igual`/`mostrar`) y la marca en `impl_traits`. En Rust se genera el FUENTE del impl y se
// baja con M9; el validador solo necesita las firmas (no chequea el cuerpo: es codegen conocido).
fn generate_derives(c: Checker, prog: Program) -> Result<int, TypeError> {
    var si = 0;
    while (si < prog.structs.len()) {
        let s = prog.structs[si];
        generate_derives_for(c, s.annotations, s.name, s.type_params, false)?;
        si = si + 1;
    }
    var ei = 0;
    while (ei < prog.enums.len()) {
        let e = prog.enums[ei];
        generate_derives_for(c, e.annotations, e.name, e.type_params, true)?;
        ei = ei + 1;
    }
    Result.Ok(0)
}

fn generate_derives_for(
    c: Checker,
    annotations: [Annotation],
    name: string,
    type_params: [string],
    is_enum: bool
) -> Result<int, TypeError> {
    var i = 0;
    while (i < annotations.len()) {
        let a = annotations[i];
        if (a.name == "derive") {
            validate_derive(a, name, type_params)?;
            var j = 0;
            while (j < a.args.len()) {
                // M93.5 (espejo de Rust): la representación JSON de un enum está diferida.
                if (is_enum && a.args[j] == "ToJson") {
                    return Result.Err(
                        terr(
                            a.line,
                            a.col,
                            "cannot derive ToJson for an enum (only structs for now)"
                        )
                    );
                }
                register_derived_impl(c, name, a.args[j]);
                j = j + 1;
            }
        }
        i = i + 1;
    }
    Result.Ok(0)
}

// Valida `@derive(...)`: argumentos no vacíos, todos derivables (Eq/Show), tipo no genérico.
fn validate_derive(a: Annotation, name: string, type_params: [string]) -> Result<int, TypeError> {
    if (a.args.len() == 0) {
        return Result.Err(
            terr(a.line, a.col, "'@derive' requires at least one trait (e.g. @derive(Eq))")
        );
    }
    var i = 0;
    while (i < a.args.len()) {
        if (a.args[i] != "Eq" && a.args[i] != "Show" && a.args[i] != "Hash" && a.args[i] != "ToJson") {
            return Result.Err(
                terr(
                    a.line,
                    a.col,
                    "cannot derive '" + a.args[i] + "' (for now Eq, Show, Hash and ToJson)"
                )
            );
        }
        i = i + 1;
    }
    if (type_params.len() != 0) {
        return Result.Err(terr(a.line, a.col, "cannot derive for the generic type '" + name + "'"));
    }
    Result.Ok(0)
}

// Registra el impl derivado de un trait (`Eq`→`igual`, `Show`→`mostrar`) para un tipo. Idempotente:
// si ya hay un impl (del usuario o derivado), no lo pisa.
fn register_derived_impl(c: Checker, type_name: string, trait_name: string) {
    if (c.impl_traits.contains_key(mangle(type_name, trait_name))) {
        return;
    }
    let target = Type.TNamed(type_name, []);
    if (trait_name == "Eq") {
        c.methods.insert(
            mangle(type_name, "eq"),
            FnSig {
                params: [target, target],
                ret: Type.TBool,
                type_params: no_tparams(),
                bounds: no_bounds()
            }
        );
    }
    if (trait_name == "Show") {
        c.methods.insert(
            mangle(type_name, "show"),
            FnSig {
                params: [target],
                ret: Type.TString,
                type_params: no_tparams(),
                bounds: no_bounds()
            }
        );
    }
    if (trait_name == "ToJson") {
        c.methods.insert(
            mangle(type_name, "to_json"),
            FnSig {
                params: [target],
                ret: Type.TString,
                type_params: no_tparams(),
                bounds: no_bounds()
            }
        );
    }
    c.impl_traits.insert(mangle(type_name, trait_name), true);
}

// Valida las anotaciones: `@test` solo en funciones `() -> bool`/`() -> unit`; `@derive` solo en tipos;
// cualquier otra es desconocida.
fn check_annotations(c: Checker, prog: Program) -> Result<int, TypeError> {
    var fi = 0;
    while (fi < prog.funcs.len()) {
        let f = prog.funcs[fi];
        var ai = 0;
        while (ai < f.annotations.len()) {
            let a = f.annotations[ai];
            if (a.name == "test") {
                if (a.args.len() != 0) {
                    return Result.Err(terr(a.line, a.col, "'@test' takes no arguments"));
                }
                if (f.params.len() != 0) {
                    return Result.Err(
                        terr(
                            a.line,
                            a.col,
                            "the '@test' test function '" + f.name + "' must not take parameters"
                        )
                    );
                }
                let ret = resolve_type(f.ret);
                if (!type_eq(ret, Type.TBool) && !type_eq(ret, Type.TUnit)) {
                    return Result.Err(
                        terr(
                            a.line,
                            a.col,
                            "an '@test' function must return bool or unit, not " + type_str(f.ret)
                        )
                    );
                }
            } else if (a.name == "derive") {
                return Result.Err(
                    terr(a.line, a.col, "'@derive' is only allowed on a struct or enum")
                );
            } else {
                return Result.Err(terr(a.line, a.col, "unknown annotation: '@" + a.name + "'"));
            }
            ai = ai + 1;
        }
        fi = fi + 1;
    }
    var si = 0;
    while (si < prog.structs.len()) {
        check_type_annotations(prog.structs[si].annotations)?;
        si = si + 1;
    }
    var ei = 0;
    while (ei < prog.enums.len()) {
        check_type_annotations(prog.enums[ei].annotations)?;
        ei = ei + 1;
    }
    Result.Ok(0)
}

fn check_type_annotations(annotations: [Annotation]) -> Result<int, TypeError> {
    var i = 0;
    while (i < annotations.len()) {
        let a = annotations[i];
        if (a.name == "derive") {
            // ok: ya validada/generada en generate_derives.
        } else if (a.name == "test") {
            return Result.Err(terr(a.line, a.col, "'@test' is only allowed on functions"));
        } else {
            return Result.Err(terr(a.line, a.col, "unknown annotation: '@" + a.name + "'"));
        }
        i = i + 1;
    }
    Result.Ok(0)
}

// Valida el objetivo de un `impl`. M14.3d-2: solo objetivos CONCRETOS (struct/enum no genérico, o
// primitivo). Los impls genéricos (`impl<T> ... for Caja<T>`) y bounds → d-3.
fn ensure_impl_target(
    c: Checker,
    target: Type,
    type_params: [string],
    line: int,
    col: int
) -> Result<int, TypeError> {
    if (is_primitive(target)) {
        if (type_params.len() == 0) {
            return Result.Ok(0);
        }
        return Result.Err(
            terr(
                line,
                col,
                "a primitive type is not generic: it does not take type parameters in the impl"
            )
        );
    }
    match (target) {
        Type.TNamed(n, args) => {
            if (!c.structs.contains_key(n) && !c.enums.contains_key(n)) {
                return Result.Err(
                    terr(line, col, "cannot implement for an unknown type: '" + n + "'")
                );
            }
            let arity = type_arity(c, n);
            if (type_params.len() == 0) {
                if (arity != 0) {
                    return Result.Err(
                        terr(
                            line,
                            col,
                            "'" + n + "' is generic: declare its parameters in the impl, e.g. 'impl<T> ... for " + n + "<T>' (M9.2b)"
                        )
                    );
                }
                Result.Ok(0)
            } else {
                ensure_generic_impl_target(n, args, type_params, arity, line, col)
            }
        },
        _ => Result.Err(
            terr(line, col, "a trait can only be implemented for a struct, enum or primitive")
        ),
    }
}

// Impl genérico (M9.2b): la aridad casa y el objetivo se aplica EXACTAMENTE a los propios parámetros
// de tipo del impl (cada uno un `Var` distinto): `impl<T> ... for Caja<T>`.
fn ensure_generic_impl_target(
    n: string,
    args: [Type],
    type_params: [string],
    arity: int,
    line: int,
    col: int
) -> Result<int, TypeError> {
    if (arity != type_params.len()) {
        return Result.Err(
            terr(
                line,
                col,
                "'" + n + "' expects " + to_string(arity) + " type parameter(s), the impl declares " + to_string(type_params.len())
            )
        );
    }
    var ok = args.len() == type_params.len();
    var seen: [string] = [];
    var i = 0;
    while (ok && i < args.len()) {
        match (args[i]) {
            Type.TNamed(an, aargs) => {
                if (aargs.len() != 0 || !contains_str(type_params, an) || contains_str(seen, an)) {
                    ok = false;
                } else {
                    seen.push(an);
                }
            },
            _ => {
                ok = false;
            },
        }
        i = i + 1;
    }
    if (!ok) {
        return Result.Err(
            terr(
                line,
                col,
                "the generic impl must apply to '" + n + "<" + join_comma(type_params) + ">' (its own distinct type parameters)"
            )
        );
    }
    Result.Ok(0)
}

// Comprueba que la firma de un método de impl coincide con la del trait, tras sustituir `Self` por el
// tipo implementador en ambas.
fn check_method_sig(tm: MethodSig, m: Func, target: Type) -> Result<int, TypeError> {
    if (tm.params.len() != m.params.len()) {
        return Result.Err(
            terr(
                m.line,
                m.col,
                "the method '" + m.name + "' takes " + to_string(m.params.len()) + " parameter(s) (including self), but the trait requires " + to_string(tm.params.len())
            )
        );
    }
    var i = 0;
    while (i < tm.params.len()) {
        let want = resolve_type(subst_self(tm.params[i].ty, target));
        let got = resolve_type(subst_self(m.params[i].ty, target));
        if (!type_eq(
            want,
            got
        )) {
            return Result.Err(
                terr(
                    m.params[i].line,
                    m.params[i].col,
                    "the parameter " + to_string(i + 1) + " of method '" + m.name + "' is " + type_str(got) + ", but the trait requires " + type_str(want)
                )
            );
        }
        i = i + 1;
    }
    let want_ret = resolve_type(subst_self(tm.ret, target));
    let got_ret = resolve_type(subst_self(m.ret, target));
    if (!type_eq(
        want_ret,
        got_ret
    )) {
        return Result.Err(
            terr(
                m.line,
                m.col,
                "the method '" + m.name + "' returns " + type_str(got_ret) + ", but the trait requires " + type_str(want_ret)
            )
        );
    }
    Result.Ok(0)
}

// Verifica los cuerpos de los métodos de cada impl (los provistos + los defectos heredados), cada uno
// como una función con `self` de tipo concreto. Va tras verificar las funciones (la tabla de métodos
// ya está completa: un método puede llamar a otro).
fn check_impl_bodies(c: Checker, prog: Program) -> Result<int, TypeError> {
    var ii = 0;
    while (ii < prog.impls.len()) {
        let imp = prog.impls[ii];
        // Para un impl genérico, sus parámetros de tipo y bounds entran en ámbito (el cuerpo del método
        // usa `T`, p. ej. `self.contenido.medir()` con `T: Medir`).
        c.tparams = imp.type_params;
        c.bounds = imp.bounds;
        let target = resolve_type(imp.target);
        let key = type_key_str(target);
        var mi = 0;
        while (mi < imp.methods.len()) {
            let m = imp.methods[mi];
            check_method_body(
                c,
                m.params,
                m.ret,
                m.body,
                m.line,
                m.col,
                mangle(key, m.name),
                target
            )?;
            mi = mi + 1;
        }
        // Defectos heredados: se verifican con `self` del tipo concreto.
        let trait_methods: [MethodSig] = match (get(c.traits, imp.trait_name)) {
            Option.Some(ms) => ms,
            Option.None => [],
        };
        var tj = 0;
        while (tj < trait_methods.len()) {
            let tm = trait_methods[tj];
            if (has_default(tm) && !impl_overrides(imp, tm.name)) {
                match (tm.default_body) {
                    Option.Some(body) => {
                        check_method_body(
                            c,
                            tm.params,
                            tm.ret,
                            body,
                            tm.line,
                            tm.col,
                            mangle(key, tm.name),
                            target
                        )?;
                    },
                    Option.None => { },
                }
            }
            tj = tj + 1;
        }
        c.tparams = no_tparams();
        c.bounds = no_bounds();
        ii = ii + 1;
    }
    Result.Ok(0)
}

// Verifica el cuerpo de un método: sus parámetros (self incluido) con Self→target, y el bloque contra
// el retorno (Self→target). `label` es el nombre manglado (aparece en un posible error de retorno).
fn check_method_body(
    c: Checker,
    params: [Param],
    ret: Type,
    body: Block,
    line: int,
    col: int,
    label: string,
    target: Type
) -> Result<int, TypeError> {
    var sp: [Param] = [];
    var i = 0;
    while (i < params.len()) {
        let p = params[i];
        sp.push(Param { name: p.name, ty: subst_self(p.ty, target), line: p.line, col: p.col });
        i = i + 1;
    }
    check_fn_body(c, sp, subst_self(ret, target), body, line, col, "'" + label + "'")
}

// Punto de entrada: valida un programa (o devuelve el primer TypeError).
pub fn check(prog: Program) -> Result<int, TypeError> {
    let c = Checker {
        funcs: Map.new(),
        structs: Map.new(),
        enums: Map.new(),
        struct_tparams: Map.new(),
        enum_tparams: Map.new(),
        traits: Map.new(),
        methods: Map.new(),
        impl_traits: Map.new(),
        scopes: [],
        current_return: Type.TUnit,
        tparams: [],
        bounds: []
    };
    check_program(c, prog)
}

// Una lista de bounds vacía, ya tipada (para reiniciar `c.bounds`; como `no_tparams`).
fn no_bounds() -> [Bound] { [] }
