            )
        ),
    }
}

// get(m, k) -> Option<V> (envoltorio del prelude en Rust; aquí builtin directo, mismo tipo).
fn check_get(c: Checker, cargs: [Expr], line: int, col: int) -> Result<Type, TypeError> {
    b_arity("get", 2, " (map, key)", cargs.len(), line, col)?;
    let a = check_args_types(c, cargs)?;
    match (map_kv(
    a[0]
)) {
        Option.Some(kv) => {
            if (!type_eq(a[1], kv[0])) {
                return Result.Err(
                    terr(
                        cargs[1].line,
                        cargs[1].col,
                        "get: the Map key is " + type_str(kv[0]) + " but got " + type_str(a[1])
                    )
                );
            }
            Result.Ok(Type.TNamed("Option", [kv[1]]))
        },
        Option.None => Result.Err(
            terr(
                cargs[0].line,
                cargs[0].col,
                "get expects a Map as first argument, not " + type_str(a[0])
            )
        ),
    }
}

