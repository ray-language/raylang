// El checker (validador de tipos) de raylang, escrito EN raylang (self-hosting, M14.3).
//
// Tercera fase del bootstrap: AST (del parser auto-alojado) → veredicto. Es un VALIDADOR: produce
// `ok` o un `TypeError` (mensaje + posición) byte-idéntico al checker de Rust (`src/checker.rs`). NO
// reproduce el lowering de M9 (UFCS/diccionarios/dyn/mangling), que queda para el back-end. Se valida
// contra el checker de Rust como ORÁCULO (ver `tests/selfhost_checker.rs`): misma fuente por ambos
// pipelines, mismo veredicto.
//
// M14.3a: NÚCLEO MONOMÓRFICO. Dos pasadas (firmas → cuerpos), pila de ámbitos, literales,
// operadores, variables (let/var, mutabilidad, ámbito), llamadas (aridad + tipos), if/while/block/
// return, anotaciones de tipo, divergencia, builtin print. Cubre fib/fizzbuzz.
//
// M14.3b (esta versión): DATOS (monomórficos). Arreglos (`[T]`, literal, índice, `len`/`push`),
// structs (definición, literal `Nombre { c: v }`, acceso a campo, asignación a campo/índice), enums
// (construcción `Enum.Variante(args)` —reconocida en el sitio, sin reescribir el AST—, `match` con
// patrones + exhaustividad, tipos recursivos). Chequeo bidireccional MÍNIMO: el tipo esperado fija el
// `[]` vacío (`let xs: [int] = []`). Diferido: genéricos (M14.3c), traits/dyn (M14.3d).
//
// El `Type` del parser DOBLA como representación del tipo inferido (un struct y un enum son ambos
// `TNamed(nombre, args)`; se distinguen por en qué tabla —`structs`/`enums`— está el nombre). Los
// ámbitos y las tablas de tipos usan `Map<K,V>`.

from parser import Type, Expr, EKind, Stmt, SKind, Block, Func, Param, Program, BinOp, UnOp, FieldInit, FieldDef, VariantDef, MatchArm, Pattern, PKind, FnExpr, TraitDef, MethodSig, ImplBlock, Bound, Annotation;

// Error de tipos con ubicación (espejo de `TypeError` en Rust).
pub struct TypeError { msg: string, line: int, col: int }

// Información de una variable en un ámbito.
struct VarInfo { ty: Type, mutable: bool, dline: int, dcol: int }

// Firma de una función. `type_params` son sus parámetros de tipo (M14.3c); `bounds` los acota (M14.3d:
// `T: Trait`), comprobados en cada sitio de llamada (satisfacción del bound).
struct FnSig { params: [Type], ret: Type, type_params: [string], bounds: [Bound] }

// Una variable ligada por un patrón de `match`: su nombre y el tipo que recibe.
struct Bind { name: string, ty: Type }

// Estado mutable de la comprobación de un `match`: variantes ya cubiertas y si hay catch-all.
struct MatchState { covered: [string], catchall: bool }

// El estado del checker: firmas de funciones, tablas de tipos nominales (structs/enums, con los
// campos/variantes ya resueltos, y sus parámetros de tipo para la aridad/sustitución), pila de
// ámbitos, el retorno de la función en curso y los parámetros de tipo en ámbito (M14.3c: los `T`
// rígidos de la función/método actual; un `TNamed(T, [])` con `T` aquí es un tipo válido, no
// desconocido).
struct Checker {
    funcs: Map<string, FnSig>,
    structs: Map<string, [FieldDef]>,
    enums: Map<string, [VariantDef]>,
    struct_tparams: Map<string, [string]>,
    enum_tparams: Map<string, [string]>,
    traits: Map<string, [MethodSig]>,
    methods: Map<string, FnSig>,
    impl_traits: Map<string, bool>,
    scopes: [Map<string, VarInfo>],
    current_return: Type,
    tparams: [string],
    bounds: [Bound],
}

fn terr(line: int, col: int, msg: string) -> TypeError {
    TypeError { msg: msg, line: line, col: col }
}

// =====================================================================
// Tipos: igualdad, presentación (Display), predicados
// =====================================================================

// Igualdad estructural de tipos (raylang no deriva == sobre enums recursivos).
fn type_eq(a: Type, b: Type) -> bool {
    match (a) {
        Type.TInt => match (b) { Type.TInt => true, _ => false },
        Type.TFloat => match (b) { Type.TFloat => true, _ => false },
        Type.TBool => match (b) { Type.TBool => true, _ => false },
        Type.TString => match (b) { Type.TString => true, _ => false },
        Type.TChar => match (b) { Type.TChar => true, _ => false },
        Type.TUnit => match (b) { Type.TUnit => true, _ => false },
        Type.TArray(ea) => match (b) { Type.TArray(eb) => type_eq(ea, eb), _ => false },
        Type.TFn(pa, ra) => match (b) {
            Type.TFn(pb, rb) => types_eq(pa, pb) && type_eq(ra, rb),
            _ => false,
        },
        Type.TNamed(na, aa) => match (b) {
            Type.TNamed(nb, ab) => na == nb && types_eq(aa, ab),
            _ => false,
        },
        Type.TDyn(ta) => match (b) {
            Type.TDyn(tb) => strs_eq(ta, tb),
            _ => false,
        },
    }
}

fn types_eq(a: [Type], b: [Type]) -> bool {
    if (len(a) != len(b)) { return false; }
    var i = 0;
    while (i < len(a)) {
        if (!type_eq(a[i], b[i])) { return false; }
        i = i + 1;
    }
    true
}

fn strs_eq(a: [string], b: [string]) -> bool {
    if (len(a) != len(b)) { return false; }
    var i = 0;
    while (i < len(a)) {
        if (a[i] != b[i]) { return false; }
        i = i + 1;
    }
    true
}

// Presentación de un tipo, idéntica al `Display` de `Type` en Rust (para los mensajes de error).
fn type_str(t: Type) -> string {
    match (t) {
        Type.TInt => "int",
        Type.TFloat => "float",
        Type.TBool => "bool",
        Type.TString => "string",
        Type.TChar => "char",
        Type.TUnit => "unit",
        Type.TArray(e) => "[" + type_str(e) + "]",
        Type.TFn(ps, r) => "fn(" + join_types(ps) + ") -> " + type_str(r),
        Type.TNamed(n, args) => { if (len(args) == 0) { n } else { n + "<" + join_types(args) + ">" } },
        Type.TDyn(ts) => "dyn " + join_strs(ts),
    }
}

fn join_types(ps: [Type]) -> string {
    var s = "";
    var i = 0;
    while (i < len(ps)) {
        if (i > 0) { s = s + ", "; }
        s = s + type_str(ps[i]);
        i = i + 1;
    }
    s
}

fn join_strs(xs: [string]) -> string {
    var s = "";
    var i = 0;
    while (i < len(xs)) {
        if (i > 0) { s = s + " + "; }
        s = s + xs[i];
        i = i + 1;
    }
    s
}

// ¿`print`/`eprint` saben imprimir este tipo? (primitivos + arreglo + función + struct/enum.)
fn is_printable(t: Type) -> bool {
    match (t) {
        Type.TInt => true,
        Type.TFloat => true,
        Type.TBool => true,
        Type.TString => true,
        Type.TChar => true,
        Type.TArray(_) => true,
        Type.TFn(_, _) => true,
        Type.TNamed(_, _) => true,
        _ => false,
    }
}

// ¿Es comparable con ==/!=? (int/float/bool/string/char, o arreglo de comparables.)
fn is_comparable(t: Type) -> bool {
    match (t) {
        Type.TInt => true,
        Type.TFloat => true,
        Type.TBool => true,
        Type.TString => true,
        Type.TChar => true,
        Type.TArray(e) => is_comparable(e),
        _ => false,
    }
}

fn is_array(t: Type) -> bool {
    match (t) { Type.TArray(_) => true, _ => false }
}

// ¿Operandos válidos para los comparadores de orden (< <= > >=)? Mismo tipo, y de int/float/string/char.
fn order_ok(lt: Type, rt: Type) -> bool {
    type_eq(lt, rt) && (type_eq(lt, Type.TInt) || type_eq(lt, Type.TFloat)
        || type_eq(lt, Type.TString) || type_eq(lt, Type.TChar))
}

// Clase de un operador binario: 0=aritmético, 1=orden, 2=igualdad, 3=lógico.
fn op_kind(op: BinOp) -> int {
    match (op) {
        BinOp.Add => 0, BinOp.Sub => 0, BinOp.Mul => 0, BinOp.Div => 0, BinOp.Rem => 0,
        BinOp.Lt => 1, BinOp.Le => 1, BinOp.Gt => 1, BinOp.Ge => 1,
        BinOp.Eq => 2, BinOp.Ne => 2,
        BinOp.And => 3, BinOp.Or => 3,
    }
}

fn is_add(op: BinOp) -> bool {
    match (op) { BinOp.Add => true, _ => false }
}

fn bin_op_str(op: BinOp) -> string {
    match (op) {
        BinOp.Add => "+", BinOp.Sub => "-", BinOp.Mul => "*", BinOp.Div => "/", BinOp.Rem => "%",
        BinOp.Eq => "==", BinOp.Ne => "!=", BinOp.Lt => "<", BinOp.Le => "<=", BinOp.Gt => ">", BinOp.Ge => ">=",
        BinOp.And => "&&", BinOp.Or => "||",
    }
}

// =====================================================================
// Resolución y validación de tipos (M14.3a: monomórfico)
// =====================================================================

// Normaliza un tipo de anotación. Monomórfico: no reclasifica nombres (struct y enum comparten
// `TNamed`); solo recorre arreglos/funciones/args para resolver recursivamente. (En Rust aquí se
// reclasifica `Struct`→`Enum`/`Var`; aquí ese trabajo no existe porque el `Type` es unificado.)
fn resolve_type(t: Type) -> Type {
    match (t) {
        Type.TArray(e) => Type.TArray(resolve_type(e)),
        Type.TFn(ps, r) => {
            var rps: [Type] = [];
            var i = 0;
            while (i < len(ps)) { push(rps, resolve_type(ps[i])); i = i + 1; }
            Type.TFn(rps, resolve_type(r))
        },
        Type.TNamed(n, args) => {
            var ra: [Type] = [];
            var i = 0;
            while (i < len(args)) { push(ra, resolve_type(args[i])); i = i + 1; }
            Type.TNamed(n, ra)
        },
        _ => t,
    }
}

// Verifica que un tipo es válido. Un `TNamed` debe nombrar un struct o un enum registrado (M14.3b);
// si no, es un tipo desconocido (mismo mensaje que Rust). Genéricos (aridad de args, params de tipo)
// y `dyn` quedan diferidos a M14.3c/d.
fn ensure_type(c: Checker, t: Type, line: int, col: int) -> Result<int, TypeError> {
    match (t) {
        Type.TArray(e) => ensure_type(c, e, line, col),
        Type.TFn(ps, r) => {
            var i = 0;
            while (i < len(ps)) { ensure_type(c, ps[i], line, col)?; i = i + 1; }
            ensure_type(c, r, line, col)
        },
        Type.TNamed(name, args) => {
            // `Map<K, V>` (M14.6b): la clave debe ser hashable (int/string/char/bool o un parámetro de
            // tipo); aridad 2. No es un struct/enum registrado → se trata aparte.
            if (name == "Map") {
                if (len(args) != 2) {
                    return Result.Err(terr(line, col, "Map espera 2 argumentos de tipo (clave y valor), no " + to_string(len(args))));
                }
                if (!is_hashable_key(c, args[0])) {
                    return Result.Err(terr(line, col, "la clave de un Map debe ser int/string/char/bool, no " + type_str(args[0])));
                }
                ensure_type(c, args[0], line, col)?;
                return ensure_type(c, args[1], line, col);
            }
            // Un parámetro de tipo en ámbito (M14.3c) es un tipo válido; no recibe argumentos.
            if (contains_str(c.tparams, name)) {
                if (len(args) != 0) {
                    return Result.Err(terr(line, col, "el parámetro de tipo '" + name + "' no recibe argumentos"));
                }
                return Result.Ok(0);
            }
            // Un struct/enum: la aridad de argumentos de tipo debe casar con sus parámetros.
            if (contains_key(c.structs, name) || contains_key(c.enums, name)) {
                let arity = type_arity(c, name);
                if (len(args) != arity) {
                    return Result.Err(terr(line, col, "'" + name + "' espera " + to_string(arity)
                        + " argumento(s) de tipo, se le dieron " + to_string(len(args))));
                }
                var i = 0;
                while (i < len(args)) { ensure_type(c, args[i], line, col)?; i = i + 1; }
                Result.Ok(0)
            } else {
                Result.Err(terr(line, col, "tipo desconocido: '" + name + "' no declarado"))
            }
        },
        Type.TDyn(traits) => {
            // Cada trait del conjunto debe existir, y ningún método puede repetirse entre ellos (no
            // se sabría a cuál despachar). Los traits deben estar registrados (M14.3d-4: `ensure_type`
            // de un `dyn` se llama al verificar cuerpos, cuando `c.traits` ya está poblado).
            var seen: [string] = [];
            var i = 0;
            while (i < len(traits)) {
                let tr = traits[i];
                match (get(c.traits, tr)) {
                    Option.None => { return Result.Err(terr(line, col, "trait '" + tr + "' no declarado (en 'dyn " + join_strs(traits) + "')")); },
                    Option.Some(ms) => {
                        var mi = 0;
                        while (mi < len(ms)) {
                            if (contains_str(seen, ms[mi].name)) {
                                return Result.Err(terr(line, col, "el método '" + ms[mi].name + "' aparece en más de un trait de 'dyn " + join_strs(traits) + "': es ambiguo"));
                            }
                            push(seen, ms[mi].name);
                            mi = mi + 1;
                        }
                    },
                }
                i = i + 1;
            }
            Result.Ok(0)
        },
        _ => Result.Ok(0),
    }
}

// La aridad (nº de parámetros de tipo) de un struct/enum registrado.
fn type_arity(c: Checker, name: string) -> int {
    match (get(c.struct_tparams, name)) {
        Option.Some(tps) => len(tps),
        Option.None => match (get(c.enum_tparams, name)) {
            Option.Some(tps) => len(tps),
            Option.None => 0,
        },
    }
}

// ¿`name` nombra un enum registrado? (Distingue construcción de enum de acceso a campo.)
fn is_enum(c: Checker, name: string) -> bool { contains_key(c.enums, name) }

// ¿`t` puede ser la clave de un Map? (int/string/char/bool o un parámetro de tipo en ámbito.)
fn is_hashable_key(c: Checker, t: Type) -> bool {
    match (t) {
        Type.TInt => true,
        Type.TString => true,
        Type.TChar => true,
        Type.TBool => true,
        Type.TNamed(n, args) => len(args) == 0 && contains_str(c.tparams, n),
        _ => false,
    }
}

// ¿`t` es un `Map<K, V>`? Devuelve `Some([K, V])` o `None`.
fn map_kv(t: Type) -> Option<[Type]> {
    match (t) {
        Type.TNamed(n, margs) => { if (n == "Map" && len(margs) == 2) { Option.Some(margs) } else { Option.None } },
        _ => Option.None,
    }
}

fn is_map(t: Type) -> bool {
    match (map_kv(t)) { Option.Some(_) => true, Option.None => false }
}

// Un arreglo de strings vacío, ya tipado (para reiniciar `c.tparams`: asignar `[]` directamente a un
// campo no infiere el tipo, pero el retorno de esta función sí lo fija).
fn no_tparams() -> [string] { [] }

// ¿`xs` contiene la cadena `s`?
fn contains_str(xs: [string], s: string) -> bool {
    var i = 0;
    while (i < len(xs)) {
        if (xs[i] == s) { return true; }
        i = i + 1;
    }
    false
}

// Une cadenas con ", " (para la lista de variantes faltantes de un match no exhaustivo).
fn join_comma(xs: [string]) -> string {
    var s = "";
    var i = 0;
    while (i < len(xs)) {
        if (i > 0) { s = s + ", "; }
        s = s + xs[i];
        i = i + 1;
    }
    s
}

// =====================================================================
// Genéricos: unificación y sustitución (M14.3c)
// =====================================================================

// **Sustitución**: reemplaza cada variable de tipo `TNamed(n, [])` con `n` en `sigma` por `sigma[n]`,
// recursivamente. Instancia un tipo genérico una vez inferidos sus parámetros (`subst([U], {U↦int})
// = [int]`). `sigma` solo contiene los nombres-incógnita, así que un nombre nominal (struct/enum
// monomórfico) nunca se sustituye.
fn subst(ty: Type, sigma: Map<string, Type>) -> Type {
    match (ty) {
        Type.TNamed(n, args) => {
            if (len(args) == 0) {
                match (get(sigma, n)) { Option.Some(t) => t, Option.None => ty }
            } else {
                var ra: [Type] = [];
                var i = 0;
                while (i < len(args)) { push(ra, subst(args[i], sigma)); i = i + 1; }
                Type.TNamed(n, ra)
            }
        },
        Type.TArray(e) => Type.TArray(subst(e, sigma)),
        Type.TFn(ps, r) => {
            var rps: [Type] = [];
            var i = 0;
            while (i < len(ps)) { push(rps, subst(ps[i], sigma)); i = i + 1; }
            Type.TFn(rps, subst(r, sigma))
        },
        _ => ty,
    }
}

// **Unificación**, asimétrica: `param` viene de la firma de la función llamada (sus variables de tipo
// —las que están en `holes`— son las INCÓGNITAS a inferir); `arg` viene del llamador (sus variables,
// si las hay, son rígidas). Liga las incógnitas en `sigma` y exige consistencia; un desacuerdo es un
// error con su razón (texto idéntico al de Rust).
fn unify(param: Type, arg: Type, sigma: Map<string, Type>, holes: [string]) -> Result<int, string> {
    match (param) {
        Type.TNamed(n, pargs) => {
            // Incógnita del lado de la firma: ligarla (o exigir que coincida con lo ya ligado).
            if (len(pargs) == 0 && contains_str(holes, n)) {
                match (get(sigma, n)) {
                    Option.Some(prev) => {
                        if (!type_eq(prev, arg)) {
                            Result.Err("'" + n + "' no puede ser " + type_str(prev) + " y " + type_str(arg) + " a la vez")
                        } else { Result.Ok(0) }
                    },
                    Option.None => { insert(sigma, n, arg); Result.Ok(0) },
                }
            } else {
                // Tipo nominal (o variable rígida): mismo nombre, misma aridad, unificar argumentos.
                match (arg) {
                    Type.TNamed(an, aargs) => {
                        if (n == an && len(pargs) == len(aargs)) {
                            unify_list(pargs, aargs, sigma, holes)
                        } else {
                            Result.Err("se esperaba " + type_str(param) + ", se pasó " + type_str(arg))
                        }
                    },
                    _ => Result.Err("se esperaba " + type_str(param) + ", se pasó " + type_str(arg)),
                }
            }
        },
        Type.TArray(pe) => {
            match (arg) {
                Type.TArray(ae) => unify(pe, ae, sigma, holes),
                _ => Result.Err("se esperaba " + type_str(param) + ", se pasó " + type_str(arg)),
            }
        },
        Type.TFn(pps, pr) => {
            match (arg) {
                Type.TFn(aps, ar) => {
                    if (len(pps) != len(aps)) {
                        Result.Err("se esperaba " + type_str(param) + ", se pasó " + type_str(arg))
                    } else {
                        unify_list(pps, aps, sigma, holes)?;
                        unify(pr, ar, sigma, holes)
                    }
                },
                _ => Result.Err("se esperaba " + type_str(param) + ", se pasó " + type_str(arg)),
            }
        },
        // Primitivos (y variable rígida vs lo que sea): igualdad exacta.
        _ => {
            if (type_eq(param, arg)) { Result.Ok(0) }
            else { Result.Err("se esperaba " + type_str(param) + ", se pasó " + type_str(arg)) }
        },
    }
}

// Unifica dos listas de tipos posición a posición (propaga la primera razón de fallo).
fn unify_list(ps: [Type], bs: [Type], sigma: Map<string, Type>, holes: [string]) -> Result<int, string> {
    var i = 0;
    while (i < len(ps)) {
        unify(ps[i], bs[i], sigma, holes)?;
        i = i + 1;
    }
    Result.Ok(0)
}

// =====================================================================
// Pila de ámbitos
// =====================================================================

fn new_scope() -> Map<string, VarInfo> { map_new() }

fn push_scope(c: Checker) { push(c.scopes, new_scope()); }

fn pop_scope(c: Checker) {
    let removed = pop(c.scopes);
}

fn declare(c: Checker, name: string, ty: Type, mutable: bool, line: int, col: int) {
    let top = c.scopes[len(c.scopes) - 1];
    insert(top, name, VarInfo { ty: ty, mutable: mutable, dline: line, dcol: col });
}

// Busca una variable de adentro hacia afuera. `None` si no está en ningún ámbito.
fn lookup(c: Checker, name: string) -> Option<VarInfo> {
    var i = len(c.scopes) - 1;
    while (i >= 0) {
        match (get(c.scopes[i], name)) {
            Option.Some(v) => { return Option.Some(v); },
            Option.None => {},
        }
        i = i - 1;
    }
    Option.None
}

// =====================================================================
// Análisis de divergencia (¿todos los caminos retornan/abortan?)
// =====================================================================

fn block_diverges(b: Block) -> bool {
    var i = 0;
    while (i < len(b.stmts)) {
        if (stmt_diverges(b.stmts[i])) { return true; }
        i = i + 1;
    }
    match (b.tail) {
        Option.Some(t) => expr_diverges(t),
        Option.None => false,
    }
}

fn stmt_diverges(s: Stmt) -> bool {
    match (s.kind) {
        SKind.SReturn(_) => true,
        SKind.SExpr(e) => expr_diverges(e),
        _ => false,
    }
}

fn expr_diverges(e: Expr) -> bool {
    match (e.kind) {
        EKind.EIf(_, then_b, elseopt) => {
            match (elseopt) {
                Option.Some(els) => block_diverges(then_b) && expr_diverges(els),
                Option.None => false,
            }
        },
        EKind.EBlock(b) => block_diverges(b),
        EKind.EMatch(_, arms) => {
            if (len(arms) == 0) { return false; }
            var i = 0;
            while (i < len(arms)) {
                if (!expr_diverges(arms[i].body)) { return false; }
                i = i + 1;
            }
            true
        },
        // panic(...) nunca retorna.
        EKind.ECall(callee, _) => {
            match (callee.kind) {
                EKind.EIdent(n) => n == "panic",
                _ => false,
            }
        },
        _ => false,
    }
}

// =====================================================================
// Las dos pasadas
// =====================================================================

// Inyecta el prelude que necesita M14.3c-3: `Option<T>` y `Result<T, E>` como enums genéricos. En
// Rust el prelude se parsea de un fuente raylang compartido; aquí el checker es un VALIDADOR que solo
// recibe el AST, así que se registran sus definiciones directamente (mismo efecto para el veredicto).
// Si el usuario declara un tipo con ese nombre, su definición gana (no se inyecta) — como el override
// del prelude en Rust. (Eq/Show/Ord y map/filter/fold → M14.3d / fase posterior.)
fn inject_prelude(c: Checker, prog: Program) {
    if (!user_declares_type(prog, "Option")) {
        var ov: [VariantDef] = [];
        push(ov, VariantDef { name: "Some", payload: [Type.TNamed("T", [])], line: 0, col: 0 });
        push(ov, VariantDef { name: "None", payload: [], line: 0, col: 0 });
        insert(c.enums, "Option", ov);
        insert(c.enum_tparams, "Option", ["T"]);
    }
    if (!user_declares_type(prog, "Result")) {
        var rv: [VariantDef] = [];
        push(rv, VariantDef { name: "Ok", payload: [Type.TNamed("T", [])], line: 0, col: 0 });
        push(rv, VariantDef { name: "Err", payload: [Type.TNamed("E", [])], line: 0, col: 0 });
        insert(c.enums, "Result", rv);
        insert(c.enum_tparams, "Result", ["T", "E"]);
    }
    inject_prelude_fns(c, prog);
    inject_prelude_traits(c, prog);
}

// Inyecta los traits del prelude (Eq/Show/Ord) y sus impls para primitivos (M14.3d-4c). En Rust se
// parsean del prelude; el validador registra sus firmas + la tabla de métodos. Solo si el usuario no
// redefine el trait (override).
fn inject_prelude_traits(c: Checker, prog: Program) {
    if (!user_declares_trait(prog, "Eq")) {
        insert(c.traits, "Eq", [eq_sig()]);
        inject_prim_eq(c, Type.TInt, "int");
        inject_prim_eq(c, Type.TFloat, "float");
        inject_prim_eq(c, Type.TString, "string");
        inject_prim_eq(c, Type.TBool, "bool");
        inject_prim_eq(c, Type.TChar, "char");
    }
    if (!user_declares_trait(prog, "Show")) {
        insert(c.traits, "Show", [show_sig()]);
        inject_prim_show(c, Type.TInt, "int");
        inject_prim_show(c, Type.TFloat, "float");
        inject_prim_show(c, Type.TString, "string");
        inject_prim_show(c, Type.TBool, "bool");
        inject_prim_show(c, Type.TChar, "char");
    }
    if (!user_declares_trait(prog, "Ord")) {
        insert(c.traits, "Ord", [ord_sig()]);
        inject_prim_ord(c, Type.TInt, "int");
        inject_prim_ord(c, Type.TFloat, "float");
        inject_prim_ord(c, Type.TString, "string");
        inject_prim_ord(c, Type.TChar, "char");
    }
}

fn self_param() -> Param { Param { name: "self", ty: Type.TNamed("Self", []), line: 0, col: 0 } }
fn otro_param() -> Param { Param { name: "otro", ty: Type.TNamed("Self", []), line: 0, col: 0 } }
fn eq_sig() -> MethodSig { MethodSig { name: "igual", params: [self_param(), otro_param()], ret: Type.TBool, default_body: Option.None, line: 0, col: 0 } }
fn show_sig() -> MethodSig { MethodSig { name: "mostrar", params: [self_param()], ret: Type.TString, default_body: Option.None, line: 0, col: 0 } }
fn ord_sig() -> MethodSig { MethodSig { name: "menor", params: [self_param(), otro_param()], ret: Type.TBool, default_body: Option.None, line: 0, col: 0 } }

// Registra un método de impl del prelude (FnSig monomórfica) + la marca en `impl_traits`.
fn inject_method_impl(c: Checker, key: string, trait_name: string, method: string, params: [Type], ret: Type) {
    insert(c.methods, mangle(key, method), FnSig { params: params, ret: ret, type_params: no_tparams(), bounds: no_bounds() });
    insert(c.impl_traits, mangle(key, trait_name), true);
}
fn inject_prim_eq(c: Checker, ty: Type, key: string) { inject_method_impl(c, key, "Eq", "igual", [ty, ty], Type.TBool); }
fn inject_prim_show(c: Checker, ty: Type, key: string) { inject_method_impl(c, key, "Show", "mostrar", [ty], Type.TString); }
fn inject_prim_ord(c: Checker, ty: Type, key: string) { inject_method_impl(c, key, "Ord", "menor", [ty, ty], Type.TBool); }

// ¿El usuario declara un trait con ese nombre?
fn user_declares_trait(prog: Program, name: string) -> bool {
    var i = 0;
    while (i < len(prog.traits)) {
        if (prog.traits[i].name == name) { return true; }
        i = i + 1;
    }
    false
}

// Inyecta las funciones genéricas de orden superior del prelude (M7.3): map/filter/fold. En Rust
// están escritas en raylang y se parsean; aquí (validador) se registran sus FIRMAS (lo que basta para
// resolver llamadas). Solo si el usuario no las redefine.
fn inject_prelude_fns(c: Checker, prog: Program) {
    let t = Type.TNamed("T", []);
    let u = Type.TNamed("U", []);
    let a = Type.TNamed("A", []);
    // map<T, U>(xs: [T], f: fn(T) -> U) -> [U]
    inject_fn(c, prog, "map", FnSig {
        params: [Type.TArray(t), Type.TFn([t], u)], ret: Type.TArray(u), type_params: ["T", "U"], bounds: no_bounds(),
    });
    // filter<T>(xs: [T], pred: fn(T) -> bool) -> [T]
    inject_fn(c, prog, "filter", FnSig {
        params: [Type.TArray(t), Type.TFn([t], Type.TBool)], ret: Type.TArray(t), type_params: ["T"], bounds: no_bounds(),
    });
    // fold<T, A>(xs: [T], init: A, f: fn(A, T) -> A) -> A
    inject_fn(c, prog, "fold", FnSig {
        params: [Type.TArray(t), a, Type.TFn([a, t], a)], ret: a, type_params: ["T", "A"], bounds: no_bounds(),
    });
    // parse_int(s: string) -> Option<int> / parse_float(s: string) -> Option<float> (M14.6c).
    inject_fn(c, prog, "parse_int", FnSig {
        params: [Type.TString], ret: Type.TNamed("Option", [Type.TInt]), type_params: no_tparams(), bounds: no_bounds(),
    });
    inject_fn(c, prog, "parse_float", FnSig {
        params: [Type.TString], ret: Type.TNamed("Option", [Type.TFloat]), type_params: no_tparams(), bounds: no_bounds(),
    });
    // assert(cond: bool) (M14.6c-2). assert_eq<T: Eq + Show>(a: T, b: T). sort<T: Ord>(a: [T]) -> [T].
    inject_fn(c, prog, "assert", FnSig {
        params: [Type.TBool], ret: Type.TUnit, type_params: no_tparams(), bounds: no_bounds(),
    });
    inject_fn(c, prog, "assert_eq", FnSig {
        params: [t, t], ret: Type.TUnit, type_params: ["T"],
        bounds: [Bound { param: "T", trait_name: "Eq" }, Bound { param: "T", trait_name: "Show" }],
    });
    inject_fn(c, prog, "sort", FnSig {
        params: [Type.TArray(t)], ret: Type.TArray(t), type_params: ["T"],
        bounds: [Bound { param: "T", trait_name: "Ord" }],
    });
    // I/O de archivos (M14.6d): read_file(ruta) -> Result<string,string>,
    // write_file(ruta, contenido) -> Result<int,string>. (exists es builtin directo -> bool.)
    inject_fn(c, prog, "read_file", FnSig {
        params: [Type.TString], ret: Type.TNamed("Result", [Type.TString, Type.TString]), type_params: no_tparams(), bounds: no_bounds(),
    });
    inject_fn(c, prog, "write_file", FnSig {
        params: [Type.TString, Type.TString], ret: Type.TNamed("Result", [Type.TInt, Type.TString]), type_params: no_tparams(), bounds: no_bounds(),
    });
}

// Registra una función del prelude (su firma) si el usuario no la define con ese nombre.
fn inject_fn(c: Checker, prog: Program, name: string, sig: FnSig) {
    if (!user_declares_fn(prog, name)) { insert(c.funcs, name, sig); }
}

// ¿El usuario declara una función con ese nombre?
fn user_declares_fn(prog: Program, name: string) -> bool {
    var i = 0;
    while (i < len(prog.funcs)) {
        if (prog.funcs[i].name == name) { return true; }
        i = i + 1;
    }
    false
}

// ¿El usuario declara un struct/enum con ese nombre? (Para no pisar su definición con la del prelude.)
fn user_declares_type(prog: Program, name: string) -> bool {
    var i = 0;
    while (i < len(prog.enums)) { if (prog.enums[i].name == name) { return true; } i = i + 1; }
    var j = 0;
    while (j < len(prog.structs)) { if (prog.structs[j].name == name) { return true; } j = j + 1; }
    false
}

// Registra los tipos nominales (structs/enums) con sus campos/variantes resueltos, y valida que los
// tipos referenciados existan. Va ANTES de las firmas/cuerpos (que pueden nombrar estos tipos). Mismo
// orden y mensajes que `check_program` en Rust: nombres de enum (duplicados) → structs (no pueden
// reusar un nombre de enum, ni repetirse) → validar los tipos referenciados (todos ya registrados).
fn register_types(c: Checker, prog: Program) -> Result<int, TypeError> {
    // --- Prelude: Option/Result son enums genéricos conocidos (M14.3c-3) ---
    inject_prelude(c, prog);
    // --- Registrar enums (variantes resueltas; duplicados de enum y de variante) ---
    var ei = 0;
    while (ei < len(prog.enums)) {
        let e = prog.enums[ei];
        if (contains_key(c.enums, e.name)) {
            return Result.Err(terr(e.line, e.col, "enum '" + e.name + "' declarado dos veces"));
        }
        var seen: [string] = [];
        var variants: [VariantDef] = [];
        var vi = 0;
        while (vi < len(e.variants)) {
            let v = e.variants[vi];
            if (contains_str(seen, v.name)) {
                return Result.Err(terr(v.line, v.col, "variante '" + v.name + "' repetida en el enum '" + e.name + "'"));
            }
            push(seen, v.name);
            var rp: [Type] = [];
            var pi = 0;
            while (pi < len(v.payload)) { push(rp, resolve_type(v.payload[pi])); pi = pi + 1; }
            push(variants, VariantDef { name: v.name, payload: rp, line: v.line, col: v.col });
            vi = vi + 1;
        }
        insert(c.enums, e.name, variants);
        insert(c.enum_tparams, e.name, e.type_params);
        ei = ei + 1;
    }
    // --- Registrar structs (campos resueltos; no reusar nombre de enum, ni repetirse) ---
    var si = 0;
    while (si < len(prog.structs)) {
        let s = prog.structs[si];
        if (contains_key(c.enums, s.name)) {
            return Result.Err(terr(s.line, s.col, "'" + s.name + "' ya es un enum; no puede ser también un struct"));
        }
        if (contains_key(c.structs, s.name)) {
            return Result.Err(terr(s.line, s.col, "struct '" + s.name + "' declarado dos veces"));
        }
        var rf: [FieldDef] = [];
        var fj = 0;
        while (fj < len(s.fields)) {
            let fd = s.fields[fj];
            push(rf, FieldDef { name: fd.name, ty: resolve_type(fd.ty) });
            fj = fj + 1;
        }
        insert(c.structs, s.name, rf);
        insert(c.struct_tparams, s.name, s.type_params);
        si = si + 1;
    }
    // --- Validar los tipos referenciados (ya están todos registrados), con los parámetros de tipo
    //     de cada definición en ámbito (un payload `Caja<T>` referencia el `T` propio) ---
    var ev = 0;
    while (ev < len(prog.enums)) {
        let e = prog.enums[ev];
        c.tparams = e.type_params;
        let variants = enum_variants(c, e.name);
        var vi = 0;
        while (vi < len(variants)) {
            let payload = variants[vi].payload;
            var pi = 0;
            while (pi < len(payload)) { ensure_type(c, payload[pi], e.line, e.col)?; pi = pi + 1; }
            vi = vi + 1;
        }
        ev = ev + 1;
    }
    var sv = 0;
    while (sv < len(prog.structs)) {
        let s = prog.structs[sv];
        c.tparams = s.type_params;
        let fields = struct_fields(c, s.name);
        var fi = 0;
        while (fi < len(fields)) { ensure_type(c, fields[fi].ty, s.line, s.col)?; fi = fi + 1; }
        sv = sv + 1;
    }
    c.tparams = no_tparams();
    Result.Ok(0)
}

// Las variantes (resueltas) de un enum registrado (lista vacía si no está, no ocurre tras registrar).
fn enum_variants(c: Checker, name: string) -> [VariantDef] {
    match (get(c.enums, name)) { Option.Some(v) => v, Option.None => [] }
}

// Los campos (resueltos) de un struct registrado.
fn struct_fields(c: Checker, name: string) -> [FieldDef] {
    match (get(c.structs, name)) { Option.Some(f) => f, Option.None => [] }
}

// program = registrar tipos → registrar firmas → registrar traits/impls → exigir main → verificar
// cada cuerpo (funciones y métodos de impl).
fn check_program(c: Checker, prog: Program) -> Result<int, TypeError> {
    register_types(c, prog)?;
    var fi = 0;
    while (fi < len(prog.funcs)) {
        let f = prog.funcs[fi];
        if (contains_key(c.funcs, f.name)) {
            return Result.Err(terr(f.line, f.col, "función '" + f.name + "' declarada dos veces"));
        }
        check_unique_tparams(f.type_params, f.name, f.line, f.col)?;
        var ps: [Type] = [];
        var pi = 0;
        while (pi < len(f.params)) { push(ps, resolve_type(f.params[pi].ty)); pi = pi + 1; }
        insert(c.funcs, f.name, FnSig { params: ps, ret: resolve_type(f.ret), type_params: f.type_params, bounds: f.bounds });
        fi = fi + 1;
    }
    register_traits_impls(c, prog)?;
    generate_derives(c, prog)?;
    check_annotations(c, prog)?;
    // 'main' es obligatoria: sin parámetros, retorno int o unit.
    match (get(c.funcs, "main")) {
        Option.None => { return Result.Err(terr(1, 1, "falta la función de entrada 'main'")); },
        Option.Some(sig) => {
            if (len(sig.params) != 0) {
                return Result.Err(terr(1, 1, "'main' no debe recibir parámetros"));
            }
            if (!type_eq(sig.ret, Type.TInt) && !type_eq(sig.ret, Type.TUnit)) {
                return Result.Err(terr(1, 1, "'main' debe devolver int o unit, no " + type_str(sig.ret)));
            }
        },
    }
    var ci = 0;
    while (ci < len(prog.funcs)) {
        check_function(c, prog.funcs[ci])?;
        ci = ci + 1;
    }
    check_impl_bodies(c, prog)?;
    Result.Ok(0)
}

fn check_function(c: Checker, f: Func) -> Result<int, TypeError> {
    // Los parámetros de tipo y bounds de ESTA función entran en ámbito (rígidos): `x: T` es válido y
    // `x.metodo()` se resuelve contra el trait acotado.
    c.tparams = f.type_params;
    c.bounds = f.bounds;
    check_bounds(c, f)?;
    var pi = 0;
    while (pi < len(f.params)) {
        let p = f.params[pi];
        ensure_type(c, p.ty, p.line, p.col)?;
        pi = pi + 1;
    }
    ensure_type(c, f.ret, f.line, f.col)?;
    let r = check_fn_body(c, f.params, f.ret, f.body, f.line, f.col, "'" + f.name + "'");
    c.tparams = no_tparams();
    c.bounds = no_bounds();
    r
}

// Valida los bounds de una función: cada bound acota un parámetro de tipo que la función declara, con
// un trait existente.
fn check_bounds(c: Checker, f: Func) -> Result<int, TypeError> {
    var i = 0;
    while (i < len(f.bounds)) {
        let b = f.bounds[i];
        if (!contains_str(f.type_params, b.param)) {
            return Result.Err(terr(f.line, f.col, "el bound '" + b.param + ": " + b.trait_name + "' no acota a ningún parámetro de tipo de '" + f.name + "'"));
        }
        if (!contains_key(c.traits, b.trait_name)) {
            return Result.Err(terr(f.line, f.col, "trait '" + b.trait_name + "' no declarado (en el bound de '" + f.name + "')"));
        }
        i = i + 1;
    }
    Result.Ok(0)
}

// Comprueba que una lista de parámetros de tipo no tenga repetidos.
fn check_unique_tparams(params: [string], owner: string, line: int, col: int) -> Result<int, TypeError> {
    var i = 0;
    while (i < len(params)) {
        var j = 0;
        while (j < i) {
            if (params[i] == params[j]) {
                return Result.Err(terr(line, col, "parámetro de tipo '" + params[i] + "' repetido en '" + owner + "'"));
            }
            j = j + 1;
        }
        i = i + 1;
    }
    Result.Ok(0)
}

// Verifica el cuerpo: declara los parámetros, comprueba el bloque y exige que su tipo-valor coincida
// con el retorno declarado, salvo que el cuerpo diverja.
fn check_fn_body(c: Checker, params: [Param], ret_ann: Type, body: Block, line: int, col: int, label: string) -> Result<int, TypeError> {
    let ret = resolve_type(ret_ann);
    c.current_return = ret;
    push_scope(c);
    var pi = 0;
    while (pi < len(params)) {
        let p = params[pi];
        declare(c, p.name, resolve_type(p.ty), false, p.line, p.col);
        pi = pi + 1;
    }
    // El retorno declarado es el tipo esperado del valor del cuerpo (propaga a la expr final).
    let body_ty = check_block_expected(c, body, ret)?;
    let diverges = block_diverges(body);
    var eline = line;
    var ecol = col;
    match (body.tail) {
        Option.Some(t) => { eline = t.line; ecol = t.col; },
        Option.None => {},
    }
    pop_scope(c);
    if (type_eq(ret, Type.TUnit)) {
        if (!type_eq(body_ty, Type.TUnit) && !diverges) {
            return Result.Err(terr(eline, ecol, label + " no declara retorno (unit), pero su cuerpo produce " + type_str(body_ty)));
        }
        Result.Ok(0)
    } else if (type_eq(body_ty, ret) || diverges) {
        Result.Ok(0)
    } else {
        Result.Err(terr(eline, ecol, label + " declara devolver " + type_str(ret) + ", pero su cuerpo produce " + type_str(body_ty)))
    }
}

// =====================================================================
// Sentencias
// =====================================================================

fn check_stmt(c: Checker, stmt: Stmt) -> Result<int, TypeError> {
    match (stmt.kind) {
        SKind.SLet(name, tyopt, value, mutable) => {
            match (tyopt) {
                Option.Some(annot) => {
                    ensure_type(c, annot, stmt.line, stmt.col)?;
                    let ty = resolve_type(annot);
                    // El tipo declarado es el esperado del valor (chequeo bidireccional: fija el `[]`).
                    let vt = check_expr_expected(c, value, ty)?;
                    if (!type_eq(vt, ty)) {
                        return Result.Err(terr(value.line, value.col,
                            "'" + name + "' se declara como " + type_str(ty) + " pero se inicializa con " + type_str(vt)));
                    }
                    declare(c, name, ty, mutable, stmt.line, stmt.col);
                },
                Option.None => {
                    let vt = check_expr(c, value)?;
                    declare(c, name, vt, mutable, stmt.line, stmt.col);
                },
            }
            Result.Ok(0)
        },
        SKind.SAssign(target, value) => check_assign(c, target, value, stmt.line, stmt.col),
        SKind.SReturn(valopt) => {
            var vt = Type.TUnit;
            match (valopt) {
                Option.Some(e) => { vt = check_expr_expected(c, e, c.current_return)?; },
                Option.None => {},
            }
            if (!type_eq(vt, c.current_return)) {
                return Result.Err(terr(stmt.line, stmt.col,
                    "se devuelve " + type_str(vt) + " pero la función declara retorno " + type_str(c.current_return)));
            }
            Result.Ok(0)
        },
        SKind.SExpr(e) => { check_expr(c, e)?; Result.Ok(0) },
    }
}

// Asignación. A una variable exige 'var'; mutar el contenido de un arreglo (`a[i] = e`) o un campo
// (`p.x = e`) NO requiere 'var' (DESIGN §12.3: `let` ata la variable, no congela el objeto).
fn check_assign(c: Checker, target: Expr, value: Expr, line: int, col: int) -> Result<int, TypeError> {
    match (target.kind) {
        EKind.EIdent(name) => {
            match (lookup(c, name)) {
                Option.None => Result.Err(terr(target.line, target.col, "variable '" + name + "' no declarada")),
                Option.Some(v) => {
                    if (!v.mutable) {
                        return Result.Err(terr(line, col,
                            "no se puede asignar a '" + name + "': es inmutable (declarada con 'let'; usa 'var')"));
                    }
                    let vt = check_expr(c, value)?;
                    if (!type_eq(vt, v.ty)) {
                        return Result.Err(terr(value.line, value.col,
                            "'" + name + "' es " + type_str(v.ty) + " pero se le asigna " + type_str(vt)));
                    }
                    Result.Ok(0)
                },
            }
        },
        EKind.EIndex(array, index) => {
            // Los strings son inmutables: `s[i] = c` no se permite (sí se lee `s[i]`).
            let at = check_expr(c, array)?;
            if (type_eq(at, Type.TString)) {
                return Result.Err(terr(target.line, target.col,
                    "no se puede asignar a un carácter de un string (los strings son inmutables)"));
            }
            let elem = check_index(c, array, index)?;
            let vt = check_expr(c, value)?;
            if (!type_eq(vt, elem)) {
                return Result.Err(terr(value.line, value.col,
                    "el elemento es " + type_str(elem) + " pero se le asigna " + type_str(vt)));
            }
            Result.Ok(0)
        },
        EKind.EField(object, name) => {
            let fty = check_field(c, object, name)?;
            let vt = check_expr(c, value)?;
            if (!type_eq(vt, fty)) {
                return Result.Err(terr(value.line, value.col,
                    "el campo '" + name + "' es " + type_str(fty) + " pero se le asigna " + type_str(vt)));
            }
            Result.Ok(0)
        },
        _ => Result.Err(terr(target.line, target.col, "el lado izquierdo no es asignable")),
    }
}

// =====================================================================
// Expresiones
// =====================================================================

fn check_expr(c: Checker, e: Expr) -> Result<Type, TypeError> {
    match (e.kind) {
        EKind.EInt(_) => Result.Ok(Type.TInt),
        EKind.EFloat(_) => Result.Ok(Type.TFloat),
        EKind.EBool(_) => Result.Ok(Type.TBool),
        EKind.EStr(_) => Result.Ok(Type.TString),
        EKind.EChar(_) => Result.Ok(Type.TChar),
        EKind.EIdent(name) => check_ident(c, name, e.line, e.col),
        EKind.EUnary(op, inner) => check_unary(c, op, inner, e.line, e.col),
        EKind.EBinary(op, l, r) => check_binary(c, op, l, r, e.line, e.col),
        EKind.ECall(callee, cargs) => check_call(c, callee, cargs, Option.None, e.line, e.col),
        EKind.EIf(cond, then_b, elseopt) => check_if(c, cond, then_b, elseopt, Option.None, e.line, e.col),
        EKind.EWhile(cond, body) => check_while(c, cond, body, e.line, e.col),
        EKind.EBlock(b) => check_block(c, b),
        EKind.EArray(elems) => check_array(c, elems, e.line, e.col),
        EKind.EIndex(arr, idx) => check_index(c, arr, idx),
        EKind.EField(obj, name) => check_field_or_enum(c, obj, name, Option.None, e.line, e.col),
        EKind.EStructLit(name, fields) => check_struct_lit(c, name, fields, Option.None, e.line, e.col),
        EKind.EMatch(scrut, arms) => check_match(c, scrut, arms, Option.None, e.line, e.col),
        EKind.ETry(inner) => check_try(c, inner, e.line, e.col),
        EKind.EFunc(fe) => check_func_expr(c, fe),
        _ => Result.Err(terr(e.line, e.col, "expresión aún no soportada por el checker auto-alojado")),
    }
}

// Una función anónima `fn(params) -> R { cuerpo }` (M4.2, con captura): el cuerpo se verifica con los
// ámbitos envolventes visibles (los parámetros encima), así que puede referenciar variables externas.
// Solo se guarda/restaura el retorno en curso. Devuelve su tipo función.
fn check_func_expr(c: Checker, fe: FnExpr) -> Result<Type, TypeError> {
    var pi = 0;
    while (pi < len(fe.params)) {
        let p = fe.params[pi];
        ensure_type(c, p.ty, p.line, p.col)?;
        pi = pi + 1;
    }
    ensure_type(c, fe.ret, fe.line, fe.col)?;
    let saved = c.current_return;
    let r = check_fn_body(c, fe.params, fe.ret, fe.body, fe.line, fe.col, "la función anónima");
    c.current_return = saved;
    r?;
    var ps: [Type] = [];
    pi = 0;
    while (pi < len(fe.params)) { push(ps, resolve_type(fe.params[pi].ty)); pi = pi + 1; }
    Result.Ok(Type.TFn(ps, resolve_type(fe.ret)))
}

// El operador de propagación `expr?` (M6.3). El operando debe ser un `Result<T, E>` o un `Option<T>`;
// el resultado es el valor desempaquetado `T`. La función envolvente debe declarar un retorno
// compatible: `Result<_, E>` con la misma `E`, o `Option<_>`.
fn check_try(c: Checker, inner: Expr, line: int, col: int) -> Result<Type, TypeError> {
    let it = check_expr(c, inner)?;
    match (it) {
        Type.TNamed(n, args) => {
            if (n == "Result" && len(args) == 2) {
                let ok_ty = args[0];
                let err_ty = args[1];
                match (c.current_return) {
                    Type.TNamed(rn, rargs) => {
                        if (rn == "Result" && len(rargs) == 2 && type_eq(rargs[1], err_ty)) {
                            Result.Ok(ok_ty)
                        } else {
                            Result.Err(terr(line, col, "'?' sobre " + type_str(it) + " requiere que la función devuelva Result<_, "
                                + type_str(err_ty) + ">, pero devuelve " + type_str(c.current_return)))
                        }
                    },
                    _ => Result.Err(terr(line, col, "'?' sobre " + type_str(it) + " requiere que la función devuelva Result<_, "
                        + type_str(err_ty) + ">, pero devuelve " + type_str(c.current_return))),
                }
            } else if (n == "Option" && len(args) == 1) {
                let some_ty = args[0];
                match (c.current_return) {
                    Type.TNamed(rn, rargs) => {
                        if (rn == "Option" && len(rargs) == 1) {
                            Result.Ok(some_ty)
                        } else {
                            Result.Err(terr(line, col, "'?' sobre " + type_str(it)
                                + " requiere que la función devuelva Option<_>, pero devuelve " + type_str(c.current_return)))
                        }
                    },
                    _ => Result.Err(terr(line, col, "'?' sobre " + type_str(it)
                        + " requiere que la función devuelva Option<_>, pero devuelve " + type_str(c.current_return))),
                }
            } else {
                Result.Err(terr(inner.line, inner.col, "'?' requiere un Result o un Option, no " + type_str(it)))
            }
        },
        _ => Result.Err(terr(inner.line, inner.col, "'?' requiere un Result o un Option, no " + type_str(it))),
    }
}

// Una expresión con un tipo ESPERADO (chequeo bidireccional, M14.3b/c). El esperado fija el `[]` vacío
// y los argumentos de tipo indeterminados (`Caja.Vacia` con esperado `Caja<int>`), y se propaga a las
// formas que producen valor (bloque, if, match, literal de struct, construcción de enum). Lo demás se
// chequea normal.
fn check_expr_expected(c: Checker, e: Expr, expected: Type) -> Result<Type, TypeError> {
    // M14.3d-4: si se espera `dyn Trait`, un valor concreto que lo implemente se coerciona. Las
    // formas que propagan el esperado (if/match/bloque) NO se interceptan: la coerción ocurre en sus
    // hojas (cada rama), igual que el resto del chequeo bidireccional.
    match (expected) {
        Type.TDyn(traits) => {
            if (!propaga_esperado(e)) { return coerce_to_dyn(c, e, traits, e.line, e.col); }
        },
        _ => {},
    }
    match (e.kind) {
        EKind.EArray(elems) => {
            match (expected) {
                Type.TArray(elem_exp) => {
                    var i = 0;
                    while (i < len(elems)) {
                        let t = check_expr_expected(c, elems[i], elem_exp)?;
                        if (!type_eq(t, elem_exp)) {
                            return Result.Err(terr(elems[i].line, elems[i].col,
                                "los elementos del arreglo deben ser " + type_str(elem_exp) + ", no " + type_str(t)));
                        }
                        i = i + 1;
                    }
                    Result.Ok(Type.TArray(elem_exp))
                },
                _ => check_expr(c, e),
            }
        },
        EKind.EBlock(b) => check_block_expected(c, b, expected),
        EKind.EStructLit(name, fields) => check_struct_lit(c, name, fields, Option.Some(expected), e.line, e.col),
        EKind.EIf(cond, then_b, elseopt) => check_if(c, cond, then_b, elseopt, Option.Some(expected), e.line, e.col),
        EKind.EMatch(scrut, arms) => check_match(c, scrut, arms, Option.Some(expected), e.line, e.col),
        EKind.EField(obj, name) => check_field_or_enum(c, obj, name, Option.Some(expected), e.line, e.col),
        EKind.ECall(callee, cargs) => check_call(c, callee, cargs, Option.Some(expected), e.line, e.col),
        _ => check_expr(c, e),
    }
}

fn check_ident(c: Checker, name: string, line: int, col: int) -> Result<Type, TypeError> {
    match (lookup(c, name)) {
        Option.Some(v) => Result.Ok(v.ty),
        Option.None => {
            match (get(c.funcs, name)) {
                Option.Some(sig) => Result.Ok(Type.TFn(sig.params, sig.ret)),
                Option.None => Result.Err(terr(line, col, "nombre '" + name + "' no declarado")),
            }
        },
    }
}

fn check_unary(c: Checker, op: UnOp, inner: Expr, line: int, col: int) -> Result<Type, TypeError> {
    let t = check_expr(c, inner)?;
    match (op) {
        UnOp.Neg => {
            if (type_eq(t, Type.TInt) || type_eq(t, Type.TFloat)) { Result.Ok(t) }
            else { Result.Err(terr(line, col, "no se puede negar (-) un " + type_str(t))) }
        },
        UnOp.Not => {
            if (type_eq(t, Type.TBool)) { Result.Ok(Type.TBool) }
            else { Result.Err(terr(line, col, "el '!' requiere bool, no " + type_str(t))) }
        },
    }
}

fn check_binary(c: Checker, op: BinOp, l: Expr, r: Expr, line: int, col: int) -> Result<Type, TypeError> {
    let lt = check_expr(c, l)?;
    let rt = check_expr(c, r)?;
    let kind = op_kind(op);
    if (kind == 0) {
        if (type_eq(lt, Type.TInt) && type_eq(rt, Type.TInt)) { Result.Ok(Type.TInt) }
        else if (type_eq(lt, Type.TFloat) && type_eq(rt, Type.TFloat)) { Result.Ok(Type.TFloat) }
        else if (is_add(op) && type_eq(lt, Type.TString) && type_eq(rt, Type.TString)) { Result.Ok(Type.TString) }
        else if (is_add(op) && is_array(lt) && type_eq(lt, rt)) { Result.Ok(lt) }
        else {
            Result.Err(terr(line, col, "el operador '" + bin_op_str(op)
                + "' requiere ambos operandos int o ambos float, no " + type_str(lt) + " y " + type_str(rt)))
        }
    } else if (kind == 1) {
        if (order_ok(lt, rt)) { Result.Ok(Type.TBool) }
        else {
            Result.Err(terr(line, col, "el operador '" + bin_op_str(op)
                + "' compara int/float/string/char del mismo tipo, no " + type_str(lt) + " y " + type_str(rt)))
        }
    } else if (kind == 2) {
        if (type_eq(lt, rt) && is_comparable(lt)) { Result.Ok(Type.TBool) }
        else {
            Result.Err(terr(line, col, "el operador '" + bin_op_str(op)
                + "' requiere ambos operandos del mismo tipo comparable, no " + type_str(lt) + " y " + type_str(rt)))
        }
    } else {
        if (type_eq(lt, Type.TBool) && type_eq(rt, Type.TBool)) { Result.Ok(Type.TBool) }
        else {
            Result.Err(terr(line, col, "el operador '" + bin_op_str(op)
                + "' requiere operandos bool, no " + type_str(lt) + " y " + type_str(rt)))
        }
    }
}

fn check_call(c: Checker, callee: Expr, cargs: [Expr], expected: Option<Type>, line: int, col: int) -> Result<Type, TypeError> {
    match (callee.kind) {
        // map_new() es indeterminado: necesita el tipo esperado (bidireccional) para fijar Map<K,V>.
        EKind.EIdent(n) => {
            if (n == "map_new") { check_map_new(c, cargs, expected, line, col) }
            else { check_named_call(c, n, cargs, line, col) }
        },
        // `recv.f(args)`: construcción de enum `Enum.Variante(args)`, o llamada al valor de un campo.
        // (UFCS / métodos de trait quedan diferidos a M14.3d.)
        EKind.EField(obj, name) => check_call_field(c, obj, name, cargs, expected, line, col),
        _ => {
            let ty = check_expr(c, callee)?;
            call_type(c, ty, cargs, line, col)
        },
    }
}

// `obj.name(args)`. Por orden: (1) construcción de enum `Enum.Variante(args)`; (2) llamada al CAMPO
// `name` del struct receptor (de tipo función) —gana sobre UFCS—; (3) **UFCS** (M7.1): `name(recv,
// args)`, el receptor como primer argumento. (Métodos de trait / bound / `dyn` → M14.3d-2/3/4.)
fn check_call_field(c: Checker, obj: Expr, name: string, cargs: [Expr], expected: Option<Type>, line: int, col: int) -> Result<Type, TypeError> {
    // (1) ¿el receptor nombra un enum? → construcción de variante.
    match (obj.kind) {
        EKind.EIdent(en) => {
            if (is_enum(c, en)) {
                return check_enum_lit(c, en, name, cargs, expected, line, col);
            }
        },
        _ => {},
    }
    let recv_ty = check_expr(c, obj)?;
    // (1.5) receptor `dyn Trait` → despacho dinámico por la vtable del objeto.
    match (recv_ty) {
        Type.TDyn(traits) => { return dispatch_dyn_method(c, traits, name, cargs, line, col); },
        _ => {},
    }
    // (2) ¿un campo del struct receptor con ese nombre (de tipo función)? Gana sobre el método/UFCS.
    match (recv_ty) {
        Type.TNamed(sname, targs) => {
            match (struct_field_type(c, sname, targs, name)) {
                Option.Some(fty) => { return call_type(c, fty, cargs, line, col); },
                Option.None => {},
            }
        },
        _ => {},
    }
    // (3) ¿un método de trait del tipo concreto del receptor? Gana sobre la función libre (UFCS).
    match (type_key_of(recv_ty)) {
        Option.Some(key) => {
            match (get(c.methods, mangle(key, name))) {
                Option.Some(sig) => { return call_method(c, sig, mangle(key, name), obj, cargs, line, col); },
                Option.None => {},
            }
        },
        Option.None => {},
    }
    // (3b) ¿un método de un trait que ACOTA al tipo del receptor? (`x.m()` con `x: T`, `T: Trait`).
    match (recv_ty) {
        Type.TNamed(tp, targs) => {
            if (len(targs) == 0 && contains_str(c.tparams, tp)) {
                match (resolve_bound_method(c, tp, name, cargs, line, col)?) {
                    Option.Some(ret) => { return Result.Ok(ret); },
                    Option.None => {},
                }
            }
        },
        _ => {},
    }
    // (4) UFCS: `name(recv, args)`.
    check_ufcs(c, name, recv_ty, obj, cargs, line, col)
}

// Resuelve `x.metodo(args)` con `x: T` y `T` acotado por un trait que declara `metodo` (M14.3d-3). El
// receptor ya casó con `self` (es `T`); valida los argumentos restantes y devuelve el retorno (con
// `Self`→T). `None` si ningún bound de `T` declara el método (→ se intenta UFCS).
fn resolve_bound_method(c: Checker, tp: string, method: string, cargs: [Expr], line: int, col: int) -> Result<Option<Type>, TypeError> {
    var hits: [string] = [];
    var i = 0;
    while (i < len(c.bounds)) {
        let b = c.bounds[i];
        if (b.param == tp) {
            match (get(c.traits, b.trait_name)) {
                Option.Some(ms) => { if (trait_has_method(ms, method)) { push(hits, b.trait_name); } },
                Option.None => {},
            }
        }
        i = i + 1;
    }
    if (len(hits) == 0) { return Result.Ok(Option.None); }
    if (len(hits) > 1) {
        return Result.Err(terr(line, col, "método '" + method + "' ambiguo para '" + tp + "': lo declaran varios traits acotados (" + join_comma(hits) + ")"));
    }
    let trait_name = hits[0];
    let self_ty = Type.TNamed(tp, []);
    let sig = match (find_method_sig(trait_methods_of(c, trait_name), method)) {
        Option.Some(m) => m,
        Option.None => { return Result.Err(terr(line, col, "método '" + method + "' no encontrado")); },
    };
    // Argumentos esperados: los del método sin el receptor (self), con Self→T.
    var expected: [Type] = [];
    var j = 1;
    while (j < len(sig.params)) { push(expected, resolve_type(subst_self(sig.params[j].ty, self_ty))); j = j + 1; }
    if (len(cargs) != len(expected)) {
        return Result.Err(terr(line, col, "el método '" + method + "' espera " + to_string(len(expected))
            + " argumento(s) (sin contar el receptor), se le pasaron " + to_string(len(cargs))));
    }
    var k = 0;
    while (k < len(cargs)) {
        let at = check_expr_expected(c, cargs[k], expected[k])?;
        if (!type_eq(at, expected[k])) {
            return Result.Err(terr(cargs[k].line, cargs[k].col,
                "argumento " + to_string(k + 1) + " del método '" + method + "': se esperaba " + type_str(expected[k]) + ", se pasó " + type_str(at)));
        }
        k = k + 1;
    }
    Result.Ok(Option.Some(resolve_type(subst_self(sig.ret, self_ty))))
}

// Las firmas de un trait registrado (vacío si no está).
fn trait_methods_of(c: Checker, name: string) -> [MethodSig] {
    match (get(c.traits, name)) { Option.Some(ms) => ms, Option.None => [] }
}

// ¿La lista de firmas declara un método con ese nombre?
fn trait_has_method(ms: [MethodSig], method: string) -> bool {
    var i = 0;
    while (i < len(ms)) {
        if (ms[i].name == method) { return true; }
        i = i + 1;
    }
    false
}

// Verifica una llamada a método `recv.m(args)` contra su firma (con `self` como primer argumento). El
// `label` manglado (`Tipo#m`) aparece en un posible error de aridad/tipo de argumento (como en Rust).
// Para un método de impl GENÉRICO la firma es genérica acotada → se infieren sus params y se chequean
// sus bounds (igual que una función genérica).
fn call_method(c: Checker, sig: FnSig, label: string, obj: Expr, cargs: [Expr], line: int, col: int) -> Result<Type, TypeError> {
    var all: [Expr] = [];
    push(all, obj);
    var i = 0;
    while (i < len(cargs)) { push(all, cargs[i]); i = i + 1; }
    if (len(sig.type_params) == 0) {
        check_args(c, sig.params, sig.ret, all, "'" + label + "'", line, col)
    } else {
        check_generic_call(c, sig.type_params, sig.params, sig.ret, sig.bounds, all, "'" + label + "'", line, col)
    }
}

// =====================================================================
// Trait objects (M14.3d-4a: dyn — despacho dinámico)
// =====================================================================

// ¿`e` propaga el tipo esperado a sus hojas? (if/match/bloque: la coerción a dyn ocurre en cada rama.)
fn propaga_esperado(e: Expr) -> bool {
    match (e.kind) {
        EKind.EIf(_, _, _) => true,
        EKind.EMatch(_, _) => true,
        EKind.EBlock(_) => true,
        _ => false,
    }
}

// ¿`ts` (subconjunto) está contenido en `whole`?
fn subset_strs(ts: [string], whole: [string]) -> bool {
    var i = 0;
    while (i < len(ts)) {
        if (!contains_str(whole, ts[i])) { return false; }
        i = i + 1;
    }
    true
}

// Coerciona una expresión a `dyn Trait`: un valor concreto que implemente todos los traits del
// conjunto, o un `dyn` del mismo conjunto (no-op) o un superconjunto (upcasting: olvidar traits).
fn coerce_to_dyn(c: Checker, e: Expr, traits: [string], line: int, col: int) -> Result<Type, TypeError> {
    let actual = check_expr(c, e)?;
    match (actual) {
        Type.TDyn(source) => {
            if (strs_eq(source, traits)) { return Result.Ok(actual); }
            if (subset_strs(traits, source)) { return Result.Ok(Type.TDyn(traits)); }
            return Result.Err(terr(line, col, "no se puede convertir 'dyn " + join_strs(source) + "' en 'dyn "
                + join_strs(traits) + "': solo se puede upcastear a un subconjunto de traits"));
        },
        _ => {},
    }
    match (type_key_of(actual)) {
        Option.None => Result.Err(terr(line, col, "no se puede convertir " + type_str(actual) + " en 'dyn " + join_strs(traits) + "'")),
        Option.Some(key) => {
            var i = 0;
            while (i < len(traits)) {
                if (!contains_key(c.impl_traits, mangle(key, traits[i]))) {
                    return Result.Err(terr(line, col, type_str(actual) + " no implementa '" + traits[i] + "': no puede usarse como 'dyn " + join_strs(traits) + "'"));
                }
                i = i + 1;
            }
            Result.Ok(Type.TDyn(traits))
        },
    }
}

// Despacha `obj.metodo(args)` con `obj: dyn Trait`: el método se resuelve por la vtable en runtime.
// Verifica que algún trait del conjunto declara el método, que es *object-safe* (no usa `Self` fuera
// del receptor) y que los argumentos casan. Devuelve el retorno del método.
fn dispatch_dyn_method(c: Checker, traits: [string], method: string, cargs: [Expr], line: int, col: int) -> Result<Type, TypeError> {
    let sig = match (find_dyn_method(c, traits, method)) {
        Option.Some(m) => m,
        Option.None => { return Result.Err(terr(line, col, "'dyn " + join_strs(traits) + "' no declara un método '" + method + "'")); },
    };
    // Object safety: si `Self` aparece fuera del receptor (en un param o el retorno), no es invocable.
    if (method_uses_self(sig)) {
        return Result.Err(terr(line, col, "el método '" + method + "' usa 'Self': no es invocable sobre 'dyn " + join_strs(traits) + "'"));
    }
    // Argumentos (sin el receptor, que es el propio objeto).
    var expected: [Type] = [];
    var j = 1;
    while (j < len(sig.params)) { push(expected, resolve_type(sig.params[j].ty)); j = j + 1; }
    if (len(cargs) != len(expected)) {
        return Result.Err(terr(line, col, "el método '" + method + "' espera " + to_string(len(expected))
            + " argumento(s) (sin contar el receptor), se le pasaron " + to_string(len(cargs))));
    }
    var k = 0;
    while (k < len(cargs)) {
        let at = check_expr_expected(c, cargs[k], expected[k])?;
        if (!type_eq(at, expected[k])) {
            return Result.Err(terr(cargs[k].line, cargs[k].col,
                "argumento " + to_string(k + 1) + " del método '" + method + "': se esperaba " + type_str(expected[k]) + ", se pasó " + type_str(at)));
        }
        k = k + 1;
    }
    Result.Ok(resolve_type(sig.ret))
}

// La firma del método `method` en alguno de los traits del conjunto (`None` si ninguno lo declara).
fn find_dyn_method(c: Checker, traits: [string], method: string) -> Option<MethodSig> {
    var i = 0;
    while (i < len(traits)) {
        match (find_method_sig(trait_methods_of(c, traits[i]), method)) {
            Option.Some(m) => { return Option.Some(m); },
            Option.None => {},
        }
        i = i + 1;
    }
    Option.None
}

// ¿Un método usa `Self` fuera del receptor (en un parámetro distinto del primero o en el retorno)?
fn method_uses_self(sig: MethodSig) -> bool {
    var i = 1;
    while (i < len(sig.params)) {
        if (type_uses_self(sig.params[i].ty)) { return true; }
        i = i + 1;
    }
    type_uses_self(sig.ret)
}

// ¿El tipo menciona `Self` en cualquier posición?
fn type_uses_self(t: Type) -> bool {
    match (t) {
        Type.TNamed(n, args) => {
            if (n == "Self") { true } else { types_use_self(args) }
        },
        Type.TArray(e) => type_uses_self(e),
        Type.TFn(ps, r) => types_use_self(ps) || type_uses_self(r),
        Type.TDyn(_) => false,
        _ => false,
    }
}
fn types_use_self(ts: [Type]) -> bool {
    var i = 0;
    while (i < len(ts)) {
        if (type_uses_self(ts[i])) { return true; }
        i = i + 1;
    }
    false
}

// El tipo del campo `fname` de un struct `sname` con args de tipo `targs`, ya sustituido (`None` si
// no es un struct o no tiene ese campo). Compartido por el acceso a campo y la resolución UFCS.
fn struct_field_type(c: Checker, sname: string, targs: [Type], fname: string) -> Option<Type> {
    match (get(c.structs, sname)) {
        Option.Some(fields) => {
            match (find_field(fields, fname)) {
                Option.Some(fty) => Option.Some(subst(fty, build_sigma(struct_tparams(c, sname), targs))),
                Option.None => Option.None,
            }
        },
        Option.None => Option.None,
    }
}

// UFCS `recv.f(args)` ≡ `f(recv, args)`: el receptor pasa a ser el primer argumento. Reusa la
// resolución de llamada por nombre (builtins, variable local, función libre, genéricos). Si `name` no
// es llamable, el error habla de UFCS (no es ni campo ni función), mencionando el tipo del receptor.
fn check_ufcs(c: Checker, name: string, recv_ty: Type, obj: Expr, cargs: [Expr], line: int, col: int) -> Result<Type, TypeError> {
    if (!name_is_callable(c, name)) {
        return Result.Err(terr(line, col, "no existe campo ni función '" + name + "' aplicable a " + type_str(recv_ty)));
    }
    var all: [Expr] = [];
    push(all, obj);
    var i = 0;
    while (i < len(cargs)) { push(all, cargs[i]); i = i + 1; }
    check_named_call(c, name, all, line, col)
}

// ¿`name` nombra un builtin que el checker auto-alojado conoce? (Los mismos que `check_named_call`.)
fn is_known_builtin(name: string) -> bool {
    name == "print" || name == "eprint" || name == "len" || name == "push"
        || name == "to_string" || name == "trim" || name == "split" || name == "chars"
        || name == "contains" || name == "replace" || name == "starts_with" || name == "ends_with"
        || name == "to_upper" || name == "to_lower" || name == "substring" || name == "repeat"
        || name == "join"
        || name == "map_new" || name == "insert" || name == "get" || name == "contains_key"
        || name == "keys" || name == "values" || name == "remove"
        || name == "panic" || name == "__parse_int" || name == "__parse_float"
        || name == "__read_file" || name == "__write_file" || name == "exists"
}

// ¿`name` nombra algo llamable? (builtin, variable local de función, o función de nivel superior.)
fn name_is_callable(c: Checker, name: string) -> bool {
    if (is_known_builtin(name)) { return true; }
    match (lookup(c, name)) { Option.Some(_) => { return true; }, Option.None => {}, }
    contains_key(c.funcs, name)
}

// `obj.name` como expresión: construcción de variante de enum sin payload (`Enum.Variante`; el
// esperado fija sus args de tipo, p. ej. `Caja.Vacia`), o acceso a campo de struct.
fn check_field_or_enum(c: Checker, obj: Expr, name: string, expected: Option<Type>, line: int, col: int) -> Result<Type, TypeError> {
    match (obj.kind) {
        EKind.EIdent(en) => {
            if (is_enum(c, en)) {
                check_enum_lit(c, en, name, [], expected, line, col)
            } else {
                check_field(c, obj, name)
            }
        },
        _ => check_field(c, obj, name),
    }
}

// Llamada por nombre: builtin (print/eprint), variable-función local, o función de nivel superior.
fn check_named_call(c: Checker, name: string, cargs: [Expr], line: int, col: int) -> Result<Type, TypeError> {
    if (name == "print" || name == "eprint") {
        return check_print(c, name, cargs, line, col);
    }
    if (name == "len") { return check_len(c, cargs, line, col); }
    if (name == "push") { return check_push(c, cargs, line, col); }
    if (name == "to_string") { return check_to_string(c, cargs, line, col); }
    if (name == "trim") { return check_trim(c, cargs, line, col); }
    if (name == "to_upper") { return check_to_upper(c, cargs, line, col); }
    if (name == "to_lower") { return check_to_lower(c, cargs, line, col); }
    if (name == "chars") { return check_chars(c, cargs, line, col); }
    if (name == "split") { return check_split(c, cargs, line, col); }
    if (name == "replace") { return check_replace(c, cargs, line, col); }
    if (name == "starts_with") { return check_starts_with(c, cargs, line, col); }
    if (name == "ends_with") { return check_ends_with(c, cargs, line, col); }
    if (name == "substring") { return check_substring(c, cargs, line, col); }
    if (name == "repeat") { return check_repeat(c, cargs, line, col); }
    if (name == "join") { return check_join(c, cargs, line, col); }
    if (name == "contains") { return check_contains(c, cargs, line, col); }
    if (name == "insert") { return check_insert(c, cargs, line, col); }
    if (name == "get") { return check_get(c, cargs, line, col); }
    if (name == "contains_key") { return check_contains_key(c, cargs, line, col); }
    if (name == "remove") { return check_remove(c, cargs, line, col); }
    if (name == "keys") { return check_keys(c, cargs, line, col); }
    if (name == "values") { return check_values(c, cargs, line, col); }
    if (name == "map_new") { return check_map_new(c, cargs, Option.None, line, col); }
    if (name == "panic") { return check_panic(c, cargs, line, col); }
    if (name == "__parse_int") { return check_parse_prim(c, "__parse_int", Type.TInt, cargs, line, col); }
    if (name == "__parse_float") { return check_parse_prim(c, "__parse_float", Type.TFloat, cargs, line, col); }
    if (name == "__read_file") { return check_read_file(c, cargs, line, col); }
    if (name == "__write_file") { return check_write_file(c, cargs, line, col); }
    if (name == "exists") { return check_exists(c, cargs, line, col); }
    match (lookup(c, name)) {
        Option.Some(v) => { return call_type(c, v.ty, cargs, line, col); },
        Option.None => {},
    }
    match (get(c.funcs, name)) {
        Option.Some(sig) => {
            if (len(sig.type_params) == 0) {
                check_args(c, sig.params, sig.ret, cargs, "'" + name + "'", line, col)
            } else {
                check_generic_call(c, sig.type_params, sig.params, sig.ret, sig.bounds, cargs, "'" + name + "'", line, col)
            }
        },
        Option.None => Result.Err(terr(line, col, "función '" + name + "' no declarada")),
    }
}

// Una llamada a una función GENÉRICA (M14.3c). Infiere los parámetros de tipo unificando los tipos
// de los parámetros con los de los argumentos, y devuelve el retorno ya sustituido. Si algún
// parámetro de tipo no queda determinado por los argumentos, es error (M6.1 no usa el tipo esperado).
fn check_generic_call(c: Checker, type_params: [string], params: [Type], ret: Type, bounds: [Bound], cargs: [Expr], label: string, line: int, col: int) -> Result<Type, TypeError> {
    if (len(cargs) != len(params)) {
        return Result.Err(terr(line, col,
            label + " espera " + to_string(len(params)) + " argumento(s), se le pasaron " + to_string(len(cargs))));
    }
    let sigma: Map<string, Type> = map_new();
    var i = 0;
    while (i < len(cargs)) {
        let at = check_expr(c, cargs[i])?;
        match (unify(params[i], at, sigma, type_params)) {
            Result.Ok(_) => {},
            Result.Err(reason) => {
                return Result.Err(terr(cargs[i].line, cargs[i].col,
                    "argumento " + to_string(i + 1) + " de " + label + ": " + reason));
            },
        }
        i = i + 1;
    }
    // Todos los parámetros de tipo deben haber quedado determinados.
    var ti = 0;
    while (ti < len(type_params)) {
        if (!contains_key(sigma, type_params[ti])) {
            return Result.Err(terr(line, col,
                "no se pudo inferir el parámetro de tipo '" + type_params[ti] + "' de " + label + " (no aparece en los argumentos)"));
        }
        ti = ti + 1;
    }
    // M14.3d-3: cada parámetro acotado debe resolver a un tipo que satisfaga su bound.
    check_call_bounds(c, bounds, sigma, line, col)?;
    Result.Ok(subst(ret, sigma))
}

// Comprueba que, en un sitio de llamada, el tipo inferido de cada parámetro acotado satisface su
// bound. (El paso de diccionarios —lowering— se omite en el validador; aquí va solo la satisfacción.)
fn check_call_bounds(c: Checker, bounds: [Bound], sigma: Map<string, Type>, line: int, col: int) -> Result<int, TypeError> {
    var i = 0;
    while (i < len(bounds)) {
        let b = bounds[i];
        let concrete = match (get(sigma, b.param)) { Option.Some(t) => t, Option.None => Type.TNamed(b.param, []) };
        check_bound_satisfied(c, concrete, b.trait_name, line, col)?;
        i = i + 1;
    }
    Result.Ok(0)
}

// ¿`concrete` satisface el bound `trait_name`? Dos vías: un parámetro de tipo rígido del llamador que
// declara el mismo bound (reenvío del diccionario), o un tipo concreto con impl del trait.
fn check_bound_satisfied(c: Checker, concrete: Type, trait_name: string, line: int, col: int) -> Result<int, TypeError> {
    match (concrete) {
        Type.TNamed(u, args) => {
            if (len(args) == 0 && contains_str(c.tparams, u)) {
                if (bounds_has(c.bounds, u, trait_name)) { return Result.Ok(0); }
                return Result.Err(terr(line, col, "el parámetro de tipo '" + u + "' no está acotado por '" + trait_name + "' (requerido por la llamada)"));
            }
            if (contains_key(c.impl_traits, mangle(u, trait_name))) { Result.Ok(0) }
            else { Result.Err(terr(line, col, type_str(concrete) + " no implementa '" + trait_name + "' (requerido por la llamada)")) }
        },
        _ => {
            match (type_key_of(concrete)) {
                Option.Some(key) => {
                    if (contains_key(c.impl_traits, mangle(key, trait_name))) { Result.Ok(0) }
                    else { Result.Err(terr(line, col, type_str(concrete) + " no implementa '" + trait_name + "' (requerido por la llamada)")) }
                },
                Option.None => Result.Err(terr(line, col, type_str(concrete) + " no puede implementar el trait '" + trait_name + "'")),
            }
        },
    }
}

// ¿La lista de bounds incluye `param: trait_name`?
fn bounds_has(bounds: [Bound], param: string, trait_name: string) -> bool {
    var i = 0;
    while (i < len(bounds)) {
        if (bounds[i].param == param && bounds[i].trait_name == trait_name) { return true; }
        i = i + 1;
    }
    false
}

// El builtin print/eprint: 1 argumento imprimible → unit.
fn check_print(c: Checker, name: string, cargs: [Expr], line: int, col: int) -> Result<Type, TypeError> {
    if (len(cargs) != 1) {
        return Result.Err(terr(line, col, name + " espera 1 argumento, se le pasaron " + to_string(len(cargs))));
    }
    let at = check_expr(c, cargs[0])?;
    if (!is_printable(at)) {
        return Result.Err(terr(cargs[0].line, cargs[0].col, name + " no puede imprimir un " + type_str(at)));
    }
    Result.Ok(Type.TUnit)
}

// El builtin len(a) -> int: longitud de un arreglo o un string (los Map llegan en M14.3c).
fn check_len(c: Checker, cargs: [Expr], line: int, col: int) -> Result<Type, TypeError> {
    if (len(cargs) != 1) {
        return Result.Err(terr(line, col, "len espera 1 argumento, se le pasaron " + to_string(len(cargs))));
    }
    let at = check_expr(c, cargs[0])?;
    if (!(is_array(at) || type_eq(at, Type.TString) || is_map(at))) {
        return Result.Err(terr(cargs[0].line, cargs[0].col, "len espera un arreglo, un string o un Map, no " + type_str(at)));
    }
    Result.Ok(Type.TInt)
}

// El builtin push(a, x) -> unit: agrega x al final del arreglo a (lo muta). x debe ser del tipo de
// los elementos. Tipa ambos argumentos antes de aplicar la regla (como el registro de builtins).
fn check_push(c: Checker, cargs: [Expr], line: int, col: int) -> Result<Type, TypeError> {
    if (len(cargs) != 2) {
        return Result.Err(terr(line, col, "push espera 2 argumentos (arreglo, valor), se le pasaron " + to_string(len(cargs))));
    }
    let a0 = check_expr(c, cargs[0])?;
    let a1 = check_expr(c, cargs[1])?;
    match (a0) {
        Type.TArray(elem) => {
            if (!type_eq(a1, elem)) {
                return Result.Err(terr(cargs[1].line, cargs[1].col,
                    "push: el arreglo es de " + type_str(elem) + " pero se empuja " + type_str(a1)));
            }
            Result.Ok(Type.TUnit)
        },
        _ => Result.Err(terr(cargs[0].line, cargs[0].col, "push espera un arreglo como primer argumento, no " + type_str(a0))),
    }
}

// =====================================================================
// Builtins de string (M14.6a): to_string/trim/split/chars/contains/replace/starts_with/ends_with/
// to_upper/to_lower/substring/repeat/join. Reglas y mensajes idénticos a `src/builtins.rs`.
// =====================================================================

// Mensaje de aridad idéntico al helper `arity` de Rust.
fn b_arity(name: string, n: int, det: string, got: int, line: int, col: int) -> Result<int, TypeError> {
    if (got != n) {
        let plural = if (n == 1) { "argumento" } else { "argumentos" };
        return Result.Err(terr(line, col, name + " espera " + to_string(n) + " " + plural + det + ", se le pasaron " + to_string(got)));
    }
    Result.Ok(0)
}

// Tipa todos los argumentos (como hace Rust antes de aplicar la regla del builtin).
fn check_args_types(c: Checker, cargs: [Expr]) -> Result<[Type], TypeError> {
    var ts: [Type] = [];
    var i = 0;
    while (i < len(cargs)) {
        let t = check_expr(c, cargs[i])?;
        push(ts, t);
        i = i + 1;
    }
    Result.Ok(ts)
}

// Exige que el argumento `i` sea string; `msg` termina en "no " (se le añade el tipo encontrado).
fn want_string(a: [Type], cargs: [Expr], i: int, msg: string) -> Result<int, TypeError> {
    if (!type_eq(a[i], Type.TString)) {
        return Result.Err(terr(cargs[i].line, cargs[i].col, msg + type_str(a[i])));
    }
    Result.Ok(0)
}

fn want_int(a: [Type], cargs: [Expr], i: int, msg: string) -> Result<int, TypeError> {
    if (!type_eq(a[i], Type.TInt)) {
        return Result.Err(terr(cargs[i].line, cargs[i].col, msg + type_str(a[i])));
    }
    Result.Ok(0)
}

fn check_to_string(c: Checker, cargs: [Expr], line: int, col: int) -> Result<Type, TypeError> {
    b_arity("to_string", 1, "", len(cargs), line, col)?;
    let a = check_args_types(c, cargs)?;
    if (!(type_eq(a[0], Type.TInt) || type_eq(a[0], Type.TFloat) || type_eq(a[0], Type.TBool) || type_eq(a[0], Type.TString) || type_eq(a[0], Type.TChar))) {
        return Result.Err(terr(cargs[0].line, cargs[0].col, "to_string solo convierte int/float/bool/string/char, no " + type_str(a[0])));
    }
    Result.Ok(Type.TString)
}

// panic(msg: string) -> unit (M14.6c). Aborta la ejecución; el análisis de divergencia ya lo
// reconoce por nombre (`expr_diverges`). Mensaje byte-idéntico a `src/builtins.rs`.
fn check_panic(c: Checker, cargs: [Expr], line: int, col: int) -> Result<Type, TypeError> {
    b_arity("panic", 1, "", len(cargs), line, col)?;
    let a = check_args_types(c, cargs)?;
    want_string(a, cargs, 0, "panic espera un string, no ")?;
    Result.Ok(Type.TUnit)
}

// __parse_int/__parse_float(s: string) -> [T] (M14.6c): primitivos que devuelven [] / [n]. Los
// envoltorios `parse_int`/`parse_float` del prelude los traducen a Option. `elem` es int o float.
fn check_parse_prim(c: Checker, name: string, elem: Type, cargs: [Expr], line: int, col: int) -> Result<Type, TypeError> {
    b_arity(name, 1, "", len(cargs), line, col)?;
    let a = check_args_types(c, cargs)?;
    want_string(a, cargs, 0, name + " espera un string, no ")?;
    Result.Ok(Type.TArray(elem))
}

// __read_file(ruta: string) -> [string] (M14.6d): ["ok", contenido] / ["err", msg]. read_file → Result.
fn check_read_file(c: Checker, cargs: [Expr], line: int, col: int) -> Result<Type, TypeError> {
    b_arity("__read_file", 1, "", len(cargs), line, col)?;
    let a = check_args_types(c, cargs)?;
    want_string(a, cargs, 0, "__read_file espera un string (la ruta), no ")?;
    Result.Ok(Type.TArray(Type.TString))
}

// __write_file(ruta: string, contenido: string) -> [string] (M14.6d): ["ok"] / ["err", msg].
fn check_write_file(c: Checker, cargs: [Expr], line: int, col: int) -> Result<Type, TypeError> {
    b_arity("__write_file", 2, " (ruta, contenido)", len(cargs), line, col)?;
    let a = check_args_types(c, cargs)?;
    want_string(a, cargs, 0, "__write_file espera un string (la ruta), no ")?;
    want_string(a, cargs, 1, "__write_file espera un string (el contenido), no ")?;
    Result.Ok(Type.TArray(Type.TString))
}

// exists(ruta: string) -> bool (M14.6d): total, no falla.
fn check_exists(c: Checker, cargs: [Expr], line: int, col: int) -> Result<Type, TypeError> {
    b_arity("exists", 1, "", len(cargs), line, col)?;
    let a = check_args_types(c, cargs)?;
    want_string(a, cargs, 0, "exists espera un string (la ruta), no ")?;
    Result.Ok(Type.TBool)
}

fn check_trim(c: Checker, cargs: [Expr], line: int, col: int) -> Result<Type, TypeError> {
    b_arity("trim", 1, "", len(cargs), line, col)?;
    let a = check_args_types(c, cargs)?;
    want_string(a, cargs, 0, "trim espera un string, no ")?;
    Result.Ok(Type.TString)
}

fn check_to_upper(c: Checker, cargs: [Expr], line: int, col: int) -> Result<Type, TypeError> {
    b_arity("to_upper", 1, "", len(cargs), line, col)?;
    let a = check_args_types(c, cargs)?;
    want_string(a, cargs, 0, "to_upper espera un string, no ")?;
    Result.Ok(Type.TString)
}

fn check_to_lower(c: Checker, cargs: [Expr], line: int, col: int) -> Result<Type, TypeError> {
    b_arity("to_lower", 1, "", len(cargs), line, col)?;
    let a = check_args_types(c, cargs)?;
    want_string(a, cargs, 0, "to_lower espera un string, no ")?;
    Result.Ok(Type.TString)
}

fn check_chars(c: Checker, cargs: [Expr], line: int, col: int) -> Result<Type, TypeError> {
    b_arity("chars", 1, "", len(cargs), line, col)?;
    let a = check_args_types(c, cargs)?;
    want_string(a, cargs, 0, "chars espera un string, no ")?;
    Result.Ok(Type.TArray(Type.TChar))
}

fn check_split(c: Checker, cargs: [Expr], line: int, col: int) -> Result<Type, TypeError> {
    b_arity("split", 2, " (string, separador)", len(cargs), line, col)?;
    let a = check_args_types(c, cargs)?;
    want_string(a, cargs, 0, "split espera un string como primer argumento, no ")?;
    want_string(a, cargs, 1, "split espera un string como separador, no ")?;
    Result.Ok(Type.TArray(Type.TString))
}

fn check_replace(c: Checker, cargs: [Expr], line: int, col: int) -> Result<Type, TypeError> {
    b_arity("replace", 3, " (string, de, a)", len(cargs), line, col)?;
    let a = check_args_types(c, cargs)?;
    want_string(a, cargs, 0, "replace espera un string como primer argumento, no ")?;
    want_string(a, cargs, 1, "replace espera un string en 'de', no ")?;
    want_string(a, cargs, 2, "replace espera un string en 'a', no ")?;
    Result.Ok(Type.TString)
}

fn check_starts_with(c: Checker, cargs: [Expr], line: int, col: int) -> Result<Type, TypeError> {
    b_arity("starts_with", 2, " (string, prefijo)", len(cargs), line, col)?;
    let a = check_args_types(c, cargs)?;
    want_string(a, cargs, 0, "starts_with espera un string como primer argumento, no ")?;
    want_string(a, cargs, 1, "starts_with espera un string como prefijo, no ")?;
    Result.Ok(Type.TBool)
}

fn check_ends_with(c: Checker, cargs: [Expr], line: int, col: int) -> Result<Type, TypeError> {
    b_arity("ends_with", 2, " (string, sufijo)", len(cargs), line, col)?;
    let a = check_args_types(c, cargs)?;
    want_string(a, cargs, 0, "ends_with espera un string como primer argumento, no ")?;
    want_string(a, cargs, 1, "ends_with espera un string como sufijo, no ")?;
    Result.Ok(Type.TBool)
}

fn check_substring(c: Checker, cargs: [Expr], line: int, col: int) -> Result<Type, TypeError> {
    b_arity("substring", 3, " (string, inicio, fin)", len(cargs), line, col)?;
    let a = check_args_types(c, cargs)?;
    want_string(a, cargs, 0, "substring espera un string como primer argumento, no ")?;
    want_int(a, cargs, 1, "substring espera un int como inicio, no ")?;
    want_int(a, cargs, 2, "substring espera un int como fin, no ")?;
    Result.Ok(Type.TString)
}

fn check_repeat(c: Checker, cargs: [Expr], line: int, col: int) -> Result<Type, TypeError> {
    b_arity("repeat", 2, " (string, veces)", len(cargs), line, col)?;
    let a = check_args_types(c, cargs)?;
    want_string(a, cargs, 0, "repeat espera un string como primer argumento, no ")?;
    want_int(a, cargs, 1, "repeat espera un int como nº de veces, no ")?;
    Result.Ok(Type.TString)
}

fn check_join(c: Checker, cargs: [Expr], line: int, col: int) -> Result<Type, TypeError> {
    b_arity("join", 2, " (arreglo de string, separador)", len(cargs), line, col)?;
    let a = check_args_types(c, cargs)?;
    if (!type_eq(a[0], Type.TArray(Type.TString))) {
        return Result.Err(terr(cargs[0].line, cargs[0].col, "join espera un [string] como primer argumento, no " + type_str(a[0])));
    }
    want_string(a, cargs, 1, "join espera un string como separador, no ")?;
    Result.Ok(Type.TString)
}

// contains(x, y) -> bool: ad-hoc polimórfico. String: ¿subcadena? Arreglo: ¿pertenencia (mismo elem)?
fn check_contains(c: Checker, cargs: [Expr], line: int, col: int) -> Result<Type, TypeError> {
    b_arity("contains", 2, " (string/arreglo, valor)", len(cargs), line, col)?;
    let a = check_args_types(c, cargs)?;
    match (a[0]) {
        Type.TString => { want_string(a, cargs, 1, "contains espera un string como subcadena, no ")?; },
        Type.TArray(elem) => {
            if (!type_eq(a[1], elem)) {
                return Result.Err(terr(cargs[1].line, cargs[1].col, "contains: el arreglo es de " + type_str(elem) + " pero se busca " + type_str(a[1])));
            }
        },
        _ => { return Result.Err(terr(cargs[0].line, cargs[0].col, "contains espera un string o un arreglo, no " + type_str(a[0]))); },
    }
    Result.Ok(Type.TBool)
}

// =====================================================================
// Builtins de Map (M14.6b): map_new/insert/get/contains_key/keys/values. Reglas/mensajes idénticos a
// `src/builtins.rs` (get refleja el envoltorio del prelude: (Map<K,V>, K) -> Option<V>).
// =====================================================================

// map_new() es INDETERMINADO (como `[]`/`None`): su tipo lo fija el esperado (bidireccional).
fn check_map_new(c: Checker, cargs: [Expr], expected: Option<Type>, line: int, col: int) -> Result<Type, TypeError> {
    match (expected) {
        Option.Some(t) => {
            if (len(cargs) != 0) {
                return Result.Err(terr(line, col, "map_new no recibe argumentos"));
            }
            match (map_kv(t)) {
                Option.Some(_) => { ensure_type(c, t, line, col)?; Result.Ok(t) },
                Option.None => Result.Err(terr(line, col, "map_new produce un Map, pero aquí se espera " + type_str(t))),
            }
        },
        Option.None => Result.Err(terr(line, col,
            "no se puede inferir el tipo de map_new; anótalo, p. ej. 'let m: Map<string, int> = map_new()'")),
    }
}

fn check_insert(c: Checker, cargs: [Expr], line: int, col: int) -> Result<Type, TypeError> {
    b_arity("insert", 3, " (mapa, clave, valor)", len(cargs), line, col)?;
    let a = check_args_types(c, cargs)?;
    match (map_kv(a[0])) {
        Option.Some(kv) => {
            if (!type_eq(a[1], kv[0])) {
                return Result.Err(terr(cargs[1].line, cargs[1].col, "insert: la clave del Map es " + type_str(kv[0]) + " pero se pasó " + type_str(a[1])));
            }
            if (!type_eq(a[2], kv[1])) {
                return Result.Err(terr(cargs[2].line, cargs[2].col, "insert: el valor del Map es " + type_str(kv[1]) + " pero se pasó " + type_str(a[2])));
            }
            Result.Ok(Type.TUnit)
        },
        Option.None => Result.Err(terr(cargs[0].line, cargs[0].col, "insert espera un Map como primer argumento, no " + type_str(a[0]))),
    }
}

fn check_contains_key(c: Checker, cargs: [Expr], line: int, col: int) -> Result<Type, TypeError> {
    b_arity("contains_key", 2, " (mapa, clave)", len(cargs), line, col)?;
    let a = check_args_types(c, cargs)?;
    match (map_kv(a[0])) {
        Option.Some(kv) => {
            if (!type_eq(a[1], kv[0])) {
                return Result.Err(terr(cargs[1].line, cargs[1].col, "contains_key: la clave del Map es " + type_str(kv[0]) + " pero se pasó " + type_str(a[1])));
            }
            Result.Ok(Type.TBool)
        },
        Option.None => Result.Err(terr(cargs[0].line, cargs[0].col, "contains_key espera un Map como primer argumento, no " + type_str(a[0]))),
    }
}

// get(m, k) -> Option<V> (envoltorio del prelude en Rust; aquí builtin directo, mismo tipo).
fn check_get(c: Checker, cargs: [Expr], line: int, col: int) -> Result<Type, TypeError> {
    b_arity("get", 2, " (mapa, clave)", len(cargs), line, col)?;
    let a = check_args_types(c, cargs)?;
    match (map_kv(a[0])) {
        Option.Some(kv) => {
            if (!type_eq(a[1], kv[0])) {
                return Result.Err(terr(cargs[1].line, cargs[1].col, "get: la clave del Map es " + type_str(kv[0]) + " pero se pasó " + type_str(a[1])));
            }
            Result.Ok(Type.TNamed("Option", [kv[1]]))
        },
        Option.None => Result.Err(terr(cargs[0].line, cargs[0].col, "get espera un Map como primer argumento, no " + type_str(a[0]))),
    }
}

// remove(m, k) -> Option<V> (envoltorio del prelude; aquí builtin directo, mismo tipo).
fn check_remove(c: Checker, cargs: [Expr], line: int, col: int) -> Result<Type, TypeError> {
    b_arity("remove", 2, " (mapa, clave)", len(cargs), line, col)?;
    let a = check_args_types(c, cargs)?;
    match (map_kv(a[0])) {
        Option.Some(kv) => {
            if (!type_eq(a[1], kv[0])) {
                return Result.Err(terr(cargs[1].line, cargs[1].col, "remove: la clave del Map es " + type_str(kv[0]) + " pero se pasó " + type_str(a[1])));
            }
            Result.Ok(Type.TNamed("Option", [kv[1]]))
        },
        Option.None => Result.Err(terr(cargs[0].line, cargs[0].col, "remove espera un Map como primer argumento, no " + type_str(a[0]))),
    }
}

fn check_keys(c: Checker, cargs: [Expr], line: int, col: int) -> Result<Type, TypeError> {
    b_arity("keys", 1, " (mapa)", len(cargs), line, col)?;
    let a = check_args_types(c, cargs)?;
    match (map_kv(a[0])) {
        Option.Some(kv) => Result.Ok(Type.TArray(kv[0])),
        Option.None => Result.Err(terr(cargs[0].line, cargs[0].col, "keys espera un Map, no " + type_str(a[0]))),
    }
}

fn check_values(c: Checker, cargs: [Expr], line: int, col: int) -> Result<Type, TypeError> {
    b_arity("values", 1, " (mapa)", len(cargs), line, col)?;
    let a = check_args_types(c, cargs)?;
    match (map_kv(a[0])) {
        Option.Some(kv) => Result.Ok(Type.TArray(kv[1])),
        Option.None => Result.Err(terr(cargs[0].line, cargs[0].col, "values espera un Map, no " + type_str(a[0]))),
    }
}

fn call_type(c: Checker, ty: Type, cargs: [Expr], line: int, col: int) -> Result<Type, TypeError> {
    match (ty) {
        Type.TFn(params, ret) => check_args(c, params, ret, cargs, "la función", line, col),
        _ => Result.Err(terr(line, col, "no se puede llamar un valor de tipo " + type_str(ty) + " (no es una función)")),
    }
}

fn check_args(c: Checker, params: [Type], ret: Type, cargs: [Expr], label: string, line: int, col: int) -> Result<Type, TypeError> {
    if (len(cargs) != len(params)) {
        return Result.Err(terr(line, col,
            label + " espera " + to_string(len(params)) + " argumento(s), se le pasaron " + to_string(len(cargs))));
    }
    var i = 0;
    while (i < len(cargs)) {
        // El tipo del parámetro es el esperado del argumento (propaga a `[]`, etc.).
        let at = check_expr_expected(c, cargs[i], params[i])?;
        if (!type_eq(at, params[i])) {
            return Result.Err(terr(cargs[i].line, cargs[i].col,
                "argumento " + to_string(i + 1) + " de " + label + ": se esperaba " + type_str(params[i]) + ", se pasó " + type_str(at)));
        }
        i = i + 1;
    }
    Result.Ok(ret)
}

// `if`. Con un tipo esperado, se propaga a ambas ramas (para construcciones indeterminadas dentro).
fn check_if(c: Checker, cond: Expr, then_b: Block, elseopt: Option<Expr>, expected: Option<Type>, line: int, col: int) -> Result<Type, TypeError> {
    let ct = check_expr(c, cond)?;
    if (!type_eq(ct, Type.TBool)) {
        return Result.Err(terr(cond.line, cond.col, "la condición del if debe ser bool, no " + type_str(ct)));
    }
    let then_ty = check_block_opt(c, then_b, expected)?;
    match (elseopt) {
        Option.None => {
            if (!type_eq(then_ty, Type.TUnit)) {
                return Result.Err(terr(line, col,
                    "un if sin else tiene tipo unit, pero su rama produce " + type_str(then_ty) + " (añade un else)"));
            }
            Result.Ok(Type.TUnit)
        },
        Option.Some(else_e) => {
            let else_ty = check_expr_opt(c, else_e, expected)?;
            if (block_diverges(then_b)) { return Result.Ok(else_ty); }
            if (expr_diverges(else_e)) { return Result.Ok(then_ty); }
            if (!type_eq(then_ty, else_ty)) {
                return Result.Err(terr(line, col,
                    "las ramas del if tienen tipos distintos: " + type_str(then_ty) + " y " + type_str(else_ty)));
            }
            Result.Ok(then_ty)
        },
    }
}

// Chequea una expresión con un tipo esperado opcional: con `Some` propaga (bidireccional), con `None`
// es el chequeo normal. (Evita duplicar cada función en variante con/sin esperado.)
fn check_expr_opt(c: Checker, e: Expr, expected: Option<Type>) -> Result<Type, TypeError> {
    match (expected) {
        Option.Some(exp) => check_expr_expected(c, e, exp),
        Option.None => check_expr(c, e),
    }
}

// Como `check_expr_opt`, pero para un bloque.
fn check_block_opt(c: Checker, b: Block, expected: Option<Type>) -> Result<Type, TypeError> {
    match (expected) {
        Option.Some(exp) => check_block_expected(c, b, exp),
        Option.None => check_block(c, b),
    }
}

fn check_while(c: Checker, cond: Expr, body: Block, line: int, col: int) -> Result<Type, TypeError> {
    let ct = check_expr(c, cond)?;
    if (!type_eq(ct, Type.TBool)) {
        return Result.Err(terr(cond.line, cond.col, "la condición del while debe ser bool, no " + type_str(ct)));
    }
    check_block(c, body)?;
    Result.Ok(Type.TUnit)
}

// Verifica un bloque en su propio ámbito y devuelve su tipo-valor (la expresión final, o unit).
fn check_block(c: Checker, block: Block) -> Result<Type, TypeError> {
    push_scope(c);
    var i = 0;
    while (i < len(block.stmts)) {
        check_stmt(c, block.stmts[i])?;
        i = i + 1;
    }
    var ty = Type.TUnit;
    match (block.tail) {
        Option.Some(e) => { ty = check_expr(c, e)?; },
        Option.None => {},
    }
    pop_scope(c);
    Result.Ok(ty)
}

// Como `check_block`, pero el valor final (la *tail*) se verifica con un tipo esperado.
fn check_block_expected(c: Checker, block: Block, expected: Type) -> Result<Type, TypeError> {
    push_scope(c);
    var i = 0;
    while (i < len(block.stmts)) {
        check_stmt(c, block.stmts[i])?;
        i = i + 1;
    }
    var ty = Type.TUnit;
    match (block.tail) {
        Option.Some(e) => { ty = check_expr_expected(c, e, expected)?; },
        Option.None => {},
    }
    pop_scope(c);
    Result.Ok(ty)
}

// =====================================================================
// Datos: arreglos, structs, enums, match (M14.3b)
// =====================================================================

// Un literal de arreglo `[e0, e1, ...]`. Todos los elementos deben ser del mismo tipo. El vacío `[]`
// es indeterminado aquí (necesita un tipo esperado, vía `check_expr_expected`).
fn check_array(c: Checker, elems: [Expr], line: int, col: int) -> Result<Type, TypeError> {
    if (len(elems) == 0) {
        return Result.Err(terr(line, col, "no se puede inferir el tipo de [] aquí; anótalo (p. ej. let xs: [int] = [];)"));
    }
    let first = check_expr(c, elems[0])?;
    var i = 1;
    while (i < len(elems)) {
        let t = check_expr(c, elems[i])?;
        if (!type_eq(t, first)) {
            return Result.Err(terr(elems[i].line, elems[i].col,
                "los elementos del arreglo deben ser del mismo tipo: " + type_str(first) + " y " + type_str(t)));
        }
        i = i + 1;
    }
    Result.Ok(Type.TArray(first))
}

// Indexar `a[i]`: el índice debe ser int; el receptor un arreglo (da el elemento) o un string (da
// char). Reusado por la indexación como expresión y como destino de asignación.
fn check_index(c: Checker, array: Expr, index: Expr) -> Result<Type, TypeError> {
    let at = check_expr(c, array)?;
    let it = check_expr(c, index)?;
    if (!type_eq(it, Type.TInt)) {
        return Result.Err(terr(index.line, index.col, "el índice debe ser int, no " + type_str(it)));
    }
    match (at) {
        Type.TArray(elem) => Result.Ok(elem),
        Type.TString => Result.Ok(Type.TChar),
        _ => Result.Err(terr(array.line, array.col, "no se puede indexar un " + type_str(at) + " (no es un arreglo ni un string)")),
    }
}

// `obj.name`: el objeto debe ser un struct y `name` uno de sus campos. Para un struct genérico, el
// tipo del campo se SUSTITUYE con los args de tipo del objeto (el campo `primero: A` de
// `Par<int, bool>` es int).
fn check_field(c: Checker, object: Expr, name: string) -> Result<Type, TypeError> {
    let ot = check_expr(c, object)?;
    match (ot) {
        Type.TNamed(sname, targs) => {
            match (get(c.structs, sname)) {
                Option.Some(fields) => {
                    match (find_field(fields, name)) {
                        Option.Some(fty) => {
                            let sigma = build_sigma(struct_tparams(c, sname), targs);
                            Result.Ok(subst(fty, sigma))
                        },
                        Option.None => Result.Err(terr(object.line, object.col, "el struct '" + sname + "' no tiene un campo '" + name + "'")),
                    }
                },
                Option.None => Result.Err(terr(object.line, object.col, "no se puede acceder a '." + name + "' en un " + type_str(ot) + " (no es un struct)")),
            }
        },
        _ => Result.Err(terr(object.line, object.col, "no se puede acceder a '." + name + "' en un " + type_str(ot) + " (no es un struct)")),
    }
}

// Los parámetros de tipo de un struct/enum registrado (lista vacía si monomórfico o desconocido).
fn struct_tparams(c: Checker, name: string) -> [string] {
    match (get(c.struct_tparams, name)) { Option.Some(tp) => tp, Option.None => no_tparams() }
}
fn enum_tparams(c: Checker, name: string) -> [string] {
    match (get(c.enum_tparams, name)) { Option.Some(tp) => tp, Option.None => no_tparams() }
}

// σ que liga cada parámetro de tipo con su argumento (zip), para sustituir campos/payloads.
fn build_sigma(tparams: [string], targs: [Type]) -> Map<string, Type> {
    let sigma: Map<string, Type> = map_new();
    var i = 0;
    while (i < len(tparams) && i < len(targs)) {
        insert(sigma, tparams[i], targs[i]);
        i = i + 1;
    }
    sigma
}

// Siembra σ desde el tipo esperado: si se espera `Nombre<a, b>` (misma aridad), liga cada parámetro
// con su argumento esperado. Así `Caja.Vacia` con esperado `Caja<int>` fija `T = int`.
fn seed_sigma_from_expected(expected: Option<Type>, name: string, tparams: [string]) -> Map<string, Type> {
    let sigma: Map<string, Type> = map_new();
    match (expected) {
        Option.Some(t) => {
            match (t) {
                Type.TNamed(en, eargs) => {
                    if (en == name && len(eargs) == len(tparams)) {
                        var i = 0;
                        while (i < len(tparams)) { insert(sigma, tparams[i], eargs[i]); i = i + 1; }
                    }
                },
                _ => {},
            }
        },
        Option.None => {},
    }
    sigma
}

// ¿Contiene `t` alguna variable de tipo sin resolver (un `TNamed(n, [])` con `n` en `holes`)?
fn type_has_var(t: Type, holes: [string]) -> bool {
    match (t) {
        Type.TNamed(n, args) => {
            if (len(args) == 0 && contains_str(holes, n)) { true }
            else { types_have_var(args, holes) }
        },
        Type.TArray(e) => type_has_var(e, holes),
        Type.TFn(ps, r) => types_have_var(ps, holes) || type_has_var(r, holes),
        _ => false,
    }
}
fn types_have_var(ts: [Type], holes: [string]) -> bool {
    var i = 0;
    while (i < len(ts)) {
        if (type_has_var(ts[i], holes)) { return true; }
        i = i + 1;
    }
    false
}

// Verifica el valor de un campo/payload propagándole como esperado el tipo declarado ya sustituido
// con lo inferido (σ), pero solo si ese tipo es concreto (sin incógnitas); si aún tiene variables,
// no aporta y se chequea normal.
fn check_value_against(c: Checker, value: Expr, declared: Type, sigma: Map<string, Type>, holes: [string]) -> Result<Type, TypeError> {
    let exp = subst(declared, sigma);
    if (type_has_var(exp, holes)) { check_expr(c, value) }
    else { check_expr_expected(c, value, exp) }
}

// Para cada parámetro de tipo, recupera lo inferido en σ (en orden), o error si quedó indeterminado.
fn finalize_type_args(tparams: [string], sigma: Map<string, Type>, label: string, line: int, col: int) -> Result<[Type], TypeError> {
    var targs: [Type] = [];
    var i = 0;
    while (i < len(tparams)) {
        match (get(sigma, tparams[i])) {
            Option.Some(t) => { push(targs, t); },
            Option.None => {
                return Result.Err(terr(line, col,
                    "no se pudo inferir el parámetro de tipo '" + tparams[i] + "' de " + label + "; anota el tipo"));
            },
        }
        i = i + 1;
    }
    Result.Ok(targs)
}

// El tipo del campo `name` en una lista de campos (`None` si no existe).
fn find_field(fields: [FieldDef], name: string) -> Option<Type> {
    var i = 0;
    while (i < len(fields)) {
        if (fields[i].name == name) { return Option.Some(fields[i].ty); }
        i = i + 1;
    }
    Option.None
}

// Un literal de struct `Nombre { campo: valor, ... }`. Cada campo declarado debe estar exactamente
// una vez; no debe haber campos desconocidos. Para un struct genérico, infiere los args de tipo de
// los valores (y del tipo esperado). Devuelve `TNamed(name, targs)`.
fn check_struct_lit(c: Checker, name: string, fields: [FieldInit], expected: Option<Type>, line: int, col: int) -> Result<Type, TypeError> {
    match (get(c.structs, name)) {
        Option.None => Result.Err(terr(line, col, "struct '" + name + "' no declarado")),
        Option.Some(declared) => {
            let tparams = struct_tparams(c, name);
            // No debe haber campos desconocidos.
            var i = 0;
            while (i < len(fields)) {
                let fi = fields[i];
                if (!field_declared(declared, fi.name)) {
                    return Result.Err(terr(fi.value.line, fi.value.col, "'" + name + "' no tiene un campo '" + fi.name + "'"));
                }
                i = i + 1;
            }
            // σ se siembra del tipo esperado; cada valor unifica los parámetros de tipo del struct.
            let sigma = seed_sigma_from_expected(expected, name, tparams);
            var di = 0;
            while (di < len(declared)) {
                let df = declared[di];
                let cnt = count_field(fields, df.name);
                if (cnt == 0) {
                    return Result.Err(terr(line, col, "falta el campo '" + df.name + "' en el literal de '" + name + "'"));
                }
                if (cnt > 1) {
                    return Result.Err(terr(line, col, "campo '" + df.name + "' de '" + name + "' repetido"));
                }
                let value = field_value(fields, df.name);
                let vt = check_value_against(c, value, df.ty, sigma, tparams)?;
                match (unify(df.ty, vt, sigma, tparams)) {
                    Result.Ok(_) => {},
                    Result.Err(reason) => {
                        return Result.Err(terr(value.line, value.col, "campo '" + df.name + "' de '" + name + "': " + reason));
                    },
                }
                di = di + 1;
            }
            let targs = finalize_type_args(tparams, sigma, "el struct '" + name + "'", line, col)?;
            Result.Ok(Type.TNamed(name, targs))
        },
    }
}

// ¿Está `name` entre los campos declarados?
fn field_declared(declared: [FieldDef], name: string) -> bool {
    var i = 0;
    while (i < len(declared)) {
        if (declared[i].name == name) { return true; }
        i = i + 1;
    }
    false
}

// Cuántas veces aparece el campo `name` en el literal (para detectar faltantes/repetidos).
fn count_field(fields: [FieldInit], name: string) -> int {
    var n = 0;
    var i = 0;
    while (i < len(fields)) {
        if (fields[i].name == name) { n = n + 1; }
        i = i + 1;
    }
    n
}

// El valor (la primera aparición) del campo `name` en el literal (existe: se llamó con cnt == 1).
fn field_value(fields: [FieldInit], name: string) -> Expr {
    var i = 0;
    while (i < len(fields)) {
        if (fields[i].name == name) { return fields[i].value; }
        i = i + 1;
    }
    fields[0].value
}

// Construcción de una variante de enum `Enum.Variante(args)`. La variante debe existir y el payload
// (aridad + tipos) debe encajar. Para un enum genérico infiere los args de tipo del payload (y del
// tipo esperado, p. ej. `Caja.Vacia`). Devuelve `TNamed(enum_name, targs)`.
fn check_enum_lit(c: Checker, enum_name: string, variant: string, cargs: [Expr], expected: Option<Type>, line: int, col: int) -> Result<Type, TypeError> {
    match (get(c.enums, enum_name)) {
        Option.None => Result.Err(terr(line, col, "enum '" + enum_name + "' no declarado")),
        Option.Some(variants) => {
            match (find_variant(variants, variant)) {
                Option.None => Result.Err(terr(line, col, "el enum '" + enum_name + "' no tiene la variante '" + variant + "'")),
                Option.Some(payload) => {
                    if (len(cargs) != len(payload)) {
                        return Result.Err(terr(line, col, "la variante '" + enum_name + "." + variant
                            + "' espera " + to_string(len(payload)) + " argumento(s), se dieron " + to_string(len(cargs))));
                    }
                    let tparams = enum_tparams(c, enum_name);
                    let sigma = seed_sigma_from_expected(expected, enum_name, tparams);
                    var i = 0;
                    while (i < len(cargs)) {
                        let pty = payload[i];
                        let at = check_value_against(c, cargs[i], pty, sigma, tparams)?;
                        match (unify(pty, at, sigma, tparams)) {
                            Result.Ok(_) => {},
                            Result.Err(reason) => {
                                return Result.Err(terr(cargs[i].line, cargs[i].col,
                                    "'" + enum_name + "." + variant + "': " + reason));
                            },
                        }
                        i = i + 1;
                    }
                    let targs = finalize_type_args(tparams, sigma, "la variante '" + enum_name + "." + variant + "'", line, col)?;
                    Result.Ok(Type.TNamed(enum_name, targs))
                },
            }
        },
    }
}

// El payload de la variante `name` en una lista de variantes (`None` si no existe).
fn find_variant(variants: [VariantDef], name: string) -> Option<[Type]> {
    var i = 0;
    while (i < len(variants)) {
        if (variants[i].name == name) { return Option.Some(variants[i].payload); }
        i = i + 1;
    }
    Option.None
}

// `match (escrutinio) { patrón => cuerpo, ... }`. El escrutinio debe ser un enum; cada patrón debe
// pertenecer a ese enum (aridad correcta); los brazos convergen a un tipo común; debe ser exhaustivo.
fn check_match(c: Checker, scrut: Expr, arms: [MatchArm], expected: Option<Type>, line: int, col: int) -> Result<Type, TypeError> {
    let scrut_ty = check_expr(c, scrut)?;
    var enum_name = "";
    var enum_targs: [Type] = [];
    match (scrut_ty) {
        Type.TNamed(n, targs) => {
            if (is_enum(c, n)) { enum_name = n; enum_targs = targs; }
            else { return Result.Err(terr(scrut.line, scrut.col, "match requiere un enum, pero el escrutinio es " + type_str(scrut_ty))); }
        },
        _ => { return Result.Err(terr(scrut.line, scrut.col, "match requiere un enum, pero el escrutinio es " + type_str(scrut_ty))); },
    }
    if (len(arms) == 0) {
        return Result.Err(terr(line, col, "un match no puede estar vacío"));
    }
    let variants = enum_variants(c, enum_name);
    // σ del enum: liga sus parámetros de tipo con los args del escrutinio, para sustituir los payloads
    // (`Some(T)` sobre `Option<int>` liga `T = int`).
    let enum_sigma = build_sigma(enum_tparams(c, enum_name), enum_targs);
    let st = MatchState { covered: [], catchall: false };
    var result_ty: Option<Type> = Option.None;
    var ai = 0;
    while (ai < len(arms)) {
        let arm = arms[ai];
        if (st.catchall) {
            return Result.Err(terr(arm.line, arm.col, "brazo inalcanzable: un brazo anterior ya cubre todos los casos"));
        }
        let binds = check_pattern(c, arm.pat, scrut_ty, enum_name, variants, enum_sigma, st)?;
        push_scope(c);
        var bi = 0;
        while (bi < len(binds)) {
            declare(c, binds[bi].name, binds[bi].ty, false, arm.line, arm.col);
            bi = bi + 1;
        }
        let body_ty = check_expr_opt(c, arm.body, expected)?;
        pop_scope(c);
        // Un brazo que diverge (panic/return) no fija el tipo del match; lo ceden los demás.
        if (!expr_diverges(arm.body)) {
            match (result_ty) {
                Option.None => { result_ty = Option.Some(body_ty); },
                Option.Some(prev) => {
                    if (!type_eq(prev, body_ty)) {
                        return Result.Err(terr(arm.body.line, arm.body.col,
                            "los brazos del match producen tipos distintos: " + type_str(prev) + " y " + type_str(body_ty)));
                    }
                },
            }
        }
        ai = ai + 1;
    }
    // Exhaustividad: sin catch-all, deben estar TODAS las variantes.
    if (!st.catchall) {
        var missing: [string] = [];
        var vi = 0;
        while (vi < len(variants)) {
            let vname = variants[vi].name;
            if (!contains_str(st.covered, vname)) { push(missing, vname); }
            vi = vi + 1;
        }
        if (len(missing) > 0) {
            return Result.Err(terr(line, col, "match no exhaustivo en '" + enum_name + "': faltan las variantes: " + join_comma(missing)));
        }
    }
    match (result_ty) {
        Option.Some(t) => Result.Ok(t),
        Option.None => Result.Ok(Type.TUnit),
    }
}

// Comprueba un patrón contra el enum del escrutinio. Devuelve las variables que liga (para el cuerpo
// del brazo). Actualiza el estado (variantes cubiertas, catch-all) por referencia.
fn check_pattern(c: Checker, pat: Pattern, scrut_ty: Type, enum_name: string, variants: [VariantDef], enum_sigma: Map<string, Type>, st: MatchState) -> Result<[Bind], TypeError> {
    match (pat.kind) {
        PKind.PWild => { st.catchall = true; Result.Ok([]) },
        PKind.PBind(name) => {
            // Liga el escrutinio completo; cubre todo lo restante.
            st.catchall = true;
            var binds: [Bind] = [];
            push(binds, Bind { name: name, ty: scrut_ty });
            Result.Ok(binds)
        },
        PKind.PVariant(pat_enum, variant, bindings) => {
            if (pat_enum != enum_name) {
                return Result.Err(terr(pat.line, pat.col, "el patrón es del enum '" + pat_enum + "', pero el escrutinio es '" + enum_name + "'"));
            }
            match (find_variant(variants, variant)) {
                Option.None => Result.Err(terr(pat.line, pat.col, "el enum '" + enum_name + "' no tiene la variante '" + variant + "'")),
                Option.Some(payload) => {
                    if (len(bindings) != len(payload)) {
                        return Result.Err(terr(pat.line, pat.col, "el patrón '" + enum_name + "." + variant
                            + "' liga " + to_string(len(bindings)) + " valor(es), pero la variante tiene " + to_string(len(payload))));
                    }
                    if (contains_str(st.covered, variant)) {
                        return Result.Err(terr(pat.line, pat.col, "la variante '" + variant + "' ya está cubierta por un brazo anterior"));
                    }
                    push(st.covered, variant);
                    // Cada sub-binding liga el payload ya SUSTITUIDO con los args de tipo del
                    // escrutinio (`x` en `Some(x)` sobre `Option<int>` es int).
                    var binds: [Bind] = [];
                    var i = 0;
                    while (i < len(bindings)) {
                        match (bindings[i]) {
                            Option.Some(bn) => { push(binds, Bind { name: bn, ty: subst(payload[i], enum_sigma) }); },
                            Option.None => {},
                        }
                        i = i + 1;
                    }
                    Result.Ok(binds)
                },
            }
        },
    }
}

// =====================================================================
// Traits e impls (M14.3d-2: despacho estático, Self, métodos por defecto)
// =====================================================================

// Nombre manglado de un método: `Tipo#metodo` (`#` ilegal en identificadores → no choca con nombres
// del usuario). Es la clave de la tabla de métodos y el nombre que aparece en los errores de llamada.
fn mangle(type_key: string, method: string) -> string { type_key + "#" + method }

// Clave de tipo para la tabla de métodos: el nombre del struct/enum o el primitivo. `None` para los
// tipos que no pueden recibir un impl (arreglos, funciones, unit, Self).
fn type_key_of(t: Type) -> Option<string> {
    match (t) {
        Type.TInt => Option.Some("int"),
        Type.TFloat => Option.Some("float"),
        Type.TBool => Option.Some("bool"),
        Type.TString => Option.Some("string"),
        Type.TChar => Option.Some("char"),
        Type.TNamed(n, _) => Option.Some(n),
        _ => Option.None,
    }
}

// Sustituye `Self` (`TNamed("Self", [])`) por el tipo implementador, recursivamente.
fn subst_self(ty: Type, target: Type) -> Type {
    match (ty) {
        Type.TNamed(n, args) => {
            if (n == "Self" && len(args) == 0) { target }
            else {
                var ra: [Type] = [];
                var i = 0;
                while (i < len(args)) { push(ra, subst_self(args[i], target)); i = i + 1; }
                Type.TNamed(n, ra)
            }
        },
        Type.TArray(e) => Type.TArray(subst_self(e, target)),
        Type.TFn(ps, r) => {
            var rps: [Type] = [];
            var i = 0;
            while (i < len(ps)) { push(rps, subst_self(ps[i], target)); i = i + 1; }
            Type.TFn(rps, subst_self(r, target))
        },
        _ => ty,
    }
}

fn is_primitive(t: Type) -> bool {
    match (t) {
        Type.TInt => true, Type.TFloat => true, Type.TBool => true, Type.TString => true, Type.TChar => true,
        _ => false,
    }
}

// ¿La firma de trait `tm` trae cuerpo por defecto?
fn has_default(tm: MethodSig) -> bool {
    match (tm.default_body) { Option.Some(_) => true, Option.None => false }
}

// La firma de trait con nombre `name` (o `None`).
fn find_method_sig(methods: [MethodSig], name: string) -> Option<MethodSig> {
    var i = 0;
    while (i < len(methods)) {
        if (methods[i].name == name) { return Option.Some(methods[i]); }
        i = i + 1;
    }
    Option.None
}

// ¿El impl redefine el método `name`?
fn impl_overrides(imp: ImplBlock, name: string) -> bool {
    var i = 0;
    while (i < len(imp.methods)) {
        if (imp.methods[i].name == name) { return true; }
        i = i + 1;
    }
    false
}

// La FnSig de un método (params con Self→target, self incluido; ret con Self→target). Un impl concreto
// pasa type_params/bounds vacíos; un impl genérico (M9.2b) pasa los suyos → el método ES una función
// genérica acotada (`Caja#medir<T: Medir>(self: Caja<T>)`), resuelta con la misma inferencia/bounds.
fn method_fnsig(params: [Param], ret: Type, target: Type, type_params: [string], bounds: [Bound]) -> FnSig {
    var ps: [Type] = [];
    var i = 0;
    while (i < len(params)) { push(ps, resolve_type(subst_self(params[i].ty, target))); i = i + 1; }
    FnSig { params: ps, ret: resolve_type(subst_self(ret, target)), type_params: type_params, bounds: bounds }
}

// Registra los traits (firmas) y valida + tabula los impls. M14.3d-2: solo impls CONCRETOS (genéricos
// y bounds → d-3). Mismo orden/mensajes que Rust.
fn register_traits_impls(c: Checker, prog: Program) -> Result<int, TypeError> {
    // 1) Traits: nombres únicos (no chocan con tipos), métodos únicos.
    var ti = 0;
    while (ti < len(prog.traits)) {
        let t = prog.traits[ti];
        if (contains_key(c.structs, t.name) || contains_key(c.enums, t.name)) {
            return Result.Err(terr(t.line, t.col, "'" + t.name + "' ya es un tipo; no puede ser también un trait"));
        }
        if (contains_key(c.traits, t.name)) {
            return Result.Err(terr(t.line, t.col, "trait '" + t.name + "' declarado dos veces"));
        }
        var seen: [string] = [];
        var mi = 0;
        while (mi < len(t.methods)) {
            let m = t.methods[mi];
            if (contains_str(seen, m.name)) {
                return Result.Err(terr(m.line, m.col, "método '" + m.name + "' repetido en el trait '" + t.name + "'"));
            }
            push(seen, m.name);
            mi = mi + 1;
        }
        insert(c.traits, t.name, t.methods);
        ti = ti + 1;
    }
    // 2) Impls: validar contra su trait y poblar la tabla de métodos.
    var ii = 0;
    while (ii < len(prog.impls)) {
        register_impl(c, prog.impls[ii])?;
        ii = ii + 1;
    }
    Result.Ok(0)
}

fn register_impl(c: Checker, imp: ImplBlock) -> Result<int, TypeError> {
    let trait_methods = match (get(c.traits, imp.trait_name)) {
        Option.Some(ms) => ms,
        Option.None => { return Result.Err(terr(imp.line, imp.col, "trait '" + imp.trait_name + "' no declarado")); },
    };
    // M9.2b: los parámetros de tipo del impl entran en ámbito (`Caja<T>` y `x: T` válidos).
    c.tparams = imp.type_params;
    check_impl_bounds(c, imp)?;
    let target = resolve_type(imp.target);
    ensure_impl_target(c, target, imp.type_params, imp.line, imp.col)?;
    let key = type_key_str(target);
    // Nombres del impl sin repetir.
    var impl_names: [string] = [];
    var mi = 0;
    while (mi < len(imp.methods)) {
        let m = imp.methods[mi];
        if (contains_str(impl_names, m.name)) {
            return Result.Err(terr(m.line, m.col, "método '" + m.name + "' implementado dos veces"));
        }
        push(impl_names, m.name);
        mi = mi + 1;
    }
    // Cobertura: no faltan métodos del trait (salvo los que tienen defecto).
    var tj = 0;
    while (tj < len(trait_methods)) {
        let tm = trait_methods[tj];
        if (!contains_str(impl_names, tm.name) && !has_default(tm)) {
            return Result.Err(terr(imp.line, imp.col, "el impl de '" + imp.trait_name + "' para "
                + type_str(target) + " no implementa el método '" + tm.name + "'"));
        }
        tj = tj + 1;
    }
    // Métodos del impl: pertenecen al trait, firmas casan, registrar.
    mi = 0;
    while (mi < len(imp.methods)) {
        let m = imp.methods[mi];
        match (find_method_sig(trait_methods, m.name)) {
            Option.None => { return Result.Err(terr(m.line, m.col, "el trait '" + imp.trait_name + "' no declara un método '" + m.name + "'")); },
            Option.Some(tm) => {
                check_method_sig(tm, m, target)?;
                let mangled = mangle(key, m.name);
                if (contains_key(c.methods, mangled)) {
                    return Result.Err(terr(m.line, m.col, "método '" + m.name + "' ambiguo para " + type_str(target) + ": ya hay un impl que lo provee"));
                }
                insert(c.methods, mangled, method_fnsig(m.params, m.ret, target, imp.type_params, imp.bounds));
            },
        }
        mi = mi + 1;
    }
    // Defectos no redefinidos: también van a la tabla de resolución.
    tj = 0;
    while (tj < len(trait_methods)) {
        let tm = trait_methods[tj];
        if (has_default(tm) && !contains_str(impl_names, tm.name)) {
            let mangled = mangle(key, tm.name);
            if (contains_key(c.methods, mangled)) {
                return Result.Err(terr(imp.line, imp.col, "método '" + tm.name + "' ambiguo para " + type_str(target) + ": ya hay un impl que lo provee"));
            }
            insert(c.methods, mangled, method_fnsig(tm.params, tm.ret, target, imp.type_params, imp.bounds));
        }
        tj = tj + 1;
    }
    // Registrar que este tipo implementa este trait (M14.3d-3: satisfacción de bounds).
    insert(c.impl_traits, mangle(key, imp.trait_name), true);
    c.tparams = no_tparams();
    Result.Ok(0)
}

// Valida los bounds de un impl genérico: cada bound acota un parámetro de tipo que el impl declara,
// con un trait existente. (Análogo a `check_bounds` para funciones.)
fn check_impl_bounds(c: Checker, imp: ImplBlock) -> Result<int, TypeError> {
    var i = 0;
    while (i < len(imp.bounds)) {
        let b = imp.bounds[i];
        if (!contains_str(imp.type_params, b.param)) {
            return Result.Err(terr(imp.line, imp.col, "el bound '" + b.param + ": " + b.trait_name + "' menciona un parámetro de tipo que el impl no declara"));
        }
        if (!contains_key(c.traits, b.trait_name)) {
            return Result.Err(terr(imp.line, imp.col, "el bound '" + b.param + ": " + b.trait_name + "' usa un trait no declarado"));
        }
        i = i + 1;
    }
    Result.Ok(0)
}

// La clave de tipo de un objetivo de impl ya validado (siempre existe).
fn type_key_str(t: Type) -> string {
    match (type_key_of(t)) { Option.Some(k) => k, Option.None => "" }
}

// =====================================================================
// @derive y anotaciones (M14.3d-4c)
// =====================================================================

// Genera los impls de `@derive(Eq, Show)` sobre struct/enum no genérico: registra los métodos
// derivados (`igual`/`mostrar`) y la marca en `impl_traits`. En Rust se genera el FUENTE del impl y se
// baja con M9; el validador solo necesita las firmas (no chequea el cuerpo: es codegen conocido).
fn generate_derives(c: Checker, prog: Program) -> Result<int, TypeError> {
    var si = 0;
    while (si < len(prog.structs)) {
        let s = prog.structs[si];
        generate_derives_for(c, s.annotations, s.name, s.type_params)?;
        si = si + 1;
    }
    var ei = 0;
    while (ei < len(prog.enums)) {
        let e = prog.enums[ei];
        generate_derives_for(c, e.annotations, e.name, e.type_params)?;
        ei = ei + 1;
    }
    Result.Ok(0)
}

fn generate_derives_for(c: Checker, annotations: [Annotation], name: string, type_params: [string]) -> Result<int, TypeError> {
    var i = 0;
    while (i < len(annotations)) {
        let a = annotations[i];
        if (a.name == "derive") {
            validate_derive(a, name, type_params)?;
            var j = 0;
            while (j < len(a.args)) {
                register_derived_impl(c, name, a.args[j]);
                j = j + 1;
            }
        }
        i = i + 1;
    }
    Result.Ok(0)
}

// Valida `@derive(...)`: argumentos no vacíos, todos derivables (Eq/Show), tipo no genérico.
fn validate_derive(a: Annotation, name: string, type_params: [string]) -> Result<int, TypeError> {
    if (len(a.args) == 0) {
        return Result.Err(terr(a.line, a.col, "'@derive' requiere al menos un trait (p. ej. @derive(Eq))"));
    }
    var i = 0;
    while (i < len(a.args)) {
        if (a.args[i] != "Eq" && a.args[i] != "Show") {
            return Result.Err(terr(a.line, a.col, "no se sabe derivar '" + a.args[i] + "' (por ahora Eq y Show)"));
        }
        i = i + 1;
    }
    if (len(type_params) != 0) {
        return Result.Err(terr(a.line, a.col, "no se puede derivar para el tipo genérico '" + name + "'"));
    }
    Result.Ok(0)
}

// Registra el impl derivado de un trait (`Eq`→`igual`, `Show`→`mostrar`) para un tipo. Idempotente:
// si ya hay un impl (del usuario o derivado), no lo pisa.
fn register_derived_impl(c: Checker, type_name: string, trait_name: string) {
    if (contains_key(c.impl_traits, mangle(type_name, trait_name))) { return; }
    let target = Type.TNamed(type_name, []);
    if (trait_name == "Eq") {
        insert(c.methods, mangle(type_name, "igual"), FnSig { params: [target, target], ret: Type.TBool, type_params: no_tparams(), bounds: no_bounds() });
    }
    if (trait_name == "Show") {
        insert(c.methods, mangle(type_name, "mostrar"), FnSig { params: [target], ret: Type.TString, type_params: no_tparams(), bounds: no_bounds() });
    }
    insert(c.impl_traits, mangle(type_name, trait_name), true);
}

// Valida las anotaciones: `@test` solo en funciones `() -> bool`/`() -> unit`; `@derive` solo en tipos;
// cualquier otra es desconocida.
fn check_annotations(c: Checker, prog: Program) -> Result<int, TypeError> {
    var fi = 0;
    while (fi < len(prog.funcs)) {
        let f = prog.funcs[fi];
        var ai = 0;
        while (ai < len(f.annotations)) {
            let a = f.annotations[ai];
            if (a.name == "test") {
                if (len(a.args) != 0) { return Result.Err(terr(a.line, a.col, "'@test' no recibe argumentos")); }
                if (len(f.params) != 0) { return Result.Err(terr(a.line, a.col, "la función de prueba '@test' '" + f.name + "' no debe recibir parámetros")); }
                let ret = resolve_type(f.ret);
                if (!type_eq(ret, Type.TBool) && !type_eq(ret, Type.TUnit)) {
                    return Result.Err(terr(a.line, a.col, "una función '@test' debe devolver bool o unit, no " + type_str(f.ret)));
                }
            } else if (a.name == "derive") {
                return Result.Err(terr(a.line, a.col, "'@derive' solo se permite sobre struct o enum"));
            } else {
                return Result.Err(terr(a.line, a.col, "anotación desconocida: '@" + a.name + "'"));
            }
            ai = ai + 1;
        }
        fi = fi + 1;
    }
    var si = 0;
    while (si < len(prog.structs)) {
        check_type_annotations(prog.structs[si].annotations)?;
        si = si + 1;
    }
    var ei = 0;
    while (ei < len(prog.enums)) {
        check_type_annotations(prog.enums[ei].annotations)?;
        ei = ei + 1;
    }
    Result.Ok(0)
}

fn check_type_annotations(annotations: [Annotation]) -> Result<int, TypeError> {
    var i = 0;
    while (i < len(annotations)) {
        let a = annotations[i];
        if (a.name == "derive") {
            // ok: ya validada/generada en generate_derives.
        } else if (a.name == "test") {
            return Result.Err(terr(a.line, a.col, "'@test' solo se permite sobre funciones"));
        } else {
            return Result.Err(terr(a.line, a.col, "anotación desconocida: '@" + a.name + "'"));
        }
        i = i + 1;
    }
    Result.Ok(0)
}

// Valida el objetivo de un `impl`. M14.3d-2: solo objetivos CONCRETOS (struct/enum no genérico, o
// primitivo). Los impls genéricos (`impl<T> ... for Caja<T>`) y bounds → d-3.
fn ensure_impl_target(c: Checker, target: Type, type_params: [string], line: int, col: int) -> Result<int, TypeError> {
    if (is_primitive(target)) {
        if (len(type_params) == 0) { return Result.Ok(0); }
        return Result.Err(terr(line, col, "un tipo primitivo no es genérico: no admite parámetros de tipo en el impl"));
    }
    match (target) {
        Type.TNamed(n, args) => {
            if (!contains_key(c.structs, n) && !contains_key(c.enums, n)) {
                return Result.Err(terr(line, col, "no se puede implementar para un tipo desconocido: '" + n + "'"));
            }
            let arity = type_arity(c, n);
            if (len(type_params) == 0) {
                if (arity != 0) {
                    return Result.Err(terr(line, col, "'" + n + "' es genérico: declara sus parámetros en el impl, p. ej. 'impl<T> ... for " + n + "<T>' (M9.2b)"));
                }
                Result.Ok(0)
            } else {
                ensure_generic_impl_target(n, args, type_params, arity, line, col)
            }
        },
        _ => Result.Err(terr(line, col, "solo se puede implementar un trait para un struct, enum o primitivo")),
    }
}

// Impl genérico (M9.2b): la aridad casa y el objetivo se aplica EXACTAMENTE a los propios parámetros
// de tipo del impl (cada uno un `Var` distinto): `impl<T> ... for Caja<T>`.
fn ensure_generic_impl_target(n: string, args: [Type], type_params: [string], arity: int, line: int, col: int) -> Result<int, TypeError> {
    if (arity != len(type_params)) {
        return Result.Err(terr(line, col, "'" + n + "' espera " + to_string(arity)
            + " parámetro(s) de tipo, el impl declara " + to_string(len(type_params))));
    }
    var bien = len(args) == len(type_params);
    var vistos: [string] = [];
    var i = 0;
    while (bien && i < len(args)) {
        match (args[i]) {
            Type.TNamed(an, aargs) => {
                if (len(aargs) != 0 || !contains_str(type_params, an) || contains_str(vistos, an)) { bien = false; }
                else { push(vistos, an); }
            },
            _ => { bien = false; },
        }
        i = i + 1;
    }
    if (!bien) {
        return Result.Err(terr(line, col, "el impl genérico debe aplicarse a '" + n + "<" + join_comma(type_params)
            + ">' (sus propios parámetros de tipo, distintos)"));
    }
    Result.Ok(0)
}

// Comprueba que la firma de un método de impl coincide con la del trait, tras sustituir `Self` por el
// tipo implementador en ambas.
fn check_method_sig(tm: MethodSig, m: Func, target: Type) -> Result<int, TypeError> {
    if (len(tm.params) != len(m.params)) {
        return Result.Err(terr(m.line, m.col, "el método '" + m.name + "' toma " + to_string(len(m.params))
            + " parámetro(s) (incluido self), pero el trait pide " + to_string(len(tm.params))));
    }
    var i = 0;
    while (i < len(tm.params)) {
        let want = resolve_type(subst_self(tm.params[i].ty, target));
        let got = resolve_type(subst_self(m.params[i].ty, target));
        if (!type_eq(want, got)) {
            return Result.Err(terr(m.params[i].line, m.params[i].col, "el parámetro " + to_string(i + 1)
                + " del método '" + m.name + "' es " + type_str(got) + ", pero el trait pide " + type_str(want)));
        }
        i = i + 1;
    }
    let want_ret = resolve_type(subst_self(tm.ret, target));
    let got_ret = resolve_type(subst_self(m.ret, target));
    if (!type_eq(want_ret, got_ret)) {
        return Result.Err(terr(m.line, m.col, "el método '" + m.name + "' devuelve " + type_str(got_ret) + ", pero el trait pide " + type_str(want_ret)));
    }
    Result.Ok(0)
}

// Verifica los cuerpos de los métodos de cada impl (los provistos + los defectos heredados), cada uno
// como una función con `self` de tipo concreto. Va tras verificar las funciones (la tabla de métodos
// ya está completa: un método puede llamar a otro).
fn check_impl_bodies(c: Checker, prog: Program) -> Result<int, TypeError> {
    var ii = 0;
    while (ii < len(prog.impls)) {
        let imp = prog.impls[ii];
        // Para un impl genérico, sus parámetros de tipo y bounds entran en ámbito (el cuerpo del método
        // usa `T`, p. ej. `self.contenido.medir()` con `T: Medir`).
        c.tparams = imp.type_params;
        c.bounds = imp.bounds;
        let target = resolve_type(imp.target);
        let key = type_key_str(target);
        var mi = 0;
        while (mi < len(imp.methods)) {
            let m = imp.methods[mi];
            check_method_body(c, m.params, m.ret, m.body, m.line, m.col, mangle(key, m.name), target)?;
            mi = mi + 1;
        }
        // Defectos heredados: se verifican con `self` del tipo concreto.
        let trait_methods: [MethodSig] = match (get(c.traits, imp.trait_name)) { Option.Some(ms) => ms, Option.None => [] };
        var tj = 0;
        while (tj < len(trait_methods)) {
            let tm = trait_methods[tj];
            if (has_default(tm) && !impl_overrides(imp, tm.name)) {
                match (tm.default_body) {
                    Option.Some(body) => { check_method_body(c, tm.params, tm.ret, body, tm.line, tm.col, mangle(key, tm.name), target)?; },
                    Option.None => {},
                }
            }
            tj = tj + 1;
        }
        c.tparams = no_tparams();
        c.bounds = no_bounds();
        ii = ii + 1;
    }
    Result.Ok(0)
}

// Verifica el cuerpo de un método: sus parámetros (self incluido) con Self→target, y el bloque contra
// el retorno (Self→target). `label` es el nombre manglado (aparece en un posible error de retorno).
fn check_method_body(c: Checker, params: [Param], ret: Type, body: Block, line: int, col: int, label: string, target: Type) -> Result<int, TypeError> {
    var sp: [Param] = [];
    var i = 0;
    while (i < len(params)) {
        let p = params[i];
        push(sp, Param { name: p.name, ty: subst_self(p.ty, target), line: p.line, col: p.col });
        i = i + 1;
    }
    check_fn_body(c, sp, subst_self(ret, target), body, line, col, "'" + label + "'")
}

// Punto de entrada: valida un programa (o devuelve el primer TypeError).
pub fn check(prog: Program) -> Result<int, TypeError> {
    let c = Checker {
        funcs: map_new(), structs: map_new(), enums: map_new(),
        struct_tparams: map_new(), enum_tparams: map_new(),
        traits: map_new(), methods: map_new(), impl_traits: map_new(),
        scopes: [], current_return: Type.TUnit, tparams: [], bounds: [],
    };
    check_program(c, prog)
}

// Una lista de bounds vacía, ya tipada (para reiniciar `c.bounds`; como `no_tparams`).
fn no_bounds() -> [Bound] { [] }
