fn check_join(c: Checker, cargs: [Expr], line: int, col: int) -> Result<Type, TypeError> {
    b_arity("join", 2, " (array of string, separator)", cargs.len(), line, col)?;
    let a = check_args_types(c, cargs)?;
    if (!type_eq(a[0], Type.TArray(Type.TString))) {
        return Result.Err(
            terr(
                cargs[0].line,
                cargs[0].col,
                "join expects a [string] as first argument, not " + type_str(a[0])
            )
        );
    }
    want_string(a, cargs, 1, "join expects a string as separator, not ")?;
    Result.Ok(Type.TString)
}

// contains(x, y) -> bool: ad-hoc polimórfico. String: ¿subcadena? Arreglo: ¿pertenencia (mismo elem)?
fn check_contains(c: Checker, cargs: [Expr], line: int, col: int) -> Result<Type, TypeError> {
    b_arity("contains", 2, " (string/array, value)", cargs.len(), line, col)?;
    let a = check_args_types(c, cargs)?;
    match (a[0]) {
        Type.TString => {
            want_string(a, cargs, 1, "contains expects a string as substring, not ")?;
        },
        Type.TArray(elem) => {
            if (!type_eq(
            a[1],
            elem
        )) {
                return Result.Err(
                    terr(
                        cargs[1].line,
                        cargs[1].col,
                        "contains: the array is of " + type_str(elem) + " but looking for " + type_str(a[1])
                    )
                );
            }
        },
        _ => {
            return Result.Err(
                terr(
                    cargs[0].line,
                    cargs[0].col,
                    "contains expects a string or an array, not " + type_str(a[0])
                )
            );
        },
    }
    Result.Ok(Type.TBool)
}

// =====================================================================
// Builtins de Map (M14.6b): map_new/insert/get/contains_key/keys/values. Reglas/mensajes idénticos a
// `src/builtins.rs` (get refleja el envoltorio del prelude: (Map<K,V>, K) -> Option<V>).
// =====================================================================
// M48.1: `Map.new()` — función asociada. Como `Map.new()` (indeterminado) pero con mensajes "Map.new"
// idénticos a `try_assoc_call` de Rust. La aridad se valida primero (como en Rust).
fn check_assoc_map_new(
    c: Checker,
    cargs: [Expr],
    expected: Option<Type>,
    line: int,
    col: int
) -> Result<Type, TypeError> {
    if (cargs.len() != 0) {
        return Result.Err(
            terr(line, col, "'Map.new' expects 0 argument(s), got " + to_string(cargs.len()))
        );
    }
    match (expected) {
        Option.Some(t) => {
            match (map_kv(
            t
        )) {
                Option.Some(_) => {
                    ensure_type(c, t, line, col)?;
                    Result.Ok(t)
                },
                Option.None => Result.Err(
                    terr(
                        line,
                        col,
                        "'Map.new' produces a Map, but the context expects " + type_str(t)
                    )
                ),
            }
        },
        Option.None => Result.Err(
            terr(
                line,
                col,
                "cannot infer the type of 'Map.new'; annotate it, e.g. 'let m: Map<string, int> = Map.new()'"
            )
        ),
    }
}

fn check_insert(c: Checker, cargs: [Expr], line: int, col: int) -> Result<Type, TypeError> {
    b_arity("insert", 3, " (map, key, value)", cargs.len(), line, col)?;
    let a = check_args_types(c, cargs)?;
    match (map_kv(
    a[0]
)) {
        Option.Some(kv) => {
            if (!type_eq(a[1], kv[0])) {
                return Result.Err(
                    terr(
                        cargs[1].line,
                        cargs[1].col,
                        "insert: the Map key is " + type_str(kv[0]) + " but got " + type_str(a[1])
                    )
                );
            }
            if (!type_eq(a[2], kv[1])) {
                return Result.Err(
                    terr(
                        cargs[2].line,
                        cargs[2].col,
                        "insert: the Map value is " + type_str(kv[1]) + " but got " + type_str(a[2])
                    )
                );
            }
            Result.Ok(Type.TUnit)
        },
        Option.None => Result.Err(
            terr(
                cargs[0].line,
                cargs[0].col,
                "insert expects a Map as first argument, not " + type_str(a[0])
            )
        ),
    }
}

