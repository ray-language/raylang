}

// __pop(a: [T]) -> [T] (M14.7c): muta `a` quitando el último; [] vacío / [x]. pop → Option<T>.
fn check_pop_prim(c: Checker, cargs: [Expr], line: int, col: int) -> Result<Type, TypeError> {
    b_arity("__pop", 1, "", cargs.len(), line, col)?;
    let a0 = check_expr(c, cargs[0])?;
    match (a0) {
        Type.TArray(elem) => Result.Ok(
            Type.TArray(elem)
        ),
        _ => Result.Err(terr(cargs[0].line, cargs[0].col, "__pop expects an array, not " + type_str(a0))),
    }
}

// args() -> [string] (M14.7c): los argumentos de la línea de comandos del programa. Nulario.
fn check_args_builtin(c: Checker, cargs: [Expr], line: int, col: int) -> Result<Type, TypeError> {
    if (cargs.len() != 0) {
        return Result.Err(
            terr(line, col, "args expects no arguments, received " + to_string(cargs.len()))
        );
    }
    Result.Ok(Type.TArray(Type.TString))
}

