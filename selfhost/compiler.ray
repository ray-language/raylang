// El compilador auto-alojado (M14.5): AST → bytecode, para la VM de pila (`vm.ray`). Es el segundo
// back-end auto-alojado, en paralelo al intérprete de M14.4 (mismo orden M1→M2 que en Rust). Port
// recortado de `src/compiler.rs`.
//
// M14.5a — el NÚCLEO: literales, variables locales, aritmética/comparación/lógica (con cortocircuito),
// if/while/bloques, llamadas a funciones nombradas + builtins escalares, recursión.
// M14.5b — DATOS: arreglos (literal/índice/asignación), structs (literal/campo/asignación de campo) y
// enums (construcción `Enum.Variante[(args)]` + `match`).
// M14.5c — PRIMERA CLASE: funciones como valor, funciones anónimas + closures (captura por upvalues),
// llamada indirecta y el operador `?`. Despacho dinámico (métodos/UFCS/dyn) → M14.5d.
//
// Decisión de diseño (la elegancia del self-hosting): el bytecode reusa el `Value` del intérprete y, en
// la VM, su runtime —no hay un segundo tipo de valor ni GC propio (cabalga sobre el host)—. Y es
// COMPACTO: un opcode genérico `OBuiltin(nombre, argc)` delega en `dispatch_builtin`, en vez de un
// opcode por builtin como en Rust.
//
// Para datos seguimos la filosofía de RESOLUCIÓN POR NOMBRE EN RUNTIME del intérprete auto-alojado (M14.4b):
// a diferencia de la VM de Rust —que numera variantes con *tags* y structs con *ids* en tablas—, aquí los
// opcodes llevan los NOMBRES (`OMakeStruct(nombre, campos)`, `OMakeEnum(enum, variante, aridad)`,
// `OEnumTagEq(variante)`) y la VM construye/compara los `Value` por nombre, igual que el intérprete.
//
// Closures (M14.5c): esquema de upvalues estilo clox (resolución transitiva en el compilador). PERO, a
// diferencia de Rust —que solo *boxea* en celdas los slots capturados (análisis `captured_slots`)—, aquí
// TODA local es una celda en la VM (como el intérprete: cada variable es una `Cell`), así que el
// compilador NO necesita el análisis de boxing: la celda siempre existe y el upvalue solo la referencia.

from parser import Program, Func, Param, Block, Stmt, SKind, Expr, EKind, BinOp, UnOp, FnExpr;
from parser import FieldInit, FieldDef, MatchArm, Pattern, PKind, VariantDef;
from parser import Type, TraitDef, MethodSig, ImplBlock;
from interpreter import Value, is_builtin, type_key_of_type;

// El conjunto de opcodes. Las constantes (`OConst`) indexan la tabla `consts` del chunk.
pub enum Op {
    OConst(int), OTrue, OFalse, OUnit,
    OAdd, OSub, OMul, ODiv, ORem, ONeg, ONot,
    OEq, ONe, OLt, OLe, OGt, OGe,
    OPop, OJump(int), OJumpIfFalse(int),
    OGetLocal(int), OSetLocal(int), OInitLocal(int),
    OCall(int, int), OReturn,    // OCall(fnIndex, argc)
    OBuiltin(string, int),       // OBuiltin(nombre, argc) → dispatch_builtin en la VM
    // --- M14.5b: datos (resolución por nombre en runtime) ---
    OMakeArray(int),             // saca n valores → VArray
    OIndex, OSetIndex,           // a[i] (lee) / a[i] = v
    OMakeStruct(string, [string]), // nombre + campos en orden de declaración → VStruct
    OGetField(string), OSetField(string), // obj.campo (lee) / obj.campo = v
    OMakeEnum(string, string, int), // enum, variante, aridad → VEnum
    OEnumTagEq(string),          // ¿la cima es esta variante? (saca el enum, empuja bool)
    OGetEnumField(int),          // payload[i] del enum de la cima
    OMatchFail,                  // ningún brazo casó (no debería ocurrir)
    // --- M14.5c: primera clase ---
    OGetUpvalue(int), OSetUpvalue(int), // lee/escribe la celda capturada i
    OFunc(int),                  // valor-función sin captura (nombrada-como-valor o anónima sin upvalues)
    OClosure(int, [UpSrc]),      // cierre: índice de la fn compilada + fuentes de captura
    OCallValue(int),             // llamada indirecta (el valor-función ya está en la pila) + argc
    OTry,                        // operador `?`: desempaqueta Ok/Some, o retorna Err/None de la función
    // --- M14.5d: despacho dinámico ---
    ODispatch(string, int),      // recv.fname(args): resuelto en runtime por la etiqueta del valor
    // --- M14.5e: llamadas en cola (TCO) — reutilizan el marco actual en vez de apilar uno nuevo ---
    OTailCall(int, int), OTailCallValue(int), OTailDispatch(string, int),
}

// La fuente de un upvalue: una local de la función envolvente (por slot) o un upvalue suyo (transitivo).
pub enum UpSrc { ULocal(int), UUp(int) }

// El bytecode de una función: las instrucciones + su tabla de constantes.
pub struct Chunk { code: [Op], consts: [Value] }

// Una función compilada: nombre, aridad, nº de slots locales (para dimensionar el marco) y su chunk.
pub struct CompiledFn { name: string, arity: int, nslots: int, chunk: Chunk }

// El programa compilado: la lista de funciones (el índice es su identidad para `OCall`/`OFunc`/`OClosure`)
// + dos tablas para el despacho dinámico en runtime (M14.5d): `indices` (nombre de función libre → índice,
// para UFCS) y `methods` (`Tipo#metodo` → índice, de los `impl` + defectos del trait).
pub struct CProgram { fns: [CompiledFn], indices: Map<string, int>, methods: Map<string, int> }

// Una variable local en tiempo de compilación: nombre, slot (índice en el marco) y profundidad de bloque.
struct Local { name: string, slot: int, depth: int }

// El estado de compilación de UNA función: su chunk en construcción, la resolución de slots/ámbitos y los
// upvalues descubiertos (en orden). Las funciones anidadas lo apilan/desapilan en `Comp.scopes`.
struct Fscope {
    code: [Op], consts: [Value],
    locals: [Local], next_slot: int, max_slots: int, depth: int,
    upvalues: [UpSrc],
}

fn new_fscope() -> Fscope {
    Fscope { code: [], consts: [], locals: [], next_slot: 0, max_slots: 0, depth: 0, upvalues: [] }
}

// El compilador: una PILA de ámbitos de función (el último es el que se compila ahora; las envolventes
// quedan debajo para resolver upvalues) + las tablas del programa + la lista de funciones que va llenando.
struct Comp {
    indices: Map<string, int>,
    structs: Map<string, [FieldDef]>,
    enums: Map<string, [VariantDef]>,
    scopes: [Fscope],
    out: [CompiledFn],
}

// =====================================================================
// Emisión y manejo de slots/ámbitos/upvalues
// =====================================================================

// El ámbito de función actual (la cima de la pila) y su profundidad-índice.
fn top(comp: Comp) -> Fscope { comp.scopes[len(comp.scopes) - 1] }
fn cur_depth(comp: Comp) -> int { len(comp.scopes) - 1 }

fn emit(comp: Comp, op: Op) -> int { let s = top(comp); push(s.code, op); len(s.code) - 1 }

fn add_const(comp: Comp, v: Value) -> int { let s = top(comp); push(s.consts, v); len(s.consts) - 1 }

// Declara un local en el ámbito actual: le asigna el siguiente slot (monotónico; los slots no se reusan →
// `max_slots` dimensiona el marco) y lo registra en la profundidad de bloque actual.
fn declare_local(comp: Comp, name: string) -> int {
    let s = top(comp);
    let slot = s.next_slot;
    s.next_slot = s.next_slot + 1;
    if (s.next_slot > s.max_slots) { s.max_slots = s.next_slot; }
    push(s.locals, Local { name: name, slot: slot, depth: s.depth });
    slot
}

fn resolve_local(comp: Comp, name: string) -> int { resolve_local_at(comp, cur_depth(comp), name) }

// Resuelve un nombre como local de la función en `d` (el más interno gana), o -1.
fn resolve_local_at(comp: Comp, d: int, name: string) -> int {
    let s = comp.scopes[d];
    var i = len(s.locals) - 1;
    while (i >= 0) {
        if (s.locals[i].name == name) { return s.locals[i].slot; }
        i = i - 1;
    }
    0 - 1
}

// Resuelve un nombre como UPVALUE de la función en `d` (estilo clox): lo busca como local de la envolvente
// (upvalue *local*) o, recursivamente, entre los upvalues de la envolvente (upvalue *de upvalue*). Devuelve
// el índice del upvalue en `d`, o -1. (Sin marca de boxing: toda local ya es una celda en la VM.)
fn resolve_upvalue(comp: Comp, d: int, name: string) -> int {
    if (d == 0) { return 0 - 1; }   // la función más externa no tiene envolvente
    let enclosing = d - 1;
    let slot = resolve_local_at(comp, enclosing, name);
    if (slot >= 0) { return add_upvalue(comp, d, UpSrc.ULocal(slot)); }
    let up = resolve_upvalue(comp, enclosing, name);
    if (up >= 0) { return add_upvalue(comp, d, UpSrc.UUp(up)); }
    0 - 1
}

// Registra un upvalue en la función `d` (dedup por fuente) y devuelve su índice.
fn add_upvalue(comp: Comp, d: int, src: UpSrc) -> int {
    let s = comp.scopes[d];
    var i = 0;
    while (i < len(s.upvalues)) {
        if (upsrc_eq(s.upvalues[i], src)) { return i; }
        i = i + 1;
    }
    push(s.upvalues, src);
    len(s.upvalues) - 1
}

fn upsrc_eq(a: UpSrc, b: UpSrc) -> bool {
    match (a) {
        UpSrc.ULocal(x) => match (b) { UpSrc.ULocal(y) => x == y, _ => false },
        UpSrc.UUp(x) => match (b) { UpSrc.UUp(y) => x == y, _ => false },
    }
}

// ¿`name` resuelve a una variable (local o upvalue) en el ámbito actual? Decide directo vs indirecto en
// una llamada. (resolve_upvalue tiene efecto: registra el upvalue; es idempotente con la emisión posterior.)
fn is_variable(comp: Comp, name: string) -> bool {
    if (resolve_local(comp, name) >= 0) { return true; }
    resolve_upvalue(comp, cur_depth(comp), name) >= 0
}

fn begin_scope(comp: Comp) -> int { let s = top(comp); s.depth = s.depth + 1; s.next_slot }

// Cierra un ámbito: descarta los locales de esta profundidad (dejan de resolver) y recupera los slots.
fn end_scope(comp: Comp, saved: int) {
    let s = top(comp);
    s.depth = s.depth - 1;
    var kept: [Local] = [];
    var i = 0;
    while (i < len(s.locals)) {
        if (s.locals[i].depth <= s.depth) { push(kept, s.locals[i]); }
        i = i + 1;
    }
    s.locals = kept;
    s.next_slot = saved;
}

// Parchea un salto emitido con destino provisional para que apunte al final actual del código.
fn patch_jump(comp: Comp, at: int) {
    let s = top(comp);
    let target = len(s.code);
    s.code[at] = match (s.code[at]) {
        Op.OJump(_) => Op.OJump(target),
        Op.OJumpIfFalse(_) => Op.OJumpIfFalse(target),
        _ => panic("patch_jump sobre una instrucción que no es salto"),
    };
}

// El opcode binario para un operador (excepto `&&`/`||`, que se bajan con cortocircuito).
fn binop_to_op(op: BinOp) -> Op {
    match (op) {
        BinOp.Add => Op.OAdd, BinOp.Sub => Op.OSub, BinOp.Mul => Op.OMul,
        BinOp.Div => Op.ODiv, BinOp.Rem => Op.ORem,
        BinOp.Eq => Op.OEq, BinOp.Ne => Op.ONe,
        BinOp.Lt => Op.OLt, BinOp.Le => Op.OLe, BinOp.Gt => Op.OGt, BinOp.Ge => Op.OGe,
        _ => panic("binop_to_op: && / || se tratan aparte"),
    }
}

// Los campos declarados de un struct, en orden (de la tabla del programa).
fn struct_field_defs(comp: Comp, name: string) -> [FieldDef] {
    match (get(comp.structs, name)) {
        Option.Some(fs) => fs,
        Option.None => panic("compilador: struct no registrado: " + name),
    }
}

// La expresión del campo `fname` en un literal de struct (el checker garantiza que está presente).
fn find_init(inits: [FieldInit], fname: string) -> Expr {
    var i = 0;
    while (i < len(inits)) {
        if (inits[i].name == fname) { return inits[i].value; }
        i = i + 1;
    }
    panic("compilador: campo ausente en el literal: " + fname)
}

// ¿`name` es un enum (del programa o del prelude) con una variante `variant`? Reconoce la construcción
// `Enum.Variante` en tiempo de compilación (lo que el intérprete decide en runtime).
fn enum_has_variant_c(comp: Comp, name: string, variant: string) -> bool {
    match (get(comp.enums, name)) {
        Option.Some(variants) => {
            var i = 0;
            while (i < len(variants)) {
                if (variants[i].name == variant) { return true; }
                i = i + 1;
            }
            false
        },
        Option.None => false,
    }
}

// =====================================================================
// Emisión de expresiones y sentencias
// =====================================================================

fn emit_expr(comp: Comp, e: Expr) {
    match (e.kind) {
        EKind.EInt(n) => { emit(comp, Op.OConst(add_const(comp, Value.VInt(n)))); },
        EKind.EFloat(f) => { emit(comp, Op.OConst(add_const(comp, Value.VFloat(f)))); },
        EKind.EStr(s) => { emit(comp, Op.OConst(add_const(comp, Value.VStr(s)))); },
        EKind.EChar(c) => { emit(comp, Op.OConst(add_const(comp, Value.VChar(c)))); },
        EKind.EBool(b) => { if (b) { emit(comp, Op.OTrue); } else { emit(comp, Op.OFalse); } },
        EKind.EIdent(name) => emit_ident(comp, name),
        EKind.EUnary(op, inner) => {
            emit_expr(comp, inner);
            match (op) { UnOp.Neg => emit(comp, Op.ONeg), UnOp.Not => emit(comp, Op.ONot) };
        },
        EKind.EBinary(op, l, r) => emit_binary(comp, op, l, r),
        EKind.ECall(callee, cargs) => emit_call(comp, callee, cargs),
        EKind.EIf(cond, then_b, elseopt) => {
            emit_expr(comp, cond);
            let to_else = emit(comp, Op.OJumpIfFalse(0));
            emit(comp, Op.OPop);
            emit_block(comp, then_b);
            let to_end = emit(comp, Op.OJump(0));
            patch_jump(comp, to_else);
            emit(comp, Op.OPop);
            match (elseopt) { Option.Some(els) => emit_expr(comp, els), Option.None => { emit(comp, Op.OUnit); } };
            patch_jump(comp, to_end);
        },
        EKind.EWhile(cond, body) => {
            let loop_start = len(top(comp).code);
            emit_expr(comp, cond);
            let exit = emit(comp, Op.OJumpIfFalse(0));
            emit(comp, Op.OPop);
            emit_block(comp, body);
            emit(comp, Op.OPop);
            emit(comp, Op.OJump(loop_start));
            patch_jump(comp, exit);
            emit(comp, Op.OPop);
            emit(comp, Op.OUnit);
        },
        EKind.EBlock(b) => emit_block(comp, b),
        // --- M14.5b: datos ---
        EKind.EArray(elems) => { emit_args(comp, elems); emit(comp, Op.OMakeArray(len(elems))); },
        EKind.EIndex(arr, idx) => { emit_expr(comp, arr); emit_expr(comp, idx); emit(comp, Op.OIndex); },
        EKind.EStructLit(name, inits) => emit_struct_lit(comp, name, inits),
        EKind.EField(obj, fname) => emit_field(comp, obj, fname),
        EKind.EMatch(scr, arms) => emit_match(comp, scr, arms),
        // --- M14.5c: primera clase ---
        EKind.EFunc(fe) => emit_func_expr(comp, fe),
        EKind.ETry(inner) => { emit_expr(comp, inner); emit(comp, Op.OTry); },
    }
}

// Un identificador: local (`OGetLocal`), upvalue (`OGetUpvalue`) o función nombrada como valor (`OFunc`).
fn emit_ident(comp: Comp, name: string) {
    let slot = resolve_local(comp, name);
    if (slot >= 0) { emit(comp, Op.OGetLocal(slot)); return; }
    let up = resolve_upvalue(comp, cur_depth(comp), name);
    if (up >= 0) { emit(comp, Op.OGetUpvalue(up)); return; }
    match (get(comp.indices, name)) {
        Option.Some(idx) => { emit(comp, Op.OFunc(idx)); },
        Option.None => panic("compilador: nombre no resuelto: " + name),
    }
}

// `&&`/`||` con cortocircuito (`OJumpIfFalse` ojea la condición, no la saca); el resto, operandos + opcode.
fn emit_binary(comp: Comp, op: BinOp, l: Expr, r: Expr) {
    match (op) {
        BinOp.And => {
            emit_expr(comp, l);
            let jump = emit(comp, Op.OJumpIfFalse(0));
            emit(comp, Op.OPop);
            emit_expr(comp, r);
            patch_jump(comp, jump);
        },
        BinOp.Or => {
            emit_expr(comp, l);
            let to_else = emit(comp, Op.OJumpIfFalse(0));
            let to_end = emit(comp, Op.OJump(0));
            patch_jump(comp, to_else);
            emit(comp, Op.OPop);
            emit_expr(comp, r);
            patch_jump(comp, to_end);
        },
        _ => {
            emit_expr(comp, l);
            emit_expr(comp, r);
            emit(comp, binop_to_op(op));
        },
    }
}

// Una llamada: construcción de enum `Enum.Variante(args)` (→ `OMakeEnum`), builtin (→ `OBuiltin`), función
// nombrada (→ `OCall`) o INDIRECTA (un valor-función: variable/upvalue/closure → `OCallValue`). Método/UFCS
// (receptor `.metodo()`) → M14.5d.
fn emit_call(comp: Comp, callee: Expr, cargs: [Expr]) {
    match (callee.kind) {
        EKind.EIdent(name) => {
            if (!is_variable(comp, name)) {
                if (is_builtin(name)) {
                    emit_args(comp, cargs);
                    emit(comp, Op.OBuiltin(name, len(cargs)));
                    return;
                }
                match (get(comp.indices, name)) {
                    Option.Some(idx) => { emit_args(comp, cargs); emit(comp, Op.OCall(idx, len(cargs))); return; },
                    Option.None => {},
                }
            }
        },
        // `recv.f(args)`: construcción de enum `Enum.Variante(args)`, o despacho de método/UFCS (runtime).
        EKind.EField(recv, fname) => {
            // M48.1: función asociada `Map.new()` → mismo primitivo que map_new (la VM lo despacha por
            // nombre vía `dispatch_builtin`). Los canales no corren en la VM auto-alojada.
            match (recv.kind) {
                EKind.EIdent(tn) => {
                    if (tn == "Map" && fname == "new") {
                        emit(comp, Op.OBuiltin("map_new", 0));
                        return;
                    }
                },
                _ => {},
            }
            match (recv.kind) {
                EKind.EIdent(en) => {
                    if (resolve_local(comp, en) < 0 && enum_has_variant_c(comp, en, fname)) {
                        emit_args(comp, cargs);
                        emit(comp, Op.OMakeEnum(en, fname, len(cargs)));
                        return;
                    }
                },
                _ => {},
            }
            // No es construcción de enum → método/UFCS: receptor, argumentos, `ODispatch` (resuelto por la
            // etiqueta del valor en runtime, como el intérprete; `dyn`/bounds/genéricos son no-ops).
            emit_expr(comp, recv);
            emit_args(comp, cargs);
            emit(comp, Op.ODispatch(fname, len(cargs)));
            return;
        },
        _ => {},
    }
    // Indirecto: el valor-función, luego los argumentos, luego `OCallValue`.
    emit_expr(comp, callee);
    emit_args(comp, cargs);
    emit(comp, Op.OCallValue(len(cargs)));
}

fn emit_args(comp: Comp, cargs: [Expr]) {
    var i = 0;
    while (i < len(cargs)) { emit_expr(comp, cargs[i]); i = i + 1; }
}

fn emit_block(comp: Comp, b: Block) {
    let saved = begin_scope(comp);
    var i = 0;
    while (i < len(b.stmts)) { emit_stmt(comp, b.stmts[i]); i = i + 1; }
    match (b.tail) { Option.Some(e) => emit_expr(comp, e), Option.None => { emit(comp, Op.OUnit); } };
    end_scope(comp, saved);
}

fn emit_stmt(comp: Comp, s: Stmt) {
    match (s.kind) {
        SKind.SLet(name, _, value, _) => {
            emit_expr(comp, value);
            let slot = declare_local(comp, name);
            emit(comp, Op.OInitLocal(slot));
        },
        SKind.SAssign(target, value) => {
            match (target.kind) {
                EKind.EIdent(name) => {
                    emit_expr(comp, value);
                    let slot = resolve_local(comp, name);
                    if (slot >= 0) { emit(comp, Op.OSetLocal(slot)); }
                    else {
                        let up = resolve_upvalue(comp, cur_depth(comp), name);
                        if (up >= 0) { emit(comp, Op.OSetUpvalue(up)); }
                        else { panic("compilador: asignación a nombre no resuelto: " + name); }
                    }
                },
                // a[i] = v  → arreglo, índice, valor, `OSetIndex` (consume los tres).
                EKind.EIndex(arr, idx) => {
                    emit_expr(comp, arr);
                    emit_expr(comp, idx);
                    emit_expr(comp, value);
                    emit(comp, Op.OSetIndex);
                },
                // obj.campo = v  → objeto, valor, `OSetField`.
                EKind.EField(obj, fname) => {
                    emit_expr(comp, obj);
                    emit_expr(comp, value);
                    emit(comp, Op.OSetField(fname));
                },
                _ => panic("compilador: destino de asignación no soportado"),
            }
        },
        SKind.SReturn(opt) => {
            match (opt) { Option.Some(e) => emit_expr(comp, e), Option.None => { emit(comp, Op.OUnit); } };
            emit(comp, Op.OReturn);
        },
        SKind.SExpr(e) => { emit_expr(comp, e); emit(comp, Op.OPop); },
    }
}

// Un literal de struct `Nombre { c: v, ... }`: emite los valores en ORDEN DE DECLARACIÓN (como Rust →
// Display/igualdad casan), luego `OMakeStruct` con los nombres de campo.
fn emit_struct_lit(comp: Comp, name: string, inits: [FieldInit]) {
    let defs = struct_field_defs(comp, name);
    var fnames: [string] = [];
    var i = 0;
    while (i < len(defs)) {
        emit_expr(comp, find_init(inits, defs[i].name));
        push(fnames, defs[i].name);
        i = i + 1;
    }
    emit(comp, Op.OMakeStruct(name, fnames));
}

// `obj.fname`: construcción de variante unit `Enum.Variante` (si `obj` nombra un enum y no un local) o
// acceso a campo. Espeja `eval_field_or_enum` del intérprete, resuelto en compilación.
fn emit_field(comp: Comp, obj: Expr, fname: string) {
    match (obj.kind) {
        EKind.EIdent(name) => {
            if (resolve_local(comp, name) < 0 && enum_has_variant_c(comp, name, fname)) {
                emit(comp, Op.OMakeEnum(name, fname, 0));
                return;
            }
        },
        _ => {},
    }
    emit_expr(comp, obj);
    emit(comp, Op.OGetField(fname));
}

// `match (scr) { patrón => cuerpo, ... }`. El escrutinio se guarda en un local temporal `$match`
// (nombre no escribible → sin choque) para leer su variante/payload sin reevaluarlo. Port de
// `emit_match` de Rust, pero comparando la variante por NOMBRE (`OEnumTagEq`), sin tags.
fn emit_match(comp: Comp, scr: Expr, arms: [MatchArm]) {
    emit_expr(comp, scr);
    let saved = begin_scope(comp);
    let scrut = declare_local(comp, "$match");
    emit(comp, Op.OInitLocal(scrut));

    var to_end: [int] = [];
    var has_catchall = false;
    var i = 0;
    while (i < len(arms)) {
        match (arms[i].pat.kind) {
            PKind.PVariant(_, variant, bindings) => {
                emit(comp, Op.OGetLocal(scrut));
                emit(comp, Op.OEnumTagEq(variant));
                let to_next = emit(comp, Op.OJumpIfFalse(0));
                emit(comp, Op.OPop);                // casó → descartar el bool true
                let arm_saved = begin_scope(comp);
                var b = 0;
                while (b < len(bindings)) {
                    match (bindings[b]) {
                        Option.Some(nm) => {
                            emit(comp, Op.OGetLocal(scrut));
                            emit(comp, Op.OGetEnumField(b));
                            let slot = declare_local(comp, nm);
                            emit(comp, Op.OInitLocal(slot));
                        },
                        Option.None => {},
                    }
                    b = b + 1;
                }
                emit_expr(comp, arms[i].body);
                end_scope(comp, arm_saved);
                push(to_end, emit(comp, Op.OJump(0)));
                patch_jump(comp, to_next);
                emit(comp, Op.OPop);                // no casó → descartar el bool false
            },
            PKind.PWild => {
                has_catchall = true;
                emit_expr(comp, arms[i].body);
                push(to_end, emit(comp, Op.OJump(0)));
            },
            PKind.PBind(name) => {
                has_catchall = true;
                let arm_saved = begin_scope(comp);
                emit(comp, Op.OGetLocal(scrut));
                let slot = declare_local(comp, name);
                emit(comp, Op.OInitLocal(slot));
                emit_expr(comp, arms[i].body);
                end_scope(comp, arm_saved);
                push(to_end, emit(comp, Op.OJump(0)));
            },
        }
        i = i + 1;
    }
    if (!has_catchall) { emit(comp, Op.OMatchFail); }
    var j = 0;
    while (j < len(to_end)) { patch_jump(comp, to_end[j]); j = j + 1; }
    end_scope(comp, saved);
}

// Una función anónima `fn(params) { cuerpo }`: se compila EN LÍNEA en su propio ámbito (que ve a los
// envolventes para resolver upvalues), se deposita en `comp.out` y en el ámbito envolvente se emite un
// `OClosure` (si capturó upvalues) o un `OFunc` simple (si no).
fn emit_func_expr(comp: Comp, fe: FnExpr) {
    push(comp.scopes, new_fscope());
    var i = 0;
    while (i < len(fe.params)) { declare_local(comp, fe.params[i].name); i = i + 1; }
    emit_block(comp, fe.body);
    emit(comp, Op.OReturn);
    let s = top(comp);
    let cfn = CompiledFn { name: "<fn>", arity: len(fe.params), nslots: s.max_slots, chunk: Chunk { code: s.code, consts: s.consts } };
    let ups = s.upvalues;
    pop(comp.scopes);
    push(comp.out, cfn);
    let idx = len(comp.out) - 1;
    if (len(ups) == 0) { emit(comp, Op.OFunc(idx)); }
    else { emit(comp, Op.OClosure(idx, ups)); }
}

// =====================================================================
// Punto de entrada
// =====================================================================

// Compila un cuerpo (función nombrada o método de impl) en su propio ámbito y devuelve su `CompiledFn`.
// Las fn-exprs anidadas en su cuerpo se compilan en línea (recursivamente) y se ANEXAN a `comp.out`.
fn compile_body(comp: Comp, name: string, params: [Param], body: Block) -> CompiledFn {
    push(comp.scopes, new_fscope());
    var i = 0;
    while (i < len(params)) { declare_local(comp, params[i].name); i = i + 1; }
    emit_block(comp, body);       // deja el valor del cuerpo en la pila
    emit(comp, Op.OReturn);       // ...que se retorna
    let s = top(comp);
    optimize_tail_calls(s.code);  // M14.5e: las llamadas en posición de cola → variantes TailCall
    let cfn = CompiledFn { name: name, arity: len(params), nslots: s.max_slots, chunk: Chunk { code: s.code, consts: s.consts } };
    pop(comp.scopes);
    cfn
}

// Peephole de TCO (M14.5e, port de `optimize_tail_calls` de Rust): toda llamada (`OCall`/`OCallValue`/
// `ODispatch`) cuya continuación sea un `OReturn` —directo o a través de saltos incondicionales— se
// convierte en su variante `OTail*`, que REUTILIZA el marco en vez de apilar uno nuevo → recursión de cola
// en O(1) marcos. El compilador ya emite ese patrón de forma natural (rama-else cae al `Return` final, etc.),
// así que basta reconocerlo en el bytecode ya generado.
fn optimize_tail_calls(code: [Op]) {
    var i = 0;
    while (i < len(code)) {
        let nuevo: Option<Op> = match (code[i]) {
            Op.OCall(idx, argc) => if (returns_immediately(code, i + 1)) { Option.Some(Op.OTailCall(idx, argc)) } else { Option.None },
            Op.OCallValue(argc) => if (returns_immediately(code, i + 1)) { Option.Some(Op.OTailCallValue(argc)) } else { Option.None },
            Op.ODispatch(fname, argc) => if (returns_immediately(code, i + 1)) { Option.Some(Op.OTailDispatch(fname, argc)) } else { Option.None },
            _ => Option.None,
        };
        match (nuevo) {
            Option.Some(op) => { code[i] = op; },
            Option.None => {},
        }
        i = i + 1;
    }
}

// ¿La instrucción en `start` (siguiendo saltos incondicionales) es un `OReturn`? El bucle acotado a la
// longitud del código evita ciclos infinitos ante un bytecode degenerado.
fn returns_immediately(code: [Op], start: int) -> bool {
    var j = start;
    var steps = 0;
    var result = false;
    var done = false;
    while (!done && steps <= len(code)) {
        if (j < 0 || j >= len(code)) { done = true; }
        else {
            match (code[j]) {
                Op.OReturn => { result = true; done = true; },
                Op.OJump(t) => { j = t; },
                _ => { done = true; },
            }
        }
        steps = steps + 1;
    }
    result
}

// Compila los métodos de los `impl` del programa y puebla la tabla `Tipo#metodo → índice` (incluye los
// métodos por DEFECTO del trait no redefinidos por el impl). Espeja `register_methods` del intérprete; un
// método es una función con `self` como primer parámetro (lo antepone el despacho). Por constructor:
// `type_key_of_type(Caja<T>) = "Caja"` → un impl genérico cubre toda la familia (genéricos = erasure).
fn compile_methods(comp: Comp, prog: Program, methods: Map<string, int>) {
    let traitmap: Map<string, [MethodSig]> = map_new();
    var ti = 0;
    while (ti < len(prog.traits)) { insert(traitmap, prog.traits[ti].name, prog.traits[ti].methods); ti = ti + 1; }

    var ii = 0;
    while (ii < len(prog.impls)) {
        let imp = prog.impls[ii];
        let key = type_key_of_type(imp.target);
        var defined: [string] = [];
        var mi = 0;
        while (mi < len(imp.methods)) {
            let m = imp.methods[mi];
            let cfn = compile_body(comp, m.name, m.params, m.body);
            push(comp.out, cfn);
            insert(methods, key + "#" + m.name, len(comp.out) - 1);
            push(defined, m.name);
            mi = mi + 1;
        }
        // métodos por defecto del trait no redefinidos por este impl
        match (get(traitmap, imp.trait_name)) {
            Option.Some(sigs) => {
                var si = 0;
                while (si < len(sigs)) {
                    let sig = sigs[si];
                    if (!contains_name(defined, sig.name)) {
                        match (sig.default_body) {
                            Option.Some(body) => {
                                let cfn = compile_body(comp, sig.name, sig.params, body);
                                push(comp.out, cfn);
                                insert(methods, key + "#" + sig.name, len(comp.out) - 1);
                            },
                            Option.None => {},
                        }
                    }
                    si = si + 1;
                }
            },
            Option.None => {},
        }
        ii = ii + 1;
    }
}

fn contains_name(xs: [string], s: string) -> bool {
    var i = 0;
    while (i < len(xs)) { if (xs[i] == s) { return true; } i = i + 1; }
    false
}

// Registra los enums del prelude (Option/Result) para RECONOCER su construcción `Option.Some`/`Result.Ok`
// en compilación, como el intérprete los inyecta en runtime (`inject_prelude_enums`). Solo importan los
// nombres de las variantes (la aridad la da el sitio de llamada).
fn inject_prelude_enums(enums: Map<string, [VariantDef]>) {
    insert(enums, "Option", [
        VariantDef { name: "Some", payload: [], line: 0, col: 0 },
        VariantDef { name: "None", payload: [], line: 0, col: 0 },
    ]);
    insert(enums, "Result", [
        VariantDef { name: "Ok", payload: [], line: 0, col: 0 },
        VariantDef { name: "Err", payload: [], line: 0, col: 0 },
    ]);
}

// Una `CompiledFn` de relleno para reservar los slots de las funciones nombradas (índices 0..n) antes de
// compilarlas; así las funciones anónimas, que se ANEXAN durante la compilación, no pisan esos índices.
fn placeholder_fn() -> CompiledFn {
    CompiledFn { name: "", arity: 0, nslots: 0, chunk: Chunk { code: [], consts: [] } }
}

pub fn compile(prog: Program) -> CProgram {
    var indices: Map<string, int> = map_new();
    var i = 0;
    while (i < len(prog.funcs)) { insert(indices, prog.funcs[i].name, i); i = i + 1; }

    var structs: Map<string, [FieldDef]> = map_new();
    var s = 0;
    while (s < len(prog.structs)) { insert(structs, prog.structs[s].name, prog.structs[s].fields); s = s + 1; }

    var enums: Map<string, [VariantDef]> = map_new();
    inject_prelude_enums(enums);
    var e = 0;
    while (e < len(prog.enums)) { insert(enums, prog.enums[e].name, prog.enums[e].variants); e = e + 1; }

    let comp = Comp { indices: indices, structs: structs, enums: enums, scopes: [], out: [] };
    // Reservamos un hueco por función nombrada (índices 0..n); las anónimas/métodos se anexarán después.
    let n = len(prog.funcs);
    var r = 0;
    while (r < n) { push(comp.out, placeholder_fn()); r = r + 1; }
    var j = 0;
    while (j < n) {
        let cfn = compile_body(comp, prog.funcs[j].name, prog.funcs[j].params, prog.funcs[j].body);
        comp.out[j] = cfn;
        j = j + 1;
    }
    var methods: Map<string, int> = map_new();
    compile_methods(comp, prog, methods);
    CProgram { fns: comp.out, indices: indices, methods: methods }
}
