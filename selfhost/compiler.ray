// El compilador auto-alojado (M14.5): AST → bytecode, para la VM de pila (`vm.ray`). Es el segundo
// back-end auto-alojado, en paralelo al intérprete de M14.4 (mismo orden M1→M2 que en Rust). Port
// recortado de `src/compiler.rs`.
//
// M14.5a — el NÚCLEO: literales, variables locales, aritmética/comparación/lógica (con cortocircuito),
// if/while/bloques, llamadas a funciones nombradas + builtins escalares, recursión.
// M14.5b — DATOS: arreglos (literal/índice/asignación), structs (literal/campo/asignación de campo) y
// enums (construcción `Enum.Variante[(args)]` + `match`). Primera clase (closures) → M14.5c; despacho
// dinámico → M14.5d.
//
// Decisión de diseño (la elegancia del self-hosting): el bytecode reusa el `Value` del intérprete y, en
// la VM, su runtime —no hay un segundo tipo de valor ni GC propio (cabalga sobre el host)—. Y es
// COMPACTO: un opcode genérico `OBuiltin(nombre, argc)` delega en `dispatch_builtin`, en vez de un
// opcode por builtin como en Rust.
//
// Para datos seguimos la filosofía de RESOLUCIÓN POR NOMBRE EN RUNTIME del intérprete auto-alojado (M14.4b):
// a diferencia de la VM de Rust —que numera variantes con *tags* y structs con *ids* en tablas—, aquí los
// opcodes llevan los NOMBRES (`OMakeStruct(nombre, campos)`, `OMakeEnum(enum, variante, aridad)`,
// `OEnumTagEq(variante)`) y la VM construye/compara los `Value` por nombre, igual que el intérprete.

from parser import Program, Func, Param, Block, Stmt, SKind, Expr, EKind, BinOp, UnOp;
from parser import FieldInit, FieldDef, MatchArm, Pattern, PKind, VariantDef;
from interpreter import Value, is_builtin;

// El conjunto de opcodes. Las constantes (`OConst`) indexan la tabla `consts` del chunk.
pub enum Op {
    OConst(int), OTrue, OFalse, OUnit,
    OAdd, OSub, OMul, ODiv, ORem, ONeg, ONot,
    OEq, ONe, OLt, OLe, OGt, OGe,
    OPop, OJump(int), OJumpIfFalse(int),
    OGetLocal(int), OSetLocal(int), OInitLocal(int),
    OCall(int, int), OReturn,    // OCall(fnIndex, argc)
    OBuiltin(string, int),       // OBuiltin(nombre, argc) → dispatch_builtin en la VM
    // --- M14.5b: datos (resolución por nombre en runtime) ---
    OMakeArray(int),             // saca n valores → VArray
    OIndex, OSetIndex,           // a[i] (lee) / a[i] = v
    OMakeStruct(string, [string]), // nombre + campos en orden de declaración → VStruct
    OGetField(string), OSetField(string), // obj.campo (lee) / obj.campo = v
    OMakeEnum(string, string, int), // enum, variante, aridad → VEnum
    OEnumTagEq(string),          // ¿la cima es esta variante? (saca el enum, empuja bool)
    OGetEnumField(int),          // payload[i] del enum de la cima
    OMatchFail,                  // ningún brazo casó (no debería ocurrir)
}

// El bytecode de una función: las instrucciones + su tabla de constantes.
pub struct Chunk { code: [Op], consts: [Value] }

// Una función compilada: nombre, aridad, nº de slots locales (para dimensionar el marco) y su chunk.
pub struct CompiledFn { name: string, arity: int, nslots: int, chunk: Chunk }

// El programa compilado: la lista de funciones (el índice es su identidad para `OCall`).
pub struct CProgram { fns: [CompiledFn] }

// Una variable local en tiempo de compilación: nombre, slot (índice en el marco) y profundidad de bloque.
struct Local { name: string, slot: int, depth: int }

// El estado del compilador para UNA función: el chunk en construcción + la resolución de slots/ámbitos.
// `indices` (nombre de función → índice), `structs` (nombre → campos) y `enums` (nombre → variantes) son
// tablas del PROGRAMA, compartidas entre funciones (resolución de `OCall`, orden de campos, construcción).
struct Cc {
    code: [Op], consts: [Value],
    locals: [Local], next_slot: int, max_slots: int, depth: int,
    indices: Map<string, int>,
    structs: Map<string, [FieldDef]>,
    enums: Map<string, [VariantDef]>,
}

// =====================================================================
// Emisión y manejo de slots/ámbitos
// =====================================================================

fn emit(cc: Cc, op: Op) -> int { push(cc.code, op); len(cc.code) - 1 }

fn add_const(cc: Cc, v: Value) -> int { push(cc.consts, v); len(cc.consts) - 1 }

// Declara un local: le asigna el siguiente slot (monotónico; los slots no se reusan → `max_slots`
// dimensiona el marco) y lo registra en la profundidad de bloque actual.
fn declare_local(cc: Cc, name: string) -> int {
    let slot = cc.next_slot;
    cc.next_slot = cc.next_slot + 1;
    if (cc.next_slot > cc.max_slots) { cc.max_slots = cc.next_slot; }
    push(cc.locals, Local { name: name, slot: slot, depth: cc.depth });
    slot
}

// Resuelve un nombre a su slot local (el más interno gana), o -1 si no es un local.
fn resolve_local(cc: Cc, name: string) -> int {
    var i = len(cc.locals) - 1;
    while (i >= 0) {
        if (cc.locals[i].name == name) { return cc.locals[i].slot; }
        i = i - 1;
    }
    0 - 1
}

fn begin_scope(cc: Cc) -> int { cc.depth = cc.depth + 1; cc.next_slot }

// Cierra un ámbito: descarta los locales de esta profundidad (dejan de resolver) y recupera los slots.
fn end_scope(cc: Cc, saved: int) {
    cc.depth = cc.depth - 1;
    var kept: [Local] = [];
    var i = 0;
    while (i < len(cc.locals)) {
        if (cc.locals[i].depth <= cc.depth) { push(kept, cc.locals[i]); }
        i = i + 1;
    }
    cc.locals = kept;
    cc.next_slot = saved;
}

// Parchea un salto emitido con destino provisional para que apunte al final actual del código.
fn patch_jump(cc: Cc, at: int) {
    let target = len(cc.code);
    cc.code[at] = match (cc.code[at]) {
        Op.OJump(_) => Op.OJump(target),
        Op.OJumpIfFalse(_) => Op.OJumpIfFalse(target),
        _ => panic("patch_jump sobre una instrucción que no es salto"),
    };
}

// El opcode binario para un operador (excepto `&&`/`||`, que se bajan con cortocircuito).
fn binop_to_op(op: BinOp) -> Op {
    match (op) {
        BinOp.Add => Op.OAdd, BinOp.Sub => Op.OSub, BinOp.Mul => Op.OMul,
        BinOp.Div => Op.ODiv, BinOp.Rem => Op.ORem,
        BinOp.Eq => Op.OEq, BinOp.Ne => Op.ONe,
        BinOp.Lt => Op.OLt, BinOp.Le => Op.OLe, BinOp.Gt => Op.OGt, BinOp.Ge => Op.OGe,
        _ => panic("binop_to_op: && / || se tratan aparte"),
    }
}

// Los campos declarados de un struct, en orden (de la tabla del programa).
fn struct_field_defs(cc: Cc, name: string) -> [FieldDef] {
    match (get(cc.structs, name)) {
        Option.Some(fs) => fs,
        Option.None => panic("compilador: struct no registrado: " + name),
    }
}

// La expresión del campo `fname` en un literal de struct (el checker garantiza que está presente).
fn find_init(inits: [FieldInit], fname: string) -> Expr {
    var i = 0;
    while (i < len(inits)) {
        if (inits[i].name == fname) { return inits[i].value; }
        i = i + 1;
    }
    panic("compilador: campo ausente en el literal: " + fname)
}

// ¿`name` es un enum (del programa o del prelude) con una variante `variant`? Reconoce la construcción
// `Enum.Variante` en tiempo de compilación (lo que el intérprete decide en runtime).
fn enum_has_variant_c(cc: Cc, name: string, variant: string) -> bool {
    match (get(cc.enums, name)) {
        Option.Some(variants) => {
            var i = 0;
            while (i < len(variants)) {
                if (variants[i].name == variant) { return true; }
                i = i + 1;
            }
            false
        },
        Option.None => false,
    }
}

// =====================================================================
// Emisión de expresiones y sentencias
// =====================================================================

fn emit_expr(cc: Cc, e: Expr) {
    match (e.kind) {
        EKind.EInt(n) => { emit(cc, Op.OConst(add_const(cc, Value.VInt(n)))); },
        EKind.EFloat(f) => { emit(cc, Op.OConst(add_const(cc, Value.VFloat(f)))); },
        EKind.EStr(s) => { emit(cc, Op.OConst(add_const(cc, Value.VStr(s)))); },
        EKind.EChar(c) => { emit(cc, Op.OConst(add_const(cc, Value.VChar(c)))); },
        EKind.EBool(b) => { if (b) { emit(cc, Op.OTrue); } else { emit(cc, Op.OFalse); } },
        EKind.EIdent(name) => {
            let slot = resolve_local(cc, name);
            if (slot >= 0) { emit(cc, Op.OGetLocal(slot)); }
            else { panic("compilador: función como valor no soportada en M14.5a: " + name); }
        },
        EKind.EUnary(op, inner) => {
            emit_expr(cc, inner);
            match (op) { UnOp.Neg => emit(cc, Op.ONeg), UnOp.Not => emit(cc, Op.ONot) };
        },
        EKind.EBinary(op, l, r) => emit_binary(cc, op, l, r),
        EKind.ECall(callee, cargs) => emit_call(cc, callee, cargs),
        EKind.EIf(cond, then_b, elseopt) => {
            emit_expr(cc, cond);
            let to_else = emit(cc, Op.OJumpIfFalse(0));
            emit(cc, Op.OPop);
            emit_block(cc, then_b);
            let to_end = emit(cc, Op.OJump(0));
            patch_jump(cc, to_else);
            emit(cc, Op.OPop);
            match (elseopt) { Option.Some(els) => emit_expr(cc, els), Option.None => { emit(cc, Op.OUnit); } };
            patch_jump(cc, to_end);
        },
        EKind.EWhile(cond, body) => {
            let loop_start = len(cc.code);
            emit_expr(cc, cond);
            let exit = emit(cc, Op.OJumpIfFalse(0));
            emit(cc, Op.OPop);
            emit_block(cc, body);
            emit(cc, Op.OPop);
            emit(cc, Op.OJump(loop_start));
            patch_jump(cc, exit);
            emit(cc, Op.OPop);
            emit(cc, Op.OUnit);
        },
        EKind.EBlock(b) => emit_block(cc, b),
        // --- M14.5b: datos ---
        EKind.EArray(elems) => { emit_args(cc, elems); emit(cc, Op.OMakeArray(len(elems))); },
        EKind.EIndex(arr, idx) => { emit_expr(cc, arr); emit_expr(cc, idx); emit(cc, Op.OIndex); },
        EKind.EStructLit(name, inits) => emit_struct_lit(cc, name, inits),
        EKind.EField(obj, fname) => emit_field(cc, obj, fname),
        EKind.EMatch(scr, arms) => emit_match(cc, scr, arms),
        _ => panic("compilador: forma de expresión no soportada en M14.5b"),
    }
}

// Un literal de struct `Nombre { c: v, ... }`: emite los valores en ORDEN DE DECLARACIÓN (como Rust →
// Display/igualdad casan), luego `OMakeStruct` con los nombres de campo.
fn emit_struct_lit(cc: Cc, name: string, inits: [FieldInit]) {
    let defs = struct_field_defs(cc, name);
    var fnames: [string] = [];
    var i = 0;
    while (i < len(defs)) {
        emit_expr(cc, find_init(inits, defs[i].name));
        push(fnames, defs[i].name);
        i = i + 1;
    }
    emit(cc, Op.OMakeStruct(name, fnames));
}

// `obj.fname`: construcción de variante unit `Enum.Variante` (si `obj` nombra un enum y no un local) o
// acceso a campo. Espeja `eval_field_or_enum` del intérprete, resuelto en compilación.
fn emit_field(cc: Cc, obj: Expr, fname: string) {
    match (obj.kind) {
        EKind.EIdent(name) => {
            if (resolve_local(cc, name) < 0 && enum_has_variant_c(cc, name, fname)) {
                emit(cc, Op.OMakeEnum(name, fname, 0));
                return;
            }
        },
        _ => {},
    }
    emit_expr(cc, obj);
    emit(cc, Op.OGetField(fname));
}

// `match (scr) { patrón => cuerpo, ... }`. El escrutinio se guarda en un local temporal `$match`
// (nombre no escribible → sin choque) para leer su variante/payload sin reevaluarlo. Port de
// `emit_match` de Rust, pero comparando la variante por NOMBRE (`OEnumTagEq`), sin tags.
fn emit_match(cc: Cc, scr: Expr, arms: [MatchArm]) {
    emit_expr(cc, scr);
    let saved = begin_scope(cc);
    let scrut = declare_local(cc, "$match");
    emit(cc, Op.OInitLocal(scrut));

    var to_end: [int] = [];
    var has_catchall = false;
    var i = 0;
    while (i < len(arms)) {
        match (arms[i].pat.kind) {
            PKind.PVariant(_, variant, bindings) => {
                emit(cc, Op.OGetLocal(scrut));
                emit(cc, Op.OEnumTagEq(variant));
                let to_next = emit(cc, Op.OJumpIfFalse(0));
                emit(cc, Op.OPop);                // casó → descartar el bool true
                let arm_saved = begin_scope(cc);
                var b = 0;
                while (b < len(bindings)) {
                    match (bindings[b]) {
                        Option.Some(nm) => {
                            emit(cc, Op.OGetLocal(scrut));
                            emit(cc, Op.OGetEnumField(b));
                            let slot = declare_local(cc, nm);
                            emit(cc, Op.OInitLocal(slot));
                        },
                        Option.None => {},
                    }
                    b = b + 1;
                }
                emit_expr(cc, arms[i].body);
                end_scope(cc, arm_saved);
                push(to_end, emit(cc, Op.OJump(0)));
                patch_jump(cc, to_next);
                emit(cc, Op.OPop);                // no casó → descartar el bool false
            },
            PKind.PWild => {
                has_catchall = true;
                emit_expr(cc, arms[i].body);
                push(to_end, emit(cc, Op.OJump(0)));
            },
            PKind.PBind(name) => {
                has_catchall = true;
                let arm_saved = begin_scope(cc);
                emit(cc, Op.OGetLocal(scrut));
                let slot = declare_local(cc, name);
                emit(cc, Op.OInitLocal(slot));
                emit_expr(cc, arms[i].body);
                end_scope(cc, arm_saved);
                push(to_end, emit(cc, Op.OJump(0)));
            },
        }
        i = i + 1;
    }
    if (!has_catchall) { emit(cc, Op.OMatchFail); }
    var j = 0;
    while (j < len(to_end)) { patch_jump(cc, to_end[j]); j = j + 1; }
    end_scope(cc, saved);
}

// `&&`/`||` con cortocircuito (`OJumpIfFalse` ojea la condición, no la saca); el resto, operandos + opcode.
fn emit_binary(cc: Cc, op: BinOp, l: Expr, r: Expr) {
    match (op) {
        BinOp.And => {
            emit_expr(cc, l);
            let jump = emit(cc, Op.OJumpIfFalse(0));
            emit(cc, Op.OPop);
            emit_expr(cc, r);
            patch_jump(cc, jump);
        },
        BinOp.Or => {
            emit_expr(cc, l);
            let to_else = emit(cc, Op.OJumpIfFalse(0));
            let to_end = emit(cc, Op.OJump(0));
            patch_jump(cc, to_else);
            emit(cc, Op.OPop);
            emit_expr(cc, r);
            patch_jump(cc, to_end);
        },
        _ => {
            emit_expr(cc, l);
            emit_expr(cc, r);
            emit(cc, binop_to_op(op));
        },
    }
}

// Una llamada `f(args)`: construcción de enum `Enum.Variante(args)` (→ `OMakeEnum`), builtin
// (→ `OBuiltin`) o función nombrada (→ `OCall`). Indirecta/método → M14.5c/d.
fn emit_call(cc: Cc, callee: Expr, cargs: [Expr]) {
    match (callee.kind) {
        EKind.EIdent(name) => {
            if (resolve_local(cc, name) < 0) {
                if (is_builtin(name)) {
                    emit_args(cc, cargs);
                    emit(cc, Op.OBuiltin(name, len(cargs)));
                    return;
                }
                match (get(cc.indices, name)) {
                    Option.Some(idx) => { emit_args(cc, cargs); emit(cc, Op.OCall(idx, len(cargs))); return; },
                    Option.None => {},
                }
            }
        },
        // `Enum.Variante(args)`: el callee es un acceso a campo sobre un nombre de enum (no un local).
        EKind.EField(recv, variant) => {
            match (recv.kind) {
                EKind.EIdent(en) => {
                    if (resolve_local(cc, en) < 0 && enum_has_variant_c(cc, en, variant)) {
                        emit_args(cc, cargs);
                        emit(cc, Op.OMakeEnum(en, variant, len(cargs)));
                        return;
                    }
                },
                _ => {},
            }
        },
        _ => {},
    }
    panic("compilador: llamada indirecta/método no soportada en M14.5b");
}

fn emit_args(cc: Cc, cargs: [Expr]) {
    var i = 0;
    while (i < len(cargs)) { emit_expr(cc, cargs[i]); i = i + 1; }
}

fn emit_block(cc: Cc, b: Block) {
    let saved = begin_scope(cc);
    var i = 0;
    while (i < len(b.stmts)) { emit_stmt(cc, b.stmts[i]); i = i + 1; }
    match (b.tail) { Option.Some(e) => emit_expr(cc, e), Option.None => { emit(cc, Op.OUnit); } };
    end_scope(cc, saved);
}

fn emit_stmt(cc: Cc, s: Stmt) {
    match (s.kind) {
        SKind.SLet(name, _, value, _) => {
            emit_expr(cc, value);
            let slot = declare_local(cc, name);
            emit(cc, Op.OInitLocal(slot));
        },
        SKind.SAssign(target, value) => {
            match (target.kind) {
                EKind.EIdent(name) => {
                    emit_expr(cc, value);
                    let slot = resolve_local(cc, name);
                    emit(cc, Op.OSetLocal(slot));
                },
                // a[i] = v  → arreglo, índice, valor, `OSetIndex` (consume los tres).
                EKind.EIndex(arr, idx) => {
                    emit_expr(cc, arr);
                    emit_expr(cc, idx);
                    emit_expr(cc, value);
                    emit(cc, Op.OSetIndex);
                },
                // obj.campo = v  → objeto, valor, `OSetField`.
                EKind.EField(obj, fname) => {
                    emit_expr(cc, obj);
                    emit_expr(cc, value);
                    emit(cc, Op.OSetField(fname));
                },
                _ => panic("compilador: destino de asignación no soportado"),
            }
        },
        SKind.SReturn(opt) => {
            match (opt) { Option.Some(e) => emit_expr(cc, e), Option.None => { emit(cc, Op.OUnit); } };
            emit(cc, Op.OReturn);
        },
        SKind.SExpr(e) => { emit_expr(cc, e); emit(cc, Op.OPop); },
    }
}

// =====================================================================
// Punto de entrada
// =====================================================================

fn compile_fn(f: Func, indices: Map<string, int>, structs: Map<string, [FieldDef]>, enums: Map<string, [VariantDef]>) -> CompiledFn {
    let cc = Cc { code: [], consts: [], locals: [], next_slot: 0, max_slots: 0, depth: 0,
                  indices: indices, structs: structs, enums: enums };
    var i = 0;
    while (i < len(f.params)) { declare_local(cc, f.params[i].name); i = i + 1; }
    emit_block(cc, f.body);     // deja el valor del cuerpo en la pila
    emit(cc, Op.OReturn);       // ...que se retorna
    CompiledFn { name: f.name, arity: len(f.params), nslots: cc.max_slots, chunk: Chunk { code: cc.code, consts: cc.consts } }
}

// Registra los enums del prelude (Option/Result) para RECONOCER su construcción `Option.Some`/`Result.Ok`
// en compilación, como el intérprete los inyecta en runtime (`inject_prelude_enums`). Solo importan los
// nombres de las variantes (la aridad la da el sitio de llamada).
fn inject_prelude_enums(enums: Map<string, [VariantDef]>) {
    insert(enums, "Option", [
        VariantDef { name: "Some", payload: [], line: 0, col: 0 },
        VariantDef { name: "None", payload: [], line: 0, col: 0 },
    ]);
    insert(enums, "Result", [
        VariantDef { name: "Ok", payload: [], line: 0, col: 0 },
        VariantDef { name: "Err", payload: [], line: 0, col: 0 },
    ]);
}

pub fn compile(prog: Program) -> CProgram {
    var indices: Map<string, int> = map_new();
    var i = 0;
    while (i < len(prog.funcs)) { insert(indices, prog.funcs[i].name, i); i = i + 1; }

    var structs: Map<string, [FieldDef]> = map_new();
    var s = 0;
    while (s < len(prog.structs)) { insert(structs, prog.structs[s].name, prog.structs[s].fields); s = s + 1; }

    var enums: Map<string, [VariantDef]> = map_new();
    inject_prelude_enums(enums);
    var e = 0;
    while (e < len(prog.enums)) { insert(enums, prog.enums[e].name, prog.enums[e].variants); e = e + 1; }

    var fns: [CompiledFn] = [];
    var j = 0;
    while (j < len(prog.funcs)) { push(fns, compile_fn(prog.funcs[j], indices, structs, enums)); j = j + 1; }
    CProgram { fns: fns }
}
