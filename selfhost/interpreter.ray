// El intérprete (back-end de ejecución) de raylang, escrito EN raylang (self-hosting, M14.4).
//
// Cuarta y última fase del bootstrap: AST validado (del parser/checker auto-alojados) → EJECUCIÓN.
// Port del intérprete tree-walking de Rust (`src/interpreter.rs`, el motor simple/oráculo). Cierra el
// self-hosting: raylang lexea/parsea/chequea/ejecuta raylang de punta a punta.
//
// DECISIÓN CLAVE (DESIGN §23.5): RESOLUCIÓN EN RUNTIME, no lowering. El checker auto-alojado es solo un
// validador (omitió el lowering de M9). En vez de reproducir M9, este intérprete resuelve construcción
// de enum / UFCS / métodos / `dyn` en tiempo de evaluación mirando la ETIQUETA del valor → `dyn`/bounds/
// genéricos quedan como no-ops (el intérprete nunca consulta tipos; el borrado ocurre solo).
//
// FACTIBLE porque CABALGA SOBRE EL HOST: el `Value` es un enum de raylang en el heap de la VM
// anfitriona (su GC lo recolecta) y la semántica de referencia (M3) da gratis lo que en Rust pide
// `Rc<RefCell<…>>`. No reimplementamos GC ni celdas.
//
// ORÁCULO CONDUCTUAL (no texto canónico): la misma `.ray` por ambos pipelines (Rust `cargo run` vs
// `raylang selfhost/run.ray`), comparar stdout + código de salida. Ver `tests/selfhost_interpreter.rs`.
//
// M14.4a: NÚCLEO. Primitivos (int/float/bool/string/char/unit), aritmética/comparación/lógica (con
// cortocircuito), variables (let/var, mutabilidad por ámbito), if/while/block/return, llamadas a
// funciones nombradas + recursión, builtins print/eprint/to_string/panic. Cubre fib/fizzbuzz/gcd/primes.
//
// M14.4b (esta versión): DATOS. Arreglos (`VArray`: literal, índice, `len`/`push`, asignación `a[i]=v`,
// anidados; semántica de REFERENCIA gratis del `[Value]` del host), structs (`VStruct`: literal en orden
// de declaración, acceso/asignación de campo, aliasing), enums (`VEnum`: construcción `Enum.Variante(args)`
// RECONOCIDA EN RUNTIME mirando las tablas del programa —el checker-validador no la reescribió—, `match`
// con patrones comodín/binding/variante). Diferido: primera clase (M14.4c: closures/orden superior/
// Option/Result/`?`), despacho dinámico (M14.4d: UFCS/métodos/dyn/@derive). TCO/MAX_CALL_DEPTH también
// (el host ya da TCO + pila grande).

from parser import Expr, EKind, Stmt, SKind, Block, Func, Param, Program, BinOp, UnOp, FieldInit, FieldDef, VariantDef, MatchArm, Pattern, PKind;

// =====================================================================
// Valores en tiempo de ejecución y señales de flujo
// =====================================================================

// Un valor del intérprete (espejo del `Value` de Rust). M14.4b añade los compuestos; función/closure/map
// llegan en M14.4c/d. Los compuestos heredan la semántica de REFERENCIA del host: un `[Value]`/`[SField]`
// de raylang ya es un objeto del heap compartido por alias (lo que en Rust pide `Rc<RefCell<…>>`).
pub enum Value {
    VInt(int),
    VFloat(float),
    VBool(bool),
    VStr(string),
    VChar(char),
    VUnit,
    VArray([Value]),               // arreglo (M3): el [Value] del host da referencia + mutación
    VStruct(string, [SField]),     // struct: nombre + campos en orden de declaración (mutables)
    VEnum(string, string, [Value]), // enum: nombre, variante, payload (inmutable)
}

// Un campo de un struct en runtime: nombre + valor (mutable). Lista ordenada (como el `Vec<(String,
// Value)>` de Rust) → el orden de declaración para Display/igualdad.
struct SField { name: string, value: Value }

// Una variable ligada por un patrón de `match`: su nombre y el valor que recibe.
struct Binding { name: string, value: Value }

// Error en tiempo de ejecución con ubicación (espejo de `RuntimeError` en Rust).
pub struct RuntimeError { msg: string, line: int, col: int }

// Lo que interrumpe la evaluación normal (espejo de `Flow` en Rust, sin `TailCall`: TCO diferido):
//   - FReturn(v): un `return` propagándose hacia el borde de la función.
//   - FError(e):  un error de ejecución real, hasta el tope.
// Ambos viajan por el canal de error de `Result` (`?` los desenrolla); el borde de la función los
// distingue (un `return` produce el valor; un error se reporta).
enum Flow { FReturn(Value), FError(RuntimeError) }

// El estado del intérprete: tabla de funciones por nombre, definiciones de structs (campos en orden) y
// enums (variantes) —para construir literales y RECONOCER la construcción de enum en runtime—, y la pila
// de ámbitos (la del último es la más interna). Struct mutado por referencia (como Checker/Parser/Lexer).
struct Interp {
    funcs: Map<string, Func>,
    structs: Map<string, [FieldDef]>,
    enums: Map<string, [VariantDef]>,
    scopes: [Map<string, Value>],
}

fn rt_error(line: int, col: int, msg: string) -> RuntimeError {
    RuntimeError { msg: msg, line: line, col: col }
}

// Una pila de ámbitos vacía, ya tipada (para reiniciar `c.scopes`; el `[]` en asignación no infiere).
fn empty_scopes() -> [Map<string, Value>] { [] }

// Una lista de valores vacía, ya tipada (para los argumentos de `main`).
fn no_vals() -> [Value] { [] }

// =====================================================================
// Presentación e igualdad de valores
// =====================================================================

// Representación textual de un valor, idéntica al `Display` de `Value` en Rust (la usa `print`/
// `to_string`). Los flotantes usan el `to_string` del host = el `Display` de f64 de Rust → coincide.
fn value_str(v: Value) -> string {
    match (v) {
        Value.VInt(n) => to_string(n),
        Value.VFloat(x) => to_string(x),
        Value.VBool(b) => to_string(b),
        Value.VStr(s) => s,
        Value.VChar(ch) => to_string(ch),
        Value.VUnit => "()",
        Value.VArray(elems) => "[" + join_vals(elems) + "]",
        Value.VStruct(name, fields) => name + " { " + join_fields(fields) + " }",
        Value.VEnum(en, vr, payload) => {
            if (len(payload) == 0) { en + "." + vr }
            else { en + "." + vr + "(" + join_vals(payload) + ")" }
        },
    }
}

// Une los `value_str` de una lista con ", " (para arreglos y payload de enum).
fn join_vals(vals: [Value]) -> string {
    var s = "";
    var i = 0;
    while (i < len(vals)) {
        if (i > 0) { s = s + ", "; }
        s = s + value_str(vals[i]);
        i = i + 1;
    }
    s
}

// Une los campos `nombre: valor` de un struct con ", " (en orden de declaración).
fn join_fields(fields: [SField]) -> string {
    var s = "";
    var i = 0;
    while (i < len(fields)) {
        if (i > 0) { s = s + ", "; }
        s = s + fields[i].name + ": " + value_str(fields[i].value);
        i = i + 1;
    }
    s
}

// Igualdad estructural de valores (para `==`/`!=`). El checker garantiza que ambos lados son del mismo
// tipo, así que las ramas cruzadas no se ejercitan en programas válidos. Los compuestos comparan recursivo
// (el checker solo lo permite sobre tipos con `==`, p. ej. derivados).
fn values_equal(a: Value, b: Value) -> bool {
    match (a) {
        Value.VInt(x) => match (b) { Value.VInt(y) => x == y, _ => false },
        Value.VFloat(x) => match (b) { Value.VFloat(y) => x == y, _ => false },
        Value.VBool(x) => match (b) { Value.VBool(y) => x == y, _ => false },
        Value.VStr(x) => match (b) { Value.VStr(y) => x == y, _ => false },
        Value.VChar(x) => match (b) { Value.VChar(y) => x == y, _ => false },
        Value.VUnit => match (b) { Value.VUnit => true, _ => false },
        Value.VArray(x) => match (b) { Value.VArray(y) => vals_equal_list(x, y), _ => false },
        Value.VStruct(nx, fx) => match (b) {
            Value.VStruct(ny, fy) => nx == ny && fields_equal(fx, fy),
            _ => false,
        },
        Value.VEnum(ex, vx, px) => match (b) {
            Value.VEnum(ey, vy, py) => ex == ey && vx == vy && vals_equal_list(px, py),
            _ => false,
        },
    }
}

fn vals_equal_list(a: [Value], b: [Value]) -> bool {
    if (len(a) != len(b)) { return false; }
    var i = 0;
    while (i < len(a)) {
        if (!values_equal(a[i], b[i])) { return false; }
        i = i + 1;
    }
    true
}

fn fields_equal(a: [SField], b: [SField]) -> bool {
    if (len(a) != len(b)) { return false; }
    var i = 0;
    while (i < len(a)) {
        if (a[i].name != b[i].name) { return false; }
        if (!values_equal(a[i].value, b[i].value)) { return false; }
        i = i + 1;
    }
    true
}

// Desempaqueta un valor que el checker garantizó string (para `panic`).
fn as_str(v: Value) -> string {
    match (v) { Value.VStr(s) => s, _ => panic("se esperaba un string") }
}

// Desempaqueta un valor que el checker garantizó int (para los índices).
fn as_int(v: Value) -> int {
    match (v) { Value.VInt(n) => n, _ => panic("se esperaba un int") }
}

// Una lista de bindings vacía, ya tipada (para los patrones sin variables).
fn no_bindings() -> [Binding] { [] }

// Los campos declarados de un struct (en orden), de la tabla del programa.
fn struct_fields(c: Interp, name: string) -> [FieldDef] {
    match (get(c.structs, name)) {
        Option.Some(fs) => fs,
        Option.None => panic("struct no registrado: " + name),
    }
}

// ¿`name` es un enum (del programa) con una variante llamada `variant`? Así se RECONOCE la construcción
// de enum en runtime (`Enum.Variante`), que el checker-validador no reescribió a un nodo dedicado.
fn enum_has_variant(c: Interp, name: string, variant: string) -> bool {
    match (get(c.enums, name)) {
        Option.Some(variants) => {
            var i = 0;
            while (i < len(variants)) {
                if (variants[i].name == variant) { return true; }
                i = i + 1;
            }
            false
        },
        Option.None => false,
    }
}

// La expresión del campo `fname` en un literal de struct (el checker garantiza que está presente).
fn find_field_init(inits: [FieldInit], fname: string) -> Expr {
    var i = 0;
    while (i < len(inits)) {
        if (inits[i].name == fname) { return inits[i].value; }
        i = i + 1;
    }
    panic("campo ausente en el literal: " + fname)
}

// Lee el valor del campo `fname` de un struct en runtime (el checker garantiza el campo).
fn struct_get(fields: [SField], fname: string) -> Value {
    var i = 0;
    while (i < len(fields)) {
        if (fields[i].name == fname) { return fields[i].value; }
        i = i + 1;
    }
    panic("campo no encontrado: " + fname)
}

// Asigna al campo `fname` de un struct en runtime, mutando la celda compartida (aliasing).
fn struct_set(fields: [SField], fname: string, v: Value) {
    var i = 0;
    while (i < len(fields)) {
        if (fields[i].name == fname) { fields[i].value = v; return; }
        i = i + 1;
    }
    panic("campo no encontrado: " + fname)
}

// =====================================================================
// Ámbitos: declarar, buscar, asignar
// =====================================================================

fn new_scope() -> Map<string, Value> { map_new() }

fn push_scope(c: Interp) { push(c.scopes, new_scope()); }

fn pop_scope(c: Interp) {
    let removed = pop(c.scopes);
}

// Declara una variable en el ámbito más interno. En M14.4a las celdas son el propio valor (sin
// compartición); la captura por referencia de closures (celdas compartidas) llega en M14.4c.
fn define(c: Interp, name: string, v: Value) {
    let top = c.scopes[len(c.scopes) - 1];
    insert(top, name, v);
}

// Busca una variable de adentro hacia afuera; `None` si no es una variable (en ese caso el nombre es
// una función usada como valor, diferido a M14.4c).
fn lookup_opt(c: Interp, name: string) -> Option<Value> {
    var i = len(c.scopes) - 1;
    while (i >= 0) {
        match (get(c.scopes[i], name)) {
            Option.Some(v) => { return Option.Some(v); },
            Option.None => {},
        }
        i = i - 1;
    }
    Option.None
}

// Asigna a una variable ya declarada, reemplazando su valor en el ámbito que la contiene.
fn assign(c: Interp, name: string, v: Value) {
    var i = len(c.scopes) - 1;
    while (i >= 0) {
        match (get(c.scopes[i], name)) {
            Option.Some(_) => { insert(c.scopes[i], name, v); return; },
            Option.None => {},
        }
        i = i - 1;
    }
}

// =====================================================================
// Operadores
// =====================================================================

fn cmp_int(op: BinOp, a: int, b: int) -> bool {
    match (op) {
        BinOp.Lt => a < b, BinOp.Le => a <= b, BinOp.Gt => a > b, BinOp.Ge => a >= b,
        _ => panic("cmp_int: operador inesperado"),
    }
}

fn cmp_float(op: BinOp, a: float, b: float) -> bool {
    match (op) {
        BinOp.Lt => a < b, BinOp.Le => a <= b, BinOp.Gt => a > b, BinOp.Ge => a >= b,
        _ => panic("cmp_float: operador inesperado"),
    }
}

fn cmp_str(op: BinOp, a: string, b: string) -> bool {
    match (op) {
        BinOp.Lt => a < b, BinOp.Le => a <= b, BinOp.Gt => a > b, BinOp.Ge => a >= b,
        _ => panic("cmp_str: operador inesperado"),
    }
}

fn cmp_char(op: BinOp, a: char, b: char) -> bool {
    match (op) {
        BinOp.Lt => a < b, BinOp.Le => a <= b, BinOp.Gt => a > b, BinOp.Ge => a >= b,
        _ => panic("cmp_char: operador inesperado"),
    }
}

// `+`: aritmética entera/flotante o concatenación de strings (M11.1a). Arreglos → M14.4b.
fn eval_add(l: Value, r: Value) -> Result<Value, Flow> {
    match (l) {
        Value.VInt(a) => match (r) { Value.VInt(b) => Result.Ok(Value.VInt(a + b)), _ => panic("+ inválido") },
        Value.VFloat(a) => match (r) { Value.VFloat(b) => Result.Ok(Value.VFloat(a + b)), _ => panic("+ inválido") },
        Value.VStr(a) => match (r) { Value.VStr(b) => Result.Ok(Value.VStr(a + b)), _ => panic("+ inválido") },
        _ => panic("+ inválido"),
    }
}

fn arith_int(op: BinOp, a: int, b: int, line: int, col: int) -> Result<Value, Flow> {
    match (op) {
        BinOp.Sub => Result.Ok(Value.VInt(a - b)),
        BinOp.Mul => Result.Ok(Value.VInt(a * b)),
        BinOp.Div => {
            if (b == 0) { return Result.Err(Flow.FError(rt_error(line, col, "división entera por cero"))); }
            Result.Ok(Value.VInt(a / b))
        },
        BinOp.Rem => {
            if (b == 0) { return Result.Err(Flow.FError(rt_error(line, col, "módulo por cero"))); }
            Result.Ok(Value.VInt(a % b))
        },
        _ => panic("arith_int: operador inesperado"),
    }
}

fn arith_float(op: BinOp, a: float, b: float) -> Result<Value, Flow> {
    match (op) {
        BinOp.Sub => Result.Ok(Value.VFloat(a - b)),
        BinOp.Mul => Result.Ok(Value.VFloat(a * b)),
        BinOp.Div => Result.Ok(Value.VFloat(a / b)),
        BinOp.Rem => Result.Ok(Value.VFloat(a % b)),
        _ => panic("arith_float: operador inesperado"),
    }
}

// Sub/Mul/Div/Rem sobre dos enteros o dos flotantes.
fn eval_arith(op: BinOp, l: Value, r: Value, line: int, col: int) -> Result<Value, Flow> {
    match (l) {
        Value.VInt(a) => match (r) { Value.VInt(b) => arith_int(op, a, b, line, col), _ => panic("aritmética inválida") },
        Value.VFloat(a) => match (r) { Value.VFloat(b) => arith_float(op, a, b), _ => panic("aritmética inválida") },
        _ => panic("aritmética inválida"),
    }
}

// Lt/Le/Gt/Ge sobre números, strings (lexicográfico) o char (code point) (M11.7d).
fn eval_cmp(op: BinOp, l: Value, r: Value) -> Result<Value, Flow> {
    match (l) {
        Value.VInt(a) => match (r) { Value.VInt(b) => Result.Ok(Value.VBool(cmp_int(op, a, b))), _ => panic("comparación inválida") },
        Value.VFloat(a) => match (r) { Value.VFloat(b) => Result.Ok(Value.VBool(cmp_float(op, a, b))), _ => panic("comparación inválida") },
        Value.VStr(a) => match (r) { Value.VStr(b) => Result.Ok(Value.VBool(cmp_str(op, a, b))), _ => panic("comparación inválida") },
        Value.VChar(a) => match (r) { Value.VChar(b) => Result.Ok(Value.VBool(cmp_char(op, a, b))), _ => panic("comparación inválida") },
        _ => panic("comparación inválida"),
    }
}

// Un operador binario. Los lógicos (`&&`/`||`) hacen CORTOCIRCUITO → se tratan antes de evaluar ambos.
fn eval_binary(c: Interp, op: BinOp, left: Expr, right: Expr, line: int, col: int) -> Result<Value, Flow> {
    match (op) {
        BinOp.And => {
            if (!eval_bool(c, left)?) { return Result.Ok(Value.VBool(false)); }
            return Result.Ok(Value.VBool(eval_bool(c, right)?));
        },
        BinOp.Or => {
            if (eval_bool(c, left)?) { return Result.Ok(Value.VBool(true)); }
            return Result.Ok(Value.VBool(eval_bool(c, right)?));
        },
        _ => {},
    }
    let l = eval_expr(c, left)?;
    let r = eval_expr(c, right)?;
    match (op) {
        BinOp.Add => eval_add(l, r),
        BinOp.Sub => eval_arith(op, l, r, line, col),
        BinOp.Mul => eval_arith(op, l, r, line, col),
        BinOp.Div => eval_arith(op, l, r, line, col),
        BinOp.Rem => eval_arith(op, l, r, line, col),
        BinOp.Eq => Result.Ok(Value.VBool(values_equal(l, r))),
        BinOp.Ne => Result.Ok(Value.VBool(!values_equal(l, r))),
        BinOp.Lt => eval_cmp(op, l, r),
        BinOp.Le => eval_cmp(op, l, r),
        BinOp.Gt => eval_cmp(op, l, r),
        BinOp.Ge => eval_cmp(op, l, r),
        BinOp.And => panic("inalcanzable: && ya tratado"),
        BinOp.Or => panic("inalcanzable: || ya tratado"),
    }
}

fn eval_unary(c: Interp, op: UnOp, inner: Expr) -> Result<Value, Flow> {
    let v = eval_expr(c, inner)?;
    match (op) {
        UnOp.Neg => match (v) {
            Value.VInt(n) => Result.Ok(Value.VInt(-n)),
            Value.VFloat(x) => Result.Ok(Value.VFloat(-x)),
            _ => panic("negación inválida"),
        },
        UnOp.Not => match (v) {
            Value.VBool(b) => Result.Ok(Value.VBool(!b)),
            _ => panic("negación lógica inválida"),
        },
    }
}

// =====================================================================
// Auxiliares de evaluación tipada
// =====================================================================

fn eval_bool(c: Interp, e: Expr) -> Result<bool, Flow> {
    let v = eval_expr(c, e)?;
    match (v) { Value.VBool(b) => Result.Ok(b), _ => panic("se esperaba una condición booleana") }
}

// =====================================================================
// Llamadas y builtins
// =====================================================================

fn is_builtin(name: string) -> bool {
    name == "print" || name == "eprint" || name == "to_string" || name == "panic"
        || name == "len" || name == "push"
}

// `len` de un arreglo o un string (nº de caracteres). Map → M14.4c/d.
fn builtin_len(v: Value) -> int {
    match (v) {
        Value.VArray(elems) => len(elems),
        Value.VStr(s) => len(s),
        _ => panic("len: se esperaba un arreglo o string"),
    }
}

// Evalúa la lista de argumentos en orden (cortocircuitando ante un `return`/error).
fn eval_args(c: Interp, args: [Expr]) -> Result<[Value], Flow> {
    var vals: [Value] = [];
    var i = 0;
    while (i < len(args)) {
        let v = eval_expr(c, args[i])?;
        push(vals, v);
        i = i + 1;
    }
    Result.Ok(vals)
}

// Ejecuta un builtin con sus argumentos. `panic` se intercepta aquí (necesita la posición de la llamada
// y debe producir un FError, no un Value), igual que en el intérprete de Rust.
fn call_builtin(c: Interp, name: string, args: [Expr], line: int, col: int) -> Result<Value, Flow> {
    let vals = eval_args(c, args)?;
    if (name == "panic") {
        return Result.Err(Flow.FError(rt_error(line, col, as_str(vals[0]))));
    }
    if (name == "print") {
        print(value_str(vals[0]));
        return Result.Ok(Value.VUnit);
    }
    if (name == "eprint") {
        eprint(value_str(vals[0]));
        return Result.Ok(Value.VUnit);
    }
    if (name == "to_string") {
        return Result.Ok(Value.VStr(value_str(vals[0])));
    }
    if (name == "len") {
        return Result.Ok(Value.VInt(builtin_len(vals[0])));
    }
    if (name == "push") {
        // push(arr, x): muta el arreglo compartido (semántica de referencia del host).
        match (vals[0]) {
            Value.VArray(elems) => { push(elems, vals[1]); Result.Ok(Value.VUnit) },
            _ => panic("push: se esperaba un arreglo"),
        }
    } else {
        panic("builtin no implementado en M14.4b: " + name)
    }
}

// Una llamada. Camino directo por nombre (builtin o función global). Construcción de enum con payload
// `Enum.Variante(args)` reconocida en runtime (callee `EField` sobre un nombre de enum). El camino
// indirecto (valor-función/closures) y el despacho dinámico (UFCS/métodos) llegan en M14.4c/d.
fn eval_call(c: Interp, callee: Expr, args: [Expr]) -> Result<Value, Flow> {
    match (callee.kind) {
        EKind.EIdent(name) => {
            match (lookup_opt(c, name)) {
                Option.Some(_) => panic("M14.4c: función como valor / closure"),
                Option.None => {
                    if (is_builtin(name)) {
                        call_builtin(c, name, args, callee.line, callee.col)
                    } else {
                        match (get(c.funcs, name)) {
                            Option.Some(f) => {
                                let vals = eval_args(c, args)?;
                                call_named(c, f, vals)
                            },
                            Option.None => panic("M14.4c: función como valor / closure"),
                        }
                    }
                },
            }
        },
        EKind.EField(obj, fname) => {
            // ¿Construcción de variante con payload, `Enum.Variante(args)`?
            match (obj.kind) {
                EKind.EIdent(maybe_enum) => {
                    match (lookup_opt(c, maybe_enum)) {
                        Option.Some(_) => panic("M14.4d: método / UFCS"),
                        Option.None => {
                            if (enum_has_variant(c, maybe_enum, fname)) {
                                let vals = eval_args(c, args)?;
                                Result.Ok(Value.VEnum(maybe_enum, fname, vals))
                            } else {
                                panic("M14.4d: método / UFCS")
                            }
                        },
                    }
                },
                _ => panic("M14.4d: método / UFCS"),
            }
        },
        _ => panic("M14.4c: llamada indirecta"),
    }
}

// Ejecuta una función nombrada con sus argumentos ya evaluados. Scoping léxico: arranca con una pila de
// ámbitos NUEVA (no la de quien llama); se guarda la actual y se restaura al volver. Un `return` interno
// (FReturn) se desenvuelve aquí en el valor de la función.
fn call_named(c: Interp, f: Func, args: [Value]) -> Result<Value, Flow> {
    let saved = c.scopes;
    c.scopes = empty_scopes();
    push_scope(c); // ámbito de los parámetros
    var i = 0;
    while (i < len(f.params)) {
        define(c, f.params[i].name, args[i]);
        i = i + 1;
    }
    let result = exec_block(c, f.body); // empuja, encima, el ámbito del cuerpo
    c.scopes = saved; // restaurar el entorno de quien llama
    match (result) {
        Result.Ok(v) => Result.Ok(v),
        Result.Err(flow) => match (flow) {
            Flow.FReturn(v) => Result.Ok(v),
            Flow.FError(e) => Result.Err(Flow.FError(e)),
        },
    }
}

// =====================================================================
// Sentencias y bloques
// =====================================================================

fn exec_stmt(c: Interp, s: Stmt) -> Result<Value, Flow> {
    match (s.kind) {
        SKind.SLet(name, _, value, _) => {
            let v = eval_expr(c, value)?;
            define(c, name, v);
            Result.Ok(Value.VUnit)
        },
        SKind.SAssign(target, value) => {
            let v = eval_expr(c, value)?;
            match (target.kind) {
                EKind.EIdent(name) => { assign(c, name, v); Result.Ok(Value.VUnit) },
                EKind.EIndex(arr_e, idx_e) => assign_index(c, arr_e, idx_e, v),
                EKind.EField(obj_e, fname) => assign_field(c, obj_e, fname, v),
                _ => panic("lvalue inválido (el checker debió rechazarlo)"),
            }
        },
        SKind.SReturn(opt) => {
            match (opt) {
                Option.Some(e) => {
                    let v = eval_expr(c, e)?;
                    Result.Err(Flow.FReturn(v))
                },
                Option.None => Result.Err(Flow.FReturn(Value.VUnit)),
            }
        },
        SKind.SExpr(e) => {
            eval_expr(c, e)?;
            Result.Ok(Value.VUnit)
        },
    }
}

// Ejecuta las sentencias de un bloque en orden; el primer `return`/error corta y se propaga (vía `?`).
fn run_stmts(c: Interp, b: Block) -> Result<Value, Flow> {
    var i = 0;
    while (i < len(b.stmts)) {
        exec_stmt(c, b.stmts[i])?;
        i = i + 1;
    }
    Result.Ok(Value.VUnit)
}

// El cuerpo de un bloque en su propio ámbito: corre las sentencias y luego la expresión final (`tail`),
// o `Unit` si no la hay.
fn exec_block_inner(c: Interp, b: Block) -> Result<Value, Flow> {
    run_stmts(c, b)?;
    match (b.tail) {
        Option.Some(e) => eval_expr(c, e),
        Option.None => Result.Ok(Value.VUnit),
    }
}

// Ejecuta un bloque empujando/quitando su ámbito (en todos los caminos, también al propagar un error).
fn exec_block(c: Interp, b: Block) -> Result<Value, Flow> {
    push_scope(c);
    let r = exec_block_inner(c, b);
    pop_scope(c);
    r
}

// Un bucle `while`: re-evalúa la condición; el valor del cuerpo se descarta, pero un `return`/error
// dentro se propaga.
fn eval_while(c: Interp, cond: Expr, body: Block) -> Result<Value, Flow> {
    var go = eval_bool(c, cond)?;
    while (go) {
        exec_block(c, body)?;
        go = eval_bool(c, cond)?;
    }
    Result.Ok(Value.VUnit)
}

// =====================================================================
// Expresiones
// =====================================================================

fn eval_expr(c: Interp, expr: Expr) -> Result<Value, Flow> {
    match (expr.kind) {
        EKind.EInt(n) => Result.Ok(Value.VInt(n)),
        EKind.EFloat(x) => Result.Ok(Value.VFloat(x)),
        EKind.EBool(b) => Result.Ok(Value.VBool(b)),
        EKind.EStr(s) => Result.Ok(Value.VStr(s)),
        EKind.EChar(ch) => Result.Ok(Value.VChar(ch)),
        EKind.EIdent(name) => {
            match (lookup_opt(c, name)) {
                Option.Some(v) => Result.Ok(v),
                Option.None => panic("M14.4c: función como valor '" + name + "'"),
            }
        },
        EKind.EUnary(op, inner) => eval_unary(c, op, inner),
        EKind.EBinary(op, l, r) => eval_binary(c, op, l, r, expr.line, expr.col),
        EKind.ECall(callee, cargs) => eval_call(c, callee, cargs),
        EKind.EIf(cond, then_b, else_o) => {
            if (eval_bool(c, cond)?) {
                exec_block(c, then_b)
            } else {
                match (else_o) {
                    Option.Some(e) => eval_expr(c, e),
                    Option.None => Result.Ok(Value.VUnit),
                }
            }
        },
        EKind.EWhile(cond, body) => eval_while(c, cond, body),
        EKind.EBlock(b) => exec_block(c, b),
        EKind.EIndex(arr_e, idx_e) => eval_index(c, arr_e, idx_e),
        EKind.EField(obj, fname) => eval_field_or_enum(c, obj, fname),
        EKind.EArray(elems) => eval_array(c, elems),
        EKind.EStructLit(name, inits) => eval_struct_lit(c, name, inits),
        EKind.EFunc(_) => panic("M14.4c: función anónima"),
        EKind.EMatch(scr, arms) => eval_match(c, scr, arms),
        EKind.ETry(_) => panic("M14.4c: operador ?"),
    }
}

// =====================================================================
// Datos: arreglos, structs, enums, match
// =====================================================================

// Error de índice fuera de rango (mensaje idéntico al de Rust).
fn oob(idx_e: Expr, i: int, n: int) -> RuntimeError {
    rt_error(idx_e.line, idx_e.col, "índice " + to_string(i) + " fuera de rango (longitud " + to_string(n) + ")")
}

fn eval_array(c: Interp, elems: [Expr]) -> Result<Value, Flow> {
    var vals: [Value] = [];
    var i = 0;
    while (i < len(elems)) {
        let v = eval_expr(c, elems[i])?;
        push(vals, v);
        i = i + 1;
    }
    Result.Ok(Value.VArray(vals))
}

// Indexar un arreglo (→ elemento) o un string (→ char, M11.4c-2). Fuera de rango = error de ejecución.
fn eval_index(c: Interp, arr_e: Expr, idx_e: Expr) -> Result<Value, Flow> {
    let target = eval_expr(c, arr_e)?;
    let i = as_int(eval_expr(c, idx_e)?);
    match (target) {
        Value.VArray(elems) => {
            if (i < 0 || i >= len(elems)) { return Result.Err(Flow.FError(oob(idx_e, i, len(elems)))); }
            Result.Ok(elems[i])
        },
        Value.VStr(s) => {
            let cs = chars(s);
            if (i < 0 || i >= len(cs)) { return Result.Err(Flow.FError(oob(idx_e, i, len(cs)))); }
            Result.Ok(Value.VChar(cs[i]))
        },
        _ => panic("indexar sobre un no-arreglo/string"),
    }
}

// `obj.fname`: construcción de variante unit `Enum.Variante` (reconocida en runtime) o acceso a campo.
fn eval_field_or_enum(c: Interp, obj: Expr, fname: string) -> Result<Value, Flow> {
    match (obj.kind) {
        EKind.EIdent(maybe_enum) => {
            match (lookup_opt(c, maybe_enum)) {
                Option.Some(_) => eval_field(c, obj, fname),
                Option.None => {
                    if (enum_has_variant(c, maybe_enum, fname)) {
                        Result.Ok(Value.VEnum(maybe_enum, fname, no_vals()))
                    } else {
                        eval_field(c, obj, fname)
                    }
                },
            }
        },
        _ => eval_field(c, obj, fname),
    }
}

fn eval_field(c: Interp, obj: Expr, fname: string) -> Result<Value, Flow> {
    let v = eval_expr(c, obj)?;
    match (v) {
        Value.VStruct(_, fields) => Result.Ok(struct_get(fields, fname)),
        _ => panic("acceso a campo sobre un no-struct"),
    }
}

// Construye un struct evaluando los campos en ORDEN DE DECLARACIÓN (como Rust → Display/igualdad casan).
fn eval_struct_lit(c: Interp, name: string, inits: [FieldInit]) -> Result<Value, Flow> {
    let defs = struct_fields(c, name);
    var built: [SField] = [];
    var i = 0;
    while (i < len(defs)) {
        let fname = defs[i].name;
        let v = eval_expr(c, find_field_init(inits, fname))?;
        push(built, SField { name: fname, value: v });
        i = i + 1;
    }
    Result.Ok(Value.VStruct(name, built))
}

fn assign_index(c: Interp, arr_e: Expr, idx_e: Expr, v: Value) -> Result<Value, Flow> {
    let target = eval_expr(c, arr_e)?;
    let i = as_int(eval_expr(c, idx_e)?);
    match (target) {
        Value.VArray(elems) => {
            if (i < 0 || i >= len(elems)) { return Result.Err(Flow.FError(oob(idx_e, i, len(elems)))); }
            elems[i] = v; // muta el arreglo compartido
            Result.Ok(Value.VUnit)
        },
        _ => panic("asignar índice sobre un no-arreglo"),
    }
}

fn assign_field(c: Interp, obj_e: Expr, fname: string, v: Value) -> Result<Value, Flow> {
    let target = eval_expr(c, obj_e)?;
    match (target) {
        Value.VStruct(_, fields) => { struct_set(fields, fname, v); Result.Ok(Value.VUnit) },
        _ => panic("asignar campo sobre un no-struct"),
    }
}

// Intenta casar un patrón contra un valor; si casa, devuelve los bindings (`None` si no). El checker
// garantiza la consistencia variante/aridad, así que solo se compara la etiqueta y se reparte el payload.
fn try_match(pat: Pattern, v: Value) -> Option<[Binding]> {
    match (pat.kind) {
        PKind.PWild => Option.Some(no_bindings()),
        PKind.PBind(name) => Option.Some([Binding { name: name, value: v }]),
        PKind.PVariant(_, variant, subs) => {
            match (v) {
                Value.VEnum(_, var2, payload) => {
                    if (variant == var2) {
                        var binds: [Binding] = [];
                        var i = 0;
                        while (i < len(subs)) {
                            match (subs[i]) {
                                Option.Some(nm) => { push(binds, Binding { name: nm, value: payload[i] }); },
                                Option.None => {},
                            }
                            i = i + 1;
                        }
                        Option.Some(binds)
                    } else {
                        Option.None
                    }
                },
                _ => Option.None,
            }
        },
    }
}

fn bind_all(c: Interp, binds: [Binding]) {
    var i = 0;
    while (i < len(binds)) {
        define(c, binds[i].name, binds[i].value);
        i = i + 1;
    }
}

// `match (scr) { patrón => cuerpo, ... }`: prueba los brazos en orden; el primero que casa liga sus
// variables en un ámbito nuevo y evalúa su cuerpo. El checker garantiza exhaustividad.
fn eval_match(c: Interp, scr: Expr, arms: [MatchArm]) -> Result<Value, Flow> {
    let v = eval_expr(c, scr)?;
    var i = 0;
    while (i < len(arms)) {
        match (try_match(arms[i].pat, v)) {
            Option.Some(binds) => {
                push_scope(c);
                bind_all(c, binds);
                let r = eval_expr(c, arms[i].body);
                pop_scope(c);
                return r;
            },
            Option.None => {},
        }
        i = i + 1;
    }
    Result.Err(Flow.FError(rt_error(scr.line, scr.col, "ningún brazo del match casó (no debería ocurrir)")))
}

// =====================================================================
// Punto de entrada
// =====================================================================

// Ejecuta el programa llamando a `main` y devuelve su valor (o un error de ejecución). El checker ya
// garantizó que `main` existe.
pub fn run(prog: Program) -> Result<Value, RuntimeError> {
    let c = Interp { funcs: map_new(), structs: map_new(), enums: map_new(), scopes: empty_scopes() };
    var i = 0;
    while (i < len(prog.funcs)) {
        insert(c.funcs, prog.funcs[i].name, prog.funcs[i]);
        i = i + 1;
    }
    var si = 0;
    while (si < len(prog.structs)) {
        insert(c.structs, prog.structs[si].name, prog.structs[si].fields);
        si = si + 1;
    }
    var ei = 0;
    while (ei < len(prog.enums)) {
        insert(c.enums, prog.enums[ei].name, prog.enums[ei].variants);
        ei = ei + 1;
    }
    match (get(c.funcs, "main")) {
        Option.Some(m) => {
            match (call_named(c, m, no_vals())) {
                Result.Ok(v) => Result.Ok(v),
                Result.Err(flow) => match (flow) {
                    Flow.FReturn(v) => Result.Ok(v),
                    Flow.FError(e) => Result.Err(e),
                },
            }
        },
        Option.None => Result.Err(rt_error(0, 0, "no hay función 'main'")),
    }
}
