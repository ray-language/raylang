// El intérprete (back-end de ejecución) de raylang, escrito EN raylang (self-hosting, M14.4).
//
// Cuarta y última fase del bootstrap: AST validado (del parser/checker auto-alojados) → EJECUCIÓN.
// Port del intérprete tree-walking de Rust (`src/interpreter.rs`, el motor simple/oráculo). Cierra el
// self-hosting: raylang lexea/parsea/chequea/ejecuta raylang de punta a punta.
//
// DECISIÓN CLAVE (DESIGN §23.5): RESOLUCIÓN EN RUNTIME, no lowering. El checker auto-alojado es solo un
// validador (omitió el lowering de M9). En vez de reproducir M9, este intérprete resuelve construcción
// de enum / UFCS / métodos / `dyn` en tiempo de evaluación mirando la ETIQUETA del valor → `dyn`/bounds/
// genéricos quedan como no-ops (el intérprete nunca consulta tipos; el borrado ocurre solo).
//
// FACTIBLE porque CABALGA SOBRE EL HOST: el `Value` es un enum de raylang en el heap de la VM
// anfitriona (su GC lo recolecta) y la semántica de referencia (M3) da gratis lo que en Rust pide
// `Rc<RefCell<…>>`. No reimplementamos GC ni celdas.
//
// ORÁCULO CONDUCTUAL (no texto canónico): la misma `.ray` por ambos pipelines (Rust `cargo run` vs
// `raylang selfhost/run.ray`), comparar stdout + código de salida. Ver `tests/selfhost_interpreter.rs`.
//
// M14.4a: NÚCLEO. Primitivos (int/float/bool/string/char/unit), aritmética/comparación/lógica (con
// cortocircuito), variables (let/var, mutabilidad por ámbito), if/while/block/return, llamadas a
// funciones nombradas + recursión, builtins print/eprint/to_string/panic. Cubre fib/fizzbuzz/gcd/primes.
//
// M14.4b: DATOS. Arreglos (`VArray`: literal, índice, `len`/`push`, asignación `a[i]=v`, anidados;
// semántica de REFERENCIA gratis del `[Value]` del host), structs (`VStruct`: literal en orden de
// declaración, acceso/asignación de campo, aliasing), enums (`VEnum`: construcción `Enum.Variante(args)`
// RECONOCIDA EN RUNTIME mirando las tablas del programa, `match` con patrones comodín/binding/variante).
//
// M14.4d-1 (esta versión): DESPACHO DINÁMICO. Aquí la decisión "RESOLUCIÓN EN RUNTIME" (DESIGN §23.5)
// alcanza su máxima expresión. `recv.f(args)` se resuelve en eval mirando la ETIQUETA del valor: campo-
// función del struct → método (tabla `Tipo#metodo` desde los `impl`, con métodos por defecto del trait)
// → `@derive` (igual ≡ values_equal, mostrar ≡ value_str) → UFCS a función libre `f(recv, args)` →
// builtin como método (`xs.len()`). Consecuencias ELEGANTES: **bounds y genéricos son no-ops** (el
// despacho mira el tipo concreto en runtime, sin pasar diccionarios) y **`dyn` es trivial** (un valor
// "objeto" ES el valor concreto, sin vtable; `obj.m()` despacha por su etiqueta). Diferido a M14.4d-2:
// map/filter/fold del prelude (stdlib.ray).
//
// M14.4c: PRIMERA CLASE. Funciones como valor (`VFunc`), funciones anónimas + closures
// (`VClosure`: captura por REFERENCIA vía CELDAS compartidas —un `struct Cell { v }` del host, que por
// su semántica de referencia es la celda mutable que comparten varias closures, como el `Rc<RefCell>`
// de Rust—), llamada indirecta, operador `?` (`ETry`) y los enums del prelude `Option`/`Result`
// (inyectados en `c.enums`: el intérprete solo necesita reconocer sus variantes). En vez del esquema de
// índices de Rust, el valor guarda el `Func`/`FnExpr` DIRECTAMENTE (referencia + GC del host). Diferido:
// despacho dinámico (M14.4d: UFCS/métodos/dyn/@derive + map/filter/fold del prelude). TCO/MAX_CALL_DEPTH
// también (el host ya da TCO + pila grande).
from parser import Type, Expr, EKind, Stmt, SKind, Block, Func, Param, Program, BinOp, UnOp, FieldInit, FieldDef, VariantDef, MatchArm, Pattern, PKind, FnExpr, MethodSig;

// =====================================================================
// Valores en tiempo de ejecución y señales de flujo
// =====================================================================
// Un valor del intérprete (espejo del `Value` de Rust). M14.4b añade los compuestos; función/closure/map
// llegan en M14.4c/d. Los compuestos heredan la semántica de REFERENCIA del host: un `[Value]`/`[SField]`
// de raylang ya es un objeto del heap compartido por alias (lo que en Rust pide `Rc<RefCell<…>>`).
pub enum Value {
    VInt(int),
    VFloat(float),
    VBool(bool),
    VStr(string),
    VChar(char),
    VUnit,
    VArray([Value]),  // arreglo (M3): el [Value] del host da referencia + mutación
    VStruct(string, [SField]),  // struct: nombre + campos en orden de declaración (mutables)
    VEnum(string, string, [Value]),  // enum: nombre, variante, payload (inmutable)
    VFunc(Func),  // una función nombrada usada como valor (sin captura)
    VClosure(FnExpr, [Capture]),  // una función anónima + su entorno capturado (celdas compartidas)
    VMap(MapData),  // un Map<K,V> (M14.6b): pares clave/valor (arrays paralelos)
    // M14.5c: el cierre de la VM auto-alojada. A diferencia del intérprete (AST: `FnExpr`+capturas por
    // nombre), la VM ejecuta BYTECODE → guarda el ÍNDICE de la función compilada + sus celdas capturadas
    // en orden de upvalue. Es la única variante específica de un motor (la representación de un cierre
    // difiere genuinamente entre AST y bytecode; en Rust también difieren intérprete y VM). El intérprete
    // nunca la crea ni la recibe.
    VVmClosure(int, [Cell]),  // índice en CProgram.fns + celdas capturadas (upvalues)
}

// Un Map en runtime. Arrays PARALELOS clave/valor con búsqueda lineal por igualdad estructural — no se
// usa un `Map` del host porque sus claves serían un `Value` (enum), no hasheable por el host. `MapData`
// es un struct (semántica de referencia) → `insert` muta y los alias lo ven (como `VArray`).
struct MapData {
    keys: [Value],
    vals: [Value],
}

// Un campo de un struct en runtime: nombre + valor (mutable). Lista ordenada (como el `Vec<(String,
// Value)>` de Rust) → el orden de declaración para Display/igualdad. `pub`: la VM (M14.5b) lo construye
// al ejecutar `OMakeStruct` (reusa el mismo `Value`).
pub struct SField {
    name: string,
    value: Value,
}

// Una variable ligada por un patrón de `match`: su nombre y el valor que recibe.
struct Binding {
    name: string,
    value: Value,
}

// Una CELDA: el contenedor mutable de una variable. Por la semántica de referencia del host, copiar la
// celda comparte el mismo objeto del heap → varias closures que la capturen ven la misma variable y sus
// mutaciones (es el análogo del `Rc<RefCell<Value>>` de Rust, sin reimplementar nada). `pub`: la VM
// (M14.5c) la reusa para sus locales y upvalues (toda local es una celda, como aquí).
pub struct Cell {
    v: Value,
}

// Una variable capturada por una closure: su nombre y la celda compartida con su origen.
struct Capture {
    name: string,
    cell: Cell,
}

// Un método invocable (de un `impl` o un cuerpo por defecto del trait): params (con `self` primero) +
// cuerpo. Unifica ambos orígenes para `call_method`.
struct Method {
    params: [Param],
    body: Block,
}

// Error en tiempo de ejecución con ubicación (espejo de `RuntimeError` en Rust).
pub struct RuntimeError {
    msg: string,
    line: int,
    col: int,
}

// Lo que interrumpe la evaluación normal (espejo de `Flow` en Rust, sin `TailCall`: TCO diferido):
//   - FReturn(v): un `return` propagándose hacia el borde de la función.
//   - FError(e):  un error de ejecución real, hasta el tope.
// Ambos viajan por el canal de error de `Result` (`?` los desenrolla); el borde de la función los
// distingue (un `return` produce el valor; un error se reporta).
pub enum Flow {
    FReturn(Value),
    FError(RuntimeError),
}

// El estado del intérprete: tabla de funciones por nombre, definiciones de structs (campos en orden) y
// enums (variantes) —para construir literales y RECONOCER la construcción de enum en runtime—, y la pila
// de ámbitos (la del último es la más interna). Struct mutado por referencia (como Checker/Parser/Lexer).
struct Interp {
    funcs: Map<string, Func>,
    structs: Map<string, [FieldDef]>,
    enums: Map<string, [VariantDef]>,
    methods: Map<string, Method>,
    scopes: [Map<string, Cell>],
    args: [string],
}

// `Tipo#metodo` → método (de impls + defectos del trait)
// argumentos de la línea de comandos (los enhebra `run`, M14.7c)
pub fn rt_error(line: int, col: int, msg: string) -> RuntimeError {
    RuntimeError { msg: msg, line: line, col: col }
}

// Una pila de ámbitos vacía, ya tipada (para reiniciar `c.scopes`; el `[]` en asignación no infiere).
fn empty_scopes() -> [Map<string, Cell>] { [] }

// Una lista de valores vacía, ya tipada (para los argumentos de `main`).
pub fn no_vals() -> [Value] { [] }

// Una lista de capturas vacía, ya tipada (para las funciones nombradas, sin entorno).
fn no_captures() -> [Capture] { [] }

// Una lista de tipos vacía, ya tipada (para el payload de las variantes del prelude inyectadas).
fn no_types() -> [Type] { [] }

// =====================================================================
// Presentación e igualdad de valores
// =====================================================================
// Representación textual de un valor, idéntica al `Display` de `Value` en Rust (la usa `print`/
// `to_string`). Los flotantes usan el `to_string` del host = el `Display` de f64 de Rust → coincide.
pub fn value_str(v: Value) -> string {
    match (v) {
        Value.VInt(n) => to_string(n),
        Value.VFloat(x) => to_string(x),
        Value.VBool(b) => to_string(b),
        Value.VStr(s) => s,
        Value.VChar(ch) => to_string(ch),
        Value.VUnit => "()",
        Value.VArray(elems) => "[" + join_vals(elems) + "]",
        Value.VStruct(name, fields) => name + " { " + join_fields(fields) + " }",
        Value.VEnum(en, vr, payload) => {
            if (payload.len() == 0) { en + "." + vr } else { en + "." + vr + "(" + join_vals(payload) + ")" }
        },
        Value.VFunc(_) => "<fn>",
        Value.VClosure(_, _) => "<fn>",
        Value.VVmClosure(_, _) => "<fn>",
        // Display de Map idéntico a Rust: `Map{k: v, ...}` con las partes ordenadas como strings. (El
        // checker prohíbe imprimir un Map, así que esto no se ejercita en programas válidos.)
        Value.VMap(d) => {
            var parts: [string] = [];
            var i = 0;
            while (i < d.keys.len()) {
                parts.push(value_str(d.keys[i]) + ": " + value_str(d.vals[i]));
                i = i + 1;
            }
            "Map{" + join(sort(parts), ", ") + "}"
        },
    }
}

// Une los `value_str` de una lista con ", " (para arreglos y payload de enum).
fn join_vals(vals: [Value]) -> string {
    var s = "";
    var i = 0;
    while (i < vals.len()) {
        if (i > 0) {
            s = s + ", ";
        }
        s = s + value_str(vals[i]);
        i = i + 1;
    }
    s
}

// Une los campos `nombre: valor` de un struct con ", " (en orden de declaración).
fn join_fields(fields: [SField]) -> string {
    var s = "";
    var i = 0;
    while (i < fields.len()) {
        if (i > 0) {
            s = s + ", ";
        }
        s = s + fields[i].name + ": " + value_str(fields[i].value);
        i = i + 1;
    }
    s
}

// Igualdad estructural de valores (para `==`/`!=`). El checker garantiza que ambos lados son del mismo
// tipo, así que las ramas cruzadas no se ejercitan en programas válidos. Los compuestos comparan recursivo
// (el checker solo lo permite sobre tipos con `==`, p. ej. derivados).
pub fn values_equal(a: Value, b: Value) -> bool {
    match (a) {
        Value.VInt(x) => match (b) {
            Value.VInt(y) => x == y,
            _ => false,
        },
        Value.VFloat(x) => match (b) {
            Value.VFloat(y) => x == y,
            _ => false,
        },
        Value.VBool(x) => match (b) {
            Value.VBool(y) => x == y,
            _ => false,
        },
        Value.VStr(x) => match (b) {
            Value.VStr(y) => x == y,
            _ => false,
        },
        Value.VChar(x) => match (b) {
            Value.VChar(y) => x == y,
            _ => false,
        },
        Value.VUnit => match (b) {
            Value.VUnit => true,
            _ => false,
        },
        Value.VArray(x) => match (b) {
            Value.VArray(y) => vals_equal_list(x, y),
            _ => false,
        },
        Value.VStruct(nx, fx) => match (b) {
            Value.VStruct(ny, fy) => nx == ny && fields_equal(fx, fy),
            _ => false,
        },
        Value.VEnum(ex, vx, px) => match (b) {
            Value.VEnum(ey, vy, py) => ex == ey && vx == vy && vals_equal_list(px, py),
            _ => false,
        },
        // Las funciones no tienen igualdad estructural (el checker prohíbe `==` sobre ellas).
        Value.VFunc(_) => false,
        Value.VClosure(_, _) => false,
        Value.VVmClosure(_, _) => false,
        // El checker prohíbe `==` sobre Map; no se ejercita en programas válidos.
        Value.VMap(_) => false,
    }
}

fn vals_equal_list(a: [Value], b: [Value]) -> bool {
    if (a.len() != b.len()) {
        return false;
    }
    var i = 0;
    while (i < a.len()) {
        if (!values_equal(a[i], b[i])) {
            return false;
        }
        i = i + 1;
    }
    true
}

fn fields_equal(a: [SField], b: [SField]) -> bool {
    if (a.len() != b.len()) {
        return false;
    }
    var i = 0;
    while (i < a.len()) {
        if (a[i].name != b[i].name) {
            return false;
        }
        if (!values_equal(a[i].value, b[i].value)) {
            return false;
        }
        i = i + 1;
    }
    true
}

// Desempaqueta un valor que el checker garantizó string (para `panic`).
fn as_str(v: Value) -> string {
    match (v) {
        Value.VStr(s) => s,
        _ => panic("expected a string"),
    }
}

// Desempaqueta un valor que el checker garantizó int (para los índices).
// `pub`: la VM (M14.5b) lo reusa para `OIndex`/`OSetIndex`.
pub fn as_int(v: Value) -> int {
    match (v) {
        Value.VInt(n) => n,
        _ => panic("expected an int"),
    }
}

// Una lista de bindings vacía, ya tipada (para los patrones sin variables).
fn no_bindings() -> [Binding] { [] }

// Los campos declarados de un struct (en orden), de la tabla del programa.
fn struct_fields(c: Interp, name: string) -> [FieldDef] {
    match (get(c.structs, name)) {
        Option.Some(fs) => fs,
        Option.None => panic("unregistered struct: " + name),
    }
}

// ¿`name` es un enum (del programa) con una variante llamada `variant`? Así se RECONOCE la construcción
// de enum en runtime (`Enum.Variante`), que el checker-validador no reescribió a un nodo dedicado.
fn enum_has_variant(c: Interp, name: string, variant: string) -> bool {
    match (get(c.enums, name)) {
        Option.Some(variants) => {
            var i = 0;
            while (i < variants.len()) {
                if (variants[i].name == variant) {
                    return true;
                }
                i = i + 1;
            }
            false
        },
        Option.None => false,
    }
}

// La expresión del campo `fname` en un literal de struct (el checker garantiza que está presente).
fn find_field_init(inits: [FieldInit], fname: string) -> Expr {
    var i = 0;
    while (i < inits.len()) {
        if (inits[i].name == fname) {
            return inits[i].value;
        }
        i = i + 1;
    }
    panic("missing field in the literal: " + fname)
}

// Lee el valor del campo `fname` de un struct en runtime (el checker garantiza el campo). `pub`: lo
// reusa la VM (M14.5b) en `OGetField`.
pub fn struct_get(fields: [SField], fname: string) -> Value {
    var i = 0;
    while (i < fields.len()) {
        if (fields[i].name == fname) {
            return fields[i].value;
        }
        i = i + 1;
    }
    panic("field not found: " + fname)
}

// Asigna al campo `fname` de un struct en runtime, mutando la celda compartida (aliasing). `pub`: lo
// reusa la VM (M14.5b) en `OSetField`.
pub fn struct_set(fields: [SField], fname: string, v: Value) {
    var i = 0;
    while (i < fields.len()) {
        if (fields[i].name == fname) {
            fields[i].value = v;
            return;
        }
        i = i + 1;
    }
    panic("field not found: " + fname)
}

// =====================================================================
// Ámbitos: declarar, buscar, asignar
// =====================================================================
fn new_scope() -> Map<string, Cell> { Map.new() }

fn push_scope(c: Interp) {
    c.scopes.push(new_scope());
}

fn pop_scope(c: Interp) {
    let removed = pop(c.scopes);
}

// Declara una variable: una CELDA NUEVA en el ámbito más interno. Como cada declaración crea su propia
// celda, el shadowing es seguro aunque una closure haya capturado la celda anterior (se queda con la vieja).
fn define(c: Interp, name: string, v: Value) {
    let top = c.scopes[c.scopes.len() - 1];
    top.insert(name, Cell { v: v });
}

// Inserta una celda YA EXISTENTE (compartida) en el ámbito más interno. Lo usa `call_body` para ligar las
// celdas capturadas por una closure: comparten el mismo objeto con su origen.
fn insert_cell(c: Interp, name: string, cell: Cell) {
    let top = c.scopes[c.scopes.len() - 1];
    top.insert(name, cell);
}

// Busca una variable de adentro hacia afuera y devuelve su valor; `None` si no es una variable (en ese
// caso el nombre es una función usada como valor).
fn lookup_opt(c: Interp, name: string) -> Option<Value> {
    var i = c.scopes.len() - 1;
    while (i >= 0) {
        match (get(c.scopes[i], name)) {
            Option.Some(cell) => {
                return Option.Some(cell.v);
            },
            Option.None => { },
        }
        i = i - 1;
    }
    Option.None
}

// Asigna a una variable ya declarada MUTANDO su celda (no reemplazándola): así el cambio se ve a través
// de cualquier closure que la haya capturado.
fn assign(c: Interp, name: string, v: Value) {
    var i = c.scopes.len() - 1;
    while (i >= 0) {
        match (get(c.scopes[i], name)) {
            Option.Some(cell) => {
                cell.v = v;
                return;
            },
            Option.None => { },
        }
        i = i - 1;
    }
}

// Captura por REFERENCIA todas las celdas visibles en este punto (snapshot de todos los ámbitos, de fuera
// hacia dentro, para que una variable interior tape a una exterior del mismo nombre). Comparte las celdas
// (no las copia) → mutar la variable después se ve en la closure.
fn capture_env(c: Interp) -> [Capture] {
    let m: Map<string, Cell> = Map.new();
    var i = 0;
    while (i < c.scopes.len()) {
        let scope = c.scopes[i];
        let ks = scope.keys();
        var j = 0;
        while (j < ks.len()) {
            match (get(scope, ks[j])) {
                Option.Some(cell) => {
                    m.insert(ks[j], cell);
                },
                Option.None => { },
            }
            j = j + 1;
        }
        i = i + 1;
    }
    var caps: [Capture] = [];
    let mk = m.keys();
    var t = 0;
    while (t < mk.len()) {
        match (get(m, mk[t])) {
            Option.Some(cell) => {
                caps.push(Capture { name: mk[t], cell: cell });
            },
            Option.None => { },
        }
        t = t + 1;
    }
    caps
}

// =====================================================================
// Operadores
// =====================================================================
fn cmp_int(op: BinOp, a: int, b: int) -> bool {
    match (op) {
        BinOp.Lt => a < b,
        BinOp.Le => a <= b,
        BinOp.Gt => a > b,
        BinOp.Ge => a >= b,
        _ => panic("cmp_int: unexpected operator"),
    }
}

fn cmp_float(op: BinOp, a: float, b: float) -> bool {
    match (op) {
        BinOp.Lt => a < b,
        BinOp.Le => a <= b,
        BinOp.Gt => a > b,
        BinOp.Ge => a >= b,
        _ => panic("cmp_float: unexpected operator"),
    }
}

fn cmp_str(op: BinOp, a: string, b: string) -> bool {
    match (op) {
        BinOp.Lt => a < b,
        BinOp.Le => a <= b,
        BinOp.Gt => a > b,
        BinOp.Ge => a >= b,
        _ => panic("cmp_str: unexpected operator"),
    }
}

fn cmp_char(op: BinOp, a: char, b: char) -> bool {
    match (op) {
        BinOp.Lt => a < b,
        BinOp.Le => a <= b,
        BinOp.Gt => a > b,
        BinOp.Ge => a >= b,
        _ => panic("cmp_char: unexpected operator"),
    }
}

// `+`: aritmética entera/flotante, concatenación de strings (M11.1a) o de arreglos (M11.7b → M14.7c:
// devuelve un arreglo NUEVO, como Rust). El checker ya garantiza tipos compatibles.
pub fn eval_add(l: Value, r: Value) -> Result<Value, Flow> {
    match (l) {
        Value.VInt(a) => match (r) {
            Value.VInt(b) => Result.Ok(Value.VInt(a + b)),
            _ => panic("invalid +"),
        },
        Value.VFloat(a) => match (r) {
            Value.VFloat(b) => Result.Ok(Value.VFloat(a + b)),
            _ => panic("invalid +"),
        },
        Value.VStr(a) => match (r) {
            Value.VStr(b) => Result.Ok(Value.VStr(a + b)),
            _ => panic("invalid +"),
        },
        Value.VArray(a) => match (r) {
            Value.VArray(b) => Result.Ok(Value.VArray(concat_values(a, b))),
            _ => panic("invalid +"),
        },
        _ => panic("invalid +"),
    }
}

// Concatena dos arreglos de valores en uno NUEVO (no muta los originales; semántica de `a + b`).
fn concat_values(a: [Value], b: [Value]) -> [Value] {
    var out: [Value] = [];
    var i = 0;
    while (i < a.len()) {
        out.push(a[i]);
        i = i + 1;
    }
    var j = 0;
    while (j < b.len()) {
        out.push(b[j]);
        j = j + 1;
    }
    out
}

fn arith_int(op: BinOp, a: int, b: int, line: int, col: int) -> Result<Value, Flow> {
    match (op) {
        BinOp.Sub => Result.Ok(Value.VInt(a - b)),
        BinOp.Mul => Result.Ok(Value.VInt(a * b)),
        BinOp.Div => {
            if (b == 0) {
                return Result.Err(Flow.FError(rt_error(line, col, "integer division by zero")));
            }
            Result.Ok(Value.VInt(a / b))
        },
        BinOp.Rem => {
            if (b == 0) {
                return Result.Err(Flow.FError(rt_error(line, col, "modulo by zero")));
            }
            Result.Ok(Value.VInt(a % b))
        },
        _ => panic("arith_int: unexpected operator"),
    }
}

fn arith_float(op: BinOp, a: float, b: float) -> Result<Value, Flow> {
    match (op) {
        BinOp.Sub => Result.Ok(Value.VFloat(a - b)),
        BinOp.Mul => Result.Ok(Value.VFloat(a * b)),
        BinOp.Div => Result.Ok(Value.VFloat(a / b)),
        BinOp.Rem => Result.Ok(Value.VFloat(a % b)),
        _ => panic("arith_float: unexpected operator"),
    }
}

// Sub/Mul/Div/Rem sobre dos enteros o dos flotantes.
pub fn eval_arith(op: BinOp, l: Value, r: Value, line: int, col: int) -> Result<Value, Flow> {
    match (l) {
        Value.VInt(a) => match (r) {
            Value.VInt(b) => arith_int(op, a, b, line, col),
            _ => panic("invalid arithmetic"),
        },
        Value.VFloat(a) => match (r) {
            Value.VFloat(b) => arith_float(op, a, b),
            _ => panic("invalid arithmetic"),
        },
        _ => panic("invalid arithmetic"),
    }
}

// Lt/Le/Gt/Ge sobre números, strings (lexicográfico) o char (code point) (M11.7d).
pub fn eval_cmp(op: BinOp, l: Value, r: Value) -> Result<Value, Flow> {
    match (l) {
        Value.VInt(a) => match (r) {
            Value.VInt(b) => Result.Ok(Value.VBool(cmp_int(op, a, b))),
            _ => panic("invalid comparison"),
        },
        Value.VFloat(a) => match (r) {
            Value.VFloat(b) => Result.Ok(Value.VBool(cmp_float(op, a, b))),
            _ => panic("invalid comparison"),
        },
        Value.VStr(a) => match (r) {
            Value.VStr(b) => Result.Ok(Value.VBool(cmp_str(op, a, b))),
            _ => panic("invalid comparison"),
        },
        Value.VChar(a) => match (r) {
            Value.VChar(b) => Result.Ok(Value.VBool(cmp_char(op, a, b))),
            _ => panic("invalid comparison"),
        },
        _ => panic("invalid comparison"),
    }
}

// Un operador binario. Los lógicos (`&&`/`||`) hacen CORTOCIRCUITO → se tratan antes de evaluar ambos.
fn eval_binary(c: Interp, op: BinOp, left: Expr, right: Expr, line: int, col: int) -> Result<Value, Flow> {
    match (op) {
        BinOp.And => {
            if (!eval_bool(c, left)?) {
                return Result.Ok(Value.VBool(false));
            }
            return Result.Ok(Value.VBool(eval_bool(c, right)?));
        },
        BinOp.Or => {
            if (eval_bool(c, left)?) {
                return Result.Ok(Value.VBool(true));
            }
            return Result.Ok(Value.VBool(eval_bool(c, right)?));
        },
        _ => { },
    }
    let l = eval_expr(c, left)?;
    let r = eval_expr(c, right)?;
    match (op) {
        BinOp.Add => eval_add(l, r),
        BinOp.Sub => eval_arith(op, l, r, line, col),
        BinOp.Mul => eval_arith(op, l, r, line, col),
        BinOp.Div => eval_arith(op, l, r, line, col),
        BinOp.Rem => eval_arith(op, l, r, line, col),
        BinOp.Eq => Result.Ok(Value.VBool(values_equal(l, r))),
        BinOp.Ne => Result.Ok(Value.VBool(!values_equal(l, r))),
        BinOp.Lt => eval_cmp(op, l, r),
        BinOp.Le => eval_cmp(op, l, r),
        BinOp.Gt => eval_cmp(op, l, r),
        BinOp.Ge => eval_cmp(op, l, r),
        BinOp.And => panic("unreachable: && already handled"),
        BinOp.Or => panic("unreachable: || already handled"),
    }
}

fn eval_unary(c: Interp, op: UnOp, inner: Expr) -> Result<Value, Flow> {
    let v = eval_expr(c, inner)?;
    match (op) {
        UnOp.Neg => match (v) {
            Value.VInt(n) => Result.Ok(Value.VInt(-n)),
            Value.VFloat(x) => Result.Ok(Value.VFloat(-x)),
            _ => panic("invalid negation"),
        },
        UnOp.Not => match (v) {
            Value.VBool(b) => Result.Ok(Value.VBool(!b)),
            _ => panic("invalid logical negation"),
        },
    }
}

// =====================================================================
// Auxiliares de evaluación tipada
// =====================================================================
fn eval_bool(c: Interp, e: Expr) -> Result<bool, Flow> {
    let v = eval_expr(c, e)?;
    match (v) {
        Value.VBool(b) => Result.Ok(b),
        _ => panic("expected a boolean condition"),
    }
}

// =====================================================================
// Llamadas y builtins
// =====================================================================
pub fn is_builtin(name: string) -> bool {
    name == "print" || name == "eprint" || name == "to_string" || name == "panic" || name == "len" || name == "push" || name == "trim" || name == "split" || name == "chars" || name == "contains" || name == "replace" || name == "starts_with" || name == "ends_with" || name == "to_upper" || name == "to_lower" || name == "substring" || name == "repeat" || name == "join" || name == "insert" || name == "get" || name == "contains_key" || name == "keys" || name == "values" || name == "remove" || name == "__parse_int" || name == "__parse_float" || name == "__read_file" || name == "__write_file" || name == "exists" || name == "args" || name == "__pop"
}

// `len` de un arreglo, un string (nº de caracteres) o un Map (nº de entradas).
fn builtin_len(v: Value) -> int {
    match (v) {
        Value.VArray(elems) => elems.len(),
        Value.VStr(s) => s.len(),
        Value.VMap(d) => d.keys.len(),
        _ => panic("len: expected an array, string or Map"),
    }
}

// =====================================================================
// Map (M14.6b): operaciones sobre `MapData` (arrays paralelos, búsqueda lineal por igualdad estructural)
// =====================================================================
// El índice de la clave `k` en el mapa, o -1 si no está.
fn map_find(d: MapData, k: Value) -> int {
    var i = 0;
    while (i < d.keys.len()) {
        if (values_equal(d.keys[i], k)) {
            return i;
        }
        i = i + 1;
    }
    0 - 1
}

// Inserta/actualiza `k -> v` mutando el mapa compartido.
fn map_put(d: MapData, k: Value, v: Value) {
    let idx = map_find(d, k);
    if (idx >= 0) {
        d.vals[idx] = v;
    } else {
        d.keys.push(k);
        d.vals.push(v);
    }
}

// Quita `k` del mapa (swap-remove: el orden no importa, keys() reordena) y devuelve `Some(v)`/`None`.
fn map_take(d: MapData, k: Value) -> Value {
    let idx = map_find(d, k);
    if (idx < 0) {
        return Value.VEnum("Option", "None", no_vals());
    }
    let v = d.vals[idx];
    let last = d.keys.len() - 1;
    d.keys[idx] = d.keys[last];
    d.vals[idx] = d.vals[last];
    let kr = pop(d.keys);
    let vr = pop(d.vals);
    Value.VEnum("Option", "Some", [v])
}

// ¿`a` < `b` para claves del MISMO tipo primitivo? (orden de `MapKey` en Rust; en un mapa todas las
// claves son del mismo tipo, así que las ramas cruzadas no se observan).
fn key_lt(a: Value, b: Value) -> bool {
    match (a) {
        Value.VInt(x) => match (b) {
            Value.VInt(y) => x < y,
            _ => false,
        },
        Value.VStr(x) => match (b) {
            Value.VStr(y) => x < y,
            _ => false,
        },
        Value.VChar(x) => match (b) {
            Value.VChar(y) => x < y,
            _ => false,
        },
        Value.VBool(x) => match (b) {
            Value.VBool(y) => !x && y,
            _ => false,
        },
        _ => false,
    }
}

// Orden `<` de Ord sobre los primitivos comparables (int/float/string/char). Lo usa el fallback de
// `.less()` en el despacho (M14.6c-2); a diferencia de `key_lt` (claves de Map) cubre también float.
// `pub`: la VM (M14.5d) lo reusa en su despacho dinámico.
pub fn value_lt(a: Value, b: Value) -> bool {
    match (a) {
        Value.VInt(x) => match (b) {
            Value.VInt(y) => x < y,
            _ => panic("less: incompatible types"),
        },
        Value.VFloat(x) => match (b) {
            Value.VFloat(y) => x < y,
            _ => panic("less: incompatible types"),
        },
        Value.VStr(x) => match (b) {
            Value.VStr(y) => x < y,
            _ => panic("less: incompatible types"),
        },
        Value.VChar(x) => match (b) {
            Value.VChar(y) => x < y,
            _ => panic("less: incompatible types"),
        },
        _ => panic("less: non-orderable type"),
    }
}

// Los índices 0..n ordenados por clave (insertion sort) → keys()/values() deterministas (como Rust).
fn map_sorted_order(ks: [Value]) -> [int] {
    var order: [int] = [];
    var i = 0;
    while (i < ks.len()) {
        order.push(i);
        i = i + 1;
    }
    var a = 1;
    while (a < order.len()) {
        let cur = order[a];
        var b = a;
        while (b > 0 && key_lt(ks[cur], ks[order[b - 1]])) {
            order[b] = order[b - 1];
            b = b - 1;
        }
        order[b] = cur;
        a = a + 1;
    }
    order
}

// Envuelve un `[char]`/`[string]` del host en un `VArray` de `VChar`/`VStr` (para chars/split).
fn chars_to_value(cs: [char]) -> Value {
    var out: [Value] = [];
    var i = 0;
    while (i < cs.len()) {
        out.push(Value.VChar(cs[i]));
        i = i + 1;
    }
    Value.VArray(out)
}

fn strs_to_value(ss: [string]) -> Value {
    var out: [Value] = [];
    var i = 0;
    while (i < ss.len()) {
        out.push(Value.VStr(ss[i]));
        i = i + 1;
    }
    Value.VArray(out)
}

// join(arr, sep): une un arreglo de strings con el separador (manual, sobre `[Value]` de `VStr`).
fn builtin_join(arrv: Value, sep: string) -> string {
    match (arrv) {
        Value.VArray(elems) => {
            var s = "";
            var i = 0;
            while (i < elems.len()) {
                if (i > 0) {
                    s = s + sep;
                }
                s = s + as_str(elems[i]);
                i = i + 1;
            }
            s
        },
        _ => panic("join: expected an array"),
    }
}

// contains(x, y): ad-hoc — subcadena (string) o pertenencia por igualdad estructural (arreglo).
fn builtin_contains(x: Value, y: Value) -> bool {
    match (x) {
        Value.VStr(s) => s.contains(as_str(y)),
        Value.VArray(elems) => {
            var i = 0;
            while (i < elems.len()) {
                if (values_equal(elems[i], y)) {
                    return true;
                }
                i = i + 1;
            }
            false
        },
        _ => panic("contains: expected string or array"),
    }
}

// Evalúa la lista de argumentos en orden (cortocircuitando ante un `return`/error).
fn eval_args(c: Interp, args: [Expr]) -> Result<[Value], Flow> {
    var vals: [Value] = [];
    var i = 0;
    while (i < args.len()) {
        let v = eval_expr(c, args[i])?;
        vals.push(v);
        i = i + 1;
    }
    Result.Ok(vals)
}

// Ejecuta un builtin: evalúa sus argumentos y despacha sobre los valores.
fn call_builtin(c: Interp, name: string, args: [Expr], line: int, col: int) -> Result<Value, Flow> {
    let vals = eval_args(c, args)?;
    dispatch_builtin(c.args, name, vals, line, col)
}

// Despacha un builtin con sus argumentos ya evaluados (lo reusan el builtin-como-método —`xs.len()`— y
// la VM auto-alojada de M14.5). `prog_args` son los argumentos del programa (para `args()`). `panic` se
// intercepta aquí (necesita la posición de la llamada y produce un FError, no un Value).
pub fn dispatch_builtin(prog_args: [string], name: string, vals: [Value], line: int, col: int) -> Result<Value, Flow> {
    if (name == "panic") {
        return Result.Err(Flow.FError(rt_error(line, col, as_str(vals[0]))));
    }
    if (name == "print") {
        print(value_str(vals[0]));
        return Result.Ok(Value.VUnit);
    }
    if (name == "eprint") {
        eprint(value_str(vals[0]));
        return Result.Ok(Value.VUnit);
    }
    if (name == "to_string") {
        return Result.Ok(Value.VStr(value_str(vals[0])));
    }
    if (name == "len") {
        return Result.Ok(Value.VInt(builtin_len(vals[0])));
    }
    if (name == "push") {
        // push(arr, x): muta el arreglo compartido (semántica de referencia del host).
        return match (vals[0]) {
            Value.VArray(elems) => {
                elems.push(vals[1]);
                Result.Ok(Value.VUnit)
            },
            _ => panic("push: expected an array"),
        };
    }
    // --- Builtins de string (M14.6a): delegan en los del host ---
    if (name == "trim") {
        return Result.Ok(Value.VStr(as_str(vals[0]).trim()));
    }
    if (name == "to_upper") {
        return Result.Ok(Value.VStr(as_str(vals[0]).to_upper()));
    }
    if (name == "to_lower") {
        return Result.Ok(Value.VStr(as_str(vals[0]).to_lower()));
    }
    if (name == "chars") {
        return Result.Ok(chars_to_value(as_str(vals[0]).chars()));
    }
    if (name == "split") {
        return Result.Ok(strs_to_value(as_str(vals[0]).split(as_str(vals[1]))));
    }
    if (name == "replace") {
        return Result.Ok(Value.VStr(as_str(vals[0]).replace(as_str(vals[1]), as_str(vals[2]))));
    }
    if (name == "starts_with") {
        return Result.Ok(Value.VBool(as_str(vals[0]).starts_with(as_str(vals[1]))));
    }
    if (name == "ends_with") {
        return Result.Ok(Value.VBool(as_str(vals[0]).ends_with(as_str(vals[1]))));
    }
    if (name == "substring") {
        return Result.Ok(Value.VStr(as_str(vals[0]).substring(as_int(vals[1]), as_int(vals[2]))));
    }
    if (name == "repeat") {
        return Result.Ok(Value.VStr(as_str(vals[0]).repeat(as_int(vals[1]))));
    }
    if (name == "join") {
        return Result.Ok(Value.VStr(builtin_join(vals[0], as_str(vals[1]))));
    }
    if (name == "contains") {
        return Result.Ok(Value.VBool(builtin_contains(vals[0], vals[1])));
    }
    // --- Primitivos de parseo (M14.6c): delegan en el host y devuelven [T] (0 o 1 elemento),
    // que los envoltorios `parse_int`/`parse_float` del prelude traducen a Option (como en Rust). ---
    if (name == "__parse_int") {
        return match (parse_int(as_str(vals[0]))) {
            Option.Some(n) => Result.Ok(Value.VArray([Value.VInt(n)])),
            Option.None => Result.Ok(Value.VArray(no_vals())),
        };
    }
    if (name == "__parse_float") {
        return match (parse_float(as_str(vals[0]))) {
            Option.Some(f) => Result.Ok(Value.VArray([Value.VFloat(f)])),
            Option.None => Result.Ok(Value.VArray(no_vals())),
        };
    }
    // --- I/O de archivos (M14.6d): delegan en los primitivos del host, que ya devuelven el arreglo
    // etiquetado (["ok",…]/["err",msg]); los envoltorios `read_file`/`write_file` del prelude lo
    // traducen a Result. `exists` es total (devuelve bool). ---
    if (name == "__read_file") {
        return Result.Ok(strs_to_value(__read_file(as_str(vals[0]))));
    }
    if (name == "__write_file") {
        return Result.Ok(strs_to_value(__write_file(as_str(vals[0]), as_str(vals[1]))));
    }
    if (name == "__exists") {
        return Result.Ok(Value.VBool(__exists(as_str(vals[0]))));
    }
    if (name == "args") {
        return Result.Ok(strs_to_value(prog_args));
    }
    if (name == "__pop") {
        // Muta el arreglo compartido quitando el último (vía el `pop` del host); devuelve [] o [x].
        return match (vals[0]) {
            Value.VArray(elems) => {
                match (pop(elems)) {
                    Option.Some(x) => Result.Ok(Value.VArray([x])),
                    Option.None => Result.Ok(Value.VArray(no_vals())),
                }
            },
            _ => panic("__pop: expected an array"),
        };
    }
    // --- Builtins de Map (M14.6b) ---
    // "map_new" ya no es un builtin de usuario (M48.1): es el **primitivo interno** al que el compilador
    // baja `Map.new()` (`OBuiltin("map_new", 0)`). Sigue aquí porque la VM lo despacha por nombre.
    if (name == "map_new") {
        return Result.Ok(Value.VMap(MapData { keys: no_vals(), vals: no_vals() }));
    }
    if (name == "insert") {
        return match (vals[0]) {
            Value.VMap(d) => {
                map_put(d, vals[1], vals[2]);
                Result.Ok(Value.VUnit)
            },
            _ => panic("insert: expected a Map"),
        };
    }
    if (name == "contains_key") {
        return match (vals[0]) {
            Value.VMap(d) => Result.Ok(Value.VBool(map_find(d, vals[1]) >= 0)),
            _ => panic("contains_key: expected a Map"),
        };
    }
    if (name == "get") {
        return match (vals[0]) {
            Value.VMap(d) => {
                let idx = map_find(d, vals[1]);
                if (idx >= 0) { Result.Ok(Value.VEnum("Option", "Some", [d.vals[idx]])) } else { Result.Ok(Value.VEnum("Option", "None", no_vals())) }
            },
            _ => panic("get: expected a Map"),
        };
    }
    if (name == "remove") {
        return match (vals[0]) {
            Value.VMap(d) => Result.Ok(map_take(d, vals[1])),
            _ => panic("remove: expected a Map"),
        };
    }
    if (name == "keys") {
        return match (vals[0]) {
            Value.VMap(d) => Result.Ok(map_collect(d.keys, map_sorted_order(d.keys))),
            _ => panic("keys: expected a Map"),
        };
    }
    if (name == "values") {
        return match (vals[0]) {
            Value.VMap(d) => Result.Ok(map_collect(d.vals, map_sorted_order(d.keys))),
            _ => panic("values: expected a Map"),
        };
    }
    panic("unimplemented builtin: " + name)
}

// Reúne `src[order[i]]` en un VArray (para keys/values en orden de clave ordenada).
fn map_collect(src: [Value], order: [int]) -> Value {
    var out: [Value] = [];
    var i = 0;
    while (i < order.len()) {
        out.push(src[order[i]]);
        i = i + 1;
    }
    Value.VArray(out)
}

// La clave de tipo de un VALOR en runtime (para el despacho de métodos): el nombre del tipo nominal o
// del primitivo. Es lo que el despacho dinámico usa en vez de los tipos (que ya se borraron).
pub fn type_key_of_value(v: Value) -> string {
    match (v) {
        Value.VInt(_) => "int",
        Value.VFloat(_) => "float",
        Value.VBool(_) => "bool",
        Value.VStr(_) => "string",
        Value.VChar(_) => "char",
        Value.VUnit => "unit",
        Value.VStruct(name, _) => name,
        Value.VEnum(name, _, _) => name,
        Value.VArray(_) => "[]",
        Value.VFunc(_) => "fn",
        Value.VClosure(_, _) => "fn",
        Value.VVmClosure(_, _) => "fn",
        Value.VMap(_) => "Map",
    }
}

// La clave de tipo del OBJETIVO de un `impl` (para poblar la tabla). `Caja<T>` → "Caja" (por constructor,
// así un impl genérico cubre toda la familia).
pub fn type_key_of_type(t: Type) -> string {
    match (t) {
        Type.TInt => "int",
        Type.TFloat => "float",
        Type.TBool => "bool",
        Type.TString => "string",
        Type.TChar => "char",
        Type.TUnit => "unit",
        Type.TNamed(name, _) => name,
        Type.TArray(_) => "[]",
        Type.TFn(_, _) => "fn",
        Type.TDyn(_) => "dyn",
    }
}

fn contains_str(xs: [string], s: string) -> bool {
    var i = 0;
    while (i < xs.len()) {
        if (xs[i] == s) {
            return true;
        }
        i = i + 1;
    }
    false
}

pub fn struct_has_field(fields: [SField], fname: string) -> bool {
    var i = 0;
    while (i < fields.len()) {
        if (fields[i].name == fname) {
            return true;
        }
        i = i + 1;
    }
    false
}

// Antepone `recv` (el `self`/receptor) a la lista de argumentos (para métodos y UFCS). `pub`: la VM
// (M14.5d) lo reusa en su despacho dinámico.
pub fn prepend(recv: Value, args: [Value]) -> [Value] {
    var all: [Value] = [recv];
    var i = 0;
    while (i < args.len()) {
        all.push(args[i]);
        i = i + 1;
    }
    all
}

// Puebla la tabla de métodos (`Tipo#metodo`) desde los `impl` del programa, más los métodos por DEFECTO
// del trait no redefinidos por el impl. El despacho mira esta tabla con la clave de tipo del receptor.
fn register_methods(c: Interp, prog: Program) {
    let traitmap: Map<string, [MethodSig]> = Map.new();
    var ti = 0;
    while (ti < prog.traits.len()) {
        traitmap.insert(prog.traits[ti].name, prog.traits[ti].methods);
        ti = ti + 1;
    }
    var ii = 0;
    while (ii < prog.impls.len()) {
        let imp = prog.impls[ii];
        let key = type_key_of_type(imp.target);
        var defined: [string] = [];
        var mi = 0;
        while (mi < imp.methods.len()) {
            let m = imp.methods[mi];
            c.methods.insert(key + "#" + m.name, Method { params: m.params, body: m.body });
            defined.push(m.name);
            mi = mi + 1;
        }
        // métodos por defecto del trait no redefinidos por este impl
        match (get(traitmap, imp.trait_name)) {
            Option.Some(sigs) => {
                var si = 0;
                while (si < sigs.len()) {
                    let sig = sigs[si];
                    if (!contains_str(defined, sig.name)) {
                        match (sig.default_body) {
                            Option.Some(body) => {
                                c.methods.insert(key + "#" + sig.name, Method { params: sig.params, body: body });
                            },
                            Option.None => { },
                        }
                    }
                    si = si + 1;
                }
            },
            Option.None => { },
        }
        ii = ii + 1;
    }
}

// Llama a un método con el receptor como `self` (primer parámetro) seguido de los argumentos.
fn call_method(c: Interp, method: Method, recv: Value, args: [Value]) -> Result<Value, Flow> {
    call_body(c, method.params, method.body, prepend(recv, args), no_captures())
}

// Despacho de `recv.fname(args)`: campo-función → método (tabla `Tipo#metodo`) → `@derive` (igual/mostrar)
// → UFCS a función libre `fname(recv, args)` → builtin como método. Es el corazón de la resolución en
// runtime: `dyn`/bounds/genéricos no necesitan nada especial (se mira la etiqueta del valor concreto).
fn dispatch_method(c: Interp, recv: Value, fname: string, args: [Expr], line: int, col: int) -> Result<Value, Flow> {
    // (a) ¿campo del struct que contiene una función? (gana sobre UFCS/método)
    match (recv) {
        Value.VStruct(_, fields) => {
            if (struct_has_field(fields, fname)) {
                let vals = eval_args(c, args)?;
                return call_value(c, struct_get(fields, fname), vals);
            }
        },
        _ => { },
    }
    // (b) método del tipo (impl o defecto)
    match (get(c.methods, type_key_of_value(recv) + "#" + fname)) {
        Option.Some(method) => {
            let vals = eval_args(c, args)?;
            return call_method(c, method, recv, vals);
        },
        Option.None => { },
    }
    // (c) @derive: igual ≡ igualdad estructural, mostrar ≡ representación (= value_str). El checker
    // garantiza que solo se llaman sobre tipos con Eq/Show, así que el tipo deriva (o tiene impl, ya
    // resuelto en (b)) → aquí solo queda el caso derivado.
    if (fname == "eq") {
        let vals = eval_args(c, args)?;
        return Result.Ok(Value.VBool(values_equal(recv, vals[0])));
    }
    if (fname == "show") {
        return Result.Ok(Value.VStr(value_str(recv)));
    }
    // `menor` de Ord sobre PRIMITIVOS (impl del prelude `impl Ord for int/float/string/char`, vía `<`).
    // Un tipo de usuario con `impl Ord` ya se resolvió en (b); el checker exige `T: Ord`, así que aquí
    // solo llegan esos cuatro primitivos. (M14.6c-2: lo que `sort` necesita.)
    if (fname == "less") {
        let vals = eval_args(c, args)?;
        return Result.Ok(Value.VBool(value_lt(recv, vals[0])));
    }
    // (d) UFCS a función libre: fname(recv, args)
    match (get(c.funcs, fname)) {
        Option.Some(f) => {
            let vals = eval_args(c, args)?;
            return call_named(c, f, prepend(recv, vals));
        },
        Option.None => { },
    }
    // (e) builtin como método: recv como primer argumento (p. ej. `xs.len()`)
    if (is_builtin(fname)) {
        let vals = eval_args(c, args)?;
        return dispatch_builtin(c.args, fname, prepend(recv, vals), line, col);
    }
    panic("could not resolve '" + fname + "' on the receiver")
}

// Una llamada. Camino directo por nombre (builtin o función global), construcción de enum
// `Enum.Variante(args)` (reconocida en runtime), llamada indirecta (valor-función/closure) y despacho de
// método/UFCS `recv.f(args)`.
fn eval_call(c: Interp, callee: Expr, args: [Expr]) -> Result<Value, Flow> {
    match (callee.kind) {
        EKind.EIdent(name) => {
            match (lookup_opt(c, name)) {
                // Variable local que contiene una función → llamada indirecta.
                Option.Some(fv) => {
                    let vals = eval_args(c, args)?;
                    call_value(c, fv, vals)
                },
                Option.None => {
                    if (is_builtin(name)) {
                        call_builtin(c, name, args, callee.line, callee.col)
                    } else {
                        match (get(c.funcs, name)) {
                            Option.Some(f) => {
                                let vals = eval_args(c, args)?;
                                call_named(c, f, vals)
                            },
                            Option.None => panic("unresolved function: " + name),
                        }
                    }
                },
            }
        },
        EKind.EField(obj, fname) => {
            // M48.1: función asociada `Map.new()` → Map vacío (los canales no corren en el intérprete).
            match (obj.kind) {
                EKind.EIdent(tn) => {
                    if (tn == "Map" && fname == "new") {
                        return Result.Ok(Value.VMap(MapData { keys: no_vals(), vals: no_vals() }));
                    }
                },
                _ => { },
            }
            // ¿Construcción de variante con payload, `Enum.Variante(args)`? (receptor = nombre de enum
            // que no es una variable local). Si no, es despacho de método/UFCS sobre el receptor.
            match (obj.kind) {
                EKind.EIdent(maybe_enum) => {
                    match (lookup_opt(c, maybe_enum)) {
                        Option.Some(recv) => dispatch_method(c, recv, fname, args, callee.line, callee.col),
                        Option.None => {
                            if (enum_has_variant(c, maybe_enum, fname)) {
                                let vals = eval_args(c, args)?;
                                Result.Ok(Value.VEnum(maybe_enum, fname, vals))
                            } else {
                                let recv = eval_expr(c, obj)?;
                                dispatch_method(c, recv, fname, args, callee.line, callee.col)
                            }
                        },
                    }
                },
                _ => {
                    let recv = eval_expr(c, obj)?;
                    dispatch_method(c, recv, fname, args, callee.line, callee.col)
                },
            }
        },
        _ => {
            // El callee es una expresión que produce un valor-función (otra llamada, un campo-función…).
            let fv = eval_expr(c, callee)?;
            let vals = eval_args(c, args)?;
            call_value(c, fv, vals)
        },
    }
}

// Ejecuta el cuerpo de una función (nombrada o anónima) con sus argumentos ya evaluados y su entorno
// capturado. Scoping léxico: arranca con una pila de ámbitos NUEVA (no la de quien llama); se guarda la
// actual y se restaura al volver. Un `return` interno (FReturn) se desenvuelve aquí en el valor de la
// función. El ámbito base son las celdas capturadas (compartidas); encima va el de los parámetros.
fn call_body(c: Interp, params: [Param], body: Block, args: [Value], captured: [Capture]) -> Result<Value, Flow> {
    let saved = c.scopes;
    c.scopes = empty_scopes();
    push_scope(c);  // ámbito base: las capturas
    var k = 0;
    while (k < captured.len()) {
        insert_cell(c, captured[k].name, captured[k].cell);
        k = k + 1;
    }
    push_scope(c);  // ámbito de los parámetros (tapan capturas con el mismo nombre)
    var i = 0;
    while (i < params.len()) {
        define(c, params[i].name, args[i]);
        i = i + 1;
    }
    let result = exec_block(c, body);  // empuja, encima, el ámbito del cuerpo
    c.scopes = saved;  // restaurar el entorno de quien llama
    match (result) {
        Result.Ok(v) => Result.Ok(v),
        Result.Err(flow) => match (flow) {
            Flow.FReturn(v) => Result.Ok(v),
            Flow.FError(e) => Result.Err(Flow.FError(e)),
        },
    }
}

// Llama a una función NOMBRADA (sin entorno capturado).
fn call_named(c: Interp, f: Func, args: [Value]) -> Result<Value, Flow> {
    call_body(c, f.params, f.body, args, no_captures())
}

// Llama a un VALOR-función (camino indirecto): una función nombrada usada como valor o una closure.
fn call_value(c: Interp, fv: Value, args: [Value]) -> Result<Value, Flow> {
    match (fv) {
        Value.VFunc(f) => call_body(c, f.params, f.body, args, no_captures()),
        Value.VClosure(fe, caps) => call_body(c, fe.params, fe.body, args, caps),
        _ => panic("attempted to call a value that is not a function"),
    }
}

// =====================================================================
// Sentencias y bloques
// =====================================================================
fn exec_stmt(c: Interp, s: Stmt) -> Result<Value, Flow> {
    match (s.kind) {
        SKind.SLet(name, _, value, _) => {
            let v = eval_expr(c, value)?;
            define(c, name, v);
            Result.Ok(Value.VUnit)
        },
        SKind.SAssign(target, value) => {
            let v = eval_expr(c, value)?;
            match (target.kind) {
                EKind.EIdent(name) => {
                    assign(c, name, v);
                    Result.Ok(Value.VUnit)
                },
                EKind.EIndex(arr_e, idx_e) => assign_index(c, arr_e, idx_e, v),
                EKind.EField(obj_e, fname) => assign_field(c, obj_e, fname, v),
                _ => panic("invalid lvalue (the checker should have rejected it)"),
            }
        },
        SKind.SReturn(opt) => {
            match (opt) {
                Option.Some(e) => {
                    let v = eval_expr(c, e)?;
                    Result.Err(Flow.FReturn(v))
                },
                Option.None => Result.Err(Flow.FReturn(Value.VUnit)),
            }
        },
        SKind.SExpr(e) => {
            eval_expr(c, e)?;
            Result.Ok(Value.VUnit)
        },
    }
}

// Ejecuta las sentencias de un bloque en orden; el primer `return`/error corta y se propaga (vía `?`).
fn run_stmts(c: Interp, b: Block) -> Result<Value, Flow> {
    var i = 0;
    while (i < b.stmts.len()) {
        exec_stmt(c, b.stmts[i])?;
        i = i + 1;
    }
    Result.Ok(Value.VUnit)
}

// El cuerpo de un bloque en su propio ámbito: corre las sentencias y luego la expresión final (`tail`),
// o `Unit` si no la hay.
fn exec_block_inner(c: Interp, b: Block) -> Result<Value, Flow> {
    run_stmts(c, b)?;
    match (b.tail) {
        Option.Some(e) => eval_expr(c, e),
        Option.None => Result.Ok(Value.VUnit),
    }
}

// Ejecuta un bloque empujando/quitando su ámbito (en todos los caminos, también al propagar un error).
fn exec_block(c: Interp, b: Block) -> Result<Value, Flow> {
    push_scope(c);
    let r = exec_block_inner(c, b);
    pop_scope(c);
    r
}

// Un bucle `while`: re-evalúa la condición; el valor del cuerpo se descarta, pero un `return`/error
// dentro se propaga.
fn eval_while(c: Interp, cond: Expr, body: Block) -> Result<Value, Flow> {
    var go = eval_bool(c, cond)?;
    while (go) {
        exec_block(c, body)?;
        go = eval_bool(c, cond)?;
    }
    Result.Ok(Value.VUnit)
}

// =====================================================================
// Expresiones
// =====================================================================
fn eval_expr(c: Interp, expr: Expr) -> Result<Value, Flow> {
    match (expr.kind) {
        EKind.EInt(n) => Result.Ok(Value.VInt(n)),
        EKind.EFloat(x) => Result.Ok(Value.VFloat(x)),
        EKind.EBool(b) => Result.Ok(Value.VBool(b)),
        EKind.EStr(s) => Result.Ok(Value.VStr(s)),
        EKind.EChar(ch) => Result.Ok(Value.VChar(ch)),
        EKind.EIdent(name) => {
            match (lookup_opt(c, name)) {
                Option.Some(v) => Result.Ok(v),
                // No es una variable: es un nombre de función usado como VALOR.
                Option.None => {
                    match (get(c.funcs, name)) {
                        Option.Some(f) => Result.Ok(Value.VFunc(f)),
                        Option.None => panic("unresolved identifier: " + name),
                    }
                },
            }
        },
        EKind.EUnary(op, inner) => eval_unary(c, op, inner),
        EKind.EBinary(op, l, r) => eval_binary(c, op, l, r, expr.line, expr.col),
        EKind.ECall(callee, cargs) => eval_call(c, callee, cargs),
        EKind.EIf(cond, then_b, else_o) => {
            if (eval_bool(c, cond)?) {
                exec_block(c, then_b)
            } else {
                match (else_o) {
                    Option.Some(e) => eval_expr(c, e),
                    Option.None => Result.Ok(Value.VUnit),
                }
            }
        },
        EKind.EWhile(cond, body) => eval_while(c, cond, body),
        EKind.EBlock(b) => exec_block(c, b),
        EKind.EIndex(arr_e, idx_e) => eval_index(c, arr_e, idx_e),
        EKind.EField(obj, fname) => eval_field_or_enum(c, obj, fname),
        EKind.EArray(elems) => eval_array(c, elems),
        EKind.EStructLit(name, inits) => eval_struct_lit(c, name, inits),
        EKind.EFunc(fe) => Result.Ok(Value.VClosure(fe, capture_env(c))),
        EKind.EMatch(scr, arms) => eval_match(c, scr, arms),
        EKind.ETry(inner) => eval_try(c, inner),
    }
}

// =====================================================================
// Datos: arreglos, structs, enums, match
// =====================================================================
// Error de índice fuera de rango (mensaje idéntico al de Rust).
fn oob(idx_e: Expr, i: int, n: int) -> RuntimeError {
    rt_error(idx_e.line, idx_e.col, "index " + to_string(i) + " out of range (length " + to_string(n) + ")")
}

fn eval_array(c: Interp, elems: [Expr]) -> Result<Value, Flow> {
    var vals: [Value] = [];
    var i = 0;
    while (i < elems.len()) {
        let v = eval_expr(c, elems[i])?;
        vals.push(v);
        i = i + 1;
    }
    Result.Ok(Value.VArray(vals))
}

// Indexar un arreglo (→ elemento) o un string (→ char, M11.4c-2). Fuera de rango = error de ejecución.
fn eval_index(c: Interp, arr_e: Expr, idx_e: Expr) -> Result<Value, Flow> {
    let target = eval_expr(c, arr_e)?;
    let i = as_int(eval_expr(c, idx_e)?);
    match (target) {
        Value.VArray(elems) => {
            if (i < 0 || i >= elems.len()) {
                return Result.Err(Flow.FError(oob(idx_e, i, elems.len())));
            }
            Result.Ok(elems[i])
        },
        Value.VStr(s) => {
            let cs = s.chars();
            if (i < 0 || i >= cs.len()) {
                return Result.Err(Flow.FError(oob(idx_e, i, cs.len())));
            }
            Result.Ok(Value.VChar(cs[i]))
        },
        _ => panic("index on a non-array/string"),
    }
}

// `obj.fname`: construcción de variante unit `Enum.Variante` (reconocida en runtime) o acceso a campo.
fn eval_field_or_enum(c: Interp, obj: Expr, fname: string) -> Result<Value, Flow> {
    match (obj.kind) {
        EKind.EIdent(maybe_enum) => {
            match (lookup_opt(c, maybe_enum)) {
                Option.Some(_) => eval_field(c, obj, fname),
                Option.None => {
                    if (enum_has_variant(c, maybe_enum, fname)) {
                        Result.Ok(Value.VEnum(maybe_enum, fname, no_vals()))
                    } else {
                        eval_field(c, obj, fname)
                    }
                },
            }
        },
        _ => eval_field(c, obj, fname),
    }
}

fn eval_field(c: Interp, obj: Expr, fname: string) -> Result<Value, Flow> {
    let v = eval_expr(c, obj)?;
    match (v) {
        Value.VStruct(_, fields) => Result.Ok(struct_get(fields, fname)),
        _ => panic("field access on a non-struct"),
    }
}

// Construye un struct evaluando los campos en ORDEN DE DECLARACIÓN (como Rust → Display/igualdad casan).
fn eval_struct_lit(c: Interp, name: string, inits: [FieldInit]) -> Result<Value, Flow> {
    let defs = struct_fields(c, name);
    var built: [SField] = [];
    var i = 0;
    while (i < defs.len()) {
        let fname = defs[i].name;
        let v = eval_expr(c, find_field_init(inits, fname))?;
        built.push(SField { name: fname, value: v });
        i = i + 1;
    }
    Result.Ok(Value.VStruct(name, built))
}

fn assign_index(c: Interp, arr_e: Expr, idx_e: Expr, v: Value) -> Result<Value, Flow> {
    let target = eval_expr(c, arr_e)?;
    let i = as_int(eval_expr(c, idx_e)?);
    match (target) {
        Value.VArray(elems) => {
            if (i < 0 || i >= elems.len()) {
                return Result.Err(Flow.FError(oob(idx_e, i, elems.len())));
            }
            elems[i] = v;  // muta el arreglo compartido
            Result.Ok(Value.VUnit)
        },
        _ => panic("index assignment on a non-array"),
    }
}

fn assign_field(c: Interp, obj_e: Expr, fname: string, v: Value) -> Result<Value, Flow> {
    let target = eval_expr(c, obj_e)?;
    match (target) {
        Value.VStruct(_, fields) => {
            struct_set(fields, fname, v);
            Result.Ok(Value.VUnit)
        },
        _ => panic("field assignment on a non-struct"),
    }
}

// Intenta casar un patrón contra un valor; si casa, devuelve los bindings (`None` si no). El checker
// garantiza la consistencia variante/aridad, así que solo se compara la etiqueta y se reparte el payload.
fn try_match(pat: Pattern, v: Value) -> Option<[Binding]> {
    match (pat.kind) {
        PKind.PWild => Option.Some(no_bindings()),
        PKind.PBind(name) => Option.Some([Binding { name: name, value: v }]),
        PKind.PVariant(_, variant, subs) => {
            match (v) {
                Value.VEnum(_, var2, payload) => {
                    if (variant == var2) {
                        var binds: [Binding] = [];
                        var i = 0;
                        while (i < subs.len()) {
                            match (subs[i]) {
                                Option.Some(nm) => {
                                    binds.push(Binding { name: nm, value: payload[i] });
                                },
                                Option.None => { },
                            }
                            i = i + 1;
                        }
                        Option.Some(binds)
                    } else {
                        Option.None
                    }
                },
                _ => Option.None,
            }
        },
    }
}

fn bind_all(c: Interp, binds: [Binding]) {
    var i = 0;
    while (i < binds.len()) {
        define(c, binds[i].name, binds[i].value);
        i = i + 1;
    }
}

// `match (scr) { patrón => cuerpo, ... }`: prueba los brazos en orden; el primero que casa liga sus
// variables en un ámbito nuevo y evalúa su cuerpo. El checker garantiza exhaustividad.
fn eval_match(c: Interp, scr: Expr, arms: [MatchArm]) -> Result<Value, Flow> {
    let v = eval_expr(c, scr)?;
    var i = 0;
    while (i < arms.len()) {
        match (try_match(arms[i].pat, v)) {
            Option.Some(binds) => {
                push_scope(c);
                bind_all(c, binds);
                let r = eval_expr(c, arms[i].body);
                pop_scope(c);
                return r;
            },
            Option.None => { },
        }
        i = i + 1;
    }
    Result.Err(Flow.FError(rt_error(scr.line, scr.col, "no match branch matched (should not happen)")))
}

// `?`: desempaqueta `Ok(v)`/`Some(v)` a `v`, o propaga `Err(e)`/`None` como un `return` de la función
// actual (el checker garantiza que el operando es un Result/Option y el retorno es compatible).
fn eval_try(c: Interp, inner: Expr) -> Result<Value, Flow> {
    let v = eval_expr(c, inner)?;
    match (v) {
        Value.VEnum(_, variant, payload) => {
            if (variant == "Ok" || variant == "Some") {
                Result.Ok(payload[0])
            } else {
                Result.Err(Flow.FReturn(v))
            }
        },
        _ => panic("? on a value that is not Result/Option"),
    }
}

// Registra los enums del prelude (Option/Result) en la tabla, para RECONOCER su construcción
// (`Option.Some`/`Result.Ok`/…) en runtime. El intérprete solo necesita los nombres de las variantes
// (no los tipos del payload). Si el usuario redefine uno, sus definiciones lo sobrescriben luego.
fn inject_prelude_enums(c: Interp) {
    c.enums.insert("Option", [VariantDef { name: "Some", payload: no_types(), line: 0, col: 0 }, VariantDef { name: "None", payload: no_types(), line: 0, col: 0 }]);
    c.enums.insert("Result", [VariantDef { name: "Ok", payload: no_types(), line: 0, col: 0 }, VariantDef { name: "Err", payload: no_types(), line: 0, col: 0 }]);
}

// =====================================================================
// Punto de entrada
// =====================================================================
// Ejecuta el programa llamando a `main` y devuelve su valor (o un error de ejecución). El checker ya
// garantizó que `main` existe.
pub fn run(prog: Program, prog_args: [string]) -> Result<Value, RuntimeError> {
    let c = Interp { funcs: Map.new(), structs: Map.new(), enums: Map.new(), methods: Map.new(), scopes: empty_scopes(), args: prog_args };
    inject_prelude_enums(c);  // Option/Result (los del programa, abajo, sobrescriben si el usuario redefine)
    var i = 0;
    while (i < prog.funcs.len()) {
        c.funcs.insert(prog.funcs[i].name, prog.funcs[i]);
        i = i + 1;
    }
    var si = 0;
    while (si < prog.structs.len()) {
        c.structs.insert(prog.structs[si].name, prog.structs[si].fields);
        si = si + 1;
    }
    var ei = 0;
    while (ei < prog.enums.len()) {
        c.enums.insert(prog.enums[ei].name, prog.enums[ei].variants);
        ei = ei + 1;
    }
    register_methods(c, prog);
    match (get(c.funcs, "main")) {
        Option.Some(m) => {
            match (call_named(c, m, no_vals())) {
                Result.Ok(v) => Result.Ok(v),
                Result.Err(flow) => match (flow) {
                    Flow.FReturn(v) => Result.Ok(v),
                    Flow.FError(e) => Result.Err(e),
                },
            }
        },
        Option.None => Result.Err(rt_error(0, 0, "no 'main' function")),
    }
}
