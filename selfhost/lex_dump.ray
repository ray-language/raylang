// Driver del lexer auto-alojado (M14): lee un archivo (su ruta es el primer argumento del
// programa), lo lexea con el lexer EN raylang (`lexer.ray`) e imprime los tokens en un formato
// canónico, uno por línea. El test de integración `tests/selfhost_lexer.rs` compara este stdout
// contra el mismo formato producido por el lexer de Rust (el ORÁCULO).
//
// Formato canónico de un token:  <KIND>@<línea>:<columna>
//   - sin valor:  Let@1:1   Plus@1:5   Arrow@2:3   Eof@3:1
//   - con valor:  Int(42)@1:1   Float(3.14)@..   Ident(foo)@..   Str("a\nb")@..   Char('x')@..
// Las cadenas/caracteres se re-escapan (\\ \n \t \r \") para caber en una línea; el lexer de Rust
// hace el mismo escape, así que las salidas coinciden carácter a carácter.

from lexer import lex, TokKind;

// Re-escapa una cadena para imprimirla en una sola línea, de forma idéntica al oráculo.
fn escape(s: string) -> string {
    var out = "";
    let cs = chars(s);
    var i = 0;
    while (i < len(cs)) {
        let c = cs[i];
        if (c == '\\') { out = out + "\\\\"; }
        else if (c == '\n') { out = out + "\\n"; }
        else if (c == '\t') { out = out + "\\t"; }
        else if (c == '\r') { out = out + "\\r"; }
        else if (c == '"') { out = out + "\\\""; }
        else { out = out + to_string(c); }
        i = i + 1;
    }
    out
}

// El nombre canónico de un token (con su valor entre paréntesis si lo lleva).
fn kind_str(k: TokKind) -> string {
    match (k) {
        TokKind.Int(n) => "Int(" + to_string(n) + ")",
        TokKind.Float(f) => "Float(" + to_string(f) + ")",
        TokKind.Str(s) => "Str(\"" + escape(s) + "\")",
        TokKind.Char(c) => "Char('" + escape(to_string(c)) + "')",
        TokKind.Ident(name) => "Ident(" + name + ")",
        TokKind.Let => "Let",
        TokKind.Var => "Var",
        TokKind.Fn => "Fn",
        TokKind.Return => "Return",
        TokKind.If => "If",
        TokKind.Else => "Else",
        TokKind.While => "While",
        TokKind.True => "True",
        TokKind.False => "False",
        TokKind.Struct => "Struct",
        TokKind.Enum => "Enum",
        TokKind.Match => "Match",
        TokKind.Trait => "Trait",
        TokKind.Impl => "Impl",
        TokKind.Dyn => "Dyn",
        TokKind.Pub => "Pub",
        TokKind.Import => "Import",
        TokKind.From => "From",
        TokKind.As => "As",
        TokKind.IntType => "IntType",
        TokKind.FloatType => "FloatType",
        TokKind.BoolType => "BoolType",
        TokKind.StringType => "StringType",
        TokKind.CharType => "CharType",
        TokKind.Plus => "Plus",
        TokKind.Minus => "Minus",
        TokKind.Star => "Star",
        TokKind.Slash => "Slash",
        TokKind.Percent => "Percent",
        TokKind.EqEq => "EqEq",
        TokKind.BangEq => "BangEq",
        TokKind.Lt => "Lt",
        TokKind.LtEq => "LtEq",
        TokKind.Gt => "Gt",
        TokKind.GtEq => "GtEq",
        TokKind.AmpAmp => "AmpAmp",
        TokKind.PipePipe => "PipePipe",
        TokKind.Bang => "Bang",
        TokKind.Eq => "Eq",
        TokKind.LParen => "LParen",
        TokKind.RParen => "RParen",
        TokKind.LBrace => "LBrace",
        TokKind.RBrace => "RBrace",
        TokKind.LBracket => "LBracket",
        TokKind.RBracket => "RBracket",
        TokKind.Comma => "Comma",
        TokKind.Semicolon => "Semicolon",
        TokKind.Colon => "Colon",
        TokKind.Dot => "Dot",
        TokKind.Arrow => "Arrow",
        TokKind.FatArrow => "FatArrow",
        TokKind.Question => "Question",
        TokKind.PipeArrow => "PipeArrow",
        TokKind.At => "At",
        TokKind.Eof => "Eof",
    }
}

fn main() -> int {
    let argv = args();
    if (len(argv) == 0) {
        eprint("uso: raylang selfhost/lex_dump.ray <archivo>");
        return 1;
    }
    match (read_file(argv[0])) {
        Result.Ok(src) => {
            let toks = lex(src);
            var i = 0;
            while (i < len(toks)) {
                let t = toks[i];
                print(kind_str(t.kind) + "@" + to_string(t.line) + ":" + to_string(t.col));
                i = i + 1;
            }
            0
        },
        Result.Err(msg) => {
            eprint(msg);
            1
        },
    }
}
