// El *loader* auto-alojado (M14.7): aplana un programa multi-archivo en un único `Program` plano para
// que el checker y el intérprete auto-alojados —que procesan UN programa— vean todo junto. Cliente
// host-side, como `run.ray`: usa `read_file` (M14.6d) + el lexer/parser auto-alojados.
//
// Port recortado de `src/loader.rs`. El caso del self-hosting solo usa `from M import …;` (funciones Y
// tipos), sin `import M;`/acceso calificado, sin directorios/cápsulas, sin reexports. Y una
// SIMPLIFICACIÓN clave frente a Rust: el checker auto-alojado es un VALIDADOR (no baja por posición) y
// el intérprete despacha por etiqueta de valor, así que **NO hace falta el position-shifting** (bandas
// de líneas disjuntas) que Rust necesita para el lowering de M9. Para programas válidos (lo que
// ejecutamos) las posiciones son irrelevantes al comportamiento.
//
// M14.7a: la máquina de carga (BFS de dependencias) + el cruce de **funciones** (el `Resolver`:
// namespacing `modulo::fn` + reescritura de referencias). El cruce de **tipos** (TypeRewriter) → M14.7b.
from lexer import lex, LexError;
from parser import parse, ParseError, Program, Func, Block, Stmt, SKind, Expr, EKind, Pattern, PKind, FnExpr;
from parser import Type, StructDef, EnumDef, TraitDef, ImplBlock, MethodSig, Bound;

// Error de carga: mensaje + ubicación + módulo donde ocurrió (espejo recortado del de Rust).
pub struct LoadError {
    msg: string,
    line: int,
    col: int,
    module: string,
}

// Un módulo ya cargado y parseado. `is_entry` distingue el de entrada (sus nombres no se namespacan).
struct Module {
    name: string,
    is_entry: bool,
    prog: Program,
}

// Una entrada pendiente en el BFS: el nombre del módulo, su ruta de archivo y si es el de entrada.
struct PendingMod {
    name: string,
    path: string,
    is_entry: bool,
}

// La superficie pública de un módulo: nombre exportado → global, separado en valores (funciones) y
// tipos (struct/enum/trait), M14.7b.
struct Surface {
    values: Map<string, string>,
    types: Map<string, string>,
}

// El resultado de clasificar los `from M import …` de un módulo: nombres de valor y de tipo (local→global).
struct FromMaps {
    values: Map<string, string>,
    types: Map<string, string>,
}

// El reescritor de **tipos**: `types` mapea nombre local de tipo → global (`modulo::Tipo`); `tparams`
// es la pila de parámetros de tipo en ámbito (un `T` en `<T>` NO es un tipo nominal → no se reescribe).
struct TypeRewriter {
    types: Map<string, string>,
    tparams: [[string]],
}

// El resolutor de **valores**: `own` mapea nombre local → nombre global (`modulo::fn`) de las funciones
// visibles sin calificar (propias + `from`-importadas); `scopes` es la pila de ámbitos locales (un
// nombre local tapa a una función de nivel superior). Reescribe las referencias `EIdent` en los cuerpos.
struct Resolver {
    own: Map<string, string>,
    scopes: [[string]],
}

// =====================================================================
// Helpers de strings (rutas) y de listas
// =====================================================================
fn no_strs() -> [string] { [] }

fn contains_str(xs: [string], s: string) -> bool {
    var i = 0;
    while (i < xs.len()) {
        if (xs[i] == s) {
            return true;
        }
        i = i + 1;
    }
    false
}

// El índice del último '/' en `s`, o -1 si no hay (para separar directorio y base de una ruta).
fn last_slash(s: string) -> int {
    let cs = s.chars();
    var idx = 0 - 1;
    var i = 0;
    while (i < cs.len()) {
        if (cs[i] == '/') {
            idx = i;
        }
        i = i + 1;
    }
    idx
}

// El directorio de una ruta (`/tmp/a.ray` → `/tmp`); `.` si la ruta no tiene '/'.
fn dir_of(path: string) -> string {
    let idx = last_slash(path);
    if (idx < 0) { "." } else { path.substring(0, idx) }
}

// El nombre base (`/tmp/a.ray` → `a.ray`).
fn base_of(path: string) -> string {
    let idx = last_slash(path);
    if (idx < 0) { path } else { path.substring(idx + 1, path.len()) }
}

// El *stem* de una ruta (`/tmp/a.ray` → `a`): la base sin la extensión `.ray`.
fn stem_of(path: string) -> string {
    let b = base_of(path);
    if (b.ends_with(".ray")) { b.substring(0, b.len() - 4) } else { b }
}

// El prefijo de namespacing de un módulo (M11.5): `/`→`::`. Sin directorios (self-hosting) es identidad.
fn ns_prefix(name: string) -> string { name.replace("/", "::") }

// El nombre global de una función/tipo: el propio nombre para el de entrada, `modulo::nombre` para uno
// importado (sus nombres se namespacan; `::` es ilegal en identificadores → nunca chocan con los suyos).
fn global_of(m: Module, name: string) -> string {
    if (m.is_entry) { name } else { ns_prefix(m.name) + "::" + name }
}

// El nombre LOCAL con el que entra un `from`-import: el alias si lo hay, o el nombre original.
fn local_of_alias(alias: Option<string>, name: string) -> string {
    match (alias) {
        Option.Some(a) => a,
        Option.None => name,
    }
}

// =====================================================================
// Fase 1: BFS — cargar y parsear cada módulo una vez (ciclos seguros)
// =====================================================================
// Lee + lexea + parsea un módulo; traduce los errores a LoadError con el nombre del módulo.
fn load_one(name: string, path: string) -> Result<Program, LoadError> {
    match (read_file(path)) {
        Result.Ok(src) => {
            match (lex(src)) {
                Result.Ok(toks) => {
                    match (parse(toks)) {
                        Result.Ok(p) => Result.Ok(p),
                        Result.Err(pe) => Result.Err(LoadError { msg: pe.msg, line: pe.line, col: pe.col, module: name }),
                    }
                },
                Result.Err(le) => Result.Err(LoadError { msg: le.msg, line: le.line, col: le.col, module: name }),
            }
        },
        Result.Err(_) => Result.Err(LoadError { msg: "no se pudo leer el módulo '" + name + "' (" + path + ")", line: 0, col: 0, module: name }),
    }
}

// =====================================================================
// Fase 2: superficies públicas (nombre pub → global)
// =====================================================================
fn build_surfaces(modules: [Module]) -> Map<string, Surface> {
    var surfaces: Map<string, Surface> = Map.new();
    var i = 0;
    while (i < modules.len()) {
        let m = modules[i];
        var vals: Map<string, string> = Map.new();
        var fi = 0;
        while (fi < m.prog.funcs.len()) {
            let f = m.prog.funcs[fi];
            if (f.is_pub) {
                vals.insert(f.name, global_of(m, f.name));
            }
            fi = fi + 1;
        }
        var tys: Map<string, string> = Map.new();
        var si = 0;
        while (si < m.prog.structs.len()) {
            let s = m.prog.structs[si];
            if (s.is_pub) {
                tys.insert(s.name, global_of(m, s.name));
            }
            si = si + 1;
        }
        var ei = 0;
        while (ei < m.prog.enums.len()) {
            let e = m.prog.enums[ei];
            if (e.is_pub) {
                tys.insert(e.name, global_of(m, e.name));
            }
            ei = ei + 1;
        }
        var ti = 0;
        while (ti < m.prog.traits.len()) {
            let t = m.prog.traits[ti];
            if (t.is_pub) {
                tys.insert(t.name, global_of(m, t.name));
            }
            ti = ti + 1;
        }
        surfaces.insert(m.name, Surface { values: vals, types: tys });
        i = i + 1;
    }
    surfaces
}

// Clasifica los `from M import a [as b]` de un módulo en dos mapas local → global: **funciones** `pub`
// y **tipos** `pub` (M14.7b). El orden prioriza funciones (un módulo no debería tener ambos homónimos).
fn clasificar_from(m: Module, surfaces: Map<string, Surface>) -> Result<FromMaps, LoadError> {
    var values: Map<string, string> = Map.new();
    var types: Map<string, string> = Map.new();
    var i = 0;
    while (i < m.prog.from_imports.len()) {
        let fi = m.prog.from_imports[i];
        var j = 0;
        while (j < fi.names.len()) {
            let n = fi.names[j];
            let local = local_of_alias(n.alias, n.name);
            match (get(surfaces, fi.module)) {
                Option.Some(surf) => {
                    match (get(surf.values, n.name)) {
                        Option.Some(g) => {
                            values.insert(local, g);
                        },
                        Option.None => {
                            match (get(surf.types, n.name)) {
                                Option.Some(g) => {
                                    types.insert(local, g);
                                },
                                Option.None => {
                                    return Result.Err(LoadError { msg: "el módulo '" + fi.module + "' no exporta '" + n.name + "' (¿falta 'pub'?)", line: n.line, col: n.col, module: m.name });
                                },
                            }
                        },
                    }
                },
                Option.None => {
                    return Result.Err(LoadError { msg: "módulo no encontrado: '" + fi.module + "'", line: n.line, col: n.col, module: m.name });
                },
            }
            j = j + 1;
        }
        i = i + 1;
    }
    Result.Ok(FromMaps { values: values, types: types })
}

// =====================================================================
// Fase 3: el Resolver — reescribir referencias de valor a nombres globales
// =====================================================================
// El mapa `own`: funciones propias del módulo (local → global) + las `from`-importadas.
fn build_own(m: Module, from_values: Map<string, string>) -> Map<string, string> {
    var own: Map<string, string> = Map.new();
    var i = 0;
    while (i < m.prog.funcs.len()) {
        let f = m.prog.funcs[i];
        own.insert(f.name, global_of(m, f.name));
        i = i + 1;
    }
    let ks = from_values.keys();
    var j = 0;
    while (j < ks.len()) {
        match (get(from_values, ks[j])) {
            Option.Some(g) => {
                own.insert(ks[j], g);
            },
            Option.None => { },
        }
        j = j + 1;
    }
    own
}

fn rs_is_local(r: Resolver, name: string) -> bool {
    var i = 0;
    while (i < r.scopes.len()) {
        if (contains_str(r.scopes[i], name)) {
            return true;
        }
        i = i + 1;
    }
    false
}

fn rs_declare(r: Resolver, name: string) {
    if (r.scopes.len() > 0) {
        r.scopes[r.scopes.len() - 1].push(name);
    }
}

fn rs_push(r: Resolver) {
    r.scopes.push(no_strs());
}

fn rs_pop(r: Resolver) {
    pop(r.scopes);
}

fn resolve_program(r: Resolver, prog: Program) {
    var i = 0;
    while (i < prog.funcs.len()) {
        resolve_fn(r, prog.funcs[i]);
        i = i + 1;
    }
    var j = 0;
    while (j < prog.impls.len()) {
        let imp = prog.impls[j];
        var k = 0;
        while (k < imp.methods.len()) {
            resolve_fn(r, imp.methods[k]);
            k = k + 1;
        }
        j = j + 1;
    }
}

fn resolve_fn(r: Resolver, f: Func) {
    rs_push(r);
    var i = 0;
    while (i < f.params.len()) {
        rs_declare(r, f.params[i].name);
        i = i + 1;
    }
    resolve_block(r, f.body);
    rs_pop(r);
}

fn resolve_block(r: Resolver, b: Block) {
    rs_push(r);
    var i = 0;
    while (i < b.stmts.len()) {
        resolve_stmt(r, b.stmts[i]);
        i = i + 1;
    }
    match (b.tail) {
        Option.Some(t) => resolve_expr(r, t),
        Option.None => { },
    }
    rs_pop(r);
}

fn resolve_stmt(r: Resolver, s: Stmt) {
    match (s.kind) {
        SKind.SLet(name, _, value, _) => {
            resolve_expr(r, value);
            rs_declare(r, name);
        },
        SKind.SAssign(target, value) => {
            resolve_expr(r, target);
            resolve_expr(r, value);
        },
        SKind.SReturn(opt) => {
            match (opt) {
                Option.Some(v) => resolve_expr(r, v),
                Option.None => { },
            }
        },
        SKind.SExpr(e) => resolve_expr(r, e),
    }
}

fn resolve_expr(r: Resolver, e: Expr) {
    match (e.kind) {
        // Una referencia a una función propia/importada (no tapada por una local) se reescribe a su
        // nombre global; lo demás (builtin/prelude/local) lo deja el checker.
        EKind.EIdent(name) => {
            if (!rs_is_local(r, name)) {
                match (get(r.own, name)) {
                    Option.Some(g) => {
                        e.kind = EKind.EIdent(g);
                    },
                    Option.None => { },
                }
            }
        },
        EKind.ECall(callee, cargs) => {
            resolve_expr(r, callee);
            var i = 0;
            while (i < cargs.len()) {
                resolve_expr(r, cargs[i]);
                i = i + 1;
            }
        },
        EKind.EUnary(_, inner) => resolve_expr(r, inner),
        EKind.EBinary(_, l, rr) => {
            resolve_expr(r, l);
            resolve_expr(r, rr);
        },
        EKind.EIndex(arr, idx) => {
            resolve_expr(r, arr);
            resolve_expr(r, idx);
        },
        // `obj.campo`: solo se resuelve el objeto (el nombre del campo/método no es una referencia).
        EKind.EField(obj, _) => resolve_expr(r, obj),
        EKind.EArray(elems) => {
            var i = 0;
            while (i < elems.len()) {
                resolve_expr(r, elems[i]);
                i = i + 1;
            }
        },
        EKind.EStructLit(_, fields) => {
            var i = 0;
            while (i < fields.len()) {
                resolve_expr(r, fields[i].value);
                i = i + 1;
            }
        },
        EKind.EFunc(fe) => resolve_fn_expr(r, fe),
        EKind.EMatch(scrut, arms) => {
            resolve_expr(r, scrut);
            var i = 0;
            while (i < arms.len()) {
                rs_push(r);
                declare_pattern(r, arms[i].pat);
                resolve_expr(r, arms[i].body);
                rs_pop(r);
                i = i + 1;
            }
        },
        EKind.ETry(inner) => resolve_expr(r, inner),
        EKind.EIf(cond, then_b, elseopt) => {
            resolve_expr(r, cond);
            resolve_block(r, then_b);
            match (elseopt) {
                Option.Some(els) => resolve_expr(r, els),
                Option.None => { },
            }
        },
        EKind.EWhile(cond, body) => {
            resolve_expr(r, cond);
            resolve_block(r, body);
        },
        EKind.EBlock(b) => resolve_block(r, b),
        _ => { },
    }
}

// Los nombres que liga un patrón (entran en el ámbito del cuerpo del brazo).
fn declare_pattern(r: Resolver, p: Pattern) {
    match (p.kind) {
        PKind.PWild => { },
        PKind.PBind(n) => rs_declare(r, n),
        PKind.PVariant(_, _, binds) => {
            var i = 0;
            while (i < binds.len()) {
                match (binds[i]) {
                    Option.Some(b) => rs_declare(r, b),
                    Option.None => { },
                }
                i = i + 1;
            }
        },
    }
}

fn resolve_fn_expr(r: Resolver, fe: FnExpr) {
    rs_push(r);
    var i = 0;
    while (i < fe.params.len()) {
        rs_declare(r, fe.params[i].name);
        i = i + 1;
    }
    resolve_block(r, fe.body);
    rs_pop(r);
}

// =====================================================================
// Fase 3b: el TypeRewriter — namespacing de tipos (M14.7b)
// =====================================================================
// Mapa nombre local de tipo → global, de los struct/enum/trait propios del módulo.
fn build_own_types(m: Module) -> Map<string, string> {
    var map: Map<string, string> = Map.new();
    var si = 0;
    while (si < m.prog.structs.len()) {
        map.insert(m.prog.structs[si].name, global_of(m, m.prog.structs[si].name));
        si = si + 1;
    }
    var ei = 0;
    while (ei < m.prog.enums.len()) {
        map.insert(m.prog.enums[ei].name, global_of(m, m.prog.enums[ei].name));
        ei = ei + 1;
    }
    var ti = 0;
    while (ti < m.prog.traits.len()) {
        map.insert(m.prog.traits[ti].name, global_of(m, m.prog.traits[ti].name));
        ti = ti + 1;
    }
    map
}

// Vuelca `b` sobre `a` (las claves de `b` ganan). Para unir tipos propios + `from`-importados.
fn merge_maps(a: Map<string, string>, b: Map<string, string>) -> Map<string, string> {
    let ks = b.keys();
    var i = 0;
    while (i < ks.len()) {
        match (get(b, ks[i])) {
            Option.Some(v) => {
                a.insert(ks[i], v);
            },
            Option.None => { },
        }
        i = i + 1;
    }
    a
}

// Renombra las DEFINICIONES de tipo del módulo a su global (las referencias las hace el TypeRewriter).
fn rename_type_defs(prog: Program, own_types: Map<string, string>) {
    var si = 0;
    while (si < prog.structs.len()) {
        match (get(own_types, prog.structs[si].name)) {
            Option.Some(g) => {
                prog.structs[si].name = g;
            },
            Option.None => { },
        }
        si = si + 1;
    }
    var ei = 0;
    while (ei < prog.enums.len()) {
        match (get(own_types, prog.enums[ei].name)) {
            Option.Some(g) => {
                prog.enums[ei].name = g;
            },
            Option.None => { },
        }
        ei = ei + 1;
    }
    var ti = 0;
    while (ti < prog.traits.len()) {
        match (get(own_types, prog.traits[ti].name)) {
            Option.Some(g) => {
                prog.traits[ti].name = g;
            },
            Option.None => { },
        }
        ti = ti + 1;
    }
}

fn tw_is_tparam(tw: TypeRewriter, name: string) -> bool {
    var i = 0;
    while (i < tw.tparams.len()) {
        if (contains_str(tw.tparams[i], name)) {
            return true;
        }
        i = i + 1;
    }
    false
}

fn tw_push(tw: TypeRewriter, params: [string]) {
    tw.tparams.push(params);
}

fn tw_pop(tw: TypeRewriter) {
    pop(tw.tparams);
}

// Un nombre de tipo/trait → su global: un parámetro de tipo en ámbito se deja; lo demás se busca en el
// mapa (un nombre no nominal, como "Map" o "T" libre, no está → se deja igual).
fn tw_name(tw: TypeRewriter, name: string) -> string {
    if (tw_is_tparam(tw, name)) {
        return name;
    }
    match (get(tw.types, name)) {
        Option.Some(g) => g,
        Option.None => name,
    }
}

fn tw_types(tw: TypeRewriter, ts: [Type]) -> [Type] {
    var out: [Type] = [];
    var i = 0;
    while (i < ts.len()) {
        out.push(tw_type(tw, ts[i]));
        i = i + 1;
    }
    out
}

fn tw_names(tw: TypeRewriter, ns: [string]) -> [string] {
    var out: [string] = [];
    var i = 0;
    while (i < ns.len()) {
        out.push(tw_name(tw, ns[i]));
        i = i + 1;
    }
    out
}

// Reescribe un tipo a su forma con nombres globales (devuelve uno nuevo).
fn tw_type(tw: TypeRewriter, t: Type) -> Type {
    match (t) {
        Type.TArray(elem) => Type.TArray(tw_type(tw, elem)),
        Type.TFn(params, ret) => Type.TFn(tw_types(tw, params), tw_type(tw, ret)),
        Type.TNamed(name, args) => Type.TNamed(tw_name(tw, name), tw_types(tw, args)),
        Type.TDyn(traits) => Type.TDyn(tw_names(tw, traits)),
        _ => t,
    }
}

// Reescribe los `T: Trait` de un parámetro de tipo: el trait se namespaca como cualquier tipo (M9.4).
fn tw_bounds(tw: TypeRewriter, bounds: [Bound]) {
    var i = 0;
    while (i < bounds.len()) {
        bounds[i].trait_name = tw_name(tw, bounds[i].trait_name);
        i = i + 1;
    }
}

fn tw_program(tw: TypeRewriter, prog: Program) {
    var si = 0;
    while (si < prog.structs.len()) {
        tw_struct(tw, prog.structs[si]);
        si = si + 1;
    }
    var ei = 0;
    while (ei < prog.enums.len()) {
        tw_enum(tw, prog.enums[ei]);
        ei = ei + 1;
    }
    var ti = 0;
    while (ti < prog.traits.len()) {
        tw_trait(tw, prog.traits[ti]);
        ti = ti + 1;
    }
    var fi = 0;
    while (fi < prog.funcs.len()) {
        tw_func(tw, prog.funcs[fi]);
        fi = fi + 1;
    }
    var ii = 0;
    while (ii < prog.impls.len()) {
        tw_impl(tw, prog.impls[ii]);
        ii = ii + 1;
    }
}

fn tw_struct(tw: TypeRewriter, s: StructDef) {
    tw_push(tw, s.type_params);
    var i = 0;
    while (i < s.fields.len()) {
        s.fields[i].ty = tw_type(tw, s.fields[i].ty);
        i = i + 1;
    }
    tw_bounds(tw, s.bounds);
    tw_pop(tw);
}

fn tw_enum(tw: TypeRewriter, e: EnumDef) {
    tw_push(tw, e.type_params);
    var i = 0;
    while (i < e.variants.len()) {
        e.variants[i].payload = tw_types(tw, e.variants[i].payload);
        i = i + 1;
    }
    tw_bounds(tw, e.bounds);
    tw_pop(tw);
}

fn tw_trait(tw: TypeRewriter, t: TraitDef) {
    tw_push(tw, no_strs());  // los traits no llevan parámetros de tipo
    var i = 0;
    while (i < t.methods.len()) {
        tw_method(tw, t.methods[i]);
        i = i + 1;
    }
    tw_pop(tw);
}

fn tw_method(tw: TypeRewriter, m: MethodSig) {
    var i = 0;
    while (i < m.params.len()) {
        m.params[i].ty = tw_type(tw, m.params[i].ty);
        i = i + 1;
    }
    m.ret = tw_type(tw, m.ret);
    match (m.default_body) {
        Option.Some(b) => tw_block(tw, b),
        Option.None => { },
    }
}

fn tw_func(tw: TypeRewriter, f: Func) {
    tw_push(tw, f.type_params);
    var i = 0;
    while (i < f.params.len()) {
        f.params[i].ty = tw_type(tw, f.params[i].ty);
        i = i + 1;
    }
    f.ret = tw_type(tw, f.ret);
    tw_bounds(tw, f.bounds);
    tw_block(tw, f.body);
    tw_pop(tw);
}

fn tw_impl(tw: TypeRewriter, imp: ImplBlock) {
    tw_push(tw, imp.type_params);
    imp.target = tw_type(tw, imp.target);
    imp.trait_name = tw_name(tw, imp.trait_name);
    tw_bounds(tw, imp.bounds);
    var i = 0;
    while (i < imp.methods.len()) {
        tw_func(tw, imp.methods[i]);
        i = i + 1;
    }
    tw_pop(tw);
}

fn tw_block(tw: TypeRewriter, b: Block) {
    var i = 0;
    while (i < b.stmts.len()) {
        tw_stmt(tw, b.stmts[i]);
        i = i + 1;
    }
    match (b.tail) {
        Option.Some(t) => tw_expr(tw, t),
        Option.None => { },
    }
}

fn tw_stmt(tw: TypeRewriter, s: Stmt) {
    match (s.kind) {
        SKind.SLet(name, tyopt, value, mutable) => {
            tw_expr(tw, value);
            match (tyopt) {
                Option.Some(t) => {
                    s.kind = SKind.SLet(name, Option.Some(tw_type(tw, t)), value, mutable);
                },
                Option.None => { },
            }
        },
        SKind.SAssign(target, value) => {
            tw_expr(tw, target);
            tw_expr(tw, value);
        },
        SKind.SReturn(opt) => {
            match (opt) {
                Option.Some(v) => tw_expr(tw, v),
                Option.None => { },
            }
        },
        SKind.SExpr(e) => tw_expr(tw, e),
    }
}

// Reescribe las expresiones que NOMBRAN tipos: literal de struct (`Nombre { … }`), construcción de enum
// (`Tipo.Variante`, que llega como `Field`/`Call`) y patrones de variante. Las demás solo se recorren.
fn tw_expr(tw: TypeRewriter, e: Expr) {
    match (e.kind) {
        EKind.EStructLit(name, fields) => {
            var i = 0;
            while (i < fields.len()) {
                tw_expr(tw, fields[i].value);
                i = i + 1;
            }
            e.kind = EKind.EStructLit(tw_name(tw, name), fields);
        },
        // `Tipo.Variante`: si la cabeza es un identificador-tipo, se reescribe; un valor (`p.x`) no casa
        // con ningún tipo, así que `tw_name` lo deja igual.
        EKind.EField(obj, fname) => {
            match (obj.kind) {
                EKind.EIdent(tn) => {
                    obj.kind = EKind.EIdent(tw_name(tw, tn));
                },
                _ => tw_expr(tw, obj),
            }
        },
        EKind.ECall(callee, cargs) => {
            tw_expr(tw, callee);
            var i = 0;
            while (i < cargs.len()) {
                tw_expr(tw, cargs[i]);
                i = i + 1;
            }
        },
        EKind.EMatch(scrut, arms) => {
            tw_expr(tw, scrut);
            var i = 0;
            while (i < arms.len()) {
                match (arms[i].pat.kind) {
                    PKind.PVariant(en, va, binds) => {
                        arms[i].pat.kind = PKind.PVariant(tw_name(tw, en), va, binds);
                    },
                    _ => { },
                }
                tw_expr(tw, arms[i].body);
                i = i + 1;
            }
        },
        EKind.EUnary(_, inner) => tw_expr(tw, inner),
        EKind.EBinary(_, l, rr) => {
            tw_expr(tw, l);
            tw_expr(tw, rr);
        },
        EKind.EIndex(arr, idx) => {
            tw_expr(tw, arr);
            tw_expr(tw, idx);
        },
        EKind.EArray(elems) => {
            var i = 0;
            while (i < elems.len()) {
                tw_expr(tw, elems[i]);
                i = i + 1;
            }
        },
        EKind.EFunc(fe) => tw_fn_expr(tw, fe),
        EKind.ETry(inner) => tw_expr(tw, inner),
        EKind.EIf(cond, then_b, elseopt) => {
            tw_expr(tw, cond);
            tw_block(tw, then_b);
            match (elseopt) {
                Option.Some(els) => tw_expr(tw, els),
                Option.None => { },
            }
        },
        EKind.EWhile(cond, body) => {
            tw_expr(tw, cond);
            tw_block(tw, body);
        },
        EKind.EBlock(b) => tw_block(tw, b),
        _ => { },
    }
}

fn tw_fn_expr(tw: TypeRewriter, fe: FnExpr) {
    var i = 0;
    while (i < fe.params.len()) {
        fe.params[i].ty = tw_type(tw, fe.params[i].ty);
        i = i + 1;
    }
    fe.ret = tw_type(tw, fe.ret);
    tw_block(tw, fe.body);
}

// =====================================================================
// Fase 4: renombrar definiciones de función a su global y fusionar
// =====================================================================
fn rename_and_merge(m: Module, fused: Program) {
    var i = 0;
    while (i < m.prog.funcs.len()) {
        let f = m.prog.funcs[i];
        f.name = global_of(m, f.name);
        fused.funcs.push(f);
        i = i + 1;
    }
    // M14.7a: los tipos (struct/enum/trait/impl) se fusionan SIN namespacar (el cruce de tipos → M14.7b).
    var si = 0;
    while (si < m.prog.structs.len()) {
        fused.structs.push(m.prog.structs[si]);
        si = si + 1;
    }
    var ei = 0;
    while (ei < m.prog.enums.len()) {
        fused.enums.push(m.prog.enums[ei]);
        ei = ei + 1;
    }
    var ti = 0;
    while (ti < m.prog.traits.len()) {
        fused.traits.push(m.prog.traits[ti]);
        ti = ti + 1;
    }
    var ii = 0;
    while (ii < m.prog.impls.len()) {
        fused.impls.push(m.prog.impls[ii]);
        ii = ii + 1;
    }
}

// =====================================================================
// Punto de entrada
// =====================================================================
pub fn load(entry_path: string) -> Result<Program, LoadError> {
    let root = dir_of(entry_path);
    let entry_name = stem_of(entry_path);

    // Fase 1: BFS sobre los `from M import …` (y los `import M;`, no usados en el self-hosting).
    var modules: [Module] = [];
    var visited: Map<string, bool> = Map.new();
    var pending: [PendingMod] = [PendingMod { name: entry_name, path: entry_path, is_entry: true }];
    var head = 0;
    while (head < pending.len()) {
        let pm = pending[head];
        head = head + 1;
        if (!visited.contains_key(pm.name)) {
            visited.insert(pm.name, true);
            let prog = load_one(pm.name, pm.path)?;
            var di = 0;
            while (di < prog.from_imports.len()) {
                let dep = prog.from_imports[di].module;
                pending.push(PendingMod { name: dep, path: root + "/" + dep + ".ray", is_entry: false });
                di = di + 1;
            }
            var ii = 0;
            while (ii < prog.imports.len()) {
                let dep = prog.imports[ii].module;
                pending.push(PendingMod { name: dep, path: root + "/" + dep + ".ray", is_entry: false });
                ii = ii + 1;
            }
            modules.push(Module { name: pm.name, is_entry: pm.is_entry, prog: prog });
        }
    }

    // Fases 2-4: superficies, resolución por módulo y fusión.
    let surfaces = build_surfaces(modules);
    var fused = Program { funcs: [], structs: [], enums: [], traits: [], impls: [], imports: [], from_imports: [] };
    var mi = 0;
    while (mi < modules.len()) {
        let m = modules[mi];
        let fm = clasificar_from(m, surfaces)?;
        // Resolución de VALORES (funciones propias + from-importadas).
        let r = Resolver { own: build_own(m, fm.values), scopes: [] };
        resolve_program(r, m.prog);
        // Namespacing de TIPOS: renombrar las definiciones propias y reescribir todas las referencias
        // (propias + from-importadas).
        let own_types = build_own_types(m);
        rename_type_defs(m.prog, own_types);
        let tw = TypeRewriter { types: merge_maps(own_types, fm.types), tparams: [] };
        tw_program(tw, m.prog);
        // Renombrar definiciones de función y fusionar.
        rename_and_merge(m, fused);
        mi = mi + 1;
    }
    Result.Ok(fused)
}
