// Driver del parser auto-alojado (M14.2): lee un archivo (su ruta es el primer argumento), lo lexea
// con el lexer EN raylang y lo parsea con el parser EN raylang, e imprime el AST en un formato
// canónico (una función por línea). El test `tests/selfhost_parser.rs` compara este stdout con el
// mismo formato producido por el parser de Rust (el ORÁCULO).
//
// Formato canónico (S-expression, con posición `@línea:col` en cada nodo de Expr/Stmt):
//   func   :  (fn NOMBRE (params (param N TIPO)@l:c ...) TIPO_RET BLOQUE)@l:c
//   bloque :  (block STMT... TAIL?)@l:c
//   stmt   :  (let N TIPO|_ E)@l:c | (var ...) | (assign DEST E)@l:c | (return E?)@l:c | (expr E)@l:c
//   expr   :  (int N)@l:c | (ident N)@l:c | (binary OP E E)@l:c | (call E E...)@l:c | (if C BLK E?)@l:c | ...
//   tipo   :  int | float | bool | string | char | unit | [T] | fn(T, ...) -> R | NOMBRE
// Las cadenas/caracteres se re-escapan igual que en el lexer-dump → coinciden con el oráculo.

from lexer import lex, Token, LexError;
from parser import parse, Program, Func, Param, Type, Expr, EKind, Stmt, SKind, Block, BinOp, UnOp;
from parser import StructDef, FieldDef, EnumDef, VariantDef, FieldInit, FnExpr, MatchArm, Pattern, PKind;
from parser import Bound, TraitDef, MethodSig, ImplBlock;
from parser import Annotation, ImportDecl, ImportName, FromImport, ParseError;

// Re-escapa una cadena para una sola línea, idéntico al oráculo (y al lexer-dump).
fn escape(s: string) -> string {
    var out = "";
    let cs = chars(s);
    var i = 0;
    while (i < len(cs)) {
        let c = cs[i];
        if (c == '\\') { out = out + "\\\\"; }
        else if (c == '\n') { out = out + "\\n"; }
        else if (c == '\t') { out = out + "\\t"; }
        else if (c == '\r') { out = out + "\\r"; }
        else if (c == '"') { out = out + "\\\""; }
        else { out = out + to_string(c); }
        i = i + 1;
    }
    out
}

fn pos(line: int, col: int) -> string { "@" + to_string(line) + ":" + to_string(col) }

fn dump_type(t: Type) -> string {
    match (t) {
        Type.TInt => "int",
        Type.TFloat => "float",
        Type.TBool => "bool",
        Type.TString => "string",
        Type.TChar => "char",
        Type.TUnit => "unit",
        Type.TArray(e) => "[" + dump_type(e) + "]",
        Type.TFn(ps, r) => "fn(" + join_types(ps) + ") -> " + dump_type(r),
        Type.TNamed(n, args) => {
            if (len(args) == 0) { n } else { n + "<" + join_types(args) + ">" }
        },
        Type.TDyn(traits) => "dyn " + join_strings(traits, " + "),
    }
}

// Strings unidos por un separador.
fn join_strings(xs: [string], sep: string) -> string {
    var s = "";
    var i = 0;
    while (i < len(xs)) {
        if (i > 0) { s = s + sep; }
        s = s + xs[i];
        i = i + 1;
    }
    s
}

// Tipos separados por ", " (igual que el Display de Type en Rust).
fn join_types(ps: [Type]) -> string {
    var s = "";
    var i = 0;
    while (i < len(ps)) {
        if (i > 0) { s = s + ", "; }
        s = s + dump_type(ps[i]);
        i = i + 1;
    }
    s
}

fn dump_binop(op: BinOp) -> string {
    match (op) {
        BinOp.Add => "add",
        BinOp.Sub => "sub",
        BinOp.Mul => "mul",
        BinOp.Div => "div",
        BinOp.Rem => "rem",
        BinOp.Eq => "eq",
        BinOp.Ne => "ne",
        BinOp.Lt => "lt",
        BinOp.Le => "le",
        BinOp.Gt => "gt",
        BinOp.Ge => "ge",
        BinOp.And => "and",
        BinOp.Or => "or",
    }
}

fn dump_unop(op: UnOp) -> string {
    match (op) {
        UnOp.Neg => "neg",
        UnOp.Not => "not",
    }
}

fn dump_expr(e: Expr) -> string {
    let pp = pos(e.line, e.col);
    match (e.kind) {
        EKind.EInt(n) => "(int " + to_string(n) + ")" + pp,
        EKind.EFloat(f) => "(float " + to_string(f) + ")" + pp,
        EKind.EBool(b) => "(bool " + to_string(b) + ")" + pp,
        EKind.EStr(s) => "(str \"" + escape(s) + "\")" + pp,
        EKind.EChar(c) => "(char '" + escape(to_string(c)) + "')" + pp,
        EKind.EIdent(n) => "(ident " + n + ")" + pp,
        EKind.EUnary(op, inner) => "(unary " + dump_unop(op) + " " + dump_expr(inner) + ")" + pp,
        EKind.EBinary(op, l, r) => "(binary " + dump_binop(op) + " " + dump_expr(l) + " " + dump_expr(r) + ")" + pp,
        EKind.ECall(callee, cargs) => "(call " + dump_expr(callee) + dump_exprs(cargs) + ")" + pp,
        EKind.EIndex(a, i) => "(index " + dump_expr(a) + " " + dump_expr(i) + ")" + pp,
        EKind.EField(o, nm) => "(field " + dump_expr(o) + " " + nm + ")" + pp,
        EKind.EArray(elems) => "(array" + dump_exprs(elems) + ")" + pp,
        EKind.EIf(c, then_b, alt) => "(if " + dump_expr(c) + " " + dump_block(then_b) + dump_opt_expr(alt) + ")" + pp,
        EKind.EWhile(c, body) => "(while " + dump_expr(c) + " " + dump_block(body) + ")" + pp,
        EKind.EBlock(b) => dump_block(b),
        EKind.EStructLit(name, fields) => "(struct-lit " + name + dump_inits(fields) + ")" + pp,
        EKind.EFunc(fe) => dump_fnexpr(fe),
        EKind.EMatch(scrut, arms) => "(match " + dump_expr(scrut) + dump_arms(arms) + ")" + pp,
        EKind.ETry(inner) => "(try " + dump_expr(inner) + ")" + pp,
    }
}

// Inicializaciones de campo de un literal de struct, cada una precedida de un espacio.
fn dump_inits(fields: [FieldInit]) -> string {
    var s = "";
    var i = 0;
    while (i < len(fields)) {
        let fi = fields[i];
        s = s + " (init " + fi.name + " " + dump_expr(fi.value) + ")";
        i = i + 1;
    }
    s
}

fn dump_fnexpr(fe: FnExpr) -> string {
    "(fn-expr " + to_string(fe.id) + " (params" + dump_params(fe.params) + ") "
        + dump_type(fe.ret) + " " + dump_block(fe.body) + ")" + pos(fe.line, fe.col)
}

// Brazos de match, cada uno precedido de un espacio.
fn dump_arms(arms: [MatchArm]) -> string {
    var s = "";
    var i = 0;
    while (i < len(arms)) {
        let a = arms[i];
        s = s + " (arm " + dump_pattern(a.pat) + " " + dump_expr(a.body) + ")" + pos(a.line, a.col);
        i = i + 1;
    }
    s
}

fn dump_pattern(pat: Pattern) -> string {
    let pp = pos(pat.line, pat.col);
    match (pat.kind) {
        PKind.PWild => "(wild)" + pp,
        PKind.PBind(n) => "(bind " + n + ")" + pp,
        PKind.PVariant(en, va, binds) => "(variant " + en + " " + va + dump_binds(binds) + ")" + pp,
    }
}

// Sub-bindings de un patrón de variante: cada nombre (o '_' para None) precedido de un espacio.
fn dump_binds(binds: [Option<string>]) -> string {
    var s = "";
    var i = 0;
    while (i < len(binds)) {
        match (binds[i]) {
            Option.Some(n) => { s = s + " " + n; },
            Option.None => { s = s + " _"; },
        }
        i = i + 1;
    }
    s
}

// Cada expresión precedida de un espacio (para listas: args, elementos de arreglo).
fn dump_exprs(es: [Expr]) -> string {
    var s = "";
    var i = 0;
    while (i < len(es)) { s = s + " " + dump_expr(es[i]); i = i + 1; }
    s
}

fn dump_opt_expr(o: Option<Expr>) -> string {
    match (o) {
        Option.Some(e) => " " + dump_expr(e),
        Option.None => "",
    }
}

fn dump_opt_type(o: Option<Type>) -> string {
    match (o) {
        Option.Some(t) => dump_type(t),
        Option.None => "_",
    }
}

fn dump_stmt(st: Stmt) -> string {
    let pp = pos(st.line, st.col);
    match (st.kind) {
        SKind.SLet(name, ty, value, mutable) => {
            let kw = if (mutable) { "var" } else { "let" };
            "(" + kw + " " + name + " " + dump_opt_type(ty) + " " + dump_expr(value) + ")" + pp
        },
        SKind.SAssign(target, value) => "(assign " + dump_expr(target) + " " + dump_expr(value) + ")" + pp,
        SKind.SReturn(value) => "(return" + dump_opt_expr(value) + ")" + pp,
        SKind.SExpr(e) => "(expr " + dump_expr(e) + ")" + pp,
    }
}

fn dump_block(b: Block) -> string {
    var s = "(block";
    var i = 0;
    while (i < len(b.stmts)) { s = s + " " + dump_stmt(b.stmts[i]); i = i + 1; }
    s = s + dump_opt_expr(b.tail);
    s + ")" + pos(b.line, b.col)
}

fn dump_params(ps: [Param]) -> string {
    var s = "";
    var i = 0;
    while (i < len(ps)) {
        let pm = ps[i];
        s = s + " (param " + pm.name + " " + dump_type(pm.ty) + ")" + pos(pm.line, pm.col);
        i = i + 1;
    }
    s
}

// Marca ` pub` si el ítem es público, o "".
fn dump_pub(is_pub: bool) -> string {
    if (is_pub) { " pub" } else { "" }
}

// Segmento de anotaciones ` (anns (ann derive Eq Show) ...)`, o "" si no hay.
fn dump_anns(anns: [Annotation]) -> string {
    if (len(anns) == 0) { return ""; }
    var s = " (anns";
    var i = 0;
    while (i < len(anns)) {
        let a = anns[i];
        var args = "";
        var j = 0;
        while (j < len(a.args)) { args = args + " " + a.args[j]; j = j + 1; }
        s = s + " (ann " + a.name + args + ")";
        i = i + 1;
    }
    s + ")"
}

// Segmento de genéricos ` (generics T U (bound T A) (bound U B))`, o "" si no hay ninguno.
fn dump_generics(tparams: [string], bounds: [Bound]) -> string {
    if (len(tparams) == 0 && len(bounds) == 0) { return ""; }
    var s = " (generics";
    var i = 0;
    while (i < len(tparams)) { s = s + " " + tparams[i]; i = i + 1; }
    var j = 0;
    while (j < len(bounds)) {
        let b = bounds[j];
        s = s + " (bound " + b.param + " " + b.trait_name + ")";
        j = j + 1;
    }
    s + ")"
}

fn dump_func(f: Func) -> string {
    "(fn" + dump_pub(f.is_pub) + dump_anns(f.annotations) + " " + f.name
        + dump_generics(f.type_params, f.bounds) + " (params" + dump_params(f.params) + ") "
        + dump_type(f.ret) + " " + dump_block(f.body) + ")" + pos(f.line, f.col)
}

fn dump_struct(s: StructDef) -> string {
    var inner = "";
    var i = 0;
    while (i < len(s.fields)) {
        let fd = s.fields[i];
        inner = inner + " (field " + fd.name + " " + dump_type(fd.ty) + ")";
        i = i + 1;
    }
    "(struct" + dump_pub(s.is_pub) + dump_anns(s.annotations) + " " + s.name
        + dump_generics(s.type_params, s.bounds) + " (fields" + inner + "))" + pos(s.line, s.col)
}

fn dump_enum(e: EnumDef) -> string {
    var inner = "";
    var i = 0;
    while (i < len(e.variants)) {
        let v = e.variants[i];
        var payload = "";
        var j = 0;
        while (j < len(v.payload)) { payload = payload + " " + dump_type(v.payload[j]); j = j + 1; }
        inner = inner + " (variant " + v.name + payload + ")" + pos(v.line, v.col);
        i = i + 1;
    }
    "(enum" + dump_pub(e.is_pub) + dump_anns(e.annotations) + " " + e.name
        + dump_generics(e.type_params, e.bounds) + inner + ")" + pos(e.line, e.col)
}

fn dump_methodsig(m: MethodSig) -> string {
    var s = "(method " + m.name + " (params" + dump_params(m.params) + ") " + dump_type(m.ret);
    match (m.default_body) {
        Option.Some(b) => { s = s + " " + dump_block(b); },
        Option.None => {},
    }
    s + ")" + pos(m.line, m.col)
}

fn dump_trait(t: TraitDef) -> string {
    var inner = "";
    var i = 0;
    while (i < len(t.methods)) { inner = inner + " " + dump_methodsig(t.methods[i]); i = i + 1; }
    "(trait" + dump_pub(t.is_pub) + " " + t.name + inner + ")" + pos(t.line, t.col)
}

fn dump_impl(b: ImplBlock) -> string {
    var inner = "";
    var i = 0;
    while (i < len(b.methods)) { inner = inner + " " + dump_func(b.methods[i]); i = i + 1; }
    "(impl " + b.trait_name + dump_generics(b.type_params, b.bounds) + " " + dump_type(b.target)
        + inner + ")" + pos(b.line, b.col)
}

fn dump_import(d: ImportDecl) -> string {
    var s = "(import " + d.module;
    match (d.alias) {
        Option.Some(a) => { s = s + " as " + a; },
        Option.None => {},
    }
    s + ")" + pos(d.line, d.col)
}

fn dump_from_import(fi: FromImport) -> string {
    var names = "";
    var i = 0;
    while (i < len(fi.names)) {
        let n = fi.names[i];
        var one = "(name " + n.name;
        match (n.alias) {
            Option.Some(a) => { one = one + " as " + a; },
            Option.None => {},
        }
        names = names + " " + one + ")" + pos(n.line, n.col);
        i = i + 1;
    }
    "(from" + dump_pub(fi.is_pub) + " " + fi.module + names + ")" + pos(fi.line, fi.col)
}

// Desenvuelve el lexer (M14.2a parsea entradas válidas; un error léxico aquí es excepcional).
fn lex_or_die(src: string) -> [Token] {
    match (lex(src)) {
        Result.Ok(toks) => toks,
        Result.Err(e) => panic("error léxico: " + e.msg),
    }
}

// Vuelca un Program en el orden fijo (el oráculo usa el mismo): imports, from-imports, funciones,
// structs, enums, traits, impls.
fn dump_program(prog: Program) {
    var im = 0;
    while (im < len(prog.imports)) { print(dump_import(prog.imports[im])); im = im + 1; }
    var fr = 0;
    while (fr < len(prog.from_imports)) { print(dump_from_import(prog.from_imports[fr])); fr = fr + 1; }
    var i = 0;
    while (i < len(prog.funcs)) { print(dump_func(prog.funcs[i])); i = i + 1; }
    var s = 0;
    while (s < len(prog.structs)) { print(dump_struct(prog.structs[s])); s = s + 1; }
    var e = 0;
    while (e < len(prog.enums)) { print(dump_enum(prog.enums[e])); e = e + 1; }
    var t = 0;
    while (t < len(prog.traits)) { print(dump_trait(prog.traits[t])); t = t + 1; }
    var m = 0;
    while (m < len(prog.impls)) { print(dump_impl(prog.impls[m])); m = m + 1; }
}

fn main() -> int {
    let argv = args();
    if (len(argv) == 0) {
        eprint("uso: raylang selfhost/parse_dump.ray <archivo>");
        return 1;
    }
    match (read_file(argv[0])) {
        Result.Ok(src) => {
            // Volcado canónico: en caso feliz el AST; ante un error de sintaxis, una línea con el
            // mismo formato que el `Display` de `ParseError` en Rust (el oráculo compara también esto).
            match (parse(lex_or_die(src))) {
                Result.Ok(prog) => { dump_program(prog); },
                Result.Err(pe) => {
                    print("error de sintaxis en " + to_string(pe.line) + ":" + to_string(pe.col) + ": " + pe.msg);
                },
            }
            0
        },
        Result.Err(msg) => {
            eprint(msg);
            1
        },
    }
}
