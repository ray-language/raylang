// El parser de raylang, escrito EN raylang (self-hosting, M14.2).
//
// Segunda fase del bootstrap: tokens (del lexer auto-alojado) → AST. Port del descenso recursivo
// de `src/parser.rs`. Se valida contra el parser de Rust como ORÁCULO (ver `tests/selfhost_parser.rs`)
// mediante un volcado canónico del AST que ambos lados producen idéntico.
//
// Cobertura: el lenguaje completo (expresiones con toda la precedencia, sentencias, funciones,
// structs/enums, match/patrones, fn-anónimas, genéricos, traits, impls, dyn, Map, `?`, pipelines,
// anotaciones, pub, imports, refs calificadas `M.Tipo`).
//
// Errores como VALORES (M14.2d): `parse` devuelve `Result<Program, ParseError>` y cada función de
// parseo propaga el primer error con `?` (igual que el lexer en M14.1b). Los mensajes y posiciones
// son idénticos a los del parser de Rust (`error de sintaxis en <l>:<c>: <msg>`).
//
// El AST se modela con tipos mutuamente recursivos: `struct Expr` lleva un `EKind`, que a su vez
// contiene `Expr`/`Block`. raylang lo soporta porque structs/enums viven en el heap (semántica de
// referencia), así que la recursión no implica tamaño infinito.
from lexer import Token, TokKind;

// =====================================================================
// El AST (espejo de `src/ast.rs`)
// =====================================================================
// Tipos que el programador escribe.
pub enum Type {
    TInt,
    TFloat,
    TBool,
    TString,
    TChar,
    TUnit,
    TArray(Type),  // [T]
    TFn([Type], Type),  // fn(args) -> ret
    TNamed(string, [Type]),  // un nombre con args de tipo: Punto / Caja<int> / Map<K,V>
    TDyn([string]),  // trait object dyn A + B (conjunto canónico: ordenado, sin duplicados)
}

pub enum UnOp {
    Neg,
    Not,
}

pub enum BinOp {
    Add,
    Sub,
    Mul,
    Div,
    Rem,
    Eq,
    Ne,
    Lt,
    Le,
    Gt,
    Ge,
    And,
    Or,
}

// Una expresión: su forma (`kind`) y dónde empieza.
pub struct Expr {
    kind: EKind,
    line: int,
    col: int,
}

pub enum EKind {
    EInt(int),
    EFloat(float),
    EBool(bool),
    EStr(string),
    EChar(char),
    EIdent(string),
    EUnary(UnOp, Expr),
    EBinary(BinOp, Expr, Expr),
    ECall(Expr, [Expr]),  // callee, argumentos
    EIndex(Expr, Expr),  // arreglo, índice
    EField(Expr, string),  // objeto, nombre del campo
    EArray([Expr]),
    EIf(Expr, Block, Option<Expr>),  // cond, then, else (bloque-expr u otro if)
    EWhile(Expr, Block),
    EBlock(Block),
    EStructLit(string, [FieldInit]),  // Nombre { campo: valor, ... }
    EFunc(FnExpr),  // función anónima fn(...) { ... }
    EMatch(Expr, [MatchArm]),  // match (e) { patrón => cuerpo, ... }
    ETry(Expr),  // expr?  (propagación de errores)
}

// Inicialización de un campo en un literal de struct: `campo: valor`.
pub struct FieldInit {
    name: string,
    value: Expr,
}

// Una función anónima como valor. `id` es único (contador del parser).
pub struct FnExpr {
    id: int,
    params: [Param],
    ret: Type,
    body: Block,
    line: int,
    col: int,
}

// Un brazo de `match`: un patrón y la expresión-cuerpo que se evalúa si casa.
pub struct MatchArm {
    pat: Pattern,
    body: Expr,
    line: int,
    col: int,
}

// Un patrón (plano, un nivel): comodín, binding suelto o variante de enum.
pub struct Pattern {
    kind: PKind,
    line: int,
    col: int,
}

pub enum PKind {
    PWild,  // _
    PBind(string),  // un nombre suelto (catch-all)
    PVariant(string, string, [Option<string>]),  // Enum.Variante(sub-bindings); None = '_'
}

// Un parámetro formal `nombre: tipo`.
pub struct Param {
    name: string,
    ty: Type,
    line: int,
    col: int,
}

// Un bloque `{ sentencias... [tail] }`. `tail` es la expresión final sin `;` (el valor del bloque).
pub struct Block {
    stmts: [Stmt],
    tail: Option<Expr>,
    line: int,
    col: int,
}

pub struct Stmt {
    kind: SKind,
    line: int,
    col: int,
}

pub enum SKind {
    SLet(string, Option<Type>, Expr, bool),  // nombre, tipo?, valor, mutable (let vs var)
    SAssign(Expr, Expr),  // destino, valor
    SReturn(Option<Expr>),
    SExpr(Expr),
}

// Un bound de un parámetro de tipo: `T: Trait`. raylang no tiene tuplas → un struct.
pub struct Bound {
    param: string,
    trait_name: string,
}

// El resultado de parsear `<T: A, U: B>`: los nombres y los bounds (raylang no tiene tuplas).
struct Generics {
    params: [string],
    bounds: [Bound],
}

// Una anotación `@nombre[(args)]` adherida a una declaración.
pub struct Annotation {
    name: string,
    args: [string],
    line: int,
    col: int,
}

// Una función de nivel superior.
pub struct Func {
    annotations: [Annotation],
    is_pub: bool,
    name: string,
    type_params: [string],
    bounds: [Bound],
    params: [Param],
    ret: Type,
    body: Block,
    line: int,
    col: int,
}

// Un campo de un struct: `nombre: tipo`.
pub struct FieldDef {
    name: string,
    ty: Type,
}

// Definición de struct: `[anns] [pub] struct Nombre<T: B> { campo: Tipo, ... }`.
pub struct StructDef {
    annotations: [Annotation],
    is_pub: bool,
    name: string,
    type_params: [string],
    bounds: [Bound],
    fields: [FieldDef],
    line: int,
    col: int,
}

// Una variante de enum: su nombre y su payload posicional (vacío = variante unit).
pub struct VariantDef {
    name: string,
    payload: [Type],
    line: int,
    col: int,
}

// Definición de enum: `[anns] [pub] enum Nombre<T: B> { Variante(tipos...), ... }`.
pub struct EnumDef {
    annotations: [Annotation],
    is_pub: bool,
    name: string,
    type_params: [string],
    bounds: [Bound],
    variants: [VariantDef],
    line: int,
    col: int,
}

// La firma de un método de trait: `fn name(self, p: T) -> R` con `;` o un cuerpo por defecto.
pub struct MethodSig {
    name: string,
    params: [Param],
    ret: Type,
    default_body: Option<Block>,
    line: int,
    col: int,
}

// Declaración de trait: contrato de comportamiento. Lista firmas de métodos.
pub struct TraitDef {
    is_pub: bool,
    name: string,
    methods: [MethodSig],
    line: int,
    col: int,
}

// `import M [as x];` / `import a/b/c [as x];`: importa un módulo por su ruta.
pub struct ImportDecl {
    module: string,
    alias: Option<string>,
    line: int,
    col: int,
}

// Un nombre traído por un `from`-import: el original y, opcionalmente, su alias local.
pub struct ImportName {
    name: string,
    alias: Option<string>,
    line: int,
    col: int,
}

// `[pub] from M import a [as b]{, …};`. `is_pub` marca reexport.
pub struct FromImport {
    module: string,
    names: [ImportName],
    is_pub: bool,
    line: int,
    col: int,
}

// Un bloque `impl [<T: B>] Trait for Tipo { ... }`. `target` es el tipo implementador.
pub struct ImplBlock {
    trait_name: string,
    type_params: [string],
    bounds: [Bound],
    target: Type,
    methods: [Func],
    line: int,
    col: int,
}

// Un programa: funciones + tipos + traits + impls + imports.
pub struct Program {
    funcs: [Func],
    structs: [StructDef],
    enums: [EnumDef],
    traits: [TraitDef],
    impls: [ImplBlock],
    imports: [ImportDecl],
    from_imports: [FromImport],
}

// Error sintáctico con ubicación (espejo de `ParseError` en Rust). Lo devuelve `parse` como VALOR.
pub struct ParseError {
    msg: string,
    line: int,
    col: int,
}

// El estado del parser: la cinta de tokens, el cursor y el contador de funciones anónimas.
struct Parser {
    toks: [Token],
    pos: int,
    next_fn_id: int,
}

// =====================================================================
// Nombre canónico de un token: única fuente de verdad para check/eat/expect.
// Devuelve la grafía del token (`(`, `->`, `let`) o un nombre simbólico para los que cargan valor
// (`ident`, `int-lit`). Así el parser compara contra strings legibles, sin números mágicos.
// =====================================================================
fn tok_name(k: TokKind) -> string {
    match (k) {
        TokKind.Int(_) => "int-lit",
        TokKind.Float(_) => "float-lit",
        TokKind.Str(_) => "str-lit",
        TokKind.Char(_) => "char-lit",
        TokKind.Ident(_) => "ident",
        TokKind.Let => "let",
        TokKind.Var => "var",
        TokKind.Fn => "fn",
        TokKind.Return => "return",
        TokKind.If => "if",
        TokKind.Else => "else",
        TokKind.While => "while",
        TokKind.True => "true",
        TokKind.False => "false",
        TokKind.Struct => "struct",
        TokKind.Enum => "enum",
        TokKind.Match => "match",
        TokKind.Trait => "trait",
        TokKind.Impl => "impl",
        TokKind.Dyn => "dyn",
        TokKind.Pub => "pub",
        TokKind.Import => "import",
        TokKind.From => "from",
        TokKind.As => "as",
        TokKind.IntType => "int",
        TokKind.FloatType => "float",
        TokKind.BoolType => "bool",
        TokKind.StringType => "string",
        TokKind.CharType => "char",
        TokKind.Plus => "+",
        TokKind.Minus => "-",
        TokKind.Star => "*",
        TokKind.Slash => "/",
        TokKind.Percent => "%",
        TokKind.EqEq => "==",
        TokKind.BangEq => "!=",
        TokKind.Lt => "<",
        TokKind.LtEq => "<=",
        TokKind.Gt => ">",
        TokKind.GtEq => ">=",
        TokKind.AmpAmp => "&&",
        TokKind.PipePipe => "||",
        TokKind.Bang => "!",
        TokKind.Eq => "=",
        TokKind.LParen => "(",
        TokKind.RParen => ")",
        TokKind.LBrace => "{",
        TokKind.RBrace => "}",
        TokKind.LBracket => "[",
        TokKind.RBracket => "]",
        TokKind.Comma => ",",
        TokKind.Semicolon => ";",
        TokKind.Colon => ":",
        TokKind.Dot => ".",
        TokKind.Arrow => "->",
        TokKind.FatArrow => "=>",
        TokKind.Question => "?",
        TokKind.PipeArrow => "|>",
        TokKind.At => "@",
        TokKind.Eof => "eof",
    }
}

// La repr Debug de Rust de un token (los nombres de variante de `TokenKind`), para reproducir el
// mensaje "se esperaba una expresión, se encontró <Debug>" exactamente como el parser de Rust.
fn tok_debug(k: TokKind) -> string {
    match (k) {
        TokKind.Int(n) => "Int(" + to_string(n) + ")",
        TokKind.Float(f) => "Float(" + to_string(f) + ")",
        TokKind.Str(s) => "Str(\"" + s + "\")",
        TokKind.Char(c) => "Char('" + to_string(c) + "')",
        TokKind.Ident(n) => "Ident(\"" + n + "\")",
        TokKind.Let => "Let",
        TokKind.Var => "Var",
        TokKind.Fn => "Fn",
        TokKind.Return => "Return",
        TokKind.If => "If",
        TokKind.Else => "Else",
        TokKind.While => "While",
        TokKind.True => "True",
        TokKind.False => "False",
        TokKind.Struct => "Struct",
        TokKind.Enum => "Enum",
        TokKind.Match => "Match",
        TokKind.Trait => "Trait",
        TokKind.Impl => "Impl",
        TokKind.Dyn => "Dyn",
        TokKind.Pub => "Pub",
        TokKind.Import => "Import",
        TokKind.From => "From",
        TokKind.As => "As",
        TokKind.IntType => "IntType",
        TokKind.FloatType => "FloatType",
        TokKind.BoolType => "BoolType",
        TokKind.StringType => "StringType",
        TokKind.CharType => "CharType",
        TokKind.Plus => "Plus",
        TokKind.Minus => "Minus",
        TokKind.Star => "Star",
        TokKind.Slash => "Slash",
        TokKind.Percent => "Percent",
        TokKind.EqEq => "EqEq",
        TokKind.BangEq => "BangEq",
        TokKind.Lt => "Lt",
        TokKind.LtEq => "LtEq",
        TokKind.Gt => "Gt",
        TokKind.GtEq => "GtEq",
        TokKind.AmpAmp => "AmpAmp",
        TokKind.PipePipe => "PipePipe",
        TokKind.Bang => "Bang",
        TokKind.Eq => "Eq",
        TokKind.LParen => "LParen",
        TokKind.RParen => "RParen",
        TokKind.LBrace => "LBrace",
        TokKind.RBrace => "RBrace",
        TokKind.LBracket => "LBracket",
        TokKind.RBracket => "RBracket",
        TokKind.Comma => "Comma",
        TokKind.Semicolon => "Semicolon",
        TokKind.Colon => "Colon",
        TokKind.Dot => "Dot",
        TokKind.Arrow => "Arrow",
        TokKind.FatArrow => "FatArrow",
        TokKind.Question => "Question",
        TokKind.PipeArrow => "PipeArrow",
        TokKind.At => "At",
        TokKind.Eof => "Eof",
    }
}

// =====================================================================
// Primitivas del cursor de tokens
// =====================================================================
fn cur_kind(p: Parser) -> TokKind { p.toks[p.pos].kind }

fn cur_tok(p: Parser) -> Token { p.toks[p.pos] }

fn at_end(p: Parser) -> bool { tok_name(cur_kind(p)) == "eof" }

// El token actual es exactamente `name` (su grafía canónica).
fn check(p: Parser, name: string) -> bool { tok_name(cur_kind(p)) == name }

// El token SIGUIENTE (uno por delante) es `name`. Para el lookahead de `pub from …`.
fn check_next(p: Parser, name: string) -> bool {
    if (p.pos + 1 < p.toks.len()) { tok_name(p.toks[p.pos + 1].kind) == name } else { false }
}

// Consume y devuelve el token actual (no avanza más allá de Eof).
fn advance(p: Parser) -> Token {
    let t = p.toks[p.pos];
    if (!at_end(p)) {
        p.pos = p.pos + 1;
    }
    t
}

// Si el token actual es `name`, lo consume y devuelve true.
fn eat(p: Parser, name: string) -> bool {
    if (check(p, name)) {
        advance(p);
        true
    } else { false }
}

// Construye un error en la posición del token ACTUAL (como `error_here` en Rust).
fn perr_here(p: Parser, msg: string) -> ParseError {
    let t = cur_tok(p);
    ParseError { msg: msg, line: t.line, col: t.col }
}

// Construye un error en una posición explícita.
fn perr_at(line: int, col: int, msg: string) -> ParseError {
    ParseError { msg: msg, line: line, col: col }
}

// Consume el token actual si es `name`; si no, error describiendo qué se esperaba.
fn expect(p: Parser, name: string, what: string) -> Result<Token, ParseError> {
    if (check(p, name)) { Result.Ok(advance(p)) } else { Result.Err(perr_here(p, "expected " + what)) }
}

// Consume un identificador y devuelve su nombre.
fn expect_ident(p: Parser, what: string) -> Result<string, ParseError> {
    match (cur_kind(p)) {
        TokKind.Ident(n) => {
            advance(p);
            Result.Ok(n)
        },
        _ => Result.Err(perr_here(p, "expected " + what)),
    }
}

// =====================================================================
// Reglas de la gramática
// =====================================================================
// program = { import | [anns] [pub] (struct_def | enum_def | trait_def | impl_block | function) }
fn parse_program(p: Parser) -> Result<Program, ParseError> {
    var funcs: [Func] = [];
    var structs: [StructDef] = [];
    var enums: [EnumDef] = [];
    var traits: [TraitDef] = [];
    var impls: [ImplBlock] = [];
    var imports: [ImportDecl] = [];
    var from_imports: [FromImport] = [];
    while (!at_end(p)) {
        if (check(p, "import")) {
            imports.push(import_decl(p)?);
        } else if (check(p, "from")) {
            from_imports.push(import_from_decl(p, false)?);
        } else if (check(p, "pub") && check_next(p, "from")) {
            advance(p);  // 'pub'
            from_imports.push(import_from_decl(p, true)?);  // reexport
        } else {
            // Anotaciones (@nombre[(args)]) y luego `pub`, antes de la declaración.
            let anns = annotations(p)?;
            var is_pub = false;
            var pub_line = 0;
            var pub_col = 0;
            if (check(p, "pub")) {
                let pt = advance(p);
                is_pub = true;
                pub_line = pt.line;
                pub_col = pt.col;
            }
            if (check(p, "struct")) {
                var s = struct_def(p)?;
                s.annotations = anns;
                s.is_pub = is_pub;
                structs.push(s);
            } else if (check(p, "enum")) {
                var e = enum_def(p)?;
                e.annotations = anns;
                e.is_pub = is_pub;
                enums.push(e);
            } else if (check(p, "trait")) {
                if (anns.len() > 0) {
                    return Result.Err(perr_at(anns[0].line, anns[0].col, "annotations are not allowed on a trait"));
                }
                var t = trait_def(p)?;
                t.is_pub = is_pub;
                traits.push(t);
            } else if (check(p, "impl")) {
                if (is_pub) {
                    return Result.Err(perr_at(pub_line, pub_col, "'pub' is not allowed on an impl (export the trait/type, not the impl)"));
                }
                if (anns.len() > 0) {
                    return Result.Err(perr_at(anns[0].line, anns[0].col, "annotations are not allowed on an impl"));
                }
                impls.push(impl_block(p)?);
            } else {
                var f = function(p)?;
                f.annotations = anns;
                f.is_pub = is_pub;
                funcs.push(f);
            }
        }
    }
    Result.Ok(Program { funcs: funcs, structs: structs, enums: enums, traits: traits, impls: impls, imports: imports, from_imports: from_imports })
}

// Recoge las anotaciones que preceden a una declaración: { '@' IDENT [ '(' IDENT { ',' IDENT } ')' ] }.
fn annotations(p: Parser) -> Result<[Annotation], ParseError> {
    var anns: [Annotation] = [];
    while (check(p, "@")) {
        let at = advance(p);
        let name = expect_ident(p, "the annotation name after '@'")?;
        var args: [string] = [];
        if (eat(p, "(")) {
            if (!check(p, ")")) {
                var keep_going = true;
                while (keep_going) {
                    args.push(expect_ident(p, "an annotation argument")?);
                    if (!eat(p, ",")) {
                        keep_going = false;
                    }
                }
            }
            expect(p, ")", "')' to close the annotation arguments")?;
        }
        anns.push(Annotation { name: name, args: args, line: at.line, col: at.col });
    }
    Result.Ok(anns)
}

// module_path = IDENT { '/' IDENT }   (ruta de directorios). Devuelve la ruta unida con '/'.
fn module_path(p: Parser) -> Result<string, ParseError> {
    var path = expect_ident(p, "the module name to import")?;
    while (eat(p, "/")) {
        let seg = expect_ident(p, "a path segment after '/'")?;
        path = path + "/" + seg;
    }
    Result.Ok(path)
}

// import_decl = 'import' module_path [ 'as' IDENT ] ';'
fn import_decl(p: Parser) -> Result<ImportDecl, ParseError> {
    let kw = expect(p, "import", "'import'")?;
    let modpath = module_path(p)?;
    var alias: Option<string> = Option.None;
    if (eat(p, "as")) {
        alias = Option.Some(expect_ident(p, "the alias after 'as'")?);
    }
    expect(p, ";", "';' after 'import …'")?;
    Result.Ok(ImportDecl { module: modpath, alias: alias, line: kw.line, col: kw.col })
}

// from_import_decl = 'from' module_path 'import' name { ',' name } [ ',' ] ';'  ;  name = IDENT [ 'as' IDENT ]
// La coma final es opcional (M104): la lista envuelta en varias líneas se edita con un diff de una línea.
fn import_from_decl(p: Parser, is_pub: bool) -> Result<FromImport, ParseError> {
    let kw = expect(p, "from", "'from'")?;
    let modpath = module_path(p)?;
    expect(p, "import", "'import' after 'from M'")?;
    var names: [ImportName] = [];
    var keep_going = true;
    while (keep_going) {
        let t = cur_tok(p);
        let nm = expect_ident(p, "a name to import")?;
        var alias: Option<string> = Option.None;
        if (eat(p, "as")) {
            alias = Option.Some(expect_ident(p, "the alias after 'as'")?);
        }
        names.push(ImportName { name: nm, alias: alias, line: t.line, col: t.col });
        if (!eat(p, ",")) {
            keep_going = false;
        }
        // Coma final: tras la `,` viene el `;` → la lista termina aquí.
        if (check(p, ";")) {
            keep_going = false;
        }
    }
    expect(p, ";", "';' to close the 'from M import …'")?;
    Result.Ok(FromImport { module: modpath, names: names, is_pub: is_pub, line: kw.line, col: kw.col })
}

// struct_def = 'struct' IDENT '{' [ field { ',' field } [ ',' ] ] '}'   ;  field = IDENT ':' type
fn struct_def(p: Parser) -> Result<StructDef, ParseError> {
    let kw = expect(p, "struct", "'struct'")?;
    let name = expect_ident(p, "the struct name")?;
    let g = type_params_with_bounds(p)?;
    expect(p, "{", "'{' after the struct name")?;
    var fields: [FieldDef] = [];
    var done = false;
    while (!done && !check(p, "}")) {
        let fname = expect_ident(p, "a field name")?;
        expect(p, ":", "':' after the field name")?;
        let ty = parse_type(p)?;
        fields.push(FieldDef { name: fname, ty: ty });
        if (!eat(p, ",")) {
            done = true;
        }
    }
    expect(p, "}", "'}' to close the struct")?;
    Result.Ok(StructDef { annotations: [], is_pub: false, name: name, type_params: g.params, bounds: g.bounds, fields: fields, line: kw.line, col: kw.col })
}

// enum_def = 'enum' IDENT '{' [ variant { ',' variant } [ ',' ] ] '}'
// variant  = IDENT [ '(' type { ',' type } ')' ]
fn enum_def(p: Parser) -> Result<EnumDef, ParseError> {
    let kw = expect(p, "enum", "'enum'")?;
    let name = expect_ident(p, "the enum name")?;
    let g = type_params_with_bounds(p)?;
    expect(p, "{", "'{' after the enum name")?;
    var variants: [VariantDef] = [];
    var done = false;
    while (!done && !check(p, "}")) {
        let vt = cur_tok(p);
        let vname = expect_ident(p, "a variant name")?;
        var payload: [Type] = [];
        if (eat(p, "(")) {
            var keep_going = true;
            while (keep_going) {
                payload.push(parse_type(p)?);
                if (!eat(p, ",")) {
                    keep_going = false;
                }
            }
            expect(p, ")", "')' to close the variant payload")?;
        }
        variants.push(VariantDef { name: vname, payload: payload, line: vt.line, col: vt.col });
        if (!eat(p, ",")) {
            done = true;
        }
    }
    expect(p, "}", "'}' to close the enum")?;
    Result.Ok(EnumDef { annotations: [], is_pub: false, name: name, type_params: g.params, bounds: g.bounds, variants: variants, line: kw.line, col: kw.col })
}

// trait_def = 'trait' IDENT '{' { method_sig } '}'
fn trait_def(p: Parser) -> Result<TraitDef, ParseError> {
    let kw = expect(p, "trait", "'trait'")?;
    let name = expect_ident(p, "the trait name")?;
    expect(p, "{", "'{' after the trait name")?;
    var methods: [MethodSig] = [];
    while (!check(p, "}") && !at_end(p)) {
        methods.push(method_sig(p)?);
    }
    expect(p, "}", "'}' to close the trait")?;
    Result.Ok(TraitDef { is_pub: false, name: name, methods: methods, line: kw.line, col: kw.col })
}

// method_sig = 'fn' IDENT '(' [ method_params ] ')' [ '->' type ] ( ';' | block )
fn method_sig(p: Parser) -> Result<MethodSig, ParseError> {
    let kw = expect(p, "fn", "'fn' in a method signature")?;
    let name = expect_ident(p, "the method name")?;
    expect(p, "(", "'(' after the method name")?;
    let params = method_params(p)?;
    expect(p, ")", "')'")?;
    var ret = Type.TUnit;
    if (eat(p, "->")) {
        ret = parse_type(p)?;
    }
    var default_body: Option<Block> = Option.None;
    if (check(p, "{")) {
        default_body = Option.Some(block(p)?);
    } else {
        expect(p, ";", "';' or a '{ ... }' body for the method")?;
    }
    Result.Ok(MethodSig { name: name, params: params, ret: ret, default_body: default_body, line: kw.line, col: kw.col })
}

// impl_block = 'impl' [ '<' tparams '>' ] IDENT 'for' type '{' { impl_method } '}'
// 'for' no es palabra clave: se reconoce contextualmente (un identificador con ese nombre).
fn impl_block(p: Parser) -> Result<ImplBlock, ParseError> {
    let kw = expect(p, "impl", "'impl'")?;
    let g = type_params_with_bounds(p)?;
    let trait_name = expect_ident(p, "the trait name")?;
    let for_tok = cur_tok(p);
    let kw_for = expect_ident(p, "'for' after the trait name")?;
    if (kw_for != "for") {
        return Result.Err(perr_at(for_tok.line, for_tok.col, "expected 'for', not '" + kw_for + "'"));
    }
    let target = parse_type(p)?;
    expect(p, "{", "'{' to open the impl body")?;
    var methods: [Func] = [];
    while (!check(p, "}") && !at_end(p)) {
        methods.push(impl_method(p)?);
    }
    expect(p, "}", "'}' to close the impl")?;
    Result.Ok(ImplBlock { trait_name: trait_name, type_params: g.params, bounds: g.bounds, target: target, methods: methods, line: kw.line, col: kw.col })
}

// impl_method = 'fn' IDENT '(' [ method_params ] ')' [ '->' type ] block
fn impl_method(p: Parser) -> Result<Func, ParseError> {
    let kw = expect(p, "fn", "'fn' in an impl method")?;
    let name = expect_ident(p, "the method name")?;
    expect(p, "(", "'(' after the method name")?;
    let params = method_params(p)?;
    expect(p, ")", "')'")?;
    var ret = Type.TUnit;
    if (eat(p, "->")) {
        ret = parse_type(p)?;
    }
    let body = block(p)?;
    var tp: [string] = [];
    var bd: [Bound] = [];
    Result.Ok(Func { annotations: [], is_pub: false, name: name, type_params: tp, bounds: bd, params: params, ret: ret, body: body, line: kw.line, col: kw.col })
}

// method_params = [ 'self' [ ',' param { ',' param } ] ] | [ params ]
// Como params(), pero admite un primer parámetro `self` sin anotación (tipo `Self`).
fn method_params(p: Parser) -> Result<[Param], ParseError> {
    var params: [Param] = [];
    if (check(p, ")")) {
        return Result.Ok(params);
    }
    // ¿El primer parámetro es 'self'? (un IDENT con ese nombre, sin anotación).
    var is_self = false;
    match (cur_kind(p)) {
        TokKind.Ident(n) => {
            if (n == "self") {
                is_self = true;
            }
        },
        _ => { },
    }
    if (is_self) {
        let t = cur_tok(p);
        advance(p);
        params.push(Param { name: "self", ty: Type.TNamed("Self", []), line: t.line, col: t.col });
        if (!eat(p, ",")) {
            return Result.Ok(params);
        }
    }
    var keep_going = true;
    while (keep_going) {
        let t = cur_tok(p);
        let name = expect_ident(p, "a parameter name")?;
        expect(p, ":", "':' after the parameter name")?;
        let ty = parse_type(p)?;
        params.push(Param { name: name, ty: ty, line: t.line, col: t.col });
        if (!eat(p, ",")) {
            keep_going = false;
        }
    }
    Result.Ok(params)
}

// function = 'fn' IDENT [ '<' tparam { ',' tparam } '>' ] '(' [ params ] ')' [ '->' type ] block
fn function(p: Parser) -> Result<Func, ParseError> {
    let kw = expect(p, "fn", "'fn'")?;
    let name = expect_ident(p, "the function name")?;
    let g = type_params_with_bounds(p)?;
    expect(p, "(", "'(' after the function name")?;
    var params: [Param] = [];
    if (!check(p, ")")) {
        params = parse_params(p)?;
    }
    expect(p, ")", "')'")?;
    var ret = Type.TUnit;
    if (eat(p, "->")) {
        ret = parse_type(p)?;
    }
    let body = block(p)?;
    Result.Ok(Func { annotations: [], is_pub: false, name: name, type_params: g.params, bounds: g.bounds, params: params, ret: ret, body: body, line: kw.line, col: kw.col })
}

// params = param { ',' param } ;  param = IDENT ':' type
fn parse_params(p: Parser) -> Result<[Param], ParseError> {
    var params: [Param] = [];
    var keep_going = true;
    while (keep_going) {
        let t = cur_tok(p);
        let name = expect_ident(p, "a parameter name")?;
        expect(p, ":", "':' after the parameter name")?;
        let ty = parse_type(p)?;
        params.push(Param { name: name, ty: ty, line: t.line, col: t.col });
        if (!eat(p, ",")) {
            keep_going = false;
        }
    }
    Result.Ok(params)
}

// type = 'dyn' IDENT { '+' IDENT } | '[' type ']' | 'fn' '(' [ types ] ')' [ '->' type ]
//      | IDENT [ '.' IDENT ] [ '<' type { ',' type } '>' ] | 'int' | 'float' | 'bool' | 'string' | 'char'
fn parse_type(p: Parser) -> Result<Type, ParseError> {
    // Trait object: dyn A [+ B ...]. El conjunto se guarda canónico (ordenado, sin duplicados).
    if (eat(p, "dyn")) {
        var traits: [string] = [];
        var keep_going = true;
        while (keep_going) {
            traits.push(expect_ident(p, "the trait name after 'dyn'")?);
            if (!eat(p, "+")) {
                keep_going = false;
            }
        }
        return Result.Ok(Type.TDyn(sort_dedup(traits)));
    }
    if (check(p, "[")) {
        advance(p);
        let elem = parse_type(p)?;
        expect(p, "]", "']' to close the array type")?;
        return Result.Ok(Type.TArray(elem));
    }
    if (check(p, "fn")) {
        advance(p);
        expect(p, "(", "'(' after 'fn' in a function type")?;
        var ps: [Type] = [];
        if (!check(p, ")")) {
            var keep_going = true;
            while (keep_going) {
                ps.push(parse_type(p)?);
                if (!eat(p, ",")) {
                    keep_going = false;
                }
            }
        }
        expect(p, ")", "')' to close the function type")?;
        var r = Type.TUnit;
        if (eat(p, "->")) {
            r = parse_type(p)?;
        }
        return Result.Ok(Type.TFn(ps, r));
    }
    // Nombre de struct/enum/parámetro/Map, con `.` calificado y args de tipo opcionales.
    match (cur_kind(p)) {
        TokKind.Ident(name) => {
            advance(p);
            var full = name;
            if (eat(p, ".")) {
                full = full + "." + expect_ident(p, "the type name after 'M.'")?;
            }
            let targs = type_args(p)?;
            return Result.Ok(Type.TNamed(full, targs));
        },
        _ => { },
    }
    // Tipos primitivos.
    if (eat(p, "int")) { Result.Ok(Type.TInt) } else if (eat(p, "float")) { Result.Ok(Type.TFloat) } else if (eat(p, "bool")) { Result.Ok(Type.TBool) } else if (eat(p, "string")) { Result.Ok(Type.TString) } else if (eat(p, "char")) { Result.Ok(Type.TChar) } else { Result.Err(perr_here(p, "expected a type (int, float, bool, string, char, bytes, [T] or a struct)")) }
}

// Lista opcional de argumentos de tipo: `< type { ',' type } >` (genéricos). Vacío si no hay `<`.
fn type_args(p: Parser) -> Result<[Type], ParseError> {
    var args: [Type] = [];
    if (eat(p, "<")) {
        var keep_going = true;
        while (keep_going) {
            args.push(parse_type(p)?);
            if (!eat(p, ",")) {
                keep_going = false;
            }
        }
        expect(p, ">", "'>' to close the type arguments")?;
    }
    Result.Ok(args)
}

// Parámetros de tipo y sus bounds: `< T [: A + B] { , U ... } >`. Vacío si no hay `<`.
fn type_params_with_bounds(p: Parser) -> Result<Generics, ParseError> {
    var params: [string] = [];
    var bounds: [Bound] = [];
    if (eat(p, "<")) {
        var keep_going = true;
        while (keep_going) {
            let name = expect_ident(p, "a type parameter name")?;
            if (eat(p, ":")) {
                var more = true;
                while (more) {
                    let tr = expect_ident(p, "a trait name in the bound")?;
                    bounds.push(Bound { param: name, trait_name: tr });
                    if (!eat(p, "+")) {
                        more = false;
                    }
                }
            }
            params.push(name);
            if (!eat(p, ",")) {
                keep_going = false;
            }
        }
        expect(p, ">", "'>' to close the type parameters")?;
    }
    Result.Ok(Generics { params: params, bounds: bounds })
}

// Ordena un arreglo de strings y elimina duplicados adyacentes (para el conjunto canónico de `dyn`).
fn sort_dedup(xs: [string]) -> [string] {
    let sorted = sort(xs);
    var out: [string] = [];
    var i = 0;
    while (i < sorted.len()) {
        if (i == 0 || sorted[i] != sorted[i - 1]) {
            out.push(sorted[i]);
        }
        i = i + 1;
    }
    out
}

// block = '{' { statement } [ expression ] '}'
//
// La expresión final sin `;` es el `tail` (valor del bloque, DESIGN §6); lo demás son sentencias.
fn block(p: Parser) -> Result<Block, ParseError> {
    let open = expect(p, "{", "'{'")?;
    var stmts: [Stmt] = [];
    var tail: Option<Expr> = Option.None;
    var done = false;
    while (!done && !check(p, "}") && !at_end(p)) {
        if (check(p, "let") || check(p, "var")) {
            stmts.push(let_stmt(p)?);
        } else if (check(p, "return")) {
            stmts.push(return_stmt(p)?);
        } else {
            let e = expression(p)?;
            let line = e.line;
            let col = e.col;
            if (eat(p, "=")) {
                if (!is_lvalue(e)) {
                    return Result.Err(perr_here(p, "the left-hand side of '=' is not assignable"));
                }
                let value = expression(p)?;
                expect(p, ";", "';' at the end of the assignment")?;
                stmts.push(Stmt { kind: SKind.SAssign(e, value), line: line, col: col });
            } else if (eat(p, ";")) {
                stmts.push(Stmt { kind: SKind.SExpr(e), line: line, col: col });
            } else if (check(p, "}")) {
                tail = Option.Some(e);
                done = true;
            } else if (expr_has_block(e)) {
                // Expresión-con-bloque usada como sentencia: no necesita `;` (DESIGN §6).
                stmts.push(Stmt { kind: SKind.SExpr(e), line: line, col: col });
            } else {
                return Result.Err(perr_here(p, "expected ';' after the expression"));
            }
        }
    }
    expect(p, "}", "'}' to close the block")?;
    Result.Ok(Block { stmts: stmts, tail: tail, line: open.line, col: open.col })
}

// letDecl = ('let' | 'var') IDENT [ ':' type ] '=' expression ';'
fn let_stmt(p: Parser) -> Result<Stmt, ParseError> {
    let kw = advance(p);  // 'let' o 'var'
    let mutable = tok_name(kw.kind) == "var";
    let name = expect_ident(p, "the variable name")?;
    var ty: Option<Type> = Option.None;
    if (eat(p, ":")) {
        ty = Option.Some(parse_type(p)?);
    }
    expect(p, "=", "'=' in the declaration")?;
    let value = expression(p)?;
    expect(p, ";", "';' at the end of the declaration")?;
    Result.Ok(Stmt { kind: SKind.SLet(name, ty, value, mutable), line: kw.line, col: kw.col })
}

// returnStmt = 'return' [ expression ] ';'
fn return_stmt(p: Parser) -> Result<Stmt, ParseError> {
    let kw = advance(p);  // 'return'
    var value: Option<Expr> = Option.None;
    if (!check(p, ";")) {
        value = Option.Some(expression(p)?);
    }
    expect(p, ";", "';' at the end of the return")?;
    Result.Ok(Stmt { kind: SKind.SReturn(value), line: kw.line, col: kw.col })
}

// ----- Expresiones, por precedencia (de menor a mayor) -----
fn expression(p: Parser) -> Result<Expr, ParseError> { pipeline(p) }

// pipeline = logic_or { '|>' call }
//
// Azúcar: `x |> f(a)` ≡ `f(x, a)` (receptor como PRIMER argumento). Precedencia más baja, asociativo
// a la izquierda; el operando derecho se parsea a nivel de `call`. Se desazucara aquí a un `Call`.
fn pipeline(p: Parser) -> Result<Expr, ParseError> {
    var left = logic_or(p)?;
    while (check(p, "|>")) {
        advance(p);
        let rhs = call(p)?;
        left = make_pipeline(left, rhs);
    }
    Result.Ok(left)
}

// logic_or = logic_and { '||' logic_and }
fn logic_or(p: Parser) -> Result<Expr, ParseError> {
    var left = logic_and(p)?;
    while (check(p, "||")) {
        advance(p);
        let right = logic_and(p)?;
        left = make_binary(BinOp.Or, left, right);
    }
    Result.Ok(left)
}

// logic_and = equality { '&&' equality }
fn logic_and(p: Parser) -> Result<Expr, ParseError> {
    var left = equality(p)?;
    while (check(p, "&&")) {
        advance(p);
        let right = equality(p)?;
        left = make_binary(BinOp.And, left, right);
    }
    Result.Ok(left)
}

// equality = comparison { ('==' | '!=') comparison }
fn equality(p: Parser) -> Result<Expr, ParseError> {
    var left = comparison(p)?;
    var keep_going = true;
    while (keep_going) {
        if (check(p, "==")) {
            advance(p);
            let r = comparison(p)?;
            left = make_binary(BinOp.Eq, left, r);
        } else if (check(p, "!=")) {
            advance(p);
            let r = comparison(p)?;
            left = make_binary(BinOp.Ne, left, r);
        } else {
            keep_going = false;
        }
    }
    Result.Ok(left)
}

// comparison = term { ('<' | '<=' | '>' | '>=') term }
fn comparison(p: Parser) -> Result<Expr, ParseError> {
    var left = term(p)?;
    var keep_going = true;
    while (keep_going) {
        if (check(p, "<")) {
            advance(p);
            let r = term(p)?;
            left = make_binary(BinOp.Lt, left, r);
        } else if (check(p, "<=")) {
            advance(p);
            let r = term(p)?;
            left = make_binary(BinOp.Le, left, r);
        } else if (check(p, ">")) {
            advance(p);
            let r = term(p)?;
            left = make_binary(BinOp.Gt, left, r);
        } else if (check(p, ">=")) {
            advance(p);
            let r = term(p)?;
            left = make_binary(BinOp.Ge, left, r);
        } else {
            keep_going = false;
        }
    }
    Result.Ok(left)
}

// term = factor { ('+' | '-') factor }
fn term(p: Parser) -> Result<Expr, ParseError> {
    var left = factor(p)?;
    var keep_going = true;
    while (keep_going) {
        if (check(p, "+")) {
            advance(p);
            let r = factor(p)?;
            left = make_binary(BinOp.Add, left, r);
        } else if (check(p, "-")) {
            advance(p);
            let r = factor(p)?;
            left = make_binary(BinOp.Sub, left, r);
        } else {
            keep_going = false;
        }
    }
    Result.Ok(left)
}

// factor = unary { ('*' | '/' | '%') unary }
fn factor(p: Parser) -> Result<Expr, ParseError> {
    var left = unary(p)?;
    var keep_going = true;
    while (keep_going) {
        if (check(p, "*")) {
            advance(p);
            let r = unary(p)?;
            left = make_binary(BinOp.Mul, left, r);
        } else if (check(p, "/")) {
            advance(p);
            let r = unary(p)?;
            left = make_binary(BinOp.Div, left, r);
        } else if (check(p, "%")) {
            advance(p);
            let r = unary(p)?;
            left = make_binary(BinOp.Rem, left, r);
        } else {
            keep_going = false;
        }
    }
    Result.Ok(left)
}

// unary = ('!' | '-') unary | call
fn unary(p: Parser) -> Result<Expr, ParseError> {
    let t = cur_tok(p);
    if (check(p, "!")) {
        advance(p);
        let e = unary(p)?;
        Result.Ok(Expr { kind: EKind.EUnary(UnOp.Not, e), line: t.line, col: t.col })
    } else if (check(p, "-")) {
        advance(p);
        let e = unary(p)?;
        Result.Ok(Expr { kind: EKind.EUnary(UnOp.Neg, e), line: t.line, col: t.col })
    } else {
        call(p)
    }
}

// call = primary { '(' [ args ] ')' | '[' expression ']' | '.' IDENT | '?' }
fn call(p: Parser) -> Result<Expr, ParseError> {
    var expr = primary(p)?;
    var keep_going = true;
    while (keep_going) {
        let line = expr.line;
        let col = expr.col;
        if (check(p, "(")) {
            advance(p);
            var cargs: [Expr] = [];
            if (!check(p, ")")) {
                cargs = parse_args(p)?;
            }
            expect(p, ")", "')' to close the call")?;
            expr = Expr { kind: EKind.ECall(expr, cargs), line: line, col: col };
        } else if (check(p, "[")) {
            advance(p);
            let idx = expression(p)?;
            expect(p, "]", "']' to close the indexing")?;
            expr = Expr { kind: EKind.EIndex(expr, idx), line: line, col: col };
        } else if (check(p, ".")) {
            advance(p);
            let nm = expect_ident(p, "the field name after '.'")?;
            // `M.Tipo { ... }`: literal de struct calificado (solo si el receptor del `.` es un Ident).
            var handled = false;
            var built = expr;
            if (check(p, "{")) {
                match (expr.kind) {
                    EKind.EIdent(m) => {
                        built = struct_literal(p, m + "." + nm, line, col)?;
                        handled = true;
                    },
                    _ => { },
                }
            }
            if (handled) {
                expr = built;
            } else {
                expr = Expr { kind: EKind.EField(expr, nm), line: line, col: col };
            }
        } else if (check(p, "?")) {
            advance(p);  // '?' postfijo (propagación de errores)
            expr = Expr { kind: EKind.ETry(expr), line: line, col: col };
        } else {
            keep_going = false;
        }
    }
    Result.Ok(expr)
}

// args = expression { ',' expression }
fn parse_args(p: Parser) -> Result<[Expr], ParseError> {
    var a: [Expr] = [];
    var keep_going = true;
    while (keep_going) {
        a.push(expression(p)?);
        if (!eat(p, ",")) {
            keep_going = false;
        }
    }
    Result.Ok(a)
}

// primary = literal | IDENT | '(' expression ')' | ifExpr | whileExpr | block | arrayLiteral
//         | fnExpr | matchExpr | structLiteral
fn primary(p: Parser) -> Result<Expr, ParseError> {
    if (check(p, "if")) {
        return if_expr(p);
    }
    if (check(p, "while")) {
        return while_expr(p);
    }
    if (check(p, "{")) {
        let b = block(p)?;
        return Result.Ok(Expr { kind: EKind.EBlock(b), line: b.line, col: b.col });
    }
    if (check(p, "[")) {
        return array_literal(p);
    }
    if (check(p, "fn")) {
        return fn_expr(p);
    }
    if (check(p, "match")) {
        return match_expr(p);
    }
    let t = cur_tok(p);
    match (t.kind) {
        TokKind.Int(v) => {
            advance(p);
            Result.Ok(Expr { kind: EKind.EInt(v), line: t.line, col: t.col })
        },
        TokKind.Float(v) => {
            advance(p);
            Result.Ok(Expr { kind: EKind.EFloat(v), line: t.line, col: t.col })
        },
        TokKind.Str(s) => {
            advance(p);
            Result.Ok(Expr { kind: EKind.EStr(s), line: t.line, col: t.col })
        },
        TokKind.Char(c) => {
            advance(p);
            Result.Ok(Expr { kind: EKind.EChar(c), line: t.line, col: t.col })
        },
        TokKind.True => {
            advance(p);
            Result.Ok(Expr { kind: EKind.EBool(true), line: t.line, col: t.col })
        },
        TokKind.False => {
            advance(p);
            Result.Ok(Expr { kind: EKind.EBool(false), line: t.line, col: t.col })
        },
        TokKind.Ident(name) => {
            advance(p);
            // `Nombre { ... }` es un literal de struct (las condiciones de if/while/match van entre
            // paréntesis, así que no hay ambigüedad con los bloques).
            if (check(p, "{")) { struct_literal(p, name, t.line, t.col) } else { Result.Ok(Expr { kind: EKind.EIdent(name), line: t.line, col: t.col }) }
        },
        TokKind.LParen => {
            advance(p);
            let inner = expression(p)?;
            expect(p, ")", "')' to close the parenthesis")?;
            // El paréntesis no deja nodo; conserva su posición (la del '(').
            Result.Ok(Expr { kind: inner.kind, line: t.line, col: t.col })
        },
        _ => Result.Err(perr_at(t.line, t.col, "expected an expression, found " + tok_debug(t.kind))),
    }
}

// ifExpr = 'if' '(' expression ')' block [ 'else' ( block | ifExpr ) ]
fn if_expr(p: Parser) -> Result<Expr, ParseError> {
    let kw = expect(p, "if", "'if'")?;
    expect(p, "(", "'(' after 'if'")?;
    let cond = expression(p)?;
    expect(p, ")", "')' after the condition")?;
    let then_b = block(p)?;
    var else_b: Option<Expr> = Option.None;
    if (eat(p, "else")) {
        if (check(p, "if")) {
            else_b = Option.Some(if_expr(p)?);
        } else {
            let b = block(p)?;
            else_b = Option.Some(Expr { kind: EKind.EBlock(b), line: b.line, col: b.col });
        }
    }
    Result.Ok(Expr { kind: EKind.EIf(cond, then_b, else_b), line: kw.line, col: kw.col })
}

// whileExpr = 'while' '(' expression ')' block
fn while_expr(p: Parser) -> Result<Expr, ParseError> {
    let kw = expect(p, "while", "'while'")?;
    expect(p, "(", "'(' after 'while'")?;
    let cond = expression(p)?;
    expect(p, ")", "')' after the condition")?;
    let body = block(p)?;
    Result.Ok(Expr { kind: EKind.EWhile(cond, body), line: kw.line, col: kw.col })
}

// arrayLiteral = '[' [ expression { ',' expression } [ ',' ] ] ']'
fn array_literal(p: Parser) -> Result<Expr, ParseError> {
    let open = expect(p, "[", "'['")?;
    var elems: [Expr] = [];
    if (!check(p, "]")) {
        var keep_going = true;
        while (keep_going) {
            elems.push(expression(p)?);
            if (!eat(p, ",")) {
                keep_going = false;
            } else if (check(p, "]")) {
                keep_going = false;  // coma final permitida
            }
        }
    }
    expect(p, "]", "']' to close the array")?;
    Result.Ok(Expr { kind: EKind.EArray(elems), line: open.line, col: open.col })
}

// fnExpr = 'fn' '(' [ params ] ')' [ '->' type ] block   (función anónima)
//
// El id se asigna en PRE-ORDEN (antes de parsear cuerpo): una fn-expr exterior recibe un id menor
// que las anidadas en su cuerpo → ids densos 0..n, igual que el parser de Rust.
fn fn_expr(p: Parser) -> Result<Expr, ParseError> {
    let kw = expect(p, "fn", "'fn'")?;
    let id = p.next_fn_id;
    p.next_fn_id = p.next_fn_id + 1;
    expect(p, "(", "'(' after 'fn'")?;
    var params: [Param] = [];
    if (!check(p, ")")) {
        params = parse_params(p)?;
    }
    expect(p, ")", "')'")?;
    var ret = Type.TUnit;
    if (eat(p, "->")) {
        ret = parse_type(p)?;
    }
    let body = block(p)?;
    let fe = FnExpr { id: id, params: params, ret: ret, body: body, line: kw.line, col: kw.col };
    Result.Ok(Expr { kind: EKind.EFunc(fe), line: kw.line, col: kw.col })
}

// matchExpr = 'match' '(' expression ')' '{' [ arm { ',' arm } [ ',' ] ] '}'
fn match_expr(p: Parser) -> Result<Expr, ParseError> {
    let kw = expect(p, "match", "'match'")?;
    expect(p, "(", "'(' after 'match'")?;
    let scrut = expression(p)?;
    expect(p, ")", "')' after the match expression")?;
    expect(p, "{", "'{' to open the match arms")?;
    var arms: [MatchArm] = [];
    var done = false;
    while (!done && !check(p, "}")) {
        arms.push(match_arm(p)?);
        if (!eat(p, ",")) {
            done = true;
        }
    }
    expect(p, "}", "'}' to close the match")?;
    Result.Ok(Expr { kind: EKind.EMatch(scrut, arms), line: kw.line, col: kw.col })
}

// arm = pattern '=>' expression
fn match_arm(p: Parser) -> Result<MatchArm, ParseError> {
    let pat = pattern(p)?;
    let line = pat.line;
    let col = pat.col;
    expect(p, "=>", "'=>' after the pattern")?;
    let body = expression(p)?;
    Result.Ok(MatchArm { pat: pat, body: body, line: line, col: col })
}

// pattern = '_' | IDENT | IDENT '.' IDENT [ '(' subpat { ',' subpat } ')' ]   ;  subpat = '_' | IDENT
// (con calificación de módulo: M.Enum.Variante)
fn pattern(p: Parser) -> Result<Pattern, ParseError> {
    let t = cur_tok(p);
    let name = expect_ident(p, "a pattern (variant, name or '_')")?;
    if (name == "_") {
        return Result.Ok(Pattern { kind: PKind.PWild, line: t.line, col: t.col });
    }
    if (eat(p, ".")) {
        var variant = expect_ident(p, "the variant name")?;
        // Variante calificada por módulo `M.Enum.Variante`: el `enum_name` guarda `M.Enum`.
        var enum_name = name;
        if (eat(p, ".")) {
            let real = expect_ident(p, "the variant name after 'M.Enum.'")?;
            enum_name = enum_name + "." + variant;
            variant = real;
        }
        var bindings: [Option<string>] = [];
        if (eat(p, "(")) {
            var keep_going = true;
            while (keep_going) {
                let b = expect_ident(p, "a sub-pattern (name or '_')")?;
                // El tipo declarado de `bv` fija el `Option.None` (no inferible suelto).
                var bv: Option<string> = Option.None;
                if (b != "_") {
                    bv = Option.Some(b);
                }
                bindings.push(bv);
                if (!eat(p, ",")) {
                    keep_going = false;
                }
            }
            expect(p, ")", "')' to close the variant pattern")?;
        }
        return Result.Ok(Pattern { kind: PKind.PVariant(enum_name, variant, bindings), line: t.line, col: t.col });
    }
    Result.Ok(Pattern { kind: PKind.PBind(name), line: t.line, col: t.col })
}

// structLiteral = IDENT '{' [ fieldInit { ',' fieldInit } [ ',' ] ] '}'   ;  fieldInit = IDENT ':' expr
// El '{' lo confirma el llamador (primary/call); aquí lo consumimos.
fn struct_literal(p: Parser, name: string, line: int, col: int) -> Result<Expr, ParseError> {
    expect(p, "{", "'{'")?;
    var fields: [FieldInit] = [];
    var done = false;
    while (!done && !check(p, "}")) {
        let fname = expect_ident(p, "a field name")?;
        expect(p, ":", "':' after the field name")?;
        let value = expression(p)?;
        fields.push(FieldInit { name: fname, value: value });
        if (!eat(p, ",")) {
            done = true;
        }
    }
    expect(p, "}", "'}' to close the struct literal")?;
    Result.Ok(Expr { kind: EKind.EStructLit(name, fields), line: line, col: col })
}

// ----- Auxiliares (puros, sin parseo → no devuelven Result) -----
// Crea un nodo binario heredando la posición del operando izquierdo.
fn make_binary(op: BinOp, left: Expr, right: Expr) -> Expr {
    Expr { kind: EKind.EBinary(op, left, right), line: left.line, col: left.col }
}

// Desazucara `recv |> rhs`: inserta `recv` como PRIMER argumento de la llamada `rhs`. Si `rhs` ya es
// `f(args)` → `f(recv, args)`; si es cualquier otra expresión `f` → `f(recv)`. Posición = la de `rhs`.
fn make_pipeline(recv: Expr, rhs: Expr) -> Expr {
    let line = rhs.line;
    let col = rhs.col;
    match (rhs.kind) {
        EKind.ECall(callee, args) => {
            var new_args: [Expr] = [];
            new_args.push(recv);
            var i = 0;
            while (i < args.len()) {
                new_args.push(args[i]);
                i = i + 1;
            }
            Expr { kind: EKind.ECall(callee, new_args), line: line, col: col }
        },
        _ => Expr { kind: EKind.ECall(rhs, [recv]), line: line, col: col },
    }
}

// ¿Expresión "con bloque" (if/while/{}/match)? Puede usarse como sentencia sin `;`.
fn expr_has_block(e: Expr) -> bool {
    match (e.kind) {
        EKind.EIf(_, _, _) => true,
        EKind.EWhile(_, _) => true,
        EKind.EBlock(_) => true,
        EKind.EMatch(_, _) => true,
        _ => false,
    }
}

// ¿Es un lvalue (asignable)? Un nombre, una indexación o un acceso a campo.
fn is_lvalue(e: Expr) -> bool {
    match (e.kind) {
        EKind.EIdent(_) => true,
        EKind.EIndex(_, _) => true,
        EKind.EField(_, _) => true,
        _ => false,
    }
}

// Punto de entrada: parsea una cinta de tokens (la salida del lexer) a un Program (o un ParseError).
pub fn parse(toks: [Token]) -> Result<Program, ParseError> {
    let p = Parser { toks: toks, pos: 0, next_fn_id: 0 };
    parse_program(p)
}
