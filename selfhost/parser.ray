// El parser de raylang, escrito EN raylang (self-hosting, M14.2).
//
// Segunda fase del bootstrap: tokens (del lexer auto-alojado) → AST. Port del descenso recursivo
// de `src/parser.rs`. Se valida contra el parser de Rust como ORÁCULO (ver `tests/selfhost_parser.rs`)
// mediante un volcado canónico del AST que ambos lados producen idéntico.
//
// M14.2a (esta versión) cubre el NÚCLEO: expresiones (con toda la cadena de precedencia),
// sentencias (let/var, asignación, return, expr) y funciones de nivel superior. Suficiente para
// programas como fib/fizzbuzz. Diferido: structs/enums/match/fn-anónimas (M14.2b); traits/impls/
// genéricos/dyn/Map/`?`/pipelines/anotaciones/imports (M14.2c). Camino feliz: ante una entrada
// inválida hace `panic` (los errores como valores llegan al cerrar el parser, como en el lexer).
//
// El AST se modela con tipos mutuamente recursivos: `struct Expr` lleva un `EKind`, que a su vez
// contiene `Expr`/`Block`. raylang lo soporta porque structs/enums viven en el heap (semántica de
// referencia), así que la recursión no implica tamaño infinito.

from lexer import Token, TokKind;

// =====================================================================
// El AST (espejo del subconjunto de `src/ast.rs` que cubre M14.2a)
// =====================================================================

// Tipos que el programador escribe. Subconjunto de M14.2a: sin genéricos `<...>`, `dyn` ni `Map`.
pub enum Type {
    TInt, TFloat, TBool, TString, TChar, TUnit,
    TArray(Type),        // [T]
    TFn([Type], Type),   // fn(args) -> ret
    TNamed(string),      // un nombre en posición de tipo (struct/enum/param); el checker lo resuelve
}

pub enum UnOp { Neg, Not }

pub enum BinOp {
    Add, Sub, Mul, Div, Rem,
    Eq, Ne, Lt, Le, Gt, Ge,
    And, Or,
}

// Una expresión: su forma (`kind`) y dónde empieza.
pub struct Expr { kind: EKind, line: int, col: int }

pub enum EKind {
    EInt(int),
    EFloat(float),
    EBool(bool),
    EStr(string),
    EChar(char),
    EIdent(string),
    EUnary(UnOp, Expr),
    EBinary(BinOp, Expr, Expr),
    ECall(Expr, [Expr]),       // callee, argumentos
    EIndex(Expr, Expr),        // arreglo, índice
    EField(Expr, string),      // objeto, nombre del campo
    EArray([Expr]),
    EIf(Expr, Block, Option<Expr>),  // cond, then, else (bloque-expr u otro if)
    EWhile(Expr, Block),
    EBlock(Block),
}

// Un parámetro formal `nombre: tipo`.
pub struct Param { name: string, ty: Type, line: int, col: int }

// Un bloque `{ sentencias... [tail] }`. `tail` es la expresión final sin `;` (el valor del bloque).
pub struct Block { stmts: [Stmt], tail: Option<Expr>, line: int, col: int }

pub struct Stmt { kind: SKind, line: int, col: int }

pub enum SKind {
    SLet(string, Option<Type>, Expr, bool),  // nombre, tipo?, valor, mutable (let vs var)
    SAssign(Expr, Expr),                      // destino, valor
    SReturn(Option<Expr>),
    SExpr(Expr),
}

// Una función de nivel superior.
pub struct Func { name: string, params: [Param], ret: Type, body: Block, line: int, col: int }

// Un programa: por ahora (M14.2a) solo funciones.
pub struct Program { funcs: [Func] }

// El estado del parser: la cinta de tokens y el cursor.
struct Parser { toks: [Token], pos: int }

// =====================================================================
// Nombre canónico de un token: única fuente de verdad para check/eat/expect.
// Devuelve la grafía del token (`(`, `->`, `let`) o un nombre simbólico para los que cargan valor
// (`ident`, `int-lit`). Así el parser compara contra strings legibles, sin números mágicos.
// =====================================================================
fn tok_name(k: TokKind) -> string {
    match (k) {
        TokKind.Int(_) => "int-lit",
        TokKind.Float(_) => "float-lit",
        TokKind.Str(_) => "str-lit",
        TokKind.Char(_) => "char-lit",
        TokKind.Ident(_) => "ident",
        TokKind.Let => "let",
        TokKind.Var => "var",
        TokKind.Fn => "fn",
        TokKind.Return => "return",
        TokKind.If => "if",
        TokKind.Else => "else",
        TokKind.While => "while",
        TokKind.True => "true",
        TokKind.False => "false",
        TokKind.Struct => "struct",
        TokKind.Enum => "enum",
        TokKind.Match => "match",
        TokKind.Trait => "trait",
        TokKind.Impl => "impl",
        TokKind.Dyn => "dyn",
        TokKind.Pub => "pub",
        TokKind.Import => "import",
        TokKind.From => "from",
        TokKind.As => "as",
        TokKind.IntType => "int",
        TokKind.FloatType => "float",
        TokKind.BoolType => "bool",
        TokKind.StringType => "string",
        TokKind.CharType => "char",
        TokKind.Plus => "+",
        TokKind.Minus => "-",
        TokKind.Star => "*",
        TokKind.Slash => "/",
        TokKind.Percent => "%",
        TokKind.EqEq => "==",
        TokKind.BangEq => "!=",
        TokKind.Lt => "<",
        TokKind.LtEq => "<=",
        TokKind.Gt => ">",
        TokKind.GtEq => ">=",
        TokKind.AmpAmp => "&&",
        TokKind.PipePipe => "||",
        TokKind.Bang => "!",
        TokKind.Eq => "=",
        TokKind.LParen => "(",
        TokKind.RParen => ")",
        TokKind.LBrace => "{",
        TokKind.RBrace => "}",
        TokKind.LBracket => "[",
        TokKind.RBracket => "]",
        TokKind.Comma => ",",
        TokKind.Semicolon => ";",
        TokKind.Colon => ":",
        TokKind.Dot => ".",
        TokKind.Arrow => "->",
        TokKind.FatArrow => "=>",
        TokKind.Question => "?",
        TokKind.PipeArrow => "|>",
        TokKind.At => "@",
        TokKind.Eof => "eof",
    }
}

// =====================================================================
// Primitivas del cursor de tokens
// =====================================================================

fn cur_kind(p: Parser) -> TokKind { p.toks[p.pos].kind }
fn cur_tok(p: Parser) -> Token { p.toks[p.pos] }
fn at_end(p: Parser) -> bool { tok_name(cur_kind(p)) == "eof" }

// El token actual es exactamente `name` (su grafía canónica).
fn check(p: Parser, name: string) -> bool { tok_name(cur_kind(p)) == name }

// Consume y devuelve el token actual (no avanza más allá de Eof).
fn advance(p: Parser) -> Token {
    let t = p.toks[p.pos];
    if (!at_end(p)) { p.pos = p.pos + 1; }
    t
}

// Si el token actual es `name`, lo consume y devuelve true.
fn eat(p: Parser, name: string) -> bool {
    if (check(p, name)) { advance(p); true } else { false }
}

// Consume el token actual si es `name`; si no, error describiendo qué se esperaba.
fn expect(p: Parser, name: string, what: string) -> Token {
    if (check(p, name)) { advance(p) } else { panic("se esperaba " + what) }
}

// Consume un identificador y devuelve su nombre.
fn expect_ident(p: Parser, what: string) -> string {
    match (cur_kind(p)) {
        TokKind.Ident(n) => { advance(p); n },
        _ => panic("se esperaba " + what),
    }
}

// =====================================================================
// Reglas de la gramática
// =====================================================================

// program = { function }   (M14.2a: solo funciones)
fn parse_program(p: Parser) -> Program {
    var funcs: [Func] = [];
    while (!at_end(p)) {
        push(funcs, function(p));
    }
    Program { funcs: funcs }
}

// function = 'fn' IDENT '(' [ params ] ')' [ '->' type ] block
fn function(p: Parser) -> Func {
    let kw = expect(p, "fn", "'fn'");
    let name = expect_ident(p, "el nombre de la función");
    expect(p, "(", "'(' tras el nombre de la función");
    var params: [Param] = [];
    if (!check(p, ")")) { params = parse_params(p); }
    expect(p, ")", "')'");
    var ret = Type.TUnit;
    if (eat(p, "->")) { ret = parse_type(p); }
    let body = block(p);
    Func { name: name, params: params, ret: ret, body: body, line: kw.line, col: kw.col }
}

// params = param { ',' param } ;  param = IDENT ':' type
fn parse_params(p: Parser) -> [Param] {
    var params: [Param] = [];
    var seguir = true;
    while (seguir) {
        let t = cur_tok(p);
        let name = expect_ident(p, "el nombre de un parámetro");
        expect(p, ":", "':' tras el nombre del parámetro");
        let ty = parse_type(p);
        push(params, Param { name: name, ty: ty, line: t.line, col: t.col });
        if (!eat(p, ",")) { seguir = false; }
    }
    params
}

// type = 'int' | 'float' | 'bool' | 'string' | 'char' | '[' type ']'
//      | 'fn' '(' [ type { ',' type } ] ')' [ '->' type ]
//      | IDENT   (struct/enum/param; sin args de tipo en M14.2a)
fn parse_type(p: Parser) -> Type {
    if (check(p, "[")) {
        advance(p);
        let elem = parse_type(p);
        expect(p, "]", "']' para cerrar el tipo de arreglo");
        return Type.TArray(elem);
    }
    if (check(p, "fn")) {
        advance(p);
        expect(p, "(", "'(' tras 'fn' en un tipo función");
        var ps: [Type] = [];
        if (!check(p, ")")) {
            var seguir = true;
            while (seguir) {
                push(ps, parse_type(p));
                if (!eat(p, ",")) { seguir = false; }
            }
        }
        expect(p, ")", "')' para cerrar el tipo función");
        var r = Type.TUnit;
        if (eat(p, "->")) { r = parse_type(p); }
        return Type.TFn(ps, r);
    }
    // Nombre de struct/enum/parámetro de tipo.
    match (cur_kind(p)) {
        TokKind.Ident(name) => { advance(p); return Type.TNamed(name); },
        _ => {},
    }
    // Tipos primitivos.
    if (eat(p, "int")) { Type.TInt }
    else if (eat(p, "float")) { Type.TFloat }
    else if (eat(p, "bool")) { Type.TBool }
    else if (eat(p, "string")) { Type.TString }
    else if (eat(p, "char")) { Type.TChar }
    else { panic("se esperaba un tipo (int, float, bool, string, char, [T] o un struct)") }
}

// block = '{' { statement } [ expression ] '}'
//
// La expresión final sin `;` es el `tail` (valor del bloque, DESIGN §6); lo demás son sentencias.
fn block(p: Parser) -> Block {
    let open = expect(p, "{", "'{'");
    var stmts: [Stmt] = [];
    var tail: Option<Expr> = Option.None;
    var done = false;
    while (!done && !check(p, "}") && !at_end(p)) {
        if (check(p, "let") || check(p, "var")) {
            push(stmts, let_stmt(p));
        } else if (check(p, "return")) {
            push(stmts, return_stmt(p));
        } else {
            let e = expression(p);
            let line = e.line;
            let col = e.col;
            if (eat(p, "=")) {
                if (!is_lvalue(e)) { panic("el lado izquierdo de '=' no es asignable"); }
                let value = expression(p);
                expect(p, ";", "';' al final de la asignación");
                push(stmts, Stmt { kind: SKind.SAssign(e, value), line: line, col: col });
            } else if (eat(p, ";")) {
                push(stmts, Stmt { kind: SKind.SExpr(e), line: line, col: col });
            } else if (check(p, "}")) {
                tail = Option.Some(e);
                done = true;
            } else if (expr_has_block(e)) {
                // Expresión-con-bloque usada como sentencia: no necesita `;` (DESIGN §6).
                push(stmts, Stmt { kind: SKind.SExpr(e), line: line, col: col });
            } else {
                panic("se esperaba ';' después de la expresión");
            }
        }
    }
    expect(p, "}", "'}' para cerrar el bloque");
    Block { stmts: stmts, tail: tail, line: open.line, col: open.col }
}

// letDecl = ('let' | 'var') IDENT [ ':' type ] '=' expression ';'
fn let_stmt(p: Parser) -> Stmt {
    let kw = advance(p); // 'let' o 'var'
    let mutable = tok_name(kw.kind) == "var";
    let name = expect_ident(p, "el nombre de la variable");
    var ty: Option<Type> = Option.None;
    if (eat(p, ":")) { ty = Option.Some(parse_type(p)); }
    expect(p, "=", "'=' en la declaración");
    let value = expression(p);
    expect(p, ";", "';' al final de la declaración");
    Stmt { kind: SKind.SLet(name, ty, value, mutable), line: kw.line, col: kw.col }
}

// returnStmt = 'return' [ expression ] ';'
fn return_stmt(p: Parser) -> Stmt {
    let kw = advance(p); // 'return'
    var value: Option<Expr> = Option.None;
    if (!check(p, ";")) { value = Option.Some(expression(p)); }
    expect(p, ";", "';' al final del return");
    Stmt { kind: SKind.SReturn(value), line: kw.line, col: kw.col }
}

// ----- Expresiones, por precedencia (de menor a mayor) -----
// (pipeline `|>` se difiere a M14.2c; expression arranca en logic_or.)

fn expression(p: Parser) -> Expr { logic_or(p) }

// logic_or = logic_and { '||' logic_and }
fn logic_or(p: Parser) -> Expr {
    var left = logic_and(p);
    while (check(p, "||")) {
        advance(p);
        let right = logic_and(p);
        left = make_binary(BinOp.Or, left, right);
    }
    left
}

// logic_and = equality { '&&' equality }
fn logic_and(p: Parser) -> Expr {
    var left = equality(p);
    while (check(p, "&&")) {
        advance(p);
        let right = equality(p);
        left = make_binary(BinOp.And, left, right);
    }
    left
}

// equality = comparison { ('==' | '!=') comparison }
fn equality(p: Parser) -> Expr {
    var left = comparison(p);
    var seguir = true;
    while (seguir) {
        if (check(p, "==")) { advance(p); left = make_binary(BinOp.Eq, left, comparison(p)); }
        else if (check(p, "!=")) { advance(p); left = make_binary(BinOp.Ne, left, comparison(p)); }
        else { seguir = false; }
    }
    left
}

// comparison = term { ('<' | '<=' | '>' | '>=') term }
fn comparison(p: Parser) -> Expr {
    var left = term(p);
    var seguir = true;
    while (seguir) {
        if (check(p, "<")) { advance(p); left = make_binary(BinOp.Lt, left, term(p)); }
        else if (check(p, "<=")) { advance(p); left = make_binary(BinOp.Le, left, term(p)); }
        else if (check(p, ">")) { advance(p); left = make_binary(BinOp.Gt, left, term(p)); }
        else if (check(p, ">=")) { advance(p); left = make_binary(BinOp.Ge, left, term(p)); }
        else { seguir = false; }
    }
    left
}

// term = factor { ('+' | '-') factor }
fn term(p: Parser) -> Expr {
    var left = factor(p);
    var seguir = true;
    while (seguir) {
        if (check(p, "+")) { advance(p); left = make_binary(BinOp.Add, left, factor(p)); }
        else if (check(p, "-")) { advance(p); left = make_binary(BinOp.Sub, left, factor(p)); }
        else { seguir = false; }
    }
    left
}

// factor = unary { ('*' | '/' | '%') unary }
fn factor(p: Parser) -> Expr {
    var left = unary(p);
    var seguir = true;
    while (seguir) {
        if (check(p, "*")) { advance(p); left = make_binary(BinOp.Mul, left, unary(p)); }
        else if (check(p, "/")) { advance(p); left = make_binary(BinOp.Div, left, unary(p)); }
        else if (check(p, "%")) { advance(p); left = make_binary(BinOp.Rem, left, unary(p)); }
        else { seguir = false; }
    }
    left
}

// unary = ('!' | '-') unary | call
fn unary(p: Parser) -> Expr {
    let t = cur_tok(p);
    if (check(p, "!")) {
        advance(p);
        let e = unary(p);
        Expr { kind: EKind.EUnary(UnOp.Not, e), line: t.line, col: t.col }
    } else if (check(p, "-")) {
        advance(p);
        let e = unary(p);
        Expr { kind: EKind.EUnary(UnOp.Neg, e), line: t.line, col: t.col }
    } else {
        call(p)
    }
}

// call = primary { '(' [ args ] ')' | '[' expression ']' | '.' IDENT }
fn call(p: Parser) -> Expr {
    var expr = primary(p);
    var seguir = true;
    while (seguir) {
        let line = expr.line;
        let col = expr.col;
        if (check(p, "(")) {
            advance(p);
            var cargs: [Expr] = [];
            if (!check(p, ")")) { cargs = parse_args(p); }
            expect(p, ")", "')' para cerrar la llamada");
            expr = Expr { kind: EKind.ECall(expr, cargs), line: line, col: col };
        } else if (check(p, "[")) {
            advance(p);
            let idx = expression(p);
            expect(p, "]", "']' para cerrar la indexación");
            expr = Expr { kind: EKind.EIndex(expr, idx), line: line, col: col };
        } else if (check(p, ".")) {
            advance(p);
            let nm = expect_ident(p, "el nombre del campo tras '.'");
            expr = Expr { kind: EKind.EField(expr, nm), line: line, col: col };
        } else {
            seguir = false;
        }
    }
    expr
}

// args = expression { ',' expression }
fn parse_args(p: Parser) -> [Expr] {
    var a: [Expr] = [];
    var seguir = true;
    while (seguir) {
        push(a, expression(p));
        if (!eat(p, ",")) { seguir = false; }
    }
    a
}

// primary = literal | IDENT | '(' expression ')' | ifExpr | whileExpr | block | arrayLiteral
fn primary(p: Parser) -> Expr {
    if (check(p, "if")) { return if_expr(p); }
    if (check(p, "while")) { return while_expr(p); }
    if (check(p, "{")) {
        let b = block(p);
        return Expr { kind: EKind.EBlock(b), line: b.line, col: b.col };
    }
    if (check(p, "[")) { return array_literal(p); }
    // (fn-expr y match → M14.2b; literal de struct → M14.2b)
    let t = cur_tok(p);
    match (t.kind) {
        TokKind.Int(v) => { advance(p); Expr { kind: EKind.EInt(v), line: t.line, col: t.col } },
        TokKind.Float(v) => { advance(p); Expr { kind: EKind.EFloat(v), line: t.line, col: t.col } },
        TokKind.Str(s) => { advance(p); Expr { kind: EKind.EStr(s), line: t.line, col: t.col } },
        TokKind.Char(c) => { advance(p); Expr { kind: EKind.EChar(c), line: t.line, col: t.col } },
        TokKind.True => { advance(p); Expr { kind: EKind.EBool(true), line: t.line, col: t.col } },
        TokKind.False => { advance(p); Expr { kind: EKind.EBool(false), line: t.line, col: t.col } },
        TokKind.Ident(name) => { advance(p); Expr { kind: EKind.EIdent(name), line: t.line, col: t.col } },
        TokKind.LParen => {
            advance(p);
            let inner = expression(p);
            expect(p, ")", "')' para cerrar el paréntesis");
            // El paréntesis no deja nodo; conserva su posición (la del '(').
            Expr { kind: inner.kind, line: t.line, col: t.col }
        },
        _ => panic("se esperaba una expresión"),
    }
}

// ifExpr = 'if' '(' expression ')' block [ 'else' ( block | ifExpr ) ]
fn if_expr(p: Parser) -> Expr {
    let kw = expect(p, "if", "'if'");
    expect(p, "(", "'(' tras 'if'");
    let cond = expression(p);
    expect(p, ")", "')' tras la condición");
    let then_b = block(p);
    var else_b: Option<Expr> = Option.None;
    if (eat(p, "else")) {
        if (check(p, "if")) {
            else_b = Option.Some(if_expr(p));
        } else {
            let b = block(p);
            else_b = Option.Some(Expr { kind: EKind.EBlock(b), line: b.line, col: b.col });
        }
    }
    Expr { kind: EKind.EIf(cond, then_b, else_b), line: kw.line, col: kw.col }
}

// whileExpr = 'while' '(' expression ')' block
fn while_expr(p: Parser) -> Expr {
    let kw = expect(p, "while", "'while'");
    expect(p, "(", "'(' tras 'while'");
    let cond = expression(p);
    expect(p, ")", "')' tras la condición");
    let body = block(p);
    Expr { kind: EKind.EWhile(cond, body), line: kw.line, col: kw.col }
}

// arrayLiteral = '[' [ expression { ',' expression } [ ',' ] ] ']'
fn array_literal(p: Parser) -> Expr {
    let open = expect(p, "[", "'['");
    var elems: [Expr] = [];
    if (!check(p, "]")) {
        var seguir = true;
        while (seguir) {
            push(elems, expression(p));
            if (!eat(p, ",")) { seguir = false; }
            else if (check(p, "]")) { seguir = false; } // coma final permitida
        }
    }
    expect(p, "]", "']' para cerrar el arreglo");
    Expr { kind: EKind.EArray(elems), line: open.line, col: open.col }
}

// ----- Auxiliares -----

// Crea un nodo binario heredando la posición del operando izquierdo.
fn make_binary(op: BinOp, left: Expr, right: Expr) -> Expr {
    Expr { kind: EKind.EBinary(op, left, right), line: left.line, col: left.col }
}

// ¿Expresión "con bloque" (if/while/{})? Puede usarse como sentencia sin `;`.
fn expr_has_block(e: Expr) -> bool {
    match (e.kind) {
        EKind.EIf(_, _, _) => true,
        EKind.EWhile(_, _) => true,
        EKind.EBlock(_) => true,
        _ => false,
    }
}

// ¿Es un lvalue (asignable)? Un nombre, una indexación o un acceso a campo.
fn is_lvalue(e: Expr) -> bool {
    match (e.kind) {
        EKind.EIdent(_) => true,
        EKind.EIndex(_, _) => true,
        EKind.EField(_, _) => true,
        _ => false,
    }
}

// Punto de entrada: parsea una cinta de tokens (la salida del lexer) a un Program.
pub fn parse(toks: [Token]) -> Program {
    let p = Parser { toks: toks, pos: 0 };
    parse_program(p)
}
