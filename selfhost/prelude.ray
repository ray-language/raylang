// El prelude de orden superior de raylang, escrito EN raylang (self-hosting, M14.4d-2).
//
// Port de la parte de `src/prelude.rs` que define `map`/`filter`/`fold`: la stdlib de orden superior
// NO está incrustada en el compilador, vive aquí escrita en el propio raylang (con genéricos M6,
// closures M4 y los builtins `len`/`push`). El driver `selfhost/run.ray` parsea este archivo y FUSIONA
// sus funciones en el programa del usuario antes de chequear/ejecutar — igual que el `check()` de Rust
// inyecta el prelude parseado en el `Program`. Así, también en el mundo auto-alojado, map/filter/fold
// son raylang, no magia del intérprete.
//
// (Option/Result, Eq/Show/Ord y los impls de primitivos los conoce el checker auto-alojado por inyección
// directa, y el intérprete reconoce Option/Result + deriva igual/mostrar; por eso no van aquí.)
fn map<T, U>(xs: [T], f: fn(T) -> U) -> [U] {
    var out: [U] = [];
    var i: int = 0;
    while (i < xs.len()) {
        out.push(f(xs[i]));
        i = i + 1;
    }
    out
}

fn filter<T>(xs: [T], pred: fn(T) -> bool) -> [T] {
    var out: [T] = [];
    var i: int = 0;
    while (i < xs.len()) {
        let x: T = xs[i];
        if (pred(x)) {
            out.push(x);
        }
        i = i + 1;
    }
    out
}

fn fold<T, A>(xs: [T], init: A, f: fn(A, T) -> A) -> A {
    var acc: A = init;
    var i: int = 0;
    while (i < xs.len()) {
        acc = f(acc, xs[i]);
        i = i + 1;
    }
    acc
}

// M14.6c: envoltorios sobre los primitivos `__parse_int`/`__parse_float` (que devuelven [T] vacío/único),
// traducidos a Option con Some/None corrientes — el runtime no sabe de Option (patrón de la stdlib).
fn parse_int(s: string) -> Option<int> {
    let r = __parse_int(s);
    if (r.len() == 0) { Option.None } else { Option.Some(r[0]) }
}

fn parse_float(s: string) -> Option<float> {
    let r = __parse_float(s);
    if (r.len() == 0) { Option.None } else { Option.Some(r[0]) }
}

// M14.6c-2: aserciones y orden. Construidas sobre `panic` + los traits Eq/Show/Ord (que el checker
// conoce por inyección y el intérprete resuelve por etiqueta de valor). Port de `src/prelude.rs`.
fn assert(cond: bool) {
    if (!cond) {
        panic("assertion failed");
    }
}

fn assert_eq<T: Eq + Show>(a: T, b: T) {
    if (!a.eq(b)) {
        panic("assert_eq failed: " + a.show() + " != " + b.show());
    }
}

// Ordena ascendente devolviendo un arreglo NUEVO (insertion sort). `T: Ord` → `.less()`.
fn sort<T: Ord>(a: [T]) -> [T] {
    var out: [T] = [];
    var i: int = 0;
    while (i < a.len()) {
        let x: T = a[i];
        out.push(x);
        var j: int = out.len() - 1;
        while (j > 0 && x.less(out[j - 1])) {
            out[j] = out[j - 1];
            j = j - 1;
        }
        out[j] = x;
        i = i + 1;
    }
    out
}

// M215 (ray-sublime #18): orden por COMPARADOR y por CLAVE, para el caso general que `sort` (un
// único orden natural por `Ord`) no cubre: ordenar por otro campo, o un tipo que no es tuyo.
// Mismo merge estable que `sort`; `less(a, b)` dice si `a` va antes que `b`.
/// Sorts `a` ascending by the comparator `less(a, b)` ("a goes before b"), returning a NEW array;
/// stable (equal elements keep their order). `sort_by(xs, fn(a: int, b: int) -> bool { a > b })`
/// sorts descending.
fn sort_by<T>(xs: [T], less: fn(T, T) -> bool) -> [T] {
    var src: [T] = [];
    var i: int = 0;
    while (i < xs.len()) {
        src.push(xs[i]);
        i = i + 1;
    }
    let n = src.len();
    var width = 1;
    while (width < n) {
        var dst: [T] = [];
        var lo = 0;
        while (lo < n) {
            var mid = lo + width;
            if (mid > n) {
                mid = n;
            }
            var hi = lo + 2 * width;
            if (hi > n) {
                hi = n;
            }
            var p = lo;
            var q = mid;
            while (p < mid || q < hi) {
                if (p >= mid) {
                    dst.push(src[q]);
                    q = q + 1;
                } else if (q >= hi) {
                    dst.push(src[p]);
                    p = p + 1;
                } else if (less(src[q], src[p])) {
                    dst.push(src[q]);
                    q = q + 1;
                } else {
                    dst.push(src[p]);
                    p = p + 1;
                }
            }
            lo = lo + 2 * width;
        }
        src = dst;
        width = width * 2;
    }
    src
}

/// Sorts `a` ascending by the key `key(x)` (`K: Ord` — int, string, float, char, bool, bytes or a
/// type with `impl Ord`), returning a NEW array; stable. `sort_by_key(people, fn(p: Person) -> int { p.age })`.
fn sort_by_key<T, K: Ord>(xs: [T], key: fn(T) -> K) -> [T] {
    sort_by(xs, fn(x: T, y: T) -> bool { key(x).less(key(y)) })
}

// M14.6d: I/O de archivos. Envoltorios sobre los primitivos `__read_file`/`__write_file` (que devuelven
// un arreglo etiquetado ["ok",…]/["err",msg]) traducidos a Result — el runtime no sabe de Result, como
// en Rust (`src/prelude.rs`). `exists` es un builtin directo (-> bool), no necesita envoltorio.
fn read_file(path: string) -> Result<string, string> {
    let r = __read_file(path);
    if (r[0] == "ok") { Result.Ok(r[1]) } else { Result.Err(r[1]) }
}

fn write_file(path: string, content: string) -> Result<int, string> {
    let r = __write_file(path, content);
    if (r[0] == "ok") { Result.Ok(content.len()) } else { Result.Err(r[1]) }
}

// M14.7c: quita y devuelve el último elemento (None si vacío); muta `a`. Envoltorio sobre `__pop`.
fn pop<T>(a: [T]) -> Option<T> {
    let r = __pop(a);
    if (r.len() == 0) { Option.None } else { Option.Some(r[0]) }
}
