// Driver del back-end auto-alojado (M14.4): lee un archivo (su ruta es el primer argumento), lo
// lexea + parsea + chequea + EJECUTA con el compilador EN raylang de punta a punta.
//
// El código de salida es el `int` que devuelve el `main` del programa (0 si es unit) — igual que el
// runner de Rust (`raylang prog.ray`). Las salidas de `print` van a stdout; los errores (léxico/
// sintáctico/tipos/ejecución) a stderr.
//
// El test `tests/selfhost_interpreter.rs` compara, para cada `.ray`, el stdout + el código de salida de
// este driver contra los del runner de Rust (el ORÁCULO conductual; ver DESIGN §23.5).
from loader import load, LoadError;
from parser import Func, Program;
from checker import check, TypeError;
from interpreter import run, Value, RuntimeError;

// El código de salida a partir del valor de `main`: el entero si es int, 0 en otro caso (como Rust).
fn exit_code(v: Value) -> int {
    match (v) {
        Value.VInt(n) => n,
        _ => 0,
    }
}

// ¿El programa del usuario ya define una función con ese nombre? (para no pisar un override del prelude).
fn user_has_func(user: Program, name: string) -> bool {
    var i = 0;
    while (i < user.funcs.len()) {
        if (user.funcs[i].name == name) {
            return true;
        }
        i = i + 1;
    }
    false
}

// Fusiona las funciones del prelude (map/filter/fold) en el programa del usuario —las que no redefina—,
// igual que el `check()` de Rust inyecta el prelude parseado. No hay colisión de posiciones que importe:
// el validador no baja por posición y el intérprete despacha por etiqueta de valor, no por `(línea,col)`.
fn add_prelude(prelude: Program, user: Program) {
    var extra: [Func] = [];
    var i = 0;
    while (i < prelude.funcs.len()) {
        if (!user_has_func(user, prelude.funcs[i].name)) {
            extra.push(prelude.funcs[i]);
        }
        i = i + 1;
    }
    user.funcs = extra + user.funcs;
}

// Carga el prelude (`selfhost/prelude.ray`, relativo a la raíz del repo) vía el loader. Es un archivo
// NUESTRO sin imports → el loader lo devuelve tal cual; si falla es un bug, así que aborta con `panic`.
fn load_prelude() -> Program {
    match (load("selfhost/prelude.ray")) {
        Result.Ok(p) => p,
        Result.Err(e) => panic("could not load selfhost/prelude.ray: " + e.msg),
    }
}

// Los argumentos del PROGRAMA ejecutado: lo que sigue al path que consumió este driver (argv[1..]).
// Enhebrarlos al intérprete vuelve `args()` consistente entre los dos pipelines (M14.7c): bajo Rust el
// programa se corre con `raylang <archivo> [args...]` → `args()` = [args...]; aquí el driver consume
// `argv[0]` y pasa el resto, así el programa ve sus PROPIOS args, no el path del driver.
fn rest_args(argv: [string]) -> [string] {
    var out: [string] = [];
    var i = 1;
    while (i < argv.len()) {
        out.push(argv[i]);
        i = i + 1;
    }
    out
}

fn main() -> int {
    let argv = args();
    if (argv.len() == 0) {
        eprint("use: raylang selfhost/run.ray <file> [args...]");
        return 1;
    }
    // M14.7: el loader aplana el programa (entrada + sus `import`/`from` transitivos) en un Program plano.
    match (load(argv[0])) {
        Result.Ok(prog) => {
            add_prelude(load_prelude(), prog);  // fusiona map/filter/fold/... del prelude
            match (check(prog)) {
                Result.Ok(_) => {
                    match (run(prog, rest_args(argv))) {
                        Result.Ok(v) => exit_code(v),
                        Result.Err(re) => {
                            eprint("runtime error at " + to_string(re.line) + ":" + to_string(re.col) + ": " + re.msg);
                            70
                        },
                    }
                },
                Result.Err(te) => {
                    eprint("type error at " + to_string(te.line) + ":" + to_string(te.col) + ": " + te.msg);
                    65
                },
            }
        },
        Result.Err(le) => {
            eprint("[" + le.module + "] load error at " + to_string(le.line) + ":" + to_string(le.col) + ": " + le.msg);
            65
        },
    }
}
