// Driver del back-end de VM auto-alojado (M14.5): lexea + parsea + chequea + COMPILA a bytecode +
// EJECUTA en la VM (`vm.ray`), de punta a punta con el compilador en raylang. Es el gemelo de
// `run.ray` (que usa el intérprete tree-walking), para el otro motor.
//
// El test `tests/selfhost_vm.rs` compara, por cada `.ray`, el stdout + el código de salida de este
// driver contra los del runner de Rust (el ORÁCULO conductual; ver DESIGN §23.6).
from loader import load, LoadError;
from parser import Func, Program;
from checker import check, TypeError;
from compiler import compile, CProgram;
from interpreter import Value, RuntimeError;
from vm import run_vm;

fn exit_code(v: Value) -> int {
    match (v) {
        Value.VInt(n) => n,
        _ => 0,
    }
}

// ¿El programa del usuario ya define una función con ese nombre? (para no pisar un override del prelude).
fn user_has_func(user: Program, name: string) -> bool {
    var i = 0;
    while (i < len(user.funcs)) {
        if (user.funcs[i].name == name) {
            return true;
        }
        i = i + 1;
    }
    false
}

// Fusiona las funciones del prelude (map/filter/fold/sort/assert/...) en el programa del usuario —las que no
// redefina—, igual que en `run.ray` (M14.4d-2). Desde M14.5d la VM compila el prelude COMPLETO: map/filter/
// fold usan llamadas indirectas (M14.5c) y sort/assert_eq usan métodos (`.menor()`/`.igual()`/`.mostrar()`),
// resueltos por `ODispatch`.
fn add_prelude(prelude: Program, user: Program) {
    var extra: [Func] = [];
    var i = 0;
    while (i < len(prelude.funcs)) {
        if (!user_has_func(user, prelude.funcs[i].name)) {
            push(extra, prelude.funcs[i]);
        }
        i = i + 1;
    }
    user.funcs = extra + user.funcs;
}

fn load_prelude() -> Program {
    match (load("selfhost/prelude.ray")) {
        Result.Ok(p) => p,
        Result.Err(e) => panic("no se pudo cargar selfhost/prelude.ray: " + e.msg),
    }
}

// Los argumentos del programa ejecutado: lo que sigue al path que consumió este driver (argv[1..]).
fn rest_args(argv: [string]) -> [string] {
    var out: [string] = [];
    var i = 1;
    while (i < len(argv)) {
        push(out, argv[i]);
        i = i + 1;
    }
    out
}

fn main() -> int {
    let argv = args();
    if (len(argv) == 0) {
        eprint("uso: raylang selfhost/run_vm.ray <archivo> [args...]");
        return 1;
    }
    match (load(argv[0])) {
        Result.Ok(prog) => {
            add_prelude(load_prelude(), prog);  // fusiona map/filter/fold/sort/... del prelude
            match (check(prog)) {
                Result.Ok(_) => {
                    let cp = compile(prog);
                    match (run_vm(cp, rest_args(argv))) {
                        Result.Ok(v) => exit_code(v),
                        Result.Err(re) => {
                            eprint("error en ejecución en " + to_string(re.line) + ":" + to_string(re.col) + ": " + re.msg);
                            70
                        },
                    }
                },
                Result.Err(te) => {
                    eprint("error de tipos en " + to_string(te.line) + ":" + to_string(te.col) + ": " + te.msg);
                    65
                },
            }
        },
        Result.Err(le) => {
            eprint("[" + le.module + "] error de carga en " + to_string(le.line) + ":" + to_string(le.col) + ": " + le.msg);
            65
        },
    }
}
