//! System alarms (M448, IDEAS §122): an alarm that rings in a loop, with the alarm volume, until
//! the user answers — with the screen locked and with the app CLOSED. It is not a notification
//! with another sound: Android arms it with `AlarmManager.setAlarmClock` (exact, shown in the
//! status bar) and, when it fires, the shell of `ray bundle --android` starts a foreground
//! service that plays the sound and shows a full-screen alarm over the lock screen with "Stop"
//! and, if asked, "Snooze"; alarms survive a reboot (re-armed at the first unlock; one whose
//! time passed meanwhile is reported as `"missed"`) and a daily or weekly one follows a
//! time-zone change. The answer comes back as an `"alarm"`
//! event on the `std/ui` queue (`event_response`), queued for the next launch when the app was
//! closed. iOS: not yet (AlarmKit, iOS 26, comes in a later release) — `status()` is
//! `"unsupported"` and `schedule` is `Err`; `std/notify` with `sound_name` rings once. Desktop:
//! `"unsupported"`. Headless: `Ok` + trace (`RAY_UI_TRACE=1`), an in-memory pending list,
//! `RAY_UI_ALARM_PERMISSION=denied|not_determined|unsupported` and `RAY_UI_ALARM_RESPONSE=stop|snooze`
//! (answers every alarm as it is scheduled; tests).
//!
//! The Android shell declares the alarm permissions (`USE_EXACT_ALARM`, `USE_FULL_SCREEN_INTENT`,
//! a media-playback foreground service) only when the program imports this module: Google Play
//! reserves them for alarm and calendar apps.

from std/ui import UiEvent;

/// An alarm. `message(title)` builds one with the defaults; set the rest by field. `id` names
/// it (empty = generated; scheduling another with the same id replaces it); `title` is what the
/// alarm screen shows; `sound` is a file listed in `[android] sounds` / `[ios] sounds` of
/// `ray.toml`, without extension (empty = the system alarm tone); `snooze_minutes` > 0 adds a
/// "Snooze" button that rings again after that many minutes (0 = none, 120 at most);
/// `stop_label` and `snooze_label` are the texts of the buttons (empty = "Stop" / "Snooze");
/// `data` comes back in the response; `max_minutes` silences an unanswered alarm (0 = the
/// shell's cap, 60 minutes) and reports it as a `"timeout"` response.
pub struct Alarm {
    id: string,
    title: string,
    sound: string,
    snooze_minutes: int,
    stop_label: string,
    snooze_label: string,
    data: string,
    max_minutes: int,
}

/// When an alarm rings. `At(unix_seconds)` (once), `Daily(hour, minute)` (local time, every
/// day) and `Weekly(days, hour, minute)` with ISO weekdays: 1 = Monday … 7 = Sunday.
pub enum Trigger {
    At(int),
    Daily(int, int),
    Weekly([int], int, int),
}

/// The user's answer to an alarm: `action` is `"stop"`, `"snooze"`, `"timeout"` (nobody
/// answered in `max_minutes`, or another alarm took over while it rang) or `"missed"` (its time
/// passed while the phone was off: it did not ring), and `"open"` on a system that offers it;
/// `data` is the alarm's `data`.
pub struct Response {
    id: string,
    action: string,
    data: string,
}

/// An alarm with the defaults: generated id, the system alarm tone, no snooze, "Stop".
pub fn message(title: string) -> Alarm {
    Alarm {
        id: "",
        title: title,
        sound: "",
        snooze_minutes: 0,
        stop_label: "",
        snooze_label: "",
        data: "",
        max_minutes: 0
    }
}

fn sep() -> string {
    "\u{1f}"
}

fn tunnel(op: string, arg: string) -> Result<string, string> {
    let r = __ui_window(0, op, arg);
    let text = if (r.len() > 1) { r[1] } else { "" };
    if (r[0] == "ok") { Result.Ok(text) } else { Result.Err(text) }
}

fn ok_unit(r: Result<string, string>) -> Result<int, string> {
    match (r) {
        Result.Ok(_) => Result.Ok(0),
        Result.Err(e) => Result.Err(e),
    }
}

fn trigger_text(t: Trigger) -> string {
    match (t) {
        Trigger.At(unix) => "at:" + to_string(unix),
        Trigger.Daily(h, m) => "daily:" + to_string(h) + ":" + to_string(m),
        Trigger.Weekly(days, h, m) => {
            let parts = days.map(fn(d: int) -> string { to_string(d) });
            "weekly:" + parts.join(",") + ":" + to_string(h) + ":" + to_string(m)
        },
    }
}

/// Asks for what an alarm needs (on Android 13+ the notifications dialog) and WAITS for the
/// answer: `"granted"` or `"denied"`. `Err` where there are no system alarms.
pub fn request_permission() -> Result<string, string> {
    tunnel("alarm_permission", "")
}

/// Whether alarms can ring, without asking: `"granted"`, `"denied"`, `"not_determined"` or
/// `"unsupported"` (iOS for now, the desktop, an Android shell bundled without `std/alarm`).
pub fn status() -> Result<string, string> {
    tunnel("alarm_status", "")
}

/// Arms `a` for `when` and returns its id. `Err` with the reason: no title, a time in the past,
/// a weekday out of 1–7, permission denied, or a platform without system alarms.
pub fn schedule(a: Alarm, when: Trigger) -> Result<string, string> {
    tunnel(
        "alarm_schedule",
        trigger_text(when)
            + sep()
            + a.id
            + sep()
            + a.title
            + sep()
            + a.sound
            + sep()
            + to_string(a.snooze_minutes)
            + sep()
            + a.stop_label
            + sep()
            + a.data
            + sep()
            + to_string(a.max_minutes)
            + sep()
            + a.snooze_label
    )
}

/// Disarms the alarm `id` (and silences it if it is ringing). `Ok` when there is none.
pub fn cancel(id: string) -> Result<int, string> {
    ok_unit(tunnel("alarm_cancel", id))
}

/// Disarms every alarm of the app.
pub fn cancel_all() -> Result<int, string> {
    ok_unit(tunnel("alarm_cancel_all", ""))
}

/// The ids of the armed alarms.
pub fn pending() -> Result<[string], string> {
    match (tunnel("alarm_pending", "")) {
        Result.Ok(text) => Result.Ok(text.split("\n").filter(fn(s: string) -> bool { s.len() > 0 })),
        Result.Err(e) => Result.Err(e),
    }
}

/// The answer carried by an `"alarm"` event of `ui.next_event` (`None` for any other event).
/// When the alarm rang with the app closed, the event is waiting in the queue at the next launch.
pub fn event_response(e: UiEvent) -> Option<Response> {
    if (e.kind != "alarm") {
        return Option.None;
    }
    let f = e.tag.split("\t");
    let at = fn(i: int) -> string {
        if (i < f.len()) { f[i] } else { "" }
    };
    // `data` is everything after the second tab: it may carry tabs of its own.
    let data = if (f.len() > 2) { f.slice(2, f.len()).join("\t") } else { "" };
    Option.Some(Response { id: at(0), action: at(1), data: data })
}
