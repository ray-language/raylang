// std/audio (M145) — salida de audio PCM: el análogo de term.* para sonido (IDEAS §79).
//
// Sobre los primitivos __audio_* del runtime: un pipe del SO + hilo alimentador hacia el
// dispositivo (AudioQueue en macOS, ALSA por dlopen en Linux; RAY_AUDIO_SINK=null = sumidero de
// tiempo real para tests/CI). La CONTRAPRESIÓN es el diseño: `write` aparca la fibra cuando el
// dispositivo va lleno — el pacing del programa sale del consumo real, sin relojes. Formato por
// defecto: PCM s16le entrelazado (little-endian, 2 octetos por muestra por canal); M398 (IDEAS
// §111, rayplay #167) añade s24le/s32le/f32le vía `open_format`, y `flush` (rayplay #166).

/// Opens a PCM output on the default device: `sample_rate` Hz (8000–192000), `channels`
/// channels (1–8), s16le interleaved samples. Returns the output handle. With
/// `RAY_AUDIO_SINK=null` in the environment, a real-time null sink plays silently (tests, CI).
pub fn open(sample_rate: int, channels: int) -> Result<int, string> {
    let r = __audio_open(sample_rate, channels, 0, "s16le");
    if (r[0] == "ok") {
        match (parse_int(r[1])) {
            Option.Some(h) => Result.Ok(h),
            Option.None => Result.Err("invalid handle"),
        }
    } else {
        Result.Err(r[1])
    }
}

/// Like `open`, with a LATENCY HINT (M158): `latency_ms` sizes the ring/device buffers and
/// the feeder chunk — a rhythm game wants 20-50 ms, a radio tolerates 200-1000. Accepted
/// range: 3–1000 (or 0 = the default); anything else is `Err`. The hint is the TOTAL queued
/// between `write` and the speaker (`write` parks once ~that much is pending). From 20 ms up,
/// macOS queues ~85 ms at least on a device with a 10.7 ms I/O cycle (a 20 ms socket, three
/// queue buffers never smaller than one cycle of the device, and a ring that keeps the
/// anti-click ramp plus three buffers) and follows the hint from about 130 ms. **Below
/// 20 ms is LOW LATENCY** (M469): on macOS the output goes straight to the device with I/O
/// buffers of 32–128 frames and the queue stays at about the hint (5 → ~4 ms, 10 → ~8 ms) —
/// what playing an instrument live needs. It has no anti-click ramps: write small blocks
/// (64–256 frames) on time, and check `underruns` in the trace. Other systems accept the hint and
/// raise it to their own floor. A Bluetooth output is always given 80 ms at least. iOS floor:
/// ~240 ms (the system freezes the app for ~200 ms on lock/unlock). `RAY_AUDIO_TRACE=1` prints
/// the size of the queue buffers when the output opens, and the ring size, the keepalive
/// silence inserted, fade-outs, flushes and underruns when it closes (a clean stream has 1
/// fade-out, 0 underruns, and one flush per `flush` call). Smaller =
/// more reactive but more underrun-prone; 0 (or plain `open`) = the 200 ms default. On
/// Android, a hint of 50 ms or less requests the LOW_LATENCY performance mode.
pub fn open_latency(sample_rate: int, channels: int, latency_ms: int) -> Result<int, string> {
    let r = __audio_open(sample_rate, channels, latency_ms, "s16le");
    if (r[0] == "ok") {
        match (parse_int(r[1])) {
            Option.Some(h) => Result.Ok(h),
            Option.None => Result.Err("invalid handle"),
        }
    } else {
        Result.Err(r[1])
    }
}

/// Like `open_latency`, choosing the SAMPLE FORMAT of what you `write`: `"s16le"` (the default
/// of `open`), `"s24le"` (3 octets per sample), `"s32le"` or `"f32le"` (IEEE float in -1..1),
/// all little-endian and interleaved. The device gets the format natively where the backend
/// accepts it (CoreAudio on macOS/iOS: all four; ALSA and AAudio: what the device supports) and
/// a conversion to s16le in the feeder thread otherwise (WASAPI always) — the program never has
/// to dither 24-bit material itself. `latency_ms` as in `open_latency` (0 = default). An unknown
/// format is `Err`.
pub fn open_format(
    sample_rate: int,
    channels: int,
    format: string,
    latency_ms: int
) -> Result<int, string> {
    let r = __audio_open(sample_rate, channels, latency_ms, format);
    if (r[0] == "ok") {
        match (parse_int(r[1])) {
            Option.Some(h) => Result.Ok(h),
            Option.None => Result.Err("invalid handle"),
        }
    } else {
        Result.Err(r[1])
    }
}

/// Discards what was written but has not sounded yet — the queue between the program and the
/// device and the backend's ring — WITHOUT closing the output: the next `write` sounds as soon as
/// it arrives. This is what a seek or a pause wants (with `close` + reopen the old position kept
/// playing over the new one for up to the latency hint). The cut ends with the anti-click fade
/// applied to the ring itself at any sample rate, and the next data fades in right behind it
/// (CoreAudio; the other backends drop their buffers without a ramp); what already sits in the
/// device buffers (a few ms) finishes playing. Returns when the output has been emptied (at most
/// ~one feeder chunk). Check it with `RAY_AUDIO_TRACE=1`: `flushes N`.
pub fn flush(h: int) -> Result<int, string> {
    let r = __audio_flush(h);
    if (r[0] == "ok") {
        Result.Ok(0)
    } else {
        Result.Err(r[1])
    }
}

/// The REAL playback position in ms (M158): what the device confirms as played
/// (AudioQueueGetCurrentTime / snd_pcm_delay / AAudioStream_getFramesRead), refreshed as
/// audio is fed (about latency/4 granularity) — for syncing visuals to the audio. 0 until
/// something has actually sounded. Under `RAY_AUDIO_SINK=null` the null sink keeps its own
/// real-time clock: `played_ms` advances at the pace of the wall clock while audio is being
/// written (within a fraction of a percent; a gap with nothing to play does not count), so tests
/// can align against it as against a device.
pub fn played_ms(h: int) -> Result<int, string> {
    let r = __audio_played(h);
    if (r[0] == "ok") {
        match (parse_int(r[1])) {
            Option.Some(ms) => Result.Ok(ms),
            Option.None => Result.Err("invalid position"),
        }
    } else {
        Result.Err(r[1])
    }
}

/// Lowers the volume of what OTHER apps are playing while your program plays something that
/// matters — an alarm, a spoken prompt — and gives it back with `false` (pepa #346). Call it
/// with `true` right before the sound and with `false` when it ends. iOS: the audio session
/// gains `MixWithOthers | DuckOthers` and gets its previous options back afterwards (it needs
/// `audio_session` or `background_audio` in `[ios]`; use `audio_session = "playback_mix"`, the
/// session that already lets other apps play — with a session that silences them there is
/// nothing to duck). Android: the transient audio focus that
/// lets others duck (`AUDIOFOCUS_GAIN_TRANSIENT_MAY_DUCK`; needs a shell generated by raylang
/// 1.27.104+, an older one gives `Err` with the fix); `Err` when the system denies the focus,
/// as during a call. Desktop: a no-op `Ok` — there is no system ducking to ask for.
pub fn duck_others(on: bool) -> Result<int, string> {
    let r = __audio_open(0, 0, 0, if (on) { "duck:on" } else { "duck:off" });
    if (r[0] == "ok") { Result.Ok(0) } else { Result.Err(r[1]) }
}

/// What the program has written and has NOT sounded yet, in ms (ray-daw #429): what waits in
/// the queue plus what the device still holds. Unlike `played_ms` — the device's clock, which
/// on macOS and iOS also counts the silence the backend plays while the queue is empty — it
/// follows the program's own samples: the sample sounding right now is `written − queued`,
/// whatever `flush` calls or gaps happened before. Granularity: one device buffer.
///
/// "Sounded" means handed to the device. It does NOT include the latency the device itself
/// declares (its converter, its DSP, its safety margin): ask `device_latency_ms` for that one.
/// The sample leaving the speaker right now is `written − queued − device_latency`.
pub fn queued_ms(h: int) -> Result<int, string> {
    let r = __audio_open(h, 0, 0, "queued");
    if (r[0] == "ok") {
        match (parse_int(r[1])) {
            Option.Some(ms) => Result.Ok(ms),
            Option.None => Result.Err("invalid position"),
        }
    } else {
        Result.Err(r[1])
    }
}

/// The latency the DEVICE of `h` declares, in ms (ray-daw #475). `h` is an open output or an
/// open input. For an output it is the time from the device taking a sample to that sample
/// leaving the speaker; for an input, from the sound reaching the microphone to the device
/// delivering it. Neither `queued_ms` nor `read` count it, so a recorder aligns a take with
/// what was playing by subtracting both: output latency + input latency.
///
/// macOS: the device latency, its safety offset and the latency of its stream, as CoreAudio
/// reports them (`kAudioDevicePropertyLatency`, `kAudioDevicePropertySafetyOffset`,
/// `kAudioStreamPropertyLatency`), plus one I/O buffer of the device for an output that the
/// device serves directly (a hint below 20 ms, when the device accepts it). An output or an
/// input opened without choosing a device follows the default device, and so does this value
/// (an input opened with a hint below 20 ms stays on the device it opened): ask when you open
/// and again after `next_change`, not per block — every call asks the system.
///
/// `Err` when the latency is not known: on the other systems (iOS, Linux, Android, Windows do
/// not report it yet) and when the device is gone. Treat `Err` as "unknown, let the user
/// calibrate", not as 0. The test sink and source (`RAY_AUDIO_SINK=null`, `RAY_AUDIO_SOURCE`)
/// give 0: they add none. It is what the device DECLARES: an external converter or a Bluetooth
/// link may add more than it says, so keep a manual offset for the user on top.
pub fn device_latency_ms(h: int) -> Result<int, string> {
    let r = __audio_open(h, 0, 0, "latency");
    if (r[0] == "ok") {
        match (parse_int(r[1])) {
            Option.Some(ms) => Result.Ok(ms),
            Option.None => Result.Err("invalid latency"),
        }
    } else {
        Result.Err(r[1])
    }
}

/// Writes interleaved samples (in the format the output was opened with; s16le unless
/// `open_format` said otherwise) to the output. Writes ALL of `samples`, parking the fiber
/// while the device buffer is full — backpressure IS the pacing: write your audio as fast as
/// you produce it and the device sets the tempo. `Err` if the output was closed, or if it was
/// opened with `open_device` and that device was disconnected (reported on macOS only).
pub fn write(h: int, samples: bytes) -> Result<int, string> {
    let r = __audio_write(h, samples);
    if (r[0] == "ok") {
        Result.Ok(samples.len())
    } else {
        // Si la salida terminó porque su dispositivo se fue, el pipe solo dice «roto»: el
        // motivo lo guarda el runtime y lo cuenta `__audio_played`.
        let why = __audio_played(h);
        if (why[0] != "ok" && why[1].starts_with("audio: the output device")) {
            Result.Err(why[1])
        } else {
            Result.Err(r[1])
        }
    }
}

/// Waits until everything written has been played (queue empty plus the device buffer margin).
/// Call it before `close(h)` at the end of a session for a gapless ending — `close(h)` (the
/// ordinary handle close) ends the output WITHOUT blocking: what is already queued (up to the
/// latency hint) still plays and ends with a short fade-out. A program that exits right away may
/// cut the tail. To jump or pause without the old position overlapping the new one, keep the
/// output open and call `flush` (rayplay #166).
pub fn drain(h: int) -> Result<int, string> {
    let r = __audio_drain(h);
    if (r[0] == "ok") {
        Result.Ok(0)
    } else {
        Result.Err(r[1])
    }
}

/// An audio device of the system, as listed by `devices`. `id` is what `open_device` and
/// `open_input_device` take; it stays the same across reconnections on macOS and Windows.
/// `input_channels` / `output_channels` are 0 when the device does not record / play.
/// `sample_rate` is its current rate (0 if unknown). `transport` says how it is connected:
/// `"builtin"`, `"usb"`, `"bluetooth"`, `"hdmi"`, `"network"`, `"virtual"`, `"aggregate"`,
/// `"wired"`, or `""` when the system does not say — a Bluetooth output needs a larger latency
/// hint than a wired one.
// M468 (ray-daw #424).
pub struct Device {
    id: string,
    name: string,
    input_channels: int,
    output_channels: int,
    default_input: bool,
    default_output: bool,
    sample_rate: int,
    transport: string,
}

/// The audio devices present right now. Empty on iOS (the system routes audio by itself) and
/// where there is no audio backend.
pub fn devices() -> [Device] {
    var out: [Device] = [];
    let r = __audio_open(0, 0, 0, "devices");
    if (r[0] != "ok") {
        return out;
    }
    for line in r[1].split("\n") {
        let f = line.split("\t");
        if (f.len() >= 8) {
            out.push(
                Device {
                    id: f[0],
                    name: f[1],
                    input_channels: parse_int(f[2]).unwrap_or(0),
                    output_channels: parse_int(f[3]).unwrap_or(0),
                    default_input: f[4] == "1",
                    default_output: f[5] == "1",
                    sample_rate: parse_int(f[6]).unwrap_or(0),
                    transport: f[7]
                }
            );
        }
    }
    out
}

/// Like `open_format`, on the output device `device` (an `id` from `devices()`) instead of the
/// default one. An unknown or disconnected device is `Err`. If the device disappears while the
/// output is open, the output ends: `write` (and `played_ms`, `queued_ms`, `flush`, `drain`)
/// return `Err("audio: the output device was disconnected")`; open another (`watch` /
/// `next_change` also tell you when the devices change). An output opened WITHOUT choosing a
/// device does not end: it moves to the new default device by itself (and is silent while
/// there is none). Both behaviours are macOS only for now: on the other systems a lost device
/// is not reported, so use `watch` / `next_change` there. Under `RAY_AUDIO_SINK=null` any id is
/// accepted, unless `RAY_AUDIO_DEVICES=a,b` declares the test devices: then an id that is not
/// listed is `Err`.
pub fn open_device(
    device: string,
    sample_rate: int,
    channels: int,
    format: string,
    latency_ms: int
) -> Result<int, string> {
    open_format(sample_rate, channels, format + "@" + device, latency_ms)
}

/// Like `open_input`, recording from the device `device` (an `id` from `devices()`) instead of
/// the default one.
pub fn open_input_device(
    device: string,
    sample_rate: int,
    channels: int,
    format: string,
    latency_ms: int
) -> Result<int, string> {
    open_input(sample_rate, channels, format + "@" + device, latency_ms)
}

/// Opens an audio INPUT (the default microphone or audio interface) and starts recording:
/// `sample_rate` Hz, `channels` interleaved channels, samples in `format` (`"s16le"`, `"s24le"`,
/// `"s32le"` or `"f32le"`). `latency_ms` (3–1000, or 0 for the default of 100; below 20 the
/// blocks are small and, on macOS, so is the device's I/O buffer) sizes the blocks
/// the capture arrives in. Returns a handle for `read`; the prelude's `close(h)` stops recording
/// (there is no `audio.close`: `close` is the global one that also closes files and sockets).
///
/// Available on macOS, iOS, Linux (ALSA), Android and Windows. The first time, the system asks
/// for microphone permission: on iOS the app needs `[ios] audio_session = "play_and_record"`
/// and on Android `[android] record_audio = true`. Without the permission the input delivers
/// silence on macOS and iOS, and `open_input` returns `Err` on Android and Windows.
///
/// A macOS app packaged with `ray bundle` must declare the text of the permission in
/// `[app.plist]` (`NSMicrophoneUsageDescription = "…"`) and, when it is signed with the hardened
/// runtime (`--sign`), carry the entitlement `com.apple.security.device.audio-input`
/// (`[app] entitlements = "file.plist"`): without it the input is silent and macOS never asks.
///
/// The system converts when the device runs at another sample rate: the rate you ask for is the
/// rate you read. `Device.sample_rate` is the device's own; ask for that one to avoid the
/// conversion.
///
/// `RAY_AUDIO_SOURCE=null` (silence) or `=tone` (440 Hz) replace
/// the device with a real-time source, for tests.
// M463 (ray-daw #422).
pub fn open_input(
    sample_rate: int,
    channels: int,
    format: string,
    latency_ms: int
) -> Result<int, string> {
    let r = __audio_open(sample_rate, channels, latency_ms, "input:" + format);
    if (r[0] == "ok") {
        match (parse_int(r[1])) {
            Option.Some(h) => Result.Ok(h),
            Option.None => Result.Err("invalid handle"),
        }
    } else {
        Result.Err(r[1])
    }
}

/// Reads the audio captured since the last `read`: whole interleaved frames in the format of
/// `open_input`. Parks the fiber until there is data, so a recording loop needs no clock. An
/// empty result means the input was closed. Audio that is not read in time (about one second)
/// is dropped, never delayed.
///
/// How old a sample is when `read` returns it: the latency the input device declares
/// (`device_latency_ms(h)`), plus the block it arrived in (about a quarter of the `latency_ms`
/// of `open_input`; on macOS an input at 20 ms or more arrives in bursts of about 20 ms
/// whatever the hint), plus how long the program took to call `read`. `recorded_ms` is the count
/// of frames delivered so far: the last frame of a block was captured `device_latency_ms(h)`
/// before `recorded_ms` reached it.
pub fn read(h: int) -> Result<bytes, string> {
    let r = __audio_read(h);
    if (r[0] == b"ok") {
        Result.Ok(r[1])
    } else {
        Result.Err(from_utf8(r[1]).unwrap_or("audio: read failed"))
    }
}

/// Starts watching the set of audio devices. Returns a handle for `next_change`; `close(h)`
/// stops it.
pub fn watch() -> Result<int, string> {
    let r = __audio_open(0, 0, 0, "input:watch");
    if (r[0] == "ok") {
        match (parse_int(r[1])) {
            Option.Some(h) => Result.Ok(h),
            Option.None => Result.Err("invalid handle"),
        }
    } else {
        Result.Err(r[1])
    }
}

/// Parks the fiber until a device is plugged in or unplugged, or the default device changes;
/// then call `devices()` again. The list is compared once per second.
pub fn next_change(h: int) -> Result<int, string> {
    let r = __audio_read(h);
    if (r[0] != b"ok") {
        return Result.Err(from_utf8(r[1]).unwrap_or("audio: watch failed"));
    }
    if (r[1].len() == 0) {
        return Result.Err("audio: the watch was closed");
    }
    Result.Ok(0)
}

/// The capture clock of the input `h`, in ms: how much audio the device has delivered since it
/// was opened, whether it was read or not. Pair it with `played_ms` of an output to line up a
/// recording with what was playing.
pub fn recorded_ms(h: int) -> Result<int, string> {
    played_ms(h)
}
