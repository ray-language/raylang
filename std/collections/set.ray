// std/collections/set — conjunto (hash set) sobre buckets (M50.2; antes en el prelude, M40.3b).
//
// Tabla hash **bucketed** escrita EN raylang sobre `@derive(Hash)` + `Eq`: `T` debe implementar ambos
// (los bounds se bajan a diccionarios, M9.2). Con leaf-binding (`import std/collections/set;`) las
// operaciones se usan calificadas: `set.new()`/`set.add(s, x)`/`set.has(s, x)`/… `set.new()` es un
// constructor vacío: su `T` lo fija el tipo esperado (inferencia bidireccional en la llamada). Nº de
// buckets fijo (sin resize aún). Los helpers `bucket`/`in_bucket` no son `pub` (internos).
/// A hash set of `T`, backed by buckets. `T` must implement `Hash` and `Eq`.
/// Import with `import std/collections/set;` and operate on it with `set.new`, `set.add`, `set.has`, …
pub struct Set<T> {
    buckets: [[T]],
    count: int,
}

/// Creates an empty set. The element type is fixed by the expected type at the call site.
pub fn new<T>() -> Set<T> {
    var bs: [[T]] = [];
    var i = 0;
    while (i < 16) {
        var e: [T] = [];
        bs.push(e);
        i = i + 1;
    }
    Set { buckets: bs, count: 0 }
}

// Índice de bucket de `x` (hash módulo nº de buckets, normalizado a 0..n aunque el hash sea negativo).
/// Internal helper: bucket index for `x` (hash modulo `n`, normalized to be non-negative).
fn bucket<T: Hash>(x: T, n: int) -> int {
    let h = x.hash();
    (h % n + n) % n
}

// ¿Está `x` en el bucket `b`? Búsqueda lineal por igualdad (`Eq`).
/// Internal helper: linear search for `x` in bucket `b` using `Eq`; true if present.
fn in_bucket<T: Eq>(b: [T], x: T) -> bool {
    var i = 0;
    while (i < b.len()) {
        if (b[i].eq(x)) {
            return true;
        }
        i = i + 1;
    }
    false
}

// Añade `x` al conjunto (si no estaba ya). Muta `s`.
/// Adds `x` to the set if it is not already present. Mutates `s`.
pub fn add<T: Hash + Eq>(s: Set<T>, x: T) {
    let idx = bucket(x, s.buckets.len());
    let b = s.buckets[idx];
    if (!in_bucket(b, x)) {
        b.push(x);
        s.count = s.count + 1;
    }
}

// ¿Pertenece `x` al conjunto?
/// Returns true if `x` is a member of the set.
pub fn has<T: Hash + Eq>(s: Set<T>, x: T) -> bool {
    let idx = bucket(x, s.buckets.len());
    in_bucket(s.buckets[idx], x)
}

// Quita `x` del conjunto (si estaba). Muta `s` reconstruyendo el bucket sin `x`.
/// Removes `x` from the set if present. Mutates `s`.
pub fn remove<T: Hash + Eq>(s: Set<T>, x: T) {
    let idx = bucket(x, s.buckets.len());
    let b = s.buckets[idx];
    var out: [T] = [];
    var i = 0;
    var removed = false;
    while (i < b.len()) {
        if (b[i].eq(x)) {
            removed = true;
        } else {
            out.push(b[i]);
        }
        i = i + 1;
    }
    if (removed) {
        s.buckets[idx] = out;
        s.count = s.count - 1;
    }
}

// Número de elementos del conjunto.
/// Returns the number of elements in the set.
pub fn size<T>(s: Set<T>) -> int { s.count }

// Los elementos del conjunto en un arreglo (orden no especificado — por bucket).
/// Returns the elements of the set as an array (order unspecified — by bucket).
pub fn items<T>(s: Set<T>) -> [T] {
    var out: [T] = [];
    var i = 0;
    while (i < s.buckets.len()) {
        let b = s.buckets[i];
        var j = 0;
        while (j < b.len()) {
            out.push(b[j]);
            j = j + 1;
        }
        i = i + 1;
    }
    out
}
