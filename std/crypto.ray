// std/crypto (M49.3) — production cryptography (constant-time, audited: backed by `ring`, M43). Import
// with `import std/crypto;` and use qualified (`crypto.sha256(data)`, `crypto.hmac_sha256(key, msg)`).
// Hashes/MACs take and return `bytes`; the fallible ones (Ed25519 sign/key from a 32-byte seed,
// ChaCha20-Poly1305 whose sizes must match, `open` which also authenticates) return `Option<bytes>`.
// The functions wrap engine-side primitives (`__sha256`, `__ed25519_sign`, …).
// M68.2: aleatoriedad criptográfica. El PRNG de `std/random` (SplitMix64 sembrado del reloj)
// es para simulación/jitter; los SECRETOS salen de aquí.
/// `n` cryptographically secure random bytes from the OS CSPRNG. Use this — not `std/random` —
/// for session tokens, salts, nonces and keys. `n <= 0` returns empty bytes.
pub fn random_bytes(n: int) -> bytes { __crypto_random_bytes(n) }

/// SHA-256 digest of `data` (32 bytes).
pub fn sha256(data: bytes) -> bytes { __sha256(data) }

/// SHA-512 digest of `data` (64 bytes).
pub fn sha512(data: bytes) -> bytes { __sha512(data) }

/// SHA-1 digest of `data` (20 bytes). Legacy algorithm — needed by some protocols (e.g. WebSocket);
/// avoid for new designs.
pub fn sha1(data: bytes) -> bytes { __sha1(data) }

/// HMAC-SHA-256 of `msg` under `key` (32 bytes).
pub fn hmac_sha256(key: bytes, msg: bytes) -> bytes { __hmac_sha256(key, msg) }

/// Derives the Ed25519 public key (32 bytes) from a 32-byte private seed; `None` if the seed is not
/// exactly 32 bytes.
pub fn ed25519_public_key(seed: bytes) -> Option<bytes> {
    let r = __ed25519_public_key(seed);
    if (r.len() == 0) { Option.None } else { Option.Some(r[0]) }
}

/// Signs `msg` with the 32-byte Ed25519 seed, returning a 64-byte deterministic signature (RFC 8032);
/// `None` if the seed is not exactly 32 bytes.
pub fn ed25519_sign(seed: bytes, msg: bytes) -> Option<bytes> {
    let r = __ed25519_sign(seed, msg);
    if (r.len() == 0) { Option.None } else { Option.Some(r[0]) }
}

/// Verifies an Ed25519 signature: `true` if `sig` is a valid signature of `msg` under `pubkey`.
pub fn ed25519_verify(pubkey: bytes, msg: bytes, sig: bytes) -> bool {
    __ed25519_verify(pubkey, msg, sig)
}

/// ChaCha20-Poly1305 AEAD encryption: returns ciphertext followed by the authentication tag. The key
/// must be 32 bytes and the nonce 12; `None` if the sizes are wrong.
pub fn chacha20poly1305_seal(
    key: bytes,
    nonce: bytes,
    aad: bytes,
    plaintext: bytes
) -> Option<bytes> {
    let r = __chacha20poly1305_seal(key, nonce, aad, plaintext);
    if (r.len() == 0) { Option.None } else { Option.Some(r[0]) }
}

/// ChaCha20-Poly1305 AEAD decryption: verifies and decrypts; `None` if authentication fails (tampered
/// data) or the sizes are wrong.
pub fn chacha20poly1305_open(
    key: bytes,
    nonce: bytes,
    aad: bytes,
    ciphertext: bytes
) -> Option<bytes> {
    let r = __chacha20poly1305_open(key, nonce, aad, ciphertext);
    if (r.len() == 0) { Option.None } else { Option.Some(r[0]) }
}

// M114: ACUERDO DE CLAVES. Ed25519 da la identidad y ChaCha20-Poly1305 el cifrado, pero sin esto no hay
// con qué unirlos: X25519 es lo que dos pares usan para llegar a un secreto común sobre un canal público.
// La privada son 32 octetos (`random_bytes(32)`), como la semilla de Ed25519, y se puede PERSISTIR: la
// identidad de un nodo sobrevive al reinicio.

/// Derives the X25519 public key (32 bytes) from a 32-byte secret key; `None` if the secret is not
/// exactly 32 bytes. Any 32 bytes are a valid secret key (RFC 7748 clamping is applied internally), so
/// `random_bytes(32)` is how you make one.
pub fn x25519_public_key(secret: bytes) -> Option<bytes> {
    let r = __x25519_public_key(secret);
    if (r.len() == 0) { Option.None } else { Option.Some(r[0]) }
}

/// The X25519 shared secret (32 bytes) between our secret key and the peer's public key. Both sides
/// compute the same value from opposite halves. `None` if either key is not 32 bytes, or if the peer's
/// public key is a small-order point (which would force an all-zero output an attacker knows).
///
/// This is the RAW Diffie-Hellman output: it is not a uniform key and must NOT be used directly as an
/// AEAD key. Always run it through `hkdf_sha256` first.
///
/// X25519 on its own gives you secrecy, not identity — anyone can do a key exchange with you. Sign the
/// exchange with `ed25519_sign` to bind it to a known peer, or you are open to a machine in the middle.
pub fn x25519_shared_secret(secret: bytes, peer_public: bytes) -> Option<bytes> {
    let r = __x25519_shared_secret(secret, peer_public);
    if (r.len() == 0) { Option.None } else { Option.Some(r[0]) }
}

/// HKDF-SHA256 (RFC 5869): derives `len` bytes of key material from `ikm` — typically a shared secret —
/// bound to `salt` and `info`. `None` if `len` is outside `1..=8160`. An empty `salt` means the all-zero
/// salt the RFC mandates.
///
/// `info` is what separates keys derived from the same secret: two different `info` values yield two
/// independent keys. Derive one key per direction of a conversation so that neither side can reuse a
/// nonce the other has already used.
pub fn hkdf_sha256(salt: bytes, ikm: bytes, info: bytes, len: int) -> Option<bytes> {
    let r = __hkdf_sha256(salt, ikm, info, len);
    if (r.len() == 0) { Option.None } else { Option.Some(r[0]) }
}

/// Compares two byte strings in constant time: `false` for different lengths, and otherwise a comparison
/// whose duration does not depend on where the first difference is. Use this — not `==` — for MAC tags,
/// session tokens and any secret, because `==` stops at the first differing byte and leaks the correct
/// value one byte at a time.
pub fn constant_time_eq(a: bytes, b: bytes) -> bool { __constant_time_eq(a, b) }
