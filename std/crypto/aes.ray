// std/crypto/aes — AES-128/192/256 (FIPS-197) en modos ECB y CBC, en raylang puro (M194, legado).
//
// LEGADO en el sentido de "primitiva sin autenticar": ECB no oculta patrones (dos bloques iguales
// dan el mismo criptograma) y CBC no autentica. Este módulo existe para HABLAR CON PROTOCOLOS QUE
// LO EXIGEN (la autenticación de Apple Remote Desktop cifra el bloque de credenciales con AES-128
// en ECB); para cifrar algo nuevo, `std/crypto.chacha20poly1305_seal`. Portado del cliente RFB
// `ray-remote` (cifrado) y completado con el descifrado, CBC y las claves de 192/256 bits; vectores
// de FIPS-197 y NIST SP 800-38A en `tests/crypto_legacy_cli.rs`. Sin relleno: el llamador trae
// bloques completos (PKCS#7 es dos líneas y depende del protocolo).

fn nb() -> int { 4 }  // columnas del estado

// Rondas según la longitud de clave (16/24/32 octetos → 10/12/14).
fn rounds_for(key_len: int) -> int {
    if (key_len == 16) { 10 } else if (key_len == 24) { 12 } else { 14 }
}

fn check_key(key: bytes) -> Result<int, string> {
    if (key.len() != 16 && key.len() != 24 && key.len() != 32) {
        return Result.Err("aes: the key must be 16, 24 or 32 bytes, got " + to_string(key.len()));
    }
    Result.Ok(0)
}

/// Encrypts one 16-byte block with `key` (16, 24 or 32 bytes).
pub fn encrypt_block(key: bytes, block: bytes) -> Result<bytes, string> {
    check_key(key)?;
    if (block.len() != 16) {
        return Result.Err("aes: the block must be 16 bytes");
    }
    let rk = expand_key(key);
    var st = to_state(block, 0);
    encrypt_state(st, rk, rounds_for(key.len()));
    Result.Ok(bytes_of(st))
}

/// Decrypts one 16-byte block with `key` (16, 24 or 32 bytes).
pub fn decrypt_block(key: bytes, block: bytes) -> Result<bytes, string> {
    check_key(key)?;
    if (block.len() != 16) {
        return Result.Err("aes: the block must be 16 bytes");
    }
    let rk = expand_key(key);
    var st = to_state(block, 0);
    decrypt_state(st, rk, rounds_for(key.len()));
    Result.Ok(bytes_of(st))
}

/// Encrypts `plaintext` in ECB mode (each 16-byte block independently; no padding — the input
/// must be a whole number of blocks). ECB leaks patterns: only for protocols that mandate it.
pub fn encrypt_ecb(key: bytes, plaintext: bytes) -> Result<bytes, string> {
    check_key(key)?;
    if (plaintext.len() % 16 != 0) {
        return Result.Err("aes: ECB needs a whole number of 16-byte blocks");
    }
    let rk = expand_key(key);
    let nr = rounds_for(key.len());
    var out: [int] = [];
    var off = 0;
    while (off < plaintext.len()) {
        var st = to_state(plaintext, off);
        encrypt_state(st, rk, nr);
        append(out, st);
        off = off + 16;
    }
    Result.Ok(bytes_of(out))
}

/// Decrypts `ciphertext` in ECB mode (whole 16-byte blocks, no padding).
pub fn decrypt_ecb(key: bytes, ciphertext: bytes) -> Result<bytes, string> {
    check_key(key)?;
    if (ciphertext.len() % 16 != 0) {
        return Result.Err("aes: ECB needs a whole number of 16-byte blocks");
    }
    let rk = expand_key(key);
    let nr = rounds_for(key.len());
    var out: [int] = [];
    var off = 0;
    while (off < ciphertext.len()) {
        var st = to_state(ciphertext, off);
        decrypt_state(st, rk, nr);
        append(out, st);
        off = off + 16;
    }
    Result.Ok(bytes_of(out))
}

/// Encrypts `plaintext` in CBC mode with a 16-byte `iv` (whole blocks, no padding, no
/// authentication).
pub fn encrypt_cbc(key: bytes, iv: bytes, plaintext: bytes) -> Result<bytes, string> {
    check_key(key)?;
    if (iv.len() != 16) {
        return Result.Err("aes: the IV must be 16 bytes");
    }
    if (plaintext.len() % 16 != 0) {
        return Result.Err("aes: CBC needs a whole number of 16-byte blocks");
    }
    let rk = expand_key(key);
    let nr = rounds_for(key.len());
    var prev = to_state(iv, 0);
    var out: [int] = [];
    var off = 0;
    while (off < plaintext.len()) {
        var st = to_state(plaintext, off);
        var i = 0;
        while (i < 16) {
            st[i] = st[i] ^ prev[i];
            i = i + 1;
        }
        encrypt_state(st, rk, nr);
        append(out, st);
        prev = st;
        off = off + 16;
    }
    Result.Ok(bytes_of(out))
}

/// Decrypts `ciphertext` in CBC mode with a 16-byte `iv` (whole blocks, no padding).
pub fn decrypt_cbc(key: bytes, iv: bytes, ciphertext: bytes) -> Result<bytes, string> {
    check_key(key)?;
    if (iv.len() != 16) {
        return Result.Err("aes: the IV must be 16 bytes");
    }
    if (ciphertext.len() % 16 != 0) {
        return Result.Err("aes: CBC needs a whole number of 16-byte blocks");
    }
    let rk = expand_key(key);
    let nr = rounds_for(key.len());
    var prev = to_state(iv, 0);
    var out: [int] = [];
    var off = 0;
    while (off < ciphertext.len()) {
        let cblock = to_state(ciphertext, off);
        var st = to_state(ciphertext, off);
        decrypt_state(st, rk, nr);
        var i = 0;
        while (i < 16) {
            st[i] = st[i] ^ prev[i];
            i = i + 1;
        }
        append(out, st);
        prev = cblock;
        off = off + 16;
    }
    Result.Ok(bytes_of(out))
}

fn to_state(data: bytes, off: int) -> [int] {
    var st: [int] = [];
    var i = 0;
    while (i < 16) {
        st.push(data[off + i]);
        i = i + 1;
    }
    st
}

fn append(out: [int], st: [int]) {
    var i = 0;
    while (i < 16) {
        out.push(st[i]);
        i = i + 1;
    }
}

// Cifra UN bloque (estado de 16 octetos, columna a columna) en el sitio con las claves de ronda.
fn encrypt_state(state: [int], rk: [int], nr: int) {
    add_round_key(state, rk, 0);
    var round = 1;
    while (round < nr) {
        sub_bytes(state);
        shift_rows(state);
        mix_columns(state);
        add_round_key(state, rk, round);
        round = round + 1;
    }
    // La última ronda no mezcla columnas.
    sub_bytes(state);
    shift_rows(state);
    add_round_key(state, rk, nr);
}

// Descifra UN bloque en el sitio: las transformaciones inversas en orden inverso (FIPS-197 §5.3).
fn decrypt_state(state: [int], rk: [int], nr: int) {
    let inv = inv_sbox_table();
    add_round_key(state, rk, nr);
    var round = nr - 1;
    while (round >= 1) {
        inv_shift_rows(state);
        inv_sub_bytes(state, inv);
        add_round_key(state, rk, round);
        inv_mix_columns(state);
        round = round - 1;
    }
    inv_shift_rows(state);
    inv_sub_bytes(state, inv);
    add_round_key(state, rk, 0);
}

// Las claves de ronda ((nr + 1) × 16 octetos) a partir de la clave de 128/192/256 bits (FIPS-197 §5.2).
fn expand_key(key: bytes) -> [int] {
    let sbox = sbox_table();
    let nk = key.len() / 4;
    let nr = rounds_for(key.len());
    var w: [int] = [];
    var i = 0;
    while (i < key.len()) {
        w.push(key[i]);
        i = i + 1;
    }
    var rcon = 1;
    var word = nk;
    let total = nb() * (nr + 1);
    while (word < total) {
        // Los cuatro octetos del word anterior.
        var t0 = w[(word - 1) * 4];
        var t1 = w[(word - 1) * 4 + 1];
        var t2 = w[(word - 1) * 4 + 2];
        var t3 = w[(word - 1) * 4 + 3];
        if (word % nk == 0) {
            // RotWord + SubWord + Rcon.
            let r0 = t0;
            t0 = sbox[t1] ^ rcon;
            t1 = sbox[t2];
            t2 = sbox[t3];
            t3 = sbox[r0];
            rcon = xtime(rcon);
        } else if (nk > 6 && word % nk == 4) {
            // AES-256: SubWord extra a mitad de cada grupo de 8 words.
            t0 = sbox[t0];
            t1 = sbox[t1];
            t2 = sbox[t2];
            t3 = sbox[t3];
        }
        let base = (word - nk) * 4;
        w.push(w[base] ^ t0);
        w.push(w[base + 1] ^ t1);
        w.push(w[base + 2] ^ t2);
        w.push(w[base + 3] ^ t3);
        word = word + 1;
    }
    w
}

fn add_round_key(state: [int], rk: [int], round: int) {
    let base = round * 16;
    var i = 0;
    while (i < 16) {
        state[i] = state[i] ^ rk[base + i];
        i = i + 1;
    }
}

fn sub_bytes(state: [int]) {
    let sbox = sbox_table();
    var i = 0;
    while (i < 16) {
        state[i] = sbox[state[i]];
        i = i + 1;
    }
}

// El estado es columna a columna: el octeto `i` es la fila `i % 4` de la columna `i / 4`. La
// fila `r` rota `r` posiciones a la izquierda.
fn shift_rows(state: [int]) {
    var copy: [int] = [];
    var i = 0;
    while (i < 16) {
        copy.push(state[i]);
        i = i + 1;
    }
    var r = 1;
    while (r < 4) {
        var c = 0;
        while (c < 4) {
            state[r + 4 * c] = copy[r + 4 * ((c + r) % 4)];
            c = c + 1;
        }
        r = r + 1;
    }
}

fn inv_sub_bytes(state: [int], inv: [int]) {
    var i = 0;
    while (i < 16) {
        state[i] = inv[state[i]];
        i = i + 1;
    }
}

// La fila `r` rota `r` posiciones a la DERECHA (inversa de shift_rows).
fn inv_shift_rows(state: [int]) {
    var copy: [int] = [];
    var i = 0;
    while (i < 16) {
        copy.push(state[i]);
        i = i + 1;
    }
    var r = 1;
    while (r < 4) {
        var c = 0;
        while (c < 4) {
            state[r + 4 * ((c + r) % 4)] = copy[r + 4 * c];
            c = c + 1;
        }
        r = r + 1;
    }
}

// La matriz inversa de MixColumns (9, 11, 13, 14 en GF(2^8)).
fn inv_mix_columns(state: [int]) {
    var c = 0;
    while (c < 4) {
        let b = c * 4;
        let a0 = state[b];
        let a1 = state[b + 1];
        let a2 = state[b + 2];
        let a3 = state[b + 3];
        state[b] = mul(a0, 14) ^ mul(a1, 11) ^ mul(a2, 13) ^ mul(a3, 9);
        state[b + 1] = mul(a0, 9) ^ mul(a1, 14) ^ mul(a2, 11) ^ mul(a3, 13);
        state[b + 2] = mul(a0, 13) ^ mul(a1, 9) ^ mul(a2, 14) ^ mul(a3, 11);
        state[b + 3] = mul(a0, 11) ^ mul(a1, 13) ^ mul(a2, 9) ^ mul(a3, 14);
        c = c + 1;
    }
}

// Producto en GF(2^8) por suma de potencias de x (la constante cabe en 4 bits).
fn mul(a: int, k: int) -> int {
    var result = 0;
    var factor = a;
    var bits = k;
    while (bits > 0) {
        if (bits % 2 == 1) {
            result = result ^ factor;
        }
        factor = xtime(factor);
        bits = bits / 2;
    }
    result
}

// La S-box inversa, derivada de la directa.
fn inv_sbox_table() -> [int] {
    let sbox = sbox_table();
    var inv: [int] = [];
    var i = 0;
    while (i < 256) {
        inv.push(0);
        i = i + 1;
    }
    i = 0;
    while (i < 256) {
        inv[sbox[i]] = i;
        i = i + 1;
    }
    inv
}

// Cada columna se multiplica por la matriz fija de MixColumns en GF(2^8).
fn mix_columns(state: [int]) {
    var c = 0;
    while (c < 4) {
        let b = c * 4;
        let a0 = state[b];
        let a1 = state[b + 1];
        let a2 = state[b + 2];
        let a3 = state[b + 3];
        state[b] = mul2(a0) ^ mul3(a1) ^ a2 ^ a3;
        state[b + 1] = a0 ^ mul2(a1) ^ mul3(a2) ^ a3;
        state[b + 2] = a0 ^ a1 ^ mul2(a2) ^ mul3(a3);
        state[b + 3] = mul3(a0) ^ a1 ^ a2 ^ mul2(a3);
        c = c + 1;
    }
}

// Multiplicar por x en GF(2^8): desplazar y, si se salió el bit alto, reducir por el polinomio
// irreducible 0x11B.
fn xtime(a: int) -> int {
    let shifted = a * 2 % 256;
    if (a >= 128) { shifted ^ 0x1B } else { shifted }
}

fn mul2(a: int) -> int { xtime(a) }

fn mul3(a: int) -> int { xtime(a) ^ a }

