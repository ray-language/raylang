// std/crypto/des — DES y 3DES (FIPS 46-3, NIST SP 800-67) en modos ECB y CBC, en raylang puro
// (M194, legado).
//
// LEGADO: DES lleva roto desde 1998 (su clave de 56 bits se agota por fuerza bruta en horas) y 3DES
// está retirado por NIST. Este módulo existe para HABLAR CON PROTOCOLOS QUE LO EXIGEN (la
// autenticación VNC clásica cifra el reto con DES; Kerberos y muchos protocolos heredados usan
// 3DES), no para diseñar nada nuevo: para eso, `std/crypto.chacha20poly1305_seal`. Portado del
// cliente RFB `ray-remote` (cifrado) y completado con el descifrado, CBC y 3DES (EDE, claves de 16
// o 24 octetos); vectores de FIPS 46-3 y SP 800-67 en `tests/crypto_legacy_cli.rs`.
//
// La implementación trabaja con ARREGLOS DE BITS en vez de con enteros de 64: es más lenta —da
// igual para los dos bloques de una autenticación— y a cambio las tablas del estándar se
// transcriben tal cual. Los bits van de más significativo a menos, y las tablas numeran las
// posiciones desde 1, como el FIPS.

fn check_sizes(key: bytes, block: bytes) -> Result<int, string> {
    if (key.len() != 8) {
        return Result.Err("des: the key must be 8 bytes");
    }
    if (block.len() != 8) {
        return Result.Err("des: the block must be 8 bytes");
    }
    Result.Ok(0)
}

/// Encrypts one 8-byte block with an 8-byte key.
pub fn encrypt_block(key: bytes, block: bytes) -> Result<bytes, string> {
    check_sizes(key, block)?;
    Result.Ok(bits_to_bytes(encrypt_bits(to_bits(key), to_bits(block))))
}

/// Decrypts one 8-byte block with an 8-byte key.
pub fn decrypt_block(key: bytes, block: bytes) -> Result<bytes, string> {
    check_sizes(key, block)?;
    Result.Ok(bits_to_bytes(decrypt_bits(to_bits(key), to_bits(block))))
}

/// Encrypts in ECB mode (whole 8-byte blocks, no padding). ECB leaks patterns.
pub fn encrypt_ecb(key: bytes, data: bytes) -> Result<bytes, string> {
    if (data.len() % 8 != 0) {
        return Result.Err("des: ECB needs a whole number of 8-byte blocks");
    }
    var out = b"";
    var off = 0;
    while (off < data.len()) {
        out = out + encrypt_block(key, data.sub_bytes(off, off + 8))?;
        off = off + 8;
    }
    Result.Ok(out)
}

/// Decrypts in ECB mode (whole 8-byte blocks, no padding).
pub fn decrypt_ecb(key: bytes, data: bytes) -> Result<bytes, string> {
    if (data.len() % 8 != 0) {
        return Result.Err("des: ECB needs a whole number of 8-byte blocks");
    }
    var out = b"";
    var off = 0;
    while (off < data.len()) {
        out = out + decrypt_block(key, data.sub_bytes(off, off + 8))?;
        off = off + 8;
    }
    Result.Ok(out)
}

/// Encrypts in CBC mode with an 8-byte `iv` (whole blocks, no padding, no authentication).
pub fn encrypt_cbc(key: bytes, iv: bytes, data: bytes) -> Result<bytes, string> {
    if (iv.len() != 8) {
        return Result.Err("des: the IV must be 8 bytes");
    }
    if (data.len() % 8 != 0) {
        return Result.Err("des: CBC needs a whole number of 8-byte blocks");
    }
    var prev = iv;
    var out = b"";
    var off = 0;
    while (off < data.len()) {
        let c = encrypt_block(key, xor_bytes(data.sub_bytes(off, off + 8), prev))?;
        out = out + c;
        prev = c;
        off = off + 8;
    }
    Result.Ok(out)
}

/// Decrypts in CBC mode with an 8-byte `iv` (whole blocks, no padding).
pub fn decrypt_cbc(key: bytes, iv: bytes, data: bytes) -> Result<bytes, string> {
    if (iv.len() != 8) {
        return Result.Err("des: the IV must be 8 bytes");
    }
    if (data.len() % 8 != 0) {
        return Result.Err("des: CBC needs a whole number of 8-byte blocks");
    }
    var prev = iv;
    var out = b"";
    var off = 0;
    while (off < data.len()) {
        let c = data.sub_bytes(off, off + 8);
        out = out + xor_bytes(decrypt_block(key, c)?, prev);
        prev = c;
        off = off + 8;
    }
    Result.Ok(out)
}

// Las tres claves de 3DES: 24 octetos (K1, K2, K3) o 16 (K3 = K1, "two-key").
fn tdes_keys(key: bytes) -> Result<[bytes], string> {
    if (key.len() == 24) {
        return Result.Ok([key.sub_bytes(0, 8), key.sub_bytes(8, 16), key.sub_bytes(16, 24)]);
    }
    if (key.len() == 16) {
        return Result.Ok([key.sub_bytes(0, 8), key.sub_bytes(8, 16), key.sub_bytes(0, 8)]);
    }
    Result.Err("3des: the key must be 16 or 24 bytes")
}

/// 3DES (EDE) encryption of one 8-byte block; `key` is 24 bytes (K1 K2 K3) or 16 (K3 = K1).
pub fn tdes_encrypt_block(key: bytes, block: bytes) -> Result<bytes, string> {
    let ks = tdes_keys(key)?;
    let a = encrypt_block(ks[0], block)?;
    let b = decrypt_block(ks[1], a)?;
    encrypt_block(ks[2], b)
}

/// 3DES (EDE) decryption of one 8-byte block.
pub fn tdes_decrypt_block(key: bytes, block: bytes) -> Result<bytes, string> {
    let ks = tdes_keys(key)?;
    let a = decrypt_block(ks[2], block)?;
    let b = encrypt_block(ks[1], a)?;
    decrypt_block(ks[0], b)
}

/// 3DES in ECB mode (whole 8-byte blocks, no padding).
pub fn tdes_encrypt_ecb(key: bytes, data: bytes) -> Result<bytes, string> {
    if (data.len() % 8 != 0) {
        return Result.Err("3des: ECB needs a whole number of 8-byte blocks");
    }
    var out = b"";
    var off = 0;
    while (off < data.len()) {
        out = out + tdes_encrypt_block(key, data.sub_bytes(off, off + 8))?;
        off = off + 8;
    }
    Result.Ok(out)
}

/// 3DES in ECB mode, decryption.
pub fn tdes_decrypt_ecb(key: bytes, data: bytes) -> Result<bytes, string> {
    if (data.len() % 8 != 0) {
        return Result.Err("3des: ECB needs a whole number of 8-byte blocks");
    }
    var out = b"";
    var off = 0;
    while (off < data.len()) {
        out = out + tdes_decrypt_block(key, data.sub_bytes(off, off + 8))?;
        off = off + 8;
    }
    Result.Ok(out)
}

/// 3DES in CBC mode with an 8-byte `iv` (whole blocks, no padding).
pub fn tdes_encrypt_cbc(key: bytes, iv: bytes, data: bytes) -> Result<bytes, string> {
    if (iv.len() != 8) {
        return Result.Err("3des: the IV must be 8 bytes");
    }
    if (data.len() % 8 != 0) {
        return Result.Err("3des: CBC needs a whole number of 8-byte blocks");
    }
    var prev = iv;
    var out = b"";
    var off = 0;
    while (off < data.len()) {
        let c = tdes_encrypt_block(key, xor_bytes(data.sub_bytes(off, off + 8), prev))?;
        out = out + c;
        prev = c;
        off = off + 8;
    }
    Result.Ok(out)
}

/// 3DES in CBC mode, decryption.
pub fn tdes_decrypt_cbc(key: bytes, iv: bytes, data: bytes) -> Result<bytes, string> {
    if (iv.len() != 8) {
        return Result.Err("3des: the IV must be 8 bytes");
    }
    if (data.len() % 8 != 0) {
        return Result.Err("3des: CBC needs a whole number of 8-byte blocks");
    }
    var prev = iv;
    var out = b"";
    var off = 0;
    while (off < data.len()) {
        let c = data.sub_bytes(off, off + 8);
        out = out + xor_bytes(tdes_decrypt_block(key, c)?, prev);
        prev = c;
        off = off + 8;
    }
    Result.Ok(out)
}

fn xor_bytes(a: bytes, b: bytes) -> bytes {
    var out: [int] = [];
    var i = 0;
    while (i < a.len()) {
        out.push(a[i] ^ b[i]);
        i = i + 1;
    }
    bytes_of(out)
}

// --- El cifrado en sí -------------------------------------------------------------------------

fn encrypt_bits(key: [int], block: [int]) -> [int] {
    feistel_rounds(subkeys(key), block)
}

// Descifrar es cifrar con las subclaves en orden inverso (FIPS 46-3).
fn decrypt_bits(key: [int], block: [int]) -> [int] {
    let keys = subkeys(key);
    var reversed: [[int]] = [];
    var i = 15;
    while (i >= 0) {
        reversed.push(keys[i]);
        i = i - 1;
    }
    feistel_rounds(reversed, block)
}

fn feistel_rounds(keys: [[int]], block: [int]) -> [int] {
    let start = permute(block, ip());
    var left = slice(start, 0, 32);
    var right = slice(start, 32, 64);

    var round = 0;
    while (round < 16) {
        let f = feistel(right, keys[round]);
        let next_right = xor(left, f);
        left = right;
        right = next_right;
        round = round + 1;
    }

    // La permutación final se aplica a las mitades INTERCAMBIADAS.
    permute(concat(right, left), fp())
}

// La función F: expandir a 48 bits, mezclar con la subclave, pasar por las cajas S y permutar.
fn feistel(right: [int], subkey: [int]) -> [int] {
    let mixed = xor(permute(right, e()), subkey);
    var out: [int] = [];
    var box = 0;
    while (box < 8) {
        let base = box * 6;
        // Los bits de los extremos dan la fila; los cuatro de en medio, la columna.
        let row = mixed[base] * 2 + mixed[base + 5];
        let col = mixed[base + 1] * 8 + mixed[base + 2] * 4 + mixed[base + 3] * 2 + mixed[base + 4];
        let value = s_boxes()[box * 64 + row * 16 + col];
        var bit = 3;
        while (bit >= 0) {
            out.push(value / pow2(bit) % 2);
            bit = bit - 1;
        }
        box = box + 1;
    }
    permute(out, p())
}

// Las 16 subclaves de 48 bits: se parte la clave en dos mitades de 28 y se rotan a la izquierda.
fn subkeys(key: [int]) -> [[int]] {
    let permuted = permute(key, pc1());
    var c = slice(permuted, 0, 28);
    var d = slice(permuted, 28, 56);
    let shifts = shift_schedule();

    var out: [[int]] = [];
    var round = 0;
    while (round < 16) {
        c = rotate(c, shifts[round]);
        d = rotate(d, shifts[round]);
        out.push(permute(concat(c, d), pc2()));
        round = round + 1;
    }
    out
}

// --- Utilidades sobre arreglos de bits -------------------------------------------------------

// Las tablas numeran desde 1, así que se resta uno al indexar.
fn permute(bits: [int], table: [int]) -> [int] {
    var out: [int] = [];
    var i = 0;
    while (i < table.len()) {
        out.push(bits[table[i] - 1]);
        i = i + 1;
    }
    out
}

fn xor(a: [int], b: [int]) -> [int] {
    var out: [int] = [];
    var i = 0;
    while (i < a.len()) {
        out.push(if (a[i] == b[i]) { 0 } else { 1 });
        i = i + 1;
    }
    out
}

fn rotate(bits: [int], n: int) -> [int] {
    var out: [int] = [];
    var i = 0;
    while (i < bits.len()) {
        out.push(bits[(i + n) % bits.len()]);
        i = i + 1;
    }
    out
}

fn slice(bits: [int], start: int, end: int) -> [int] {
    var out: [int] = [];
    var i = start;
    while (i < end) {
        out.push(bits[i]);
        i = i + 1;
    }
    out
}

fn concat(a: [int], b: [int]) -> [int] {
    var out: [int] = [];
    var i = 0;
    while (i < a.len()) {
        out.push(a[i]);
        i = i + 1;
    }
    i = 0;
    while (i < b.len()) {
        out.push(b[i]);
        i = i + 1;
    }
    out
}

fn to_bits(b: bytes) -> [int] {
    var out: [int] = [];
    var i = 0;
    while (i < b.len()) {
        var bit = 7;
        while (bit >= 0) {
            out.push(b[i] / pow2(bit) % 2);
            bit = bit - 1;
        }
        i = i + 1;
    }
    out
}

fn bits_to_bytes(bits: [int]) -> bytes {
    var out: [int] = [];
    var i = 0;
    while (i + 8 <= bits.len()) {
        var v = 0;
        var j = 0;
        while (j < 8) {
            v = v * 2 + bits[i + j];
            j = j + 1;
        }
        out.push(v);
        i = i + 8;
    }
    bytes_of(out)
}

fn pow2(n: int) -> int {
    var v = 1;
    var i = 0;
    while (i < n) {
        v = v * 2;
        i = i + 1;
    }
    v
}

