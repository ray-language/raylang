// std/crypto/md5 — MD5 (RFC 1321) en raylang puro (M194, legado).
//
// LEGADO: MD5 está roto para firmas y resistencia a colisiones desde hace dos décadas. Este módulo
// existe para HABLAR CON PROTOCOLOS QUE LO EXIGEN (la autenticación de Apple Remote Desktop deriva
// su clave AES del MD5 del secreto Diffie-Hellman; digest auth de HTTP; ...), no para diseñar nada
// nuevo: para eso, `std/crypto.sha256`. Portado del cliente RFB `ray-remote` con los vectores de
// RFC 1321 (`tests/crypto_legacy_cli.rs`).
//
// La aritmética va en `u32`, que en raylang envuelve por diseño: el algoritmo se escribe tal cual
// viene en el RFC, sin enmascarar a mano en cada paso.

/// The MD5 digest of `data` (16 bytes). LEGACY: only for protocols that require MD5; use
/// `std/crypto.sha256` for anything new.
pub fn md5(data: bytes) -> bytes {
    var a0: u32 = 0x67452301;
    var b0: u32 = 0xEFCDAB89;
    var c0: u32 = 0x98BADCFE;
    var d0: u32 = 0x10325476;

    let msg = pad(data);
    let k = table_k();
    let s = table_s();

    var off = 0;
    while (off < msg.len()) {
        // Los 16 words del bloque, little-endian.
        var m: [u32] = [];
        var w = 0;
        while (w < 16) {
            let p = off + w * 4;
            let v = msg[p] + msg[p + 1] * 256 + msg[p + 2] * 65536 + msg[p + 3] * 16777216;
            m.push(v as u32);
            w = w + 1;
        }

        var a = a0;
        var b = b0;
        var c = c0;
        var d = d0;

        var i = 0;
        while (i < 64) {
            var f: u32 = 0;
            var g = 0;
            if (i < 16) {
                f = b & c | ~b & d;
                g = i;
            } else if (i < 32) {
                f = d & b | ~d & c;
                g = (5 * i + 1) % 16;
            } else if (i < 48) {
                f = b ^ c ^ d;
                g = (3 * i + 5) % 16;
            } else {
                f = c ^ (b | ~d);
                g = 7 * i % 16;
            }
            let tmp = d;
            d = c;
            c = b;
            let sum = a + f + k[i] + m[g];
            b = b + rotl(sum, s[i]);
            a = tmp;
            i = i + 1;
        }

        a0 = a0 + a;
        b0 = b0 + b;
        c0 = c0 + c;
        d0 = d0 + d;
        off = off + 64;
    }

    var out: [int] = [];
    push_le32(out, a0);
    push_le32(out, b0);
    push_le32(out, c0);
    push_le32(out, d0);
    bytes_of(out)
}

// Rotación a la izquierda de 32 bits.
fn rotl(v: u32, n: int) -> u32 {
    if (n == 0) { v } else { v << n as u32 | v >> (32 - n) as u32 }
}

fn push_le32(out: [int], v: u32) {
    out.push((v & 0xFF) as int);
    out.push((v >> 8 & 0xFF) as int);
    out.push((v >> 16 & 0xFF) as int);
    out.push((v >> 24 & 0xFF) as int);
}

// Un 0x80, ceros hasta dejar 8 octetos libres en el bloque, y la longitud en BITS little-endian.
fn pad(data: bytes) -> bytes {
    var out: [int] = [];
    var i = 0;
    while (i < data.len()) {
        out.push(data[i]);
        i = i + 1;
    }
    out.push(0x80);
    while (out.len() % 64 != 56) {
        out.push(0);
    }
    // La longitud en bits como u64 little-endian. Se calcula por octetos para no desbordar `int`
    // con mensajes enormes: bit_len = len*8 se parte en su parte baja y su parte alta.
    let len = data.len();
    let low = len % 536870912 * 8;
    let high = len / 536870912;
    out.push(low % 256);
    out.push(low / 256 % 256);
    out.push(low / 65536 % 256);
    out.push(low / 16777216 % 256);
    out.push(high % 256);
    out.push(high / 256 % 256);
    out.push(high / 65536 % 256);
    out.push(high / 16777216 % 256);
    bytes_of(out)
}

