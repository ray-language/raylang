// std/crypto/md5 — MD5 (RFC 1321). LEGADO (M194): MD5 está roto para firmas y resistencia a
// colisiones desde hace dos décadas. Este módulo existe para HABLAR CON PROTOCOLOS QUE LO EXIGEN
// (ETag y `Content-MD5` de S3, la autenticación de Apple Remote Desktop, digest auth de HTTP, ...),
// no para diseñar nada nuevo: para eso, `std/crypto.sha256`.
//
// rayblob #282: el cálculo vive en Rust (`ray-runtime/src/md5.rs`, sin ring): la versión en raylang
// puro copiaba la entrada a `[int]` (~23× su tamaño en memoria, 20× el tiempo de sha256). Una pasada
// (`md5`) o incremental (`md5_init` + `crypto.hash_update`/`hash_final`), con los vectores de
// RFC 1321 en `tests/crypto_legacy_cli.rs`.

/// The MD5 digest of `data` (16 bytes), in one pass and without copying the input. LEGACY: only
/// for protocols that require MD5; use `std/crypto.sha256` for anything new.
pub fn md5(data: bytes) -> bytes {
    __md5(data)
}

/// Opens an incremental MD5 hasher (`Ok(handle)`): feed it with `crypto.hash_update(h, chunk)` as
/// many times as needed and close it with `crypto.hash_final(h)` (16 bytes) — the same cycle as
/// `crypto.sha256_init`, for hashing a body or a file chunk by chunk with bounded memory.
pub fn md5_init() -> Result<int, string> {
    let r = __hasher_new("md5");
    if (r[0] == "ok") {
        match (parse_int(r[1])) {
            Option.Some(h) => Result.Ok(h),
            Option.None => Result.Err("invalid handle"),
        }
    } else {
        Result.Err(r[1])
    }
}
