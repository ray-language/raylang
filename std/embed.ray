// std/embed (M147) — los assets del proyecto (IDEAS §80 F2): archivos declarados en
// `[native] embed = ["assets"]` del ray.toml, con el MISMO espacio de nombres en todos los
// motores. En la VM y el intérprete se leen EN VIVO del disco (editas y recargas — dev);
// `ray build --native` los HORNEA dentro del binario (autocontenido: el binario corre desde
// cualquier directorio, y es lo que un .app de `ray bundle` necesita — Finder lanza con
// cwd=/). Las claves usan `/` y son relativas a la raíz del proyecto: "assets/app.css".

/// Reads one embedded asset by its key (e.g. "assets/app.css"): `Ok(bytes)`, or `Err` if the
/// key is not in the embed namespace or nothing is configured. Keys are exact strings — no
/// `..`, no case folding: the namespace is identical on every engine and build.
pub fn read(path: string) -> Result<bytes, string> {
    let r = __embed_read(path);
    if (r[0] == b"ok") {
        Result.Ok(r[1])
    } else {
        match (from_utf8(r[1])) {
            Result.Ok(m) => Result.Err(m),
            Result.Err(_) => Result.Err("embed: read failed"),
        }
    }
}

/// Lists every key in the embed namespace, in lexicographic order (the order is part of the
/// contract: identical on the VM, the interpreter and the native binary).
pub fn list() -> Result<[string], string> {
    let r = __embed_list();
    if (r[0] == "ok") {
        var keys: [string] = [];
        var i = 1;
        while (i < r.len()) {
            keys.push(r[i]);
            i = i + 1;
        }
        Result.Ok(keys)
    } else {
        Result.Err(r[1])
    }
}
