// std/ffi — helpers de la frontera C (FFI, M41). Complementa a los bloques `extern "lib" { … }`
// del lenguaje: aquí vive lo que acompaña a una llamada C pero no es una llamada C.
/// Reads the calling thread's C `errno`: the reason of the last failed POSIX-style extern call
/// (`fopen`, `unlink`, ...). Read it IMMEDIATELY after the extern call, with no raylang I/O in
/// between: any operation that parks the fiber lets its siblings run on the same thread, and they
/// may overwrite it. Returns 0 in the wasm playground (no FFI there).
pub fn errno() -> int { __ffi_errno() }

// rayffi #215: saber si una librería está ANTES de llamarla (y recibir un pánico del símbolo).
/// Whether the C library `lib` (a short name, as in `extern "lib"`: `"z"`, `"sqlite3"`) can be
/// loaded on this system — the same file names an `extern` block tries (`libz.dylib`, `libz.so`,
/// `z.dll`…). `"c"` and `"m"` are always available. Check it before calling into an optional
/// library; a call into a missing one is a runtime error. In a native binary the libraries of its
/// `extern` blocks are linked at build time (they exist by construction); this still asks the OS
/// for any name. `false` in the web playground and in builds without FFI.
pub fn library_available(lib: string) -> bool { __ffi_lib_available(lib) }

// rayffi #211: el búfer de salida de una extern (`uLongf *destLen`, el `dest` de compress). Una
// copia propia: escribir en él no toca ningún otro valor.
/// `n` zero bytes in a buffer of their own: the output buffer for an extern that writes through a
/// pointer (`compress(dest, &dest_len, …)`). C may write into a `bytes` argument and the program
/// sees the write (and so does every alias of the value); it must not write past `n` or keep the
/// pointer after the call. `n <= 0` gives an empty buffer.
pub fn buffer(n: int) -> bytes {
    if (n <= 0) { b"" } else { "\0".repeat(n).to_bytes() }
}
