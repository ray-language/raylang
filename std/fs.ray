// std/fs — sistema de archivos (M50.1).
//
// Todo lo que toca disco vive aquí (opt-in con `import std/fs;`). Importar este
// módulo es un *capability hint* suave: señala "este archivo toca el sistema de
// archivos". Los envoltorios se apoyan en los primitivos globales `__read_file`/…
// (que devuelven un arreglo etiquetado `["ok", …]` / `["err", msg]`) y los
// traducen a `Result`/`Option`. El único builtin total es `exists` (`__exists`).
// Lee el archivo completo; Ok(contenido) u Err(mensaje del sistema).
/// Reads the whole file as a string; `Ok(contents)` or `Err(system error message)`.
pub fn read_file(path: string) -> Result<string, string> {
    let r = __read_file(path);
    if (r[0] == "ok") { Result.Ok(r[1]) } else { Result.Err(r[1]) }
}

// M16.1c: I/O binaria. Las lecturas devuelven [bytes] etiquetado (tag en bytes para
// arreglo homogéneo); el mensaje de error viene como bytes y se decoda con from_utf8.
/// Reads the whole file as raw bytes; `Ok(bytes)` or `Err(message)` on I/O failure.
pub fn read_file_bytes(path: string) -> Result<bytes, string> {
    let r = __read_file_bytes(path);
    if (r[0] == b"ok") {
        Result.Ok(r[1])
    } else {
        match (from_utf8(r[1])) {
            Result.Ok(m) => Result.Err(m),
            Result.Err(e) => Result.Err("error de E/S"),
        }
    }
}

/// Writes raw bytes to the file (creating or overwriting it); `Ok(byte count)` or `Err(message)`.
pub fn write_file_bytes(path: string, data: bytes) -> Result<int, string> {
    let r = __write_file_bytes(path, data);
    if (r[0] == "ok") { Result.Ok(data.len()) } else { Result.Err(r[1]) }
}

// Escribe el contenido en el archivo (lo crea/sobrescribe); Ok(nº de caracteres) u Err(mensaje).
/// Writes the string to the file (creating or overwriting it); `Ok(character count)` or `Err(message)`.
pub fn write_file(path: string, content: string) -> Result<int, string> {
    let r = __write_file(path, content);
    if (r[0] == "ok") { Result.Ok(content.len()) } else { Result.Err(r[1]) }
}

// Añade el contenido al final del archivo (lo crea si no existe); Ok(nº de caracteres) u Err(mensaje).
/// Appends the string to the end of the file (creating it if needed); `Ok(character count)` or `Err(message)`.
pub fn append_file(path: string, content: string) -> Result<int, string> {
    let r = __append_file(path, content);
    if (r[0] == "ok") { Result.Ok(content.len()) } else { Result.Err(r[1]) }
}

// M11.7c: borra un archivo; Ok(0) u Err(mensaje del sistema).
/// Deletes a file; `Ok(0)` or `Err(system error message)`.
pub fn remove_file(path: string) -> Result<int, string> {
    let r = __remove_file(path);
    if (r[0] == "ok") { Result.Ok(0) } else { Result.Err(r[1]) }
}

// M11.7c: nombres de las entradas de un directorio (ordenados); Ok([nombres]) u Err(mensaje).
// El primitivo devuelve ["ok", n0, n1, …] o ["err", msg]; aquí se reconstruye el [string].
/// Returns the names of a directory's entries, sorted; `Ok(names)` or `Err(message)`.
pub fn list_dir(path: string) -> Result<[string], string> {
    let r = __list_dir(path);
    if (r[0] == "ok") {
        var names: [string] = [];
        var i = 1;
        while (i < r.len()) {
            names.push(r[i]);
            i = i + 1;
        }
        Result.Ok(names)
    } else {
        Result.Err(r[1])
    }
}

/// Whether a file or directory exists at the given path (total; never fails).
pub fn exists(path: string) -> bool {
    __exists(path)
}

// --- M67: directorios y metadatos. Antes el módulo era solo-archivos: sin mkdir no se podía
// crear un directorio, sin is_dir/is_file no se podía recorrer un árbol, y sin rename la
// escritura atómica (temp + rename) era imposible. ---
/// Creates a directory, including any missing parents (like `mkdir -p`); `Ok(0)` or `Err(message)`.
pub fn mkdir(path: string) -> Result<int, string> {
    let r = __mkdir(path);
    if (r[0] == "ok") { Result.Ok(0) } else { Result.Err(r[1]) }
}

/// Removes an EMPTY directory; `Ok(0)` or `Err(message)` (non-empty is an error — recursive
/// removal is deliberately not offered).
pub fn remove_dir(path: string) -> Result<int, string> {
    let r = __remove_dir(path);
    if (r[0] == "ok") { Result.Ok(0) } else { Result.Err(r[1]) }
}

/// Whether the path exists and is a directory (total; never fails).
pub fn is_dir(path: string) -> bool {
    __is_dir(path)
}

/// Whether the path exists and is a regular file (total; never fails).
pub fn is_file(path: string) -> bool {
    __is_file(path)
}

/// Renames (moves) a file or directory; `Ok(0)` or `Err(message)`. On the same filesystem this
/// is atomic — write to a temp file and `rename` it for corruption-safe writes.
pub fn rename(src: string, dst: string) -> Result<int, string> {
    let r = __rename(src, dst);
    if (r[0] == "ok") { Result.Ok(0) } else { Result.Err(r[1]) }
}

/// Copies a file (overwriting the destination); `Ok(0)` or `Err(message)`.
pub fn copy_file(src: string, dst: string) -> Result<int, string> {
    let r = __copy_file(src, dst);
    if (r[0] == "ok") { Result.Ok(0) } else { Result.Err(r[1]) }
}

/// Size of a file in bytes; `Ok(size)` or `Err(message)` (a directory is an error).
pub fn file_size(path: string) -> Result<int, string> {
    let r = __file_size(path);
    if (r[0] == "ok") {
        match (parse_int(r[1])) {
            Option.Some(n) => Result.Ok(n),
            Option.None => Result.Err("tamaño inválido"),
        }
    } else {
        Result.Err(r[1])
    }
}

/// Last-modification time of a file or directory as epoch **milliseconds** UTC (the same
/// currency as `time.now()`); `Ok(epoch_ms)` or `Err(message)` if the path does not exist.
pub fn mtime(path: string) -> Result<int, string> {
    let r = __mtime(path);
    if (r[0] == "ok") {
        match (parse_int(r[1])) {
            Option.Some(n) => Result.Ok(n),
            Option.None => Result.Err("mtime inválido"),
        }
    } else {
        Result.Err(r[1])
    }
}

/// Appends raw bytes to the end of the file (creating it if needed); `Ok(byte count)` or
/// `Err(message)`. Binary twin of `append_file`.
pub fn append_file_bytes(path: string, data: bytes) -> Result<int, string> {
    let r = __append_file_bytes(path, data);
    if (r[0] == "ok") { Result.Ok(data.len()) } else { Result.Err(r[1]) }
}

// --- I/O con buffering: handles de archivo (M11.8). open/read_line/write/close. ---
// Abre un archivo (modo "r"/"w"/"a") y devuelve un handle (int); Err(mensaje) si falla.
/// Opens a file in mode "r" (read), "w" (write) or "a" (append) and returns a
/// buffered handle; `Ok(handle)` or `Err(message)`. Close it with `close(h)`.
pub fn open(path: string, mode: string) -> Result<int, string> {
    let r = __open(path, mode);
    if (r[0] == "ok") {
        match (parse_int(r[1])) {
            Option.Some(h) => Result.Ok(h),
            Option.None => Result.Err("handle inválido"),
        }
    } else {
        Result.Err(r[1])
    }
}

// Lee la siguiente línea del handle (sin el salto); None en EOF (o handle no-lector).
/// Reads the next line from the file handle (without the newline); `None` on EOF
/// (or on a handle that is not open for reading).
pub fn read_line(h: int) -> Option<string> {
    let r = __read_line_handle(h);
    if (r.len() == 0) { Option.None } else { Option.Some(r[0]) }
}

// Escribe en el handle; Ok(nº de caracteres) u Err(mensaje).
/// Writes the string to the file handle; `Ok(character count)` or `Err(message)`.
pub fn write(h: int, s: string) -> Result<int, string> {
    let r = __write_handle(h, s);
    if (r[0] == "ok") { Result.Ok(s.len()) } else { Result.Err(r[1]) }
}

// Lee hasta `max` octetos del handle desde su posición actual (M113). La memoria queda acotada
// por lo leído: es la primitiva para trocear archivos grandes sin cargarlos enteros.
/// Reads up to `max` bytes from the file handle at its current position; `Ok(Some(data))`
/// (exactly `max` bytes unless the end of the file is near), `Ok(None)` on end of file, or
/// `Err(message)` on error or on a handle that is not open for reading. Memory is bounded by
/// what is actually read — the primitive for streaming a large file in chunks.
pub fn read_bytes(h: int, max: int) -> Result<Option<bytes>, string> {
    let r = __read_bytes_handle(h, max);
    if (r[0] == b"ok") {
        Result.Ok(Option.Some(r[1]))
    } else if (r[0] == b"eof") {
        Result.Ok(Option.None)
    } else {
        match (from_utf8(r[1])) {
            Result.Ok(m) => Result.Err(m),
            Result.Err(_) => Result.Err("read error"),
        }
    }
}

// Mueve la posición del handle a `pos` octetos desde el inicio (M113); devuelve la nueva
// posición. Con `read_bytes` da transferencias reanudables (retomar en el offset N).
/// Moves the file handle's position to `pos` bytes from the start and returns the new
/// position; `Ok(position)` or `Err(message)`. Together with `read_bytes` this enables
/// resumable transfers (continue from byte offset N).
pub fn seek(h: int, pos: int) -> Result<int, string> {
    let r = __seek_handle(h, pos);
    if (r[0] == "ok") {
        match (parse_int(r[1])) {
            Option.Some(p) => Result.Ok(p),
            Option.None => Result.Err("posición inválida"),
        }
    } else {
        Result.Err(r[1])
    }
}

// Escribe octetos crudos en la posición actual del handle (M115.1). Es el gemelo binario de
// `write`: sin él, un formato binario en disco (WAL, AOF, bloques) solo podía escribirse por
// RUTA (append_file_bytes), que no compone con un handle abierto ni con seek.
/// Writes raw bytes to the file handle at its current position; `Ok(byte count)` or
/// `Err(message)`. Binary twin of `write`; composes with `seek`.
pub fn write_bytes(h: int, data: bytes) -> Result<int, string> {
    let r = __write_bytes_handle(h, data);
    if (r[0] == "ok") { Result.Ok(data.len()) } else { Result.Err(r[1]) }
}

// Fuerza lo escrito a almacenamiento ESTABLE (fsync) (M115.1). Un write/append llega al page
// cache del SO: es durable ante un crash del proceso, NO ante un corte de luz. sync(h) es la
// pieza que permite prometer durabilidad real (WAL, colas, bases de datos).
/// Flushes the handle's writes and forces them to stable storage (fsync); `Ok(0)` or
/// `Err(message)`. Without it, written data survives a process crash but not a power failure.
pub fn sync(h: int) -> Result<int, string> {
    let r = __sync_handle(h);
    if (r[0] == "ok") { Result.Ok(0) } else { Result.Err(r[1]) }
}

// Candado consultivo EXCLUSIVO del archivo, sin bloquear (M115.2, flock). El patrón estándar del
// proceso único: abrir un archivo LOCK al arrancar y try_lock — dos brokers sobre el mismo
// directorio ya no se doble-entregan en silencio. Consultivo: solo protege frente a procesos que
// también lo piden. Un lock BLOQUEANTE queda fuera a propósito (congelaría todas las fibras).
/// Tries to take an EXCLUSIVE advisory lock on the file without blocking (flock);
/// `Ok(true)` = acquired, `Ok(false)` = another process (or another handle) holds it,
/// `Err(message)` on a real error. The lock is released by `unlock` or by `close`.
pub fn try_lock(h: int) -> Result<bool, string> {
    let r = __try_lock_handle(h);
    if (r[0] == "ok") { Result.Ok(r[1] == "1") } else { Result.Err(r[1]) }
}

/// Releases the advisory lock on the file handle; `Ok(0)` or `Err(message)`. Closing the
/// handle also releases it.
pub fn unlock(h: int) -> Result<int, string> {
    let r = __unlock_handle(h);
    if (r[0] == "ok") { Result.Ok(0) } else { Result.Err(r[1]) }
}

// --- M115.3: metadatos y permisos. `stat` NO sigue symlinks (lstat): así un symlink se DETECTA
// (kind "symlink") en vez de seguirse a ciegas — lo que un sync/backup fiel necesita. Los
// helpers totales (is_dir/is_file/mtime/file_size) siguen resolviendo symlinks, como siempre. ---
/// File metadata, WITHOUT following symlinks (lstat semantics): a symlink reports its own
/// kind/size instead of its target's. See `stat`.
pub struct Stat {
    /// "file", "dir", "symlink" or "other" (socket, FIFO, device…).
    kind: string,
    /// Permission bits (the low 12 bits), as an int: 0o600 is 384, 0o755 is 493.
    mode: int,
    /// Size in bytes (for a symlink: the length of the link itself).
    size: int,
    /// Last modification, epoch milliseconds UTC (the same currency as `time.now()`).
    mtime_ms: int,
}

/// Metadata of the path WITHOUT following symlinks; `Ok(Stat)` or `Err(message)` if the path
/// does not exist. A symlink reports kind "symlink" — the way to even detect one.
pub fn stat(path: string) -> Result<Stat, string> {
    let r = __stat(path);
    if (r[0] == "ok") {
        let mode = parse_int(r[2]).unwrap_or(0);
        let size = parse_int(r[3]).unwrap_or(0);
        let mt = parse_int(r[4]).unwrap_or(0);
        Result.Ok(Stat { kind: r[1], mode: mode, size: size, mtime_ms: mt })
    } else {
        Result.Err(r[1])
    }
}

/// Sets the file's permission bits (chmod, the low 12 bits); `Ok(0)` or `Err(message)`.
/// The mode is a plain int: 384 is 0o600 (owner read/write), 493 is 0o755.
pub fn chmod(path: string, mode: int) -> Result<int, string> {
    let r = __chmod(path, mode);
    if (r[0] == "ok") { Result.Ok(0) } else { Result.Err(r[1]) }
}

// --- M115.4: watch de filesystem por EVENTOS DE KERNEL (FSEvents/inotify), no por sondeo de
// mtimes. Un directorio se observa RECURSIVO; un archivo, a sí mismo. Los eventos pueden llegar
// agrupados o con kinds gruesos según la plataforma — trata el evento como "algo cambió aquí" y
// re-examina, no como una bitácora exacta. `close(h)` detiene el watch. ---
/// One filesystem change: `kind` is "create", "modify", "remove", "rename" or "other", and
/// `path` is the affected file or directory.
pub struct WatchEvent {
    kind: string,
    path: string,
}

/// Watches a file or a directory (directories recursively) for changes, via kernel events —
/// not mtime polling. Returns a watch handle; read events with `next_event` and stop with
/// `close(h)`.
pub fn watch(path: string) -> Result<int, string> {
    let r = __watch(path);
    if (r[0] == "ok") {
        match (parse_int(r[1])) {
            Option.Some(h) => Result.Ok(h),
            Option.None => Result.Err("handle inválido"),
        }
    } else {
        Result.Err(r[1])
    }
}

/// The next change event, waiting as long as it takes (the fiber parks — the process sleeps,
/// it does not poll); `Err` if the handle is closed or invalid.
pub fn next_event(h: int) -> Result<WatchEvent, string> {
    let r = __watch_next(h, 0);
    if (r[0] == "ok") {
        Result.Ok(WatchEvent { kind: r[1], path: r[2] })
    } else {
        Result.Err(r[1])
    }
}

/// The next change event with a deadline: `Ok(Some(event))`, or `Ok(None)` if `timeout_ms`
/// elapsed with no change. Useful to coalesce bursts (rebuild once after 200 ms of quiet).
pub fn next_event_timeout(h: int, timeout_ms: int) -> Result<Option<WatchEvent>, string> {
    let r = __watch_next(h, timeout_ms);
    if (r[0] == "ok") {
        Result.Ok(Option.Some(WatchEvent { kind: r[1], path: r[2] }))
    } else if (r[0] == "timeout") {
        Result.Ok(Option.None)
    } else {
        Result.Err(r[1])
    }
}
