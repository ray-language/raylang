// std/image (M144) — decodificación PNG en raylang puro (IDEAS §77).
//
// El caso que lo motiva: "cargo un sprite.png" desde un juego/TUI. La pieza dura (DEFLATE) ya
// existía — std/inflate trae zlib_inflate endurecido (M64) — así que este módulo es el parser
// PNG encima: chunks con CRC verificado, des-filtrado por scanline (None/Sub/Up/Average/Paeth),
// tipos de color 0/2/3/4/6 con profundidades 1/2/4/8/16, paleta + tRNS. La salida SIEMPRE es
// RGBA8 (4 octetos por píxel, filas de arriba a abajo): un solo formato de consumo, decidido
// aquí y no en cada llamador.
//
// Decisiones de v1: Adam7 (entrelazado) se rechaza con error claro — raro en assets y su
// des-entrelazado es un módulo entero; los canales de 16 bits se reducen a 8 tomando el octeto
// alto (la convención de los decodificadores de assets); el color-key tRNS de los tipos 0/2 se
// aplica en profundidad 8/16. Espíritu M64: TODO input corrupto/truncado es `Err` con mensaje,
// nunca un error de índice — cada lectura verifica límites antes.

import std/inflate;
import std/deflate;

/// A decoded raster image: RGBA8, row-major, top-to-bottom, 4 bytes per pixel
/// (`pixels.len() == width * height * 4`). Whatever the source PNG stored (grayscale,
/// palette, 16-bit…), pixels always come out as 8-bit RGBA.
pub struct Image {
    width: int,
    height: int,
    pixels: bytes,
}

/// Decodes a PNG file into an RGBA8 `Image`. Verifies the signature and every chunk CRC,
/// inflates the zlib stream with an anti-bomb output cap, and un-filters each scanline.
/// Color types 0/2/3/4/6 with bit depths 1/2/4/8/16 are supported (16-bit channels are
/// reduced to 8 by taking the high byte; palette `tRNS` alpha applies, and the color-key
/// `tRNS` of types 0/2 applies at depths 8/16). Interlaced (Adam7) PNGs return an error —
/// deferred, rare in assets. Any corrupt or truncated input is an `Err`, never a crash.
pub fn decode_png(data: bytes) -> Result<Image, string> {
    if (data.len() < 8) {
        return Result.Err("png: too short for the signature");
    }
    // La firma: 137 80 78 71 13 10 26 10.
    let sig = [137, 80, 78, 71, 13, 10, 26, 10];
    var s = 0;
    while (s < 8) {
        if (data[s] != sig[s]) {
            return Result.Err("png: bad signature");
        }
        s = s + 1;
    }

    // Estado del recorrido de chunks.
    var width = 0;
    var height = 0;
    var bit_depth = 0;
    var color_type = 0;
    var seen_ihdr = false;
    var seen_iend = false;
    var palette: [int] = [];
    var trns: [int] = [];
    var idat: [int] = [];

    var i = 8;
    while (!seen_iend) {
        if (i + 8 > data.len()) {
            return Result.Err("png: truncated chunk header");
        }
        let clen = be32(data, i);
        let t0 = data[i + 4];
        let t1 = data[i + 5];
        let t2 = data[i + 6];
        let t3 = data[i + 7];
        if (clen < 0 || i + 12 + clen > data.len()) {
            return Result.Err("png: truncated chunk data");
        }
        // CRC del chunk: sobre tipo + datos.
        let crc_stored = be32(data, i + 8 + clen);
        let crc_input = sub_bytes(data, i + 4, clen + 4);
        if (inflate.crc32(crc_input) != crc_stored) {
            return Result.Err("png: chunk crc mismatch");
        }
        let body = i + 8;
        if (t0 == 73 && t1 == 72 && t2 == 68 && t3 == 82) {
            // IHDR
            if (clen != 13) {
                return Result.Err("png: IHDR must be 13 bytes");
            }
            width = be32(data, body);
            height = be32(data, body + 4);
            bit_depth = data[body + 8];
            color_type = data[body + 9];
            if (data[body + 10] != 0) {
                return Result.Err("png: unknown compression method");
            }
            if (data[body + 11] != 0) {
                return Result.Err("png: unknown filter method");
            }
            if (data[body + 12] == 1) {
                return Result.Err("png: interlaced (Adam7) is not supported");
            }
            if (data[body + 12] != 0) {
                return Result.Err("png: unknown interlace method");
            }
            if (width <= 0 || height <= 0) {
                return Result.Err("png: invalid dimensions");
            }
            if (width * height > 67108864) {
                return Result.Err("png: image too large (over 64 megapixels)");
            }
            if (!valid_depth(color_type, bit_depth)) {
                return Result.Err("png: invalid bit depth for the color type");
            }
            seen_ihdr = true;
        } else if (t0 == 80 && t1 == 76 && t2 == 84 && t3 == 69) {
            // PLTE: triples RGB.
            if (clen % 3 != 0 || clen > 768) {
                return Result.Err("png: invalid PLTE length");
            }
            var j = 0;
            while (j < clen) {
                palette.push(data[body + j]);
                j = j + 1;
            }
        } else if (t0 == 116 && t1 == 82 && t2 == 78 && t3 == 83) {
            // tRNS: alfas de paleta (tipo 3) o color-key (tipos 0/2).
            var j = 0;
            while (j < clen) {
                trns.push(data[body + j]);
                j = j + 1;
            }
        } else if (t0 == 73 && t1 == 68 && t2 == 65 && t3 == 84) {
            // IDAT: el flujo zlib, concatenado entre todos los IDAT.
            var j = 0;
            while (j < clen) {
                idat.push(data[body + j]);
                j = j + 1;
            }
        } else if (t0 == 73 && t1 == 69 && t2 == 78 && t3 == 68) {
            seen_iend = true;
        }
        // Cualquier otro chunk (ancillary: gAMA, pHYs, tEXt…) se salta.
        i = i + 12 + clen;
    }
    if (!seen_ihdr) {
        return Result.Err("png: missing IHDR");
    }
    if (color_type == 3 && palette.len() == 0) {
        return Result.Err("png: palette color type without PLTE");
    }

    // Infla el flujo zlib con tope anti-bomba: el tamaño crudo exacto es
    // alto * (1 + stride) — un octeto de filtro por scanline.
    let ch = channels_of(color_type);
    let stride = (width * ch * bit_depth + 7) / 8;
    let raw_len = height * (1 + stride);
    let inflated = inflate.zlib_inflate_limit(bytes_of(idat), raw_len);
    match (inflated) {
        Result.Err(e) => Result.Err("png: " + e),
        Result.Ok(raw) => {
            if (raw.len() != raw_len) {
                return Result.Err("png: decompressed size does not match the dimensions");
            }
            match (unfilter(raw, height, stride, filter_bpp(ch, bit_depth))) {
                Result.Err(e) => Result.Err(e),
                Result.Ok(recon) => {
                    to_rgba(recon, width, height, stride, color_type, bit_depth, palette, trns)
                },
            }
        },
    }
}

// ¿La profundidad es legal para el tipo de color? (Tabla del spec §11.2.2.)
fn valid_depth(color_type: int, depth: int) -> bool {
    if (color_type == 0) {
        return depth == 1 || depth == 2 || depth == 4 || depth == 8 || depth == 16;
    }
    if (color_type == 3) {
        return depth == 1 || depth == 2 || depth == 4 || depth == 8;
    }
    if (color_type == 2 || color_type == 4 || color_type == 6) {
        return depth == 8 || depth == 16;
    }
    false
}

// Canales por tipo de color: gris 1, RGB 3, paleta 1, gris+alfa 2, RGBA 4.
fn channels_of(color_type: int) -> int {
    if (color_type == 2) {
        return 3;
    }
    if (color_type == 4) {
        return 2;
    }
    if (color_type == 6) {
        return 4;
    }
    1
}

// El "bpp" del filtrado: octetos por píxel completo, redondeando hacia ARRIBA a 1 (spec §9.2):
// la distancia a la que Sub/Average/Paeth miran al vecino de la izquierda.
fn filter_bpp(channels: int, depth: int) -> int {
    let bits = channels * depth;
    if (bits < 8) {
        return 1;
    }
    bits / 8
}

// Entero big-endian de 32 bits en `data[i..i+4]` (el llamador ya verificó los límites).
fn be32(data: bytes, i: int) -> int {
    data[i] * 16777216 + data[i + 1] * 65536 + data[i + 2] * 256 + data[i + 3]
}

// Sub-secuencia de bytes [start, start+len) como `bytes` nuevo.
fn sub_bytes(data: bytes, start: int, len: int) -> bytes {
    var out: [int] = [];
    var j = 0;
    while (j < len) {
        out.push(data[start + j]);
        j = j + 1;
    }
    bytes_of(out)
}

// Des-filtra las scanlines (spec §9): cada fila llega como [tipo_de_filtro | octetos] y se
// reconstruye contra la fila anterior. Devuelve los octetos crudos SIN los bytes de filtro.
fn unfilter(raw: bytes, height: int, stride: int, bpp: int) -> Result<[int], string> {
    var recon: [int] = [];
    var y = 0;
    while (y < height) {
        let row_start = y * (1 + stride);
        let ftype = raw[row_start];
        if (ftype < 0 || ftype > 4) {
            return Result.Err("png: unknown filter type " + to_string(ftype));
        }
        var x = 0;
        while (x < stride) {
            let filt = raw[row_start + 1 + x];
            // a = izquierda, b = arriba, c = arriba-izquierda (0 fuera de rango).
            var a = 0;
            if (x >= bpp) {
                a = recon[y * stride + x - bpp];
            }
            var b = 0;
            if (y > 0) {
                b = recon[(y - 1) * stride + x];
            }
            var c = 0;
            if (x >= bpp && y > 0) {
                c = recon[(y - 1) * stride + x - bpp];
            }
            var value = filt;
            if (ftype == 1) {
                value = filt + a;
            } else if (ftype == 2) {
                value = filt + b;
            } else if (ftype == 3) {
                value = filt + (a + b) / 2;
            } else if (ftype == 4) {
                value = filt + paeth(a, b, c);
            }
            recon.push(value % 256);
            x = x + 1;
        }
        y = y + 1;
    }
    Result.Ok(recon)
}

// El predictor de Paeth (spec §9.4): el vecino más cercano a a+b-c.
fn paeth(a: int, b: int, c: int) -> int {
    let p = a + b - c;
    var pa = p - a;
    if (pa < 0) {
        pa = -pa;
    }
    var pb = p - b;
    if (pb < 0) {
        pb = -pb;
    }
    var pc = p - c;
    if (pc < 0) {
        pc = -pc;
    }
    if (pa <= pb && pa <= pc) {
        return a;
    }
    if (pb <= pc) {
        return b;
    }
    c
}

// La muestra j-ésima de una fila reconstruida: para profundidades 1/2/4 el empaquetado es
// MSB-first dentro del octeto; para 8 es directa; para 16 se toma el octeto ALTO (reducción a
// 8 bits). `row_off` es el inicio de la fila en `recon`.
fn sample_at(recon: [int], row_off: int, j: int, depth: int) -> int {
    if (depth == 8) {
        return recon[row_off + j];
    }
    if (depth == 16) {
        return recon[row_off + j * 2];
    }
    let bit = j * depth;
    let byte = recon[row_off + bit / 8];
    let shift = 8 - depth - bit % 8;
    let mask = 1 << depth;
    (byte >> shift) % mask
}

// Escala una muestra de `depth` bits a 8 (255 * v / máximo); las de 8/16 ya vienen a escala.
fn scale_sample(v: int, depth: int) -> int {
    if (depth >= 8) {
        return v;
    }
    let top = (1 << depth) - 1;
    v * 255 / top
}

// Expande las filas reconstruidas al RGBA8 final según el tipo de color.
fn to_rgba(
    recon: [int],
    width: int,
    height: int,
    stride: int,
    color_type: int,
    depth: int,
    palette: [int],
    trns: [int]
) -> Result<Image, string> {
    let ch = channels_of(color_type);
    var out: [int] = [];
    var y = 0;
    while (y < height) {
        let row = y * stride;
        var x = 0;
        while (x < width) {
            if (color_type == 3) {
                // Paleta: la muestra es el índice; el alfa sale del tRNS si lo cubre.
                let idx = sample_at(recon, row, x, depth);
                if (idx * 3 + 2 >= palette.len()) {
                    return Result.Err("png: palette index out of range");
                }
                out.push(palette[idx * 3]);
                out.push(palette[idx * 3 + 1]);
                out.push(palette[idx * 3 + 2]);
                if (idx < trns.len()) {
                    out.push(trns[idx]);
                } else {
                    out.push(255);
                }
            } else if (color_type == 0) {
                let g = sample_at(recon, row, x, depth);
                let v = scale_sample(g, depth);
                var alpha = 255;
                // Color-key: el tRNS trae el gris transparente en 2 octetos big-endian. Con 16
                // bits la muestra quedó reducida al octeto ALTO → se compara contra ese.
                if (trns.len() == 2) {
                    let key = trns[0] * 256 + trns[1];
                    if (depth == 16 && g == key / 256) {
                        alpha = 0;
                    }
                    if (depth == 8 && g == key % 256) {
                        alpha = 0;
                    }
                }
                out.push(v);
                out.push(v);
                out.push(v);
                out.push(alpha);
            } else if (color_type == 2) {
                let r = sample_at(recon, row, x * 3, depth);
                let g = sample_at(recon, row, x * 3 + 1, depth);
                let b = sample_at(recon, row, x * 3 + 2, depth);
                var alpha = 255;
                if (trns.len() == 6 && depth >= 8) {
                    let kr = trns[0] * 256 + trns[1];
                    let kg = trns[2] * 256 + trns[3];
                    let kb = trns[4] * 256 + trns[5];
                    if (depth == 16 && r == kr / 256 && g == kg / 256 && b == kb / 256) {
                        alpha = 0;
                    }
                    if (depth == 8 && r == kr % 256 && g == kg % 256 && b == kb % 256) {
                        alpha = 0;
                    }
                }
                out.push(r);
                out.push(g);
                out.push(b);
                out.push(alpha);
            } else if (color_type == 4) {
                let g = sample_at(recon, row, x * 2, depth);
                let a = sample_at(recon, row, x * 2 + 1, depth);
                out.push(g);
                out.push(g);
                out.push(g);
                out.push(a);
            } else {
                // Tipo 6: RGBA directo.
                out.push(sample_at(recon, row, x * 4, depth));
                out.push(sample_at(recon, row, x * 4 + 1, depth));
                out.push(sample_at(recon, row, x * 4 + 2, depth));
                out.push(sample_at(recon, row, x * 4 + 3, depth));
            }
            x = x + 1;
        }
        y = y + 1;
    }
    Result.Ok(Image { width: width, height: height, pixels: bytes_of(out) })
}

/// Encodes an RGBA8 `Image` as a PNG file (color type 6, 8-bit channels, no interlace),
/// the exact format `decode_png` produces — so `decode_png(encode_png(img))` round-trips
/// byte for byte. Scanlines use filter None; the zlib stream comes from `std/deflate`.
/// Returns `Err` if the dimensions are not positive or `pixels.len() != width * height * 4`.
pub fn encode_png(img: Image) -> Result<bytes, string> {
    if (img.width <= 0 || img.height <= 0) {
        return Result.Err("png: invalid dimensions");
    }
    if (img.width * img.height > 67108864) {
        return Result.Err("png: image too large (over 64 megapixels)");
    }
    if (img.pixels.len() != img.width * img.height * 4) {
        return Result.Err("png: pixels must hold width * height * 4 bytes (RGBA8)");
    }
    // Scanlines crudas: un octeto de filtro (0 = None) + la fila RGBA tal cual.
    let stride = img.width * 4;
    var raw: [int] = [];
    var y = 0;
    while (y < img.height) {
        raw.push(0);
        var x = 0;
        while (x < stride) {
            raw.push(img.pixels[y * stride + x]);
            x = x + 1;
        }
        y = y + 1;
    }
    var ihdr: [int] = [];
    push_be32(ihdr, img.width);
    push_be32(ihdr, img.height);
    ihdr.push(8);  // profundidad: 8 bits por canal
    ihdr.push(6);  // tipo de color: RGBA
    ihdr.push(0);  // compresión: deflate
    ihdr.push(0);  // filtro: adaptativo (por scanline)
    ihdr.push(0);  // sin entrelazado
    let idat = deflate.zlib_compress(bytes_of(raw));
    var out: [int] = [137, 80, 78, 71, 13, 10, 26, 10];
    push_chunk(out, [73, 72, 68, 82], ihdr);
    push_chunk(out, [73, 68, 65, 84], to_ints(idat));
    push_chunk(out, [73, 69, 78, 68], []);
    Result.Ok(bytes_of(out))
}

// Entero big-endian de 32 bits al final de `out`.
fn push_be32(out: [int], v: int) {
    out.push(v >> 24 & 255);
    out.push(v >> 16 & 255);
    out.push(v >> 8 & 255);
    out.push(v & 255);
}

// Un chunk PNG al final de `out`: longitud BE32, tipo (4 octetos), datos y CRC-32 sobre
// tipo + datos (spec §5.3).
fn push_chunk(out: [int], kind: [int], data: [int]) {
    push_be32(out, data.len());
    var crc_input: [int] = [];
    var i = 0;
    while (i < 4) {
        crc_input.push(kind[i]);
        i = i + 1;
    }
    var j = 0;
    while (j < data.len()) {
        crc_input.push(data[j]);
        j = j + 1;
    }
    var k = 0;
    while (k < crc_input.len()) {
        out.push(crc_input[k]);
        k = k + 1;
    }
    push_be32(out, inflate.crc32(bytes_of(crc_input)));
}

// `bytes` → `[int]` (octeto a octeto).
fn to_ints(b: bytes) -> [int] {
    var out: [int] = [];
    var i = 0;
    while (i < b.len()) {
        out.push(b[i]);
        i = i + 1;
    }
    out
}
