// std/io (M107.1/M107.2) — consola por bytes: escritura SIN salto de línea, flush, y lectura de
// stdin por bytes.
//
// `print`/`eprint` siempre añaden '\n' e `input()` lee por líneas; este módulo cubre lo demás:
// prompts, barras de progreso, secuencias de escape de terminal, salida incremental y lectura de
// teclas. Envuelve los primitivos (arreglos etiquetados) en `Result`/`Option`/`ReadResult`.
//
// Buffering: stdout va line-buffered — un `write` sin salto puede no verse hasta `flush()` (o el
// fin del proceso). stderr no tiene buffer: `ewrite` es visible al instante.
//
// Lectura: `read`/`read_timeout` van al fd CRUDO (sin el buffer de líneas de `input()`): mezclar
// `input()`/`fs.read_line` de stdin con `io.read` en el mismo programa no está soportado. En la VM,
// una lectura sin datos APARCA la fibra (las demás siguen corriendo); un solo lector a la vez.

// Escribe a stdout sin salto; Ok(nº de caracteres) u Err(mensaje).
/// Writes the string to stdout WITHOUT a trailing newline; `Ok(character count)` or
/// `Err(message)`. Buffered: call `flush()` to make it visible before the next newline.
pub fn write(s: string) -> Result<int, string> {
    let r = __stdout_write(s);
    if (r[0] == "ok") { Result.Ok(s.len()) } else { Result.Err(r[1]) }
}

// Escribe a stderr sin salto; sin buffer (visible al instante).
/// Writes the string to stderr WITHOUT a trailing newline; `Ok(character count)` or
/// `Err(message)`. Unbuffered: visible immediately, no flush needed.
pub fn ewrite(s: string) -> Result<int, string> {
    let r = __stderr_write(s);
    if (r[0] == "ok") { Result.Ok(s.len()) } else { Result.Err(r[1]) }
}

// Escribe bytes crudos a stdout (secuencias de escape, salida binaria).
/// Writes raw bytes to stdout (terminal escape sequences, binary output);
/// `Ok(byte count)` or `Err(message)`. Buffered, like `write`.
pub fn write_bytes(b: bytes) -> Result<int, string> {
    let r = __stdout_write_bytes(b);
    if (r[0] == "ok") { Result.Ok(b.len()) } else { Result.Err(r[1]) }
}

// Vacía el buffer de stdout.
/// Flushes stdout's buffer; `Ok(0)` or `Err(message)`. Needed after `write`/`write_bytes`
/// when the output must be visible before the next newline (prompts, progress bars).
pub fn flush() -> Result<int, string> {
    let r = __stdout_flush();
    if (r[0] == "ok") { Result.Ok(0) } else { Result.Err(r[1]) }
}

// El resultado de una lectura con plazo: datos, fin de la entrada, o plazo vencido.
/// The outcome of a read with a timeout: data, end of input, or deadline expired.
pub enum ReadResult {
    Data(bytes),
    Eof,
    TimedOut,
}

// Lee hasta max octetos de stdin; None = EOF. Bloquea la FIBRA (no la VM) hasta que haya datos.
/// Reads up to `max` bytes from stdin; `Some(bytes)` (1..=max) or `None` on end of input.
/// Blocks only the calling fiber: other fibers keep running while it waits.
pub fn read(max: int) -> Option<bytes> {
    let r = __stdin_read(max);
    if (r.len() == 0) { Option.None } else { Option.Some(r[0]) }
}

// Lee hasta max octetos esperando a lo sumo timeout_ms (0 = sondeo puro).
/// Reads up to `max` bytes from stdin, waiting at most `timeout_ms` milliseconds
/// (0 = pure poll). Returns `Data(bytes)`, `Eof`, or `TimedOut`.
pub fn read_timeout(max: int, timeout_ms: int) -> ReadResult {
    let r = __stdin_read_timeout(max, timeout_ms);
    if (r[0] == b"data") {
        ReadResult.Data(r[1])
    } else if (r[0] == b"eof") {
        ReadResult.Eof
    } else {
        ReadResult.TimedOut
    }
}
