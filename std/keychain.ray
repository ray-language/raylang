// std/keychain (M266, ray-sublime §96) — secretos en el LLAVERO DEL SISTEMA.
//
// Sobre el primitivo __keychain del runtime: Keychain Services en macOS, Secret Service (libsecret,
// gnome-keyring/KWallet) en Linux, Credential Manager en Windows. Un secreto se identifica por
// (service, account) — "mi-app" + "anthropic_api_key" — y es texto UTF-8: tokens, claves de API,
// contraseñas. Con RAY_KEYCHAIN_FILE=<ruta> en el entorno, un archivo plano (0600) hace de llavero:
// la vía de los tests y del CI, nunca de producción.

/// Reads the secret stored under `service`/`account`: `Ok(Some(secret))`, or `Ok(None)` when there
/// is none. `Err` when the system keychain is unavailable (no Secret Service daemon on Linux, a
/// slim build) or refuses the access.
pub fn get(service: string, account: string) -> Result<Option<string>, string> {
    let r = __keychain("get", service, account, "");
    if (r[0] == "ok") {
        Result.Ok(Option.Some(r[1]))
    } else if (r[0] == "none") {
        Result.Ok(Option.None)
    } else {
        Result.Err(r[1])
    }
}

/// Stores `secret` under `service`/`account`, replacing whatever was there. `service` and
/// `account` must be non-empty and free of NUL, tab and newline.
pub fn set(service: string, account: string, secret: string) -> Result<int, string> {
    let r = __keychain("set", service, account, secret);
    if (r[0] == "ok") { Result.Ok(0) } else { Result.Err(r[1]) }
}

/// Removes the secret under `service`/`account`: `Ok(true)` if there was one, `Ok(false)` if not.
pub fn delete(service: string, account: string) -> Result<bool, string> {
    let r = __keychain("delete", service, account, "");
    if (r[0] == "ok") { Result.Ok(r[1] == "true") } else { Result.Err(r[1]) }
}
