// std/kv — estado clave/valor persistido en raylang puro (IDEAS §48 G-rev, 21 jul 2026).
//
// El caso que lo motiva: conservar sesiones/config entre reloads de `ray dev` sin
// arrastrar una base de datos entera. Un `Store` es un `Map<string, bytes>` en memoria
// respaldado por un archivo con formato binario propio (RKV1): magic + nº de entradas +
// `[u32 klen | clave utf8 | u32 vlen | valor]*`, todo little-endian. La serialización es
// determinista gratis (las `keys()` del Map van ordenadas) y la escritura es atómica
// (temp + `rename`, mismo patrón que documenta std/fs). Cadencia recomendada en dev:
// cargar al boot, `save()` tras el drenado graceful — un write por reload.
//
// La API va por MÉTODOS de trait (`s.get(k)`, `s.save()`), no por funciones libres:
// una función libre `get(Store, …)` ganaría al builtin `get` del Map en la resolución
// UFCS y rompería `self.data.get(k)` dentro del propio módulo (visible en el LSP, que
// analiza el archivo sin namespacing de import). El despacho por receptor lo esquiva
// — mismo patrón que el trait `Matcher` de std/regex (M59.2) — y además los métodos
// SÍ cruzan módulos (UFCS a función libre importada no).
//
// Módulo puro (ambos motores, cero primitivos nuevos). La compartición entre fibras
// bajo multicore (actor CSP dueño del Store) y el session store del paquete web van
// encima de esto (G.2), no aquí.
import std/fs;

/// A persistent key/value store: an in-memory `Map<string, bytes>` backed by a file.
/// Create with `kv.open(path)`; operate through the `StoreOps` methods (`s.get(k)`,
/// `s.set(k, v)`, `s.save()`). Mutations touch only memory; `save` persists atomically.
/// Typical dev-state cadence: `open` at boot, `save` once on graceful shutdown.
pub struct Store {
    path: string,
    data: Map<string, bytes>,
}

/// Opens the store at `path`. A missing file yields an empty store; an existing file
/// that cannot be read or decoded is an error (never silently discards data).
pub fn open(path: string) -> Result<Store, string> {
    if (fs.exists(path)) {
        let b = fs.read_file_bytes(path)?;
        let m = decode(b)?;
        Result.Ok(Store { path: path, data: m })
    } else {
        Result.Ok(empty(path))
    }
}

/// A fresh, empty in-memory store bound to `path` WITHOUT reading the file — for
/// state that should start clean and only touch disk if `save` is ever called.
pub fn empty(path: string) -> Store {
    let m: Map<string, bytes> = Map.new();
    Store { path: path, data: m }
}

/// The operations of a `Store`, in method-call style.
pub trait StoreOps {
    /// Returns the value stored under `key`, if any.
    fn get(self, key: string) -> Option<bytes>;
    /// Stores `val` under `key` (in memory; call `save` to persist).
    fn set(self, key: string, val: bytes);
    /// Removes `key` from the store; returns whether it was present.
    fn delete(self, key: string) -> bool;
    /// The keys currently in the store, sorted.
    fn keys(self) -> [string];
    /// Number of entries in the store.
    fn count(self) -> int;
    /// Returns the value under `key` decoded as UTF-8; `None` when the key is
    /// absent or the stored bytes are not valid UTF-8.
    fn get_string(self, key: string) -> Option<string>;
    /// Stores a string value, UTF-8 encoded (sugar over `set`).
    fn set_string(self, key: string, val: string);
    /// Persists the store atomically: writes `<path>.tmp` and renames it over `path`
    /// (a crash mid-write never corrupts the previous state). Returns the bytes written.
    fn save(self) -> Result<int, string>;
    /// Atomically adds `delta` to the integer under `key` and returns the new value;
    /// an absent key counts as 0. The value is stored as decimal UTF-8 (readable with
    /// `get_string`). `Err` when the existing value is not a decimal integer. On a
    /// `SharedStore` the whole read-modify-write runs inside the owner fiber — safe
    /// under concurrent callers (M154).
    fn incr(self, key: string, delta: int) -> Result<int, string>;
    /// Compare-and-set: stores `new` under `key` only when the current value equals
    /// `expected` (`Option.None` = only when the key is absent). Returns whether it
    /// stored. The general escape for read-modify-write beyond counters (M154).
    fn set_if(self, key: string, expected: Option<bytes>, new: bytes) -> bool;
}

impl StoreOps for Store {
    fn get(self, key: string) -> Option<bytes> {
        self.data.get(key)
    }

    fn set(self, key: string, val: bytes) {
        self.data.insert(key, val);
    }

    fn delete(self, key: string) -> bool {
        match (self.data.remove(key)) {
            Option.Some(v) => true,
            Option.None => false,
        }
    }

    fn keys(self) -> [string] {
        self.data.keys()
    }

    fn count(self) -> int {
        self.data.len()
    }

    fn get_string(self, key: string) -> Option<string> {
        match (self.data.get(key)) {
            Option.Some(b) => {
                match (from_utf8(b)) {
                    Result.Ok(v) => Option.Some(v),
                    Result.Err(e) => Option.None,
                }
            },
            Option.None => Option.None,
        }
    }

    fn set_string(self, key: string, val: string) {
        self.data.insert(key, val.to_bytes());
    }

    fn save(self) -> Result<int, string> {
        let b = encode(self.data);
        let tmp = self.path + ".tmp";
        fs.write_file_bytes(tmp, b)?;
        fs.rename(tmp, self.path)?;
        Result.Ok(b.len())
    }

    // M154: sobre el Store local (una sola fibra dueña) el read-modify-write es
    // trivialmente atómico. Ausente = 0; presente-pero-no-entero = Err (errores como
    // valores — jamás un reset silencioso).
    fn incr(self, key: string, delta: int) -> Result<int, string> {
        let current = match (self.data.get(key)) {
            Option.None => 0,
            Option.Some(b) => {
                let txt = match (from_utf8(b)) {
                    Result.Ok(t) => t,
                    Result.Err(_) => {
                        return Result.Err("kv: the value at key '" + key + "' is not an integer");
                    },
                };
                match (parse_int(txt)) {
                    Option.Some(n) => n,
                    Option.None => {
                        return Result.Err("kv: the value at key '" + key + "' is not an integer");
                    },
                }
            },
        };
        let next = current + delta;
        self.data.insert(key, to_string(next).to_bytes());
        Result.Ok(next)
    }

    fn set_if(self, key: string, expected: Option<bytes>, new: bytes) -> bool {
        let hit = match (self.data.get(key)) {
            Option.None => {
                match (expected) {
                    Option.None => true,
                    Option.Some(_) => false,
                }
            },
            Option.Some(current) => {
                match (expected) {
                    Option.Some(want) => current == want,
                    Option.None => false,
                }
            },
        };
        if (hit) {
            self.data.insert(key, new);
        }
        hit
    }
}

// --- G.2: el store COMPARTIDO entre fibras (actor CSP) ---
//
// Bajo el pool M:N (M38) los heaps de fibra están aislados: un `Store` no puede
// compartirse — al cruzar un canal se copia profundo y los alias divergen. El patrón
// del proyecto (actor de métricas, M38) aplica tal cual: UNA fibra posee el `Store`
// y las demás le hablan por un canal de peticiones; el id de canal sí se comparte al
// transferir. FIFO da la coherencia: un `get` ve todos los `set` encolados antes.
// `impl StoreOps for SharedStore` → la MISMA API sirve local y compartido. VM y nativo
// (spawn/canales); el intérprete da su error limpio de siempre.
// Los mensajes al actor. Las peticiones con respuesta llevan su canal de reply.
enum KvMsg {
    Get(string, Channel<Option<bytes>>),
    Set(string, bytes),
    Delete(string, Channel<bool>),
    Keys(Channel<[string]>),
    Count(Channel<int>),
    Save(Channel<Result<int, string>>),
    Incr(string, int, Channel<Result<int, string>>),
    SetIf(string, Option<bytes>, bytes, Channel<bool>),
}

/// A `Store` owned by a dedicated fiber, shared between fibers through a request
/// channel. Create with `kv.share(store)` or `kv.open_shared(path)`; use the same
/// `StoreOps` methods as a local `Store` (`sh.get(k)`, `sh.save()`, …). Requests are
/// served in FIFO order, so a `get` observes every `set` sent before it on the same
/// handle. Stop the owner fiber with `kv.stop(sh)`; a stopped store must not be used.
pub struct SharedStore {
    ch: Channel<KvMsg>,
}

/// Moves `s` into a dedicated owner fiber and returns the shared handle. The fiber
/// gets its own copy of the store — do not keep using `s` after sharing it.
pub fn share(s: Store) -> SharedStore {
    let ch: Channel<KvMsg> = Channel.new();
    spawn(fn() {
        store_actor(s, ch);
    });
    SharedStore { ch: ch }
}

/// Opens the store at `path` (like `open`) and shares it in one step.
pub fn open_shared(path: string) -> Result<SharedStore, string> {
    let s = open(path)?;
    Result.Ok(share(s))
}

/// Stops the owner fiber (closes the request channel). Call after a final `save`
/// if the state must persist; using the handle afterwards is an error.
pub fn stop(sh: SharedStore) {
    close(sh.ch);
}

// El actor: posee el Store y lo toca SOLO él; canal cerrado → termina.
fn store_actor(s: Store, ch: Channel<KvMsg>) {
    var running = true;
    while (running) {
        match (recv(ch)) {
            Option.Some(msg) => {
                match (msg) {
                    KvMsg.Get(k, reply) => send(reply, s.get(k)),
                    KvMsg.Set(k, v) => s.set(k, v),
                    KvMsg.Delete(k, reply) => send(reply, s.delete(k)),
                    KvMsg.Keys(reply) => send(reply, s.keys()),
                    KvMsg.Count(reply) => send(reply, s.count()),
                    KvMsg.Save(reply) => send(reply, s.save()),
                    // M154: el RMW entero corre DENTRO del actor — atómico por FIFO.
                    KvMsg.Incr(k, d, reply) => send(reply, s.incr(k, d)),
                    KvMsg.SetIf(k, e, v, reply) => send(reply, s.set_if(k, e, v)),
                }
            },
            Option.None => {
                running = false;
            },
        }
    }
}

impl StoreOps for SharedStore {
    fn get(self, key: string) -> Option<bytes> {
        let reply: Channel<Option<bytes>> = Channel.new();
        send(self.ch, KvMsg.Get(key, reply));
        match (recv(reply)) {
            Option.Some(v) => v,
            Option.None => Option.None,
        }
    }

    // Fire-and-forget: el orden FIFO del canal garantiza que un get posterior lo ve.
    fn set(self, key: string, val: bytes) {
        send(self.ch, KvMsg.Set(key, val));
    }

    fn delete(self, key: string) -> bool {
        let reply: Channel<bool> = Channel.new();
        send(self.ch, KvMsg.Delete(key, reply));
        match (recv(reply)) {
            Option.Some(b) => b,
            Option.None => false,
        }
    }

    fn keys(self) -> [string] {
        let reply: Channel<[string]> = Channel.new();
        send(self.ch, KvMsg.Keys(reply));
        match (recv(reply)) {
            Option.Some(ks) => ks,
            Option.None => [],
        }
    }

    fn count(self) -> int {
        let reply: Channel<int> = Channel.new();
        send(self.ch, KvMsg.Count(reply));
        match (recv(reply)) {
            Option.Some(n) => n,
            Option.None => 0,
        }
    }

    // El azúcar de strings va del lado del CLIENTE (codifica/decodifica en su fibra):
    // el actor solo conoce Get/Set de bytes.
    fn get_string(self, key: string) -> Option<string> {
        match (self.get(key)) {
            Option.Some(b) => {
                match (from_utf8(b)) {
                    Result.Ok(v) => Option.Some(v),
                    Result.Err(e) => Option.None,
                }
            },
            Option.None => Option.None,
        }
    }

    fn set_string(self, key: string, val: string) {
        self.set(key, val.to_bytes());
    }

    fn save(self) -> Result<int, string> {
        let reply: Channel<Result<int, string>> = Channel.new();
        send(self.ch, KvMsg.Save(reply));
        match (recv(reply)) {
            Option.Some(r) => r,
            Option.None => Result.Err("kv: shared store is stopped"),
        }
    }

    fn incr(self, key: string, delta: int) -> Result<int, string> {
        let reply: Channel<Result<int, string>> = Channel.new();
        send(self.ch, KvMsg.Incr(key, delta, reply));
        match (recv(reply)) {
            Option.Some(r) => r,
            Option.None => Result.Err("kv: shared store is stopped"),
        }
    }

    fn set_if(self, key: string, expected: Option<bytes>, new: bytes) -> bool {
        let reply: Channel<bool> = Channel.new();
        send(self.ch, KvMsg.SetIf(key, expected, new, reply));
        match (recv(reply)) {
            Option.Some(b) => b,
            Option.None => false,
        }
    }
}

// --- formato RKV1 ---
// Empuja `n` (0 <= n < 2^32) como u32 little-endian en `out`.
fn push_u32(out: [int], n: int) {
    out.push(n % 256);
    out.push(n / 256 % 256);
    out.push(n / 65536 % 256);
    out.push(n / 16777216 % 256);
}

// Empuja todos los octetos de `b` en `out`.
fn push_bytes(out: [int], b: bytes) {
    var i = 0;
    while (i < b.len()) {
        out.push(b[i]);
        i = i + 1;
    }
}

// Lee el u32 little-endian que empieza en `pos` (el llamador garantiza los 4 octetos).
fn read_u32(b: bytes, pos: int) -> int {
    b[pos] + b[pos + 1] * 256 + b[pos + 2] * 65536 + b[pos + 3] * 16777216
}

// Serializa el Map al formato RKV1. Determinista: itera `keys()` (ordenadas).
fn encode(data: Map<string, bytes>) -> bytes {
    var out: [int] = [];
    // magic "RKV1"
    out.push(82);
    out.push(75);
    out.push(86);
    out.push(49);
    let ks = data.keys();
    push_u32(out, ks.len());
    var i = 0;
    while (i < ks.len()) {
        let kb = ks[i].to_bytes();
        push_u32(out, kb.len());
        push_bytes(out, kb);
        let v = match (data.get(ks[i])) {
            Option.Some(x) => x,
            Option.None => b"",
        };
        push_u32(out, v.len());
        push_bytes(out, v);
        i = i + 1;
    }
    bytes_of(out)
}

// Decodifica un archivo RKV1; cualquier malformación es un error (no se pierde estado
// en silencio). `sub_bytes` clampa, así que los cortes van SIEMPRE precedidos del
// chequeo de longitud explícito.
fn decode(b: bytes) -> Result<Map<string, bytes>, string> {
    var m: Map<string, bytes> = Map.new();
    if (b.len() < 8) {
        return Result.Err("kv: invalid store file (truncated header)");
    }
    if (b[0] != 82 || b[1] != 75 || b[2] != 86 || b[3] != 49) {
        return Result.Err("kv: invalid store file (bad magic)");
    }
    let n = read_u32(b, 4);
    var pos = 8;
    var i = 0;
    while (i < n) {
        if (pos + 4 > b.len()) {
            return Result.Err("kv: invalid store file (truncated key length)");
        }
        let klen = read_u32(b, pos);
        pos = pos + 4;
        if (pos + klen > b.len()) {
            return Result.Err("kv: invalid store file (truncated key)");
        }
        let key = from_utf8(b.sub_bytes(pos, pos + klen))?;
        pos = pos + klen;
        if (pos + 4 > b.len()) {
            return Result.Err("kv: invalid store file (truncated value length)");
        }
        let vlen = read_u32(b, pos);
        pos = pos + 4;
        if (pos + vlen > b.len()) {
            return Result.Err("kv: invalid store file (truncated value)");
        }
        m.insert(key, b.sub_bytes(pos, pos + vlen));
        pos = pos + vlen;
        i = i + 1;
    }
    if (pos != b.len()) {
        return Result.Err("kv: invalid store file (trailing bytes)");
    }
    Result.Ok(m)
}
