// std/kv — estado clave/valor persistido en raylang puro (IDEAS §48 G-rev, 21 jul 2026).
//
// El caso que lo motiva: conservar sesiones/config entre reloads de `ray dev` sin
// arrastrar una base de datos entera. Un `Store` es un `Map<string, bytes>` en memoria
// respaldado por un archivo con formato binario propio (RKV1): magic + nº de entradas +
// `[u32 klen | clave utf8 | u32 vlen | valor]*`, todo little-endian. La serialización es
// determinista gratis (las `keys()` del Map van ordenadas) y la escritura es atómica
// (temp + `rename`, mismo patrón que documenta std/fs). Cadencia recomendada en dev:
// cargar al boot, `save()` tras el drenado graceful — un write por reload.
//
// Módulo puro (ambos motores, cero primitivos nuevos). La compartición entre fibras
// bajo multicore (actor CSP dueño del Store) y el session store del paquete web van
// encima de esto (G.2), no aquí.

import std/fs;

/// A persistent key/value store: an in-memory `Map<string, bytes>` backed by a file.
/// Mutations (`set`/`delete`) touch only memory; call `save` to persist atomically.
/// Typical dev-state cadence: `open` at boot, `save` once on graceful shutdown.
pub struct Store {
    path: string,
    data: Map<string, bytes>,
}

/// Opens the store at `path`. A missing file yields an empty store; an existing file
/// that cannot be read or decoded is an error (never silently discards data).
pub fn open(path: string) -> Result<Store, string> {
    if (fs.exists(path)) {
        let b = fs.read_file_bytes(path)?;
        let m = decode(b)?;
        Result.Ok(Store { path: path, data: m })
    } else {
        let m: Map<string, bytes> = Map.new();
        Result.Ok(Store { path: path, data: m })
    }
}

/// Returns the value stored under `key`, if any.
pub fn get(s: Store, key: string) -> Option<bytes> {
    s.data.get(key)
}

/// Stores `val` under `key` (in memory; call `save` to persist).
pub fn set(s: Store, key: string, val: bytes) {
    s.data.insert(key, val);
}

/// Removes `key` from the store; returns whether it was present.
pub fn delete(s: Store, key: string) -> bool {
    match (s.data.remove(key)) {
        Option.Some(v) => true,
        Option.None => false,
    }
}

/// The keys currently in the store, sorted.
pub fn keys(s: Store) -> [string] {
    s.data.keys()
}

/// Number of entries in the store.
pub fn count(s: Store) -> int {
    s.data.len()
}

/// Stores a string value, UTF-8 encoded (sugar over `set`).
pub fn set_string(s: Store, key: string, val: string) {
    s.data.insert(key, val.to_bytes());
}

/// Returns the value under `key` decoded as UTF-8; `None` when the key is absent
/// or the stored bytes are not valid UTF-8.
pub fn get_string(s: Store, key: string) -> Option<string> {
    match (s.data.get(key)) {
        Option.Some(b) => {
            match (from_utf8(b)) {
                Result.Ok(v) => Option.Some(v),
                Result.Err(e) => Option.None,
            }
        },
        Option.None => Option.None,
    }
}

/// Persists the store atomically: writes `<path>.tmp` and renames it over `path`
/// (a crash mid-write never corrupts the previous state). Returns the bytes written.
pub fn save(s: Store) -> Result<int, string> {
    let b = encode(s.data);
    let tmp = s.path + ".tmp";
    fs.write_file_bytes(tmp, b)?;
    fs.rename(tmp, s.path)?;
    Result.Ok(b.len())
}

// --- formato RKV1 ---

// Empuja `n` (0 <= n < 2^32) como u32 little-endian en `out`.
fn push_u32(out: [int], n: int) {
    out.push(n % 256);
    out.push((n / 256) % 256);
    out.push((n / 65536) % 256);
    out.push((n / 16777216) % 256);
}

// Empuja todos los octetos de `b` en `out`.
fn push_bytes(out: [int], b: bytes) {
    var i = 0;
    while (i < b.len()) {
        out.push(b[i]);
        i = i + 1;
    }
}

// Lee el u32 little-endian que empieza en `pos` (el llamador garantiza los 4 octetos).
fn read_u32(b: bytes, pos: int) -> int {
    b[pos] + b[pos + 1] * 256 + b[pos + 2] * 65536 + b[pos + 3] * 16777216
}

// Serializa el Map al formato RKV1. Determinista: itera `keys()` (ordenadas).
fn encode(data: Map<string, bytes>) -> bytes {
    var out: [int] = [];
    // magic "RKV1"
    out.push(82);
    out.push(75);
    out.push(86);
    out.push(49);
    let ks = data.keys();
    push_u32(out, ks.len());
    var i = 0;
    while (i < ks.len()) {
        let kb = ks[i].to_bytes();
        push_u32(out, kb.len());
        push_bytes(out, kb);
        let v = match (data.get(ks[i])) {
            Option.Some(x) => x,
            Option.None => b"",
        };
        push_u32(out, v.len());
        push_bytes(out, v);
        i = i + 1;
    }
    bytes_of(out)
}

// Decodifica un archivo RKV1; cualquier malformación es un error (no se pierde estado
// en silencio). `sub_bytes` clampa, así que los cortes van SIEMPRE precedidos del
// chequeo de longitud explícito.
fn decode(b: bytes) -> Result<Map<string, bytes>, string> {
    var m: Map<string, bytes> = Map.new();
    if (b.len() < 8) {
        return Result.Err("kv: invalid store file (truncated header)");
    }
    if (b[0] != 82 || b[1] != 75 || b[2] != 86 || b[3] != 49) {
        return Result.Err("kv: invalid store file (bad magic)");
    }
    let n = read_u32(b, 4);
    var pos = 8;
    var i = 0;
    while (i < n) {
        if (pos + 4 > b.len()) {
            return Result.Err("kv: invalid store file (truncated key length)");
        }
        let klen = read_u32(b, pos);
        pos = pos + 4;
        if (pos + klen > b.len()) {
            return Result.Err("kv: invalid store file (truncated key)");
        }
        let key = from_utf8(b.sub_bytes(pos, pos + klen))?;
        pos = pos + klen;
        if (pos + 4 > b.len()) {
            return Result.Err("kv: invalid store file (truncated value length)");
        }
        let vlen = read_u32(b, pos);
        pos = pos + 4;
        if (pos + vlen > b.len()) {
            return Result.Err("kv: invalid store file (truncated value)");
        }
        m.insert(key, b.sub_bytes(pos, pos + vlen));
        pos = pos + vlen;
        i = i + 1;
    }
    if (pos != b.len()) {
        return Result.Err("kv: invalid store file (trailing bytes)");
    }
    Result.Ok(m)
}
