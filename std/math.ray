// std/math (M40.4b; M49) — la biblioteca de matemáticas. Se importa con `import std/math;` y se usa
// calificado (`math.sqrt(2.0)`, `math.min(3, 8)`, `math.PI`). Las funciones float envuelven primitivos
// internos `__x` (mismo opcode que antes; el cálculo lo hacen los motores); `abs`/`min`/`max` son puros
// en raylang (M49.1b, vía los traits `Signed`/`Ord`). Las utilidades enteras van más abajo.
/// The mathematical constant π. Use qualified: `math.PI`.
pub const PI: float = 3.141592653589793;

/// Euler's number e. Use qualified: `math.E`.
pub const E: float = 2.718281828459045;

/// Square root of `x`.
pub fn sqrt(x: float) -> float { __sqrt(x) }

/// `base` raised to the floating-point power `exp`.
pub fn pow(base: float, exp: float) -> float { __pow(base, exp) }

/// Sine of `x` (radians).
pub fn sin(x: float) -> float { __sin(x) }  // es-ok: nombre trigonométrico estándar en inglés

/// Cosine of `x` (radians).
pub fn cos(x: float) -> float { __cos(x) }

/// Tangent of `x` (radians).
pub fn tan(x: float) -> float { __tan(x) }

/// Natural logarithm (base e) of `x`.
pub fn ln(x: float) -> float { __ln(x) }

/// Base-10 logarithm of `x`.
pub fn log10(x: float) -> float { __log10(x) }

/// e raised to the power `x`.
pub fn exp(x: float) -> float { __exp(x) }

/// Largest integer value not greater than `x`, as a float.
pub fn floor(x: float) -> float { __floor(x) }

/// Smallest integer value not less than `x`, as a float.
pub fn ceil(x: float) -> float { __ceil(x) }

/// `x` rounded to the nearest integer, as a float (ties away from zero).
pub fn round(x: float) -> float { __round(x) }

// M65.2: trig inversa y compañía. Mismos dominios totales IEEE que el resto
// (fuera de dominio → NaN, sin traps).
/// Arcsine of `x`, in radians in [-π/2, π/2]. `|x| > 1` → NaN.
pub fn asin(x: float) -> float { __asin(x) }

/// Arccosine of `x`, in radians in [0, π]. `|x| > 1` → NaN.
pub fn acos(x: float) -> float { __acos(x) }

/// Arctangent of `x`, in radians in (-π/2, π/2).
pub fn atan(x: float) -> float { __atan(x) }

/// The angle of the point `(x, y)` from the positive x-axis, in radians in (-π, π].
/// Note the argument order: `atan2(y, x)`, as in C and every mainstream language.
pub fn atan2(y: float, x: float) -> float { __atan2(y, x) }

/// Base-2 logarithm of `x`.
pub fn log2(x: float) -> float { __log2(x) }

/// The integer part of `x`, as a float (rounds toward zero; `trunc(-3.7)` is `-3`).
pub fn trunc(x: float) -> float { __trunc(x) }

/// A numeric type that has an absolute value (M49.1b). Implemented for `int` and `float`; a user numeric
/// type can `impl Signed for T` to work with `math.abs`.
pub trait Signed {
    /// Absolute value of `self`.
    fn abs(self) -> Self;
}

impl Signed for int {
    fn abs(self) -> int {
        if (self < 0) { 0 - self } else { self }
    }
}

impl Signed for float {
    fn abs(self) -> float {
        if (self < 0.0) { 0.0 - self } else { self }
    }
}

/// Absolute value of `x` (any `Signed` type: `int`, `float`, …). Keeps the numeric type.
pub fn abs<T: Signed>(x: T) -> T { x.abs() }

// M65.1: la comparación va invertida para que el EMPATE caiga en `a`, como promete la doc
// (antes devolvía `b`; observable con un `impl Ord` de usuario cuyos "iguales" se distingan).
/// The smaller of `a` and `b` (any `Ord` type: int/float/string/char). Ties return `a`.
pub fn min<T: Ord>(a: T, b: T) -> T {
    if (b.less(a)) { b } else { a }
}

/// The larger of `a` and `b` (any `Ord` type). Ties return `a`.
pub fn max<T: Ord>(a: T, b: T) -> T {
    if (a.less(b)) { b } else { a }
}

/// Absolute value of `x`.
pub fn iabs(x: int) -> int {
    if (x < 0) { 0 - x } else { x }
}

/// Sign of `x`: -1 if negative, 0 if zero, 1 if positive.
pub fn sign(x: int) -> int {
    if (x < 0) { 0 - 1 } else {
        if (x > 0) { 1 } else { 0 }
    }
}

// M65.3: genérica sobre `Ord` (antes solo-int), como min/max. Retrocompatible: int infiere T=int.
/// Clamps `x` to the closed range `[lo, hi]` (any `Ord` type; assumes `lo <= hi`).
pub fn clamp<T: Ord>(x: T, lo: T, hi: T) -> T {
    if (x.less(lo)) { lo } else {
        if (hi.less(x)) { hi } else { x }
    }
}

/// Greatest common divisor of `a` and `b` (Euclid's algorithm). Always non-negative;
/// `gcd(0, 0) == 0`.
pub fn gcd(a: int, b: int) -> int {
    var x = iabs(a);
    var y = iabs(b);
    while (y != 0) {
        let t = y;
        y = x % y;
        x = t;
    }
    x
}

/// Least common multiple of `a` and `b`. `lcm(_, 0) == 0`.
pub fn lcm(a: int, b: int) -> int {
    if (a == 0 || b == 0) {
        0
    } else {
        let g = gcd(a, b);
        iabs(a / g * b)
    }
}

/// `base` raised to `exp` (with `exp >= 0`) by fast binary exponentiation. `exp < 0` → 0.
/// A result beyond the `int` range traps (checked arithmetic), like `*` itself.
pub fn ipow(base: int, exp: int) -> int {
    if (exp < 0) {
        0
    } else {
        var result = 1;
        var b = base;
        var e = exp;
        while (e > 0) {
            if (e % 2 == 1) {
                result = result * b;
            }
            e = e / 2;
            // M65.1: solo cuadrar si quedan iteraciones — con el int checked, el cuadrado
            // final innecesario trap-eaba con resultados que SÍ caben (ipow(2,40) por 2^64).
            if (e > 0) {
                b = b * b;
            }
        }
        result
    }
}

/// Factorial of `n` (with `n >= 0`). `n < 0` → 0. `n > 20` overflows `int` and traps
/// (checked arithmetic, like `*` itself); `factorial(20)` is the largest that fits.
pub fn factorial(n: int) -> int {
    if (n < 0) {
        0
    } else {
        var r = 1;
        var i = 2;
        while (i <= n) {
            r = r * i;
            i = i + 1;
        }
        r
    }
}

/// Whether `n` is prime (`n < 2` → false). Trial division up to the square root.
pub fn is_prime(n: int) -> bool {
    if (n < 2) {
        false
    } else {
        var i = 2;
        var prime = true;
        while (i * i <= n && prime) {
            if (n % i == 0) {
                prime = false;
            }
            i = i + 1;
        }
        prime
    }
}

/// The raw IEEE 754 bits of a float, as a two's-complement int (M54.1). Enables binary formats
/// that carry doubles (BSON, protobuf).
pub fn float_bits(f: float) -> int { __float_bits(f) }

/// Builds a float from its raw IEEE 754 bits. Total: any bit pattern is a valid f64
/// (including NaN and the infinities).
pub fn float_from_bits(n: int) -> float { __float_from_bits(n) }
