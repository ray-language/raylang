// std/math (M40.4b) — utilidades enteras que complementan los builtins matemáticos (sqrt/pow/abs/
// min/max/…). Todo `pub`: se importa con `import std/math;` y se usa calificado (`math.gcd(12, 18)`).
/// Absolute value of `x`.
pub fn iabs(x: int) -> int {
    if (x < 0) { 0 - x } else { x }
}

/// Sign of `x`: -1 if negative, 0 if zero, 1 if positive.
pub fn sign(x: int) -> int {
    if (x < 0) { 0 - 1 } else {
        if (x > 0) { 1 } else { 0 }
    }
}

/// Clamps `x` to the closed range `[lo, hi]` (assumes `lo <= hi`).
pub fn clamp(x: int, lo: int, hi: int) -> int {
    if (x < lo) { lo } else {
        if (x > hi) { hi } else { x }
    }
}

/// Greatest common divisor of `a` and `b` (Euclid's algorithm). Always non-negative;
/// `gcd(0, 0) == 0`.
pub fn gcd(a: int, b: int) -> int {
    var x = iabs(a);
    var y = iabs(b);
    while (y != 0) {
        let t = y;
        y = x % y;
        x = t;
    }
    x
}

/// Least common multiple of `a` and `b`. `lcm(_, 0) == 0`.
pub fn lcm(a: int, b: int) -> int {
    if (a == 0 || b == 0) {
        0
    } else {
        let g = gcd(a, b);
        iabs(a / g * b)
    }
}

/// `base` raised to `exp` (with `exp >= 0`) by fast binary exponentiation. `exp < 0` → 0.
pub fn ipow(base: int, exp: int) -> int {
    if (exp < 0) {
        0
    } else {
        var resultado = 1;
        var b = base;
        var e = exp;
        while (e > 0) {
            if (e % 2 == 1) {
                resultado = resultado * b;
            }
            b = b * b;
            e = e / 2;
        }
        resultado
    }
}

/// Factorial of `n` (with `n >= 0`). `n < 0` → 0.
pub fn factorial(n: int) -> int {
    if (n < 0) {
        0
    } else {
        var r = 1;
        var i = 2;
        while (i <= n) {
            r = r * i;
            i = i + 1;
        }
        r
    }
}

/// Whether `n` is prime (`n < 2` → false). Trial division up to the square root.
pub fn is_prime(n: int) -> bool {
    if (n < 2) {
        false
    } else {
        var i = 2;
        var primo = true;
        while (i * i <= n && primo) {
            if (n % i == 0) {
                primo = false;
            }
            i = i + 1;
        }
        primo
    }
}
