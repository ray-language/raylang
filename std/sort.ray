// std/sort (M40.5b) — orden y búsqueda sobre arreglos, genéricos sobre `T: Ord` (el trait del prelude
// con `menor`; hay impl para int/float/string/char y para tipos de usuario que lo implementen). El
// `sort` genérico ya vive en el prelude; aquí van las utilidades que lo rodean. `import std/sort;` →
// `sort.binary_search(xs, 7)`.
/// Whether `a` is sorted in **non-decreasing** order (`[]` and `[x]` → `true`).
pub fn is_sorted<T: Ord>(a: [T]) -> bool {
    var i = 1;
    var ok = true;
    while (i < a.len() && ok) {
        if (a[i].menor(a[i - 1])) {
            ok = false;
        }
        i = i + 1;
    }
    ok
}

/// Sorts `a` in **descending** order (largest first). The prelude's `sort`, reversed.
pub fn sort_desc<T: Ord>(a: [T]) -> [T] {
    sort(a).reverse()
}

/// The **minimum** of `a`, or `None` if it is empty.
pub fn min<T: Ord>(a: [T]) -> Option<T> {
    if (a.len() == 0) {
        Option.None
    } else {
        var m: T = a[0];
        var i = 1;
        while (i < a.len()) {
            if (a[i].menor(m)) {
                m = a[i];
            }
            i = i + 1;
        }
        Option.Some(m)
    }
}

/// The **maximum** of `a`, or `None` if it is empty.
pub fn max<T: Ord>(a: [T]) -> Option<T> {
    if (a.len() == 0) {
        Option.None
    } else {
        var m: T = a[0];
        var i = 1;
        while (i < a.len()) {
            if (m.menor(a[i])) {
                m = a[i];
            }
            i = i + 1;
        }
        Option.Some(m)
    }
}

/// **Binary search** for `x` in an array `a` assumed **sorted** (non-decreasing): returns
/// `Some(i)` with `a[i] == x` (any index if there are duplicates), or `None` if absent. O(log n).
/// Equality is derived from `Ord`: `x == y` ⟺ neither `x < y` nor `y < x`.
pub fn binary_search<T: Ord>(a: [T], x: T) -> Option<int> {
    var lo = 0;
    var hi = a.len();
    while (lo < hi) {
        let mid = lo + (hi - lo) / 2;
        let m: T = a[mid];
        if (m.menor(x)) {
            lo = mid + 1;
        } else {
            if (x.menor(m)) {
                hi = mid;
            } else {
                return Option.Some(mid);
            }
        }
    }
    Option.None
}

/// Sorts `a` and **removes duplicates** (equal elements are kept once). The result is sorted.
pub fn dedup<T: Ord>(a: [T]) -> [T] {
    let s = sort(a);
    var out: [T] = [];
    var i = 0;
    while (i < s.len()) {
        // Como `s` está ordenado, los iguales son adyacentes: se añade si el último es estrictamente menor.
        if (out.len() == 0 || out[out.len() - 1].menor(s[i])) {
            out.push(s[i]);
        }
        i = i + 1;
    }
    out
}

/// **Merges** two **already sorted** arrays `a` and `b` into one sorted array (stable: on ties, `a` wins).
pub fn merge<T: Ord>(a: [T], b: [T]) -> [T] {
    var out: [T] = [];
    var i = 0;
    var j = 0;
    while (i < a.len() && j < b.len()) {
        if (b[j].menor(a[i])) {
            out.push(b[j]);
            j = j + 1;
        } else {
            out.push(a[i]);
            i = i + 1;
        }
    }
    while (i < a.len()) {
        out.push(a[i]);
        i = i + 1;
    }
    while (j < b.len()) {
        out.push(b[j]);
        j = j + 1;
    }
    out
}
