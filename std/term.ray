// std/term (M107.3) — el terminal: isatty, tamaño, modo crudo y lectura de teclas.
//
// Sobre los primitivos `__term_*` (termios/ioctl/isatty vía FFI propio del runtime, cero crates) y
// la lectura por bytes de std/io (M107.2). El modo crudo se restaura SIEMPRE al salir del proceso
// (atexit) además de al salir de `raw` — salvo muerte por señal fatal o kill -9 (como cualquier
// programa de terminal: `reset` lo arregla).
//
// `decode` es PURO (bytes → tecla): toda la tabla de secuencias ESC/CSI/SS3 y UTF-8 se prueba sin
// terminal. `read_key` lo alimenta byte a byte, con un plazo corto para distinguir un ESC suelto
// de una secuencia (`ESC [ A` llega junta; un humano no teclea el `[` en 25 ms).

import std/io;
import std/image;
import std/base64;
import std/collections/stringbuilder as sb;

// Una tecla decodificada. `Ctrl('a')` es Ctrl+A (bytes 1..=26); `F(5)` es la tecla F5.
/// A decoded key. `Ctrl('a')` is Ctrl+A (bytes 1..=26); `F(5)` is the F5 function key.
pub enum Key {
    Char(char),
    Enter,
    Tab,
    Backspace,
    Esc,
    Up,
    Down,
    Left,
    Right,
    Home,
    End,
    PageUp,
    PageDown,
    Insert,
    Delete,
    Ctrl(char),
    F(int),
}

// ¿El fd (0 = stdin, 1 = stdout, 2 = stderr) es una terminal?
/// Is the given fd (0 = stdin, 1 = stdout, 2 = stderr) a terminal?
pub fn is_tty(fd: int) -> bool {
    __term_is_tty(fd)
}

// Tamaño del terminal; None si no hay tty (salida canalizada, CI…).
/// The terminal size as `(columns, rows)`, or `None` when not attached to a terminal.
pub fn size() -> Option<(int, int)> {
    let r = __term_size();
    if (r.len() == 2) { Option.Some((r[0], r[1])) } else { Option.None }
}

// Área en píxeles (M143, IDEAS §78): ws_xpixel/ws_ypixel del MISMO ioctl que size(); muchos
// terminales los dejan en 0 → None, jamás un 0 que divida.
/// The terminal area in PIXELS as `(width, height)`, or `None` when there is no terminal or it
/// does not report pixel sizes (many terminals leave them at 0).
pub fn size_px() -> Option<(int, int)> {
    let r = __term_size_px();
    if (r.len() == 2) { Option.Some((r[0], r[1])) } else { Option.None }
}

/// The size of one terminal cell in PIXELS as `(width, height)`: the pixel area divided by the
/// column/row grid. `None` when either is unavailable. This is what scales sixel/kitty graphics
/// to the text layout.
pub fn cell_px() -> Option<(int, int)> {
    match (size_px()) {
        Option.Some(px) => {
            match (size()) {
                Option.Some(cr) => {
                    let (w, h) = px;
                    let (cols, rows) = cr;
                    if (cols > 0 && rows > 0) {
                        Option.Some((w / cols, h / rows))
                    } else {
                        Option.None
                    }
                },
                Option.None => Option.None,
            }
        },
        Option.None => Option.None,
    }
}

// --- Capacidades (M143b, IDEAS §78) ---
// Deteccion en dos capas: pistas de entorno (baratas, sin I/O) y una query DA1 que responde el
// PROPIO terminal (solo con stdin Y stdout en tty, dentro de raw, con plazo corto). Todo lo
// indetectable queda en false: degradar, nunca adivinar hacia arriba.

/// What the terminal supports, from environment hints (`COLORTERM`, `TERM`, `KITTY_WINDOW_ID`)
/// and a DA1 device-attributes query answered by the terminal itself. Every field defaults to
/// `false` when undetectable — degrade rendering, never guess up.
pub struct Capabilities {
    truecolor: bool,
    colors_256: bool,
    sixel: bool,
    kitty_graphics: bool,
}

/// Detects the terminal's capabilities. With both stdin and stdout on a terminal it asks the
/// terminal itself, inside raw mode with a ~150 ms budget: a DA1 query (for sixel) and a kitty
/// graphics APC query (M161 — a real probe, so a terminal behind tmux correctly reports
/// `false`: the multiplexer swallows APC and you could not draw there anyway). Without a
/// terminal the graphics answer falls back to the environment heuristic
/// (`TERM`/`KITTY_WINDOW_ID`); truecolor/256 always come from `COLORTERM`/`TERM`. Every field
/// defaults to `false` when undetectable — degrade rendering, never guess up.
pub fn capabilities() -> Capabilities {
    let colorterm = env_text("COLORTERM");
    let name = env_text("TERM");
    let truecolor = colorterm.contains("truecolor") || colorterm.contains("24bit");
    let has_256 = truecolor || name.contains("256color") || name == "xterm-kitty";
    var kitty = name == "xterm-kitty" || env_text("KITTY_WINDOW_ID") != "";
    var sixel = false;
    if (is_tty(0) && is_tty(1)) {
        let resp = query_terminal();
        for a in parse_device_attributes(resp) {
            if (a == 4) {
                sixel = true;
            }
        }
        kitty = parse_graphics_reply(resp);
    }
    Capabilities { truecolor: truecolor, colors_256: has_256, sixel: sixel, kitty_graphics: kitty }
}

/// Parses a DA1 (primary device attributes) reply such as `ESC [ ? 64 ; 1 ; 4 c` into its
/// numeric attributes (`[64, 1, 4]`). Pure and tolerant: anything malformed yields `[]`.
pub fn parse_device_attributes(resp: bytes) -> [int] {
    // Primer "ESC [": los atributos van tras el '?' opcional, separados por ';', hasta la 'c'.
    var i = 0;
    var found = false;
    while (!found && i + 1 < resp.len()) {
        if (resp[i] == 27 && resp[i + 1] == 91) {
            found = true;
        } else {
            i = i + 1;
        }
    }
    if (!found) {
        return [];
    }
    i = i + 2;
    if (i < resp.len() && resp[i] == 63) {
        i = i + 1;
    }
    var attrs: [int] = [];
    var cur = 0;
    var has_digit = false;
    while (i < resp.len()) {
        let b = resp[i];
        if (b >= 48 && b <= 57) {
            cur = cur * 10 + (b - 48);
            has_digit = true;
        } else if (b == 59) {
            if (has_digit) {
                attrs.push(cur);
            }
            cur = 0;
            has_digit = false;
        } else if (b == 99) {
            if (has_digit) {
                attrs.push(cur);
            }
            return attrs;
        } else {
            return [];
        }
        i = i + 1;
    }
    // `return` a proposito: un tail `[]` tras un while parsea como indexacion del bloque.
    return [];
}

/// Parses a terminal reply to the kitty graphics probe: `true` when it contains an APC
/// graphics response whose payload starts with `OK` (`ESC _ G … ; O K`). Pure and tolerant —
/// an error reply, a lone DA1 answer or garbage yields `false`.
pub fn parse_graphics_reply(resp: bytes) -> bool {
    // Busca "ESC _ G"; desde ahi, el ';' que abre el payload y comprueba que empieza por "OK".
    var i = 0;
    while (i + 2 < resp.len()) {
        if (resp[i] == 27 && resp[i + 1] == 95 && resp[i + 2] == 71) {
            var j = i + 3;
            while (j < resp.len() && resp[j] != 59 && resp[j] != 27) {
                j = j + 1;
            }
            if (j + 2 < resp.len() && resp[j] == 59 && resp[j + 1] == 79 && resp[j + 2] == 75) {
                return true;
            }
        }
        i = i + 1;
    }
    // `return` a proposito: un tail tras un while parsea como indexacion del bloque.
    return false;
}

// Emite la query de graficos kitty (APC a=q — M161) seguida de DA1, y acumula la respuesta
// cruda hasta la 'c' final de la DA1 (o plazo sin datos): UNA sola sesion raw y un solo
// roundtrip de ~150 ms para ambas capacidades. DA1 va DESPUES como centinela: todo terminal
// la responde, hable o no kitty. En raw: la respuesta llega por stdin como bytes, no teclas.
fn query_terminal() -> bytes {
    let got = raw(fn() -> bytes {
        // i=31: un id de sonda cualquiera; f=24 RGB 1x1 = 3 octetos = "AAAA". SIN q=: la
        // respuesta ";OK" es justo lo que se espera.
        io.write("\u{1B}_Gi=31,s=1,v=1,a=q,t=d,f=24;AAAA\u{1B}\\\u{1B}[c");
        io.flush();
        var acc = b"";
        var done = false;
        while (!done) {
            match (io.read_timeout(64, 150)) {
                io.ReadResult.Data(more) => {
                    acc = acc + more;
                    if (has_da1_terminator(acc)) {
                        done = true;
                    }
                },
                io.ReadResult.Eof => {
                    done = true;
                },
                io.ReadResult.TimedOut => {
                    done = true;
                },
            }
        }
        acc
    });
    match (got) {
        Result.Ok(resp) => resp,
        Result.Err(_) => b"",
    }
}

// El corte del acumulador: una 'c' vista DESPUES de un "ESC [" (la respuesta APC de kitty
// puede llevar una 'c' en texto libre — p. ej. un mensaje de error — y cortaria antes).
fn has_da1_terminator(resp: bytes) -> bool {
    var in_csi = false;
    var i = 0;
    while (i < resp.len()) {
        if (in_csi && resp[i] == 99) {
            return true;
        }
        if (i + 1 < resp.len() && resp[i] == 27 && resp[i + 1] == 91) {
            in_csi = true;
        }
        i = i + 1;
    }
    // `return` a proposito: un tail tras un while parsea como indexacion del bloque.
    return false;
}

// El env como texto plano ("" si no esta): las pistas se comparan por contains.
fn env_text(name: string) -> string {
    match (env(name)) {
        Option.Some(v) => v,
        Option.None => "",
    }
}

// Corre f en modo crudo y restaura SIEMPRE (también si f falla: try_call).
/// Runs `f` with the terminal in raw mode (no echo, byte-at-a-time input) and ALWAYS restores
/// the previous state, even if `f` panics. Returns `f`'s value, or `Err` if raw mode could not
/// be entered or `f` failed.
pub fn raw<T>(f: fn() -> T) -> Result<T, string> {
    let on = __term_raw_on();
    if (on[0] != "ok") {
        return Result.Err(on[1]);
    }
    let r = try_call(f);
    let _ = __term_raw_off();
    r
}

// ---------------------------------------------------------------------------------------------
// Gráficos kitty (M161, IDEAS §83)
// ---------------------------------------------------------------------------------------------
// El protocolo moderno de imagenes en terminal (kitty/Ghostty/WezTerm): comandos APC
// `ESC _ G control;payload ESC \` con el payload en base64. Todo raylang puro sobre io.write —
// cero builtins. El patron de juego: `transmit_image` UNA vez por sprite, `place_image` por
// frame (~30 octetos). q=2 en todo comando de dibujo (el terminal no responde: stdin limpio
// dentro de raw) y C=1 (el cursor no se mueve al colocar). Contrato del llamador: consultar
// `capabilities().kitty_graphics` antes de dibujar — se emite igual sin tty (captura/replay).

/// Encodes ONE kitty graphics command as APC escapes: `ESC _ G control;base64 ESC \`. A
/// payload over 3072 bytes (4096 base64 chars, the protocol's chunk limit) is split: the
/// first chunk carries the full control data plus `m=1`, continuation chunks carry only `m=`,
/// and the last one `m=0`. An empty payload emits a single control-only APC. Pure — the
/// building block under `transmit_image`/`draw_image`; use it directly for kitty features the
/// surface does not cover (animation, z-index).
pub fn kitty_chunks(control: string, payload: bytes) -> string {
    if (payload.len() == 0) {
        return "\u{1B}_G" + control + "\u{1B}\\";
    }
    if (payload.len() <= 3072) {
        return "\u{1B}_G" + control + ";" + base64.base64(payload) + "\u{1B}\\";
    }
    // Troceo por OCTETOS a 3072 (multiplo de 3): cada trozo codifica sin relleno y la
    // concatenacion es el base64 exacto del total — y O(n), sin recortar un string gigante.
    let out = sb.new();
    var i = 0;
    var first = true;
    while (i < payload.len()) {
        let j = if (i + 3072 < payload.len()) { i + 3072 } else { payload.len() };
        let m = if (j < payload.len()) { "1" } else { "0" };
        let head = if (first) { control + ",m=" + m } else { "m=" + m };
        sb.push(out, "\u{1B}_G" + head + ";" + base64.base64(payload.sub_bytes(i, j)) + "\u{1B}\\");
        first = false;
        i = j;
    }
    sb.build(out)
}

// CUP 1-based (fila;columna) — con DECSC/DECRC en los llamadores (CSI s/u colisiona con
// DECSLRM cuando hay margenes activos).
fn cursor_to(col: int, row: int) -> string {
    "\u{1B}[" + to_string(row) + ";" + to_string(col) + "H"
}

// UN write + UN flush por comando (sin interleaving posible; el flush drena el hilo escritor
// del binario nativo, M96f).
fn emit(s: string) -> Result<int, string> {
    match (io.write(s)) {
        Result.Ok(n) => {
            match (io.flush()) {
                Result.Ok(_) => Result.Ok(n),
                Result.Err(e) => Result.Err(e),
            }
        },
        Result.Err(e) => Result.Err(e),
    }
}

// Validacion comun de las funciones con imagen: id positivo (i=0 es "autoasigna" en kitty y
// no podrias borrarla) y pixeles RGBA8 completos.
fn check_image(id: int, img: image.Image) -> Option<string> {
    if (id <= 0) {
        return Option.Some("image id must be positive");
    }
    if (img.pixels.len() != img.width * img.height * 4) {
        return Option.Some("pixel buffer does not match width*height*4");
    }
    Option.None
}

/// Transmits `img` (RGBA8, from `image.decode_png` or built by hand) to the terminal as kitty
/// image `id` WITHOUT showing it — pair with `place_image` (transmit once, place per frame).
/// The terminal keeps the pixels under `id` until deleted. `Ok(characters written)`; `Err` on
/// `id <= 0` or a pixel buffer that does not match `width*height*4`. Emits even without a
/// terminal (capture/replay pipes) — check `capabilities().kitty_graphics` first.
pub fn transmit_image(id: int, img: image.Image) -> Result<int, string> {
    match (check_image(id, img)) {
        Option.Some(e) => Result.Err(e),
        Option.None => {
            let control = "a=t,i=" + to_string(
                id
            ) + ",t=d,f=32,s=" + to_string(img.width) + ",v=" + to_string(img.height) + ",q=2";
            emit(kitty_chunks(control, img.pixels))
        },
    }
}

/// Shows the already-transmitted image `id` at cell `(col, row)` (both 1-based, like the
/// cursor). `cols`/`rows` scale the image to that many cells (`0` = natural size, no
/// scaling). ~30 bytes on the wire — this is the per-frame half of the transmit/place pair.
/// The cursor does not move. `Err` on `id <= 0`.
pub fn place_image(id: int, col: int, row: int, cols: int, rows: int) -> Result<int, string> {
    if (id <= 0) {
        return Result.Err("image id must be positive");
    }
    var control = "a=p,i=" + to_string(id);
    if (cols > 0) {
        control = control + ",c=" + to_string(cols);
    }
    if (rows > 0) {
        control = control + ",r=" + to_string(rows);
    }
    control = control + ",C=1,q=2";
    emit("\u{1B}7" + cursor_to(col, row) + kitty_chunks(control, b"") + "\u{1B}8")
}

/// Transmits AND shows `img` at cell `(col, row)` (1-based) at natural size, as kitty image
/// `id` — the one-shot convenience. For animation prefer `transmit_image` once +
/// `place_image` per frame; for scaling, that same pair. The cursor does not move.
pub fn draw_image(id: int, col: int, row: int, img: image.Image) -> Result<int, string> {
    match (check_image(id, img)) {
        Option.Some(e) => Result.Err(e),
        Option.None => {
            let control = "a=T,i=" + to_string(
                id
            ) + ",t=d,f=32,s=" + to_string(img.width) + ",v=" + to_string(img.height) + ",C=1,q=2";
            emit("\u{1B}7" + cursor_to(col, row) + kitty_chunks(control, img.pixels) + "\u{1B}8")
        },
    }
}

/// Transmits AND shows a PNG at cell `(col, row)` (1-based) as kitty image `id` — the
/// terminal decodes it (`f=100`), so the bytes travel compressed: the right call for static
/// assets read from disk or `std/embed`. Validates only the 8-byte PNG signature.
pub fn draw_png(id: int, col: int, row: int, data: bytes) -> Result<int, string> {
    if (id <= 0) {
        return Result.Err("image id must be positive");
    }
    if (data.len() < 8 || data.sub_bytes(0, 8) != b"\x89PNG\r\n\x1a\n") {
        return Result.Err("not a PNG (bad signature)");
    }
    let control = "a=T,i=" + to_string(id) + ",t=d,f=100,C=1,q=2";
    emit("\u{1B}7" + cursor_to(col, row) + kitty_chunks(control, data) + "\u{1B}8")
}

/// Removes every placement of image `id` from the screen. The terminal KEEPS the transmitted
/// pixels: `place_image(id, …)` shows it again without retransmitting. `Err` on `id <= 0`.
pub fn clear_image(id: int) -> Result<int, string> {
    if (id <= 0) {
        return Result.Err("image id must be positive");
    }
    emit(kitty_chunks("a=d,d=i,i=" + to_string(id) + ",q=2", b""))
}

/// Removes every image placement from the screen (transmitted pixel data is kept).
pub fn clear_images() -> Result<int, string> {
    emit(kitty_chunks("a=d,d=a,q=2", b""))
}

// ---------------------------------------------------------------------------------------------
// Decodificación de teclas
// ---------------------------------------------------------------------------------------------

// Decodifica UNA tecla del frente de buf: Some((tecla, octetos consumidos)) o None si el prefijo
// es una secuencia aún incompleta (ESC solo, CSI sin byte final, UTF-8 a medias).
/// Decodes ONE key from the front of `buf`: `Some((key, bytes consumed))`, or `None` when the
/// prefix is an incomplete sequence (lone ESC, unfinished CSI, partial UTF-8) and more bytes are
/// needed. Pure — feed it any byte source.
pub fn decode(buf: bytes) -> Option<(Key, int)> {
    if (buf.len() == 0) {
        return Option.None;
    }
    let b0 = buf[0];
    if (b0 == 27) {
        return decode_escape(buf);
    }
    if (b0 == 13 || b0 == 10) {
        return Option.Some((Key.Enter, 1));
    }
    if (b0 == 9) {
        return Option.Some((Key.Tab, 1));
    }
    if (b0 == 127 || b0 == 8) {
        return Option.Some((Key.Backspace, 1));
    }
    if (b0 >= 1 && b0 <= 26) {
        // Ctrl+letra: el byte es la letra menos 96 ('a' = 97 → 1).
        match (char_from_code(96 + b0)) {
            Option.Some(c) => {
                return Option.Some((Key.Ctrl(c), 1));
            },
            Option.None => {
                return Option.Some((Key.Char('?'), 1));
            },
        }
    }
    if (b0 < 32) {
        return Option.Some((Key.Char('?'), 1));  // controles raros (28..31, 0)
    }
    if (b0 < 128) {
        match (char_from_code(b0)) {
            Option.Some(c) => {
                return Option.Some((Key.Char(c), 1));
            },
            Option.None => {
                return Option.Some((Key.Char('?'), 1));
            },
        }
    }
    // UTF-8 multibyte: el byte líder fija la longitud total.
    let need = utf8_len(b0);
    if (need == 0) {
        return Option.Some((Key.Char('?'), 1));  // continuación suelta / líder inválido
    }
    if (buf.len() < need) {
        return Option.None;  // incompleta: faltan continuaciones
    }
    match (from_utf8(buf.sub_bytes(0, need))) {
        Result.Ok(s) => Option.Some((Key.Char(s[0]), need)),
        Result.Err(_) => Option.Some((Key.Char('?'), 1)),
    }
}

// Longitud total de un carácter UTF-8 por su byte líder (0 = inválido/continuación).
fn utf8_len(lead: int) -> int {
    if (lead >= 192 && lead < 224) {
        2
    } else if (lead >= 224 && lead < 240) {
        3
    } else if (lead >= 240 && lead < 248) {
        4
    } else {
        0
    }
}

// buf[0] == 27. ESC solo no decide (podría venir una secuencia): None hasta que llegue más (o el
// llamador se rinda por plazo y lo trate como Esc suelto).
fn decode_escape(buf: bytes) -> Option<(Key, int)> {
    if (buf.len() == 1) {
        return Option.None;
    }
    let b1 = buf[1];
    if (b1 == 91) {
        // CSI: ESC '[' params… byte final en 0x40..0x7E.
        var i = 2;
        while (i < buf.len()) {
            let c = buf[i];
            if (c >= 64 && c <= 126) {
                return Option.Some((csi_key(buf, i), i + 1));
            }
            i = i + 1;
        }
        return Option.None;  // CSI sin byte final todavía
    }
    if (b1 == 79) {
        // SS3: ESC 'O' letra (F1..F4, Home/End en algunos terminales).
        if (buf.len() < 3) {
            return Option.None;
        }
        return Option.Some((ss3_key(buf[2]), 3));
    }
    // ESC seguido de otra cosa (Alt+tecla…): v1 → Esc suelto, consumiendo SOLO el ESC.
    Option.Some((Key.Esc, 1))
}

// La tecla de una secuencia CSI cuyo byte final está en buf[fin] (los params van en 2..fin).
fn csi_key(buf: bytes, fin: int) -> Key {
    let f = buf[fin];
    if (f == 65) {
        return Key.Up;  // 'A'
    }
    if (f == 66) {
        return Key.Down;  // 'B'
    }
    if (f == 67) {
        return Key.Right;  // 'C'
    }
    if (f == 68) {
        return Key.Left;  // 'D'
    }
    if (f == 72) {
        return Key.Home;  // 'H'
    }
    if (f == 70) {
        return Key.End;  // 'F'
    }
    if (f == 90) {
        return Key.Tab;  // 'Z': Shift-Tab → Tab (v1)
    }
    if (f == 126) {
        // '~': la tecla la nombra el PRIMER número de los params (los modificadores van tras ';').
        var n = 0;
        var i = 2;
        while (i < fin && buf[i] >= 48 && buf[i] <= 57) {
            n = n * 10 + (buf[i] - 48);
            i = i + 1;
        }
        if (n == 1 || n == 7) {
            return Key.Home;
        }
        if (n == 2) {
            return Key.Insert;
        }
        if (n == 3) {
            return Key.Delete;
        }
        if (n == 4 || n == 8) {
            return Key.End;
        }
        if (n == 5) {
            return Key.PageUp;
        }
        if (n == 6) {
            return Key.PageDown;
        }
        if (n >= 11 && n <= 15) {
            return Key.F(n - 10);  // F1..F5
        }
        if (n >= 17 && n <= 21) {
            return Key.F(n - 11);  // F6..F10
        }
        if (n == 23 || n == 24) {
            return Key.F(n - 12);  // F11, F12
        }
    }
    Key.Esc  // secuencia CSI que no mapeamos (v1)
}

// La tecla de una secuencia SS3 (ESC 'O' letra).
fn ss3_key(f: int) -> Key {
    if (f == 80) {
        return Key.F(1);  // 'P'
    }
    if (f == 81) {
        return Key.F(2);  // 'Q'
    }
    if (f == 82) {
        return Key.F(3);  // 'R'
    }
    if (f == 83) {
        return Key.F(4);  // 'S'
    }
    if (f == 72) {
        return Key.Home;  // 'H'
    }
    if (f == 70) {
        return Key.End;  // 'F'
    }
    Key.Esc
}

// Lee UNA tecla de stdin (bloquea la fibra); None = EOF. Pensada para el modo crudo.
/// Reads ONE key from stdin (blocking only the calling fiber); `None` on end of input. Meant to
/// be used inside `raw`. A lone ESC is resolved after a short (25 ms) grace period — a human
/// cannot type the `[` of an arrow-key sequence that fast. Note: on a burst (paste), bytes
/// beyond the decoded key may be discarded; for burst processing read `io.read` + `decode`.
pub fn read_key() -> Option<Key> {
    match (io.read(1)) {
        Option.None => Option.None,
        Option.Some(first) => {
            var buf = first;
            var keys: [Key] = [];
            while (keys.len() == 0) {
                match (decode(buf)) {
                    Option.Some(kc) => {
                        keys.push(kc.0);
                    },
                    Option.None => {
                        // Secuencia incompleta: espera un poco por el resto.
                        match (io.read_timeout(8, 25)) {
                            io.ReadResult.Data(more) => {
                                buf = buf + more;
                            },
                            io.ReadResult.Eof => {
                                if (buf[0] == 27) {
                                    keys.push(Key.Esc);
                                } else {
                                    keys.push(Key.Char('?'));
                                }
                            },
                            io.ReadResult.TimedOut => {
                                // No llegó más: era un ESC suelto (o un byte roto).
                                if (buf[0] == 27) {
                                    keys.push(Key.Esc);
                                } else {
                                    keys.push(Key.Char('?'));
                                }
                            },
                        }
                    },
                }
            }
            Option.Some(keys[0])
        },
    }
}

// --- M125: entrada OCULTA (passphrases). Leer una línea sin eco era artesanía sobre `raw` que
// toda herramienta de secretos repetía (~30 líneas; hallazgo de raypass, IDEAS §71.1). El núcleo
// de edición es PURO (`hidden_feed`, como `decode`): se prueba sin tty y sirve para alimentar
// bytes propios. `read_hidden` lo envuelve con el prompt (a stderr, como getpass(3): no ensucia
// un stdout canalizado), el modo crudo y el bucle de lectura. ---

// Un paso del editor oculto: sigue acumulando, terminó (Enter/EOF) o se canceló (Ctrl-C).
/// One step of the hidden-line editor: still accumulating (`More`), finished (`Done`, on
/// Enter), or cancelled (`Cancelled`, on Ctrl-C).
pub enum Hidden {
    More(bytes),
    Done(string),
    Cancelled,
}

// Quita el ÚLTIMO carácter completo (no un byte): retrocede las continuaciones UTF-8 (10xxxxxx)
// y luego el byte líder — un backspace sobre "ñ" borra la "ñ" entera.
fn drop_last_char(buf: bytes) -> bytes {
    if (buf.len() == 0) {
        return buf;
    }
    var end = buf.len() - 1;
    while (end > 0 && (buf[end] & 192) == 128) {
        end = end - 1;
    }
    buf.sub_bytes(0, end)
}

// El texto acumulado como string (total: bytes no-UTF-8 → "").
fn hidden_text(buf: bytes) -> string {
    match (from_utf8(buf)) {
        Result.Ok(s) => s,
        Result.Err(_e) => "",
    }
}

/// The PURE core of `read_hidden` (the `decode` philosophy: testable without a tty, feed it any
/// byte source): applies one chunk of raw input to the accumulated bytes. Enter (CR/LF) finishes
/// with the decoded text; Backspace/DEL removes one full UTF-8 CHARACTER; Ctrl-C cancels; other
/// control bytes are ignored. Nothing is ever echoed — that is the caller's contract.
pub fn hidden_feed(acc: bytes, chunk: bytes) -> Hidden {
    var buf = acc;
    var i = 0;
    while (i < chunk.len()) {
        let b = chunk[i];
        if (b == 13 || b == 10) {
            return Hidden.Done(hidden_text(buf));
        }
        if (b == 3) {
            return Hidden.Cancelled;
        }
        if (b == 127 || b == 8) {
            buf = drop_last_char(buf);
        } else if (b >= 32) {
            buf = buf + chunk.sub_bytes(i, i + 1);
        }
        i = i + 1;
    }
    Hidden.More(buf)
}

// El bucle de lectura sobre el núcleo puro (dentro de `raw`): EOF devuelve lo tecleado.
fn hidden_loop() -> Result<string, string> {
    var acc = b"";
    while (true) {
        match (io.read(64)) {
            Option.None => {
                return Result.Ok(hidden_text(acc));
            },
            Option.Some(chunk) => match (hidden_feed(acc, chunk)) {
                Hidden.More(rest) => {
                    acc = rest;
                },
                Hidden.Done(s) => {
                    return Result.Ok(s);
                },
                Hidden.Cancelled => {
                    return Result.Err("interrupted");
                },
            },
        }
    }
    return Result.Err("eof");
}

/// Reads one line WITHOUT echo (passphrases, tokens): prints `prompt` to STDERR (like getpass(3),
/// so a piped stdout stays clean), enters raw mode, and edits with Backspace (one full UTF-8
/// character) until Enter. Ctrl-C cancels with `Err("interrupted")`; end of input returns what
/// was typed. `Err` when stdin is not a terminal — script callers should read their secret from
/// an env var or a file instead.
pub fn read_hidden(prompt: string) -> Result<string, string> {
    if (!is_tty(0)) {
        return Result.Err("stdin is not a terminal");
    }
    let _ = io.ewrite(prompt);
    let out = raw(fn() -> Result<string, string> { hidden_loop() })?;
    let _ = io.ewrite("\r\n");
    out
}

// --- M117: ancho en CELDAS de terminal (el problema wcwidth). Todo TUI lo necesita para alinear
// columnas cuando el texto lleva CJK/kana/emoji (2 celdas) o combinantes (0). `char_from_code`/
// `chars` ya dan el code point; esto es la tabla de rangos que faltaba (antes cada TUI la copiaba).
// wcwidth PRAGMÁTICO: control y combinantes → 0, ancho-Este-Asiático y bloques emoji → 2, resto → 1.
// No resuelve secuencias emoji ZWJ/VS16 (ancho ambiguo según el terminal); para eso no hay respuesta
// universal. Los rangos van en decimal (aún sin literales hex); el hex va en el comentario. ---

// ¿El code point ocupa DOS celdas? (East Asian Wide + Fullwidth + bloques emoji comunes.)
fn is_wide(cp: int) -> bool {
    cp >= 0x1100 && cp <= 0x115F || cp >= 0x231A && cp <= 0x231B || cp >= 0x2600 && cp <= 0x2613 || cp >= 0x2E80 && cp <= 0x303E || cp >= 0x3041 && cp <= 0x30FF || cp >= 0x3105 && cp <= 0x312F || cp >= 0x3131 && cp <= 0x318E || cp >= 0x3200 && cp <= 0x33FF || cp >= 0x3400 && cp <= 0x4DBF || cp >= 0x4E00 && cp <= 0xA48C || cp >= 0xAC00 && cp <= 0xD7A3 || cp >= 0xF900 && cp <= 0xFAFF || cp >= 0xFE30 && cp <= 0xFE6B || cp >= 0xFF01 && cp <= 0xFF60 || cp >= 0xFFE0 && cp <= 0xFFE6 || cp >= 0x1F300 && cp <= 0x1FAFF || cp >= 0x20000 && cp <= 0x3FFFD  // Hangul Jamo (0x1100–0x115F)
    // ⌚⌛ (0x231A–0x231B)
    // símbolos meteorológicos anchos (0x2600–0x2613)
    // radicales/puntuación CJK (0x2E80–0x303E)
    // kana (0x3041–0x30FF)
    // Bopomofo (0x3105–0x312F)
    // Hangul compat Jamo (0x3131–0x318E)
    // símbolos CJK cercados (0x3200–0x33FF)
    // CJK ext A (0x3400–0x4DBF)
    // CJK unificado + Yi (0x4E00–0xA48C)
    // sílabas Hangul (0xAC00–0xD7A3)
    // CJK compat (0xF900–0xFAFF)
    // formas CJK compat (0xFE30–0xFE6B)
    // formas fullwidth (0xFF01–0xFF60)
    // signos fullwidth (0xFFE0–0xFFE6)
    // bloques emoji (0x1F300–0x1FAFF)
    // CJK ext B+ (0x20000–0x3FFFD)
}

// ¿El code point es de ancho CERO? (Control C0/C1 y marcas combinantes / de ancho cero comunes.)
fn is_zero_width(cp: int) -> bool {
    cp < 0x20 || cp >= 0x7F && cp < 0xA0 || cp >= 0x300 && cp <= 0x36F || cp >= 0x1AB0 && cp <= 0x1AFF || cp >= 0x1DC0 && cp <= 0x1DFF || cp >= 0x200B && cp <= 0x200F || cp >= 0x20D0 && cp <= 0x20FF || cp >= 0xFE20 && cp <= 0xFE2F || cp == 0xFEFF  // control C0 (0x00–0x1F) y C1 (0x7F–0x9F)
    // combinantes diacríticos (0x0300–0x036F)
    // combinantes extendidos (0x1AB0–0x1AFF)
    // combinantes suplementarios (0x1DC0–0x1DFF)
    // espacios/marcas de ancho cero (0x200B–0x200F)
    // combinantes para símbolos (0x20D0–0x20FF)
    // selectores de variación combinantes (0xFE20–0xFE2F)
    // BOM / zero-width no-break space (0xFEFF)
}

/// The display width of a character in terminal cells: 0 for control and combining code points,
/// 2 for East Asian Wide/Fullwidth and the common emoji blocks, 1 otherwise.
pub fn char_width(c: char) -> int {
    let cp = c as int;
    if (is_zero_width(cp)) {
        0
    } else if (is_wide(cp)) {
        2
    } else {
        1
    }
}

/// The display width of a string in terminal cells (the sum of its characters' widths). Use it to
/// align columns that may contain CJK, kana or emoji, where `s.len()` (a character count) is wrong.
pub fn width(s: string) -> int {
    var w = 0;
    for c in s.chars() {
        w = w + char_width(c);
    }
    w
}

/// Truncates `s` to at most `cells` display cells and pads with spaces to EXACTLY `cells` (left
/// aligned). A wide character that would straddle the boundary is dropped (not split). The
/// column-building primitive for a TUI.
pub fn fit(s: string, cells: int) -> string {
    var out = "";
    var w = 0;
    var done = false;
    for c in s.chars() {
        if (!done) {
            let cw = char_width(c);
            if (w + cw > cells) {
                done = true;  // no cabe: deja de añadir (una wide no se parte)
            } else {
                out = out + to_string(c);
                w = w + cw;
            }
        }
    }
    while (w < cells) {
        out = out + " ";
        w = w + 1;
    }
    out
}

/// Like `fit`, but right aligned — pads on the LEFT to `cells` cells (for numeric columns). If `s`
/// is already wider than `cells`, it is truncated like `fit`.
pub fn fit_right(s: string, cells: int) -> string {
    let w = width(s);
    if (w >= cells) {
        return fit(s, cells);
    }
    var pad = "";
    var i = w;
    while (i < cells) {
        pad = pad + " ";
        i = i + 1;
    }
    pad + s
}
