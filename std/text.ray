// std/text (M40.4c) — utilidades de string que complementan los builtins (trim/split/chars/replace/
// to_upper/substring/repeat/index_of/join/…). Todo `pub`: `import std/text;` → `text.capitalize(s)`.
/// Whether the string is empty.
pub fn is_empty(s: string) -> bool {
    len(s) == 0
}

/// Pads `s` on the LEFT with the string `relleno` until it reaches `ancho` characters (returned
/// unchanged if already that long). `relleno` is repeated whole (use a single character for an exact width).
pub fn pad_left(s: string, ancho: int, relleno: string) -> string {
    let faltan = ancho - len(s);
    if (faltan <= 0) { s } else { repeat(relleno, faltan) + s }
}

/// Like `pad_left`, but padding on the RIGHT.
pub fn pad_right(s: string, ancho: int, relleno: string) -> string {
    let faltan = ancho - len(s);
    if (faltan <= 0) { s } else { s + repeat(relleno, faltan) }
}

/// Uppercases the first character and leaves the rest unchanged. Empty string → empty.
pub fn capitalize(s: string) -> string {
    if (len(s) == 0) {
        s
    } else {
        to_upper(substring(s, 0, 1)) + substring(s, 1, len(s))
    }
}

/// Reverses the string character by character.
pub fn reverse(s: string) -> string {
    let cs = chars(s);
    var out = "";
    var i = len(cs) - 1;
    while (i >= 0) {
        out = out + to_string(cs[i]);
        i = i - 1;
    }
    out
}

/// Number of **non-overlapping** occurrences of `sub` in `s` (empty `sub` → 0).
pub fn count(s: string, sub: string) -> int {
    if (len(sub) == 0) {
        0
    } else {
        var n = 0;
        var resto = s;
        var seguir = true;
        while (seguir) {
            match (index_of(resto, sub)) {
                Option.Some(i) => {
                    n = n + 1;
                    resto = substring(resto, i + len(sub), len(resto));
                },
                Option.None => {
                    seguir = false;
                },
            }
        }
        n
    }
}

/// Splits `s` into words separated by spaces, discarding empty ones (repeated spaces).
pub fn words(s: string) -> [string] {
    let partes = split(s, " ");
    var out: [string] = [];
    var i = 0;
    while (i < len(partes)) {
        if (len(partes[i]) > 0) {
            push(out, partes[i]);
        }
        i = i + 1;
    }
    out
}
