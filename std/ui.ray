// std/ui (M146) — la PRIMITIVA ventana + webview (IDEAS §80 F1): una ventana nativa del SO con
// el webview del sistema cargando una URL. Para apps chicas, el puente IPC integrado basta:
// `window.ray.send(text)` en la página → evento `"message"` (M152), y `eval_js` de vuelta; el
// patrón con backend sigue siendo el webserver embebido + framework web (fetch/WS).
//
// No hay `ui.run()`: el runtime captura el hilo principal por su cuenta en la primera ventana.
// Los eventos (una cola por proceso) se leen con `next_event`/`next_event_timeout` (la fibra
// aparca — sin sondeo) o como canal con `events()`. `close(h)` cierra la ventana.
//
// Backends: AppKit/WKWebView en macOS; `RAY_UI_BACKEND=headless` (tests/CI) en cualquier OS.

/// One UI event. `kind` is "closed" (the window left the screen — the red button and
/// `close(h)` both report here, exactly once per window; `tag` is empty), "menu" (a custom
/// menu item was clicked: `tag` carries the item's tag and `window` is 0 — menus belong to the
/// app, not to one window), or "message" (the page called `window.ray.send(text)`: `tag`
/// carries the text — strings only, NULs removed by the bridge; `window` is the window's
/// handle on desktop and 0 on iOS). `window` is the window's handle for per-window events.
/// In headless mode the env var RAY_UI_MSG injects one "message" per opened window (tests).
pub struct UiEvent {
    kind: string,
    window: int,
    tag: string,
}

/// Opens a native window with the system webview loading `url` (point it at your embedded
/// webserver: `http://127.0.0.1:<port>/`). Returns the window handle; `close(h)` closes it.
/// With `RAY_UI_BACKEND=headless` in the environment, windows are in-memory rows (tests, CI).
pub fn open(title: string, url: string, width: int, height: int) -> Result<int, string> {
    let r = __ui_open(title, url, width, height);
    if (r[0] == "ok") {
        match (parse_int(r[1])) {
            Option.Some(h) => Result.Ok(h),
            Option.None => Result.Err("invalid handle"),
        }
    } else {
        Result.Err(r[1])
    }
}

/// Runs JavaScript in the window's page, fire-and-forget: it does NOT wait for the result (and
/// before the page finishes loading it may be a no-op). `Err` if the handle is not a window.
pub fn eval_js(h: int, js: string) -> Result<int, string> {
    let r = __ui_eval_js(h, js);
    if (r[0] == "ok") { Result.Ok(0) } else { Result.Err(r[1]) }
}

/// The next UI event, waiting as long as it takes (the fiber parks — the process sleeps, it
/// does not poll). The queue is process-wide: events from every window arrive here.
pub fn next_event() -> Result<UiEvent, string> {
    let r = __ui_next_event(0);
    if (r[0] == "ok") {
        match (parse_int(r[2])) {
            Option.Some(w) => Result.Ok(UiEvent { kind: r[1], window: w, tag: r[3] }),
            Option.None => Result.Err("invalid window id"),
        }
    } else {
        Result.Err(r[1])
    }
}

/// The next UI event with a deadline: `Ok(Some(event))`, or `Ok(None)` if `timeout_ms` elapsed
/// with no event.
pub fn next_event_timeout(timeout_ms: int) -> Result<Option<UiEvent>, string> {
    let r = __ui_next_event(timeout_ms);
    if (r[0] == "ok") {
        match (parse_int(r[2])) {
            Option.Some(w) => Result.Ok(Option.Some(UiEvent { kind: r[1], window: w, tag: r[3] })),
            Option.None => Result.Err("invalid window id"),
        }
    } else if (r[0] == "timeout") {
        Result.Ok(Option.None)
    } else {
        Result.Err(r[1])
    }
}

/// One item of a custom menu: `tag` travels in the click event (`kind == "menu"`), `title` is
/// what the menu shows, and `shortcut` is a single character for Cmd+key on macOS (uppercase
/// adds Shift; empty = no shortcut; Linux v1 is click-only).
pub struct MenuItem {
    tag: string,
    title: string,
    shortcut: string,
}

/// Adds one top-level menu with custom items. Clicking an item emits a `"menu"` event whose
/// `tag` is the item's tag (window 0 — menus belong to the app). On macOS the menu bar is
/// global and gains the menu immediately; on Linux the bar is per-window and the menu applies
/// to windows opened AFTER this call. The standard App/Edit menus (quit, clipboard, undo)
/// install themselves — you only declare your own. Headless: a no-op `Ok`.
pub fn menu(title: string, items: [MenuItem]) -> Result<int, string> {
    let r = __ui_menu(title, encode_items(items));
    if (r[0] == "ok") { Result.Ok(0) } else { Result.Err(r[1]) }
}

// La codificación del borde de builtins ([string], "tag\ttitle\tshortcut"), compartida por
// menu y app_menu.
fn encode_items(items: [MenuItem]) -> [string] {
    var encoded: [string] = [];
    var i = 0;
    while (i < items.len()) {
        let it = items[i];
        encoded.push(it.tag + "\t" + it.title + "\t" + it.shortcut);
        i = i + 1;
    }
    encoded
}

/// Adds items to the APPLICATION menu — on macOS, the bold first menu of the global bar —
/// inserted ABOVE Hide/Quit (a separator is added after yours). A non-empty `name` also
/// retitles that menu: useful under `ray run`, where it defaults to the process name ("ray");
/// a bundled .app already shows its own name. An item whose tag is `"role:about"` becomes the
/// NATIVE "About" item on macOS (standard about panel; it does NOT emit an event; empty title
/// = "About"). On Linux there is no global application menu: the items are added as a regular
/// per-window menu titled `name` and EVERY item — `"role:about"` included — emits the usual
/// `"menu"` event with its tag, so the program shows its own about. Headless: a no-op `Ok`.
/// Call it once, before opening windows.
pub fn app_menu(name: string, items: [MenuItem]) -> Result<int, string> {
    let r = __ui_app_menu(name, encode_items(items));
    if (r[0] == "ok") { Result.Ok(0) } else { Result.Err(r[1]) }
}

// El desempaquetado común de __ui_dialog: ["ok", path] / ["none"] / ["err", msg].
fn dialog_result(r: [string]) -> Result<Option<string>, string> {
    if (r[0] == "ok") {
        Result.Ok(Option.Some(r[1]))
    } else if (r[0] == "none") {
        Result.Ok(Option.None)
    } else {
        Result.Err(r[1])
    }
}

/// Opens the native "choose a file" dialog, MODAL: the call parks until the user decides.
/// `Ok(Some(path))`, or `Ok(None)` if they cancelled. One modal at a time (on macOS other UI
/// operations wait while the panel is open). Headless: the result is injected via the
/// `RAY_UI_PICK` environment variable (unset/empty = None) — how the test battery drives it.
pub fn pick_file() -> Result<Option<string>, string> {
    dialog_result(__ui_dialog("open_file", ""))
}

/// Like `pick_file`, for choosing a FOLDER.
pub fn pick_folder() -> Result<Option<string>, string> {
    dialog_result(__ui_dialog("open_folder", ""))
}

/// The native "save as" dialog with `suggested` as the pre-filled file name. `Ok(Some(path))`
/// is where the user wants the file written (writing it is your job), `Ok(None)` = cancelled.
pub fn save_file(suggested: string) -> Result<Option<string>, string> {
    dialog_result(__ui_dialog("save_file", suggested))
}

/// The UI events as a channel: spawns a pump fiber that forwards `next_event()` into it — use
/// it to `select` UI events alongside your other channels. Needs the VM or a native build
/// (`spawn`); on an error from the queue the pump ends and the channel goes quiet.
pub fn events() -> Channel<UiEvent> {
    let ch: Channel<UiEvent> = Channel.new();
    spawn(fn() {
        var running = true;
        while (running) {
            match (next_event()) {
                Result.Ok(e) => send(ch, e),
                Result.Err(_) => {
                    running = false;
                },
            }
        }
    });
    ch
}
