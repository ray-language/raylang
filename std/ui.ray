// std/ui (M146) — la PRIMITIVA ventana + webview (IDEAS §80 F1): una ventana nativa del SO con
// el webview del sistema cargando una URL. Para apps chicas, el puente IPC integrado basta:
// `window.ray.send(text)` en la página → evento `"message"` (M152), y `eval_js` de vuelta; el
// patrón con backend sigue siendo el webserver embebido + framework web (fetch/WS).
//
// No hay `ui.run()`: el runtime captura el hilo principal por su cuenta en la primera ventana.
// Los eventos (una cola por proceso) se leen con `next_event`/`next_event_timeout` (la fibra
// aparca — sin sondeo) o como canal con `events()`. `close(h)` cierra la ventana.
//
// Backends: AppKit/WKWebView en macOS; `RAY_UI_BACKEND=headless` (tests/CI) en cualquier OS.

import std/json;
from std/json import Json;

/// One UI event. `kind` is "closed" (the window left the screen — the red button and
/// `close(h)` both report here, exactly once per window; `tag` is empty), "menu" (a custom
/// menu item was chosen: `tag` is the item's tag; `window` is the handle of the window that
/// was key/active at that moment — M252 — or 0 when none is, e.g. with every window closed),
/// "focused" (M252: `window` became the key/active one — on open, on `focus(h)` and whenever
/// the user brings it to the front; use it to know which window a menu action refers to and to
/// refresh on regaining focus), "message" (the page called `window.ray.send(text)`: `tag`
/// is the text and `window` the sender), "close_requested" (M257: the user tried to close
/// `window` while `intercept_close(h, true)` is on — the window stays open until you `close(h)`)
/// "quit_requested" (M257: the user pressed ⌘Q / Quit while `intercept_quit(true)` is on —
/// `window` is 0; the app keeps running until `main` returns) or "open" (M370: the system asked
/// the app to open something — a file or folder dropped on its Dock icon, "Open with",
/// `open -a App path` — `tag` is the path, one event per item, also when the app is already
/// running; `window` is 0. On macOS it needs a `ray bundle` with `[app] opens`; a bare binary
/// still gets its launch arguments in `args()`). In the iOS/Android shells of
/// `ray bundle` there is one more kind, "lifecycle" (`tag` is "background" or "foreground"),
/// and every event carries `window == 0` — the shell's single webview; `reply(0, …)` and
/// `eval_js(0, …)` address it.
/// In headless mode opening a window produces no event; `focus(h)` emits "focused", the
/// env var RAY_UI_MSG injects one "message" per opened window, and RAY_UI_OPEN (paths
/// separated by `:`) injects the "open" events once per process (tests).
pub struct UiEvent {
    kind: string,
    window: int,
    tag: string,
}

/// Resolves an `app://` URL to where the app's pages live RIGHT NOW (M263, `[frontend]` of
/// `ray.toml`): under `ray dev` with a frontend dev server (Vite, …) `app://index.html` becomes
/// `<dev server url>/index.html` — hot module replacement included —; everywhere else (`ray run`,
/// a native binary, a bundle) it becomes `ray://app/index.html`, the embedded build mounted
/// with `mount_embed`. Any other URL is returned unchanged, except that under `ray dev` an
/// `http://` URL of your own webserver also swaps its origin for the dev server's (so a
/// webserver-backed app develops against Vite too). `open`/`open_with` apply it to `app://` URLs.
/// A DEVELOPMENT build (`ray run --devtools`, `ray build --native --devtools`, `ray bundle
/// --devtools`) also honours `RAY_DEV_FRONTEND_URL`: if that dev server answers, `app://` resolves
/// there instead of the embedded build (hot reload on a phone); a build without `--devtools`
/// always ignores it.
pub fn app_url(url: string) -> string {
    let dev = __ui_frontend_url();
    if (url.starts_with("app://")) {
        let rest = url.substring(6, url.len());
        if (dev == "") { "ray://app/" + rest } else { dev + "/" + rest }
    } else if (dev != "" && url.starts_with("http://")) {
        // Sustituye el origen (`http://host:port`) por el del dev server; conserva la ruta.
        let after = url.substring(7, url.len());
        match (index_of(after, "/")) {
            Option.Some(i) => dev + after.substring(i, after.len()),
            Option.None => dev,
        }
    } else {
        url
    }
}

/// Opens a native window with the system webview loading `url` (point it at your embedded
/// webserver: `http://127.0.0.1:<port>/`, or use `app://index.html` — see `app_url` — for a
/// frontend built with Vite and served from the embedded build). Returns the window handle.
/// The handle is a plain `int` like a file or socket handle: the prelude's **`close(h)` closes
/// the window** (there is no `ui.close`), emitting `closed` for it; a handle already closed by the
/// user is a no-op. With `RAY_UI_BACKEND=headless` in the environment, windows are in-memory rows
/// (tests, CI).
pub fn open(title: string, url: string, width: int, height: int) -> Result<int, string> {
    mount_web_packages();
    let r = __ui_open(title, resolve_app_url(url), width, height);
    if (r[0] == "ok") {
        match (parse_int(r[1])) {
            Option.Some(h) => Result.Ok(h),
            Option.None => Result.Err("invalid handle"),
        }
    } else {
        Result.Err(r[1])
    }
}

/// Window geometry beyond width × height (M210). `min_width`/`min_height` (0 = no minimum),
/// `resizable`, `center` (initial position centered on the main screen) and `autosave`: a name
/// under which the SYSTEM remembers size and position between launches (NSWindow's
/// `frameAutosaveName` on macOS; Linux and Windows have no equivalent and ignore it; "" = don't).
/// `titlebar_color` (M224): a `#rrggbb` color that paints the system title bar like the app's
/// theme (macOS: transparent title bar over the window background, dark or light title text by
/// luminance; Windows 11: the caption color; Linux ignores it; "" = system default).
/// `background` (M327): the `#rrggbb` color the window shows UNTIL the page paints — no white
/// or grey flash while WebKit parses a large app (macOS: the webview's under-page color and the
/// window background; Linux: WebKitGTK's background color; Windows: WebView2's default
/// background and the window's erase color). "" = `titlebar_color` when set (the same theme
/// color in both places), otherwise the system's. `ui.set_background(h, color)` changes it later.
/// `minimizable` (M230): `false` disables the minimize button (macOS yellow light, Windows
/// `WS_MINIMIZEBOX`) for secondary panels such as an About window; GTK ignores it.
/// `kind` (M260): `"document"` (the default window), `"panel"` (a floating utility palette that
/// stays above the app's windows — macOS `NSPanel`, Windows tool window, GTK utility hint; a
/// command palette, a find panel), `"borderless"` (no frame, no title bar — you draw everything;
/// the window is movable by dragging its background on macOS) or `"full_content"` (M328: the page
/// extends UNDER the title bar, Chrome/VS Code style — macOS: transparent bar, hidden title, the
/// traffic lights float over the page; Linux/Windows: like `document` for now). The page reserves
/// that strip with `window.ray.titlebar_height` (px; 0 when there is none) and marks what should
/// drag the window with `data-ray-drag` on an element (children `button`/`a`/`input`/
/// `select`/`textarea` or `data-ray-no-drag` stay clickable; double-click zooms) — macOS and
/// Windows honour it, also for `borderless` windows. `always_on_top` (M260) keeps the
/// window above every other window. `parent` (M260) is the handle of the OWNING window (0 =
/// none): the new one stays above it and follows it — the closest thing to a sheet on every OS.
/// Build it with `ui.options(width, height)` and tweak the fields you need.
pub struct WindowOptions {
    width: int,
    height: int,
    min_width: int,
    min_height: int,
    resizable: bool,
    center: bool,
    autosave: string,
    titlebar_color: string,
    background: string,
    minimizable: bool,
    kind: string,
    always_on_top: bool,
    parent: int,
}

/// The defaults of `ui.open` as a `WindowOptions`: no minimum, resizable, centered, no autosave,
/// system title bar.
pub fn options(width: int, height: int) -> WindowOptions {
    WindowOptions {
        width: width,
        height: height,
        min_width: 0,
        min_height: 0,
        resizable: true,
        center: true,
        autosave: "",
        titlebar_color: "",
        background: "",
        minimizable: true,
        kind: "document",
        always_on_top: false,
        parent: 0
    }
}

/// Like `open`, with `WindowOptions`: `ui.open_with("App", url, ui.options(1024, 720))` after
/// setting e.g. `o.min_width = 640; o.autosave = "main"; o.titlebar_color = "#1f2430";`. Errors
/// on an invalid size, a minimum larger than the window or a color that is not `#rrggbb`.
pub fn open_with(title: string, url: string, o: WindowOptions) -> Result<int, string> {
    mount_web_packages();
    let r = __ui_open_with(
        title,
        resolve_app_url(url),
        o.width,
        o.height,
        o.min_width,
        o.min_height,
        o.resizable,
        o.center,
        o.autosave,
        o.titlebar_color,
        o.minimizable,
        o.kind,
        o.always_on_top,
        o.parent,
        o.background
    );
    if (r[0] == "ok") {
        match (parse_int(r[1])) {
            Option.Some(h) => Result.Ok(h),
            Option.None => Result.Err("invalid handle"),
        }
    } else {
        Result.Err(r[1])
    }
}

// Solo `app://` se resuelve al abrir: una URL `http://` explícita en `open` se respeta tal cual
// (quien quiera el intercambio de origen bajo `ray dev` llama a `app_url` a mano).
fn resolve_app_url(url: string) -> string {
    if (url.starts_with("app://")) { app_url(url) } else { url }
}

/// Runs JavaScript in the window's page, fire-and-forget: it does NOT wait for the result (and
/// before the page finishes loading it may be a no-op). `Err` if the handle is not a window.
pub fn eval_js(h: int, js: string) -> Result<int, string> {
    let r = __ui_eval_js(h, js);
    if (r[0] == "ok") { Result.Ok(0) } else { Result.Err(r[1]) }
}

/// The next UI event, waiting as long as it takes (the fiber parks — the process sleeps, it
/// does not poll). The queue is process-wide: events from every window arrive here.
pub fn next_event() -> Result<UiEvent, string> {
    let r = __ui_next_event(0);
    if (r[0] == "ok") {
        match (parse_int(r[2])) {
            Option.Some(w) => Result.Ok(UiEvent { kind: r[1], window: w, tag: r[3] }),
            Option.None => Result.Err("invalid window id"),
        }
    } else {
        Result.Err(r[1])
    }
}

/// The next UI event with a deadline: `Ok(Some(event))`, or `Ok(None)` if `timeout_ms` elapsed
/// with no event.
pub fn next_event_timeout(timeout_ms: int) -> Result<Option<UiEvent>, string> {
    let r = __ui_next_event(timeout_ms);
    if (r[0] == "ok") {
        match (parse_int(r[2])) {
            Option.Some(w) => Result.Ok(Option.Some(UiEvent { kind: r[1], window: w, tag: r[3] })),
            Option.None => Result.Err("invalid window id"),
        }
    } else if (r[0] == "timeout") {
        Result.Ok(Option.None)
    } else {
        Result.Err(r[1])
    }
}

/// Decodes a request sent with `window.ray.request(value)` (M157): `Some((id, body))` when
/// this `"message"` event carries the request envelope, `None` for a plain
/// `window.ray.send`. `body` is the payload — a string, or the JSON text of a non-string
/// value (parse it with `std/json`). Answer with `reply(e.window, id, value)`; an
/// unanswered request leaves the page's Promise pending forever (your protocol decides).
pub fn as_request(e: UiEvent) -> Option<(int, string)> {
    if (e.kind != "message") {
        return Option.None;
    }
    // M225: sobre parseado con substring/index_of — lineal (antes carácter a carácter, cuadrático).
    let tag = e.tag;
    if (tag.len() < 4 || tag[0] != '\u{1}' || tag[1] != 'q' || tag[2] != '\u{1}') {
        return Option.None;
    }
    let rest = tag.substring(3, tag.len());
    match (index_of(rest, "\u{1}")) {
        Option.Some(k) => match (parse_int(rest.substring(0, k))) {
            Option.Some(id) => Option.Some((id, rest.substring(k + 1, rest.len()))),
            Option.None => Option.None,
        },
        Option.None => Option.None,
    }
}

/// Resolves the page's Promise for the request `id` with `value` (M157): the page's
/// `window.ray.request(...).then(v => …)` receives it as a string. Delivered over the same
/// fire-and-forget `eval_js`; the JS literal is escaped natively in one pass (M225: linear —
/// a 1 MB reply takes milliseconds, not seconds). In the iOS/Android shells the page's events
/// arrive with `window == 0` (the shell's single webview): `reply(0, id, value)` answers it.
pub fn reply(window: int, id: int, value: string) -> Result<int, string> {
    let r = __ui_reply(window, id, value, false);
    if (r[0] == "ok") { Result.Ok(0) } else { Result.Err(r[1]) }
}

/// Like `reply`, but the page receives `JSON.parse(json)` — an object, not a string — so the
/// frontend never re-parses by hand (M225). `json` must be valid JSON text (e.g. from
/// `std/json`); invalid text rejects the Promise on the page side.
pub fn reply_json(window: int, id: int, json: string) -> Result<int, string> {
    let r = __ui_reply(window, id, json, true);
    if (r[0] == "ok") { Result.Ok(0) } else { Result.Err(r[1]) }
}

/// One item of a custom menu: `tag` travels in the click event (`kind == "menu"`), `title` is
/// what the menu shows. `shortcut` (M236) is a chord such as `"cmd+s"`, `"cmd+shift+s"`,
/// `"ctrl+alt+p"`, `"f5"` or `"cmd+enter"` — `cmd` is Command on macOS and Ctrl on Linux and
/// Windows (the desktop's primary key), `ctrl` is Control everywhere, `alt`/`option`, `shift`;
/// keys: a character, `f1`..`f12`, `enter`, `escape`, `tab`, `space`, `backspace`, `delete`,
/// arrows, `home`/`end`, `pageup`/`pagedown`. A single character keeps the old meaning
/// (`"s"` = cmd+S, `"S"` = cmd+shift+S); empty = no shortcut; an unknown chord is an `Err` from
/// `menu`. GTK menus stay click-only. `icon` (M236) is an image file path, or `"sf:<name>"`
/// for an SF Symbol on macOS (ignored elsewhere; Windows takes `.bmp` files only). `enabled`
/// and `checked` are the initial state — change them later with `set_menu_item`. Build items
/// with `item(...)`/`separator()` to get the defaults.
pub struct MenuItem {
    tag: string,
    title: string,
    shortcut: string,
    icon: string,
    enabled: bool,
    checked: bool,
}

/// A menu item with the defaults: no icon, enabled, unchecked (M236).
///
/// Standard edit roles (M255): a tag of `"role:undo"`, `"role:redo"`, `"role:cut"`,
/// `"role:copy"`, `"role:paste"`, `"role:select_all"` or `"role:close"` makes the item behave
/// like the system's own — undo, clipboard and select-all act on the focused webview, close
/// closes the key window — and it emits NO `"menu"` event. An empty `title` or `shortcut`
/// takes the standard one (`"Paste"`, `"cmd+v"`); give your own to rename or rebind it. This is
/// what lets you rebuild the Edit menu (`edit_menu`/`replace_menu("Edit", …)`) with your items
/// between the standard ones without losing the clipboard. `set_menu_item` works on them by tag.
pub fn item(tag: string, title: string, shortcut: string) -> MenuItem {
    MenuItem { tag: tag, title: title, shortcut: shortcut, icon: "", enabled: true, checked: false }
}

/// A separator line between groups of items (M236). It carries no tag and never emits an event.
pub fn separator() -> MenuItem {
    MenuItem { tag: "", title: "-", shortcut: "", icon: "", enabled: true, checked: false }
}

/// Adds one top-level menu with custom items. Clicking an item emits a `"menu"` event whose
/// `tag` is the item's tag (window 0 — menus belong to the app). On macOS the menu bar is
/// global and gains the menu immediately; on Linux the bar is per-window and the menu applies
/// to windows opened AFTER this call. The standard App/Edit menus (quit, clipboard, undo)
/// install themselves — you only declare your own. Headless: a no-op `Ok`.
pub fn menu(title: string, items: [MenuItem]) -> Result<int, string> {
    let r = __ui_menu(title, encode_items(items));
    if (r[0] == "ok") { Result.Ok(0) } else { Result.Err(r[1]) }
}

// La codificación del borde de builtins ([string], "tag\ttitle\tshortcut"), compartida por
// menu y app_menu.
fn encode_items(items: [MenuItem]) -> [string] {
    var encoded: [string] = [];
    var i = 0;
    while (i < items.len()) {
        let it = items[i];
        let en = if (it.enabled) { "1" } else { "0" };
        let ch = if (it.checked) { "1" } else { "0" };
        encoded.push(
            it.tag + "\t" + it.title + "\t" + it.shortcut + "\t" + it.icon + "\t" + en + "\t" + ch
        );
        i = i + 1;
    }
    encoded
}

/// Like `menu`, at `position` in the menu bar (M236, ray-sublime #68): counted from the first
/// menu after the application menu on macOS (`0` = right after it, before the standard Edit),
/// and from the first menu on Linux and Windows. Out of range = at the end (`-1` = at the end).
pub fn menu_at(position: int, title: string, items: [MenuItem]) -> Result<int, string> {
    let r = __ui_menu_at(position, title, encode_items(items));
    if (r[0] == "ok") { Result.Ok(0) } else { Result.Err(r[1]) }
}

/// Replaces the contents of the top-level menu titled `title` with `items` (M250,
/// ray-sublime): the old items disappear (their tags no longer exist for `set_menu_item`) and
/// the new ones take their place, in the same position of the bar — the way to change titles
/// and shortcuts after the fact (a keymap preset, a "recent files" list). Immediate on macOS;
/// on Linux and Windows it rebuilds the bar of every open window and applies to the windows
/// opened afterwards. `Err` if no menu has that title (`menu`/`menu_at` create one).
pub fn replace_menu(title: string, items: [MenuItem]) -> Result<int, string> {
    let r = __ui_replace_menu(title, encode_items(items));
    if (r[0] == "ok") { Result.Ok(0) } else { Result.Err(r[1]) }
}

/// The Edit menu, rebuilt with your items (M255, ray-sublime): on macOS it REPLACES the
/// contents of the standard Edit menu, in place; on Linux and Windows — where no Edit menu is
/// installed by default (the webview handles the clipboard keys itself) — it creates one at the
/// end of the bar the first time and replaces it afterwards, so call it right after declaring
/// File. Keep the system behaviour with the `"role:*"` items (see `item`) and add your own
/// around them:
///
/// ```raylang
/// ui.edit_menu([
///     ui.item("role:undo", "", ""), ui.item("role:redo", "", ""), ui.separator(),
///     ui.item("role:cut", "", ""), ui.item("role:copy", "", ""), ui.item("role:paste", "", ""),
///     ui.separator(), ui.item("find", "Find...", "cmd+f"), ui.item("role:select_all", "", ""),
/// ])?;
/// ```
pub fn edit_menu(items: [MenuItem]) -> Result<int, string> {
    match (replace_menu("Edit", items)) {
        Result.Ok(v) => Result.Ok(v),
        Result.Err(_) => menu("Edit", items),
    }
}

/// A CONTEXT menu (M259): shows `items` at the current mouse position, over window `h`. The call
/// returns as soon as the menu is on screen; the choice arrives as a `"menu"` event (`tag` =
/// the item's tag, `window` = h), exactly like the menu bar — standard `"role:*"` items act
/// natively. The items live while the menu is open (`set_menu_item` works on them meanwhile).
/// Typical wiring: the page captures `contextmenu`, sends a message, the program pops the menu:
///
/// ```raylang
/// // page: document.oncontextmenu = (e) => { e.preventDefault(); window.ray.send("ctx:" + targetId); };
/// if (e.kind == "message" && e.tag.starts_with("ctx:")) {
///     ui.popup_menu(e.window, [ui.item("rename", "Rename...", ""), ui.item("delete", "Delete", "")])?;
/// }
/// ```
pub fn popup_menu(h: int, items: [MenuItem]) -> Result<int, string> {
    let r = __ui_popup_menu(h, encode_items(items));
    if (r[0] == "ok") { Result.Ok(0) } else { Result.Err(r[1]) }
}

/// Changes the state of an already declared item, by tag (M236): `enabled` (greyed out or
/// not) and `checked` (the check mark). Works for custom and application-menu items, and for
/// the windows opened afterwards on Linux and Windows (their bar is per window). `Err` for an
/// unknown tag.
pub fn set_menu_item(tag: string, enabled: bool, checked: bool) -> Result<int, string> {
    let r = __ui_set_menu_item(tag, enabled, checked);
    if (r[0] == "ok") { Result.Ok(0) } else { Result.Err(r[1]) }
}

/// Declares the content of the native "About" panel that the `"role:about"` menu item of
/// `app_menu` opens (macOS): `name` (the bold app name), `version` (the "Version …" line),
/// `description` (shown as the credits text under the version, like Finder's subtitle) and
/// `copyright`. Pass `""` to omit a field — the panel then shows what the app bundle
/// declares (`ray bundle` fills name/version/icon from ray.toml, and copyright from
/// `[app] copyright`). Call it any time before the user clicks the item; without it the
/// panel is the bare system one. On Linux `"role:about"` arrives as a `"menu"` event (show
/// your own about — these values are stored but there is no native panel); iOS has no menu
/// bar. Headless: stored, `Ok`.
pub fn set_about(
    name: string,
    version: string,
    description: string,
    copyright: string
) -> Result<int, string> {
    let r = __ui_set_about(name, version, description, copyright);
    if (r[0] == "ok") { Result.Ok(0) } else { Result.Err(r[1]) }
}

/// Adds items to the APPLICATION menu — on macOS, the bold first menu of the global bar —
/// inserted ABOVE Hide/Quit (a separator is added after yours). A non-empty `name` also
/// retitles that menu: useful under `ray run`, where it defaults to the process name ("ray");
/// a bundled .app already shows its own name. An item whose tag is `"role:about"` becomes the
/// NATIVE "About" item on macOS (standard about panel; it does NOT emit an event; empty title
/// = "About"). On Linux there is no global application menu: the items are added as a regular
/// per-window menu titled `name` and EVERY item — `"role:about"` included — emits the usual
/// `"menu"` event with its tag, so the program shows its own about. Headless: a no-op `Ok`.
/// Call it once, before opening windows.
pub fn app_menu(name: string, items: [MenuItem]) -> Result<int, string> {
    let r = __ui_app_menu(name, encode_items(items));
    if (r[0] == "ok") { Result.Ok(0) } else { Result.Err(r[1]) }
}

// El desempaquetado común de __ui_dialog: ["ok", path] / ["none"] / ["err", msg].
fn dialog_result(r: [string]) -> Result<Option<string>, string> {
    if (r[0] == "ok") {
        Result.Ok(Option.Some(r[1]))
    } else if (r[0] == "none") {
        Result.Ok(Option.None)
    } else {
        Result.Err(r[1])
    }
}

/// Opens the native "choose a file" dialog, MODAL: the call parks until the user decides.
/// `Ok(Some(path))`, or `Ok(None)` if they cancelled. One modal at a time (on macOS other UI
/// operations wait while the panel is open). Headless: the result is injected via the
/// `RAY_UI_PICK` environment variable (unset/empty = None) — how the test battery drives it.
pub fn pick_file() -> Result<Option<string>, string> {
    dialog_result(__ui_dialog("open_file", ""))
}

/// Like `pick_file`, for choosing a FOLDER.
pub fn pick_folder() -> Result<Option<string>, string> {
    dialog_result(__ui_dialog("open_folder", ""))
}

/// A file-type filter for the file dialogs (M258): a display name and the extensions without
/// the dot (`filter("Ray sources", ["ray", "toml"])`).
pub struct FileFilter {
    name: string,
    extensions: [string],
}

/// Builds a `FileFilter`.
pub fn filter(name: string, extensions: [string]) -> FileFilter {
    FileFilter { name: name, extensions: extensions }
}

/// Options for the file dialogs (M258). `title` (the dialog's title/prompt; "" = the system
/// default), `directory` (the folder it opens in; "" = the system's choice), `suggested` (the
/// pre-filled file name for "save as"), `filters` (selectable file types; empty = any file) and
/// `multiple` (allow choosing several files — `pick_files`). Start from `file_options()`.
pub struct FileDialogOptions {
    title: string,
    directory: string,
    suggested: string,
    filters: [FileFilter],
    multiple: bool,
}

/// The defaults of `pick_file`/`pick_folder`/`save_file` as a `FileDialogOptions`.
pub fn file_options() -> FileDialogOptions {
    FileDialogOptions { title: "", directory: "", suggested: "", filters: [], multiple: false }
}

// Codificación del borde de builtins para los filtros: "nombre\text1,ext2".
fn encode_filters(filters: [FileFilter]) -> [string] {
    var encoded: [string] = [];
    var i = 0;
    while (i < filters.len()) {
        let f = filters[i];
        encoded.push(f.name + "\t" + f.extensions.join(","));
        i = i + 1;
    }
    encoded
}

fn dialog_with(kind: string, o: FileDialogOptions, multiple: bool) -> Result<[string], string> {
    let r = __ui_dialog_with(
        kind,
        o.title,
        o.directory,
        o.suggested,
        encode_filters(o.filters),
        multiple
    );
    if (r[0] == "ok") {
        var paths: [string] = [];
        var i = 1;
        while (i < r.len()) {
            paths.push(r[i]);
            i = i + 1;
        }
        Result.Ok(paths)
    } else if (r[0] == "none") {
        Result.Ok([])
    } else {
        Result.Err(r[1])
    }
}

fn first_of(r: Result<[string], string>) -> Result<Option<string>, string> {
    match (r) {
        Result.Ok(paths) => if (paths.len() == 0) {
            Result.Ok(Option.None)
        } else {
            Result.Ok(Option.Some(paths[0]))
        },
        Result.Err(e) => Result.Err(e),
    }
}

/// `pick_file` with options (M258): title, initial folder and type filters. Modal like
/// `pick_file`; `Ok(None)` = cancelled.
pub fn pick_file_with(o: FileDialogOptions) -> Result<Option<string>, string> {
    first_of(dialog_with("open_file", o, false))
}

/// The "choose files" dialog with MULTIPLE selection (M258): the chosen paths, `Ok([])` if the
/// user cancelled. Honors `title`, `directory` and `filters`.
pub fn pick_files(o: FileDialogOptions) -> Result<[string], string> {
    dialog_with("open_file", o, true)
}

/// `pick_folder` with options (M258): title and initial folder (filters do not apply).
pub fn pick_folder_with(o: FileDialogOptions) -> Result<Option<string>, string> {
    first_of(dialog_with("open_folder", o, false))
}

/// `save_file` with options (M258): title, initial folder, `suggested` name and type filters.
pub fn save_file_with(o: FileDialogOptions) -> Result<Option<string>, string> {
    first_of(dialog_with("save_file", o, false))
}

/// A native message dialog, MODAL (M258): `title` (the bold line), `text` (the detail) and 1 to
/// 3 `buttons` with your labels, in order. Returns the INDEX of the button pressed; dismissing
/// the dialog (Esc, the close box) counts as the LAST button — put "Cancel" last. Informational
/// style; see `message_styled` for warnings and errors. Headless: `RAY_UI_ANSWER` (default 0).
///
/// ```raylang
/// match (ui.message("Save changes?", "Your edits to main.ray will be lost.", ["Save", "Don't Save", "Cancel"])) {
///     Result.Ok(i) => if (i == 0) { save(); } else if (i == 1) { discard(); },
///     Result.Err(e) => print(e),
/// }
/// ```
pub fn message(title: string, text: string, buttons: [string]) -> Result<int, string> {
    message_styled(title, text, "info", buttons)
}

/// `message` with a `style`: `"info"`, `"warning"` or `"error"` (the system icon; on macOS the
/// alert style). Any other style is an `Err`.
pub fn message_styled(
    title: string,
    text: string,
    style: string,
    buttons: [string]
) -> Result<int, string> {
    let r = __ui_message(title, text, style, buttons);
    if (r[0] == "ok") {
        match (parse_int(r[1])) {
            Option.Some(i) => Result.Ok(i),
            Option.None => Result.Err("ui: malformed message result"),
        }
    } else {
        Result.Err(r[1])
    }
}

/// A one-button informational message (M258): `alert("Done", "Exported 12 files.")`.
pub fn alert(title: string, text: string) -> Result<int, string> {
    message(title, text, ["OK"])
}

/// A two-button question (M258): `true` if the user chose the first button (`ok_label`),
/// `false` for `cancel_label` or dismissing the dialog.
pub fn confirm(
    title: string,
    text: string,
    ok_label: string,
    cancel_label: string
) -> Result<bool, string> {
    match (message(title, text, [ok_label, cancel_label])) {
        Result.Ok(i) => Result.Ok(i == 0),
        Result.Err(e) => Result.Err(e),
    }
}

/// The native "save as" dialog with `suggested` as the pre-filled file name. `Ok(Some(path))`
/// is where the user wants the file written (writing it is your job), `Ok(None)` = cancelled.
pub fn save_file(suggested: string) -> Result<Option<string>, string> {
    dialog_result(__ui_dialog("save_file", suggested))
}

/// Brings an already open window to the front and gives it focus (M229): `makeKeyAndOrderFront`
/// on macOS (and the app is activated), `gtk_window_present` on GTK, restore + foreground on
/// Windows. Use it when a menu item targets a window that is open but behind another one;
/// `eval_js(h, "window.focus()")` only focuses the document, not the native window.
///
/// A process started OUTSIDE the graphical session (an ssh shell, a CI runner, an agent's
/// terminal) cannot be activated by the window server: the window opens but stays
/// `document.visibilityState == "hidden"`, no `focused` event arrives, `requestAnimationFrame`
/// never fires and WebKit throttles the page's timers to ~1 s after a few seconds. Automation
/// of a `std/ui` app from such a shell should drive the page with `eval_js` and `MessageChannel`
/// tasks (not `setTimeout`/rAF), or launch the app from the session (`open -a`, Terminal.app).
pub fn focus(h: int) -> Result<int, string> {
    let r = __ui_focus(h);
    if (r[0] == "ok") { Result.Ok(0) } else { Result.Err(r[1]) }
}

/// Changes the title of an OPEN window (M257): `"main.ray — MyApp"`, a dirty marker, the
/// current document. `Err` for a closed or unknown window.
pub fn set_title(h: int, title: string) -> Result<int, string> {
    let r = __ui_window(h, "set_title", title);
    if (r[0] == "ok") { Result.Ok(0) } else { Result.Err(r[1]) }
}

/// Marks an OPEN window's document as modified or not (M257): on macOS the close button shows
/// the "unsaved changes" dot (`setDocumentEdited:`); Linux and Windows have no such indicator
/// and ignore it (show it in the title with `set_title`). `Err` for a closed or unknown window.
pub fn set_edited(h: int, edited: bool) -> Result<int, string> {
    let r = __ui_window(h, "set_edited", if (edited) { "1" } else { "0" });
    if (r[0] == "ok") { Result.Ok(0) } else { Result.Err(r[1]) }
}

/// Makes the USER's attempt to close window `h` (the close button, ⌘W/Alt+F4, the window
/// manager) emit a `"close_requested"` event (`window` = h) instead of closing (M257). The
/// program decides — ask "Save changes?", save — and closes with `close(h)` when it is ready
/// (`close` always closes). `false` restores the direct close. `Err` for a closed or unknown
/// window.
pub fn intercept_close(h: int, on: bool) -> Result<int, string> {
    let r = __ui_window(h, "intercept_close", if (on) { "1" } else { "0" });
    if (r[0] == "ok") { Result.Ok(0) } else { Result.Err(r[1]) }
}

/// Makes this process the app's single instance (M370b). `Ok(true)`: no other instance was
/// running — keep going; this launch's arguments (`args()`) have been queued as `"open"` events,
/// so the program handles "open this" the same way whether it came from `argv` (Linux, Windows,
/// a bare binary) or from the system (macOS `.app`, see the `"open"` event). `Ok(false)`: another
/// instance is already running and has received these arguments as its own `"open"` events —
/// return from `main`. Relative paths that exist are made absolute before forwarding. Keyed by
/// `[app] id` (or the executable's name); the rendezvous is a local socket under
/// `$XDG_RUNTIME_DIR`/the temp dir (Unix) or `%LOCALAPPDATA%\ray` (Windows). A stale socket
/// left by a crashed instance is replaced. On macOS a `ray bundle` app is already single by the
/// system; this call is harmless there.
///
/// ```ray
/// if (!ui.single_instance()?) { return 0; }   // the running app got our paths
/// for e in ui.events() { if (e.kind == "open") { open_path(e.tag); } }
/// ```
pub fn single_instance() -> Result<bool, string> {
    let r = __ui_window(0, "single_instance", __app_info()[0] + "\n" + join(args(), "\n"));
    if (r[0] == "ok") {
        Result.Ok(true)
    } else if (r[1] == "ui: another instance is already running and received this launch's arguments") {
        Result.Ok(false)
    } else {
        Result.Err(r[1])
    }
}

/// Makes the USER's attempt to quit the app — ⌘Q or Quit in the application menu on macOS —
/// emit a `"quit_requested"` event (`window` = 0) instead of terminating the process (M257).
/// The program decides: close its windows and return from `main`. Linux and Windows have no
/// app-level quit besides closing windows, so this only matters on macOS; it is harmless
/// elsewhere. `false` restores the immediate quit.
pub fn intercept_quit(on: bool) -> Result<int, string> {
    let r = __ui_window(0, "intercept_quit", if (on) { "1" } else { "0" });
    if (r[0] == "ok") { Result.Ok(0) } else { Result.Err(r[1]) }
}

/// Puts an OPEN window in or out of full screen (M260): macOS `toggleFullScreen:` (a Space of
/// its own), GTK `gtk_window_fullscreen`, Windows a frameless window covering its monitor (the
/// previous frame is restored on `false`). `Err` for a closed or unknown window.
pub fn set_fullscreen(h: int, on: bool) -> Result<int, string> {
    let r = __ui_window(h, "fullscreen", if (on) { "1" } else { "0" });
    if (r[0] == "ok") { Result.Ok(0) } else { Result.Err(r[1]) }
}

/// Keeps an OPEN window above every other window, or stops doing so (M260):
/// `WindowOptions.always_on_top` after the fact.
pub fn set_always_on_top(h: int, on: bool) -> Result<int, string> {
    let r = __ui_window(h, "always_on_top", if (on) { "1" } else { "0" });
    if (r[0] == "ok") { Result.Ok(0) } else { Result.Err(r[1]) }
}

/// Resizes an OPEN window's CONTENT area to `width` × `height` (M260; the frame is added by the
/// system). Same limits as `open`.
pub fn set_size(h: int, width: int, height: int) -> Result<int, string> {
    let r = __ui_window(h, "set_size", to_string(width) + "," + to_string(height));
    if (r[0] == "ok") { Result.Ok(0) } else { Result.Err(r[1]) }
}

/// Moves an OPEN window so its top-left corner is at `(x, y)` in screen coordinates, origin at
/// the top-left of the main screen (M260; converted for AppKit's bottom-left origin).
pub fn set_position(h: int, x: int, y: int) -> Result<int, string> {
    let r = __ui_window(h, "set_position", to_string(x) + "," + to_string(y));
    if (r[0] == "ok") { Result.Ok(0) } else { Result.Err(r[1]) }
}

/// Centers an OPEN window on its screen (M260).
pub fn center(h: int) -> Result<int, string> {
    let r = __ui_window(h, "center", "");
    if (r[0] == "ok") { Result.Ok(0) } else { Result.Err(r[1]) }
}

/// Minimizes an OPEN window to the Dock / taskbar (M260).
pub fn minimize(h: int) -> Result<int, string> {
    let r = __ui_window(h, "minimize", "");
    if (r[0] == "ok") { Result.Ok(0) } else { Result.Err(r[1]) }
}

/// Maximizes an OPEN window (M260): macOS zoom (toggles), GTK and Windows maximize.
pub fn maximize(h: int) -> Result<int, string> {
    let r = __ui_window(h, "maximize", "");
    if (r[0] == "ok") { Result.Ok(0) } else { Result.Err(r[1]) }
}

/// Changes the title bar color of an OPEN window (M239): `"#rrggbb"` tints it like
/// `WindowOptions.titlebar_color` does at creation (macOS: transparent bar over the window
/// background with a light or dark appearance by luminance; Windows 11: `DWMWA_CAPTION_COLOR`),
/// `""` restores the system bar. Follows a theme change without reopening the window. Linux
/// ignores it, as at creation. `Err` for a malformed color or a closed window.
pub fn set_titlebar_color(h: int, color: string) -> Result<int, string> {
    let r = __ui_set_titlebar(h, color);
    if (r[0] == "ok") { Result.Ok(0) } else { Result.Err(r[1]) }
}

/// Changes the background an OPEN window shows until (and behind) the page (M327): `"#rrggbb"`
/// like `WindowOptions.background` at creation, `""` back to the system default. Follows a
/// theme change without reopening; pair it with `set_titlebar_color` on macOS, where the title
/// bar shows the WINDOW background (this call only touches the webview's). `Err` for a
/// malformed color or a closed window.
pub fn set_background(h: int, color: string) -> Result<int, string> {
    let r = __ui_set_background(h, color);
    if (r[0] == "ok") { Result.Ok(0) } else { Result.Err(r[1]) }
}

/// Opens `path` (a file or directory) with the application the desktop associates to it
/// (M235): `open` on macOS, the default handler on Windows, `xdg-open` on freedesktop. No shell
/// is involved (the path is an argument). Err when the path does not exist or the launcher
/// cannot start; what the desktop does afterwards is not observable.
pub fn open_path(path: string) -> Result<int, string> {
    let r = __ui_desktop("open_path", path);
    if (r[0] == "ok") { Result.Ok(0) } else { Result.Err(r[1]) }
}

/// Reveals `path` in the system file manager, selected (M235): Finder (`open -R`), Explorer
/// (`/select,`), or the freedesktop `FileManager1.ShowItems` call with `xdg-open` of the parent
/// directory as fallback. Err when the path does not exist.
pub fn reveal(path: string) -> Result<int, string> {
    let r = __ui_desktop("reveal", path);
    if (r[0] == "ok") { Result.Ok(0) } else { Result.Err(r[1]) }
}

/// Puts `text` on the system clipboard (M235). Works without a window on macOS and Windows (a
/// terminal app can copy); on Linux it needs a graphical session (GTK).
pub fn clipboard_write(text: string) -> Result<int, string> {
    let r = __ui_clipboard("write", text);
    if (r[0] == "ok") { Result.Ok(0) } else { Result.Err(r[1]) }
}

/// The text on the system clipboard, or `""` when it holds no text (M235).
pub fn clipboard_read() -> Result<string, string> {
    let r = __ui_clipboard("read", "");
    if (r[0] == "ok") { Result.Ok(r[1]) } else { Result.Err(r[1]) }
}

/// M226 — the `ray://app/…` scheme: the page loads its files straight from the process, with no
/// local TCP server (no port another app on the machine could reach, no local-network permission
/// in the bundle) and streamed in chunks (Range, ETag/304, MIME by extension). Mount BEFORE the
/// page requests the files; `open("App", "ray://app/index.html", …)` then needs no server at all.
/// `mount_dir("files", "/path/to/project")` serves `ray://app/files/<rel>` from disk (canonical
/// path; `..` never escapes the directory; a directory serves its `index.html`). Requests to
/// anything not mounted are 404. GET/HEAD only. Served by the three desktop backends (WebKitGTK
/// older than 2.36: body and MIME only, no Range/304; WebView2: the requested range from memory)
/// and, since 1.27.17 (M322), by the iOS and Android shells of `ray bundle` — Android loads the
/// page through the alias `https://app.ray.invalid/…` so `fetch()` and relative URLs work; a
/// shell generated with an older raylang makes `open` fail with a message: regenerate it.
/// Returns `Ok(0)` (files are read lazily, nothing is counted — unlike `mount_embed_at`, which
/// returns how many embedded files it mounted); `Err` if `dir` does not exist.
pub fn mount_dir(prefix: string, dir: string) -> Result<int, string> {
    let r = __ui_mount("dir", prefix, dir);
    if (r[0] == "ok") { Result.Ok(0) } else { Result.Err(r[1]) }
}

/// Mounts `data` as the in-memory file `ray://app/<path>` (M226): generated content, or assets
/// (see `mount_embed`). Replaces a previous file at the same path. In-memory files WIN over a
/// directory mounted on the same path (`mount_dir("", dir)` plus `mount_bytes("boot/x.js", …)`
/// serves the bytes at `ray://app/boot/x.js`, whatever the directory holds), so a program can
/// override or add single files under a mounted tree.
pub fn mount_bytes(path: string, data: bytes) -> Result<int, string> {
    let r = __ui_mount_bytes(path, data);
    if (r[0] == "ok") { Result.Ok(0) } else { Result.Err(r[1]) }
}

/// Mounts the project's embedded assets (`std/embed`, `[native] embed`) whose key starts with
/// `embed_prefix` under `ray://app/<prefix>/…` (M226): `mount_embed("", "assets")` makes
/// `assets/app.css` reachable as `ray://app/assets/app.css`, live from disk under `ray run` and
/// baked into the native binary otherwise. A dependency's assets live under its name
/// (`mount_embed("", "ray_ds/assets")`). Returns the number of files mounted. Works on the
/// desktop backends and (since 1.27.17) inside the iOS/Android shells, see `mount_dir`. The
/// embed key is kept whole — to mount a directory's CONTENTS at a path (the Vite build at the
/// root), use `mount_embed_at`.
pub fn mount_embed(prefix: string, embed_prefix: string) -> Result<int, string> {
    mount_web_packages();
    embed_mount(prefix, embed_prefix)
}

// `mount_embed` sin montar los paquetes web (lo usa el propio montaje de los paquetes).
fn embed_mount(prefix: string, embed_prefix: string) -> Result<int, string> {
    let names = __embed_list();
    if (names.len() > 0 && names[0] != "ok") {
        return Result.Err(names[1]);
    }
    var n = 0;
    var i = 1;
    while (i < names.len()) {
        if (names[i].starts_with(embed_prefix)) {
            n = n + 1;
        }
        i = i + 1;
    }
    // M234: bajo la toolchain (`ray run`/`ray dev`) los embebidos viven en disco → se monta el
    // directorio EN VIVO (streaming, Range, ETag), así una recarga de `ray dev` ve el asset
    // nuevo sin reiniciar. En el binario nativo van horneados y se montan en memoria. M367: el
    // directorio es el que contiene exactamente las claves bajo `embed_prefix` (el de la app o
    // el de una dependencia); "" cuando no hay uno solo → por bytes, con las mismas claves.
    let dir = __embed_root(embed_prefix);
    if (dir != "") {
        let target = if (prefix == "") { embed_prefix } else { prefix + "/" + embed_prefix };
        return match (mount_dir(target, dir)) {
            Result.Ok(_) => Result.Ok(n),
            Result.Err(e) => Result.Err(e),
        };
    }
    n = 0;
    i = 1;
    while (i < names.len()) {
        let name = names[i];
        if (name.starts_with(embed_prefix)) {
            let r = __embed_read(name);
            if (r[0] != b"ok") {
                return Result.Err("embed: read failed: " + name);
            }
            let target = if (prefix == "") { name } else { prefix + "/" + name };
            match (mount_bytes(target, r[1])) {
                Result.Ok(_) => {
                    n = n + 1;
                },
                Result.Err(e) => {
                    return Result.Err(e);
                },
            }
        }
        i = i + 1;
    }
    Result.Ok(n)
}

/// Like `mount_embed`, but the files under `embed_prefix` are mounted AT `prefix` — the embed
/// prefix is stripped (M323, ray808 #11): `mount_embed_at("", "frontend/dist")` puts
/// `frontend/dist/index.html` at `ray://app/index.html` (what `app://index.html` expects, the
/// `ray new --frontend` layout), `mount_embed_at("static", "assets")` puts `assets/app.css` at
/// `ray://app/static/app.css`, and `mount_embed_at("ray-ds", "ray_ds/assets")` serves a
/// dependency's assets at `ray://app/ray-ds/…`. Live from disk under `ray run`/`ray dev`, baked
/// into the native binary otherwise (see `mount_embed`). Returns the number of files mounted.
pub fn mount_embed_at(prefix: string, embed_prefix: string) -> Result<int, string> {
    mount_web_packages();
    embed_mount_at(prefix, embed_prefix)
}

// `mount_embed_at` sin montar los paquetes web.
fn embed_mount_at(prefix: string, embed_prefix: string) -> Result<int, string> {
    if (embed_prefix == "") {
        return embed_mount(prefix, "");
    }
    let names = __embed_list();
    if (names.len() > 0 && names[0] != "ok") {
        return Result.Err(names[1]);
    }
    let under = embed_prefix + "/";
    var n = 0;
    var i = 1;
    while (i < names.len()) {
        if (names[i].starts_with(under)) {
            n = n + 1;
        }
        i = i + 1;
    }
    let dir = __embed_root(embed_prefix);
    if (dir != "") {
        return match (mount_dir(prefix, dir)) {
            Result.Ok(_) => Result.Ok(n),
            Result.Err(e) => Result.Err(e),
        };
    }
    n = 0;
    i = 1;
    while (i < names.len()) {
        let name = names[i];
        if (name.starts_with(under)) {
            let r = __embed_read(name);
            if (r[0] != b"ok") {
                return Result.Err("embed: read failed: " + name);
            }
            let rel = name.substring(under.len(), name.len());
            let target = if (prefix == "") { rel } else { prefix + "/" + rel };
            match (mount_bytes(target, r[1])) {
                Result.Ok(_) => {
                    n = n + 1;
                },
                Result.Err(e) => {
                    return Result.Err(e);
                },
            }
        }
        i = i + 1;
    }
    Result.Ok(n)
}

/// The import map of the web packages of your dependencies, as JSON (`{"imports":{…}}`), or
/// `""` when no dependency has one (M369). A dependency whose `ray.toml` declares
/// `[web] package = "web"` ships that npm package (its `package.json` with `name` and `exports`);
/// `open`, `open_with`, `mount_embed` and `mount_embed_at` serve it at
/// `ray://app/node_modules/<name>/` and every HTML page of `ray://app/` gets this map injected
/// right after `<head>`, so the page imports it by its npm name, as with a bundler:
/// `import "@ray-ds/elements/button"`. Each subpath of `exports` maps to its file (conditions
/// in the order `browser`, `import`, `module`, `default`; `"./x/*": "./y/*.js"` patterns are not
/// mapped), `"<name>/"` maps to the package's folder, and a package without `exports` maps its
/// `module` or `main`. A page that declares its own `<script type="importmap">` is served as is
/// — copy these entries into it. `ray run`/`ray fetch` also link each package into the app's
/// `node_modules/<name>`, so the editor resolves the same imports with their types.
pub fn import_map() -> string {
    web_packages(false)
}

// M369: monta los paquetes web de las dependencias (`node_modules/<nombre>/` del espacio embed,
// lo que la CLI pone ahí por `[web] package`) en `ray://app/node_modules/<nombre>/` y fija el
// import map que el runtime inyecta en cada página HTML. Idempotente; sin paquetes, no hace nada.
fn mount_web_packages() {
    web_packages(true);
}

// Recorre los paquetes web del espacio embed (montándolos si `mount`) y devuelve su import map.
fn web_packages(mount: bool) -> string {
    let names = __embed_list();
    if (names.len() == 0 || names[0] != "ok") {
        return "";
    }
    var entries: [(string, string)] = [];
    var i = 1;
    while (i < names.len()) {
        let key = names[i];
        i = i + 1;
        let name = match (web_package_name(key)) {
            Option.Some(n) => n,
            Option.None => {
                continue;
            },
        };
        let root = "node_modules/" + name;
        if (mount) {
            match (embed_mount_at(root, root)) {
                Result.Ok(_) => { },
                Result.Err(e) => {
                    eprint("[ui] could not mount the web package ${name}: ${e}");
                    continue;
                },
            }
        }
        let r = __embed_read(key);
        if (r[0] != b"ok") {
            continue;
        }
        let text = match (from_utf8(r[1])) {
            Result.Ok(t) => t,
            Result.Err(_) => {
                continue;
            },
        };
        match (json.parse(text)) {
            Result.Ok(pj) => {
                entries = entries + package_imports(name, "/" + root, pj);
            },
            Result.Err(e) => {
                eprint("[ui] the package.json of ${name} is not valid JSON: ${e}");
            },
        }
    }
    if (entries.len() == 0) {
        return "";
    }
    var parts: [string] = [];
    var seen: [string] = [];
    for (k, v) in entries {
        if (!seen.contains(k)) {
            seen.push(k);
            parts.push(json.stringify(Json.JStr(k)) + ":" + json.stringify(Json.JStr(v)));
        }
    }
    let map = "{\"imports\":{" + join(parts, ",") + "}}";
    if (mount) {
        let _r = __ui_mount("importmap", "", map);
    }
    map
}

// El nombre npm de un paquete web si `key` es su `package.json` en el espacio embed:
// `node_modules/<nombre>/package.json`, con `<nombre>` = `pkg` o `@scope/pkg`.
fn web_package_name(key: string) -> Option<string> {
    let head = "node_modules/";
    let tail = "/package.json";
    if (!key.starts_with(head) || !key.ends_with(tail) || key.len() <= head.len() + tail.len()) {
        return Option.None;
    }
    let name = key.substring(head.len(), key.len() - tail.len());
    let segs = name.split("/");
    let ok = if (segs.len() == 1) {
        !name.starts_with("@")
    } else {
        segs.len() == 2 && segs[0].starts_with("@") && segs[0].len() > 1 && segs[1] != ""
    };
    if (ok) { Option.Some(name) } else { Option.None }
}

// Las entradas del import map de un paquete: cada subruta de `exports` → su archivo bajo `base`
// (`/node_modules/<nombre>`), más `<nombre>/` → la carpeta del paquete.
fn package_imports(name: string, base: string, pj: Json) -> [(string, string)] {
    var out: [(string, string)] = [];
    match (json.member(pj, "exports")) {
        Option.Some(Json.JObject(obj)) => {
            let ks: [string] = obj.keys();
            if (ks.len() > 0 && ks[0].starts_with(".")) {
                for k in ks {
                    let target = match (get(obj, k)) {
                        Option.Some(v) => condition_target(v),
                        Option.None => Option.None,
                    };
                    match (target) {
                        Option.Some(t) => {
                            if (k == ".") {
                                out.push((name, package_url(base, t)));
                            } else if (k.ends_with("/*") && t.ends_with("/*")) {
                                // `"./x/*": "./y/*"` → un prefijo: `<nombre>/x/` → `…/y/`.
                                let from = name + k.substring(1, k.len() - 1);
                                out.push((from, package_url(base, t.substring(0, t.len() - 1))));
                            } else if (!k.contains("*")) {
                                out.push((name + k.substring(1, k.len()), package_url(base, t)));
                            }
                        },
                        Option.None => { },
                    }
                }
            } else {
                match (condition_target(Json.JObject(obj))) {
                    Option.Some(t) => out.push((name, package_url(base, t))),
                    Option.None => { },
                }
            }
        },
        Option.Some(e) => {
            match (condition_target(e)) {
                Option.Some(t) => out.push((name, package_url(base, t))),
                Option.None => { },
            }
        },
        Option.None => {
            let main = match (json.get_string(pj, "module")) {
                Option.Some(m) => Option.Some(m),
                Option.None => json.get_string(pj, "main"),
            };
            match (main) {
                Option.Some(m) => out.push((name, package_url(base, m))),
                Option.None => { },
            }
        },
    }
    out.push((name + "/", base + "/"));
    out
}

// El archivo de un valor de `exports`: una cadena relativa (`./x.js`), la primera alternativa que
// resuelve de un arreglo, o la condición `browser`/`import`/`module`/`default` de un objeto
// (`types` y `require` no son para el navegador).
fn condition_target(v: Json) -> Option<string> {
    match (v) {
        Json.JStr(s) => if (s.starts_with("./")) { Option.Some(s) } else { Option.None },
        Json.JArray(items) => {
            for it in items {
                match (condition_target(it)) {
                    Option.Some(t) => {
                        return Option.Some(t);
                    },
                    Option.None => { },
                }
            }
            Option.None
        },
        Json.JObject(_) => {
            for c in ["browser", "import", "module", "default"] {
                match (json.member(v, c)) {
                    Option.Some(inner) => match (condition_target(inner)) {
                        Option.Some(t) => {
                            return Option.Some(t);
                        },
                        Option.None => { },
                    },
                    Option.None => { },
                }
            }
            Option.None
        },
        _ => Option.None,
    }
}

fn package_url(base: string, rel: string) -> string {
    let r = if (rel.starts_with("./")) { rel.substring(2, rel.len()) } else { rel };
    base + "/" + r
}

/// The UI events as a channel: spawns a pump fiber that forwards `next_event()` into it — use
/// it to `select` UI events alongside your other channels. Needs the VM or a native build
/// (`spawn`); on an error from the queue the pump ends and the channel goes quiet.
pub fn events() -> Channel<UiEvent> {
    let ch: Channel<UiEvent> = Channel.new();
    spawn(fn() {
        var running = true;
        while (running) {
            match (next_event()) {
                Result.Ok(e) => send(ch, e),
                Result.Err(_) => {
                    running = false;
                },
            }
        }
    });
    ch
}

/// The UI events split in two channels: `(messages, other)` — the first receives the
/// `"message"` events (the page's `window.ray.send`/`request`; `as_request`/`reply` work on
/// them unchanged), the second everything else ("closed", "menu"). One pump fiber routes
/// `next_event()` — so, like `events()`, this is the SINGLE consumer of the process-wide
/// queue: call it once, and don't mix it with `next_event`/`events()`. Both channels are
/// unbounded: drain both (an ignored side grows). On a queue error the pump ends and both
/// channels go quiet. Needs the VM or a native build (`spawn`).
pub fn split_events() -> (Channel<UiEvent>, Channel<UiEvent>) {
    let msgs: Channel<UiEvent> = Channel.new();
    let other: Channel<UiEvent> = Channel.new();
    spawn(fn() {
        var running = true;
        while (running) {
            match (next_event()) {
                Result.Ok(e) => {
                    if (e.kind == "message") { send(msgs, e) } else { send(other, e) }
                },
                Result.Err(_) => {
                    running = false;
                },
            }
        }
    });
    (msgs, other)
}
