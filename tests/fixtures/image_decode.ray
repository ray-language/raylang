import std/image;

fn show(name: string, data: bytes) {
    match (image.decode_png(data)) {
        Result.Ok(img) => {
            print("ok " + to_string(img.width) + "x" + to_string(img.height));
            var px: [int] = [];
            var i = 0;
            while (i < img.pixels.len()) {
                px.push(img.pixels[i]);
                i = i + 1;
            }
            print(px);
        },
        Result.Err(e) => print("err " + e),
    }
}

