import std/image;

fn dump(b: bytes) -> [int] {
    var out: [int] = [];
    var i = 0;
    while (i < b.len()) {
        out.push(b[i]);
        i = i + 1;
    }
    out
}

fn main() {
    // 3x2 RGBA: rojo opaco, verde medio, azul transparente / gris, blanco, negro.
    let px = [255, 0, 0, 255, 0, 255, 0, 128, 0, 0, 255, 0, 10, 20, 30, 40, 255, 255, 255, 255, 0, 0, 0, 255];
    let img = image.Image { width: 3, height: 2, pixels: bytes_of(px) };
    match (image.encode_png(img)) {
        Result.Ok(png) => {
            print("png " + to_string(png.len()));
            print(dump(png));
            match (image.decode_png(png)) {
                Result.Ok(back) => {
                    print("back " + to_string(back.width) + "x" + to_string(back.height));
                    print(dump(back.pixels));
                },
                Result.Err(e) => print("decode err " + e),
            }
        },
        Result.Err(e) => print("err " + e),
    }
    // 1x1 mínimo.
    match (image.encode_png(image.Image { width: 1, height: 1, pixels: b"\x01\x02\x03\x04" })) {
        Result.Ok(png) => print("one " + to_string(png.len())),
        Result.Err(e) => print("err " + e),
    }
    // Errores: tamaño de píxeles incoherente y dimensiones nulas.
    match (image.encode_png(image.Image { width: 2, height: 1, pixels: b"\x00" })) {
        Result.Ok(_) => print("bad size accepted"),
        Result.Err(e) => print("err " + e),
    }
    match (image.encode_png(image.Image { width: 0, height: 1, pixels: b"" })) {
        Result.Ok(_) => print("zero accepted"),
        Result.Err(e) => print("err " + e),
    }
}
