// tools/site.ray — el generador del SITIO del lenguaje (IDEAS §74), en raylang puro.
//
// Dogfooding doble: el sitio lo genera raylang (como el sitio del registro, M84) y las
// páginas se autoran con los TEMPLATES NATIVOS `.ray.html` (M102) — layout compartido
// con herencia (`site_layout`) + landing (`site_landing`) + SPEC renderizada vía
// std/markdown empalmada cruda con `{{& body }}` (`site_spec`). Salida DETERMINISTA
// (cero relojes, contenido fijo + SPEC.md) → verificable por golden en ambos motores.
//
//   ray run tools/site.ray <raíz-del-repo> <dir-de-salida>
//
// Previsualización local: la salida es autocontenida (CSS inline, enlaces relativos) —
// basta abrir `index.html` en el navegador o servir el directorio con cualquier estático.

import std/fs;
import std/markdown;
import site_landing;
import site_spec;

fn write_or_die(path: string, content: string) {
    match (fs.write_file(path, content)) {
        Result.Ok(n) => { },
        Result.Err(e) => panic("no se pudo escribir '" + path + "': " + e),
    }
}

// Copia un asset de marca (SVG = texto) del repo a la salida.
fn copy_asset(root: string, out: string, source: string, dest: string) {
    match (fs.read_file(root + "/assets/" + source)) {
        Result.Ok(svg) => write_or_die(out + "/assets/" + dest, svg),
        Result.Err(e) => panic("missing brand asset '" + source + "': " + e),
    }
}

fn main() -> int {
    let argv = args();
    if (argv.len() != 2) {
        eprint("usage: ray run tools/site.ray <repo-root> <out-dir>");
        return 64;
    }
    let root = argv[0];
    let out = argv[1];
    let spec_md = match (fs.read_file(root + "/SPEC.md")) {
        Result.Ok(s) => s,
        Result.Err(e) => {
            eprint("could not read SPEC.md: " + e);
            return 65;
        },
    };
    let _ = fs.mkdir(out);
    let _ = fs.mkdir(out + "/assets");
    // La marca (assets/branding/raylang-brand.pdf): símbolo primario, icono y Manta.
    copy_asset(root, out, "raylang-symbol-primary.svg", "symbol.svg");
    copy_asset(root, out, "icon.svg", "icon.svg");
    copy_asset(root, out, "raylang-mascot.svg", "mascot.svg");
    write_or_die(
        out + "/index.html",
        site_landing.render("raylang — un lenguaje para producción real")
    );
    write_or_die(
        out + "/spec.html",
        site_spec.render("Especificación del lenguaje raylang", markdown.to_html(spec_md))
    );
    print("site generated in " + out);
    0
}
